    ' ---- Begin Inlined Level 2: IFsEducSec_new_init:SecondaryTotals_New_Init
' Private Sub SecondaryTotals_New_Init(R%, AdultMales As Single, AdultFemales As Single, SecLowrLGGenM As Single, SecLowrLGGenF As Single, AdultMales15to24 As Single, AdultFemales15to24 As Single, AdultMales20to24 As Single, AdultFemales20to24 As Single)
                '----------------------------------------------------------------------------------
                'mti 2020/09/01  - Take procedure
    
                'Education Module - Total from male and female- Lower, Upper and Whole of Secondary
    
                ' Secondary lower
                Dim seclowrStart As Integer = CInt(edpristart(R%%) + edprilen(R%%))
    
                'mti 2016/12/09 start
                EDSECLOWRTOT(R%%, Total) = EDSECLOWRTOT(R%%, Male) + EDSECLOWRTOT(R%%, Female)
                EDSECLOWRGRADS(R%%, Total) = EDSECLOWRGRADS(R%%, Male) + EDSECLOWRGRADS(R%%, Female)
                'mti 2016/12/09 - end
    
                EDSECLOWRTRAN(R%%, Total) = CSng((EDSECLOWRTRAN(R%%, Male) * fagedst(seclowrStart, R%%, Male) + EDSECLOWRTRAN(R%%, Female) * fagedst(seclowrStart, R%%, Female)) _
                                / AMAX(0.0000001, fagedst(seclowrStart, R%%, Male) + fagedst(seclowrStart, R%%, Female)))
    
                Dim IntkRateMale = EDSECLOWRTRAN(R%%, 1) * EDPRICR(R%%, 1)
                Dim IntkRateFemale = EDSECLOWRTRAN(R%%, 2) * EDPRICR(R%%, 2)
    
                'mti 2017/01/24 start
                'EDSECLOWRSUR(R%%, Total) = ((EDSECLOWRSUR(R%%, 1) * IntkRateMale * fagedst(seclowrStart, R%%, 1) + EDSECLOWRSUR(R%%, 2) * IntkRateFemale * fagedst(seclowrStart, R%%, 2)) / _
                'AMAX(0.0000001, (IntkRateMale * fagedst(seclowrStart, R%%, 1) + IntkRateFemale * fagedst(seclowrStart, R%%, 2))))  '* 100
                'mti 2017/01/24 End
    
                'mti check October 2008 - all population could be saved at their first calculation in IFsEduc
    Dim SecMale = seclowrStart + edseclowrlen(R%%) + R%% + Male @@Dim SecMale = CalcPopFrom1Year(seclowrStart, edseclowrlen(R%%), R%%, Male)@@
    Dim SecFemale = seclowrStart + edseclowrlen(R%%) + R%% + Female @@Dim SecFemale = CalcPopFrom1Year(seclowrStart, edseclowrlen(R%%), R%%, Female)@@
    
                EDSECLOWRENRG(R%%, Total) = (EDSECLOWRENRG(R%%, 1) * SecMale + EDSECLOWRENRG(R%%, 2) * SecFemale) _
                                        / AMAX(0.0000001, SecMale + SecFemale)
    
                'mti 2020/09/01  Start
                For GCount% = 1 To CInt(edseclowrlen(R%%)) '+ 1 To NPriGr
                    Dim Pupils_Male = EDSECLOWRENRGGRD(R%%, GCount%, Male) * fagedst(seclowrStart + GCount% - 1, R%%, Male)
                    Dim Pupils_Female = EDSECLOWRENRGGRD(R%%, GCount%, Female) * fagedst(seclowrStart + GCount% - 1, R%%, Female)
                    Dim Population_Total = fagedst(seclowrStart + GCount% - 1, R%%, Male) + fagedst(seclowrStart + GCount% - 1, R%%, Female)
                    Dim Pupils_Total = Pupils_Male + Pupils_Female
    
                    EDSECLOWRENRGGRD(R%%, GCount%, Total) = CSng((Pupils_Male + Pupils_Female) / AMAX(0.00001, Population_Total))
    
                    If GCount% < edseclowrlen(R%%) Then
                        EDSECLOWRDRPGRD(R%%, GCount%, Total) = CSng((EDSECLOWRDRPGRD(R%%, GCount%, Male) * Pupils_Male + EDSECLOWRDRPGRD(R%%, GCount%, Female) * Pupils_Female) / AMAX(0.000001, Pupils_Total))
                    End If
    
                Next
                'mti 2020/09/01 End
    
    
    
    
                EDSECLOWRVOC(R%%, Total) = (EDSECLOWRVOC(R%%, 1) * SecMale + EDSECLOWRVOC(R%%, 2) * SecFemale) _
                                        / AMAX(0.0000001, SecMale + SecFemale)
    
                'basic education total
    
    Dim primale = edpristart(R%%) + edprilen(R%%) + R%% + Male @@Dim primale = CalcPopFrom1Year(edpristart(R%%), edprilen(R%%), R%%, Male)@@
    Dim prifemale = edpristart(R%%) + edprilen(R%%) + R%% + Female @@Dim prifemale = CalcPopFrom1Year(edpristart(R%%), edprilen(R%%), R%%, Female)@@
    
                Dim basMale = primale + SecMale
                Dim basFemale = prifemale + SecFemale
    
                EDBASENRG(R%%, Total) = (EDBASENRG(R%%, 1) * basMale + EDBASENRG(R%%, 2) * basFemale) _
                                        / AMAX(0.0000001, basMale + basFemale)
                'Lower Secondary Graduation Rate
                Dim TotBoys = fagedst(CInt(seclowrStart + edseclowrlen(R%%)), R%%, Male)
                Dim TotGirls = fagedst(CInt(seclowrStart + edseclowrlen(R%%)), R%%, Female)
                EDSECLOWRGRATE(R%%, Total) = CSng((EDSECLOWRGRATE(R%%, Male) * TotBoys + EDSECLOWRGRATE(R%%, Female) * TotGirls) / AMAX(0.0000001, TotBoys + TotGirls)) '* 100
    
                ' Secondary Upper
                Dim secupprStart As Integer = CInt(edpristart(R%%) + edprilen(R%%) + edseclowrlen(R%%))
                EDSECUPPRTRAN(R%%, Total) = CSng((EDSECUPPRTRAN(R%%, Male) * fagedst(secupprStart, R%%, Male) + EDSECUPPRTRAN(R%%, Female) * fagedst(secupprStart, R%%, Female)) _
                                / AMAX(0.0000001, fagedst(secupprStart, R%%, Male) + fagedst(secupprStart, R%%, Female)))
    
                IntkRateMale = EDSECUPPRTRAN(R%%, 1) * seclowrstudents(CInt(edseclowrlen(R%)), R%, Male)
                IntkRateFemale = EDSECUPPRTRAN(R%%, 2) * seclowrstudents(CInt(edseclowrlen(R%)), R%, Female)
    
                'mti 2017/01/24 start
                'EDSECUPPRSUR(R%%, Total) = ((EDSECUPPRSUR(R%%, 1) * IntkRateMale * fagedst(secupprStart, R%%, 1) + EDSECUPPRSUR(R%%, 2) * IntkRateFemale * fagedst(secupprStart, R%%, 2)) / _
                'AMAX(0.0000001, (IntkRateMale * fagedst(secupprStart, R%%, 1) + IntkRateFemale * fagedst(secupprStart, R%%, 2))))  '* 100
                'mti 2017/01/24 end
    
    
    SecMale = secupprStart + edsecupprlen(R%%) + R%% + Male @@SecMale = CalcPopFrom1Year(secupprStart, edsecupprlen(R%%), R%%, Male)@@
    SecFemale = secupprStart + edsecupprlen(R%%) + R%% + Female @@SecFemale = CalcPopFrom1Year(secupprStart, edsecupprlen(R%%), R%%, Female)@@
    
                EDSECUPPRENRG(R%%, Total) = (EDSECUPPRENRG(R%%, 1) * SecMale + EDSECUPPRENRG(R%%, 2) * SecFemale) _
                                        / AMAX(0.0000001, SecMale + SecFemale)
    
                EDSECUPPRVOC(R%%, Total) = (EDSECUPPRVOC(R%%, 1) * SecMale + EDSECUPPRVOC(R%%, 2) * SecFemale) _
                                        / AMAX(0.0000001, SecMale + SecFemale)
    
