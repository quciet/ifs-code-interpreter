    ' ---- Begin Inlined Level 2: IFsEducPri_new_init:ProcessPriNet_new_init
' Private Sub ProcessPriNet_new_init(R%, gndr%, ByRef PriIntNShift As Single, ByRef PriEnrNShift As Single, savepridropoutnet As Single, ByRef PristudentsNet As Single(,,), drpoutgr As Single(), pripopgndr As Single, context As IForecastContext)
                'mti 2023/10/15 added byref
    
                'mti 2020/09/01 - new proc - initialization of net variables in primary
                Dim EdPriEnrRatioNG As Single
                Dim CalcPriShift As Single
                If gndr = 1 Then
                    If context.HistoricMode Then
                        Call XYTABL("GDP/Capita (PPP) Versus Primary Net Intake Rate Male(1992)", GDPPCP(R%%), CalcPriShift, context)
                    Else
                        TbName$ = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Male (" & CStr(BaseYear) & ") Log"
                        TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
                        Call XYTABL(TbName$, GDPPCP(R%%), CalcPriShift, context)
                    End If
                Else
                    If context.HistoricMode Then
                        Call XYTABL("GDP/Capita (PPP) Versus Primary Net Intake Rate Female(1992)", GDPPCP(R%%), CalcPriShift, context)
                    Else
    
                        TbName$ = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Female (" & CStr(BaseYear) & ") Log"
                        TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
                        Call XYTABL(TbName$, GDPPCP(R%%), CalcPriShift, context)
                        'mti 2016/12/09 End
                    End If
                End If
    
                edpriintnshift(R%, gndr) = EDPRIINTN(R%%, gndr) - CalcPriShift
    
                '    If RegName(R%%) = "Nicaragua" And gndr% = 1 Then Stop
    
                EdPriEnrRatioNG = Amin(1, EDPRIENRN(R%%, gndr%) / EDPRIENRG(R%%, gndr%))
    
                PristudentsNet(1, R%%, gndr%) = AMAX(EDPRIINTN(R%%, gndr%), pristudents(1, R%%, gndr%) * EdPriEnrRatioNG)
    
                'Normalization would be required for net, just in case 1st grade "net(school age)" students need tp b e adjusted to keep it above net intake
                Dim NetHC_2ndtoLast As Single = 0
                For GCount% = 2 To CInt(edprilen(R%%))
                    PristudentsNet(GCount%, R%%, gndr%) = pristudents(GCount%, R%%, gndr%) * EdPriEnrRatioNG
                    NetHC_2ndtoLast = CSng(NetHC_2ndtoLast + fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, gndr%) * PristudentsNet(GCount%, R%%, gndr%))
                Next
                Dim NetHC_2ndtoLast_Reqd = EDPRIENRN(R%%, gndr%) * POPEDPRI(R%%, gndr%) - fagedst(CInt(edpristart(R%%)), R%%, gndr%) * PristudentsNet(1, R%%, gndr%)
    
                For GCount% = 2 To CInt(edprilen(R%%))
                    'mti 2022/11/25 start
                    'PristudentsNet(GCount%, R%%, gndr%) = PristudentsNet(GCount%, R%%, gndr%) * NetHC_2ndtoLast_Reqd / NetHC_2ndtoLast
                    PristudentsNet(GCount%, R%%, gndr%) = CSng(PristudentsNet(GCount%, R%%, gndr%) * NetHC_2ndtoLast_Reqd / AMAX(0.0000001, NetHC_2ndtoLast))
                    'mti 2022/11/25 start
                Next
    
    
    
                'mti 2021/01/11 End PriNetGrossRatAllBut1st(R%%, gndr%)
    
    
                'First Year Primary Net Model: Calculate dropout using net intake and net enrollment rate
                '        pridropoutnet = CalcDropoutFromEnrNIntk(edprilen(R%%), EDPRIINTN(R%%, gndr), EDPRIENRN(R%%, gndr))
                '        spridropoutnet(R%, gndr) = pridropoutnet
                '
                '        'First Year Primary Net Model: detrmine grade-wise enrollment rates and total number of students
                '        Call GradeWiseEnrollmentInit(R%%, gndr, edpristart(R%%), edprilen(R%%), EDPRIINTN(R%%, gndr), PristudentsNet(), _
                '                pridropoutnet, drpoutgr(), edpritotNet)
    
    
    
    
    
    
                Dim edpritotNet As Double = 0
                For GCount% = 1 To CInt(edprilen(R%%))
                    edpritotNet = edpritotNet + fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, gndr%) * PristudentsNet(GCount%, R%%, gndr%) / 100
                    'If gndr% = 1 Then Debug.Print ","; fagedst(cint(edpristart(R%%) + GCount% - 1), R%%, gndr%) * pristudents(GCount%, R%%, gndr%) / 100;
                Next
    
    
                '        'First Year Primary Net Model: calculate net enrolment rate from grade-flow of students and school-age population
                '        edprienrnshift(R%, gndr) = EDPRIENRN(R%%, gndr) - (100 * edpritotNet / pripopgndr) 'caledprienrn
                '        edprienrnshift(R%, gndr) = 0 'override shift (will take out later
