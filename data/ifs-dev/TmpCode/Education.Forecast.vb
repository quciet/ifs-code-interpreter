                    '
                    '                Rat_Gr_Lvl = EDSECLOWRTOT(R%, gndr) * (1 - EDSECLOWRVOC(R%, gndr%) / 100) / AMAX(0.000001, EdSecLowrTot_From_GradeEnr)
                    '
                    '          'If RegName(R%) = "Angola" Then Stop
                    ''          If RegName(R%) = "Cambodia" Then Stop
