            '                        'supplysecuppr = demandsecuppr + Budgetdiff * secupprgap / totgap
            '
            '                        supplyseclowr = demandseclowr + seclowradd + budgetdiff * seclowrgap / totgap
            '                        supplysecuppr = demandsecuppr + secuppradd + budgetdiff * secupprgap / totgap
            '
            '
            '                        'supplysec = demandsec + Budgetdiff * secgap / totgap
            '
            '                        'supplyter = demandter + Budgetdiff * tergap / totgap
            '                        supplyter = demandter + teradd + budgetdiff * tergap / totgap
            '                    End If
            '
            '                End If
            '
            '                supplysec = supplyseclowr + supplysecuppr
            '
            '            Else
            'mti commented from here - Nov 25, 2008 -end
            Dim supplypri = demandpri
            Dim supplyseclowr = demandseclowr
            Dim supplysecuppr = demandsecuppr
            Dim supplysec = demandsec
            Dim supplyter = demandter
            '            End If

            'extra spending decision (scenario intervention) added now to supply side,to make sure emphasis is reflected in normalization
            supplypri = supplypri * gdsedm(R%%, Primary)

            supplyseclowr = supplyseclowr * gdsedm(R%%, SecLowr)
            supplysecuppr = supplysecuppr * gdsedm(R%%, SecUppr)

            'mti 2014/10/06 - start
            'supplysec = supplysec * gdsedm(R%%, Secondary)
            'mti 2014/10/06 - end

            supplyter = supplyter * gdsedm(R%%, Tertiary)


            'calctotspend = newprispend + newsecspend + newterspend 'exchange rate
            Dim supplysum = supplypri + supplyseclowr + supplysecuppr + supplyter
            '   If R%% = 1 Then Stop
            'If GRPS(1,R%%) = "Ethiopia" Then Stop
            GDSED(R%%, Primary) = supplypri / AMAX(0.0000001, supplysum)
            GDSED(R%%, SecLowr) = supplyseclowr / AMAX(0.0000001, supplysum) '* GDS(R%%, Educ) / AMAX(0.0000001, GOVCON(R%%))
            GDSED(R%%, SecUppr) = supplysecuppr / AMAX(0.0000001, supplysum) '* GDS(R%%, Educ) / AMAX(0.0000001, GOVCON(R%%))

            'mti 2014/10/06 - start
            'GDSED(R%%, Secondary) = supplysec / AMAX(0.0000001, supplysum) '* GDS(R%%, Educ) / AMAX(0.0000001, GOVCON(R%%))
            'mti 2014/10/06 - end

            GDSED(R%%, Tertiary) = supplyter / AMAX(0.0000001, supplysum) '* GDS(R%%, Educ) / AMAX(0.0000001, GOVCON(R%%))

            'mti commented from here till end- Nov 25, 2008
            'reallocate if there are flow goals; necessary for deficit countries
            Dim PriHasFlowGoals = False
            For gndr% = 1 To NGender%
                If edpriintngr(R%%, gndr%) <> 0 Or edprisurgr(R%%, gndr%) <> 0 Then
                    PriHasFlowGoals = True
                    Exit For
                End If

            Next
            '   If GRPS(1,R%) = "Chad" Then Stop
            Dim SumFrac_Others As Single
            Dim Add_Frac As Single
            If PriHasFlowGoals Then
                '         If R%% = 1 And IY > 20 Then Stop
                supplypri = GDSED(R%%, Primary) * calctotsupply
                If supplypri < demandpri Then

                    SumFrac_Others = 1 - GDSED(R%%, Primary)
                    'jrs 2020/07/14 Add_Frac = CSng(Amin(0.7 * SumFrac_Others, (demandpri - supplypri) / calctotsupply))
                    Add_Frac = CSng(Amin(0.7 * SumFrac_Others, (demandpri - supplypri) / AMAX(0.0000001, calctotsupply)))
                    GDSED(R%%, Primary) = GDSED(R%%, Primary) + Add_Frac
                    GDSED(R%%, SecLowr) = GDSED(R%%, SecLowr) * (1 - Add_Frac / SumFrac_Others)
                    GDSED(R%%, SecUppr) = GDSED(R%%, SecUppr) * (1 - Add_Frac / SumFrac_Others)
                    GDSED(R%%, Tertiary) = GDSED(R%%, Tertiary) * (1 - Add_Frac / SumFrac_Others)
                End If
                supplypri = GDSED(R%%, Primary) * calctotsupply
                If supplypri < demandpri Then
                    'demandpri = EDEXPERPRI(R%%) * GDPPC(R%%) * (EDPRITOT(R%%, 1) + EDPRITOT(R%%, 2)) / 100
                    EDEXPERPRI(R%%) = 100 * supplypri / (GDPPC(R%%) * (EDPRITOT(R%%, 1) + EDPRITOT(R%%, 2)))
                End If
            End If

            Dim SecLowrHasFlowGoals = False
            For gndr% = 1 To NGender%
                'mti 2017/01/24 start
                If edseclowrtrangr(R%%, gndr%) <> 0 Or edseclowrgradgr(R%%, gndr%) <> 0 Then
                    'mti 2017/01/24 end
                    SecLowrHasFlowGoals = True
                    Exit For
                End If

            Next
            If SecLowrHasFlowGoals Then
                supplyseclowr = GDSED(R%%, SecLowr) * calctotsupply
                If supplyseclowr < demandseclowr Then
                    SumFrac_Others = 1 - GDSED(R%%, Primary) - GDSED(R%%, SecLowr)
                    'jrs 2020/07/14 Add_Frac = CSng(Amin(0.5 * SumFrac_Others, (demandseclowr - supplyseclowr) / calctotsupply))
                    Add_Frac = CSng(Amin(0.5 * SumFrac_Others, (demandseclowr - supplyseclowr) / AMAX(0.0000001, calctotsupply)))
                    GDSED(R%%, SecLowr) = GDSED(R%%, SecLowr) + Add_Frac
                    GDSED(R%%, SecUppr) = GDSED(R%%, SecUppr) * (1 - Add_Frac / SumFrac_Others)
                    GDSED(R%%, Tertiary) = GDSED(R%%, Tertiary) * (1 - Add_Frac / SumFrac_Others)
                End If
            End If


            Dim SecUpprHasFlowGoals = False
            For gndr% = 1 To NGender%
                'mti 2017/01/24 start
                If edsecupprtrangr(R%%, gndr%) <> 0 Or edsecupprgradgr(R%%, gndr%) <> 0 Then
                    'mti 2017/01/24 end
                    SecUpprHasFlowGoals = True
                    Exit For
                End If

            Next
            If SecUpprHasFlowGoals Then
                supplysecuppr = GDSED(R%%, SecUppr) * calctotsupply
                If supplysecuppr < demandsecuppr Then
                    SumFrac_Others = 1 - GDSED(R%%, Primary) - GDSED(R%%, SecLowr) - GDSED(R%%, SecUppr) 'Tertiary frac
                    'jrs 2020/07/14 Add_Frac = CSng(Amin(0.5 * SumFrac_Others, (demandsecuppr - supplysecuppr) / calctotsupply))
                    Add_Frac = CSng(Amin(0.5 * SumFrac_Others, (demandsecuppr - supplysecuppr) / AMAX(0.0000001, calctotsupply)))
                    GDSED(R%%, SecUppr) = GDSED(R%%, SecUppr) + Add_Frac
                    GDSED(R%%, Tertiary) = GDSED(R%%, Tertiary) * (1 - Add_Frac / SumFrac_Others)
                End If
            End If

            'end reallocate if there are flow goals; necessary for shortage
            'mti check - needed only for budget code analysis
            demandpri = EDEXPERPRI(R%%) * GDPPC(R%%) * (EDPRITOT(R%%, 1) + EDPRITOT(R%%, 2)) / 100
            demandseclowr = EDEXPERSECLOWR(R%%) * GDPPC(R%%) * (EDSECLOWRTOT(R%%, 1) + EDSECLOWRTOT(R%%, 2)) / 100
            demandsecuppr = EDEXPERSECUPPR(R%%) * GDPPC(R%%) * (EDSECUPPRTOT(R%%, 1) + EDSECUPPRTOT(R%%, 2)) / 100
            demandter = EDEXPERTER(R%%) * GDPPC(R%%) * (EDTERTOT(R%%, 1) + EDTERTOT(R%%, 2)) / 100
            demandsec = demandseclowr + demandsecuppr
            calctotdemand = (demandpri + demandsec + demandter) * convtoexchange(R%) '* spendcostRI(R%)

            budgetdiff = calctotsupply - calctotdemand

            ' If GRPS(1,R%%) = "Lesotho" And IY > 8 Then Stop

            '        Debug.Print IY; EDEXPERPRI(R%%); EDPRITOT(R%%, 1) + EDPRITOT(R%%, 2); EDEXPERSECLOWR(R%%); EDSECLOWRTOT(R%%, 1) + EDSECLOWRTOT(R%%, 2); EDEXPERSECUPPR(R%%); EDSECUPPRTOT(R%%, 1) + EDSECUPPRTOT(R%%, 2); EDEXPERTER(R%%); EDTERTOT(R%%, 1) + EDTERTOT(R%%, 2)
            '        Debug.Print IY; demandpri, demandsec, demandter, calctotdemand, calctotsupply
            '   End If

            '            EDBUDGDIFF2(R%%) = budgetdiff * 1000

' End Sub
' ---- End Inlined Level 1: BudgetAllocation

            Next R%
            '
            '
            '  All Years but First After Budget:  Budget Impact from here
            '===================================================================================================
            'cap on budget impact on intake and survival: upside and downside

            'mti 2016/03/09- start
            MxIntDown = 3 'change to +3
            MxIntUp = 6 ' 8  '5

            MxSurDown = 3 'change to +3
            MxSurUp = 6 ' 8 '4
            'mti 2016/03/09- end



            '
            '  All Years but First: Primary Final:  Compute Exttrastudentsratio Or Budget Impact on Intake and Survival
            '============================================================================================================
            'error location string
            ' sErrorSub = "IFsEduc All years but First After Budget: Primary " & CStr(IFUN)

Call IFsEducPri2AllYearsButFirst(context)
' ---- Begin Inlined Level 1: IFsEducPri2AllYearsButFirst
' Private Sub IFsEducPri2AllYearsButFirst(context As IForecastContext)
            'call2:
            '  All Years but First: Primary Final After Budget:  Compute Exttrastudentsratio Or Budget Impact on Intake and Survival
            '============================================================================================================

            sErrorSub = "IFsEducPri All years but First After Budget: Primary: "


            For R% = 1 To NR%

                '    If GRPS(1,R%) = "Malawi" And IY = 8 Then Stop
                '    If GRPS(1,R%) = "Burundi" And IY = 5 Then Stop
                Dim RegionName = context.GetDimension(1).Buckets.Item(CShort(R))
                sErrorSub = sErrorSub & RegionName
                'budgeting off - skip budget impact
                'If edbudgon(R%) = 0 Then GoTo AfterPriBudgetImpact  'budget neutral
                If edbudgon(R%) = 0 Then
Call AfterPriBudgetImpact(R)
    ' ---- Begin Inlined Level 2: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact
' Private Sub AfterPriBudgetImpact(R%)
                'AfterPriBudgetImpact:
    
    
                'primary initialize total student and graduates once more after budget
                EDPRITOT(R%, Total) = 0
                EDPRIGRADS(R%, Total) = 0
    
                For gndr = 1 To NGender - 1 'male/female, no total
    
                    'new budget code- moving average
                    sIntakeImpact(R%, gndr, Primary) = CSng(0.8 * sIntakeImpact(R%, gndr, Primary) + 0.2 * sIntakeImpact(R%, gndr, Primary) * fEdIntk(R%, gndr, Primary) / iEdIntk(R%, gndr, Primary))
                    sSurvImpact(R%, gndr, Primary) = CSng(0.8 * sSurvImpact(R%, gndr, Primary) + 0.2 * sSurvImpact(R%, gndr, Primary) * fEdSurv(R%, gndr, Primary) / iEdSurv(R%, gndr, Primary))
    
                    '     If GRPS(1,R%) = "Burundi" Then Stop
                    'dropout - grade-specific
    Call DropoutSpread(edprilen(R%), EDPRISUR(R%, gndr), drpoutgr)
            ' ---- Begin Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:DropoutSpread
    ' Private Sub DropoutSpread(lencycle As Single, Survival As Single, ByRef Arr_Dropout() As Single)
                        '-----------------------------------------------------------------------------------
                        ' Education Module - Calculates a seperate dropout rate for each grade
                        ' Assumes dropout in the first grade is twice the average dropout rate; all other grades average out the rest of the dropout
                        Dim Dropoutrate, G2Enr As Single
                        Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1)))))
            
                        'mti April 05, 2012 -start
                        drpoutgr(1) = Dropoutrate
            
            
                        'mti 2017/01/24 start
                        If EDPRISUR(R%, gndr) < 100 Then  'was 90
                            'mti 2017/01/24 end
            
            
            
                            'If dropoutrate < 0.4 And GDPPCP(R%) < 4 Then
                            drpoutgr(1) = CSng(Amin(0.5, Dropoutrate * 2))
            
            
            
                            G2Enr = 1 - drpoutgr(1)
                            Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%, gndr) / G2Enr / 100) ^ (1 / (edprilen(R%) - 2))))) 'dropout rate for gender
                            'End If
            
            
                            For GCount% = 2 To CInt(edprilen(R%))
                                drpoutgr(GCount%) = Dropoutrate
                            Next GCount%
            
                        Else
                            For GCount% = 2 To CInt(edprilen(R%))
                                drpoutgr(GCount%) = Dropoutrate
                            Next GCount%
                        End If
                        'mti April 05, 2012 -end
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:DropoutSpread
                    EDPRITOT(R%, gndr) = 0
    
                    'save first grade dropouts to add in the over-age pool
                    DropOut1st_No(R%, gndr) = CSng(drpoutgr(1) * fagedst(CInt(edpristart(R%)) + 1, R%, gndr) * SaveStudentCohorts(R%, 1, gndr, 1) / 100)
    
                    'mti 2022/03/16 start - shock rebound
                    Dim OutofSchooltot As Single = 0
                    For grcount% = 1 To 10
                        OutofSchooltot = OutofSchooltot + outofschoolbyage(grcount%, R%, gndr%)
                    Next
                    'mti 2022/03/16 end
    
                    'All Years but First: Primary Final: grade-specific enrolment rates and total enrolment
                    For GCount% = CInt(edprilen(R%)) To 2 Step -1
                        'students carried forward to the subsequent grades - using gradewise array (from previous year) saved before budget intervention
                        pristudents(GCount%, R%, gndr) = SaveStudentCohorts(R%, GCount% - 1, gndr, 1) * (1 - drpoutgr(GCount% - 1))
    
                        'mti 2022/03/16 start - shock rebound
                        If edpriintnm(R%, NGender) > 1 Or edpriintnm(R%, gndr) > 1 Then
                            '         If RegName(R%) = "Uganda" Then Stop
    
                            Dim OutofSchooltotRunning As Single = 0
                            For grcount% = 1 To 10
                                OutofSchooltotRunning = OutofSchooltotRunning + outofschoolbyage(grcount%, R%, gndr%)
                            Next
                            If OutofSchooltot > 0 And OutofSchooltotRunning > 0 Then
                                Dim sPriStudents = pristudents(GCount%, R%, gndr)
    
    
                                Dim RetMul As Double = If(edpriintnm(R%, NGender) > 1, edpriintnm(R%, NGender), edpriintnm(R%, gndr))
                                If GCount% = 2 Then
                                    RetMul = 1 + (RetMul - 1) * 2      'dropouts were higher between 1st and second grade
                                ElseIf GCount% = 3 Then
                                    RetMul = 1 + (RetMul - 1) * 1.25
                                Else
                                    RetMul = 1 + (RetMul - 1) * 0.5 ' * Amin(0.9, AMAX(0.5, (edprilen(R%) + 1 - GCount%) / (edprilen(R%) - 3)))
                                End If
    
                                pristudents(GCount%, R%, gndr%) = CSng(pristudents(GCount%, R%, gndr%) * Amin(3, AMAX(1, RetMul)))
                                Dim Returnee = (pristudents(GCount%, R%, gndr%) - sPriStudents) * fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr) / 100
                                If Returnee > 0 Then
                                    For grcount% = 1 To 10
                                        outofschoolbyage(grcount%, R%, gndr%) = CSng(AMAX(0, outofschoolbyage(grcount%, R%, gndr%) - Returnee * outofschoolbyage(grcount%, R%, gndr%) / OutofSchooltot))
                                    Next
                                End If
                            End If
                        End If
                        'mti 2022/03/16 end
    
                        'Total student
                        EDPRITOT(R%, gndr) = CSng(EDPRITOT(R%, gndr) + fagedst(CInt(edpristart(R%)) + GCount% - 1, R%, gndr) *
                                        pristudents(GCount%, R%, gndr) / 100)
                    Next GCount%
    
                    'first graders from the new intake rate
                    pristudents(1, R%, gndr) = EDPRIINT(R%, gndr)
                    '    If GRPS(1,R%) = "Burundi" And gndr = 1 Then Stop
                    'add first graders to total students
                    EDPRITOT(R%, gndr) = CSng(EDPRITOT(R%, gndr) + fagedst(CInt(edpristart(R%)), R%, gndr) * pristudents(1, R%, gndr) / 100)
                    'All Years but First: Primary Final: Completion/Graduation Rate (gross)
    
                    'CalEdPriCR = pristudents(edprilen(R%), R%, gndr) * (1 - drpoutgr(edprilen(R%)))
                    Dim CalEdPriCR = pristudents(CInt(edprilen(R%)), R%, gndr) * (1 - drpoutgr(CInt(edprilen(R%))))
    
                    '    If GRPS(1,R%) = "Brazil" And IY >= 15 Then Stop
                    '    If GRPS(1,R%) = "Solomon Islands" Then Stop
    
                    'mti 2016/07/16 start : halving shift time for countries like Malawi that reach 100% completion soon, but brought down by Shift factor
    
                    'revert back to 40
                    'converge initial shift, if any, in 40 years - 'mti check October 2008
    
    
                    'mti 2017/01/24 start
                    EDPRICR(R%, gndr) = AMAX(5, CalEdPriCR + ConvergeOverTime1(EDPRICRShift(R%, gndr), 0, 30))  '20 ' - 100 80
                    'EDPRICR(R%, gndr) = AMAX(5, CalEdPriCR + ConvergeOverTime1(EDPRICRShift(R%, gndr), 0, 40))  ' - 100 80
    
    
    
                    'EDPRICR(R%, gndr) = 0.2 * EDPRICR(R%, gndr) + 0.8 * sEDPRICR(R%, gndr)
                    '
                    '            sEDPRICR(R%, gndr%) = EDPRICR(R%, gndr%)
    
                    'mti 2017/01/24 End
                    'mti 2017/01/24 start
                    sEDPRICR(R%, gndr%) = EDPRICR(R%, gndr%)
                    'mti 2017/01/24 End
    
    
                    'EDPRICR(R%, gndr) = AMAX(5, CalEdPriCR + ConvergeOverTime1(EDPRICRShift(R%, gndr), 0, 20))  ' - 100 80
    
                    'mti 2016/07/16 start
    
                    'Number of completers/Graduates (gross)
                    EDPRIGRADS(R%, gndr) = CSng(fagedst(CInt(edpristart(R%) + edprilen(R%)), R%, gndr) * (EDPRICR(R%, gndr) / 100))
    
                    'All Years but First: Primary Final: Gross Enrolment Rate
                    Dim CalEdPriEnrG = Amin(150, (EDPRITOT(R%, gndr) / AMAX(0.0000001, pripop(R%, gndr))) * 100)
    
                    'converge initial shift, if any, in 20 years - 'mti check October 2008
                    EDPRIENRG(R%, gndr) = CalEdPriEnrG + edPrienrgshiftCur(R%, gndr) '10
    
                    EDPRITOT(R%, gndr) = EDPRIENRG(R%, gndr) * pripop(R%, gndr) / 100
    
                    'All Years but First: Primary Final: Total Students and Total Graduates: Both genders combined
                    EDPRITOT(R%, Total) = EDPRITOT(R%, Total) + EDPRITOT(R%, gndr)
                    EDPRIGRADS(R%, Total) = EDPRIGRADS(R%, Total) + EDPRIGRADS(R%, gndr)
    
    
                    'All Years but First: Primary Final: Net Enrolment
                    '   -------------------------------------------------
                    'net equivalent of (gross) dropout
                    Dim dout = AMAX(0, 1 - ((EDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1))))
                    Dim sdout = AMAX(0, 1 - ((sEDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1))))
    
                    'mti check for very small dropouts (close to 100% gross survival, e.g., Uzbekistan), the survival improvement ratio might be high even with low absolute improvements
                    Dim pridropoutnet = 0!
                    If sdout > 0.01 Then
                        pridropoutnet = CSng(AMAX(0, spridropoutnet(R%, gndr) * (dout / sdout)))
                    Else
                        Dim sratenet = CSng(Amin(100, 100 * ((1 - spridropoutnet(R%, gndr)) ^ (edprilen(R%) - 1))))
                        Dim srategap = CInt(Floor(100 - sratenet))
                        sratenet = ConvergeOverTimeRate(sratenet, 100, Amin(30, srategap))
    
                        'gross survival have already reached 100%; Net'll converge in next 20 years
                        pridropoutnet = CSng(AMAX(0, 1 - ((sratenet / 100) ^ (1 / (edprilen(R%) - 1)))))
                    End If
    
                    spridropoutnet(R%, gndr) = pridropoutnet
    
                    'All Years but First: Primary Final: Net Enrollment: Students
                    Dim edpritotNet = 0!
                    For GCount% = CInt(edprilen(R%)) To 2 Step -1
                        'students carried forward to the subsequent grades - using gradewise array saved before budget intervention
                        PristudentsNet(GCount%, R%, gndr) = PristudentsNet(GCount% - 1, R%, gndr) * (1 - pridropoutnet)
                        'Total student
                        edpritotNet = CSng(edpritotNet + fagedst(CInt(edpristart(R%)) + GCount% - 1, R%, gndr) *
                                        PristudentsNet(GCount%, R%, gndr) / 100)
                    Next GCount%
                    'first graders from the net intake rate
                    PristudentsNet(1, R%, gndr) = EDPRIINTN(R%, gndr)
    
                    'add first graders to total students
                    edpritotNet = CSng(edpritotNet + fagedst(CInt(edpristart(R%)), R%, gndr) * PristudentsNet(1, R%, gndr) / 100)
    
                    EDPRIENRN(R%, gndr) = Amin(100, (100 * edpritotNet / pripop(R%, gndr)) + ConvergeOverTime1(edprienrnshift(R%, gndr), 0, 40)) ' caledprienrn
                    '
                    '   All Years but First: Primary Final: Compute Primary Educated Adults- Total and by 5 year cohorts
                    '   ------------------------------------------------------------------------------------------------
    
                    'Percentage of 15+ that completed primary
                    EDPRIPER(R%, gndr) = 0
    
    
                    'advance primary educated across cohort borders
                    For j% = NCohorts To 5 Step -1
                        EdPriPopPer(j%, R%, gndr) = EdPriPopPer(j%, R%, gndr) +
                         EdPriPopPer(j% - 1, R%, gndr) / 5 - EdPriPopPer(j%, R%, gndr) / 5
                        EDPRIPER(R%, gndr) = CSng(EDPRIPER(R%, gndr) + EdPriPopPer(j%, R%, gndr) *
                         agedst(j%, R%, gndr))
    
                    Next j%
    
                    'If IY = 2 And gndr = 1 And EdPriPopPer(4, R%, gndr) > EDPRICR(R, gndr) Then Stop
                    'add (net) graduates to the bottom cohort
                    'mti 2024/01/09 start 'PEPPRI(R%, gndr),
                    Dim prigrate = AMAX(1, Amin(100, EDPRICR(R%, gndr)))
                    'just in case primary school graduation data is less than primary adult completion rate and the spread results in a lower rate for 15-19
                    prigrate = AMAX(1, Amin(100, prigrate * ConvergeOverTime(PEPPRI(R%, gndr), 1, 15)))
                    'mti 2024/01/09 end
    
                    EdPriPopPer(4, R%, gndr) = Amin(100, AMAX(0.000001, (4 * EdPriPopPer(4, R%, gndr) + prigrate) / 5))
    
                    'mti 2024/01/14 start 
                    EDPRIPER(R%, gndr) = CSng(EDPRIPER(R%, gndr) + EdPriPopPer(4, R%, gndr) * agedst(4, R%, gndr))
    
                    EDPRIPER(R%, gndr) = AMAX(1, Amin(100, EDPRIPER(R%, gndr) / AMAX(0.0000001, AdultPop(R%, gndr)) + ConvergeOverTime(EPPShft(R%, gndr), 0, 70)))
                    EDPRIPER15TO24(R%, gndr) = AMAX(1, Amin(100, CSng(EdPriPopPer(4, R%, gndr) * agedst(4, R%, gndr) + EdPriPopPer(5, R%, gndr) * agedst(5, R%, gndr))))
    
                    'using 15+ shift for now: revise
                    EDPRIPER15TO24(R%, gndr) = AMAX(1, Amin(100, EDPRIPER15TO24(R%, gndr) / AMAX(0.0000001, AdultPop15to24(R%, gndr)) + ConvergeOverTime(EPPShft15to24(R%, gndr), 0, 70)))
                    'mti 2024/01/14 end
    
                Next gndr
    
                '   All Years but First: Primary Final: Totals of both genders: Final After Budget
                '   ------------------------------------------------------------------------------------------------
    PrimaryTotals(R%, AdultPop(R%, 1), AdultPop(R%, 2), AdultPop15to24(R%, 1), AdultPop15to24(R%, 2))
            ' ---- Begin Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:PrimaryTotals
    ' Private Sub PrimaryTotals(R%, AdultMales As Single, AdultFemales As Single, AdultMales15to24 As Single, AdultFemales15to24 As Single)
                        '----------------------------------------------------------------------------------
                        Dim PriBoys, PriGirls As Single
                        'mti 2016/01/07 - whole procedure
                        'Education Module - Total from male and female- Primary
            
                        '   First Year Primary: Average male and female to totals;
                        '   --------------------------------------------------------------------------------------------------
                        'EDPRIINT(R%%, Total) = (EDPRIINT(R%%, 1) * (agedst(2, R%%, 1) / 5) + EDPRIINT(R%%, 2) * (agedst(2, R%%, 2) / 5)) / AMAX(0.0000001, ((agedst(2, R%%, 1) + agedst(2, R%%, 2)) / 5))
                        EDPRIINT(R%%, Total) = CSng((EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) _
                                        + EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) _
                                        / AMAX(0.0000001, fagedst(CInt(edpristart(R%%)), R%%, 1) + fagedst(CInt(edpristart(R%%)), R%%, 2)))
            
                        EDPRIINTN(R%%, Total) = CSng((EDPRIINTN(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) _
                                        + EDPRIINTN(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) _
                                        / AMAX(0.0000001, fagedst(CInt(edpristart(R%%)), R%%, 1) + fagedst(CInt(edpristart(R%%)), R%%, 2)))
            
            
                        EDPRISUR(R%%, Total) = CSng(((EDPRISUR(R%%, 1) * EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) + EDPRISUR(R%%, 2) * EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) /
                        AMAX(0.0000001, (EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) + EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2))))) '* 100
            
                        'ttt 2019/10/08 
                        PriBoys = CalcPopFrom1YearDics("pri")(R%%, Male)
                        PriGirls = CalcPopFrom1YearDics("pri")(R%%, Female)
                        'PriBoys = CalcPopFrom1Year(CInt(edpristart(R%%)), edprilen(R%%), R%%, Male)
                        'PriGirls = CalcPopFrom1Year(CInt(edpristart(R%%)), edprilen(R%%), R%%, Female)
            
                        EDPRIENRG(R%%, Total) = (EDPRIENRG(R%%, 1) * PriBoys + EDPRIENRG(R%%, 2) * PriGirls) /
                                AMAX(0.0000001, PriBoys + PriGirls)
            
            
                        'mti January 14-20, 2005- total for first year - calculation of total in pre-processor ignored
                        EDPRIPER(R%%, Total) = (EDPRIPER(R%%, 1) * AdultPop(R%, 1) + EDPRIPER(R%%, 2) * AdultPop(R%, 2)) /
                    AMAX(0.0000001, (AdultPop(R%, 1) + AdultPop(R%, 2)))
            
                        'mti 2016/01/07 -start
                        EDPRIPER15TO24(R%%, Total) = (EDPRIPER15TO24(R%%, 1) * AdultPop15to24(R%, 1) + EDPRIPER15TO24(R%%, 2) * AdultPop15to24(R%, 2)) /
                    AMAX(0.0000001, (AdultPop15to24(R%, 1) + AdultPop15to24(R%, 2)))
                        'mti 2016/01/07 -end
            
                        EDPRIENRN(R%%, Total) = Amin(100, (EDPRIENRN(R%%, 1) * PriBoys + EDPRIENRN(R%%, 2) * PriGirls) /
                                AMAX(0.0000001, PriBoys + PriGirls))
            
            
                        EDPRICR(R%%, Total) = CSng((EDPRICR(R%%, Male) * fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Male) +
                            EDPRICR(R%%, Female) * fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Female)) /
                                AMAX(0.0000001, (fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Male) + fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Female))))
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:PrimaryTotals
' End Sub
    ' ---- End Inlined Level 2: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact
                    'jrs 2023/11/06 Return
                Else 'jrs 2023/11/06 else used to have Return, but that would exit the procedure on the first country, and didn't run the all years
                    'All Years but First: Primary Final: Calculate Budget Imppact
BudgetImpactParam = R% + spendcostRI(R%) + EDEXPERPRI + EDEXPERSECLOWR + EDEXPERSECUPPR + EDEXPERTER + EDPRITOT + EDSECLOWRTOT + EDSECUPPRTOT + EDTERTOT + GDPPC + GDS + GDSED @@BudgetImpactParam = CalcBudgetImpact("Primary", R%, spendcostRI(R%))@@
                    EXTRASTDRATIO(R%, Primary) = BudgetImpactParam

                    'All Years but First: Primary Final: Apply Budget Impact on Intake Rates (net and gross)
                    For gndr = 1 To NGender - 1

                        '        If GRPS(1,R%) = "Yemen" Then Stop
                        '
                        '        If GRPS(1,R%) = "Zimbabwe" Then Stop

                        'new budget impact
Dim intakefactorNet = BudgetImpactParam + EDPRIINTN(R%, gndr) + sedpriintn(R%, gndr) + edprilen(R%) @@Dim intakefactorNet = FlowFactor(BudgetImpactParam, EDPRIINTN(R%, gndr), 100, sedpriintn(R%, gndr), edprilen(R%), "Intk")@@

                        Dim addintakefactorNet = 100 * (BudgetImpactParam - 1) * intakefactorNet


                        If sCostPerDelta(R%, Primary) > 1 Then
                            'generates transient, e.g., Albania: 2029-2030
                            addintakefactorNet = AMAX(0, addintakefactorNet)  'cost is growing, do not let intake fall
                        End If

                        'mti 2016/12/09 start
                        'cap the change relative to last year: this cap is not there at the function output? also for normative?
                        'fEdIntk(R%, gndr, Primary) = Amin(sedpriintn(R%, gndr) + MxIntUp, AMAX(sedpriintn(R%, gndr) - MxIntDown, EDPRIINTN(R%, gndr) + addintakefactorNet))

                        'mti 2019/10/19 start
                        'mti 2019/03/01 start
                        'fEdIntk(R%, gndr, Primary) = Amin(sedpriintn(R%, gndr) + MxIntUp, AMAX(sedpriintn(R%, gndr) - MxIntDown, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100))))
                        'If edpriintnm(R%, gndr) < 1 Or edpriintnm(R%, NGender) < 1 Or gdsm(R%, Educ) < 1 Then
                        '    fEdIntk(R%, gndr, Primary) = CSng(Amin(100, AMAX(1, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100)))))
                        'Else
                        '    fEdIntk(R%, gndr, Primary) = CSng(Amin(sedpriintn(R%, gndr) + MxIntUp, AMAX(sedpriintn(R%, gndr) - MxIntDown, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100)))))
                        'End If
                        'mti 2019/03/01 End
                        'mti 2022/03/08 start
                        'mti 2022/03/16 start
                        'If edpriintnm(R%, gndr) <> 1 Or edpriintnm(R%, NGender) <> 1 Or gdsm(R%, Educ) <> 1 Then
                        If edpriintnm(R%, gndr) <> 1 Or edpriintnm(R%, NGender) <> 1 Then
                            'mti 2022/03/16 End
                            fEdIntk(R%, gndr, Primary) = CSng(Amin(100, AMAX(1, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100)))))
                            'mti 2022/03/08 End
                        Else
                            fEdIntk(R%, gndr, Primary) = CSng(Amin(sEdPriIntN_pre_qtql(R%, gndr) + MxIntUp, AMAX(sEdPriIntN_pre_qtql(R%, gndr) - MxIntDown, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100)))))
                        End If



                        'fEdIntk(R%, gndr, Primary) = Amin(sedpriintn(R%, gndr) + MxIntUp, AMAX(sedpriintn(R%, gndr) - MxIntDown, EDPRIINTN(R%, gndr) * (1 + (BudgetImpactParam - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100))))

                        'mti 2016/12/09 End

                        'bound the change to conform with definition
                        EDPRIINTN(R%, gndr) = AMAX(0.0001, Amin(100, fEdIntk(R%, gndr, Primary)))

                        sEdPriIntN_pre_qtql(R%, gndr) = EDPRIINTN(R%, gndr)
                        'sEdPriSur_pre_qtql()
                        'mti 2019/10/19 End

                        'Impact on gross intake  'what if net intake hit the bound of 100, abruptly?

                        'mti 2017/04/04 Start
                        'EDPRIINT(R%, gndr) = AMAX(0.0001, Amin(170, EDPRIINTN(R%, gndr) + cOvrAgeIntk_Pri(R%, gndr) * EDPRIINTN(R%, gndr) / iEdIntk(R%, gndr, Primary))) '150
                        EDPRIINT(R%, gndr) = AMAX(0.0001, Amin(170, EDPRIINTN(R%, gndr) + OverageInGr1Pcnt(R%, gndr%) * EDPRIINTN(R%, gndr) / iEdIntk(R%, gndr, Primary))) '150
                        'mti 2017/04/04 End

                        'mti check October 2008 - Quality quantity trade off - base value 1- not used any more - take out

                        'mti 2018/06/05 Start
                        EDPRIINTN(R%, gndr) = AMAX(0.0001, Amin(100, EDPRIINTN(R%, gndr) * edqtqltrm(R%, Primary))) '150
                        EDPRIINT(R%, gndr) = AMAX(0.0001, Amin(170, EDPRIINT(R%, gndr) * edqtqltrm(R%, Primary))) '150
                        'mti 2018/06/05 End


                    Next gndr

                    'If GRPS(1,R%) = "Comoros" Then Stop

                    'All Years but First: Primary Final: Apply Budget Impact on Survival Rates
                    For gndr = 1 To NGender - 1


                        'new budget impact

                        'mti 2016/12/09 start
                        'survgrowthfactor = FlowFactor(BudgetImpactParam, EDPRISUR(R%, gndr), 100, sedpriintn(R%, gndr), edprilen(R%))

Dim survgrowthfactor = BudgetImpactParam + EDPRISUR(R%, gndr) + sEDPRISUR(R%, gndr) + edprilen(R%) @@Dim survgrowthfactor = FlowFactor(BudgetImpactParam, EDPRISUR(R%, gndr), 100, sEDPRISUR(R%, gndr), edprilen(R%))@@
                        'mti 2016/12/09 end

                        'addSurvgrowthfactor = AMAX(MxSurDown, Amin(MxSurUp, 100 * (BudgetImpactParam - 1) * survgrowthfactor))
                        Dim addSurvgrowthfactor = 100 * (BudgetImpactParam - 1) * survgrowthfactor

                        '                'impact on survival
                        If sCostPerDelta(R%, Primary) > 1 Then
                            addSurvgrowthfactor = AMAX(0, addSurvgrowthfactor)  'cost is growing, do not let intake fall
                        End If
                        '        If GRPS(1,R%) = "Yemen" Then Stop
                        'mti 2016/12/09 start
                        'fEdSurv(R%, gndr, Primary) = Amin(sEDPRISUR(R%, gndr) + MxSurUp, AMAX(sEDPRISUR(R%, gndr) - MxSurDown, EDPRISUR(R%, gndr) + addSurvgrowthfactor))

                        'mti 2019/10/19 Start
                        'mti 2019/03/01 start
                        'fEdSurv(R%, gndr, Primary) = Amin(sEDPRISUR(R%, gndr) + MxSurUp, AMAX(sEDPRISUR(R%, gndr) - MxSurDown, EDPRISUR(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRISUR(R%, gndr)) / 100))))
                        'mti 2022/03/08 start
                        'mti 2022/03/16 start
                        'If edprisurm(R%, NGender) <> 1 Or edprisurm(R%, gndr%) <> 1 Or gdsm(R%, Educ) <> 1 Then
                        If edprisurm(R%, NGender) <> 1 Or edprisurm(R%, gndr%) <> 1 Then
                            'mti 2022/03/16 End
                            'mti 2022/03/08 End
                            fEdSurv(R%, gndr, Primary) = CSng(Amin(120, AMAX(1, EDPRISUR(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRISUR(R%, gndr)) / 100)))))
                        Else
                            'fEdSurv(R%, gndr, Primary) = Amin(sEDPRISUR(R%, gndr) + MxSurUp, AMAX(sEDPRISUR(R%, gndr) - MxSurDown, EDPRISUR(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRISUR(R%, gndr)) / 100))))
                            fEdSurv(R%, gndr, Primary) = CSng(Amin(sEdPriSur_pre_qtql(R%, gndr) + MxSurUp, AMAX(sEdPriSur_pre_qtql(R%, gndr) - MxSurDown, EDPRISUR(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRISUR(R%, gndr)) / 100)))))
                        End If
                        'mti 2019/03/01 End
                        EDPRISUR(R%, gndr) = AMAX(0.0001, Amin(100, fEdSurv(R%, gndr, Primary)))

                        sEdPriSur_pre_qtql(R%, gndr) = EDPRISUR(R%, gndr)
                        'sEdPriSur_pre_qtql()
                        'mti 2019/10/19 End

                        'mti check October 2008 - Quality quantity trade off - base value 1- not used any more - take out
                        'mti 2018/06/05 Start
                        EDPRISUR(R%, gndr) = AMAX(0.0001, Amin(100, EDPRISUR(R%, gndr) * edqtqltrm(R%, Primary)))
                        'mti 2018/06/05 End


                    Next gndr

                    'All Years but First: Primary Final: Students, Enrollment and Graduates
                    'AfterPriBudgetImpact:
Call AfterPriBudgetImpact(R%)
    ' ---- Begin Inlined Level 2: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact
' Private Sub AfterPriBudgetImpact(R%)
                'AfterPriBudgetImpact:
    
    
                'primary initialize total student and graduates once more after budget
                EDPRITOT(R%%, Total) = 0
                EDPRIGRADS(R%%, Total) = 0
    
                For gndr = 1 To NGender - 1 'male/female, no total
    
                    'new budget code- moving average
                    sIntakeImpact(R%%, gndr, Primary) = CSng(0.8 * sIntakeImpact(R%%, gndr, Primary) + 0.2 * sIntakeImpact(R%%, gndr, Primary) * fEdIntk(R%%, gndr, Primary) / iEdIntk(R%%, gndr, Primary))
                    sSurvImpact(R%%, gndr, Primary) = CSng(0.8 * sSurvImpact(R%%, gndr, Primary) + 0.2 * sSurvImpact(R%%, gndr, Primary) * fEdSurv(R%%, gndr, Primary) / iEdSurv(R%%, gndr, Primary))
    
                    '     If GRPS(1,R%%) = "Burundi" Then Stop
                    'dropout - grade-specific
    Call DropoutSpread(edprilen(R%%), EDPRISUR(R%%, gndr), drpoutgr)
            ' ---- Begin Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:DropoutSpread
    ' Private Sub DropoutSpread(lencycle As Single, Survival As Single, ByRef Arr_Dropout() As Single)
                        '-----------------------------------------------------------------------------------
                        ' Education Module - Calculates a seperate dropout rate for each grade
                        ' Assumes dropout in the first grade is twice the average dropout rate; all other grades average out the rest of the dropout
                        Dim Dropoutrate, G2Enr As Single
                        Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%%, gndr) / 100) ^ (1 / (edprilen(R%%) - 1)))))
            
                        'mti April 05, 2012 -start
                        drpoutgr(1) = Dropoutrate
            
            
                        'mti 2017/01/24 start
                        If EDPRISUR(R%%, gndr) < 100 Then  'was 90
                            'mti 2017/01/24 end
            
            
            
                            'If dropoutrate < 0.4 And GDPPCP(R%%) < 4 Then
                            drpoutgr(1) = CSng(Amin(0.5, Dropoutrate * 2))
            
            
            
                            G2Enr = 1 - drpoutgr(1)
                            Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%%, gndr) / G2Enr / 100) ^ (1 / (edprilen(R%%) - 2))))) 'dropout rate for gender
                            'End If
            
            
                            For GCount% = 2 To CInt(edprilen(R%%))
                                drpoutgr(GCount%) = Dropoutrate
                            Next GCount%
            
                        Else
                            For GCount% = 2 To CInt(edprilen(R%%))
                                drpoutgr(GCount%) = Dropoutrate
                            Next GCount%
                        End If
                        'mti April 05, 2012 -end
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:DropoutSpread
                    EDPRITOT(R%%, gndr) = 0
    
                    'save first grade dropouts to add in the over-age pool
                    DropOut1st_No(R%%, gndr) = CSng(drpoutgr(1) * fagedst(CInt(edpristart(R%%)) + 1, R%%, gndr) * SaveStudentCohorts(R%%, 1, gndr, 1) / 100)
    
                    'mti 2022/03/16 start - shock rebound
                    Dim OutofSchooltot As Single = 0
                    For grcount% = 1 To 10
                        OutofSchooltot = OutofSchooltot + outofschoolbyage(grcount%, R%%, gndr%)
                    Next
                    'mti 2022/03/16 end
    
                    'All Years but First: Primary Final: grade-specific enrolment rates and total enrolment
                    For GCount% = CInt(edprilen(R%%)) To 2 Step -1
                        'students carried forward to the subsequent grades - using gradewise array (from previous year) saved before budget intervention
                        pristudents(GCount%, R%%, gndr) = SaveStudentCohorts(R%%, GCount% - 1, gndr, 1) * (1 - drpoutgr(GCount% - 1))
    
                        'mti 2022/03/16 start - shock rebound
                        If edpriintnm(R%%, NGender) > 1 Or edpriintnm(R%%, gndr) > 1 Then
                            '         If RegName(R%%) = "Uganda" Then Stop
    
                            Dim OutofSchooltotRunning As Single = 0
                            For grcount% = 1 To 10
                                OutofSchooltotRunning = OutofSchooltotRunning + outofschoolbyage(grcount%, R%%, gndr%)
                            Next
                            If OutofSchooltot > 0 And OutofSchooltotRunning > 0 Then
                                Dim sPriStudents = pristudents(GCount%, R%%, gndr)
    
    
                                Dim RetMul As Double = If(edpriintnm(R%%, NGender) > 1, edpriintnm(R%%, NGender), edpriintnm(R%%, gndr))
                                If GCount% = 2 Then
                                    RetMul = 1 + (RetMul - 1) * 2      'dropouts were higher between 1st and second grade
                                ElseIf GCount% = 3 Then
                                    RetMul = 1 + (RetMul - 1) * 1.25
                                Else
                                    RetMul = 1 + (RetMul - 1) * 0.5 ' * Amin(0.9, AMAX(0.5, (edprilen(R%%) + 1 - GCount%) / (edprilen(R%%) - 3)))
                                End If
    
                                pristudents(GCount%, R%%, gndr%) = CSng(pristudents(GCount%, R%%, gndr%) * Amin(3, AMAX(1, RetMul)))
                                Dim Returnee = (pristudents(GCount%, R%%, gndr%) - sPriStudents) * fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, gndr) / 100
                                If Returnee > 0 Then
                                    For grcount% = 1 To 10
                                        outofschoolbyage(grcount%, R%%, gndr%) = CSng(AMAX(0, outofschoolbyage(grcount%, R%%, gndr%) - Returnee * outofschoolbyage(grcount%, R%%, gndr%) / OutofSchooltot))
                                    Next
                                End If
                            End If
                        End If
                        'mti 2022/03/16 end
    
                        'Total student
                        EDPRITOT(R%%, gndr) = CSng(EDPRITOT(R%%, gndr) + fagedst(CInt(edpristart(R%%)) + GCount% - 1, R%%, gndr) *
                                        pristudents(GCount%, R%%, gndr) / 100)
                    Next GCount%
    
                    'first graders from the new intake rate
                    pristudents(1, R%%, gndr) = EDPRIINT(R%%, gndr)
                    '    If GRPS(1,R%%) = "Burundi" And gndr = 1 Then Stop
                    'add first graders to total students
                    EDPRITOT(R%%, gndr) = CSng(EDPRITOT(R%%, gndr) + fagedst(CInt(edpristart(R%%)), R%%, gndr) * pristudents(1, R%%, gndr) / 100)
                    'All Years but First: Primary Final: Completion/Graduation Rate (gross)
    
                    'CalEdPriCR = pristudents(edprilen(R%%), R%%, gndr) * (1 - drpoutgr(edprilen(R%%)))
                    Dim CalEdPriCR = pristudents(CInt(edprilen(R%%)), R%%, gndr) * (1 - drpoutgr(CInt(edprilen(R%%))))
    
                    '    If GRPS(1,R%%) = "Brazil" And IY >= 15 Then Stop
                    '    If GRPS(1,R%%) = "Solomon Islands" Then Stop
    
                    'mti 2016/07/16 start : halving shift time for countries like Malawi that reach 100% completion soon, but brought down by Shift factor
    
                    'revert back to 40
                    'converge initial shift, if any, in 40 years - 'mti check October 2008
    
    
                    'mti 2017/01/24 start
                    EDPRICR(R%%, gndr) = AMAX(5, CalEdPriCR + ConvergeOverTime1(EDPRICRShift(R%%, gndr), 0, 30))  '20 ' - 100 80
                    'EDPRICR(R%%, gndr) = AMAX(5, CalEdPriCR + ConvergeOverTime1(EDPRICRShift(R%%, gndr), 0, 40))  ' - 100 80
    
    
    
                    'EDPRICR(R%%, gndr) = 0.2 * EDPRICR(R%%, gndr) + 0.8 * sEDPRICR(R%%, gndr)
                    '
                    '            sEDPRICR(R%%, gndr%) = EDPRICR(R%%, gndr%)
    
                    'mti 2017/01/24 End
                    'mti 2017/01/24 start
                    sEDPRICR(R%%, gndr%) = EDPRICR(R%%, gndr%)
                    'mti 2017/01/24 End
    
    
                    'EDPRICR(R%%, gndr) = AMAX(5, CalEdPriCR + ConvergeOverTime1(EDPRICRShift(R%%, gndr), 0, 20))  ' - 100 80
    
                    'mti 2016/07/16 start
    
                    'Number of completers/Graduates (gross)
                    EDPRIGRADS(R%%, gndr) = CSng(fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, gndr) * (EDPRICR(R%%, gndr) / 100))
    
                    'All Years but First: Primary Final: Gross Enrolment Rate
                    Dim CalEdPriEnrG = Amin(150, (EDPRITOT(R%%, gndr) / AMAX(0.0000001, pripop(R%%, gndr))) * 100)
    
                    'converge initial shift, if any, in 20 years - 'mti check October 2008
                    EDPRIENRG(R%%, gndr) = CalEdPriEnrG + edPrienrgshiftCur(R%%, gndr) '10
    
                    EDPRITOT(R%%, gndr) = EDPRIENRG(R%%, gndr) * pripop(R%%, gndr) / 100
    
                    'All Years but First: Primary Final: Total Students and Total Graduates: Both genders combined
                    EDPRITOT(R%%, Total) = EDPRITOT(R%%, Total) + EDPRITOT(R%%, gndr)
                    EDPRIGRADS(R%%, Total) = EDPRIGRADS(R%%, Total) + EDPRIGRADS(R%%, gndr)
    
    
                    'All Years but First: Primary Final: Net Enrolment
                    '   -------------------------------------------------
                    'net equivalent of (gross) dropout
                    Dim dout = AMAX(0, 1 - ((EDPRISUR(R%%, gndr) / 100) ^ (1 / (edprilen(R%%) - 1))))
                    Dim sdout = AMAX(0, 1 - ((sEDPRISUR(R%%, gndr) / 100) ^ (1 / (edprilen(R%%) - 1))))
    
                    'mti check for very small dropouts (close to 100% gross survival, e.g., Uzbekistan), the survival improvement ratio might be high even with low absolute improvements
                    Dim pridropoutnet = 0!
                    If sdout > 0.01 Then
                        pridropoutnet = CSng(AMAX(0, spridropoutnet(R%%, gndr) * (dout / sdout)))
                    Else
                        Dim sratenet = CSng(Amin(100, 100 * ((1 - spridropoutnet(R%%, gndr)) ^ (edprilen(R%%) - 1))))
                        Dim srategap = CInt(Floor(100 - sratenet))
                        sratenet = ConvergeOverTimeRate(sratenet, 100, Amin(30, srategap))
    
                        'gross survival have already reached 100%; Net'll converge in next 20 years
                        pridropoutnet = CSng(AMAX(0, 1 - ((sratenet / 100) ^ (1 / (edprilen(R%%) - 1)))))
                    End If
    
                    spridropoutnet(R%%, gndr) = pridropoutnet
    
                    'All Years but First: Primary Final: Net Enrollment: Students
                    Dim edpritotNet = 0!
                    For GCount% = CInt(edprilen(R%%)) To 2 Step -1
                        'students carried forward to the subsequent grades - using gradewise array saved before budget intervention
                        PristudentsNet(GCount%, R%%, gndr) = PristudentsNet(GCount% - 1, R%%, gndr) * (1 - pridropoutnet)
                        'Total student
                        edpritotNet = CSng(edpritotNet + fagedst(CInt(edpristart(R%%)) + GCount% - 1, R%%, gndr) *
                                        PristudentsNet(GCount%, R%%, gndr) / 100)
                    Next GCount%
                    'first graders from the net intake rate
                    PristudentsNet(1, R%%, gndr) = EDPRIINTN(R%%, gndr)
    
                    'add first graders to total students
                    edpritotNet = CSng(edpritotNet + fagedst(CInt(edpristart(R%%)), R%%, gndr) * PristudentsNet(1, R%%, gndr) / 100)
    
                    EDPRIENRN(R%%, gndr) = Amin(100, (100 * edpritotNet / pripop(R%%, gndr)) + ConvergeOverTime1(edprienrnshift(R%%, gndr), 0, 40)) ' caledprienrn
                    '
                    '   All Years but First: Primary Final: Compute Primary Educated Adults- Total and by 5 year cohorts
                    '   ------------------------------------------------------------------------------------------------
    
                    'Percentage of 15+ that completed primary
                    EDPRIPER(R%%, gndr) = 0
    
    
                    'advance primary educated across cohort borders
                    For j% = NCohorts To 5 Step -1
                        EdPriPopPer(j%, R%%, gndr) = EdPriPopPer(j%, R%%, gndr) +
                         EdPriPopPer(j% - 1, R%%, gndr) / 5 - EdPriPopPer(j%, R%%, gndr) / 5
                        EDPRIPER(R%%, gndr) = CSng(EDPRIPER(R%%, gndr) + EdPriPopPer(j%, R%%, gndr) *
                         agedst(j%, R%%, gndr))
    
                    Next j%
    
                    'If IY = 2 And gndr = 1 And EdPriPopPer(4, R%%, gndr) > EDPRICR(R%, gndr) Then Stop
                    'add (net) graduates to the bottom cohort
                    'mti 2024/01/09 start 'PEPPRI(R%%, gndr),
                    Dim prigrate = AMAX(1, Amin(100, EDPRICR(R%%, gndr)))
                    'just in case primary school graduation data is less than primary adult completion rate and the spread results in a lower rate for 15-19
                    prigrate = AMAX(1, Amin(100, prigrate * ConvergeOverTime(PEPPRI(R%%, gndr), 1, 15)))
                    'mti 2024/01/09 end
    
                    EdPriPopPer(4, R%%, gndr) = Amin(100, AMAX(0.000001, (4 * EdPriPopPer(4, R%%, gndr) + prigrate) / 5))
    
                    'mti 2024/01/14 start 
                    EDPRIPER(R%%, gndr) = CSng(EDPRIPER(R%%, gndr) + EdPriPopPer(4, R%%, gndr) * agedst(4, R%%, gndr))
    
                    EDPRIPER(R%%, gndr) = AMAX(1, Amin(100, EDPRIPER(R%%, gndr) / AMAX(0.0000001, AdultPop(R%%, gndr)) + ConvergeOverTime(EPPShft(R%%, gndr), 0, 70)))
                    EDPRIPER15TO24(R%%, gndr) = AMAX(1, Amin(100, CSng(EdPriPopPer(4, R%%, gndr) * agedst(4, R%%, gndr) + EdPriPopPer(5, R%%, gndr) * agedst(5, R%%, gndr))))
    
                    'using 15+ shift for now: revise
                    EDPRIPER15TO24(R%%, gndr) = AMAX(1, Amin(100, EDPRIPER15TO24(R%%, gndr) / AMAX(0.0000001, AdultPop15to24(R%%, gndr)) + ConvergeOverTime(EPPShft15to24(R%%, gndr), 0, 70)))
                    'mti 2024/01/14 end
    
                Next gndr
    
                '   All Years but First: Primary Final: Totals of both genders: Final After Budget
                '   ------------------------------------------------------------------------------------------------
    PrimaryTotals(R%%, AdultPop(R%%, 1), AdultPop(R%%, 2), AdultPop15to24(R%%, 1), AdultPop15to24(R%%, 2))
            ' ---- Begin Inlined Level 3: IFsEducPri2AllYearsButFirst:AfterPriBudgetImpact:PrimaryTotals
    ' Private Sub PrimaryTotals(R%%, AdultMales As Single, AdultFemales As Single, AdultMales15to24 As Single, AdultFemales15to24 As Single)
                        '----------------------------------------------------------------------------------
                        Dim PriBoys, PriGirls As Single
                        'mti 2016/01/07 - whole procedure
                        'Education Module - Total from male and female- Primary
            
                        '   First Year Primary: Average male and female to totals;
                        '   --------------------------------------------------------------------------------------------------
                        'EDPRIINT(R%%%, Total) = (EDPRIINT(R%%%, 1) * (agedst(2, R%%%, 1) / 5) + EDPRIINT(R%%%, 2) * (agedst(2, R%%%, 2) / 5)) / AMAX(0.0000001, ((agedst(2, R%%%, 1) + agedst(2, R%%%, 2)) / 5))
                        EDPRIINT(R%%%, Total) = CSng((EDPRIINT(R%%%, 1) * fagedst(CInt(edpristart(R%%%)), R%%%, 1) _
                                        + EDPRIINT(R%%%, 2) * fagedst(CInt(edpristart(R%%%)), R%%%, 2)) _
                                        / AMAX(0.0000001, fagedst(CInt(edpristart(R%%%)), R%%%, 1) + fagedst(CInt(edpristart(R%%%)), R%%%, 2)))
            
                        EDPRIINTN(R%%%, Total) = CSng((EDPRIINTN(R%%%, 1) * fagedst(CInt(edpristart(R%%%)), R%%%, 1) _
                                        + EDPRIINTN(R%%%, 2) * fagedst(CInt(edpristart(R%%%)), R%%%, 2)) _
                                        / AMAX(0.0000001, fagedst(CInt(edpristart(R%%%)), R%%%, 1) + fagedst(CInt(edpristart(R%%%)), R%%%, 2)))
            
            
                        EDPRISUR(R%%%, Total) = CSng(((EDPRISUR(R%%%, 1) * EDPRIINT(R%%%, 1) * fagedst(CInt(edpristart(R%%%)), R%%%, 1) + EDPRISUR(R%%%, 2) * EDPRIINT(R%%%, 2) * fagedst(CInt(edpristart(R%%%)), R%%%, 2)) /
                        AMAX(0.0000001, (EDPRIINT(R%%%, 1) * fagedst(CInt(edpristart(R%%%)), R%%%, 1) + EDPRIINT(R%%%, 2) * fagedst(CInt(edpristart(R%%%)), R%%%, 2))))) '* 100
            
                        'ttt 2019/10/08 
                        PriBoys = CalcPopFrom1YearDics("pri")(R%%%, Male)
                        PriGirls = CalcPopFrom1YearDics("pri")(R%%%, Female)
                        'PriBoys = CalcPopFrom1Year(CInt(edpristart(R%%%)), edprilen(R%%%), R%%%, Male)
                        'PriGirls = CalcPopFrom1Year(CInt(edpristart(R%%%)), edprilen(R%%%), R%%%, Female)
            
                        EDPRIENRG(R%%%, Total) = (EDPRIENRG(R%%%, 1) * PriBoys + EDPRIENRG(R%%%, 2) * PriGirls) /
                                AMAX(0.0000001, PriBoys + PriGirls)
            
            
                        'mti January 14-20, 2005- total for first year - calculation of total in pre-processor ignored
                        EDPRIPER(R%%%, Total) = (EDPRIPER(R%%%, 1) * AdultPop(R%%, 1) + EDPRIPER(R%%%, 2) * AdultPop(R%%, 2)) /
                    AMAX(0.0000001, (AdultPop(R%%, 1) + AdultPop(R%%, 2)))
            
                        'mti 2016/01/07 -start
                        EDPRIPER15TO24(R%%%, Total) = (EDPRIPER15TO24(R%%%, 1) * AdultPop15to24(R%%, 1) + EDPRIPER15TO24(R%%%, 2) * AdultPop15to24(R%%, 2)) /
                    AMAX(0.0000001, (AdultPop15to24(R%%, 1) + AdultPop15to24(R%%, 2)))
                        'mti 2016/01/07 -end
            
                        EDPRIENRN(R%%%, Total) = Amin(100, (EDPRIENRN(R%%%, 1) * PriBoys + EDPRIENRN(R%%%, 2) * PriGirls) /
                                AMAX(0.0000001, PriBoys + PriGirls))
            
            
                        EDPRICR(R%%%, Total) = CSng((EDPRICR(R%%%, Male) * fagedst(CInt(edpristart(R%%%) + edprilen(R%%%)), R%%%, Male) +
                            EDPRICR(R%%%, Female) * fagedst(CInt(edpristart(R%%%) + edprilen(R%%%)), R%%%, Female)) /
                                AMAX(0.0000001, (fagedst(CInt(edpristart(R%%%) + edprilen(R%%%)), R%%%, Male) + fagedst(CInt(edpristart(R%%%) + edprilen(R%%%)), R%%%, Female))))
            
    ' End Sub
