                    Dim MidEnrAvg = (EDPRIENRG(R%, gndr) * CInt(edprilen(R%)) - pGradeStudents(1) - pGradeStudents(CInt(edprilen(R%)))) / (CInt(edprilen(R%)) - 2)
    
                    Dim MidGrade1% = CInt(edprilen(R%)) \ 2 + 1
                    Dim MidGrade2% = MidGrade1
