                ''        EdUpprSecPopPer(j%, R%%, gndr%) = CSng(AMAX(0.00001, 100 * (EdUpprSecPopPer(j%, R%%, gndr%) * agedst(j%, R%%, gndr%) / 100 + Weighted_Adjustment) / agedst(j%, R%%, gndr%)))
