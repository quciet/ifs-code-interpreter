                    'EDSECLOWRGRATE(R%, Male) = Amin(100, AMAX(1, EDSECLOWRGRATE(R%, Female) * gndreqintnProg))
                    EDSECLOWRGRATE(R%, Male) = AMAX(0.01, EDSECLOWRGRATE(R%, Female) * gndreqintnProg)
                End If
    
    
