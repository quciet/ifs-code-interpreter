                        End If
            
            
                        'gradewise enrolment rates and total enrolment
                        For GCount% = CInt(edsecupprlen(R%)) To 2 Step -1
                            If SaveGradeEnrRate Then
                                'save last year's grade enrollment rates for later use
                                SaveSecLowUpStudentCohorts(R%%, GCount%, gndr%, 2%) = secupprstudents(GCount%, R%%, gndr%)
            
                                'apply dropout to last year's grade enrollment rates - saved last year
                                If Dropoutrate = 8888 Then 'dropout by grade
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - dropoutgr(GCount% - 1))
                                Else 'single average dropout rate
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - Dropoutrate)
                                End If
