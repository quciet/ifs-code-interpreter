            Dim terperstdntDollar, expendpri, expendseclowr, expendsecuppr, expendter, expendsec As Single
            terperstdntDollar = EDEXPERTER(R%%) * GDPPC(R%%) * 10
            'expenditure not by gender - Add both genders to get total students
            'in billion dollars -> dollars per student / 1000 * million students
            expendpri = priperstdntDollar / 1000 * (EDPRITOT(R%%, 1) + EDPRITOT(R%%, 2))

            expendseclowr = seclowrperstdntDollar / 1000 * (EDSECLOWRTOT(R%%, 1) + EDSECLOWRTOT(R%%, 2))
            expendsecuppr = secupprperstdntDollar / 1000 * (EDSECUPPRTOT(R%%, 1) + EDSECUPPRTOT(R%%, 2))



            expendter = terperstdntDollar / 1000 * (EDTERTOT(R%%, 1) + EDTERTOT(R%%, 2))  'EDTERTOT(R%%)

            expendsec = expendseclowr + expendsecuppr
            'calculate secondary per student using upper and lower
            EDEXPERSEC(R%%) = 100 * expendsec / (EDSECTOT(R%%, 1) + EDSECTOT(R%%, 2)) / GDPPC(R%%)


            Dim calctotcost As Single
            calctotcost = expendpri + expendsec + expendter
            'If GRPS(1,R%%) = "Guatemala" Then Stop
