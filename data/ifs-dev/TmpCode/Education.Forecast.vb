                    'first-grade: primary-level age students as a multiple of primary-entrance age students: initial year ratio
                    'PriNIRAsShrOfPrimAgeG1(R%, gndr%) = AMAX(1, PristudentsNet(1, R%, gndr%) / EDPRIINTN(R%, gndr%))
                    PrimAgeG1Shift(R%, gndr%) = AMAX(0, PristudentsNet(1, R%, gndr%) - EDPRIINTN(R%, gndr%))


                    'mti 2021/03/07
                    'Unbounded net intake (of-age, plus 1, minus 1)
                    EdPriIntnRat(R%, gndr%) = EDPRIINTNEXT(R%, gndr%) / EDPRIINTN(R%, gndr%)
                    i1EdPriIntN(R%, gndr%) = EDPRIINTN(R%, gndr%)


                    'net dropout rate same as gross
                    For GCount% = 1 To CInt(edprilen(R%))
                        'mti 2022/04/12 Start
                        'EdPriDropoutByGradeNet(GCount, R%, gndr%) = EdPriDropoutByGrade(GCount, R%, gndr%)
                        EdPriDropoutByGradeNet(GCount, R%, gndr%) = EDPRIDRPGRD(R%, GCount%, gndr%)
                        'mti 2022/04/12 End
                    Next

                    '   First Year Primary: Compute overage entrants as a share of out of school children
                    '=====================================================================================

                    'mti 2020/09/01 End

                    'out of school children at the beginning of a year are the children from the preceding year, who
                    'a. were of entrance age but missed entry, or, b. were already out of school, or, c. dropped out during the preceding year
                    'mti 2021/02/18

                    ' If GRPS(1, R%) = "Solomon Islands" Then Stop

                    'were of entrance age but missed entry
                    Dim Missed_Entrance = fagedst(CInt(edpristart(R%)), R%, gndr%) * (100 - EDPRIINTN(R%, gndr%)) / 100  'The second term will bring same result as AMAX(0, 100 - EDPRIINTNEXT(R%, gndr%)); it's more convenient to explain the way it is

                    'were already out of school, above entrance age but within primary age; with the assumption that above primary age won't return to school unless just dropped out
                    Dim StudentsTot = fagedst(CInt(edpristart(R%)), R%, gndr%) * (PristudentsNet(1, R%, gndr%) - EDPRIINTN(R%, gndr%)) / 100
                    Dim PopTot As Double? = 0 ' fagedst(cint(edpristart(R%)), R%, gndr%)
                    For GCount% = 2 To CInt(edprilen(R%))
                        StudentsTot = StudentsTot + fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr%) * PristudentsNet(GCount%, R%, gndr%) / 100
                        PopTot = PopTot + fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr%)
                    Next
                    Dim Already_Out_Of_School = AMAX(0, PopTot - StudentsTot)

                    'dropped out during the preceding year
                    Dim Just_Dropped_Out As Double = 0
                    For GCount = 1 To CInt(edprilen(R%)) - 1   '3
                        Just_Dropped_Out = Just_Dropped_Out + pristudents(GCount%, R%, gndr%) * EdPriDropoutByGrade(GCount%, R%, gndr%) * fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr) / 100
                    Next

                    'Total out of school this year, a portion of whom might potentially enter school as overage entrants
                    Already_Out_Of_School = Already_Out_Of_School '* 1.25 'mti 2021/04/19

                    Dim OutofSchoolTot = Missed_Entrance + Already_Out_Of_School + Just_Dropped_Out  'OutofSchool_Dropouts_Lower +



                    'Overage entrance this year - head count
                    OverageInGr1Count(R%, gndr%) = CSng(AMAX(0, EDPRIINT(R%, gndr%) - EDPRIINTNEXT(R%, gndr%)) * fagedst(CInt(edpristart(R%)), R%, gndr) / 100) 'this can also be gross - net in 1st grade


                    'overage entrants as a share of out of school children
                    If OutofSchoolTot > 0 Then
                        RetGr1Pcnt(R%, gndr%) = CSng(OverageInGr1Count(R%, gndr%) / OutofSchoolTot)
                    Else
                        RetGr1Pcnt(R%, gndr%) = 0
                    End If

                    OverageInGr1Pcnt(R%, gndr%) = AMAX(0, EDPRIINT(R%, gndr%) - EDPRIINTNEXT(R%, gndr%))

                    'Save age cohorts for next year
                    For Agecnt% = 1 To NAges
                        sfagedst(Agecnt, R%, gndr%) = fagedst(Agecnt, R%, gndr%)
                    Next


                    'Print #99, "New," & IY & "," & Replace(GRPS(1, R%), ",", " ") & "," & gndr% & "," & Round(OutofSchoolTot, 4) & "," & Round(RetGr1Pcnt(R%, gndr%), 4) & "," & Round(OverageInGr1Pcnt(R%, gndr%), 4) & "," & EDPRIINT(R%, gndr%) & "," & EDPRIINTN(R%, gndr%) & "," & EDPRISUR(R%, gndr%) & "," & EDPRIENRN(R%, gndr%) & "," & EDPRIENRG(R%, gndr%) & "," & EDPRICR(R%, gndr%) & "," & Round(Missed_Entrance, 4) & "," & Round(Already_Out_Of_School, 4) & "," & Round(Just_Dropped_Out, 4)


                    '   First Year Primary: Distribute (15+) Adult Population with Primary Education Across 5 year Cohorts
                    '=====================================================================================================
                    'mti 2024/05/23 start
                    ''mti 2024/01/09 start
                    ''Call SpreadAdultPri(R%, gndr, AdultPop(R%, gndr), AdultPop15to24(R%, gndr), EdPriPopPer, sEdPriPopPer, EPPShft(R%, gndr), EPPShft15to24(R%, gndr))
                    'Call SpreadAdultPri(R%, gndr, AdultPop(R%, gndr), AdultPop15to24(R%, gndr), EdPriPopPer, PEPPRI(R%, gndr), EPPShft(R%, gndr), EPPShft15to24(R%, gndr))
                    ''mti 2024/01/09 end


Call SpreadAdultPriData(R%, gndr, AdultPop(R%, gndr), AdultPop15to24(R%, gndr), EdPriPopPer, PEPPRI(R%, gndr), EPPShft(R%, gndr), EPPShft15to24(R%, gndr), EdAttnPrimaryData)
    ' ---- Begin Inlined Level 2: IFsEducPri_new_init:SpreadAdultPriData
