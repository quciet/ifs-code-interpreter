                            fEdSurv(R%, gndr, Primary) = CSng(Amin(sEdPriSur_pre_qtql(R%, gndr) + MxSurUp, AMAX(sEdPriSur_pre_qtql(R%, gndr) - MxSurDown, EDPRISUR(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRISUR(R%, gndr)) / 100)))))
                        End If
                        'mti 2019/03/01 End
    
                        EDPRISUR(R%, gndr) = AMAX(0.0001, Amin(100, fEdSurv(R%, gndr, Primary)))
    
    
                        sEdPriSur_pre_qtql(R%, gndr) = EDPRISUR(R%, gndr)
    
                        'mti check October 2008 - Quality quantity trade off - base value 1- not used any more - take out
