                'Gender Parity Parameter
GenderParityCalc(edseclowrgndreqtran(R%), EDSECLOWRTRAN(R%, Male), EDSECLOWRTRAN(R%, Female), "SecLowr")
    ' ---- Begin Inlined Level 2: IFsEducSec_new_init:GenderParityCalc
' Private Sub GenderParityCalc(TargetYr As Single, ByRef RateMale As Single, ByRef RateFemale As Single, level$)
                'edseclowrgndreqtran(R%) = edprigndreqintn(R%), ValInit=edprigndreqintnI(R%)
    
                If edseclowrgndreqtran(R%) = 0 Then
                    Exit Sub
                End If
                If EDSECLOWRTRAN(R%, Male) = 0 Then
                    Exit Sub
                End If
                If EDSECLOWRTRAN(R%, Female) = 0 Then
                    Exit Sub
                End If
    
                Dim dampen_male As Integer
                dampen_male = 1
                If ("SecLowr"$ = "SecLowr" Or "SecLowr"$ = "SecUppr") And EDSECLOWRTRAN(R%, Male) < EDSECLOWRTRAN(R%, Female) Then
                    dampen_male = 5
                End If
                'moving base to avoid problems at gender crossover
                Dim ValInit, TargetYr_Prop, gndreqintnProg As Single
                ValInit = EDSECLOWRTRAN(R%, Male) / EDSECLOWRTRAN(R%, Female)
                'edseclowrgndreqtran(R%) = edprigndreqintn(R%) ' take start/end time through driver
    
    
                'if edseclowrgndreqtran(R%)=10 GPI merges 1% a year, with edseclowrgndreqtran(R%)=7 GPI merges at a rate of 1.5%/year
                'TargetYr_Prop = AMAX(1, Round(edseclowrgndreqtran(R%) * (10 * Abs((ValInit - 1))), 0))
                TargetYr_Prop = AMAX(1, edseclowrgndreqtran(R%) * (10 * Abs((ValInit - 1))))
                'TargetYr_Prop = edseclowrgndreqtran(R%) * (1 + Int(10 * Abs((ValInit - 1))))
                TargetYr_Prop = TargetYr_Prop * dampen_male
    
                'mti 2022/02/23 Start
                gndreqintnProg = ValInit + (1 - ValInit) * Amin(1, (IY% / edseclowrgndreqtran(R%)))
                'gndreqintnProg = ValInit + (1 - ValInit) * Amin(1, ((IY% - 1) / TargetYr_Prop))
                'mti 2022/02/23 end
    
                'gender parity index = male/female
                If EDSECLOWRTRAN(R%, Female) < EDSECLOWRTRAN(R%, Male) Then
                    'mti December 2008 - revisited these bounds with new multiplier code
                    'mti dec 15 08 - commented this and added the following
                    'EDSECLOWRTRAN(R%, Female) = Amin(100, AMAX(1, EDSECLOWRTRAN(R%, Male) / gndreqintnProg))
                    EDSECLOWRTRAN(R%, Female) = AMAX(0.01, EDSECLOWRTRAN(R%, Male) / gndreqintnProg)
                ElseIf EDSECLOWRTRAN(R%, Male) < EDSECLOWRTRAN(R%, Female) Then
                    'EDSECLOWRTRAN(R%, Male) = Amin(100, AMAX(1, EDSECLOWRTRAN(R%, Female) * gndreqintnProg))
                    EDSECLOWRTRAN(R%, Male) = AMAX(0.01, EDSECLOWRTRAN(R%, Female) * gndreqintnProg)
                End If
    
    
' End Sub
    ' ---- End Inlined Level 2: IFsEducSec_new_init:GenderParityCalc

                '  If GRPS(1,R%) = "China" Then Stop

                'All But first: Lower Secondary: Pre-Budget: Survival Rate
                '------------------------------------------------------------------
                For gndr = 1 To NGender - 1

                    'Regression Model
                    'mti 2016/12/09 Start



                    'EdSecLowrGRateShift(R%, gndr) = EDSECLOWRGRATE(R%, gndr) - CalEDSecLowrGrad

                    '                If gndr = 1 Then
                    '                    Call XYTABL("GDP/Capita (PPP) Versus Secondary Lower Survival Rate Male (MostRecent)", _
                    '                        GDPPCP(R%), CalEDSecLowrSur)
                    '                Else
                    '                    Call XYTABL("GDP/Capita (PPP) Versus Secondary Lower Survival Rate Female (MostRecent)", _
                    '                        GDPPCP(R%), CalEDSecLowrSur)
                    '                End If
                    Dim CalEDSecLowrGrad As Single
