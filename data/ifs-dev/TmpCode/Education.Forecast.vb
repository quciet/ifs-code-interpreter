                'edseclowrgndreqgrad(R%) = edprigndreqintn(R%) ' take start/end time through driver
    
    
                'if edseclowrgndreqgrad(R%)=10 GPI merges 1% a year, with edseclowrgndreqgrad(R%)=7 GPI merges at a rate of 1.5%/year
                'TargetYr_Prop = AMAX(1, Round(edseclowrgndreqgrad(R%) * (10 * Abs((ValInit - 1))), 0))
                TargetYr_Prop = AMAX(1, edseclowrgndreqgrad(R%) * (10 * Abs((ValInit - 1))))
                'TargetYr_Prop = edseclowrgndreqgrad(R%) * (1 + Int(10 * Abs((ValInit - 1))))
                TargetYr_Prop = TargetYr_Prop * dampen_male
    
                'mti 2022/02/23 Start
                gndreqintnProg = ValInit + (1 - ValInit) * Amin(1, (IY% / edseclowrgndreqgrad(R%)))
                'gndreqintnProg = ValInit + (1 - ValInit) * Amin(1, ((IY% - 1) / TargetYr_Prop))
