                                s_growth = AMAX(GRate_gndr, Amin(s_growth, 0))
                                EDPRISUR(R%, gndr) = AMAX(3, Amin(100, gEDPRISUR(R%, gndr) + s_growth))  'gEDPRISUR(R%, gndr) is first year value for this case
                                'Else
                                's_growth = 0
                                'EDPRISUR(R%, gndr) = EDPRISUR(R%, gndr)
                            ElseIf gEDPRISUR(R%, gndr) < EDPRISUR(R%, gndr) Then
                                EDPRISUR(R%, gndr) = ConvergeOverTimeSmooth(gEDPRISUR(R%, gndr), EDPRISUR(R%, gndr), 5)
                            End If
            
                        End If
                        'mti 2013/09/16 - Education for WC -end
            
    ' End Sub
