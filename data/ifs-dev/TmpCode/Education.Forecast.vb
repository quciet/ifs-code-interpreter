                    'All Years but First: Primary Final: Apply Budget Impact on Survival Rates
                    For gndr = 1 To NGender - 1
    
                        'If GRPS(1, R%) = "Liberia" Then Stop
    
                        'budget impact
    Dim survgrowthfactor = BudgetImpactParam + EDPRISUR(R%, gndr) + sEDPRISUR(R%, gndr) + edprilen(R%) @@Dim survgrowthfactor = FlowFactor(BudgetImpactParam, EDPRISUR(R%, gndr), 100, sEDPRISUR(R%, gndr), edprilen(R%))@@
                        Dim addSurvgrowthfactor = 100 * (BudgetImpactParam - 1) * survgrowthfactor
    
                        '                'impact on survival
                        If sCostPerDelta(R%, Primary) > 1 Then
                            addSurvgrowthfactor = AMAX(0, addSurvgrowthfactor)  'cost is growing, do not let intake fall
                        End If
    
                        'mti 2022/03/08 start
                        If edprisurm(R%, NGender) <> 1 Or edprisurm(R%, gndr%) <> 1 Or gdsm(R%, Educ) <> 1 Then
                            'mti 2022/03/08 End
                            fEdSurv(R%, gndr, Primary) = CSng(Amin(120, AMAX(1, EDPRISUR(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRISUR(R%, gndr)) / 100)))))
                        Else
