    ' ---- Begin Inlined Level 2: IFsEducPri_new_init:ifsEducPri_new_init_AllButFirst
' Private Sub ifsEducPri_new_init_AllButFirst(context As IForecastContext)
                sErrorSub = "IFsEducPri All years but First Before Budget: Primary: "
    
                Dim SurvTrgtCovd As Single
    
                For R% = 1 To NR%
    
                    '   All years but First Before Budget: Primary:  Compute Primary Intake Rate: Budget Independent
                    '===================================================================================================
    
                    sErrorSub = sErrorSub + GRPS(1, R%)
    
    Call InitTots(R%, "Pri")
            ' ---- Begin Inlined Level 3: IFsEducPri_new_init:ifsEducPri_new_init_AllButFirst:InitTots
    ' Private Sub InitTots(R%, level$)
                        '---------------------------------------------------------
                        'mti December 2009 - Knowledge Indices - new proc
            
                        If "Pri"$ = "Pri" Then
                            EDPRITOT(R%%, Total) = 0
                            EDPRIGRADS(R%%, Total) = 0
            
                        ElseIf "Pri"$ = "Sec" Then
            
                            EDSECTOT(R%%, Total) = 0
                            '    EDSECGRADS(R%%, Total) = 0
            
                            EDSECLOWRTOT(R%%, Total) = 0
                            EDSECLOWRGRADS(R%%, Total) = 0
            
                            EDSECUPPRTOT(R%%, Total) = 0
                            EDSECUPPRGRADS(R%%, Total) = 0
            
                        ElseIf "Pri"$ = "Ter" Then
            
                            EDTERTOT(R%%, Total) = 0
                            EDTERGRADS(R%%, Total) = 0
            
                        End If
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri_new_init:ifsEducPri_new_init_AllButFirst:InitTots
    
    
                    '   All years but first: Primary Initial:  Estimate Initial Gross Enrollment Demand
                    '===================================================================================
    
                    Dim CalEDPRIINT, CalEDPRIINT1, CalEDPRIINT2, CalEDPRISur1, CalEDPRISur2, CalEDPRISur3, CalEDPRISur4 As Single
                    'All years but first Primary Initial: Estimate initial net intake and survival rates using cross-sectional function
                    For gndr = 1 To NGender - 1
    
                        'Primary net intake rate - initial demand estimation
                        If gndr = 1 Then
                            If context.HistoricMode Then
                                Call XYTABL("GDP/Capita (PPP) Versus Primary Net Intake Rate Male(1992)",
                                GDPPCP(R%), CalEDPRIINT, context)
                            Else
                                TbName$ = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Male (" & CStr(BaseYear) & ") Log"
                                TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
    
                                'If GRPS(1, R) = "Afghanistan" Then Stop
                                'If GRPS(1, R) = "India" Then Stop
    
                                Call XYTABL(TbName$, GDPPCP(R%), CalEDPRIINT, context)
                                'mti 2016/12/09 End
    
                            End If
                        Else
                            If context.HistoricMode Then
                                Call XYTABL("GDP/Capita (PPP) Versus Primary Net Intake Rate Female(1992)",
                                GDPPCP(R%), CalEDPRIINT, context)
                            Else
                                TbName$ = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Female (" & CStr(BaseYear) & ") Log"
                                TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
                                Call XYTABL(TbName$, GDPPCP(R%), CalEDPRIINT, context)
    
                            End If
                        End If
    
                        'Converge to function: upward only
                        Dim PriIntN_Shift_Time = If(edpriintnshift(R%, gndr) > 0, 500, 15)  '30
    
                        'If GRPS(1, R) = "Afghanistan" And gndr = 1 And IY >= 22 Then Stop
                        CalEDPRIINT = CalEDPRIINT + ConvergeOverTimeSmooth(edpriintnshift(R%, gndr), 0, PriIntN_Shift_Time)
    
                        'All years but first Primary Pre-Budget: Systemic Shift in Net Intake Rate
                        Dim EdAddTemporalShift = True
                        If EdAddTemporalShift Then
                            If Not context.HistoricMode Then
                                'using total: as there is a non-uniform temporal shift in male and female (more for female)
                                'that added with faster slope of original female function might amplify female intake growth
                                Call XYTABL("GDP/Capita (PPP) Versus Primary Net Intake Rate Total(1992)",
                                    GDPPCP(R%), CalEDPRIINT1, context)
    
                                Call XYTABL("GDP/Capita (PPP) Versus Primary Net Intake Rate Total(2000)",
