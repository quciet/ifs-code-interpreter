                    pGradeStudents(CInt(edprilen(R%))) = EDPRIINT(R%, gndr) * EDPRISUR(R%, gndr%) / 100
                    Dim MidEnrAvg = (EDPRIENRG(R%, gndr) * CInt(edprilen(R%)) - pGradeStudents(1) - pGradeStudents(CInt(edprilen(R%)))) / (CInt(edprilen(R%)) - 2)
    
                    Dim MidGrade1% = CInt(edprilen(R%)) \ 2 + 1
                    Dim MidGrade2% = MidGrade1
                    If CInt(edprilen(R%)) Mod 2 = 0 Then  'even number of grades
                        MidGrade1 = CInt(edprilen(R%)) \ 2
                        MidGrade2 = CInt(edprilen(R%)) \ 2 + 1
                    End If
    
                    Dim DeltaEnr = 5
    
                    Do While True
                        If MidGrade1 <> MidGrade2 Then
                            pGradeStudents(MidGrade1) = MidEnrAvg + DeltaEnr
                            pGradeStudents(MidGrade2) = MidEnrAvg - DeltaEnr
                        Else
                            pGradeStudents(MidGrade1) = MidEnrAvg
                            pGradeStudents(MidGrade2) = pGradeStudents(MidGrade1)
                        End If
    
                        For GCount% = MidGrade1 - 1 To 2 Step -1
                            pGradeStudents(GCount%) = pGradeStudents(GCount% + 1) + DeltaEnr
                        Next
    
                        For GCount% = MidGrade2 + 1 To CInt(edprilen(R%)) - 1
                            pGradeStudents(GCount%) = AMAX(0.5, pGradeStudents(GCount% - 1) - DeltaEnr)  'negatives not allowed
                        Next
                        Dim TotEnr As Single = 0
                        For GCount% = 1 To CInt(edprilen(R%))
                            TotEnr = TotEnr + pGradeStudents(GCount%)
                        Next
    
                        'this should not be necessary
                        If TotEnr / CInt(edprilen(R%)) > EDPRIENRG(R%, gndr) + 1 Then
                            DeltaEnr = DeltaEnr - 1
                        ElseIf TotEnr / CInt(edprilen(R%)) < EDPRIENRG(R%, gndr) - 1 Then
                            DeltaEnr = DeltaEnr + 1
                        Else
                            Exit Do
                        End If
