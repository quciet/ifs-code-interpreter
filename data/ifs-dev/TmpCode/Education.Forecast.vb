                    'First Year Primary Gross Model: calculate gross enrolment rate from grade-flow of students and school-age population
                    CalEdPriEnrG = Amin(150, (EDPRITOT(R%, gndr) / AMAX(0.001, pripop(R%, gndr))) * 100)

                    'First Year Primary Gross Model: gross enrollment rate shift (data - calculation from grade-flow)
                    edPrienrgshift(R%, gndr) = EDPRIENRG(R%, gndr) - CalEdPriEnrG


                    'check mti october 08 new
                    EDPRITOT(R%, gndr) = AMAX(0.001, pripop(R%, gndr)) * EDPRIENRG(R%, gndr) / 100

                    'First Year Primary Gross Model: calculate primary completion rate from grade flow
                    CalEdPriCR = pristudents(CInt(edprilen(R%)), R%, gndr) * (1 - drpoutgr(CInt(edprilen(R%))))

                    'First Year Primary Gross Model: comletion rate shift (data - calculation from grade-flow)
                    EDPRICRShift(R%, gndr) = EDPRICR(R%, gndr) - CalEdPriCR


                    'First Year Primary Gross Model: Initialize number of primary graduates
                    EDPRIGRADS(R%, gndr) = CSng(fagedst(CInt(edpristart(R%) + edprilen(R%)), R%, gndr) * (EDPRICR(R%, gndr) / 100))


                    'First Year Primary Gross Model: add each gender to get total students and graduates
                    EDPRITOT(R%, Total) = EDPRITOT(R%, Total) + EDPRITOT(R%, gndr)
                    EDPRIGRADS(R%, Total) = EDPRIGRADS(R%, Total) + EDPRIGRADS(R%, gndr)

                    '   First Year Primary: Net Flow Model: Calculate shifts and initialize grade-flow
                    '====================================================================================

                    'First Year Primary Net Model: net intake rate - calculate initial shift factor (data-function estimate)
ProcessPriNet(R%, gndr%, edpriintnshift(R%, gndr), edprienrnshift(R%, gndr), spridropoutnet(R%, gndr), PristudentsNet, drpoutgr, pripop(R%, gndr), context)
