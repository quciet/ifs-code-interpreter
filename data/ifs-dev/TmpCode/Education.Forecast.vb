                        Call XYTABL(TFNameSurvMale, GDPPCP(R%), CalEDSecLowrSur, context)
                    Else
                        'jrs 2024/06/17 Call XYTABL("GDP/Capita (PPP 2011) Versus Secondary Lower Survival Rate, General, Female (2020) Log",
                        'GDPPCP(R%), CalEDSecLowrSur, context)
                        Call XYTABL(TFNameSurvFemale, GDPPCP(R%), CalEDSecLowrSur, context)
                    End If

                    EdSecLowrSurShift(R%, gndr) = EDSECLOWRSUR(R%, gndr%) - CalEDSecLowrSur


                    '-------- End grade-specific rate initialization ------------


