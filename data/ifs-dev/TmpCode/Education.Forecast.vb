                                                secupprstudents(GCount%, R%%, gndr%) / 100)
                    Next GCount%
                Else  'one average dropout
                    For GCount% = 2 To CInt(edsecupprlen(R%))
                        'grade wise enrolment rate (gross)
                        secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - Dropoutrate) '^ (GCount% - 1)
                        secupprstudents(GCount%, R%%, gndr%) = AMAX(0.5, secupprstudents(GCount%, R%%, gndr%))
                        'Add to total enrolment
                        EDSECUPPRTOT(R%, gndr) = EDSECUPPRTOT(R%, gndr) + CSng(fagedst(CInt(secStart(R%) + edseclowrlen(R%) + GCount% - 1), R%%, gndr%) *
