                '    totalAdultpop = 0
                '    For j = 4 To NCohorts
                '        CompAdultEdSecCompletionPop = CSng(CompAdultEdSecCompletionPop) + CSng(EdUpprSecPopPer(j%, R%%, gndr%) * agedst(j%, R%%, gndr%))
                '        totalAdultpop = CSng(totalAdultpop) + CSng(agedst(j%, R%%, gndr%))
                '    Next j
