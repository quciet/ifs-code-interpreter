                    ' If GRPS(1,R%) = "Brazil" And gndr = 2 Then Stop
                    Dim CalEdSeclowrEnrG = Amin(150, (EDSECLOWRTOT(R%, gndr) / AMAX(0.0000001, seclowrpop(R%, gndr))) * 100)
                    EDSECLOWRENRG(R%, gndr) = CalEdSeclowrEnrG + edseclowrenrgshiftCur(R%, gndr)    'ConvergeOverTime1(edseclowrenrgshift(R%, gndr), 0, edseclowrenrgshiftCur(R%, gndr)) '10 '100
                    '        EDSECLOWRENRG(R%, gndr) = CalEdSeclowrEnrG + seclowrpop(R%, gndr) * edseclowrenrgshift(R%, gndr) * (sEdSLSurMx(R%, gndr) - mEdSecLowrSur(R%, gndr)) / (sEdSLSurMx(R%, gndr) - iEdSecLowrSur(R%, gndr)) '10 '100
    
                    'All Years but First: Lower Secondary Final: Total students
                    EDSECLOWRTOT(R%, gndr) = seclowrpop(R%, gndr) * EDSECLOWRENRG(R%, gndr) / 100
    
                    'All Years but First: Lower Secondary Final: Graduation rate: Last grade enrollment rate * last grade retention rate
                    'caledseclowrgrategen = seclowrstudents(cint(edseclowrlen(R%)), R%, gndr) * (1 - LastGradeDropout(cint(edseclowrlen(R%)), EDSECLOWRSUR(R%, gndr), sEdSLSurMx(R%, gndr)))
    
