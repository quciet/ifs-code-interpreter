                    'All Years but First: Basic Education Final: Primary plus lower secondary: Gross Enrollment Rate
                    '-------------------------------------------------------------------------------------------------------------------
                    '        pripop(R%, gndr) = CalcPopFrom1Year(edpristart(R%), cint(edprilen(R%)), R%, gndr)
                    EDBASENRG(R%, gndr) = (EDSECLOWRENRG(R%, gndr) * seclowrpop(R%, gndr) + EDPRIENRG(R%, gndr) * pripop(R%, gndr)) / (seclowrpop(R%, gndr) + pripop(R%, gndr))
    
    
                    'All Years but First: Upper Secondary Final: Gross enrollment and graduation
    
                    '----------------------------------------------------------------------------
    
                    'All Years but First: Upper Secondary Final: Intake Rate from last year's lower sec last grade x transition rate this year
                    'caledsecint = seclowrstudents(cint(edseclowrlen(R%)), R%, gndr) * EDSECUPPRTRAN(R%, gndr) / 100
    
                    'mti December 11, 2008
