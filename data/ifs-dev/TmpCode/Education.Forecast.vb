EdSecTotShifts(R%, seclowrpop, secupprpop, EdSecEnrNShift, context)
    ' ---- Begin Inlined Level 2: IFsEducSec_new_init:EdSecTotShifts
' Private Sub EdSecTotShifts(R%, seclowrpop(,) As Single, secupprpop(,) As Single, EdSecEnrNShift(,) As Single, context As IForecastContext)
                '---------Education Module-------
                'mti 2014/10/06 -whole proc
    
                'mti 2014/03/27 - new proc
    
    
                '   First Year All Secondary (Upper and Lower Combined):  Calculate shifts
                '---------------------------------------------------------------------------------
                For gndr = 1 To NGender - 1
                    'First Year All Secondary: Total Students
                    EDSECTOT(R%%, gndr) = EDSECLOWRTOT(R%%, gndr) + EDSECUPPRTOT(R%%, gndr)
    
                    'First Year All Secondary: school-age population
                    secpop = seclowrpop(R%%, gndr) + secupprpop(R%%, gndr) 'CalcPopFrom1Year(secStart(R%%), edseclenR, R%%, gndr)
    
                    'First Year All Secondary: Gross Enrolment Rate Shifts
                    CalEdSecEnrG = Amin(150, (EDSECTOT(R%%, gndr) / AMAX(0.001, secpop)) * 100)
    
    
                    'EdSecEnrgShift(R%%, gndr) = EDSECENRG(R%%, gndr) - CalEdSecEnrG
    
                    'force all secondary to match with upper and lower
                    EDSECENRG(R%%, gndr) = CalEdSecEnrG
    
    
                    'First Year All Secondary:add each gender to total students and graduates
                    EDSECTOT(R%%, Total) = EDSECTOT(R%%, Total) + EDSECTOT(R%%, gndr)
    
    
                    'First Year All Secondary: Net enrolment rates shifts--
                    'use secondary gross versus net enrollment rate functions to estimate net
    
                    If context.HistoricMode = True Then
                        If gndr = 1 Then
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Male (1970)",
                        EDSECENRG(R%%, gndr), CalEDSECENRN, context)
                        Else
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Female (1970)",
                        EDSECENRG(R%%, gndr), CalEDSECENRN, context)
                        End If
                    Else
                        If gndr = 1 Then
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Male (2000)",
                        EDSECENRG(R%%, gndr), CalEDSECENRN, context)
                        Else
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Female (2000)",
                        EDSECENRG(R%%, gndr), CalEDSECENRN, context)
    
                        End If
                    End If
    
                    CalEDSECENRN = Amin(100, CalEDSECENRN)
                    '   If GRPS(1,R%%) = "Sri Lanka" Then Stop
    
                    EdSecEnrNShift(R%%, gndr) = EDSECENRN(R%%, gndr) - CalEDSECENRN
    
                    'for high initial gross enrollment do not let them switch branches: keep track by a definitie shift value
                    If EDSECENRG(R%%, gndr) >= 95 Then
                        EdSecEnrNShift(R%%, gndr) = -9999
                    End If
    
                Next
' End Sub
    ' ---- End Inlined Level 2: IFsEducSec_new_init:EdSecTotShifts

