                        s_growth = AMAX(GRate_gndr, Amin(s_growth, 0))
                        EDSECLOWRGRATE(R%, gndr) = AMAX(3, Amin(100, gEDSECLOWRGRate(R%, gndr) + s_growth))  'gEDSECLOWRGRate(R%, gndr) is first year value for this case
