                            'mti 2022/04/12 start
                            pristudents(GCount%, R%, gndr%) = pristudents(GCount%, R%, gndr%) * If(edprienrgrdm(R%, NGender) <> 1, edprienrgrdm(R%, NGender), edprienrgrdm(R%, gndr))
                            'mti 2022/04/12 end
    
                            EDPRITOT(R%, gndr) = CSng(EDPRITOT(R%, gndr) + fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr) * pristudents(GCount%, R%, gndr) / 100)
    
                        Next
    
                        Dim CalEdPriCR = pristudents(CInt(edprilen(R%)), R%, gndr) * (1 - drpoutgr(CInt(edprilen(R%))))  'should really use SaveStudentCohorts(R%, edprilen(R%), gndr, 1)
    
    
