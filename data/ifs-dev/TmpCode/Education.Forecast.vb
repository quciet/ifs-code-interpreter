            'jrs 2024/07/23 Call XYTABL("GDP/Capita (PPP) Versus Secondary Lower Exp Per Student as % of GDPPC (MostRecent)",
            'Amin(GDPPCP(R%%), 30), calexpperstudseclowr(R%%), context) 'Amin(GDPPCP(R%%), 30)
            Call XYTABL(TFNameSecLowExpPerStuPctGDP, Amin(GDPPCP(R%%), 30), calexpperstudseclowr(R%%), context)

            'mti 2024/05/14 end
            'mti 2017/07/13 End

            'mti 2024/05/14 start
            edexpslconv = 40
            'mti 2024/05/14 end

            'edexpslconv is time for convergence to cost function; base case value 50 years; can be changed in scenario
            EDEXPERSECLOWR(R%%) = calexpperstudseclowr(R%%) + ConvergeOverTime1(edexpperSecLowrShift(R%), 0, CInt(edexpslconv))


            '     If GRPS(1,R%%) = "Egypt" And (IY = 15 Or IY = 19 Or IY = 24 Or IY = 25 Or IY = 31) Then Stop  'IY = 6 Or IY = 11 Or

            'mti 2019/11/22 Start
            'mti 2019/10/19 Start
            'mti 2019/12/09 start
            iEDEXPERSECLOWR(R%) = EDEXPERSECLOWR(R%%) * edexperseclowrm(R%%)

            EDEXPERSECLOWR(R%%) = EDEXPERSECLOWR(R%%) * sCostPerDelta(R%, SecLowr) * edexperseclowrm(R%%) '* edqtqltrm(R%%, SecLowr)

            '            'save at this point with the smoothing ; needed to separate out quality quantity tradeoff parameter impacts
            '            iAS_EDEXPERSECLOWR(R%) = EDEXPERSECLOWR(R%%)
