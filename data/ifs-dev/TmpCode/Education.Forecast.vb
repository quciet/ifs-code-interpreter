            Call XYTABL(TFNameSecUpExpPerStuPctGDP, GDPPCP_Ahead, calexpperstudsecuppr(R%%), context) 'Amin(GDPPCP_Ahead, 30)


            'mti 2024/05/14 Start
            ''calexpperstudsecuppr(R%%) = AMAX(28, calexpperstudsecuppr(R%%))  '28 '30
            'calexpperstudsecuppr(R%%) = AMAX(calexpperstudseclowr(R%%) + 2, calexpperstudsecuppr(R%%)) '28 '30
            'mti 2024/05/14 End

            'mti 2017/07/13 End

            'mti 2024/05/14 start
            edexpsuconv = 40
            'mti 2024/05/14 end

            'mti 2024/05/14 Start
            ''edexpsuconv is time for Convergence to Function; can be changed in scenario
