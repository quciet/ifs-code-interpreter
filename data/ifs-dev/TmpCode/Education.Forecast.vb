                            'logistic goal seek
                            '            stpmid = 9.999 / (edpriintntrgtyr(R%) * 2) 'back calculated from logistic formula
                            '            stpmidmin = AMAX(0.01, stpmid - 0.05)
                            '            stpmidmax = Amin(0.7, stpmid + 0.25)
                            '            stp = Amin(stpmidmax, AMAX(stpmidmin, stpmid + (70 - iEDPRIINTN(R%, gndr%)) / 100))
                            '            expterm = Exp(stp * Amin(IY - 1, edpriintntrgtyr(R%) + 20))
                            '            trgtval = (100 * iEDPRIINTN(R%, gndr%) * expterm) / (100 + (iEDPRIINTN(R%, gndr%) * (expterm - 1)))
                            'mti 2016/03/09- end
            
                            'mti 2014/10/06 - start
                            gEDPRIINTN(R%, gndr) = AMAX(trgtval, EDPRIINTN(R%, gndr))
                            EDPRIINTN(R%, gndr) = gEDPRIINTN(R%, gndr)
                            'mti 2014/10/06 - end
            
            
                            Exit Sub 'if target year is set - growth rate parameter won't work
                        End If
                        'mti 2014/05/28
            
                        '100 is the ceiling for flow, e.g., 100% for survival
                        'grate is the growth rate obtained from scenario handle, if it is 3, 3% (point) growth occurs at 50 and tapers off both way, i.e., towards 0 and 100
                        '    If GRate_gndr < 0 Then Stop
                        'take the max of the total or the gender being calculated
            
                        'mti 2013/09/16 - Education for WC -start
                        If edpriintngr(R%, NGender) > 0 Then
                            GRate_gndr = AMAX(GRate_gndr, edpriintngr(R%, NGender))
                        ElseIf edpriintngr(R%, NGender) < 0 Then
                            GRate_gndr = Amin(GRate_gndr, edpriintngr(R%, NGender))
