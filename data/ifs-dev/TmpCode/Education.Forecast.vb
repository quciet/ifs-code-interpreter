                        GDPPCP(R%), CalEDSecLowrGrad, context)
                    Else
                        Call XYTABL("GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Female (MostRecent) Log",
                        GDPPCP(R%), CalEDSecLowrGrad, context)
                    End If

                    'mti 2016/02/20- end

                    '                'Convergence of Initial Year Data-Regression Gap: upward only: Over 50 years
                    '                'mti 2016/12/09 start
                    '                Sur_Shift_Time = If(EdSecLowrSurShift(R%, gndr) > 0, 500, 15) '50
                    '                'mti 2016/12/09 end
                    '                EDSECLOWRSUR(R%, gndr) = AMAX(5, CalEDSecLowrSur + ConvergeOverTime1(EdSecLowrSurShift(R%, gndr), 0, Sur_Shift_Time))


                    'Convergence of Initial Year Data-Regression Gap: upward only: Over 50 years
                    'mti 2016/12/09 start
                    Dim Grad_Shift_Time = If(EdSecLowrGRateShift(R%, gndr) > 0, 500, 15) '50

                    'If GRPS(1,R%) = "China" Then Stop

                    'mti 2019/11/22 Start
                    'EDSECLOWRGRATE(R%, gndr) = AMAX(5, CalEDSecLowrGrad + ConvergeOverTime1(EdSecLowrGRateShift(R%, gndr), 0, Grad_Shift_Time))
                    'EDSECLOWRGRATE(R%, gndr) = AMAX(5, CalEDSecLowrGrad + ConvergeOverTimeSmooth(EdSecLowrGRateShift(R%, gndr), 0, Grad_Shift_Time))
                    EDSECLOWRGRATE(R%, gndr) = AMAX(1, CalEDSecLowrGrad + ConvergeOverTimeSmooth(EdSecLowrGRateShift(R%, gndr), 0, Grad_Shift_Time))
                    EDSECLOWRGRATE(R%, gndr) = EDSECLOWRGRATE(R%, gndr) + AMAX(-5, Amin(5, EdEnrSecurImpact(R%, 2)))

                    'mti 2022/11/25 start
                    'marginal impact of changes in share of girls (15 to 19) married, compared to the base forecast
                    'marriageedseclowr is elasticity; the next term is the decrease/increase in the share of girls (15 to 19) who are married compared to base (i.e., pre-multiplier) projection
                    'when marriageedseclowr is .5, for a base projection of MARRIEDFEMSHR of 50%, brought down to 45% by a .9 value of marriedfemshrm, 2.5% will be added to  EDSECLOWRGRATE, which can then get somewhat reduced when there is a financial constraint
                    'max/min change that can be added to or taken away from the base projection of lower secondary graduation rate is capped by 5%
                    EDSECLOWRGRATE(R%, gndr) = EDSECLOWRGRATE(R%, gndr) + AMAX(-5, Amin(5, marriageedseclowr(R%, Age15_19) * MARRIEDFEMSHR(R%, Age15_19) * ((1 / AMAX(0.00001, marriedfemshrm(R%, Age15_19))) - 1)))
                    EDSECLOWRGRATE(R%, gndr) = EDSECLOWRGRATE(R%, gndr) + AMAX(-5, Amin(5, marriageedseclowr(R%, Age20_24) * MARRIEDFEMSHR(R%, Age20_24) * ((1 / AMAX(0.00001, marriedfemshrm(R%, Age20_24))) - 1)))
                    'mti 2022/11/25 End

                    '                caledsecint = sEDPRICR(R%, gndr%) * EDSECLOWRTRAN(R%, gndr) / 100
                    '                EDSECLOWRGRATE(R%, gndr) = Amin(caledsecint - 1, EDSECLOWRGRATE(R%, gndr))


                    'mti 2022/03/16 start
