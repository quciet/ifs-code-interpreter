' ---- Begin Inlined Level 1: CalcEducationyears
' Private Sub CalcEducationyears(IY%, R%, pristudents(,,) As Single, seclowrstudents(,,) As Single, secupprstudents(,,) As Single, terstudents(,,) As Single,
' EdPriPopPer(,,) As Single, EdUpprSecPopPer(,,) As Single, EdTerPopPer(,,) As Single,
' ByRef edyrsag15to24difiMal As Single, ByRef edyrsag15to24difiFem As Single, ByRef EdPartialPopPer15to24(,,) As Single, ByRef sEdPartialPopPer15to24(,,) As Single, 'clp 2023/01/09 fixing EDYEARS transient; adding "ByRefs"
' ByRef edyrsag20to29difiMal As Single, ByRef edyrsag20to29difiFem As Single, ByRef EdPartialPopPer20to29(,,) As Single, ByRef sEdPartialPopPer20to29(,,) As Single, 'clp 2023/01/09 fixing EDYEARS transient; adding "ByRefs"
' ByRef edyrsag15difiMal As Single, ByRef edyrsag15difiFem As Single, ByRef EdPartialPopPer15(,,) As Single, ByRef sEdPartialPopPer15(,,) As Single, ByRef edyrsag25difiMal As Single, ByRef edyrsag25difiFem As Single,'clp 2023/01/09 fixing EDYEARS transient; adding "ByRefs"
' ByRef EdPartialPopPer25(,,) As Single, ByRef sEdPartialPopPer25(,,) As Single)

            'mti 2022/10/20 - take entire proc
            'mti 2016/02/29 - new proc




AverageEducationYearsLowrUppr(IY%%, R%%, 20, pristudents, seclowrstudents, secupprstudents, terstudents, EDYRSAG20TO29(R%%, Male), EDYRSAG20TO29(R%%, Female), EDYRSAG20TO29(R%%, Total), edyrsag20to29difi(R%, Male), edyrsag20to29difi(R%, Female), EdPriPopPer, EdUpprSecPopPer, EdTerPopPer, EdPartialPopPer20to29, sEdPartialPopPer20to29, 29)
    ' ---- Begin Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr
' Private Sub AverageEducationYearsLowrUppr(IY%%, R%%, AdultAge As Single, pristudents(,,) As Single, seclowrstudents(,,) As Single, secupprstudents(,,) As Single, terstudents(,,) As Single,
' ByRef EDYRSAdultMale As Single, ByRef EDYRSAdultFemale As Single, ByRef EDYRSAdultTotal As Single, ByRef edyrsadultdifiMale As Single, ByRef edyrsadultdifiFemale As Single,
' EdPriPopPer(,,) As Single, EdUpprSecPopPer(,,) As Single, EdTerPopPer(,,) As Single, ByRef EdPartialPopPer(,,) As Single, ByRef sEdPartialPopPer(,,) As Single, Optional AdultAgeEnd As Single = 9999)
                '--------------------------------------------------------------------------------------------------------------------------------------
                'Education Module
                'mti 2016/03/30 - take entire procedure
    
                'mti 2014/10/06 - whole proc
    
                '   All Years:  Compute Average Years of Education for Age 15 and above, 15 to 24; and age 25 and above
                '=============================================================================
    
                'secondary starts at this age
                'ttt 2019/10/08 comment
                'Dim seclowrStart, secupprStart As Single
                'seclowrStart = edpristart(R%%%) + edprilen(R%%%)
                'secupprStart = seclowrStart + edseclowrlen(R%%%)
                'End zz191 comment
    
                'terstart = secupprStart + edsecupprlen(R%%%)
    
                'mti 2024/03/25 start
                Dim CohortYrs As Single
                'mti 2024/03/25 end
    
                Dim CohtInit, CohtLast As Integer
                CohtInit% = CInt(CLng(20) \ 5 + 1)  '4 for 15+, 6 for 25+
                If 29 = 9999 Then
                    CohtLast% = NCohorts
                Else
                    CohtLast% = CInt(CLng(29) \ 5 + 1)
                End If
    
                Dim TotYearsPriEdPop, AdultPop1, AvgYearsPriEdPop, PartialPriPersYearsNew, Dropoutrate As Single
                Dim gr_Students, TotYearsSecEdPop, AvgYearsSecEdPop, PartiallowrSecPersYearsNew As Single
                Dim caledsecint, PartialupprSecPersYearsNew, TotYearsTerEdPop, AvgYearsTerEdPop As Single
                Dim PartialTerPersYearsNew, PartialYearsTotalNew, RatioPartialCompleted, PartialYearsTotal As Single
                Dim PartialYearsEdPop, Comp, EDYRSAdult, edyrsadultdifi, AdultPop1Male, AdultPop1Female As Single
                Dim c_age, TerYears As Integer
    
                For gndr% = 1 To NGender% - 1 'mti education
    
                    'Total Years of education from primary completion, for people aged (25 or 15) and above
                    TotYearsPriEdPop = 0
    
                    'Population aged (25 or 15) and above
                    AdultPop1 = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsPriEdPop = CSng(TotYearsPriEdPop + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                        AdultPop1 = CSng(AdultPop1 + agedst(j%, R%%%, gndr%)) '+ agedst(j%, R%%%, 2)
                    Next j%
    
                    'Average Years of education from primary completion, for people aged (25 or 15) and above
                    AvgYearsPriEdPop = TotYearsPriEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from primary dropout, for people aged (25 or 15) and above
                    PartialPriPersYearsNew = 0  'Person Years of Partial Primary Education, Across 5 Year Cohort
    
                    'differentiated dropout here?
                    Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%%%, gndr%) / 100) ^ (1 / (edprilen(R%%%) - 1))))) 'dropout rate for gender
                    '        Call DropoutSpread(edprilen(R%%%), EDPRISUR(R%%%, gndr%), PriDrpOutGrs())
    
                    For GCount% = 2 To CInt(edprilen(R%%%))  'If drop out is in 1st year, no partial education achieved
                        'dropoutrate = AMAX(0, (1 - (EDPRISUR(R%%%, gndr%) / 100)) / AMAX(1, PriYears%))
                        'Assume dropoutrate is same in every year of primary education
                        'mti review : current students for partial years? bt goes to 25+
                        '???????????? makes OECD high?
    
                        'pristudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        gr_Students = CSng(fagedst(CInt(edpristart(R%%%) + GCount% - 1), R%%%, gndr%) *
                                    pristudents(GCount%, R%%%, gndr%) / 100)
                        PartialPriPersYearsNew = PartialPriPersYearsNew +
                    (gr_Students * Dropoutrate) * (GCount% - 1)
    
                        '            PartialPriPersYearsNew = PartialPriPersYearsNew + _
                        '(gr_Students * PriDrpOutGrs(GCount%)) * (GCount% - 1)
    
                        'Subtraction of 1 because dropout in 2nd year gives one year of partial education
                    Next GCount%
    
                    'Total Years of education from secondary completion, for people aged (25 or 15) and above
                    TotYearsSecEdPop = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsSecEdPop = CSng(TotYearsSecEdPop + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
    
                        'If gndr = 1 And 20 = 15 And 29 = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        'If gndr = 1 And 20 = 15 And 29 = 9999 And GRPS(1, R%%%) = "Bhutan" Then
                        '    Stop
                        '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag20to29difi(R%, Male)) & "," & CStr(29) & vbNewLine)
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(j) & "," & CStr(EdUpprSecPopPer(j%, R%%%, gndr%)) & "," & CStr(agedst(j%, R%%%, gndr%)) & vbNewLine)
                        'End If
    
                    Next j%
                    'Average Years of education from secondary completion, for people aged (25 or 15) and above
                    AvgYearsSecEdPop = TotYearsSecEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from lower secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartiallowrSecPersYearsNew = 0
    
                    'mti 2017/01/24 start
                    'Dropoutrate = AMAX(0, 1 - ((EDSECLOWRSUR(R%%%, gndr%) / 100) ^ (1 / (edseclowrlen(R%%%) - 1)))) 'dropout rate for gender
                    caledsecint = sEDPRICR(R%%%, gndr%) * EDSECLOWRTRAN(R%%%, gndr) / 100
                    Dropoutrate = CSng(AMAX(0, 1 - (EDSECLOWRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edseclowrlen(R%%%))))
                    'mti 2017/01/24 End
    
                    For GCount% = 2 To CInt(edseclowrlen(R%%%))
                        'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                        'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        'mti August 2009
                        c_age = CInt(seclowrStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to seclowrStart
                        If c_age <= 20 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        seclowrstudents(GCount%, R%%%, gndr%) / 100)
                            PartiallowrSecPersYearsNew = PartiallowrSecPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
    
    
                    'Partial Years of education from upper secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartialupprSecPersYearsNew = 0
                    If edsecupprlen(R%%%) > 1 Then
    
                        'mti 2017/01/24 Start
                        'Dropoutrate = AMAX(0, 1 - ((EDSECUPPRSUR(R%%%, gndr%) / 100) ^ (1 / (edsecupprlen(R%%%) - 1)))) 'dropout rate for gender
    
                        If IY%% = 1 Then
                            caledsecint = EDSECLOWRGRATE(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        Else
                            caledsecint = sEDSECLOWRGRate(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        End If
    
                        Dropoutrate = CSng(AMAX(0, 1 - (EDSECUPPRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edsecupprlen(R%%%))))
                        'mti 2017/01/24 End
    
                        For GCount% = 2 To CInt(edsecupprlen(R%%%))
                            'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                            'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                            c_age = CInt(secupprStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to secupprStart
                            If c_age <= 20 + 4 Then 'take partial years for the bottom cohort
                                gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                            secupprstudents(GCount%, R%%%, gndr%) / 100)
    
                                PartialupprSecPersYearsNew = PartialupprSecPersYearsNew +
                            (gr_Students * Dropoutrate) * (GCount% - 1)
                            End If
                        Next GCount%
                    End If
    
                    'Total Years of education from tertiary completion, for people aged (25 or 15) and above
                    TotYearsTerEdPop = 0
                    TerYears% = 4 '3  '???5A can be 3 years
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsTerEdPop = CSng(TotYearsTerEdPop +
                    EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                    Next j%
    
                    'Average Years of education from tertiary completion, for people aged (25 or 15) and above
                    AvgYearsTerEdPop = TotYearsTerEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from tertiary dropout, for people aged (25 or 15) and above
                    PartialTerPersYearsNew = 0
                    Dropoutrate = CSng(AMAX(0, 1 - (EDTERGRATE(R%%%, gndr%) / EDTERINT(R%%%, gndr%)) ^ (1 / terlen(R%%%)))) 'dropout rate for gender
                    For GCount% = 2 To 4 '5
    
                        c_age = CInt(terstart(R%%%) + GCount% - 1)
                        If c_age <= 20 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        terstudents(GCount%, R%%%, gndr%) / 100)
    
                            PartialTerPersYearsNew = PartialTerPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
                    'Partial Years of education (million), total from all levels, from dropout, for people aged (25 or 15) and above
                    PartialYearsTotalNew = PartialPriPersYearsNew + PartiallowrSecPersYearsNew + PartialupprSecPersYearsNew _
                                         + PartialTerPersYearsNew
                    'If GRPS(1,R%%%) = "China" Then Stop
                    If IY%%% = 1 Then 'Spread partial years like primary years
                        'Because calculated for cohort (not year), assign to full cohort
                        'EdPartialPopPer20to29(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'partial years per person by cohort [tertiary/upper sec partial years should be omitted for persons below 25]
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer20to29(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer20to29(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                   AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '-----mti january 2008 - check here for sec/ter for age 15+, if the denom is zero skip to a higher cohort
                        'for pri if Edpripopper (6) is zero go to higher cohorts
                        'for pri 15+, partial years might be high for 15+ and thus ratio not right for higher
                        '-------------------------
    
                        'RatioPartialCompleted = EdPartialPopPer20to29(6, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(6, R%%%, gndr%))
                        RatioPartialCompleted = EdPartialPopPer20to29(CohtInit%, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(CohtInit%, R%%%, gndr%))
    
                        'For j% = 7 To NCohorts
                        For j% = CohtInit% + 1 To CohtLast% 'NCohorts
                            'mti June 2006 - ??? EdPriPopPer(6, R%%%, gndr%) or EdPriPopPer(j%, R%%%, gndr%)
                            'mti June 2006
                            '                EdPartialPopPer20to29(j%, R%%%, gndr%) = EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted
                            EdPartialPopPer20to29(j%, R%%%, gndr%) = EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                            '            Debug.Print gndr; GRPS(1,R%%); j; EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted; EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                        Next j%
    
                        'save the ratio
                        'For j% = 6 To NCohorts
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer20to29(j%, R%%%, gndr%) = EdPartialPopPer20to29(j%, R%%%, gndr%)
                        Next j%
                    Else 'Update partial years and count total
                        'EdPartialPopPer20to29(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer20to29(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer20to29(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                        AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '            For j% = NCohorts To 7 Step -1
                        '               EdPartialPopPer20to29(j%, R%%%, gndr%) = SEdPartialPopPer(j%, R%%%, gndr%) + _
                        '                SEdPartialPopPer(j% - 1, R%%%, gndr%) / 5 - SEdPartialPopPer(j%, R%%%, gndr%) / 5
                        '            Next j%
                        For j% = CohtLast% To CohtInit% + 1 Step -1  'NCohorts
                            EdPartialPopPer20to29(j%, R%%%, gndr%) = sEdPartialPopPer20to29(j%, R%%%, gndr%) +
                            sEdPartialPopPer20to29(j% - 1, R%%%, gndr%) / 5 - sEdPartialPopPer20to29(j%, R%%%, gndr%) / 5
                        Next j%
    
                        '            For j% = 6 To NCohorts
                        '                SEdPartialPopPer(j%, R%%%, gndr%) = EdPartialPopPer20to29(j%, R%%%, gndr%)
                        '            Next j%
    
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer20to29(j%, R%%%, gndr%) = EdPartialPopPer20to29(j%, R%%%, gndr%)
                        Next j%
    
                    End If
    
                    PartialYearsTotal = 0
                    'For j% = 6 To NCohorts
                    'mti August 2009 -unnecessarily multiplied by 100
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        'PartialYearsTotal = PartialYearsTotal + EdPartialPopPer20to29(j%, R%%%, gndr%) / 100 _
                        '    * agedst(j%, R%%%, gndr%)
                        PartialYearsTotal = CSng(PartialYearsTotal + EdPartialPopPer20to29(j%, R%%%, gndr%) _
                        * agedst(j%, R%%%, gndr%))
                    Next j%
    
                    'If GRPS(1, R%%) = "United Kingdom" And gndr% = 1 And 29 = 24 Then Stop
                    PartialYearsEdPop = PartialYearsTotal / AMAX(0.0000001, AdultPop1)
    
                    Comp = AvgYearsPriEdPop + AvgYearsSecEdPop + AvgYearsTerEdPop + PartialYearsEdPop
                    '   If GRPS(1,R%%) = "UAE" And gndr% = 2 Then
                    '
                    '    Debug.Print IY%%; AvgYearsPriEdPop25plus; AvgYearsSecEdPop25plus; _
                    '        AvgYearsTerEdPop25plus; PartialYearsEdPop25plus; _
                    '        PartialPriPersYearsNew; PartialSecPersYearsNew; PartialTerPersYearsNew
                    '   End If
    
                    'If GRPS(1, R%%%) = "India" Then Stop
    
                    'mti 2023/12/30 start
                    Dim iEDYRSAdult As Single
                    'mti 2023/12/30 start
    
                    If IY%%% = 1 Then
    
                        'record the initial difference for later use
    
                        If gndr% = 1 Then
                            EDYRSAdult = EDYRSAG20TO29(R%%, Male)
                        Else 'gndr=2
                            EDYRSAdult = EDYRSAG20TO29(R%%, Female)
                        End If
    
                        'edyrsag25difi(R%%%, gndr%) = EDYRSAG25(R%%%, gndr%) - comp
                        edyrsadultdifi = EDYRSAdult - Comp
                        If gndr% = 1 Then
                            edyrsag20to29difi(R%, Male) = edyrsadultdifi
                        Else 'gndr=2
                            edyrsag20to29difi(R%, Female) = edyrsadultdifi
                        End If
    
                        'mti 2023/12/30 start 'save initial values of ed years
                        If 29 = 9999 Then
                            If 20 = 15 Then
                                iEdYrsAg15Tot(R%%%) = EDYRSAdult
                            ElseIf 20 = 25 Then
                                iEdYrsAg25Tot(R%%%) = EDYRSAdult
                            End If
                        ElseIf 20 = 15 And 29 = 24 Then
                            iEdYrsAg15to24Tot(R%%%) = EDYRSAdult
                        ElseIf 20 = 20 And 29 = 29 Then
                            iEdYrsAg20to29Tot(R%%%) = EDYRSAdult
                        End If
                        'mti 2023/12/30 end
    
    
    
                        'If gndr = 1 And 20 = 15 And 29 = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        '    Stop
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(edyrsag20to29difi(R%, Male)) & "," & CStr(AvgYearsPriEdPop) & "," & CStr(AvgYearsSecEdPop) & "," & CStr(AvgYearsTerEdPop) & "," & CStr(PartialYearsEdPop) & vbNewLine)
                        'End If
    
                    Else
                            'If gndr = 1 And 20 = 15 And 29 = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                            '    Stop
                            '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag20to29difi(R%, Male)) & "," & CStr(29) & vbNewLine)
                            '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(edyrsag20to29difi(R%, Male)) & "," & CStr(AvgYearsPriEdPop) & "," & CStr(AvgYearsSecEdPop) & "," & CStr(AvgYearsTerEdPop) & "," & CStr(PartialYearsEdPop) & vbNewLine)
                            'End If
    
                            'calculated this year plus initial difference
                            If gndr% = 1 Then
                            edyrsadultdifi = edyrsag20to29difi(R%, Male)
                        Else 'gndr=2
                            edyrsadultdifi = edyrsag20to29difi(R%, Female)
                        End If
                        'EDYRSAG25(R%%%, gndr%) = AMAX(0.01, comp + edyrsag25difi(R%%%, gndr%))
    
                        'mti 2023/12/30 start 'save initial values of ed years
                        If 29 = 9999 Then
                            If 20 = 15 Then
                                iEDYRSAdult = iEdYrsAg15Tot(R%%%)
                            ElseIf 20 = 25 Then
                                iEDYRSAdult = iEdYrsAg25Tot(R%%%)
                            End If
                        ElseIf 20 = 15 And 29 = 24 Then
                            iEDYRSAdult = iEdYrsAg15to24Tot(R%%%)
                        ElseIf 20 = 20 And 29 = 29 Then
                            iEDYRSAdult = iEdYrsAg20to29Tot(R%%%)
                        End If
                        'mti 2023/12/30 end
    
                        'mti 2018/09/19 Start
                        'EDYRSAdult = AMAX(0.01, Comp + edyrsadultdifi)
                        If 29 < 35 Then
                            'mti 2024/01/17 start
                            EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250)) '20 mti 2024/01/17 'mti 2023/12/11 was 250; changed to 100 on Dec 11
                            'mti 2024/01/17 end
                        Else
                            'mti 2022/12/12 start
                            ''EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))
                            ''If GRPS(1, R%%%) = "Belarus" Then Stop
                            'If GRPS(1, R%%%) = "United Kingdom" Then Stop
                            ''If GRPS(1, R%%%) = "Ethiopia" Then Stop
                            'If GRPS(1, R%%%) = "United States of America" Then Stop
                            'If GRPS(1, R%%%) = "Congo, Dem. Republic of the" Then Stop
    
                            If edyrsadultdifi > 0 Then
    
                                'mti 2023/12/30 start
                                'If iEDYRSAdult > 10 Then
                                '    EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))
                                'Else
                                '    EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250))
                                'End If
                                EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, CInt(1500 / iEDYRSAdult))) 'faster convergence for high ed; slower for lower initial ed attain years
                                'EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250))  ' was 250  'mti 2023/12/11 was 250; ; changed to 100 on Dec 11
                                'mti 2023/12/30 end
                            Else
                                EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))    'mti 2023/12/11 was 125; ; changed to 50 on Dec 11
                            End If
                            'mti 2022/12/12 End
                        End If
    
                        'mti 2018/09/19 End
                    End If
    
                    'note March 16, 2015 : is this calculated at IY%%=1 as well?
                    If gndr% = 1 Then
                        AdultPop1Male = AdultPop1
                        EDYRSAG20TO29(R%%, Male) = EDYRSAdult
    
                        'mti 2015/03/04 - start
                        If edyrsagm(R%%%, NGender%) <> 1 Then  'multiplier on total (i.e., both sexes)
                            EDYRSAG20TO29(R%%, Male) = EDYRSAG20TO29(R%%, Male) * edyrsagm(R%%%, NGender%)
                        Else
                            EDYRSAG20TO29(R%%, Male) = EDYRSAG20TO29(R%%, Male) * edyrsagm(R%%%, gndr%)
                        End If
                        'mti 2015/03/04 - end
    
                        'mti 2015/03/30 - start
                        EDYRSAG20TO29(R%%, Male) = Amin(20, EDYRSAG20TO29(R%%, Male))
                        'mti 2015/03/30 - end
    
                    Else 'gndr=2
                        AdultPop1Female = AdultPop1
                        EDYRSAG20TO29(R%%, Female) = EDYRSAdult
    
                        'mti 2015/03/04 - start
                        If edyrsagm(R%%%, NGender%) <> 1 Then  'multiplier on total (i.e., both sexes)
                            EDYRSAG20TO29(R%%, Female) = EDYRSAG20TO29(R%%, Female) * edyrsagm(R%%%, NGender%)
                        Else
                            EDYRSAG20TO29(R%%, Female) = EDYRSAG20TO29(R%%, Female) * edyrsagm(R%%%, gndr%)
                        End If
                        'mti 2015/03/04 - end
    
                        'mti 2015/03/30 - start
                        EDYRSAG20TO29(R%%, Female) = Amin(20, EDYRSAG20TO29(R%%, Female))
                        'mti 2015/03/30 - end
    
                    End If
    
    
                    'mti 2024/03/25 start  
                    If 29 = 9999  Then
                        For j% = 0 To CohtInit% - 1 'NCohorts
                            If 20 = 15 Then
                                EdYears(j%, R%%%, gndr%) = 0
                            End If
                            If 20 = 25 Then
                                EdYears25(j%, R%%%, gndr%) = 0
                            End If
                        Next j%
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            'If R%% = 124 And j = 6 And gndr = 1 And 20 = 15 Then Stop
                            CohortYrs = 0
                            CohortYrs = CSng(CohortYrs + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                            CohortYrs = CSng(CohortYrs + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
                            CohortYrs = CSng(CohortYrs + EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                            CohortYrs = CSng(CohortYrs + EdPartialPopPer20to29(j%, R%%%, gndr%) * agedst(j%, R%%%, gndr%))
                            If Comp > 0 And agedst(j%, R%%%, gndr%) > 0 Then
    
                                'should really take the converged shift; not the initial shift
                                'CohortYrs = CSng((CohortYrs + agedst(j%, R%%%, gndr%) * edyrsadultdifi) / agedst(j%, R%%%, gndr%))
    
                                'withiut shift
                                CohortYrs = CSng(CohortYrs / agedst(j%, R%%%, gndr%))
                            Else
                                CohortYrs = 0
                            End If
                            If 20 = 15 Then
                                EdYears(j%, R%%%, gndr%) = CohortYrs
                            End If
                            If 20 = 25 Then
                                EdYears25(j%, R%%%, gndr%) = CohortYrs
                            End If
                        Next j%
                    End If
                    'mti 2024/03/25 end
    
    
                Next gndr%
    
    
                'mti 2024/03/25 start
                If 29 = 9999 And 20 = 25 Then
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        CohortYrs = CSng(EdYears(j%, R%%%, Female) * agedst(j%, R%%%, Female) + EdYears(j%, R%%%, Male) * agedst(j%, R%%%, Male))
                        If agedst(j%, R%%%, Female) + agedst(j%, R%%%, Male) > 0 Then
                            CohortYrs = CSng(CohortYrs / (agedst(j%, R%%%, Female) + agedst(j%, R%%%, Male)))
                        Else
                            CohortYrs = 0
                        End If
                        If 20 = 15 Then
                            EdYears(j%, R%%%, 3) = CohortYrs
                        End If
                        If 20 = 25 Then
                            EdYears25(j%, R%%%, 3) = CohortYrs
                        End If
                    Next j%
                End If
                'mti 2024/03/25 end
    
    
                'EDYRSAG25(R%%%, Total) = (PopAge25Male * EDYRSAG25(R%%%, Male) + PopAge25FeMale * EDYRSAG25(R%%%, Female)) / AMAX(0.0001, (PopAge25Male + PopAge25FeMale))
                'mti 2015/03/30 - start
                'EDYRSAG20TO29(R%%, Total) = Amin(29 - 20 + 1, (AdultPop1Male * EDYRSAG20TO29(R%%, Male) + AdultPop1Female * EDYRSAG20TO29(R%%, Female)) / AMAX(0.0001, (AdultPop1Male + AdultPop1Female)))
                EDYRSAG20TO29(R%%, Total) = Amin(20, (AdultPop1Male * EDYRSAG20TO29(R%%, Male) + AdultPop1Female * EDYRSAG20TO29(R%%, Female)) / AMAX(0.0001, (AdultPop1Male + AdultPop1Female)))
                'mti 2015/03/30 - end
    
' End Sub
    ' ---- End Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr

            'mti 2016/02/29 - end

AverageEducationYearsLowrUppr(IY%%, R%%, 15, pristudents, seclowrstudents, secupprstudents, terstudents, EDYRSAG15TO24(R%%, Male), EDYRSAG15TO24(R%%, Female), EDYRSAG15TO24(R%%, Total), edyrsag15to24difi(R%, Male), edyrsag15to24difi(R%, Female), EdPriPopPer, EdUpprSecPopPer, EdTerPopPer, EdPartialPopPer15to24, sEdPartialPopPer15to24, 24)
    ' ---- Begin Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr
' Private Sub AverageEducationYearsLowrUppr(IY%%, R%%, AdultAge As Single, pristudents(,,) As Single, seclowrstudents(,,) As Single, secupprstudents(,,) As Single, terstudents(,,) As Single,
' ByRef EDYRSAdultMale As Single, ByRef EDYRSAdultFemale As Single, ByRef EDYRSAdultTotal As Single, ByRef edyrsadultdifiMale As Single, ByRef edyrsadultdifiFemale As Single,
' EdPriPopPer(,,) As Single, EdUpprSecPopPer(,,) As Single, EdTerPopPer(,,) As Single, ByRef EdPartialPopPer(,,) As Single, ByRef sEdPartialPopPer(,,) As Single, Optional AdultAgeEnd As Single = 9999)
                '--------------------------------------------------------------------------------------------------------------------------------------
                'Education Module
                'mti 2016/03/30 - take entire procedure
    
                'mti 2014/10/06 - whole proc
    
                '   All Years:  Compute Average Years of Education for Age 15 and above, 15 to 24; and age 25 and above
                '=============================================================================
    
                'secondary starts at this age
                'ttt 2019/10/08 comment
                'Dim seclowrStart, secupprStart As Single
                'seclowrStart = edpristart(R%%%) + edprilen(R%%%)
                'secupprStart = seclowrStart + edseclowrlen(R%%%)
                'End zz191 comment
    
                'terstart = secupprStart + edsecupprlen(R%%%)
    
                'mti 2024/03/25 start
                Dim CohortYrs As Single
                'mti 2024/03/25 end
    
                Dim CohtInit, CohtLast As Integer
                CohtInit% = CInt(CLng(15) \ 5 + 1)  '4 for 15+, 6 for 25+
                If 24 = 9999 Then
                    CohtLast% = NCohorts
                Else
                    CohtLast% = CInt(CLng(24) \ 5 + 1)
                End If
    
                Dim TotYearsPriEdPop, AdultPop1, AvgYearsPriEdPop, PartialPriPersYearsNew, Dropoutrate As Single
                Dim gr_Students, TotYearsSecEdPop, AvgYearsSecEdPop, PartiallowrSecPersYearsNew As Single
                Dim caledsecint, PartialupprSecPersYearsNew, TotYearsTerEdPop, AvgYearsTerEdPop As Single
                Dim PartialTerPersYearsNew, PartialYearsTotalNew, RatioPartialCompleted, PartialYearsTotal As Single
                Dim PartialYearsEdPop, Comp, EDYRSAdult, edyrsadultdifi, AdultPop1Male, AdultPop1Female As Single
                Dim c_age, TerYears As Integer
    
                For gndr% = 1 To NGender% - 1 'mti education
    
                    'Total Years of education from primary completion, for people aged (25 or 15) and above
                    TotYearsPriEdPop = 0
    
                    'Population aged (25 or 15) and above
                    AdultPop1 = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsPriEdPop = CSng(TotYearsPriEdPop + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                        AdultPop1 = CSng(AdultPop1 + agedst(j%, R%%%, gndr%)) '+ agedst(j%, R%%%, 2)
                    Next j%
    
                    'Average Years of education from primary completion, for people aged (25 or 15) and above
                    AvgYearsPriEdPop = TotYearsPriEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from primary dropout, for people aged (25 or 15) and above
                    PartialPriPersYearsNew = 0  'Person Years of Partial Primary Education, Across 5 Year Cohort
    
                    'differentiated dropout here?
                    Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%%%, gndr%) / 100) ^ (1 / (edprilen(R%%%) - 1))))) 'dropout rate for gender
                    '        Call DropoutSpread(edprilen(R%%%), EDPRISUR(R%%%, gndr%), PriDrpOutGrs())
    
                    For GCount% = 2 To CInt(edprilen(R%%%))  'If drop out is in 1st year, no partial education achieved
                        'dropoutrate = AMAX(0, (1 - (EDPRISUR(R%%%, gndr%) / 100)) / AMAX(1, PriYears%))
                        'Assume dropoutrate is same in every year of primary education
                        'mti review : current students for partial years? bt goes to 25+
                        '???????????? makes OECD high?
    
                        'pristudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        gr_Students = CSng(fagedst(CInt(edpristart(R%%%) + GCount% - 1), R%%%, gndr%) *
                                    pristudents(GCount%, R%%%, gndr%) / 100)
                        PartialPriPersYearsNew = PartialPriPersYearsNew +
                    (gr_Students * Dropoutrate) * (GCount% - 1)
    
                        '            PartialPriPersYearsNew = PartialPriPersYearsNew + _
                        '(gr_Students * PriDrpOutGrs(GCount%)) * (GCount% - 1)
    
                        'Subtraction of 1 because dropout in 2nd year gives one year of partial education
                    Next GCount%
    
                    'Total Years of education from secondary completion, for people aged (25 or 15) and above
                    TotYearsSecEdPop = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsSecEdPop = CSng(TotYearsSecEdPop + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
    
                        'If gndr = 1 And 15 = 15 And 24 = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        'If gndr = 1 And 15 = 15 And 24 = 9999 And GRPS(1, R%%%) = "Bhutan" Then
                        '    Stop
                        '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag15to24difi(R%, Male)) & "," & CStr(24) & vbNewLine)
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(j) & "," & CStr(EdUpprSecPopPer(j%, R%%%, gndr%)) & "," & CStr(agedst(j%, R%%%, gndr%)) & vbNewLine)
                        'End If
    
                    Next j%
                    'Average Years of education from secondary completion, for people aged (25 or 15) and above
                    AvgYearsSecEdPop = TotYearsSecEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from lower secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartiallowrSecPersYearsNew = 0
    
                    'mti 2017/01/24 start
                    'Dropoutrate = AMAX(0, 1 - ((EDSECLOWRSUR(R%%%, gndr%) / 100) ^ (1 / (edseclowrlen(R%%%) - 1)))) 'dropout rate for gender
                    caledsecint = sEDPRICR(R%%%, gndr%) * EDSECLOWRTRAN(R%%%, gndr) / 100
                    Dropoutrate = CSng(AMAX(0, 1 - (EDSECLOWRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edseclowrlen(R%%%))))
                    'mti 2017/01/24 End
    
                    For GCount% = 2 To CInt(edseclowrlen(R%%%))
                        'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                        'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        'mti August 2009
                        c_age = CInt(seclowrStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to seclowrStart
                        If c_age <= 15 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        seclowrstudents(GCount%, R%%%, gndr%) / 100)
                            PartiallowrSecPersYearsNew = PartiallowrSecPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
    
    
                    'Partial Years of education from upper secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartialupprSecPersYearsNew = 0
                    If edsecupprlen(R%%%) > 1 Then
    
                        'mti 2017/01/24 Start
                        'Dropoutrate = AMAX(0, 1 - ((EDSECUPPRSUR(R%%%, gndr%) / 100) ^ (1 / (edsecupprlen(R%%%) - 1)))) 'dropout rate for gender
    
                        If IY%% = 1 Then
                            caledsecint = EDSECLOWRGRATE(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        Else
                            caledsecint = sEDSECLOWRGRate(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        End If
    
                        Dropoutrate = CSng(AMAX(0, 1 - (EDSECUPPRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edsecupprlen(R%%%))))
                        'mti 2017/01/24 End
    
                        For GCount% = 2 To CInt(edsecupprlen(R%%%))
                            'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                            'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                            c_age = CInt(secupprStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to secupprStart
                            If c_age <= 15 + 4 Then 'take partial years for the bottom cohort
                                gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                            secupprstudents(GCount%, R%%%, gndr%) / 100)
    
                                PartialupprSecPersYearsNew = PartialupprSecPersYearsNew +
                            (gr_Students * Dropoutrate) * (GCount% - 1)
                            End If
                        Next GCount%
                    End If
    
                    'Total Years of education from tertiary completion, for people aged (25 or 15) and above
                    TotYearsTerEdPop = 0
                    TerYears% = 4 '3  '???5A can be 3 years
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsTerEdPop = CSng(TotYearsTerEdPop +
                    EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                    Next j%
    
                    'Average Years of education from tertiary completion, for people aged (25 or 15) and above
                    AvgYearsTerEdPop = TotYearsTerEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from tertiary dropout, for people aged (25 or 15) and above
                    PartialTerPersYearsNew = 0
                    Dropoutrate = CSng(AMAX(0, 1 - (EDTERGRATE(R%%%, gndr%) / EDTERINT(R%%%, gndr%)) ^ (1 / terlen(R%%%)))) 'dropout rate for gender
                    For GCount% = 2 To 4 '5
    
                        c_age = CInt(terstart(R%%%) + GCount% - 1)
                        If c_age <= 15 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        terstudents(GCount%, R%%%, gndr%) / 100)
    
                            PartialTerPersYearsNew = PartialTerPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
                    'Partial Years of education (million), total from all levels, from dropout, for people aged (25 or 15) and above
                    PartialYearsTotalNew = PartialPriPersYearsNew + PartiallowrSecPersYearsNew + PartialupprSecPersYearsNew _
                                         + PartialTerPersYearsNew
                    'If GRPS(1,R%%%) = "China" Then Stop
                    If IY%%% = 1 Then 'Spread partial years like primary years
                        'Because calculated for cohort (not year), assign to full cohort
                        'EdPartialPopPer15to24(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'partial years per person by cohort [tertiary/upper sec partial years should be omitted for persons below 25]
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer15to24(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer15to24(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                   AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '-----mti january 2008 - check here for sec/ter for age 15+, if the denom is zero skip to a higher cohort
                        'for pri if Edpripopper (6) is zero go to higher cohorts
                        'for pri 15+, partial years might be high for 15+ and thus ratio not right for higher
                        '-------------------------
    
                        'RatioPartialCompleted = EdPartialPopPer15to24(6, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(6, R%%%, gndr%))
                        RatioPartialCompleted = EdPartialPopPer15to24(CohtInit%, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(CohtInit%, R%%%, gndr%))
    
                        'For j% = 7 To NCohorts
                        For j% = CohtInit% + 1 To CohtLast% 'NCohorts
                            'mti June 2006 - ??? EdPriPopPer(6, R%%%, gndr%) or EdPriPopPer(j%, R%%%, gndr%)
                            'mti June 2006
                            '                EdPartialPopPer15to24(j%, R%%%, gndr%) = EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted
                            EdPartialPopPer15to24(j%, R%%%, gndr%) = EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                            '            Debug.Print gndr; GRPS(1,R%%); j; EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted; EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                        Next j%
    
                        'save the ratio
                        'For j% = 6 To NCohorts
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer15to24(j%, R%%%, gndr%) = EdPartialPopPer15to24(j%, R%%%, gndr%)
                        Next j%
                    Else 'Update partial years and count total
                        'EdPartialPopPer15to24(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer15to24(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer15to24(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                        AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '            For j% = NCohorts To 7 Step -1
                        '               EdPartialPopPer15to24(j%, R%%%, gndr%) = SEdPartialPopPer(j%, R%%%, gndr%) + _
                        '                SEdPartialPopPer(j% - 1, R%%%, gndr%) / 5 - SEdPartialPopPer(j%, R%%%, gndr%) / 5
                        '            Next j%
                        For j% = CohtLast% To CohtInit% + 1 Step -1  'NCohorts
                            EdPartialPopPer15to24(j%, R%%%, gndr%) = sEdPartialPopPer15to24(j%, R%%%, gndr%) +
                            sEdPartialPopPer15to24(j% - 1, R%%%, gndr%) / 5 - sEdPartialPopPer15to24(j%, R%%%, gndr%) / 5
                        Next j%
    
                        '            For j% = 6 To NCohorts
                        '                SEdPartialPopPer(j%, R%%%, gndr%) = EdPartialPopPer15to24(j%, R%%%, gndr%)
                        '            Next j%
    
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer15to24(j%, R%%%, gndr%) = EdPartialPopPer15to24(j%, R%%%, gndr%)
                        Next j%
    
                    End If
    
                    PartialYearsTotal = 0
                    'For j% = 6 To NCohorts
                    'mti August 2009 -unnecessarily multiplied by 100
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        'PartialYearsTotal = PartialYearsTotal + EdPartialPopPer15to24(j%, R%%%, gndr%) / 100 _
                        '    * agedst(j%, R%%%, gndr%)
                        PartialYearsTotal = CSng(PartialYearsTotal + EdPartialPopPer15to24(j%, R%%%, gndr%) _
                        * agedst(j%, R%%%, gndr%))
                    Next j%
    
                    'If GRPS(1, R%%) = "United Kingdom" And gndr% = 1 And 24 = 24 Then Stop
                    PartialYearsEdPop = PartialYearsTotal / AMAX(0.0000001, AdultPop1)
    
                    Comp = AvgYearsPriEdPop + AvgYearsSecEdPop + AvgYearsTerEdPop + PartialYearsEdPop
                    '   If GRPS(1,R%%) = "UAE" And gndr% = 2 Then
                    '
                    '    Debug.Print IY%%; AvgYearsPriEdPop25plus; AvgYearsSecEdPop25plus; _
                    '        AvgYearsTerEdPop25plus; PartialYearsEdPop25plus; _
                    '        PartialPriPersYearsNew; PartialSecPersYearsNew; PartialTerPersYearsNew
                    '   End If
    
                    'If GRPS(1, R%%%) = "India" Then Stop
    
                    'mti 2023/12/30 start
                    Dim iEDYRSAdult As Single
                    'mti 2023/12/30 start
    
                    If IY%%% = 1 Then
    
                        'record the initial difference for later use
    
                        If gndr% = 1 Then
                            EDYRSAdult = EDYRSAG15TO24(R%%, Male)
                        Else 'gndr=2
                            EDYRSAdult = EDYRSAG15TO24(R%%, Female)
                        End If
    
                        'edyrsag25difi(R%%%, gndr%) = EDYRSAG25(R%%%, gndr%) - comp
                        edyrsadultdifi = EDYRSAdult - Comp
                        If gndr% = 1 Then
                            edyrsag15to24difi(R%, Male) = edyrsadultdifi
                        Else 'gndr=2
                            edyrsag15to24difi(R%, Female) = edyrsadultdifi
                        End If
    
                        'mti 2023/12/30 start 'save initial values of ed years
                        If 24 = 9999 Then
                            If 15 = 15 Then
                                iEdYrsAg15Tot(R%%%) = EDYRSAdult
                            ElseIf 15 = 25 Then
                                iEdYrsAg25Tot(R%%%) = EDYRSAdult
                            End If
                        ElseIf 15 = 15 And 24 = 24 Then
                            iEdYrsAg15to24Tot(R%%%) = EDYRSAdult
                        ElseIf 15 = 20 And 24 = 29 Then
                            iEdYrsAg20to29Tot(R%%%) = EDYRSAdult
                        End If
                        'mti 2023/12/30 end
    
    
    
                        'If gndr = 1 And 15 = 15 And 24 = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        '    Stop
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(edyrsag15to24difi(R%, Male)) & "," & CStr(AvgYearsPriEdPop) & "," & CStr(AvgYearsSecEdPop) & "," & CStr(AvgYearsTerEdPop) & "," & CStr(PartialYearsEdPop) & vbNewLine)
                        'End If
    
                    Else
                            'If gndr = 1 And 15 = 15 And 24 = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                            '    Stop
                            '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag15to24difi(R%, Male)) & "," & CStr(24) & vbNewLine)
                            '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(edyrsag15to24difi(R%, Male)) & "," & CStr(AvgYearsPriEdPop) & "," & CStr(AvgYearsSecEdPop) & "," & CStr(AvgYearsTerEdPop) & "," & CStr(PartialYearsEdPop) & vbNewLine)
                            'End If
    
                            'calculated this year plus initial difference
                            If gndr% = 1 Then
                            edyrsadultdifi = edyrsag15to24difi(R%, Male)
                        Else 'gndr=2
                            edyrsadultdifi = edyrsag15to24difi(R%, Female)
                        End If
                        'EDYRSAG25(R%%%, gndr%) = AMAX(0.01, comp + edyrsag25difi(R%%%, gndr%))
    
                        'mti 2023/12/30 start 'save initial values of ed years
                        If 24 = 9999 Then
                            If 15 = 15 Then
                                iEDYRSAdult = iEdYrsAg15Tot(R%%%)
                            ElseIf 15 = 25 Then
                                iEDYRSAdult = iEdYrsAg25Tot(R%%%)
                            End If
                        ElseIf 15 = 15 And 24 = 24 Then
                            iEDYRSAdult = iEdYrsAg15to24Tot(R%%%)
                        ElseIf 15 = 20 And 24 = 29 Then
                            iEDYRSAdult = iEdYrsAg20to29Tot(R%%%)
                        End If
                        'mti 2023/12/30 end
    
                        'mti 2018/09/19 Start
                        'EDYRSAdult = AMAX(0.01, Comp + edyrsadultdifi)
                        If 24 < 35 Then
                            'mti 2024/01/17 start
                            EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250)) '20 mti 2024/01/17 'mti 2023/12/11 was 250; changed to 100 on Dec 11
                            'mti 2024/01/17 end
                        Else
                            'mti 2022/12/12 start
                            ''EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))
                            ''If GRPS(1, R%%%) = "Belarus" Then Stop
                            'If GRPS(1, R%%%) = "United Kingdom" Then Stop
                            ''If GRPS(1, R%%%) = "Ethiopia" Then Stop
                            'If GRPS(1, R%%%) = "United States of America" Then Stop
                            'If GRPS(1, R%%%) = "Congo, Dem. Republic of the" Then Stop
    
                            If edyrsadultdifi > 0 Then
    
                                'mti 2023/12/30 start
                                'If iEDYRSAdult > 10 Then
                                '    EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))
                                'Else
                                '    EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250))
                                'End If
                                EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, CInt(1500 / iEDYRSAdult))) 'faster convergence for high ed; slower for lower initial ed attain years
                                'EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250))  ' was 250  'mti 2023/12/11 was 250; ; changed to 100 on Dec 11
                                'mti 2023/12/30 end
                            Else
                                EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))    'mti 2023/12/11 was 125; ; changed to 50 on Dec 11
                            End If
                            'mti 2022/12/12 End
                        End If
    
                        'mti 2018/09/19 End
                    End If
    
                    'note March 16, 2015 : is this calculated at IY%%=1 as well?
                    If gndr% = 1 Then
                        AdultPop1Male = AdultPop1
                        EDYRSAG15TO24(R%%, Male) = EDYRSAdult
    
                        'mti 2015/03/04 - start
                        If edyrsagm(R%%%, NGender%) <> 1 Then  'multiplier on total (i.e., both sexes)
                            EDYRSAG15TO24(R%%, Male) = EDYRSAG15TO24(R%%, Male) * edyrsagm(R%%%, NGender%)
                        Else
                            EDYRSAG15TO24(R%%, Male) = EDYRSAG15TO24(R%%, Male) * edyrsagm(R%%%, gndr%)
                        End If
                        'mti 2015/03/04 - end
    
                        'mti 2015/03/30 - start
                        EDYRSAG15TO24(R%%, Male) = Amin(20, EDYRSAG15TO24(R%%, Male))
                        'mti 2015/03/30 - end
    
                    Else 'gndr=2
                        AdultPop1Female = AdultPop1
                        EDYRSAG15TO24(R%%, Female) = EDYRSAdult
    
                        'mti 2015/03/04 - start
                        If edyrsagm(R%%%, NGender%) <> 1 Then  'multiplier on total (i.e., both sexes)
                            EDYRSAG15TO24(R%%, Female) = EDYRSAG15TO24(R%%, Female) * edyrsagm(R%%%, NGender%)
                        Else
                            EDYRSAG15TO24(R%%, Female) = EDYRSAG15TO24(R%%, Female) * edyrsagm(R%%%, gndr%)
                        End If
                        'mti 2015/03/04 - end
    
                        'mti 2015/03/30 - start
                        EDYRSAG15TO24(R%%, Female) = Amin(20, EDYRSAG15TO24(R%%, Female))
                        'mti 2015/03/30 - end
    
                    End If
    
    
                    'mti 2024/03/25 start  
                    If 24 = 9999  Then
                        For j% = 0 To CohtInit% - 1 'NCohorts
                            If 15 = 15 Then
                                EdYears(j%, R%%%, gndr%) = 0
                            End If
                            If 15 = 25 Then
                                EdYears25(j%, R%%%, gndr%) = 0
                            End If
                        Next j%
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            'If R%% = 124 And j = 6 And gndr = 1 And 15 = 15 Then Stop
                            CohortYrs = 0
                            CohortYrs = CSng(CohortYrs + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                            CohortYrs = CSng(CohortYrs + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
                            CohortYrs = CSng(CohortYrs + EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                            CohortYrs = CSng(CohortYrs + EdPartialPopPer15to24(j%, R%%%, gndr%) * agedst(j%, R%%%, gndr%))
                            If Comp > 0 And agedst(j%, R%%%, gndr%) > 0 Then
    
                                'should really take the converged shift; not the initial shift
                                'CohortYrs = CSng((CohortYrs + agedst(j%, R%%%, gndr%) * edyrsadultdifi) / agedst(j%, R%%%, gndr%))
    
                                'withiut shift
                                CohortYrs = CSng(CohortYrs / agedst(j%, R%%%, gndr%))
                            Else
                                CohortYrs = 0
                            End If
                            If 15 = 15 Then
                                EdYears(j%, R%%%, gndr%) = CohortYrs
                            End If
                            If 15 = 25 Then
                                EdYears25(j%, R%%%, gndr%) = CohortYrs
                            End If
                        Next j%
                    End If
                    'mti 2024/03/25 end
    
    
                Next gndr%
    
    
                'mti 2024/03/25 start
                If 24 = 9999 And 15 = 25 Then
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        CohortYrs = CSng(EdYears(j%, R%%%, Female) * agedst(j%, R%%%, Female) + EdYears(j%, R%%%, Male) * agedst(j%, R%%%, Male))
                        If agedst(j%, R%%%, Female) + agedst(j%, R%%%, Male) > 0 Then
                            CohortYrs = CSng(CohortYrs / (agedst(j%, R%%%, Female) + agedst(j%, R%%%, Male)))
                        Else
                            CohortYrs = 0
                        End If
                        If 15 = 15 Then
                            EdYears(j%, R%%%, 3) = CohortYrs
                        End If
                        If 15 = 25 Then
                            EdYears25(j%, R%%%, 3) = CohortYrs
                        End If
                    Next j%
                End If
                'mti 2024/03/25 end
    
    
                'EDYRSAG25(R%%%, Total) = (PopAge25Male * EDYRSAG25(R%%%, Male) + PopAge25FeMale * EDYRSAG25(R%%%, Female)) / AMAX(0.0001, (PopAge25Male + PopAge25FeMale))
                'mti 2015/03/30 - start
                'EDYRSAG15TO24(R%%, Total) = Amin(24 - 15 + 1, (AdultPop1Male * EDYRSAG15TO24(R%%, Male) + AdultPop1Female * EDYRSAG15TO24(R%%, Female)) / AMAX(0.0001, (AdultPop1Male + AdultPop1Female)))
                EDYRSAG15TO24(R%%, Total) = Amin(20, (AdultPop1Male * EDYRSAG15TO24(R%%, Male) + AdultPop1Female * EDYRSAG15TO24(R%%, Female)) / AMAX(0.0001, (AdultPop1Male + AdultPop1Female)))
                'mti 2015/03/30 - end
    
' End Sub
    ' ---- End Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr


            'mti 2022/10/20 start - change here

            'AverageEducationYearsLowrUppr IY%%, R%%, 15, pristudents(), seclowrstudents(), secupprstudents(), terstudents(), _
            '        EDYRSAG15(R%%, Male), EDYRSAG15(R%%, Female), EDYRSAG15(R%%, Total), edyrsag15difi(R%, Male), edyrsag15difi(R%, Female), _
            '        EdPriPopPer(), EdUpprSecPopPer(), EdTerPopPer(), EdPartialPopPer(), sEdPartialPopPer()
            '
            'AverageEducationYearsLowrUppr IY%%, R%%, 25, pristudents(), seclowrstudents(), secupprstudents(), terstudents(), _
            '        EDYRSAG25(R%%, Male), EDYRSAG25(R%%, Female), EDYRSAG25(R%%, Total), edyrsag25difi(R%, Male), edyrsag25difi(R%, Female), _
            '        EdPriPopPer(), EdUpprSecPopPer(), EdTerPopPer(), EdPartialPopPer(), sEdPartialPopPer()

            'If IY% >= 8 And R% = 1 Then Stop
AverageEducationYearsLowrUppr(IY%%, R%%, 15, pristudents, seclowrstudents, secupprstudents, terstudents, EDYRSAG15(R%%, Male), EDYRSAG15(R%%, Female), EDYRSAG15(R%%, Total), edyrsag15difi(R%, Male), edyrsag15difi(R%, Female), EdPriPopPer, EdUpprSecPopPer, EdTerPopPer, EdPartialPopPer15, sEdPartialPopPer15)
    ' ---- Begin Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr
' Private Sub AverageEducationYearsLowrUppr(IY%%, R%%, AdultAge As Single, pristudents(,,) As Single, seclowrstudents(,,) As Single, secupprstudents(,,) As Single, terstudents(,,) As Single,
' ByRef EDYRSAdultMale As Single, ByRef EDYRSAdultFemale As Single, ByRef EDYRSAdultTotal As Single, ByRef edyrsadultdifiMale As Single, ByRef edyrsadultdifiFemale As Single,
' EdPriPopPer(,,) As Single, EdUpprSecPopPer(,,) As Single, EdTerPopPer(,,) As Single, ByRef EdPartialPopPer(,,) As Single, ByRef sEdPartialPopPer(,,) As Single, Optional AdultAgeEnd As Single = 9999)
                '--------------------------------------------------------------------------------------------------------------------------------------
                'Education Module
                'mti 2016/03/30 - take entire procedure
    
                'mti 2014/10/06 - whole proc
    
                '   All Years:  Compute Average Years of Education for Age 15 and above, 15 to 24; and age 25 and above
                '=============================================================================
    
                'secondary starts at this age
                'ttt 2019/10/08 comment
                'Dim seclowrStart, secupprStart As Single
                'seclowrStart = edpristart(R%%%) + edprilen(R%%%)
                'secupprStart = seclowrStart + edseclowrlen(R%%%)
                'End zz191 comment
    
                'terstart = secupprStart + edsecupprlen(R%%%)
    
                'mti 2024/03/25 start
                Dim CohortYrs As Single
                'mti 2024/03/25 end
    
                Dim CohtInit, CohtLast As Integer
                CohtInit% = CInt(CLng(15) \ 5 + 1)  '4 for 15+, 6 for 25+
                If AdultAgeEnd = 9999 Then
                    CohtLast% = NCohorts
                Else
                    CohtLast% = CInt(CLng(AdultAgeEnd) \ 5 + 1)
                End If
    
                Dim TotYearsPriEdPop, AdultPop1, AvgYearsPriEdPop, PartialPriPersYearsNew, Dropoutrate As Single
                Dim gr_Students, TotYearsSecEdPop, AvgYearsSecEdPop, PartiallowrSecPersYearsNew As Single
                Dim caledsecint, PartialupprSecPersYearsNew, TotYearsTerEdPop, AvgYearsTerEdPop As Single
                Dim PartialTerPersYearsNew, PartialYearsTotalNew, RatioPartialCompleted, PartialYearsTotal As Single
                Dim PartialYearsEdPop, Comp, EDYRSAdult, edyrsadultdifi, AdultPop1Male, AdultPop1Female As Single
                Dim c_age, TerYears As Integer
    
                For gndr% = 1 To NGender% - 1 'mti education
    
                    'Total Years of education from primary completion, for people aged (25 or 15) and above
                    TotYearsPriEdPop = 0
    
                    'Population aged (25 or 15) and above
                    AdultPop1 = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsPriEdPop = CSng(TotYearsPriEdPop + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                        AdultPop1 = CSng(AdultPop1 + agedst(j%, R%%%, gndr%)) '+ agedst(j%, R%%%, 2)
                    Next j%
    
                    'Average Years of education from primary completion, for people aged (25 or 15) and above
                    AvgYearsPriEdPop = TotYearsPriEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from primary dropout, for people aged (25 or 15) and above
                    PartialPriPersYearsNew = 0  'Person Years of Partial Primary Education, Across 5 Year Cohort
    
                    'differentiated dropout here?
                    Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%%%, gndr%) / 100) ^ (1 / (edprilen(R%%%) - 1))))) 'dropout rate for gender
                    '        Call DropoutSpread(edprilen(R%%%), EDPRISUR(R%%%, gndr%), PriDrpOutGrs())
    
                    For GCount% = 2 To CInt(edprilen(R%%%))  'If drop out is in 1st year, no partial education achieved
                        'dropoutrate = AMAX(0, (1 - (EDPRISUR(R%%%, gndr%) / 100)) / AMAX(1, PriYears%))
                        'Assume dropoutrate is same in every year of primary education
                        'mti review : current students for partial years? bt goes to 25+
                        '???????????? makes OECD high?
    
                        'pristudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        gr_Students = CSng(fagedst(CInt(edpristart(R%%%) + GCount% - 1), R%%%, gndr%) *
                                    pristudents(GCount%, R%%%, gndr%) / 100)
                        PartialPriPersYearsNew = PartialPriPersYearsNew +
                    (gr_Students * Dropoutrate) * (GCount% - 1)
    
                        '            PartialPriPersYearsNew = PartialPriPersYearsNew + _
                        '(gr_Students * PriDrpOutGrs(GCount%)) * (GCount% - 1)
    
                        'Subtraction of 1 because dropout in 2nd year gives one year of partial education
                    Next GCount%
    
                    'Total Years of education from secondary completion, for people aged (25 or 15) and above
                    TotYearsSecEdPop = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsSecEdPop = CSng(TotYearsSecEdPop + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
    
                        'If gndr = 1 And 15 = 15 And AdultAgeEnd = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        'If gndr = 1 And 15 = 15 And AdultAgeEnd = 9999 And GRPS(1, R%%%) = "Bhutan" Then
                        '    Stop
                        '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag15difi(R%, Male)) & "," & CStr(AdultAgeEnd) & vbNewLine)
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(j) & "," & CStr(EdUpprSecPopPer(j%, R%%%, gndr%)) & "," & CStr(agedst(j%, R%%%, gndr%)) & vbNewLine)
                        'End If
    
                    Next j%
                    'Average Years of education from secondary completion, for people aged (25 or 15) and above
                    AvgYearsSecEdPop = TotYearsSecEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from lower secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartiallowrSecPersYearsNew = 0
    
                    'mti 2017/01/24 start
                    'Dropoutrate = AMAX(0, 1 - ((EDSECLOWRSUR(R%%%, gndr%) / 100) ^ (1 / (edseclowrlen(R%%%) - 1)))) 'dropout rate for gender
                    caledsecint = sEDPRICR(R%%%, gndr%) * EDSECLOWRTRAN(R%%%, gndr) / 100
                    Dropoutrate = CSng(AMAX(0, 1 - (EDSECLOWRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edseclowrlen(R%%%))))
                    'mti 2017/01/24 End
    
                    For GCount% = 2 To CInt(edseclowrlen(R%%%))
                        'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                        'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        'mti August 2009
                        c_age = CInt(seclowrStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to seclowrStart
                        If c_age <= 15 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        seclowrstudents(GCount%, R%%%, gndr%) / 100)
                            PartiallowrSecPersYearsNew = PartiallowrSecPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
    
    
                    'Partial Years of education from upper secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartialupprSecPersYearsNew = 0
                    If edsecupprlen(R%%%) > 1 Then
    
                        'mti 2017/01/24 Start
                        'Dropoutrate = AMAX(0, 1 - ((EDSECUPPRSUR(R%%%, gndr%) / 100) ^ (1 / (edsecupprlen(R%%%) - 1)))) 'dropout rate for gender
    
                        If IY%% = 1 Then
                            caledsecint = EDSECLOWRGRATE(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        Else
                            caledsecint = sEDSECLOWRGRate(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        End If
    
                        Dropoutrate = CSng(AMAX(0, 1 - (EDSECUPPRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edsecupprlen(R%%%))))
                        'mti 2017/01/24 End
    
                        For GCount% = 2 To CInt(edsecupprlen(R%%%))
                            'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                            'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                            c_age = CInt(secupprStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to secupprStart
                            If c_age <= 15 + 4 Then 'take partial years for the bottom cohort
                                gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                            secupprstudents(GCount%, R%%%, gndr%) / 100)
    
                                PartialupprSecPersYearsNew = PartialupprSecPersYearsNew +
                            (gr_Students * Dropoutrate) * (GCount% - 1)
                            End If
                        Next GCount%
                    End If
    
                    'Total Years of education from tertiary completion, for people aged (25 or 15) and above
                    TotYearsTerEdPop = 0
                    TerYears% = 4 '3  '???5A can be 3 years
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsTerEdPop = CSng(TotYearsTerEdPop +
                    EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                    Next j%
    
                    'Average Years of education from tertiary completion, for people aged (25 or 15) and above
                    AvgYearsTerEdPop = TotYearsTerEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from tertiary dropout, for people aged (25 or 15) and above
                    PartialTerPersYearsNew = 0
                    Dropoutrate = CSng(AMAX(0, 1 - (EDTERGRATE(R%%%, gndr%) / EDTERINT(R%%%, gndr%)) ^ (1 / terlen(R%%%)))) 'dropout rate for gender
                    For GCount% = 2 To 4 '5
    
                        c_age = CInt(terstart(R%%%) + GCount% - 1)
                        If c_age <= 15 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        terstudents(GCount%, R%%%, gndr%) / 100)
    
                            PartialTerPersYearsNew = PartialTerPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
                    'Partial Years of education (million), total from all levels, from dropout, for people aged (25 or 15) and above
                    PartialYearsTotalNew = PartialPriPersYearsNew + PartiallowrSecPersYearsNew + PartialupprSecPersYearsNew _
                                         + PartialTerPersYearsNew
                    'If GRPS(1,R%%%) = "China" Then Stop
                    If IY%%% = 1 Then 'Spread partial years like primary years
                        'Because calculated for cohort (not year), assign to full cohort
                        'EdPartialPopPer15(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'partial years per person by cohort [tertiary/upper sec partial years should be omitted for persons below 25]
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer15(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer15(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                   AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '-----mti january 2008 - check here for sec/ter for age 15+, if the denom is zero skip to a higher cohort
                        'for pri if Edpripopper (6) is zero go to higher cohorts
                        'for pri 15+, partial years might be high for 15+ and thus ratio not right for higher
                        '-------------------------
    
                        'RatioPartialCompleted = EdPartialPopPer15(6, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(6, R%%%, gndr%))
                        RatioPartialCompleted = EdPartialPopPer15(CohtInit%, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(CohtInit%, R%%%, gndr%))
    
                        'For j% = 7 To NCohorts
                        For j% = CohtInit% + 1 To CohtLast% 'NCohorts
                            'mti June 2006 - ??? EdPriPopPer(6, R%%%, gndr%) or EdPriPopPer(j%, R%%%, gndr%)
                            'mti June 2006
                            '                EdPartialPopPer15(j%, R%%%, gndr%) = EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted
                            EdPartialPopPer15(j%, R%%%, gndr%) = EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                            '            Debug.Print gndr; GRPS(1,R%%); j; EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted; EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                        Next j%
    
                        'save the ratio
                        'For j% = 6 To NCohorts
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer15(j%, R%%%, gndr%) = EdPartialPopPer15(j%, R%%%, gndr%)
                        Next j%
                    Else 'Update partial years and count total
                        'EdPartialPopPer15(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer15(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer15(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                        AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '            For j% = NCohorts To 7 Step -1
                        '               EdPartialPopPer15(j%, R%%%, gndr%) = SEdPartialPopPer(j%, R%%%, gndr%) + _
                        '                SEdPartialPopPer(j% - 1, R%%%, gndr%) / 5 - SEdPartialPopPer(j%, R%%%, gndr%) / 5
                        '            Next j%
                        For j% = CohtLast% To CohtInit% + 1 Step -1  'NCohorts
                            EdPartialPopPer15(j%, R%%%, gndr%) = sEdPartialPopPer15(j%, R%%%, gndr%) +
                            sEdPartialPopPer15(j% - 1, R%%%, gndr%) / 5 - sEdPartialPopPer15(j%, R%%%, gndr%) / 5
                        Next j%
    
                        '            For j% = 6 To NCohorts
                        '                SEdPartialPopPer(j%, R%%%, gndr%) = EdPartialPopPer15(j%, R%%%, gndr%)
                        '            Next j%
    
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer15(j%, R%%%, gndr%) = EdPartialPopPer15(j%, R%%%, gndr%)
                        Next j%
    
                    End If
    
                    PartialYearsTotal = 0
                    'For j% = 6 To NCohorts
                    'mti August 2009 -unnecessarily multiplied by 100
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        'PartialYearsTotal = PartialYearsTotal + EdPartialPopPer15(j%, R%%%, gndr%) / 100 _
                        '    * agedst(j%, R%%%, gndr%)
                        PartialYearsTotal = CSng(PartialYearsTotal + EdPartialPopPer15(j%, R%%%, gndr%) _
                        * agedst(j%, R%%%, gndr%))
                    Next j%
    
                    'If GRPS(1, R%%) = "United Kingdom" And gndr% = 1 And AdultAgeEnd = 24 Then Stop
                    PartialYearsEdPop = PartialYearsTotal / AMAX(0.0000001, AdultPop1)
    
                    Comp = AvgYearsPriEdPop + AvgYearsSecEdPop + AvgYearsTerEdPop + PartialYearsEdPop
                    '   If GRPS(1,R%%) = "UAE" And gndr% = 2 Then
                    '
                    '    Debug.Print IY%%; AvgYearsPriEdPop25plus; AvgYearsSecEdPop25plus; _
                    '        AvgYearsTerEdPop25plus; PartialYearsEdPop25plus; _
                    '        PartialPriPersYearsNew; PartialSecPersYearsNew; PartialTerPersYearsNew
                    '   End If
    
                    'If GRPS(1, R%%%) = "India" Then Stop
    
                    'mti 2023/12/30 start
                    Dim iEDYRSAdult As Single
                    'mti 2023/12/30 start
    
                    If IY%%% = 1 Then
    
                        'record the initial difference for later use
    
                        If gndr% = 1 Then
                            EDYRSAdult = EDYRSAG15(R%%, Male)
                        Else 'gndr=2
                            EDYRSAdult = EDYRSAG15(R%%, Female)
                        End If
    
                        'edyrsag25difi(R%%%, gndr%) = EDYRSAG25(R%%%, gndr%) - comp
                        edyrsadultdifi = EDYRSAdult - Comp
                        If gndr% = 1 Then
                            edyrsag15difi(R%, Male) = edyrsadultdifi
                        Else 'gndr=2
                            edyrsag15difi(R%, Female) = edyrsadultdifi
                        End If
    
                        'mti 2023/12/30 start 'save initial values of ed years
                        If AdultAgeEnd = 9999 Then
                            If 15 = 15 Then
                                iEdYrsAg15Tot(R%%%) = EDYRSAdult
                            ElseIf 15 = 25 Then
                                iEdYrsAg25Tot(R%%%) = EDYRSAdult
                            End If
                        ElseIf 15 = 15 And AdultAgeEnd = 24 Then
                            iEdYrsAg15to24Tot(R%%%) = EDYRSAdult
                        ElseIf 15 = 20 And AdultAgeEnd = 29 Then
                            iEdYrsAg20to29Tot(R%%%) = EDYRSAdult
                        End If
                        'mti 2023/12/30 end
    
    
    
                        'If gndr = 1 And 15 = 15 And AdultAgeEnd = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        '    Stop
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(edyrsag15difi(R%, Male)) & "," & CStr(AvgYearsPriEdPop) & "," & CStr(AvgYearsSecEdPop) & "," & CStr(AvgYearsTerEdPop) & "," & CStr(PartialYearsEdPop) & vbNewLine)
                        'End If
    
                    Else
                            'If gndr = 1 And 15 = 15 And AdultAgeEnd = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                            '    Stop
                            '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag15difi(R%, Male)) & "," & CStr(AdultAgeEnd) & vbNewLine)
                            '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(edyrsag15difi(R%, Male)) & "," & CStr(AvgYearsPriEdPop) & "," & CStr(AvgYearsSecEdPop) & "," & CStr(AvgYearsTerEdPop) & "," & CStr(PartialYearsEdPop) & vbNewLine)
                            'End If
    
                            'calculated this year plus initial difference
                            If gndr% = 1 Then
                            edyrsadultdifi = edyrsag15difi(R%, Male)
                        Else 'gndr=2
                            edyrsadultdifi = edyrsag15difi(R%, Female)
                        End If
                        'EDYRSAG25(R%%%, gndr%) = AMAX(0.01, comp + edyrsag25difi(R%%%, gndr%))
    
                        'mti 2023/12/30 start 'save initial values of ed years
                        If AdultAgeEnd = 9999 Then
                            If 15 = 15 Then
                                iEDYRSAdult = iEdYrsAg15Tot(R%%%)
                            ElseIf 15 = 25 Then
                                iEDYRSAdult = iEdYrsAg25Tot(R%%%)
                            End If
                        ElseIf 15 = 15 And AdultAgeEnd = 24 Then
                            iEDYRSAdult = iEdYrsAg15to24Tot(R%%%)
                        ElseIf 15 = 20 And AdultAgeEnd = 29 Then
                            iEDYRSAdult = iEdYrsAg20to29Tot(R%%%)
                        End If
                        'mti 2023/12/30 end
    
                        'mti 2018/09/19 Start
                        'EDYRSAdult = AMAX(0.01, Comp + edyrsadultdifi)
                        If AdultAgeEnd < 35 Then
                            'mti 2024/01/17 start
                            EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250)) '20 mti 2024/01/17 'mti 2023/12/11 was 250; changed to 100 on Dec 11
                            'mti 2024/01/17 end
                        Else
                            'mti 2022/12/12 start
                            ''EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))
                            ''If GRPS(1, R%%%) = "Belarus" Then Stop
                            'If GRPS(1, R%%%) = "United Kingdom" Then Stop
                            ''If GRPS(1, R%%%) = "Ethiopia" Then Stop
                            'If GRPS(1, R%%%) = "United States of America" Then Stop
                            'If GRPS(1, R%%%) = "Congo, Dem. Republic of the" Then Stop
    
                            If edyrsadultdifi > 0 Then
    
                                'mti 2023/12/30 start
                                'If iEDYRSAdult > 10 Then
                                '    EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))
                                'Else
                                '    EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250))
                                'End If
                                EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, CInt(1500 / iEDYRSAdult))) 'faster convergence for high ed; slower for lower initial ed attain years
                                'EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 250))  ' was 250  'mti 2023/12/11 was 250; ; changed to 100 on Dec 11
                                'mti 2023/12/30 end
                            Else
                                EDYRSAdult = AMAX(0.01, Comp + ConvergeOverTime(edyrsadultdifi, 0, 125))    'mti 2023/12/11 was 125; ; changed to 50 on Dec 11
                            End If
                            'mti 2022/12/12 End
                        End If
    
                        'mti 2018/09/19 End
                    End If
    
                    'note March 16, 2015 : is this calculated at IY%%=1 as well?
                    If gndr% = 1 Then
                        AdultPop1Male = AdultPop1
                        EDYRSAG15(R%%, Male) = EDYRSAdult
    
                        'mti 2015/03/04 - start
                        If edyrsagm(R%%%, NGender%) <> 1 Then  'multiplier on total (i.e., both sexes)
                            EDYRSAG15(R%%, Male) = EDYRSAG15(R%%, Male) * edyrsagm(R%%%, NGender%)
                        Else
                            EDYRSAG15(R%%, Male) = EDYRSAG15(R%%, Male) * edyrsagm(R%%%, gndr%)
                        End If
                        'mti 2015/03/04 - end
    
                        'mti 2015/03/30 - start
                        EDYRSAG15(R%%, Male) = Amin(20, EDYRSAG15(R%%, Male))
                        'mti 2015/03/30 - end
    
                    Else 'gndr=2
                        AdultPop1Female = AdultPop1
                        EDYRSAG15(R%%, Female) = EDYRSAdult
    
                        'mti 2015/03/04 - start
                        If edyrsagm(R%%%, NGender%) <> 1 Then  'multiplier on total (i.e., both sexes)
                            EDYRSAG15(R%%, Female) = EDYRSAG15(R%%, Female) * edyrsagm(R%%%, NGender%)
                        Else
                            EDYRSAG15(R%%, Female) = EDYRSAG15(R%%, Female) * edyrsagm(R%%%, gndr%)
                        End If
                        'mti 2015/03/04 - end
    
                        'mti 2015/03/30 - start
                        EDYRSAG15(R%%, Female) = Amin(20, EDYRSAG15(R%%, Female))
                        'mti 2015/03/30 - end
    
                    End If
    
    
                    'mti 2024/03/25 start  
                    If AdultAgeEnd = 9999  Then
                        For j% = 0 To CohtInit% - 1 'NCohorts
                            If 15 = 15 Then
                                EdYears(j%, R%%%, gndr%) = 0
                            End If
                            If 15 = 25 Then
                                EdYears25(j%, R%%%, gndr%) = 0
                            End If
                        Next j%
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            'If R%% = 124 And j = 6 And gndr = 1 And 15 = 15 Then Stop
                            CohortYrs = 0
                            CohortYrs = CSng(CohortYrs + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                            CohortYrs = CSng(CohortYrs + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
                            CohortYrs = CSng(CohortYrs + EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                            CohortYrs = CSng(CohortYrs + EdPartialPopPer15(j%, R%%%, gndr%) * agedst(j%, R%%%, gndr%))
                            If Comp > 0 And agedst(j%, R%%%, gndr%) > 0 Then
    
                                'should really take the converged shift; not the initial shift
                                'CohortYrs = CSng((CohortYrs + agedst(j%, R%%%, gndr%) * edyrsadultdifi) / agedst(j%, R%%%, gndr%))
    
                                'withiut shift
                                CohortYrs = CSng(CohortYrs / agedst(j%, R%%%, gndr%))
                            Else
                                CohortYrs = 0
                            End If
                            If 15 = 15 Then
                                EdYears(j%, R%%%, gndr%) = CohortYrs
                            End If
                            If 15 = 25 Then
                                EdYears25(j%, R%%%, gndr%) = CohortYrs
                            End If
                        Next j%
                    End If
                    'mti 2024/03/25 end
    
    
                Next gndr%
    
    
                'mti 2024/03/25 start
                If AdultAgeEnd = 9999 And 15 = 25 Then
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        CohortYrs = CSng(EdYears(j%, R%%%, Female) * agedst(j%, R%%%, Female) + EdYears(j%, R%%%, Male) * agedst(j%, R%%%, Male))
                        If agedst(j%, R%%%, Female) + agedst(j%, R%%%, Male) > 0 Then
                            CohortYrs = CSng(CohortYrs / (agedst(j%, R%%%, Female) + agedst(j%, R%%%, Male)))
                        Else
                            CohortYrs = 0
                        End If
                        If 15 = 15 Then
                            EdYears(j%, R%%%, 3) = CohortYrs
                        End If
                        If 15 = 25 Then
                            EdYears25(j%, R%%%, 3) = CohortYrs
                        End If
                    Next j%
                End If
                'mti 2024/03/25 end
    
    
                'EDYRSAG25(R%%%, Total) = (PopAge25Male * EDYRSAG25(R%%%, Male) + PopAge25FeMale * EDYRSAG25(R%%%, Female)) / AMAX(0.0001, (PopAge25Male + PopAge25FeMale))
                'mti 2015/03/30 - start
                'EDYRSAG15(R%%, Total) = Amin(AdultAgeEnd - 15 + 1, (AdultPop1Male * EDYRSAG15(R%%, Male) + AdultPop1Female * EDYRSAG15(R%%, Female)) / AMAX(0.0001, (AdultPop1Male + AdultPop1Female)))
                EDYRSAG15(R%%, Total) = Amin(20, (AdultPop1Male * EDYRSAG15(R%%, Male) + AdultPop1Female * EDYRSAG15(R%%, Female)) / AMAX(0.0001, (AdultPop1Male + AdultPop1Female)))
                'mti 2015/03/30 - end
    
' End Sub
    ' ---- End Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr

AverageEducationYearsLowrUppr(IY%%, R%%, 25, pristudents, seclowrstudents, secupprstudents, terstudents, EDYRSAG25(R%%, Male), EDYRSAG25(R%%, Female), EDYRSAG25(R%%, Total), edyrsag25difi(R%, Male), edyrsag25difi(R%, Female), EdPriPopPer, EdUpprSecPopPer, EdTerPopPer, EdPartialPopPer25, sEdPartialPopPer25)
    ' ---- Begin Inlined Level 2: CalcEducationyears:AverageEducationYearsLowrUppr
' Private Sub AverageEducationYearsLowrUppr(IY%%, R%%, AdultAge As Single, pristudents(,,) As Single, seclowrstudents(,,) As Single, secupprstudents(,,) As Single, terstudents(,,) As Single,
' ByRef EDYRSAdultMale As Single, ByRef EDYRSAdultFemale As Single, ByRef EDYRSAdultTotal As Single, ByRef edyrsadultdifiMale As Single, ByRef edyrsadultdifiFemale As Single,
' EdPriPopPer(,,) As Single, EdUpprSecPopPer(,,) As Single, EdTerPopPer(,,) As Single, ByRef EdPartialPopPer(,,) As Single, ByRef sEdPartialPopPer(,,) As Single, Optional AdultAgeEnd As Single = 9999)
                '--------------------------------------------------------------------------------------------------------------------------------------
                'Education Module
                'mti 2016/03/30 - take entire procedure
    
                'mti 2014/10/06 - whole proc
    
                '   All Years:  Compute Average Years of Education for Age 15 and above, 15 to 24; and age 25 and above
                '=============================================================================
    
                'secondary starts at this age
                'ttt 2019/10/08 comment
                'Dim seclowrStart, secupprStart As Single
                'seclowrStart = edpristart(R%%%) + edprilen(R%%%)
                'secupprStart = seclowrStart + edseclowrlen(R%%%)
                'End zz191 comment
    
                'terstart = secupprStart + edsecupprlen(R%%%)
    
                'mti 2024/03/25 start
                Dim CohortYrs As Single
                'mti 2024/03/25 end
    
                Dim CohtInit, CohtLast As Integer
                CohtInit% = CInt(CLng(25) \ 5 + 1)  '4 for 15+, 6 for 25+
                If AdultAgeEnd = 9999 Then
                    CohtLast% = NCohorts
                Else
                    CohtLast% = CInt(CLng(AdultAgeEnd) \ 5 + 1)
                End If
    
                Dim TotYearsPriEdPop, AdultPop1, AvgYearsPriEdPop, PartialPriPersYearsNew, Dropoutrate As Single
                Dim gr_Students, TotYearsSecEdPop, AvgYearsSecEdPop, PartiallowrSecPersYearsNew As Single
                Dim caledsecint, PartialupprSecPersYearsNew, TotYearsTerEdPop, AvgYearsTerEdPop As Single
                Dim PartialTerPersYearsNew, PartialYearsTotalNew, RatioPartialCompleted, PartialYearsTotal As Single
                Dim PartialYearsEdPop, Comp, EDYRSAdult, edyrsadultdifi, AdultPop1Male, AdultPop1Female As Single
                Dim c_age, TerYears As Integer
    
                For gndr% = 1 To NGender% - 1 'mti education
    
                    'Total Years of education from primary completion, for people aged (25 or 15) and above
                    TotYearsPriEdPop = 0
    
                    'Population aged (25 or 15) and above
                    AdultPop1 = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsPriEdPop = CSng(TotYearsPriEdPop + EdPriPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * edprilen(R%%%))
                        AdultPop1 = CSng(AdultPop1 + agedst(j%, R%%%, gndr%)) '+ agedst(j%, R%%%, 2)
                    Next j%
    
                    'Average Years of education from primary completion, for people aged (25 or 15) and above
                    AvgYearsPriEdPop = TotYearsPriEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from primary dropout, for people aged (25 or 15) and above
                    PartialPriPersYearsNew = 0  'Person Years of Partial Primary Education, Across 5 Year Cohort
    
                    'differentiated dropout here?
                    Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%%%, gndr%) / 100) ^ (1 / (edprilen(R%%%) - 1))))) 'dropout rate for gender
                    '        Call DropoutSpread(edprilen(R%%%), EDPRISUR(R%%%, gndr%), PriDrpOutGrs())
    
                    For GCount% = 2 To CInt(edprilen(R%%%))  'If drop out is in 1st year, no partial education achieved
                        'dropoutrate = AMAX(0, (1 - (EDPRISUR(R%%%, gndr%) / 100)) / AMAX(1, PriYears%))
                        'Assume dropoutrate is same in every year of primary education
                        'mti review : current students for partial years? bt goes to 25+
                        '???????????? makes OECD high?
    
                        'pristudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        gr_Students = CSng(fagedst(CInt(edpristart(R%%%) + GCount% - 1), R%%%, gndr%) *
                                    pristudents(GCount%, R%%%, gndr%) / 100)
                        PartialPriPersYearsNew = PartialPriPersYearsNew +
                    (gr_Students * Dropoutrate) * (GCount% - 1)
    
                        '            PartialPriPersYearsNew = PartialPriPersYearsNew + _
                        '(gr_Students * PriDrpOutGrs(GCount%)) * (GCount% - 1)
    
                        'Subtraction of 1 because dropout in 2nd year gives one year of partial education
                    Next GCount%
    
                    'Total Years of education from secondary completion, for people aged (25 or 15) and above
                    TotYearsSecEdPop = 0
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsSecEdPop = CSng(TotYearsSecEdPop + EdUpprSecPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * (edseclowrlen(R%%%) + edsecupprlen(R%%%)))
    
                        'If gndr = 1 And 25 = 15 And AdultAgeEnd = 9999 And (GRPS(1, R%%%) = "India" Or GRPS(1, R%%%) = "Ethiopia") Then
                        'If gndr = 1 And 25 = 15 And AdultAgeEnd = 9999 And GRPS(1, R%%%) = "Bhutan" Then
                        '    Stop
                        '    'Debug.Print(GRPS(1, R%%%) & "," & CStr(edyrsag25difi(R%, Male)) & "," & CStr(AdultAgeEnd) & vbNewLine)
                        '    Debug.Print(GRPS(1, R%%%) & "," & CStr(IY%%) & "," & CStr(j) & "," & CStr(EdUpprSecPopPer(j%, R%%%, gndr%)) & "," & CStr(agedst(j%, R%%%, gndr%)) & vbNewLine)
                        'End If
    
                    Next j%
                    'Average Years of education from secondary completion, for people aged (25 or 15) and above
                    AvgYearsSecEdPop = TotYearsSecEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from lower secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartiallowrSecPersYearsNew = 0
    
                    'mti 2017/01/24 start
                    'Dropoutrate = AMAX(0, 1 - ((EDSECLOWRSUR(R%%%, gndr%) / 100) ^ (1 / (edseclowrlen(R%%%) - 1)))) 'dropout rate for gender
                    caledsecint = sEDPRICR(R%%%, gndr%) * EDSECLOWRTRAN(R%%%, gndr) / 100
                    Dropoutrate = CSng(AMAX(0, 1 - (EDSECLOWRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edseclowrlen(R%%%))))
                    'mti 2017/01/24 End
    
                    For GCount% = 2 To CInt(edseclowrlen(R%%%))
                        'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                        'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                        'mti August 2009
                        c_age = CInt(seclowrStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to seclowrStart
                        If c_age <= 25 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        seclowrstudents(GCount%, R%%%, gndr%) / 100)
                            PartiallowrSecPersYearsNew = PartiallowrSecPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
    
    
                    'Partial Years of education from upper secondary dropout (gen only, since voc has no dropout), for people aged (25 or 15) and above
                    PartialupprSecPersYearsNew = 0
                    If edsecupprlen(R%%%) > 1 Then
    
                        'mti 2017/01/24 Start
                        'Dropoutrate = AMAX(0, 1 - ((EDSECUPPRSUR(R%%%, gndr%) / 100) ^ (1 / (edsecupprlen(R%%%) - 1)))) 'dropout rate for gender
    
                        If IY%% = 1 Then
                            caledsecint = EDSECLOWRGRATE(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        Else
                            caledsecint = sEDSECLOWRGRate(R%%%, gndr%) * EDSECUPPRTRAN(R%%%, gndr) / 100
                        End If
    
                        Dropoutrate = CSng(AMAX(0, 1 - (EDSECUPPRGRATE(R%%%, gndr) / caledsecint) ^ (1 / edsecupprlen(R%%%))))
                        'mti 2017/01/24 End
    
                        For GCount% = 2 To CInt(edsecupprlen(R%%%))
                            'dropoutrate = AMAX(0, (1 - (EDSECSUR(R%%%, gndr%) / 100)) / AMAX(1, SecYears%))
                            'secstudents(GCount%, R%%%, gndr%) is the rate now; gr_Students is the students in that grade
                            c_age = CInt(secupprStart(R%%%) + GCount% - 1) 'ttt 2019/10/08 added R%%% to secupprStart
                            If c_age <= 25 + 4 Then 'take partial years for the bottom cohort
                                gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                            secupprstudents(GCount%, R%%%, gndr%) / 100)
    
                                PartialupprSecPersYearsNew = PartialupprSecPersYearsNew +
                            (gr_Students * Dropoutrate) * (GCount% - 1)
                            End If
                        Next GCount%
                    End If
    
                    'Total Years of education from tertiary completion, for people aged (25 or 15) and above
                    TotYearsTerEdPop = 0
                    TerYears% = 4 '3  '???5A can be 3 years
                    'For j% = 6 To NCohorts
                    For j% = CohtInit% To CohtLast% 'NCohorts
                        TotYearsTerEdPop = CSng(TotYearsTerEdPop +
                    EdTerPopPer(j%, R%%%, gndr%) / 100 * agedst(j%, R%%%, gndr%) * TerYears%)
                    Next j%
    
                    'Average Years of education from tertiary completion, for people aged (25 or 15) and above
                    AvgYearsTerEdPop = TotYearsTerEdPop / AMAX(0.0000001, AdultPop1)
    
                    'Partial Years of education from tertiary dropout, for people aged (25 or 15) and above
                    PartialTerPersYearsNew = 0
                    Dropoutrate = CSng(AMAX(0, 1 - (EDTERGRATE(R%%%, gndr%) / EDTERINT(R%%%, gndr%)) ^ (1 / terlen(R%%%)))) 'dropout rate for gender
                    For GCount% = 2 To 4 '5
    
                        c_age = CInt(terstart(R%%%) + GCount% - 1)
                        If c_age <= 25 + 4 Then 'take partial years for the bottom cohort
                            gr_Students = CSng(fagedst(c_age, R%%%, gndr%) *
                                        terstudents(GCount%, R%%%, gndr%) / 100)
    
                            PartialTerPersYearsNew = PartialTerPersYearsNew +
                        (gr_Students * Dropoutrate) * (GCount% - 1)
                        End If
                    Next GCount%
    
                    'Partial Years of education (million), total from all levels, from dropout, for people aged (25 or 15) and above
                    PartialYearsTotalNew = PartialPriPersYearsNew + PartiallowrSecPersYearsNew + PartialupprSecPersYearsNew _
                                         + PartialTerPersYearsNew
                    'If GRPS(1,R%%%) = "China" Then Stop
                    If IY%%% = 1 Then 'Spread partial years like primary years
                        'Because calculated for cohort (not year), assign to full cohort
                        'EdPartialPopPer25(6, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(6, R%%%, gndr%))) * 100
    
                        'partial years per person by cohort [tertiary/upper sec partial years should be omitted for persons below 25]
    
                        'mti August 2009 -unnecessarily multiplied by 100
                        'EdPartialPopPer25(CohtInit%, R%%%, gndr%) = (PartialYearsTotalNew / _
                        'AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))) * 100
    
                        EdPartialPopPer25(CohtInit%, R%%%, gndr%) = CSng((PartialYearsTotalNew /
                   AMAX(0.0000001, agedst(CohtInit%, R%%%, gndr%))))
    
                        '-----mti january 2008 - check here for sec/ter for age 15+, if the denom is zero skip to a higher cohort
                        'for pri if Edpripopper (6) is zero go to higher cohorts
                        'for pri 15+, partial years might be high for 15+ and thus ratio not right for higher
                        '-------------------------
    
                        'RatioPartialCompleted = EdPartialPopPer25(6, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(6, R%%%, gndr%))
                        RatioPartialCompleted = EdPartialPopPer25(CohtInit%, R%%%, gndr%) / AMAX(0.0000001, EdPriPopPer(CohtInit%, R%%%, gndr%))
    
                        'For j% = 7 To NCohorts
                        For j% = CohtInit% + 1 To CohtLast% 'NCohorts
                            'mti June 2006 - ??? EdPriPopPer(6, R%%%, gndr%) or EdPriPopPer(j%, R%%%, gndr%)
                            'mti June 2006
                            '                EdPartialPopPer25(j%, R%%%, gndr%) = EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted
                            EdPartialPopPer25(j%, R%%%, gndr%) = EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                            '            Debug.Print gndr; GRPS(1,R%%); j; EdPriPopPer(6, R%%%, gndr%) * RatioPartialCompleted; EdPriPopPer(j%, R%%%, gndr%) * RatioPartialCompleted
                        Next j%
    
                        'save the ratio
                        'For j% = 6 To NCohorts
                        For j% = CohtInit% To CohtLast% 'NCohorts
                            sEdPartialPopPer25(j%, R%%%, gndr%) = EdPartialPopPer25(j%, R%%%, gndr%)
                        Next j%
                    Else 'Update partial years and count total
