    ' ---- Begin Inlined Level 2: IFsEducPri_new_init:PrimaryTotals_new_init
' Private Sub PrimaryTotals_new_init(R%, AdultMales As Single, AdultFemales As Single, AdultMales15to24 As Single, AdultFemales15to24 As Single)
                '----------------------------------------------------------------------------------
                'mti 2020/09/01  - Take procedure
                'mti 2016/01/07 - whole procedure
                'Education Module - Total from male and female- Primary
    
                '    Primary: Average male and female to totals;
                '   --------------------------------------------------------------------------------------------------
                'EDPRIINT(R%%, Total) = (EDPRIINT(R%%, 1) * (agedst(2, R%%, 1) / 5) + EDPRIINT(R%%, 2) * (agedst(2, R%%, 2) / 5)) / AMAX(0.0000001, ((agedst(2, R%%, 1) + agedst(2, R%%, 2)) / 5))
                EDPRIINT(R%%, Total) = CSng((EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) _
                                + EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) _
                                / AMAX(0.0000001, fagedst(CInt(edpristart(R%%)), R%%, 1) + fagedst(CInt(edpristart(R%%)), R%%, 2)))
    
                EDPRIINTN(R%%, Total) = CSng((EDPRIINTN(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) _
                                + EDPRIINTN(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) _
                                / AMAX(0.0000001, fagedst(CInt(edpristart(R%%)), R%%, 1) + fagedst(CInt(edpristart(R%%)), R%%, 2)))
    
    
                EDPRISUR(R%%, Total) = CSng(((EDPRISUR(R%%, 1) * EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) + EDPRISUR(R%%, 2) * EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) /
                AMAX(0.0000001, (EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) + EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2))))) '* 100
    
    
    Dim PriBoys = CInt(edpristart(R%%)) + edprilen(R%%) + R%% + Male @@Dim PriBoys = CalcPopFrom1Year(CInt(edpristart(R%%)), edprilen(R%%), R%%, Male)@@
    Dim PriGirls = CInt(edpristart(R%%)) + edprilen(R%%) + R%% + Female @@Dim PriGirls = CalcPopFrom1Year(CInt(edpristart(R%%)), edprilen(R%%), R%%, Female)@@
    
                'mti 2020/09/01  Start
                For GCount% = 1 To CInt(edprilen(R%%)) '+ 1 To NPriGr
                    Dim Pupils_Male = EDPRIENRGGRD(R%%, GCount%, Male) * fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Male)
                    Dim Pupils_Female = EDPRIENRGGRD(R%%, GCount%, Female) * fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Female)
                    Dim Population_Total = fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Male) + fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Female)
                    Dim Pupils_Total = Pupils_Male + Pupils_Female
    
                    EDPRIENRGGRD(R%%, GCount%, Total) = CSng((Pupils_Male + Pupils_Female) / AMAX(0.00001, Population_Total))
    
                    If GCount% < edprilen(R%%) Then
                        EDPRIDRPGRD(R%%, GCount%, Total) = CSng((EDPRIDRPGRD(R%%, GCount%, Male) * Pupils_Male + EDPRIDRPGRD(R%%, GCount%, Female) * Pupils_Female) / AMAX(0.000001, Pupils_Total))
                    End If
                Next
