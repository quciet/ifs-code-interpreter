                                s_growth = GRate_gndr * ((100 - Amin(100, gEDPRIINTN(R%, gndr))) / (100 - 50)) * (gEDPRIINTN(R%, gndr) / 50)
                            Else  '3 =3 ; log formulation
                                'Amin(100, gEDPRIINTN(R%, gndr)) - this is needed as some country's lower/upper sec survival value at te initial year night be above the cap; they are brought down later
                                's_growth = GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDPRIINTN(R%, gndr)), 100 + 1 - 50)) / Log(100 + 1 - 50) * Log(AMAX(1.1, gEDPRIINTN(R%, gndr))) / Log(50)
                                s_growth = CSng(GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDPRIINTN(R%, gndr)), 100 + 1 - 50)) / Log(100 + 1 - 50) * Log(AMAX(1.1, Amin(100, gEDPRIINTN(R%, gndr)))) / Log(50))
