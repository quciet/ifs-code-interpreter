                TotBoys = fagedst(CInt(secupprStart + edsecupprlen(R%%)), R%%, Male)
                TotGirls = fagedst(CInt(secupprStart + edsecupprlen(R%%)), R%%, Female)
                EDSECUPPRGRATE(R%%, Total) = CSng((EDSECUPPRGRATE(R%%, Male) * TotBoys + EDSECUPPRGRATE(R%%, Female) * TotGirls) / AMAX(0.0000001, TotBoys + TotGirls)) '* 100
    
    
