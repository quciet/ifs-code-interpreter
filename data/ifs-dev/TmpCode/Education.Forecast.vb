                    End If

                    'First Year Upper Secondary: determine (general curriculum) grade-wise enrollment rates and total number of students
Call GradeWiseEnrollmentInit(R%, gndr, secStart(R%) + edseclowrlen(R%), edsecupprlen(R%), caledsecint, secupprstudents, Dropoutrate, drpoutgr, EDSECUPPRTOT(R%, gndr))
    ' ---- Begin Inlined Level 2: IFsEducSec_new_init:GradeWiseEnrollmentInit
' Private Sub GradeWiseEnrollmentInit(R%, gndr%, startcycle As Single, lencycle As Single, Intake As Single, ByRef GradeStudents(,,) As Single, AvgDropOutRate As Single, ByRef GradeDropOutRate() As Single, ByRef TotStudents As Single)
                '-----Education Module ----------------------------------------------------------------------------------------------
                'mti Education secondary lower and upper October 2007 - new proc
    
                'Initialize total (gross) enrolment in Primary (could not do in pre-processor for the lack of population age-chorts)
                EDSECUPPRTOT(R%, gndr) = 0
    
    
                secupprstudents(1, R%%, gndr%) = caledsecint
                EDSECUPPRTOT(R%, gndr) = EDSECUPPRTOT(R%, gndr) + CSng(fagedst(CInt(secStart(R%) + edseclowrlen(R%)), R%%, gndr%) * secupprstudents(1, R%%, gndr%) / 100)
    
                If Dropoutrate = 9999 Then 'dropout by grades
                    For GCount% = 2 To CInt(edsecupprlen(R%))
                        'grade wise enrolment rate (gross)
                        'Pristudents(GCount%, R%%, gndr%) = EDPRIINT(R%%, gndr%) * (1 - dropoutrate) ^ (GCount% - 1)
                        secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - drpoutgr(GCount% - 1)) '^ (GCount% - 1)
                        secupprstudents(GCount%, R%%, gndr%) = AMAX(0.5, secupprstudents(GCount%, R%%, gndr%))
                        'Add to total enrolment
                        EDSECUPPRTOT(R%, gndr) = EDSECUPPRTOT(R%, gndr) + CSng(fagedst(CInt(secStart(R%) + edseclowrlen(R%) + GCount% - 1), R%%, gndr%) *
                                                secupprstudents(GCount%, R%%, gndr%) / 100)
                    Next GCount%
                Else  'one average dropout
                    For GCount% = 2 To CInt(edsecupprlen(R%))
                        'grade wise enrolment rate (gross)
                        secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - Dropoutrate) '^ (GCount% - 1)
                        secupprstudents(GCount%, R%%, gndr%) = AMAX(0.5, secupprstudents(GCount%, R%%, gndr%))
                        'Add to total enrolment
                        EDSECUPPRTOT(R%, gndr) = EDSECUPPRTOT(R%, gndr) + CSng(fagedst(CInt(secStart(R%) + edseclowrlen(R%) + GCount% - 1), R%%, gndr%) *
                                                secupprstudents(GCount%, R%%, gndr%) / 100)
                    Next GCount%
                End If
    
