                    '(minus the number of repeaters from the last grade of primary education in the given year)
                    'caledsecint = pristudents(CInt(edprilen(R%)), R%, gndr) * EDSECLOWRTRAN(R%, gndr) / 100


                    'First Year Lower Secondary: determine (general curriculum) grade-wise enrollment rates and total number of students
                    'Call GradeWiseEnrollmentInit1(R%, gndr, secStart(R%), cint(edseclowrlen(R%)), caledsecint, "", seclowrstudents(), _
                    'Dropoutrate, drpoutgr(), EDSECLOWRTOT(R%, gndr), EDSECLOWRENRG(R%, gndr), "SecLowr")


                    'First Year Lower Secondary: Gross Enrolment Rate Shifts
                    'mti 2022/04/12 start
                    'CalEdSeclowrEnrG = Amin(150, (EDSECLOWRTOT(R%, gndr) / AMAX(0.001, seclowrpop(R%, gndr))) * 100)
                    Dim CalEdSeclowrEnrG = Amin(150, (EDSECLOWRTOT(R%, gndr) / AMAX(0.001, POPEDSECLOWR(R%, gndr))) * 100)
                    'mti 2022/04/12 end
                    edseclowrenrgshift(R%, gndr) = 0 'EDSECLOWRENRG(R%, gndr) - CalEdSeclowrEnrG

                    'EDSECLOWRTOT(R%, gndr) = seclowrpop(R%, gndr) * EDSECLOWRENRG(R%, gndr) / 100
                    EDSECLOWRTOT(R%, gndr) = AMAX(0.001, seclowrpop(R%, gndr)) * EDSECLOWRENRG(R%, gndr) / 100
                    EDSECLOWRGRADS(R%, gndr) = CSng(fagedst(CInt(secStart(R%) + edseclowrlen(R%)), R%, gndr) * (EDSECLOWRGRATE(R%, gndr) / 100))




                    '   First Year Upper Secondary (Gross Only):  Calculate shifts and initialize grade-flow
