                EDSECLOWRGRATE(R%%, Total) = CSng((EDSECLOWRGRATE(R%%, Male) * TotBoys + EDSECLOWRGRATE(R%%, Female) * TotGirls) / AMAX(0.0000001, TotBoys + TotGirls)) '* 100
    
                ' Secondary Upper
