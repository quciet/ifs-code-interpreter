                        ' If GRPS(1, R%) = "Burundi" And gndr = 1 Then
                        '    'Stop
                        '    Debug.Print IY; ","; GRPS(1, R%); ","; EDPRIINT(R%, gndr%); ","; EDPRISUR(R%, gndr%); ","; EDPRIINT(R%, gndr%) * EDPRISUR(R%, gndr%) / 100; ",";
                        ' End If
    
    
                        If i1EdPriSur(R%, gndr%) > 90 Then
                            For GCount% = 1 To CInt(edprilen(R%)) '
