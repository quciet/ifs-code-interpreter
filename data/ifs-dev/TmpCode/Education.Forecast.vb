' Private Sub FlowGoals(ByRef gflow_val As Single, ByRef flow_val As Single, ByRef GRate_gndr As Single, GRate_Ttl As Single, ByRef max_gp As Single, flow_cap As Single, Optional ftype As Single = 3, Optional trgtyr As Single = 0, Optional initval As Single = 0) '3 '1
                'ttt 2019/08/31 where go EDSECUPPRTRAN(R%, gndr)? (consider ByRef)
                'mti 2014/05/28 - definition and proc
                ''''Education Module
                'mti 2013/10/07 - Education for WC - Take whole proc
    
                '
                'ssErrorSub = sErrorSub
                'sErrorSub = sErrorSub + ", FlowGoals"
    
                'mti 2014/05/28
                'Target year parameter: reach max within trgtyear measured as number of years from the base year (0 is the base value= no target seek)
                Dim trgtval = 0!
                Dim s_growth = 0!
                If edsecupprtrantrgtyr(R%) > 0 Then
    
                    'mti 2016/03/09- start
                    'Linear goal seek
                    trgtval = 100 'for now
                    trgtval = Amin(100, iEdSecUpprTran(R%, gndr%) + Amin(edsecupprtrantrgtyr(R%), IY - 1) * (trgtval - iEdSecUpprTran(R%, gndr%)) / edsecupprtrantrgtyr(R%))
    
                    'logistic goal seek
                    '            stpmid = 9.999 / (edsecupprtrantrgtyr(R%) * 2) 'back calculated from logistic formula
                    '            stpmidmin = AMAX(0.01, stpmid - 0.05)
                    '            stpmidmax = Amin(0.7, stpmid + 0.25)
                    '            stp = Amin(stpmidmax, AMAX(stpmidmin, stpmid + (70 - iEdSecUpprTran(R%, gndr%)) / 100))
                    '            expterm = Exp(stp * Amin(IY - 1, edsecupprtrantrgtyr(R%) + 20))
                    '            trgtval = (100 * iEdSecUpprTran(R%, gndr%) * expterm) / (100 + (iEdSecUpprTran(R%, gndr%) * (expterm - 1)))
                    'mti 2016/03/09- end
    
                    'mti 2014/10/06 - start
                    gEdSecUpprTran(R%, gndr) = AMAX(trgtval, EDSECUPPRTRAN(R%, gndr))
                    EDSECUPPRTRAN(R%, gndr) = gEdSecUpprTran(R%, gndr)
                    'mti 2014/10/06 - end
    
    
                    Exit Sub 'if target year is set - growth rate parameter won't work
                End If
                'mti 2014/05/28
    
                '100 is the ceiling for flow, e.g., 100% for survival
                'grate is the growth rate obtained from scenario handle, if it is 3, 3% (point) growth occurs at 50 and tapers off both way, i.e., towards 0 and 100
                '    If GRate_gndr < 0 Then Stop
                'take the max of the total or the gender being calculated
    
                'mti 2013/09/16 - Education for WC -start
                If edsecupprtrangr(R%, NGender) > 0 Then
                    GRate_gndr = AMAX(GRate_gndr, edsecupprtrangr(R%, NGender))
                ElseIf edsecupprtrangr(R%, NGender) < 0 Then
                    GRate_gndr = Amin(GRate_gndr, edsecupprtrangr(R%, NGender))
                End If
                'mti 2013/09/16 - Education for WC -end
    
                If GRate_gndr = 0 Then
                    Exit Sub
                End If
    
                'mti 2013/09/16 - Education for WC -start
                If GRate_gndr > 0 Then
                    '50 is the point at which maximum growth occurs, as a  percentage of ceiling (or 100);  e.g., 50%
                    50 = 100 * 50 / 100
    
                    'net intake rate growing with a growth rate
    
                    's-shaped growth : point at which maximum growth occurs
                    'standard logistic sigmoid function : dp/dt = P(1-P), with P(0) = .5; or max_gr=50;
                    'In P(1-P); the first term,P controls increasing growth till the midpoint (max_gr); the second term is dcreasing growth from the mid point to saturation
                    'our formulation growth = gr*[P(1-P)]/midpoint; P is the population, here, intake rate
                    'introduced a log formulation now
    
                    If ftype = 1 Then         'non-log, tiered
                        s_growth = GRate_gndr * If(gEdSecUpprTran(R%, gndr) >= 50, (100 - Amin(100, gEdSecUpprTran(R%, gndr))) / (100 - 50), gEdSecUpprTran(R%, gndr) / 50)
                    ElseIf ftype = 2 Then 'non-log- product of terms
                        s_growth = GRate_gndr * ((100 - Amin(100, gEdSecUpprTran(R%, gndr))) / (100 - 50)) * (gEdSecUpprTran(R%, gndr) / 50)
                    Else  'ftype =3 ; log formulation
                        'Amin(100, gEdSecUpprTran(R%, gndr)) - this is needed as some country's lower/upper sec survival value at te initial year night be above the cap; they are brought down later
                        's_growth = GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEdSecUpprTran(R%, gndr)), 100 + 1 - 50)) / Log(100 + 1 - 50) * Log(AMAX(1.1, gEdSecUpprTran(R%, gndr))) / Log(50)
                        s_growth = CSng(GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEdSecUpprTran(R%, gndr)), 100 + 1 - 50)) / Log(100 + 1 - 50) * Log(AMAX(1.1, Amin(100, gEdSecUpprTran(R%, gndr)))) / Log(50))
                    End If
                    gEdSecUpprTran(R%, gndr) = Amin(100, gEdSecUpprTran(R%, gndr) + s_growth) 'previous years' goal value + goal growth
    
                    EDSECUPPRTRAN(R%, gndr) = AMAX(gEdSecUpprTran(R%, gndr), EDSECUPPRTRAN(R%, gndr))  'take the higher of goal or base (function driven) forecast
    
                Else
                    'equation of conic parabola with vertex at 10, Grate_gndr; y= a (x-h)^2+k
                    '            If IY >= 11 Then Stop
                    If IY <= 11 Then
                        s_growth = CSng((Abs(GRate_gndr) * 0.05) * (IY - 6) ^ 2 + GRate_gndr)
                        s_growth = AMAX(GRate_gndr, Amin(s_growth, 0))
                        EDSECUPPRTRAN(R%, gndr) = AMAX(3, Amin(100, gEdSecUpprTran(R%, gndr) + s_growth))  'gEdSecUpprTran(R%, gndr) is first year value for this case
                        'Else
                        's_growth = 0
                        'EDSECUPPRTRAN(R%, gndr) = EDSECUPPRTRAN(R%, gndr)
                    ElseIf gEdSecUpprTran(R%, gndr) < EDSECUPPRTRAN(R%, gndr) Then
                        EDSECUPPRTRAN(R%, gndr) = ConvergeOverTimeSmooth(gEdSecUpprTran(R%, gndr), EDSECUPPRTRAN(R%, gndr), 5)
                    End If
    
                End If
                'mti 2013/09/16 - Education for WC -end
    
' End Sub
    ' ---- End Inlined Level 2: IFsEducSec_new_init:FlowGoals



