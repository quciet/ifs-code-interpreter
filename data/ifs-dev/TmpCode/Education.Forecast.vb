                        seclowrstudents(GCount%, R%, gndr) = seclowrstudents(GCount%, R%, gndr) * Amin(3, AMAX(0.05, If(edseclowrenrm(R%, NGender) <> 1, edseclowrenrm(R%, NGender), edseclowrenrm(R%, gndr))))
