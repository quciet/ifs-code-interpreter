' ---- Begin Inlined Level 1: CalSecurImpact
' Private Sub CalSecurImpact(R%, ByRef countryshift As Single, EdEnrImpactElast As Single, EdQualImpactElast As Single, context As IForecastContext)
            '- - - - - - - - - -  Education  - - - - - - - - - - - - - - - - - - - - -
            'mti 2018/06/18  - new procedure


            'jrs 2024/06/11
            'TbName$ = "GDP/Capita (PPP 2011) Versus Government Security Index (" & CStr(BaseYear) & ") Log"
            'jrs 2026/05/20 
            'TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Government Security Index (" & CStr(BaseYear) & ") Log"
            'TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context, "(PPP " & ConstantDollarsYear & ")")
            'Dim CalVal = 0!
            'Call XYTABL(TbName$, sGDPPCP(R%%), CalVal, context)
            Dim CalVal = 0!
            Call XYTABL(TFNameGovSecIdx, sGDPPCP(R%%), CalVal, context)

            If IY = 2 Then
                GovIndSecurShift(R%) = SGOVINDSECUR(R%%) - CalVal
            End If

            Dim ExpVal = CalVal + ConvergeOverTime(GovIndSecurShift(R%), 0, 100)

            'Security index is 0 to 1; edenrsecur = .1;  .01 diff in govindsecur results in .01 * .1 impact (=.001, % change in survival rate)
            Dim EdEnrImpactVal = (SGOVINDSECUR(R%%) - ExpVal) * edenrsecur  ' edenrsecur '.1  '/ AMAX(0.0001, ExpVal)

            'Security index is 0 to 1;  edqualsecur = .1; .01 diff in govindsecur results in .01 * .1  impact (=.001, change in score)
            Dim EdQualImpactVal = (SGOVINDSECUR(R%%) - ExpVal) * edqualsecur
            'Quantitative/Enrollment/via Survival
            'Barrera and Ibanez - per 1 point increase in homicide rate - impact on primary at .0002 decrease in enr prob; secondary .0001; tertiary .0003 (translating age group -> pri)
            'elemenetary impact .0027 to .0089; .0036 to .0199 - Claudillo and Torch
            EdEnrSecurImpact(R%%, 1) = EdEnrImpactVal * 2  'primary
            EdEnrSecurImpact(R%%, 2) = EdEnrImpactVal      'secondary
            EdEnrSecurImpact(R%%, 3) = EdEnrImpactVal * 3  'tertiary

            'Quality impact
            ' Romano (1995) -Increase of 1 in homicide rate (per 10,000 inhabitants) lowers average test scores
            'between 0.0035 and and .0039 standard deviations for primary students
            'between .0089 and .0142 standard deviations for secondary students.
            EdQualSecurImpact(R%%, 1) = EdQualImpactVal     'primary
            EdQualSecurImpact(R%%, 2) = EdQualImpactVal * 2    'secondary



' End Sub
' ---- End Inlined Level 1: CalSecurImpact
                'mti 2018/06/18 End

            Next R%
            For R% = 1 To NR
                '   All years but First Before Budget: Expenditures: Per Student Expenditures by Level of Education
                ' ========================================================================================
                'error locating string
                Dim RegionName = context.GetDimension(1).Buckets.Item(CShort(R))
