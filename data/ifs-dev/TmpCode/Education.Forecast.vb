                    EdPriPopPer(4, R%%, gndr%) = AdultCompletionRate
                End If
    
                ''try .5/AdultCompletionRate
                't_mult = 0.0005 ' CSng(0.5 / AdultCompletionRate) ' 0.05  ' 0.005 '0.0005 'try higher numbers for more steep tapering (the problem with that is younger cohorts also taper heavily) 
