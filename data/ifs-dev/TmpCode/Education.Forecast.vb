    Call GradeWiseEnrollmentInit(R%%, gndr, edpristart(R%%), edprilen(R%%), EDPRIINTN(R%%, gndr), PristudentsNet, pridropoutnet, drpoutgr, edpritotNet)
            ' ---- Begin Inlined Level 3: IFsEducPri1FirstYear:ProcessPriNet:GradeWiseEnrollmentInit
    ' Private Sub GradeWiseEnrollmentInit(R%%, gndr%, startcycle As Single, lencycle As Single, Intake As Single, ByRef GradeStudents(,,) As Single, AvgDropOutRate As Single, ByRef GradeDropOutRate() As Single, ByRef TotStudents As Single)
                        '-----Education Module ----------------------------------------------------------------------------------------------
                        'mti Education secondary lower and upper October 2007 - new proc
            
                        'Initialize total (gross) enrolment in Primary (could not do in pre-processor for the lack of population age-chorts)
                        edpritotNet = 0
            
            
                        PristudentsNet(1, R%%%, gndr%) = EDPRIINTN(R%%, gndr)
                        edpritotNet = edpritotNet + CSng(fagedst(CInt(edpristart(R%%)), R%%%, gndr%) * PristudentsNet(1, R%%%, gndr%) / 100)
            
                        If pridropoutnet = 9999 Then 'dropout by grades
                            For GCount% = 2 To CInt(edprilen(R%%))
                                'grade wise enrolment rate (gross)
                                'Pristudents(GCount%, R%%%, gndr%) = EDPRIINT(R%%%, gndr%) * (1 - dropoutrate) ^ (GCount% - 1)
                                PristudentsNet(GCount%, R%%%, gndr%) = PristudentsNet(GCount% - 1, R%%%, gndr%) * (1 - drpoutgr(GCount% - 1)) '^ (GCount% - 1)
                                PristudentsNet(GCount%, R%%%, gndr%) = AMAX(0.5, PristudentsNet(GCount%, R%%%, gndr%))
                                'Add to total enrolment
                                edpritotNet = edpritotNet + CSng(fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%%, gndr%) *
                                                        PristudentsNet(GCount%, R%%%, gndr%) / 100)
                            Next GCount%
                        Else  'one average dropout
                            For GCount% = 2 To CInt(edprilen(R%%))
                                'grade wise enrolment rate (gross)
                                PristudentsNet(GCount%, R%%%, gndr%) = PristudentsNet(GCount% - 1, R%%%, gndr%) * (1 - pridropoutnet) '^ (GCount% - 1)
                                PristudentsNet(GCount%, R%%%, gndr%) = AMAX(0.5, PristudentsNet(GCount%, R%%%, gndr%))
                                'Add to total enrolment
                                edpritotNet = edpritotNet + CSng(fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%%, gndr%) *
                                                        PristudentsNet(GCount%, R%%%, gndr%) / 100)
                            Next GCount%
                        End If
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri1FirstYear:ProcessPriNet:GradeWiseEnrollmentInit
    
                'First Year Primary Net Model: calculate net enrolment rate from grade-flow of students and school-age population
                edprienrnshift(R%, gndr) = EDPRIENRN(R%%, gndr) - (100 * edpritotNet / pripopgndr) 'caledprienrn
    
    
' End Sub
    ' ---- End Inlined Level 2: IFsEducPri1FirstYear:ProcessPriNet

                    'mti 2017/04/04 start

                    'empty the arrays
                    For AgeCount% = 1 To 10  'AgeCount% = 1 is the entrance age of primary

                        'student headcount by age
                        pristudentsbyage(AgeCount%, R%, gndr%) = 0

                        'completer headcount by age
                        prigradsbyage(AgeCount%, R%, gndr%) = 0

                        'headcount of those with incomplete primary or no schooling at all by age
                        outofschoolbyage(AgeCount%, R%, gndr%) = 0
                    Next

                    'this delta is used to push enrollment/completion etc (by grade) further down as the end of the primary cycle is reached

                    If CInt(edprilen(R%) - 1) > -1 Then
                        DeltaEnr = AMAX(0, pristudents(CInt(edprilen(R%) - 1), R%, gndr%) - pristudents(CInt(edprilen(R%)), R%, gndr%)) 'enrollment rate difference for last grade and the grade prior-to-the-last
                    End If


                    'Net and gross ratio (of final grade) used to estimate the share of (gross) completers who are of age
                    Sharenet = Amin(1, EDPRIENRN(R%, gndr%) / EDPRIENRG(R%, gndr%))

                    'Algorithm for filling in the the array of primary students by age
                    For GrCount% = 1 To CInt(edprilen(R%)) 'here GrCount denotes grade

                        If PristudentsNet(GrCount%, R%, gndr%) > pristudents(GrCount%, R%, gndr%) Then
                            'this could happen in special situations with lots of first catchup (e.g., Rwanda) and thus net spread by single grade is not right for the upper grades

                            'total students (of age plus overage) in this grade obtained by spreading gross enrollment
                            StudentsfromGrsSpread = CSng(fagedst(CInt(edpristart(R%)) + GrCount% - 1, R%, gndr) * pristudents(GrCount%, R%, gndr%) / 100)

                            'Age appropriate students in this grade obtained by spreading net enrollment
                            StudentsfromNetSpread = StudentsfromGrsSpread * Sharenet

                        Else
                            'total students (of age plus overage) in this grade obtained by spreading gross enrollment
                            StudentsfromGrsSpread = CSng(fagedst(CInt(edpristart(R%) + GrCount% - 1), R%, gndr) * pristudents(GrCount%, R%, gndr%) / 100)

                            'Age appropriate students in this grade obtained by spreading net enrollment
                            StudentsfromNetSpread = CSng(fagedst(CInt(edpristart(R%) + GrCount% - 1), R%, gndr) * PristudentsNet(GrCount%, R%, gndr%) / 100)
                        End If

                        'Age appropriate students obtained by spreading net enrollment;
                        'for pristudentsbyage array, GrCount is actually a counter for age, 1 = starting age of primary
                        'make sure student headcount do not go over population for the cohort;
                        pristudentsbyage(GrCount%, R%, gndr%) = CSng(Amin(fagedst(CInt(edpristart(R%) + GrCount% - 1), R%, gndr), pristudentsbyage(GrCount%, R%, gndr%) + StudentsfromNetSpread))


                        'We'll now normalize the overage portion of students into single year cohorts from just above the grade level to upto 10 year above the primary entrance age
                        'The base of normalization
                        TotOverageEnRateTot = 0
                        For UGrCount% = GrCount% + 1 To CInt(edprilen(R%))
                            'First add the grade spread for all grades from current grade to the last grade

                            If pristudentsbyage(UGrCount%, R%, gndr%) < fagedst(CInt(edpristart(R%) + UGrCount% - 1), R%, gndr) Then 'make sure this agrgroup is not already full
                                'TotOverageEnRateTot = TotOverageEnRateTot + PristudentsNet(UGrCount%, R%, gndr%)
                                TotOverageEnRateTot = TotOverageEnRateTot + pristudents(UGrCount%, R%, gndr%)
                            End If

                        Next

                        'mti 05/04/2017 06:15 - use net here?
                        For UGrCount% = CInt(edprilen(R%) + 1) To 10
                            'now add those above primary age (=last grade enrollment - completion rate - one DeltaEnr for each year)
                            'TotOverageEnRateTot = TotOverageEnRateTot + AMAX(0, (PristudentsNet(edprilen(R%), R%, gndr%) - (Sharenet * EDPRICR(R%, gndr%)) - DeltaEnr * (UGrCount% - (edprilen(R%) + 1))))
                            TotOverageEnRateTot = TotOverageEnRateTot + AMAX(0, (pristudents(CInt(edprilen(R%)), R%, gndr%) - (Sharenet * EDPRICR(R%, gndr%)) - DeltaEnr * (UGrCount% - (edprilen(R%) + 1))))
                        Next

                        'Normalized values computed below

                        'Total overage in the grade
                        OverageStudentsIntheGrade = StudentsfromGrsSpread - StudentsfromNetSpread
                        If GrCount% = 1 Then
                            OverageInGr1Count(R%, gndr%) = OverageStudentsIntheGrade
                        End If

                        'Spread these overage to single year cohorts using normalization
                        For UGrCount% = GrCount% + 1 To CInt(edprilen(R%))
                            If pristudentsbyage(UGrCount%, R%, gndr%) < fagedst(CInt(edpristart(R%)) + UGrCount% - 1, R%, gndr) Then 'make sure this agrgroup is not already full

                                If TotOverageEnRateTot = 0 Then
                                    AddOverAge = 0
                                Else
                                    'AddOverAge = OverageStudentsIntheGrade * PristudentsNet(UGrCount%, R%, gndr%) / TotOverageEnRateTot
                                    AddOverAge = OverageStudentsIntheGrade * pristudents(UGrCount%, R%, gndr%) / TotOverageEnRateTot
                                End If

                                pristudentsbyage(UGrCount%, R%, gndr%) = pristudentsbyage(UGrCount%, R%, gndr%) + AddOverAge
                            End If
                        Next
                        'Spread these overage to single year cohorts using normalization - continued for those above primary age
                        For UGrCount% = CInt(edprilen(R%) + 1) To 10
                            If TotOverageEnRateTot = 0 Then
                                AddOverAge = 0
                            Else
                                'AgeEnRate = AMAX(0, PristudentsNet(edprilen(R%), R%, gndr%) - (Sharenet * EDPRICR(R%, gndr%) - DeltaEnr * (UGrCount% - (edprilen(R%) + 1))))
                                AgeEnRate = AMAX(0, pristudents(CInt(edprilen(R%)), R%, gndr%) - (Sharenet * EDPRICR(R%, gndr%) - DeltaEnr * (UGrCount% - (edprilen(R%) + 1))))
                                AddOverAge = OverageStudentsIntheGrade * AgeEnRate / TotOverageEnRateTot
                            End If
                            pristudentsbyage(UGrCount%, R%, gndr%) = pristudentsbyage(UGrCount%, R%, gndr%) + AddOverAge
                        Next


                    Next

                    'Those who completed primary

                    'Ratio needed to figure out compraratively younger of the graduates (those who are abover graduation age but under start age plus 10)
                    TotInSchoolYounger = 0
                    TotInSchoolOlder = 0
                    'TotPopYounger = 0
                    For AgeCount% = 2 To 10
                        If AgeCount% <= 10 - (edprilen(R%) + 1) Then
                            TotInSchoolYounger = TotInSchoolYounger + pristudentsbyage(AgeCount%, R%, gndr%)
                        Else
                            TotInSchoolOlder = TotInSchoolOlder + pristudentsbyage(AgeCount%, R%, gndr%)
                        End If
                    Next
                    TotInSchoolYoungerPortion = TotInSchoolYounger / (TotInSchoolYounger + TotInSchoolOlder)

                    'Complation rate is gross; estimate a net portion

                    'prigradsbyage(edprilen(R%) + 1, R%, gndr%) = EDPRICR(R%, gndr%) * Sharenet * fagedst(edpristart(R%) + edprilen(R%), R%, gndr) / 100

                    'PriGradRateNet = PristudentsNet(1, R%, gndr%) * EDPRISUR(R%, gndr%) / 100 - Deltaenr
                    PriGradRateNet = PristudentsNet(CInt(edprilen(R%)), R%, gndr%) - DeltaEnr
                    prigradsbyage(CInt(edprilen(R%) + 1), R%, gndr%) = CSng((PriGradRateNet) * fagedst(CInt(edpristart(R%) + edprilen(R%)), R%, gndr) / 100)


                    'the remaining (gross - net) equally among the upper age brackets
                    If edprilen(R%) + 2 <= 10 Then

                        'ShareGrossPerYearPerCohort = EDPRICR(R%, gndr%) * (1 - Sharenet) / (10 - (edprilen(R%) + 2)) / 100
                        'graduates need also be spread across 10 years
                        'spread done evenly for now: should actually take a higher portion as graduation rtae will be higher in more recent years)
                        'ShareGrossPerYearPerCohort = EDPRICR(R%, gndr%) * (1 - Sharenet) * TotInSchoolYoungerPortion / (10 - (edprilen(R%) + 2)) / 100
                        ShareGrossPerYearPerCohort = EDPRICR(R%, gndr%) * (1 - Sharenet) / 100 / 10

                        '* fagedst(edpristart(R%) + Agecount% - 1, R%, gndr)
                        For AgeCount% = CInt(edprilen(R%) + 2) To 10
                            'distribute the remaining (gross - net) equally among the upper age brackets

                            'NetPortion = AMAX(0, (EDPRICR(R%, gndr%) * Sharenet - DeltaEnr * (AgeCount% - (edprilen(R%) + 1)))) * fagedst(edpristart(R%) + AgeCount% - 1, R%, gndr) / 100
                            NetPortion = CSng(AMAX(0, ((PriGradRateNet) - DeltaEnr * (AgeCount% - (edprilen(R%) + 1)))) * fagedst(CInt(edpristart(R%) + AgeCount%), R%, gndr) / 100)

                            'GrossPortion = (AgeCount% - (edprilen(R%) + 1)) * ShareGrossPerYearPerCohort * fagedst(edpristart(R%) + AgeCount% - 1, R%, gndr)
                            GrossPortion = CSng(ShareGrossPerYearPerCohort * fagedst(CInt(edpristart(R%) + AgeCount%), R%, gndr))
                            prigradsbyage(AgeCount%, R%, gndr%) = NetPortion + GrossPortion
                        Next

                    End If


                    'Compute out of school
                    For AgeCount% = 1 To 10

                        If fagedst(CInt(edpristart(R%) + AgeCount% - 1), R%, gndr) < pristudentsbyage(AgeCount%, R%, gndr%) + prigradsbyage(AgeCount%, R%, gndr%) Then
                            'make sure students and graduates combined do not go over population for the cohort; adjust the number of grdauates when it does
                            pristudentsbyage(AgeCount%, R%, gndr%) = CSng(fagedst(CInt(edpristart(R%) + AgeCount% - 1), R%, gndr) - prigradsbyage(AgeCount%, R%, gndr%))
                        End If

                        'out of school kids are a year or more older than the entrance age children
                        If AgeCount% = 1 Then
                            'For first year (starting age plus 1), add dropots
                            outofschoolbyage(AgeCount%, R%, gndr%) = CSng(fagedst(CInt(edpristart(R%) + AgeCount% - 1), R%, gndr) - (pristudentsbyage(AgeCount%, R%, gndr%) - (PristudentsNet(1, R%, gndr%) - PristudentsNet(2, R%, gndr%)) * fagedst(CInt(edpristart(R%)), R%, gndr) / 100))
                        Else
                            outofschoolbyage(AgeCount%, R%, gndr%) = CSng(fagedst(CInt(edpristart(R%) + AgeCount% - 1), R%, gndr) - pristudentsbyage(AgeCount%, R%, gndr%) - prigradsbyage(AgeCount%, R%, gndr%))
                        End If
                    Next




                    'If GRPS(1,R%) = "Afghanistan" Then Stop
                    'If GRPS(1,R%) = "Bangladesh" Then Stop

                    OverageInGr1Pcnt(R%, gndr%) = CSng(100 * OverageInGr1Count(R%, gndr%) / fagedst(CInt(edpristart(R%)), R%, gndr)) 'this can also be gross - net in 1st grade
                    outofschoolTot = 0
                    For AgeCount% = 1 To 10  'Agcount%=1 is the entrance age, and thus not part of overage; later-> use first three years only
                        outofschoolTot = outofschoolTot + outofschoolbyage(AgeCount%, R%, gndr%)
                    Next

                    outofschoolTot = outofschoolTot + OverageInGr1Count(R%, gndr%) 'Overage 1st graders were also in pool

                    RetGr1Pcnt(R%, gndr%) = CSng(Amin(0.99, OverageInGr1Count(R%, gndr%) / outofschoolTot)) 'if greater than 1

                    'Save age cohorts for next year
                    For Agecnt% = 1 To NAges
                        sfagedst(Agecnt, R%, gndr%) = fagedst(Agecnt, R%, gndr%)
                    Next


                    '   First Year Primary: Distribute (15+) Adult Population with Primary Education Across 5 year Cohorts
                    '=====================================================================================================
                    'mti 2024/05/23 start
                    ''mti 2024/01/09 start
                    ''Call SpreadAdultPri(R%, gndr, AdultPop(R%, gndr), AdultPop15to24(R%, gndr), EdPriPopPer, sEdPriPopPer, EPPShft(R%, gndr), EPPShft15to24(R%, gndr))
                    'Call SpreadAdultPri(R%, gndr, AdultPop(R%, gndr), AdultPop15to24(R%, gndr), EdPriPopPer, PEPPRI(R%, gndr), EPPShft(R%, gndr), EPPShft15to24(R%, gndr))
                    ''mti 2024/01/09 end

Call SpreadAdultPriData(R%, gndr, AdultPop(R%, gndr), AdultPop15to24(R%, gndr), EdPriPopPer, PEPPRI(R%, gndr), EPPShft(R%, gndr), EPPShft15to24(R%, gndr), EdAttnPrimaryData)
    ' ---- Begin Inlined Level 2: IFsEducPri1FirstYear:SpreadAdultPriData
' Private Sub SpreadAdultPriData(R%, gndr%, AdultPop As Single, AdultPop15to24 As Single,
