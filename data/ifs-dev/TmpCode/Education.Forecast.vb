                    'sSurvImpact(R%, gndr, Tertiary) = 0.8 * sSurvImpact(R%, gndr, Tertiary) + 0.2 * EDTERGRATE(R%, gndr) / iEdSurv(R%,gndr, Tertiary)
                    'sSurvImpact(R%, gndr, Tertiary) = 0.8 * sSurvImpact(R%, gndr, Tertiary) + 0.2 * sSurvImpact(R%, gndr, Tertiary) * EDTERGRATE(R%, gndr) / iEdSurv(R%,gndr, Tertiary)
                    sSurvImpact(R%, gndr, Tertiary) = CSng(0.8 * sSurvImpact(R%, gndr, Tertiary) + 0.2 * sSurvImpact(R%, gndr, Tertiary) * fEdSurv(R%, gndr, Tertiary) / iEdSurv(R%, gndr, Tertiary))
