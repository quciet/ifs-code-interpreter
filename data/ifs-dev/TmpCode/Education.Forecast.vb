                '        Comp_AdultCompletionRate = CompAdultEdPriCompletionPop / totalAdultpop
                '    Else
                '        Comp_AdultCompletionRate = 0 ' Avoid division by zero
                '    End If
    
    
                '    ' Check for convergence
                '    If Abs(AdultCompletionRate - Comp_AdultCompletionRate) < MaxDeviation Then
                '        Exit For
