                        If gndr% = 1 Then
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Male (1970)",
                                EDSECENRG(R%%, gndr%), CalEDSECENRN, context)
                        Else
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Female (1970)",
                                EDSECENRG(R%%, gndr%), CalEDSECENRN, context)
    
                        End If
                    Else
                        If gndr% = 1 Then
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Male (2000)",
                                EDSECENRG(R%%, gndr%), CalEDSECENRN, context)
                        Else
                            Call XYTABL("Secondary Gross Enrollment Versus Secondary Net Enrollment Female (2000)",
                                EDSECENRG(R%%, gndr%), CalEDSECENRN, context)
    
                        End If
                    End If
                    Dim shiftadded = ConvergeOverTime1(EdSecEnrNShift(R%, gndr), 0, 25) '150
                    EDSECENRN(R%%, gndr%) = AMAX(0.0000001, Amin(EDSECENRG(R%%, gndr%), Amin(100, CalEDSECENRN + shiftadded)))
    
                Else
                    '                If GRPS(1,R%%) = "Australia" Then Stop
    
    
                    EdSecEnrNShift(R%, gndr) = -9999 'so that it doesn't switch branch later
    
                    'mti 2017/01/24 start - no survival now; commented this - check later (should not change much - other branch is 0.05 to 1
                    '                If 100 > 100 Then
                    '                    EdSUSurProg = Amin(0.1, AMAX(0.05, (100 - 100) / (100 - 100)))
                    '                Else
    
                    Dim EdSUSurProg = 0.05!
                    '                End If
                    'mti 2017/01/24 end
                    'EdSUSurProg = IIf(100 > 100, Amin(0.1, AMAX(0.05, (100 - 100) / (100 - 100))), 0.05)
                    EDSECENRN(R%%, gndr%) = AMAX(0.0000001, Amin(EDSECENRG(R%%, gndr%), Amin(100, sEdSecEnrN(R%, gndr) + (100 - sEdSecEnrN(R%, gndr)) * EdSUSurProg)))
                End If
                '  If GRPS(1,R%%) = "Argentina" Then Stop
    
                '            If sEDSECENRN(R%%, Total) > 90 And IY% > 2 Then
                '
                '              c_EDSECENRN = ConvergeOverTimeRate1(sEdSecEnrN(R%, gndr), 100, 20)  '15
