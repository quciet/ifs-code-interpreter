    ' ---- Begin Inlined Level 2: IFsEducPri_new_init:ifsEducPri2_new_init
' Private Sub ifsEducPri2_new_init()
                '  All Years but First: Primary Final After Budget:  Compute Exttrastudentsratio Or Budget Impact on Intake and Survival
                '============================================================================================================
                Dim SurvTrgtCovd As Single
    
                sErrorSub = "IFsEducPri All years but First After Budget: Primary: "
    
    
                For R% = 1 To NR%
    
    
    
                    '    If GRPS(1, R%) = "Liberia" And IY > 7 Then Stop
                    sErrorSub = sErrorSub + GRPS(1, R%)
                    'budgeting off - skip budget impact
                    If edbudgon(R%) = 0 Then
                        GoTo AfterPriBudgetImpact 'budget neutral
                    End If
    
    
                    'If GRPS(1, R) = "Afghanistan" And IY >= 22 Then Stop
    
                    'All Years but First: Primary Final: Calculate Budget Imppact
    BudgetImpactParam = R% + spendcostRI(R%) + EDEXPERPRI + EDEXPERSECLOWR + EDEXPERSECUPPR + EDEXPERTER + EDPRITOT + EDSECLOWRTOT + EDSECUPPRTOT + EDTERTOT + GDPPC + GDS + GDSED @@BudgetImpactParam = CalcBudgetImpact("Primary", R%, spendcostRI(R%))@@
                    EXTRASTDRATIO(R%, Primary) = BudgetImpactParam
    
                    'All Years but First: Primary Final: Apply Budget Impact on Intake Rates (net and gross)
                    For gndr = 1 To NGender - 1
    
                        'new budget impact
    Dim intakefactorNet = BudgetImpactParam + EDPRIINTN(R%, gndr) + sedpriintn(R%, gndr) + edprilen(R%) @@Dim intakefactorNet = FlowFactor(BudgetImpactParam, EDPRIINTN(R%, gndr), 100, sedpriintn(R%, gndr), edprilen(R%), "Intk")@@
    
                        Dim addintakefactorNet = 100 * (BudgetImpactParam - 1) * intakefactorNet
    
    
                        If sCostPerDelta(R%, Primary) > 1 Then
                            'generates transient, e.g., Albania: 2029-2030
                            addintakefactorNet = AMAX(0, addintakefactorNet)  'cost is growing, do not let intake fall
                        End If
    
                        'If GRPS(1, R) = "Afghanistan" And gndr = 1 And IY >= 22 Then Stop
    
                        'mti 2022/03/08 start
                        'mti 2022/03/16 start
                        If edpriintnm(R%, gndr) <> 1 Or edpriintnm(R%, NGender) <> 1 Or gdsm(R%, Educ) <> 1 Then
                            'If edpriintnm(R%, gndr) <> 1 Or edpriintnm(R%, NGender) <> 1 Then
                            'mti 2022/03/16 End
                            'mti 2022/03/08 End
                            fEdIntk(R%, gndr, Primary) = CSng(Amin(100, AMAX(1, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100)))))
                        Else
                            fEdIntk(R%, gndr, Primary) = CSng(Amin(sEdPriIntN_pre_qtql(R%, gndr) + MxIntUp, AMAX(sEdPriIntN_pre_qtql(R%, gndr) - MxIntDown, EDPRIINTN(R%, gndr) * (1 + (AMAX(BudgetImpactParam, 0.98) - 1) * ((100 - EDPRIINTN(R%, gndr)) / 100)))))
                        End If
    
                        'bound the change to conform with definition
                        EDPRIINTN(R%, gndr) = AMAX(0.0001, Amin(100, fEdIntk(R%, gndr, Primary)))
    
                        sEdPriIntN_pre_qtql(R%, gndr) = EDPRIINTN(R%, gndr)
    
                        If i1EdPriSur(R%, gndr%) < 90 Then '  i1EdPriIntN(R%, gndr%) < 100 Then
                            EDPRIINTNEXT(R%, gndr%) = EDPRIINTN(R%, gndr%) * ConvergeOverPath(EdPriIntnRat(R%, gndr%), 1, EDPRISUR(R%, gndr%), i1EdPriSur(R%, gndr%), 90)
                            'EDPRIINTNEXT(R%, gndr%) = EDPRIINTN(R%, gndr%) * ConvergeOverPath(EdPriIntnRat(R%, gndr%), 1, EDPRIINTN(R%, gndr%), i1EdPriIntN(R%, gndr%), 100)   ' ConvergeOverTime(EdPriIntnRat(R%, gndr%), 1, 20)
                        Else
                            EDPRIINTNEXT(R%, gndr%) = EDPRIINTN(R%, gndr%) * ConvergeOverTime1(EdPriIntnRat(R%, gndr%), 1, 10)
                        End If
    
                        'Impact on gross intake  'what if net intake hit the bound of 100, abruptly?
    
                        EDPRIINT(R%, gndr) = AMAX(0.0001, Amin(270, EDPRIINTNEXT(R%, gndr) + OverageInGr1Pcnt(R%, gndr%) * EDPRIINTN(R%, gndr) / iEdIntk(R%, gndr, Primary))) '170
    
                        'Print #99, "New"; ","; IY; ","; Replace(GRPS(1, R%), ",", " "); ","; gndr%; ","; _
                        'EDPRIINT(R%, gndr); ","; EDPRIINTN(R%, gndr); ","; OverageInGr1Pcnt(R%, gndr%); ","; _
                        'OverageInGr1Pcnt(R%, gndr%) * EDPRIINTN(R%, gndr) / iEdIntk(R%, gndr, Primary); ","; _
                        'iEdIntk(R%, gndr, Primary); ",";
    
    
    
                        'mti check October 2008 - Quality quantity trade off - base value 1- not used any more - take out
    
