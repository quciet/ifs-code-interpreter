' Private Sub AfterSecBudgetImpact(R%, context As IForecastContext)
            'All Years but First: Upper and Lower Secondary Final: Enrollments and graduates
            '---------------------------------------------------------------------------------

            'jump to here when budget is not a constraint
            'AfterSecBudgetImpact:
            Dim caledsecint = 0!
            Dim Dropoutrate = 0!
            EDSECTOT(R%, Total) = 0
            '          EDSECGRADS(R%, Total) = 0

            EDSECLOWRTOT(R%, Total) = 0
            EDSECLOWRGRADS(R%, Total) = 0

            EDSECUPPRTOT(R%, Total) = 0
            EDSECUPPRGRADS(R%, Total) = 0

            'All Years but First: Lower Secondary Final: Enrollment and graduation
            '----------------------------------------------------------------------------------------------------------------
            For gndr = 1 To NGender - 1

                'new budget code- moving average
                'sIntakeImpact(R%, gndr, SecLowr) = 0.8 * sIntakeImpact(R%, gndr, SecLowr) + 0.2 * EDSECLOWRTRAN(R%, gndr) / iEdIntk(R%,gndr, SecLowr)
                'sIntakeImpact(R%, gndr, SecLowr) = 0.8 * sIntakeImpact(R%, gndr, SecLowr) + 0.2 * sIntakeImpact(R%, gndr, SecLowr) * EDSECLOWRTRAN(R%, gndr) / iEdIntk(R%,gndr, SecLowr)
                'mti 2022/03/16 start
                'sIntakeImpact(R%, gndr, SecLowr) = 0.8 * sIntakeImpact(R%, gndr, SecLowr) + 0.2 * sIntakeImpact(R%, gndr, SecLowr) * fEdIntk(R%, gndr, SecLowr) / iEdIntk(R%, gndr, SecLowr)
                sIntakeImpact(R%, gndr, SecLowr) = CSng(0.8 * sIntakeImpact(R%, gndr, SecLowr) + 0.2 * fEdIntk(R%, gndr, SecLowr) / iEdIntk(R%, gndr, SecLowr))
                'mti 2022/03/16 end
                '                sIntakeImpact(R%, gndr, SecLowr) = 0.95 * sIntakeImpact(R%, gndr, SecLowr) + 0.05 * EDSECLOWRTRAN(R%, gndr) / iEdIntk(R%,gndr, SecLowr)
                '        If Mid(RegName(R%), 1, 7) = "Central" And gndr = 1 Then Debug.Print BudgetSecLowrImpactParam; ","; sintkfactor; ","; EDSECLOWRTRAN(R%, gndr)

                'new budget code- moving average
                'sSurvImpact(R%, gndr, SecLowr) = 0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * EDSECLOWRSUR(R%, gndr) / iEdSurv(R%,gndr, SecLowr)
                'sSurvImpact(R%, gndr, SecLowr) = 0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * sSurvImpact(R%, gndr, SecLowr) * EDSECLOWRSUR(R%, gndr) / iEdSurv(R%,gndr, SecLowr)
                'mti 2022/03/16 start
                'sSurvImpact(R%, gndr, SecLowr) = 0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * sSurvImpact(R%, gndr, SecLowr) * fEdSurv(R%, gndr, SecLowr) / iEdSurv(R%, gndr, SecLowr)
                sSurvImpact(R%, gndr, SecLowr) = CSng(0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * fEdSurv(R%, gndr, SecLowr) / iEdSurv(R%, gndr, SecLowr))
                'mti 2022/03/16 end

                '        If Mid(GRPS(1,R%), 1, 7) = "Central" And gndr = 1 Then Debug.Print BudgetSecLowrImpactParam; ","; ssurvfactor; ","; EDSECLOWRSUR(R%, gndr)

                'new budget code- moving average
                'sIntakeImpact(R%, gndr, SecUppr) = 0.8 * sIntakeImpact(R%, gndr, SecUppr) + 0.2 * EDSECUPPRTRAN(R%, gndr) / iEdIntk(R%,gndr, SecUppr)
                'sIntakeImpact(R%, gndr, SecUppr) = 0.8 * sIntakeImpact(R%, gndr, SecUppr) + 0.2 * sIntakeImpact(R%, gndr, SecUppr) * EDSECUPPRTRAN(R%, gndr) / iEdIntk(R%,gndr, SecUppr)
                sIntakeImpact(R%, gndr, SecUppr) = CSng(0.8 * sIntakeImpact(R%, gndr, SecUppr) + 0.2 * sIntakeImpact(R%, gndr, SecUppr) * fEdIntk(R%, gndr, SecUppr) / iEdIntk(R%, gndr, SecUppr))
                '                sIntakeImpact(R%, gndr, SecUppr) = 0.95 * sIntakeImpact(R%, gndr, SecUppr) + 0.05 * EDSECUPPRTRAN(R%, gndr) / iEdIntk(R%,gndr, SecUppr)

                'new budget code- moving average
                'sSurvImpact(R%, gndr, SecUppr) = 0.8 * sSurvImpact(R%, gndr, SecUppr) + 0.2 * EDSECUPPRSUR(R%, gndr) / iEdSurv(R%,gndr, SecUppr)
                'sSurvImpact(R%, gndr, SecUppr) = 0.8 * sSurvImpact(R%, gndr, SecUppr) + 0.2 * sSurvImpact(R%, gndr, SecUppr) * EDSECUPPRSUR(R%, gndr) / iEdSurv(R%,gndr, SecUppr)
                sSurvImpact(R%, gndr, SecUppr) = CSng(0.8 * sSurvImpact(R%, gndr, SecUppr) + 0.2 * sSurvImpact(R%, gndr, SecUppr) * fEdSurv(R%, gndr, SecUppr) / iEdSurv(R%, gndr, SecUppr))

                '    If GRPS(1,R%) = "Botswana" Then Stop

                '            'new base or code
                '            EDSECLOWRTRAN(R%, gndr) = IIf(edseclowrtrangr(R%, gndr) <> 0, AMAX(gEdSecLowrTran(R%, gndr), EDSECLOWRTRAN(R%, gndr)), EDSECLOWRTRAN(R%, gndr))
                '            EDSECLOWRSUR(R%, gndr) = IIf(edseclowrsurvgr(R%, gndr) <> 0, AMAX(gEdSecLowrSur(R%, gndr), EDSECLOWRSUR(R%, gndr)), EDSECLOWRSUR(R%, gndr))
                '
                '            'new base or code
                '            EDSECUPPRTRAN(R%, gndr) = IIf(edsecupprtrangr(R%, gndr) <> 0, AMAX(gEdSecUpprTran(R%, gndr), EDSECUPPRTRAN(R%, gndr)), EDSECUPPRTRAN(R%, gndr))
                '            EDSECUPPRSUR(R%, gndr) = IIf(edsecupprsurvgr(R%, gndr) <> 0, AMAX(gEdSecUpprSur(R%, gndr), EDSECUPPRSUR(R%, gndr)), EDSECUPPRSUR(R%, gndr))


                'All Years but First: Lower Secondary Final: Intake Rate from last year's primary last grade x transition rate this year
                'caledsecint = pristudents(edprilen(R%), R%, gndr) * EDSECLOWRTRAN(R%, gndr) / 100
                '    If GRPS(1,R%) = "Malawi" And IY >= 5 And gndr = 1 Then Stop
                'mti dec 15 08 - commented this
                'caledsecint = FinalGrade(Primary, gndr) * EDSECLOWRTRAN(R%, gndr) / 100
                caledsecint = SaveStudentCohorts(R%, CInt(edprilen(R%)), gndr, Primary) * EDSECLOWRTRAN(R%, gndr) / 100

                'mti dec 15 08 - commented this; using  saved value
                'save secondary lower last grade enrollment from last year - to use with transition rate
                '        FinalGrade(SecLowr, gndr) = SaveSecLowUpStudentCohorts(edseclowrlen(R%), gndr, 1)

                '   If GRPS(1,R%) = "Ethiopia" Then Stop
                'All Years but First: Lower Secondary Final: grade-specific enrollment rates, total students - general curriculum only
                'Call GradeWiseEnrollmentCalc(R%, gndr, secStart(R%), edseclowrlen(R%), caledsecint, EDSECLOWRSUR(R%, gndr), _
                'seclowrstudents(), SaveSecLowUpStudentCohorts(), 1, EdSecTot_Gen)
                'mti 2022/03/16 Start
                'Dropoutrate = AMAX(0, 1 - (EDSECLOWRGRATE(R%, gndr) / caledsecint) ^ (1 / edseclowrlen(R%)))
                Dropoutrate = CSng(AMAX(0, 1 - (EDSECLOWRGRATE(R%, gndr) / SaveSecLowUpStudentCohorts(R%, 1, gndr, 1)) ^ (1 / edseclowrlen(R%))))
                'mti 2022/03/16 End SaveSecLowUpStudentCohorts(R%, 1, gndr, 1)
                'mti 2022/03/16 start
                'Call GradeWiseEnrollmentCalc(R%, gndr, secStart(R%), edseclowrlen(R%), caledsecint, 0, _
                'seclowrstudents(), SaveSecLowUpStudentCohorts(), 1, EDSECLOWRTOT(R%, gndr), Dropoutrate)

Call GradeWiseEnrollmentCalc(R%, gndr, secStart(R%), edseclowrlen(R%), caledsecint, 0, seclowrstudents, SaveSecLowUpStudentCohorts, 1, EDSECLOWRTOT(R%, gndr), Dropoutrate, , "SecLowr")
    ' ---- Begin Inlined Level 2: AfterSecBudgetImpact:GradeWiseEnrollmentCalc
' Private Sub GradeWiseEnrollmentCalc(R%, gndr%, startcycle As Single, lencycle As Single, Intake As Single, Survival As Single, ByRef GradeStudents As Single(,,),
' ByRef SaveGradeStudents As Single(,,,), SGS3rdIndex%, ByRef TotStudents As Single, Optional Dropoutrate As Single = 9999, Optional SaveGradeEnrRate As Boolean = False, Optional level As String = "All")
                'mti 2022/03/16 take proc
                'mti 2016/03/30 - take procedure
                'mti Education secondary lower and upper October 2007 - new proc
    
                Dim dropoutgr(10) As Single
                If Dropoutrate = 9999 Then
                    If edseclowrlen(R%) = 1 Then
                        Dropoutrate = 0
                    Else
                        Dropoutrate = CSng(AMAX(0, 1 - ((0 / 100) ^ (1 / (edseclowrlen(R%) - 1)))))
                    End If
                ElseIf Dropoutrate = 8888 Then 'spread dropout
    Call DropoutSpread(edseclowrlen(R%), 0, dropoutgr)
            ' ---- Begin Inlined Level 3: AfterSecBudgetImpact:GradeWiseEnrollmentCalc:DropoutSpread
    ' Private Sub DropoutSpread(edseclowrlen(R%) As Single, 0 As Single, ByRef Arr_Dropout() As Single)
                        '-----------------------------------------------------------------------------------
                        ' Education Module - Calculates a seperate dropout rate for each grade
                        ' Assumes dropout in the first grade is twice the average dropout rate; all other grades average out the rest of the dropout
                        Dim Dropoutrate, G2Enr As Single
                        Dropoutrate = CSng(AMAX(0, 1 - ((0 / 100) ^ (1 / (edseclowrlen(R%) - 1)))))
            
                        'mti April 05, 2012 -start
                        dropoutgr(1) = Dropoutrate
            
            
                        'mti 2017/01/24 start
                        If 0 < 100 Then  'was 90
                            'mti 2017/01/24 end
            
            
            
                            'If dropoutrate < 0.4 And GDPPCP(R%%) < 4 Then
                            dropoutgr(1) = CSng(Amin(0.5, Dropoutrate * 2))
            
            
            
                            G2Enr = 1 - dropoutgr(1)
                            Dropoutrate = CSng(AMAX(0, 1 - ((0 / G2Enr / 100) ^ (1 / (edseclowrlen(R%) - 2))))) 'dropout rate for gender
                            'End If
            
            
                            For GCount% = 2 To CInt(edseclowrlen(R%))
                                dropoutgr(GCount%) = Dropoutrate
                            Next GCount%
            
                        Else
                            For GCount% = 2 To CInt(edseclowrlen(R%))
                                dropoutgr(GCount%) = Dropoutrate
                            Next GCount%
                        End If
                        'mti April 05, 2012 -end
            
    ' End Sub
            ' ---- End Inlined Level 3: AfterSecBudgetImpact:GradeWiseEnrollmentCalc:DropoutSpread
                End If
    
    
                EDSECLOWRTOT(R%, gndr) = 0
                If SaveGradeEnrRate Then
                    SaveSecLowUpStudentCohorts(R%%, 1, gndr%, 1%) = seclowrstudents(1, R%%, gndr%)
                End If
    
    
                'gradewise enrolment rates and total enrolment
                For GCount% = CInt(edseclowrlen(R%)) To 2 Step -1
                    If SaveGradeEnrRate Then
                        'save last year's grade enrollment rates for later use
                        SaveSecLowUpStudentCohorts(R%%, GCount%, gndr%, 1%) = seclowrstudents(GCount%, R%%, gndr%)
    
                        'apply dropout to last year's grade enrollment rates - saved last year
                        If Dropoutrate = 8888 Then 'dropout by grade
                            seclowrstudents(GCount%, R%%, gndr%) = seclowrstudents(GCount% - 1, R%%, gndr%) * (1 - dropoutgr(GCount% - 1))
                        Else 'single average dropout rate
                            seclowrstudents(GCount%, R%%, gndr%) = seclowrstudents(GCount% - 1, R%%, gndr%) * (1 - Dropoutrate)
                        End If
                    Else
                        'apply dropout to last year's grade enrollment rates,
                        'saved in a separate array during initial calculation of grade enrollment rates this year
                        If Dropoutrate = 8888 Then 'dropout by grade
                            seclowrstudents(GCount%, R%%, gndr%) = SaveSecLowUpStudentCohorts(R%%, GCount% - 1, gndr%, 1%) * (1 - dropoutgr(GCount% - 1))
                        Else
                            seclowrstudents(GCount%, R%%, gndr%) = SaveSecLowUpStudentCohorts(R%%, GCount% - 1, gndr%, 1%) * (1 - Dropoutrate)
                        End If
                    End If
    
                    seclowrstudents(GCount%, R%%, gndr%) = AMAX(0.5, seclowrstudents(GCount%, R%%, gndr%))
                    'students carried forward to the subsequent grades - using gradewise array saved before budget intervention
    
    
                    'mti 2022/03/16 start   'added to bring in students in upper grades; when transition rate multipliers are greater than 1; capped at 2
                    Select Case "SecLowr"
                        Case "Pri"  'Lower sec
                            seclowrstudents(GCount%, R%%, gndr%) = seclowrstudents(GCount%, R%%, gndr%) * Amin(2, AMAX(1, If(edpriintnm(R%%, NGender) <> 1, edpriintnm(R%%, NGender), edpriintnm(R%%, gndr))))
                        Case "SecLowr"  'Lower sec
                            seclowrstudents(GCount%, R%%, gndr%) = seclowrstudents(GCount%, R%%, gndr%) * Amin(2, AMAX(1, If(edseclowrtranm(R%%, NGender) <> 1, edseclowrtranm(R%%, NGender), edseclowrtranm(R%%, gndr))))
                        Case "SecUppr"  'Upper sec
