                'sSurvImpact(R%, gndr, SecLowr) = 0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * sSurvImpact(R%, gndr, SecLowr) * EDSECLOWRSUR(R%, gndr) / iEdSurv(R%,gndr, SecLowr)
                'mti 2022/03/16 start
                'sSurvImpact(R%, gndr, SecLowr) = 0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * sSurvImpact(R%, gndr, SecLowr) * fEdSurv(R%, gndr, SecLowr) / iEdSurv(R%, gndr, SecLowr)
                sSurvImpact(R%, gndr, SecLowr) = CSng(0.8 * sSurvImpact(R%, gndr, SecLowr) + 0.2 * fEdSurv(R%, gndr, SecLowr) / iEdSurv(R%, gndr, SecLowr))
