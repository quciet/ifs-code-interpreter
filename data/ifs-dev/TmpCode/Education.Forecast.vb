                    '
                    '                        'SaveStudentCohorts(R%, GCount%, gndr, SecLowr) = seclowrstudents(GCount%, R%, gndr)
                    '                    Next
                    '                End If

                    'mti 2022/04/12 - End


                    'Unused Grade Variables set to 0
                    For GCount% = CInt(edseclowrlen(R%) + 1) To NPriGr
                        seclowrstudents(GCount%, R%, gndr%) = 0
                        EDSECLOWRENRGGRD(R%, GCount%, gndr%) = 0
                    Next

                    'Dropouts by grade
                    Dim Surv = 0
                    For GCount% = 1 To CInt(edseclowrlen(R%)) - 1
                        If EDSECLOWRDRPGRD(R%, GCount%, gndr%) >= 999 Then
                            EDSECLOWRDRPGRD(R%, GCount%, gndr%) = EdSecLowrDropoutByGrade(GCount%, R%, gndr%)
                        Else
                            EdSecLowrDropoutByGrade(GCount%, R%, gndr%) = EDSECLOWRDRPGRD(R%, GCount%, gndr%) 'initialized in pre-processor
                        End If
                        i1EdSecLowrDropoutByGrade(GCount%, R%, gndr%) = EDSECLOWRDRPGRD(R%, GCount%, gndr%)

                    Next

                    'EdSecLowrSur(NR, NGender), iEdSecLowrSur(NR, NGender) 
