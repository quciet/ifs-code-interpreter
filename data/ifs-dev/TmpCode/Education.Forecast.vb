                        '        Print #199, Replace(GRPS(1, R%), ",", " "); ","; IY; ","; gndr; ","; Round(pristudents(cint(edprilen(R%)), R%, gndr), 3); ","; Round(drpoutgr(edprilen(R%)), 3); ","; Round(ConvergeOverTime1(EDPRICRShift(R%, gndr), 0, 30), 3); ","; Round(CalEdPriCR, 3); ; ","; Round(EDPRICR(R%, gndr), 3); ","; Round(EDPRISUR(R%, gndr), 3); ","; Round(CumDrp, 3); ","; Round(EDPRIINT(R%, gndr), 3); ","; edprilen(R%); ","; Round(RptGr(1) * pristudents(1, R%, gndr%), 2); ","; Round(RptGr(2) * pristudents(2, R%, gndr%), 2); ","; Round(RptGr(3) * pristudents(3, R%, gndr%), 2); ","; Round(RptGr(4) * pristudents(4, R%, gndr%), 2); ","; Round(RptGr(5) * pristudents(5, R%, gndr%), 2); ","; _
                        '            Round(RptGr(6) * pristudents(6, R%, gndr%), 2); ","; Round(RptGr(edprilen(R%)) * pristudents(cint(edprilen(R%)), R%, gndr%), 2); ","; Round((1 - RptGr(edprilen(R%)) * pristudents(cint(edprilen(R%)), R%, gndr%) / EDPRIINT(R%, gndr%)), 2)
                        '    End If
                        '
                        'End If
                        '
                        'If IY = 36 And R% = 1 And gndr% = 1 Then Close #199
    
                        'not needed? if needed (for next yera?) must use final 5th grade - after the next step
                        EdPriDropoutByGrade(CInt(edprilen(R%)), R%, gndr%) = AMAX(0.005, (pristudents(CInt(edprilen(R%)), R%, gndr%) - EDPRICR(R%, gndr%)) / pristudents(CInt(edprilen(R%)), R%, gndr%))
                        'mti 07/24/2020 End
    
                        For GCount% = 1 To CInt(edprilen(R%)) '+ 1 To NPriGr
                            EDPRIENRGGRD(R%, GCount%, gndr%) = pristudents(GCount%, R%, gndr%)
                            EDPRIDRPGRD(R%, GCount%, gndr%) = EdPriDropoutByGrade(GCount%, R%, gndr%)
                        Next
    
                        'using edmodelsw to store cumulative dropout for male start mti 2021/05/04 start
                        '    If gndr = 1 Then
                        '        edmodelsw = 100
                        '        For GCount% = 1 To cint(edprilen(R%)) - 1
                        '            edmodelsw = 100 * (1 - EDPRIDRPGRD(R%, GCount%, gndr%))
                        '        Next
                        '    End If
                        'using edmodelsw to store cumulative dropout for male end
    
                        sEDPRICR(R%, gndr%) = EDPRICR(R%, gndr%)
                        'Number of completers/Graduates (gross)
                        EDPRIGRADS(R%, gndr) = CSng(fagedst(CInt(edpristart(R%) + edprilen(R%)), R%, gndr) * (EDPRICR(R%, gndr) / 100))
    
                        'All Years but First: Primary Final: Gross Enrolment Rate
                        Dim CalEdPriEnrG = Amin(250, (EDPRITOT(R%, gndr) / AMAX(0.0000001, pripop(R%, gndr))) * 100)    '150
                        'converge initial shift, if any, in 20 years - 'mti check October 2008
                        EDPRIENRG(R%, gndr) = CalEdPriEnrG + edPrienrgshiftCur(R%, gndr) '10
    
                        EDPRITOT(R%, gndr) = EDPRIENRG(R%, gndr) * pripop(R%, gndr) / 100
    
                        'All Years but First: Primary Final: Total Students and Total Graduates: Both genders combined
                        EDPRITOT(R%, Total) = EDPRITOT(R%, Total) + EDPRITOT(R%, gndr)
                        EDPRIGRADS(R%, Total) = EDPRIGRADS(R%, Total) + EDPRIGRADS(R%, gndr)
    
    
                        'All Years but First: Primary Final: Net Enrolment
                        '   -------------------------------------------------
                        'net equivalent of (gross) dropout
                        Dim dout = AMAX(0, 1 - ((EDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1))))
                        Dim sdout = AMAX(0, 1 - ((sEDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1))))
    
                        'mti check for very small dropouts (close to 100% gross survival, e.g., Uzbekistan), the survival improvement ratio might be high even with low absolute improvements
                        Dim pridropoutnet As Double
                        If sdout > 0.01 Then
                            pridropoutnet = AMAX(0, spridropoutnet(R%, gndr) * (dout / sdout))
                        Else
                            Dim sratenet = Amin(100, 100 * ((1 - spridropoutnet(R%, gndr)) ^ (edprilen(R%) - 1)))
                            Dim srategap = CInt(Floor(100 - sratenet))
                            sratenet = ConvergeOverTimeRate(CSng(sratenet), 100, Amin(30, srategap))
    
                            'gross survival have already reached 100%; Net'll converge in next 20 years
                            pridropoutnet = AMAX(0, 1 - ((sratenet / 100) ^ (1 / (edprilen(R%) - 1))))
                        End If
    
                        spridropoutnet(R%, gndr) = CSng(pridropoutnet)
    
                        'mti 07/24/2020 Start
                        For GCount% = 1 To CInt(edprilen(R%))
                            EdPriDropoutByGradeNet(GCount%, R%, gndr%) = EdPriDropoutByGrade(GCount%, R%, gndr%)
                        Next GCount%
    
                        'mti 2020/09/01 Start
                        If i1EdPriSur(R%, gndr%) = 100 Then
                            SurvTrgtCovd = 1
                        Else
                            SurvTrgtCovd = (sEDPRISUR(R%, gndr%) - i1EdPriSur(R%, gndr%)) / (100 - i1EdPriSur(R%, gndr%))
                        End If
    
                        'If (GRPS(1, R%) = "Afghanistan" Or GRPS(1, R%) = "Singapore" Or GRPS(1, R%) = "Rwanda") And gndr = 1 And IY = 2 Then
                        '    Debug.Print IY - 1; ","; GRPS(1, R%); ","; "Male_Net"; ","; PristudentsNet(1, R%, gndr%); ","; PristudentsNet(2, R%, gndr%); ","; PristudentsNet(3, R%, gndr%); ","; PristudentsNet(4, R%, gndr%); ","; PristudentsNet(5, R%, gndr%); ","; PristudentsNet(6, R%, gndr%)
                        'End If
    
                        'mti 2022/04/12 Start
                        For GCount% = 1 To CInt(edprilen(R%))
                            NByGGrd(GCount%) = If(edprienrgrdm(R%, NGender) <> 1, edprienrgrdm(R%, NGender), edprienrgrdm(R%, gndr))
                            If NByGGrd(GCount%) <> 1 Then
                                NByGGrd(GCount%) = NByGGrd(GCount%) * PristudentsNet(GCount%, R%, gndr%) / SaveStudentCohorts(R%, GCount%, gndr, 1)
                            End If
                        Next
                        'mti 2022/04/12 End NByGGrd(GCount%)
    
    
                        For GCount% = CInt(edprilen(R%)) To 2 Step -1
                            PristudentsNet(GCount%, R%, gndr%) = PristudentsNet(GCount% - 1, R%, gndr%) * (1 - EdPriDropoutByGradeNet(GCount% - 1, R%, gndr%))
    
                            'mti 2021/03/02 Start - last grade
                            If GCount% = edprilen(R%) And edPrienrggrshift(GCount%, R%, gndr) > 1 Then
                                If i1EdPriSur(R%, gndr%) < 90 Then '95
                                    PristudentsNet(GCount%, R%, gndr%) = AMAX(5, PristudentsNet(GCount%, R%, gndr%) * ConvergeOverPath(edPrienrggrshift(GCount%, R%, gndr), 1, EDPRISUR(R%, gndr%), i1EdPriSur(R%, gndr%), 90)) 'sEdprisur ;100
                                Else
                                    PristudentsNet(GCount%, R%, gndr%) = AMAX(5, PristudentsNet(GCount%, R%, gndr%) * ConvergeOverTime(edPrienrggrshift(GCount%, R%, gndr), 1, 10))
                                End If
                            End If
    
                            'mti 2022/04/12 start
                            '* Amin(2, AMAX(1, IIf(edpriintnm(R%, NGender) <> 1, edpriintnm(R%, NGender), edpriintnm(R%, gndr))))
                            PristudentsNet(GCount%, R%, gndr) = PristudentsNet(GCount%, R%, gndr) * Amin(2, AMAX(1, If(edpriintnm(R%, NGender) <> 1, edpriintnm(R%, NGender), edpriintnm(R%, gndr))))
                            'mti 2022/04/12 End
    
    
                            'mti 2022/04/12 start
                            '* Amin(2, AMAX(1, IIf(edpriintnm(R%, NGender) <> 1, edpriintnm(R%, NGender), edpriintnm(R%, gndr))))
                            PristudentsNet(GCount%, R%, gndr) = PristudentsNet(GCount%, R%, gndr) * Amin(3, AMAX(0.05, If(edprienrm(R%, NGender) <> 1, edprienrm(R%, NGender), edprienrm(R%, gndr))))
                            'mti 2022/04/12 End
    
                        Next
    
                        'repeaters subtracted from second grade
                        'jrs 2021/07/08
                        'Dim RptrGr1Net = PristudentsNet(1, R%, gndr%) * RptrGr1 / pristudents(1, R%, gndr%) 'RptGr1 set to 0 for no impact
                        'PristudentsNet(2, R%, gndr%) = PristudentsNet(2, R%, gndr%) - RptrGr1Net
    
    
                        If i1EdPriSur(R%, gndr%) < 95 Then
                            'pristudents(1, R%, gndr%) = AMAX(5, pristudents(1, R%, gndr%) - edPrienrggr1shift(R%, gndr) * (1 - SurvTrgtCovd))
                            PristudentsNet(1, R%, gndr%) = AMAX(5, EDPRIINTN(R%, gndr) + ConvergeOverPath(PrimAgeG1Shift(R%, gndr%), 0, sEDPRISUR(R%, gndr%), i1EdPriSur(R%, gndr%), 100))
                        Else
                            'high survival, high grd1 - intake difference countries
                            'pristudents(1, R%, gndr%) = AMAX(5, pristudents(1, R%, gndr%) - ConvergeOverTime(edPrienrggr1shift(R%, gndr), 0, 10))
                            PristudentsNet(1, R%, gndr%) = AMAX(5, EDPRIINTN(R%, gndr) + ConvergeOverTime1(PrimAgeG1Shift(R%, gndr%), 0, 10))
                        End If
                        'mti 2021/03/16 End
    
                        'subtract repeaters from (net) grade 2 enrollment
    
                        'add first graders to total students
                        Dim edpritotNet As Double = 0
                        For GCount% = 1 To CInt(edprilen(R%))
                            'mti 2022/04/12 start
                            PristudentsNet(GCount%, R%, gndr) = PristudentsNet(GCount%, R%, gndr) * NByGGrd(GCount%)
                            If GCount% > 1 Then
                                PristudentsNet(GCount%, R%, gndr) = Amin(100, PristudentsNet(GCount%, R%, gndr))
                            End If
                            'mti 2022/04/12 End NByGGrd(GCount%)
    
                            edpritotNet = edpritotNet + fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr) * PristudentsNet(GCount%, R%, gndr) / 100
                        Next
    
                        EDPRIENRN(R%, gndr) = CSng(Amin(100, (100 * edpritotNet / pripop(R%, gndr)))) '+ ConvergeOverTime1(edprienrnshift(R%, gndr), 0, 40)) ' caledprienrn
                        '
                        '   All Years but First: Primary Final: Compute Primary Educated Adults- Total and by 5 year cohorts
                        '   ------------------------------------------------------------------------------------------------
    
                        'Percentage of 15+ that completed primary
                        EDPRIPER(R%, gndr) = 0
    
                        'If IY = 2 And gndr = 1 And GRPS(1, R) = "Japan" Then Stop
    
                        'advance primary educated across cohort borders
                        For j% = NCohorts To 5 Step -1
                            EdPriPopPer(j%, R%, gndr) = EdPriPopPer(j%, R%, gndr) +
                            EdPriPopPer(j% - 1, R%, gndr) / 5 - EdPriPopPer(j%, R%, gndr) / 5
                            EDPRIPER(R%, gndr) = CSng(EDPRIPER(R%, gndr) + EdPriPopPer(j%, R%, gndr) *
                            agedst(j%, R%, gndr))
    
                        Next j%
    
                        'If IY = 2 And gndr = 1 And EdPriPopPer(4, R%, gndr) > EDPRICR(R, gndr) Then Stop
                        'add (net) graduates to the bottom cohort
                        'mti 2024/01/09 start 'PEPPRI(R%, gndr),
                        Dim prigrate = AMAX(1, Amin(100, EDPRICR(R%, gndr)))
                        'just in case primary school graduation data is less than primary adult completion rate and the spread results in a lower rate for 15-19
                        prigrate = AMAX(1, Amin(100, prigrate * ConvergeOverTime(PEPPRI(R%, gndr), 1, 15)))
                        'mti 2024/01/09 end
    
                        EdPriPopPer(4, R%, gndr) = Amin(100, AMAX(0.000001, (4 * EdPriPopPer(4, R%, gndr) + prigrate) / 5))
    
                        'mti 2024/01/14 start 
                        EDPRIPER(R%, gndr) = CSng(EDPRIPER(R%, gndr) + EdPriPopPer(4, R%, gndr) * agedst(4, R%, gndr))
    
                        EDPRIPER(R%, gndr) = AMAX(1, Amin(100, EDPRIPER(R%, gndr) / AMAX(0.0000001, AdultPop(R%, gndr)) + ConvergeOverTime(EPPShft(R%, gndr), 0, 70)))
                        EDPRIPER15TO24(R%, gndr) = AMAX(1, Amin(100, CSng(EdPriPopPer(4, R%, gndr) * agedst(4, R%, gndr) + EdPriPopPer(5, R%, gndr) * agedst(5, R%, gndr))))
    
                        'using 15+ shift for now: revise
                        EDPRIPER15TO24(R%, gndr) = AMAX(1, Amin(100, EDPRIPER15TO24(R%, gndr) / AMAX(0.0000001, AdultPop15to24(R%, gndr)) + ConvergeOverTime(EPPShft15to24(R%, gndr), 0, 70)))
                        'mti 2024/01/14 end
                    Next gndr
    
                    '   All Years but First: Primary Final: Totals of both genders: Final After Budget
                    '   ------------------------------------------------------------------------------------------------
                    'mti 2020/09/01 Start
                    'PrimaryTotals R%, AdultPop(R%, 1), AdultPop(R%, 2), AdultPop15to24(R%, 1), AdultPop15to24(R%, 2)
    PrimaryTotals_new_init(R%, AdultPop(R%, 1), AdultPop(R%, 2), AdultPop15to24(R%, 1), AdultPop15to24(R%, 2))
            ' ---- Begin Inlined Level 3: IFsEducPri_new_init:ifsEducPri2_new_init:PrimaryTotals_new_init
    ' Private Sub PrimaryTotals_new_init(R%, AdultMales As Single, AdultFemales As Single, AdultMales15to24 As Single, AdultFemales15to24 As Single)
                        '----------------------------------------------------------------------------------
                        'mti 2020/09/01  - Take procedure
                        'mti 2016/01/07 - whole procedure
                        'Education Module - Total from male and female- Primary
            
                        '    Primary: Average male and female to totals;
                        '   --------------------------------------------------------------------------------------------------
                        'EDPRIINT(R%%, Total) = (EDPRIINT(R%%, 1) * (agedst(2, R%%, 1) / 5) + EDPRIINT(R%%, 2) * (agedst(2, R%%, 2) / 5)) / AMAX(0.0000001, ((agedst(2, R%%, 1) + agedst(2, R%%, 2)) / 5))
                        EDPRIINT(R%%, Total) = CSng((EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) _
                                        + EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) _
                                        / AMAX(0.0000001, fagedst(CInt(edpristart(R%%)), R%%, 1) + fagedst(CInt(edpristart(R%%)), R%%, 2)))
            
                        EDPRIINTN(R%%, Total) = CSng((EDPRIINTN(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) _
                                        + EDPRIINTN(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) _
                                        / AMAX(0.0000001, fagedst(CInt(edpristart(R%%)), R%%, 1) + fagedst(CInt(edpristart(R%%)), R%%, 2)))
            
            
                        EDPRISUR(R%%, Total) = CSng(((EDPRISUR(R%%, 1) * EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) + EDPRISUR(R%%, 2) * EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2)) /
                        AMAX(0.0000001, (EDPRIINT(R%%, 1) * fagedst(CInt(edpristart(R%%)), R%%, 1) + EDPRIINT(R%%, 2) * fagedst(CInt(edpristart(R%%)), R%%, 2))))) '* 100
            
            
            Dim PriBoys = CInt(edpristart(R%%)) + edprilen(R%%) + R%% + Male @@Dim PriBoys = CalcPopFrom1Year(CInt(edpristart(R%%)), edprilen(R%%), R%%, Male)@@
            Dim PriGirls = CInt(edpristart(R%%)) + edprilen(R%%) + R%% + Female @@Dim PriGirls = CalcPopFrom1Year(CInt(edpristart(R%%)), edprilen(R%%), R%%, Female)@@
            
                        'mti 2020/09/01  Start
                        For GCount% = 1 To CInt(edprilen(R%%)) '+ 1 To NPriGr
                            Dim Pupils_Male = EDPRIENRGGRD(R%%, GCount%, Male) * fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Male)
                            Dim Pupils_Female = EDPRIENRGGRD(R%%, GCount%, Female) * fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Female)
                            Dim Population_Total = fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Male) + fagedst(CInt(edpristart(R%%) + GCount% - 1), R%%, Female)
                            Dim Pupils_Total = Pupils_Male + Pupils_Female
            
                            EDPRIENRGGRD(R%%, GCount%, Total) = CSng((Pupils_Male + Pupils_Female) / AMAX(0.00001, Population_Total))
            
                            If GCount% < edprilen(R%%) Then
                                EDPRIDRPGRD(R%%, GCount%, Total) = CSng((EDPRIDRPGRD(R%%, GCount%, Male) * Pupils_Male + EDPRIDRPGRD(R%%, GCount%, Female) * Pupils_Female) / AMAX(0.000001, Pupils_Total))
                            End If
                        Next
                        'mti 2020/09/01 End
            
            
                        EDPRIENRG(R%%, Total) = (EDPRIENRG(R%%, 1) * PriBoys + EDPRIENRG(R%%, 2) * PriGirls) /
                        AMAX(0.0000001, PriBoys + PriGirls)
            
            
                        'mti January 14-20, 2005- total for first year - calculation of total in pre-processor ignored
                        EDPRIPER(R%%, Total) = (EDPRIPER(R%%, 1) * AdultPop(R%, 1) + EDPRIPER(R%%, 2) * AdultPop(R%, 2)) /
                        AMAX(0.0000001, (AdultPop(R%, 1) + AdultPop(R%, 2)))
            
                        'mti 2016/01/07 -start
                        EDPRIPER15TO24(R%%, Total) = (EDPRIPER15TO24(R%%, 1) * AdultPop15to24(R%, 1) + EDPRIPER15TO24(R%%, 2) * AdultPop15to24(R%, 2)) /
                        AMAX(0.0000001, (AdultPop15to24(R%, 1) + AdultPop15to24(R%, 2)))
                        'mti 2016/01/07 -end
            
                        EDPRIENRN(R%%, Total) = Amin(100, (EDPRIENRN(R%%, 1) * PriBoys + EDPRIENRN(R%%, 2) * PriGirls) /
                        AMAX(0.0000001, PriBoys + PriGirls))
            
            
                        EDPRICR(R%%, Total) = CSng((EDPRICR(R%%, Male) * fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Male) +
                            EDPRICR(R%%, Female) * fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Female)) /
                                AMAX(0.0000001, (fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Male) + fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Female))))
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri_new_init:ifsEducPri2_new_init:PrimaryTotals_new_init
                    'mti 2020/09/01 End
    
                Next R%
    
                sErrorSub = PrevsErrorSub
' End Sub
    ' ---- End Inlined Level 2: IFsEducPri_new_init:ifsEducPri2_new_init
