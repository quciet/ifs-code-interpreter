                '              'CalEDSECENRN = Amin(100, ConvergeOverTimeRate1(CalEDSECENRN, 100, 15))
                '            End If
    
    
                'advance net by looking at upper survival
    
                'ttt 2019/08/31 Consider ByRef??
                sEdSecEnrN(R%, gndr) = EDSECENRN(R%%, gndr%)
' End Sub
