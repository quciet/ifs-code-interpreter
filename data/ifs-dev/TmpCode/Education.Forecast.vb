                                / AMAX(0.0000001, fagedst(CInt(secupprStart), R%%, Male) + fagedst(CInt(secupprStart), R%%, Female)))
    
                IntkRateMale = EDSECUPPRTRAN(R%%, 1) * seclowrstudents(CInt(edseclowrlen(R%)), R%, Male)
