                        iEdIntk(R%, gndr, Primary) = EDPRIINTN(R%, gndr)
    
                        'net intake determined by demand and not constrained by multiplier- used for unconstrained enrollment demand calculation
                        EDPRIINTN(R%, gndr) = AMAX(1, Amin(100, EDPRIINTN(R%, gndr)))
    
                        'normative scenario for growth in intake - has to go in demand calc- in case budget is on
    FlowGoals(gEDPRIINTN(R%, gndr), EDPRIINTN(R%, gndr), edpriintngr(R%, gndr), edpriintngr(R%, NGender), 50, 100, 3, edpriintntrgtyr(R%), iEDPRIINTN(R%, gndr%))
            ' ---- Begin Inlined Level 3: IFsEducPri_new_init:ifsEducPri_new_init_AllButFirst:FlowGoals
    ' Private Sub FlowGoals(ByRef gflow_val As Single, ByRef flow_val As Single, ByRef GRate_gndr As Single, GRate_Ttl As Single, ByRef max_gp As Single, flow_cap As Single, Optional ftype As Single = 3, Optional trgtyr As Single = 0, Optional initval As Single = 0) '3 '1
                        'ttt 2019/08/31 where go EDPRIINTN(R%, gndr)? (consider ByRef)
                        'mti 2014/05/28 - definition and proc
                        ''''Education Module
                        'mti 2013/10/07 - Education for WC - Take whole proc
            
                        '
                        'ssErrorSub = sErrorSub
                        'sErrorSub = sErrorSub + ", FlowGoals"
            
                        'mti 2014/05/28
                        'Target year parameter: reach max within trgtyear measured as number of years from the base year (0 is the base value= no target seek)
                        Dim trgtval = 0!
                        Dim s_growth = 0!
                        If edpriintntrgtyr(R%) > 0 Then
            
                            'mti 2016/03/09- start
                            'Linear goal seek
                            trgtval = 100 'for now
                            trgtval = Amin(100, iEDPRIINTN(R%, gndr%) + Amin(edpriintntrgtyr(R%), IY - 1) * (trgtval - iEDPRIINTN(R%, gndr%)) / edpriintntrgtyr(R%))
            
                            'logistic goal seek
                            '            stpmid = 9.999 / (edpriintntrgtyr(R%) * 2) 'back calculated from logistic formula
                            '            stpmidmin = AMAX(0.01, stpmid - 0.05)
                            '            stpmidmax = Amin(0.7, stpmid + 0.25)
                            '            stp = Amin(stpmidmax, AMAX(stpmidmin, stpmid + (70 - iEDPRIINTN(R%, gndr%)) / 100))
                            '            expterm = Exp(stp * Amin(IY - 1, edpriintntrgtyr(R%) + 20))
                            '            trgtval = (100 * iEDPRIINTN(R%, gndr%) * expterm) / (100 + (iEDPRIINTN(R%, gndr%) * (expterm - 1)))
                            'mti 2016/03/09- end
            
                            'mti 2014/10/06 - start
                            gEDPRIINTN(R%, gndr) = AMAX(trgtval, EDPRIINTN(R%, gndr))
                            EDPRIINTN(R%, gndr) = gEDPRIINTN(R%, gndr)
                            'mti 2014/10/06 - end
            
            
                            Exit Sub 'if target year is set - growth rate parameter won't work
                        End If
                        'mti 2014/05/28
            
                        '100 is the ceiling for flow, e.g., 100% for survival
                        'grate is the growth rate obtained from scenario handle, if it is 3, 3% (point) growth occurs at 50 and tapers off both way, i.e., towards 0 and 100
                        '    If GRate_gndr < 0 Then Stop
                        'take the max of the total or the gender being calculated
            
                        'mti 2013/09/16 - Education for WC -start
                        If edpriintngr(R%, NGender) > 0 Then
                            GRate_gndr = AMAX(GRate_gndr, edpriintngr(R%, NGender))
                        ElseIf edpriintngr(R%, NGender) < 0 Then
                            GRate_gndr = Amin(GRate_gndr, edpriintngr(R%, NGender))
                        End If
                        'mti 2013/09/16 - Education for WC -end
            
                        If GRate_gndr = 0 Then
                            Exit Sub
                        End If
            
                        'mti 2013/09/16 - Education for WC -start
                        If GRate_gndr > 0 Then
                            '50 is the point at which maximum growth occurs, as a  percentage of ceiling (or 100);  e.g., 50%
                            50 = 100 * 50 / 100
            
                            'net intake rate growing with a growth rate
            
                            's-shaped growth : point at which maximum growth occurs
                            'standard logistic sigmoid function : dp/dt = P(1-P), with P(0) = .5; or max_gr=50;
                            'In P(1-P); the first term,P controls increasing growth till the midpoint (max_gr); the second term is dcreasing growth from the mid point to saturation
                            'our formulation growth = gr*[P(1-P)]/midpoint; P is the population, here, intake rate
                            'introduced a log formulation now
            
                            If 3 = 1 Then         'non-log, tiered
                                s_growth = GRate_gndr * If(gEDPRIINTN(R%, gndr) >= 50, (100 - Amin(100, gEDPRIINTN(R%, gndr))) / (100 - 50), gEDPRIINTN(R%, gndr) / 50)
                            ElseIf 3 = 2 Then 'non-log- product of terms
                                s_growth = GRate_gndr * ((100 - Amin(100, gEDPRIINTN(R%, gndr))) / (100 - 50)) * (gEDPRIINTN(R%, gndr) / 50)
                            Else  '3 =3 ; log formulation
                                'Amin(100, gEDPRIINTN(R%, gndr)) - this is needed as some country's lower/upper sec survival value at te initial year night be above the cap; they are brought down later
                                's_growth = GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDPRIINTN(R%, gndr)), 100 + 1 - 50)) / Log(100 + 1 - 50) * Log(AMAX(1.1, gEDPRIINTN(R%, gndr))) / Log(50)
                                s_growth = CSng(GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDPRIINTN(R%, gndr)), 100 + 1 - 50)) / Log(100 + 1 - 50) * Log(AMAX(1.1, Amin(100, gEDPRIINTN(R%, gndr)))) / Log(50))
                            End If
                            gEDPRIINTN(R%, gndr) = Amin(100, gEDPRIINTN(R%, gndr) + s_growth) 'previous years' goal value + goal growth
            
