                            '            stpmidmin = AMAX(0.01, stpmid - 0.05)
                            '            stpmidmax = Amin(0.7, stpmid + 0.25)
                            '            stp = Amin(stpmidmax, AMAX(stpmidmin, stpmid + (70 - iEDPRISUR(R%, gndr%)) / 100))
                            '            expterm = Exp(stp * Amin(IY - 1, edprisurtrgtyr(R%) + 20))
                            '            trgtval = (100 * iEDPRISUR(R%, gndr%) * expterm) / (100 + (iEDPRISUR(R%, gndr%) * (expterm - 1)))
                            'mti 2016/03/09- end
            
                            'mti 2014/10/06 - start
                            gEDPRISUR(R%, gndr) = AMAX(trgtval, EDPRISUR(R%, gndr))
                            EDPRISUR(R%, gndr) = gEDPRISUR(R%, gndr)
                            'mti 2014/10/06 - end
            
            
                            Exit Sub 'if target year is set - growth rate parameter won't work
                        End If
                        'mti 2014/05/28
            
                        '100 is the ceiling for flow, e.g., 100% for survival
                        'grate is the growth rate obtained from scenario handle, if it is 3, 3% (point) growth occurs at 65 and tapers off both way, i.e., towards 0 and 100
                        '    If GRate_gndr < 0 Then Stop
                        'take the max of the total or the gender being calculated
            
                        'mti 2013/09/16 - Education for WC -start
                        If edprisurgr(R%, NGender) > 0 Then
                            GRate_gndr = AMAX(GRate_gndr, edprisurgr(R%, NGender))
                        ElseIf edprisurgr(R%, NGender) < 0 Then
                            GRate_gndr = Amin(GRate_gndr, edprisurgr(R%, NGender))
                        End If
                        'mti 2013/09/16 - Education for WC -end
            
                        If GRate_gndr = 0 Then
                            Exit Sub
                        End If
            
                        'mti 2013/09/16 - Education for WC -start
                        If GRate_gndr > 0 Then
                            '65 is the point at which maximum growth occurs, as a  percentage of ceiling (or 100);  e.g., 50%
                            65 = 100 * 65 / 100
            
                            'net intake rate growing with a growth rate
            
                            's-shaped growth : point at which maximum growth occurs
                            'standard logistic sigmoid function : dp/dt = P(1-P), with P(0) = .5; or max_gr=50;
                            'In P(1-P); the first term,P controls increasing growth till the midpoint (max_gr); the second term is dcreasing growth from the mid point to saturation
                            'our formulation growth = gr*[P(1-P)]/midpoint; P is the population, here, intake rate
                            'introduced a log formulation now
            
                            If 3 = 1 Then         'non-log, tiered
                                s_growth = GRate_gndr * If(gEDPRISUR(R%, gndr) >= 65, (100 - Amin(100, gEDPRISUR(R%, gndr))) / (100 - 65), gEDPRISUR(R%, gndr) / 65)
                            ElseIf 3 = 2 Then 'non-log- product of terms
                                s_growth = GRate_gndr * ((100 - Amin(100, gEDPRISUR(R%, gndr))) / (100 - 65)) * (gEDPRISUR(R%, gndr) / 65)
                            Else  '3 =3 ; log formulation
                                'Amin(100, gEDPRISUR(R%, gndr)) - this is needed as some country's lower/upper sec survival value at te initial year night be above the cap; they are brought down later
                                's_growth = GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDPRISUR(R%, gndr)), 100 + 1 - 65)) / Log(100 + 1 - 65) * Log(AMAX(1.1, gEDPRISUR(R%, gndr))) / Log(65)
                                s_growth = CSng(GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDPRISUR(R%, gndr)), 100 + 1 - 65)) / Log(100 + 1 - 65) * Log(AMAX(1.1, Amin(100, gEDPRISUR(R%, gndr)))) / Log(65))
                            End If
                            gEDPRISUR(R%, gndr) = Amin(100, gEDPRISUR(R%, gndr) + s_growth) 'previous years' goal value + goal growth
            
                            EDPRISUR(R%, gndr) = AMAX(gEDPRISUR(R%, gndr), EDPRISUR(R%, gndr))  'take the higher of goal or base (function driven) forecast
            
                        Else
                            'equation of conic parabola with vertex at 10, Grate_gndr; y= a (x-h)^2+k
                            '            If IY >= 11 Then Stop
                            If IY <= 11 Then
