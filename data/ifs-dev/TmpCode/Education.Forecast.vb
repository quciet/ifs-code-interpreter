                        'EdPriDropoutByGradeNet(GCount, R%, gndr%) = EdPriDropoutByGrade(GCount, R%, gndr%)
                        EdPriDropoutByGradeNet(GCount, R%, gndr%) = EDPRIDRPGRD(R%, GCount%, gndr%)
                        'mti 2022/04/12 End
                    Next

                    '   First Year Primary: Compute overage entrants as a share of out of school children
                    '=====================================================================================

                    'mti 2020/09/01 End

                    'out of school children at the beginning of a year are the children from the preceding year, who
                    'a. were of entrance age but missed entry, or, b. were already out of school, or, c. dropped out during the preceding year
                    'mti 2021/02/18

                    ' If GRPS(1, R%) = "Solomon Islands" Then Stop

                    'were of entrance age but missed entry
                    Dim Missed_Entrance = fagedst(CInt(edpristart(R%)), R%, gndr%) * (100 - EDPRIINTN(R%, gndr%)) / 100  'The second term will bring same result as AMAX(0, 100 - EDPRIINTNEXT(R%, gndr%)); it's more convenient to explain the way it is

                    'were already out of school, above entrance age but within primary age; with the assumption that above primary age won't return to school unless just dropped out
                    Dim StudentsTot = fagedst(CInt(edpristart(R%)), R%, gndr%) * (PristudentsNet(1, R%, gndr%) - EDPRIINTN(R%, gndr%)) / 100
                    Dim PopTot As Double? = 0 ' fagedst(cint(edpristart(R%)), R%, gndr%)
                    For GCount% = 2 To CInt(edprilen(R%))
                        StudentsTot = StudentsTot + fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr%) * PristudentsNet(GCount%, R%, gndr%) / 100
                        PopTot = PopTot + fagedst(CInt(edpristart(R%) + GCount% - 1), R%, gndr%)
                    Next
                    Dim Already_Out_Of_School = AMAX(0, PopTot - StudentsTot)

