                        '    Debug.Print IY; ","; GRPS(1, R%); ","; "Male_Gross"; ","; pristudents(1, R%, gndr%); ","; pristudents(2, R%, gndr%); ","; pristudents(3, R%, gndr%); ","; pristudents(4, R%, gndr%); ","; pristudents(5, R%, gndr%); ","; pristudents(6, R%, gndr%)
                        'End If
    
    
    
                        EDPRITOT(R%, gndr) = 0
