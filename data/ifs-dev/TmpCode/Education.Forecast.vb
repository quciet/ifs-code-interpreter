            'mti 2013/09/16 - Education for WC -start
            If GRate_gndr > 0 Then
                '70 is the point at which maximum growth occurs, as a  percentage of ceiling (or 100);  e.g., 50%
                70 = 100 * 70 / 100

                'net intake rate growing with a growth rate

                's-shaped growth : point at which maximum growth occurs
                'standard logistic sigmoid function : dp/dt = P(1-P), with P(0) = .5; or max_gr=50;
                'In P(1-P); the first term,P controls increasing growth till the midpoint (max_gr); the second term is dcreasing growth from the mid point to saturation
                'our formulation growth = gr*[P(1-P)]/midpoint; P is the population, here, intake rate
                'introduced a log formulation now

                If ftype = 1 Then         'non-log, tiered
                    s_growth = GRate_gndr * If(gEDSECLOWRGRate(R%, gndr) >= 70, (100 - Amin(100, gEDSECLOWRGRate(R%, gndr))) / (100 - 70), gEDSECLOWRGRate(R%, gndr) / 70)
                ElseIf ftype = 2 Then 'non-log- product of terms
                    s_growth = GRate_gndr * ((100 - Amin(100, gEDSECLOWRGRate(R%, gndr))) / (100 - 70)) * (gEDSECLOWRGRate(R%, gndr) / 70)
                Else  'ftype =3 ; log formulation
                    'Amin(100, gEDSECLOWRGRate(R%, gndr)) - this is needed as some country's lower/upper sec survival value at te initial year night be above the cap; they are brought down later
                    's_growth = GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDSECLOWRGRate(R%, gndr)), 100 + 1 - 70)) / Log(100 + 1 - 70) * Log(AMAX(1.1, gEDSECLOWRGRate(R%, gndr))) / Log(70)
                    s_growth = CSng(GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDSECLOWRGRate(R%, gndr)), 100 + 1 - 70)) / Log(100 + 1 - 70) * Log(AMAX(1.1, Amin(100, gEDSECLOWRGRate(R%, gndr)))) / Log(70))
                End If
                gEDSECLOWRGRate(R%, gndr) = Amin(100, gEDSECLOWRGRate(R%, gndr) + s_growth) 'previous years' goal value + goal growth

                EDSECLOWRGRATE(R%, gndr) = AMAX(gEDSECLOWRGRate(R%, gndr), EDSECLOWRGRATE(R%, gndr))  'take the higher of goal or base (function driven) forecast

            Else
                'equation of conic parabola with vertex at 10, Grate_gndr; y= a (x-h)^2+k
                '            If IY >= 11 Then Stop
                If IY <= 11 Then
                    s_growth = CSng((Abs(GRate_gndr) * 0.05) * (IY - 6) ^ 2 + GRate_gndr)
                    s_growth = AMAX(GRate_gndr, Amin(s_growth, 0))
                    EDSECLOWRGRATE(R%, gndr) = AMAX(3, Amin(100, gEDSECLOWRGRate(R%, gndr) + s_growth))  'gEDSECLOWRGRate(R%, gndr) is first year value for this case
                    'Else
                    's_growth = 0
                    'EDSECLOWRGRATE(R%, gndr) = EDSECLOWRGRATE(R%, gndr)
                ElseIf gEDSECLOWRGRate(R%, gndr) < EDSECLOWRGRATE(R%, gndr) Then
                    EDSECLOWRGRATE(R%, gndr) = ConvergeOverTimeSmooth(gEDSECLOWRGRate(R%, gndr), EDSECLOWRGRATE(R%, gndr), 5)
                End If

            End If
