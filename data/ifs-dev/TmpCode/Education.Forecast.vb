                                                terstudents(GCount%, R%%%, gndr%) / 100)
            
                                    PartialTerPersYearsNew = PartialTerPersYearsNew +
                                (gr_Students * Dropoutrate) * (GCount% - 1)
                                End If
                            Next GCount%
            
                            'Partial Years of education (million), total from all levels, from dropout, for people aged (25 or 15) and above
