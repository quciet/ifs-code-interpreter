                For R% = 1 To NR%
                    Dim RegionName = context.GetDimension(1).Buckets.Item(CShort(R))
                    sErrorSub = sErrorSub & RegionName
                    '   Primary Education
                    '========================================
                    'mti 2018/01/18 start
                    'mti 2018/06/05 Start
                    'Call AnalFunc("Educ Qual Pri All, Total, WBGA 2010 (Lin) vs GDPPCPLN, Edyear25 and PriExpPer", _
                    'Array(EDEXPERPRI(R%), EDYRSAG25(R%, 3), GDPPCP(R%)), CalcScore, _
                    'Array("EdExpPriPerStud%GDPPC (Linear)", "EdYearsAge25 (Linear)", "GDPPCP (Log)"))
    
    
