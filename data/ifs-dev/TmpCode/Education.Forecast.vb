                    Already_Out_Of_School = Already_Out_Of_School '* 1.25 'mti 2021/04/19

                    Dim OutofSchoolTot = Missed_Entrance + Already_Out_Of_School + Just_Dropped_Out  'OutofSchool_Dropouts_Lower +



                    'Overage entrance this year - head count
                    OverageInGr1Count(R%, gndr%) = CSng(AMAX(0, EDPRIINT(R%, gndr%) - EDPRIINTNEXT(R%, gndr%)) * fagedst(CInt(edpristart(R%)), R%, gndr) / 100) 'this can also be gross - net in 1st grade


                    'overage entrants as a share of out of school children
                    If OutofSchoolTot > 0 Then
                        RetGr1Pcnt(R%, gndr%) = CSng(OverageInGr1Count(R%, gndr%) / OutofSchoolTot)
                    Else
                        RetGr1Pcnt(R%, gndr%) = 0
                    End If

                    OverageInGr1Pcnt(R%, gndr%) = AMAX(0, EDPRIINT(R%, gndr%) - EDPRIINTNEXT(R%, gndr%))

