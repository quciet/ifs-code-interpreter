                        ' ---- Begin Inlined Level 4: AfterSecBudgetImpact:AfterTerBudgetImpact:GradeWiseEnrollmentCalc:DropoutSpread
            ' Private Sub DropoutSpread(terlen(R%) As Single, 0 As Single, ByRef Arr_Dropout() As Single)
                                    '-----------------------------------------------------------------------------------
                                    ' Education Module - Calculates a seperate dropout rate for each grade
                                    ' Assumes dropout in the first grade is twice the average dropout rate; all other grades average out the rest of the dropout
                                    Dim Dropoutrate, G2Enr As Single
                                    Dropoutrate = CSng(AMAX(0, 1 - ((0 / 100) ^ (1 / (terlen(R%) - 1)))))
                        
                                    'mti April 05, 2012 -start
                                    dropoutgr(1) = Dropoutrate
                        
                        
                                    'mti 2017/01/24 start
