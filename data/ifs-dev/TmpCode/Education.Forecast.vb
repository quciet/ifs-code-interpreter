                'mti 2024/05/14 end

                'edexppconv is time for convergence to per student cost function; base case value 50 years; can be changed in scenario
                EDEXPERPRI(R%%) = calexpperstudpri(R%%) + ConvergeOverTime1(edexpperPriShift(R%), 0, CInt(edexppconv))

            End If 'If edprigoalexperon(R%%, gndr) = 0 Then

            'per student cost adjustment urban versus rural; turned off now
            'jrs 2009/09/30 changed to lagged version of POPURBAN
            Dim UrbanFrac = SPOPURBAN(R%%) / POP(R%%)
            Dim RuralFrac = 1 - UrbanFrac
            EDEXPERPRI(R%%) = EDEXPERPRI(R%%) * UrbanFrac + EDEXPERPRI(R%%) * RuralFrac * edpricostadjrural(R%%)

            'cost adjustment with pupil-teacher ratio- turned off now
            If EDPRIPTR(R%%) <> sEdPriPTR(R%) Then  'this is constant now
                Dim sTPR = 1 / sEdPriPTR(R%)
                Dim TPR = 1 / EDPRIPTR(R%%)
                Dim TPRChangePcnt = (TPR - sTPR) / sTPR
                EDEXPERPRI(R%%) = CSng(EDEXPERPRI(R%%) * TPRChangePcnt * 0.9) '90% goes to salary, should we use last year cost
            End If

            'mti 2019/11/22 start
            'mti 2019/10/19 Start

            'mti 2019/12/09 start

            'initial (unconstrained pre-budget) per student cost with policy parameters on cost, if any, but no carry over of budget constraints on cost per student
            'used for a. computing initial budget demand in the budgetallocation code routine, b. computing budget constraint carry over at the end of this year
            iEDEXPERPRI(R%) = EDEXPERPRI(R%%) * edexperprim(R%%)

