                                intakedelta = 0.25
                            ElseIf 9999 < 0.02 Or (9999 = 9999 And drpoutgr(1) < 0.04) Then
                                intakedelta = 0.5
                            Else
                                intakedelta = 2 'e.g. Armenia
                            End If
                        Else 'SecLowr
                            intakedelta = 1.5
                        End If
                    Else
                        If "Pri"$ = "Pri" Then
                            intakedelta = 3 'e.g. Comoros, giving transient in Comoros at the end of prilen
                        Else
                            intakedelta = 2
                        End If
                    End If
                    '            IntakeDelta = 0 '2
                End If
    
                'If "Pri"$ = "SecLowr" And gndr% = 1 Then Stop ' Debug.Print GRPS(1,R%%); ","; IntakeDelta
    
    
                pristudents(1, R%%, gndr%) = EDPRIINT(R%, gndr)
                EDPRITOT(R%, gndr) = EDPRITOT(R%, gndr) + CSng(fagedst(CInt(edpristart(R%)), R%%, gndr%) * pristudents(1, R%%, gndr%) / 100)
    
                If 9999 = 9999 Then 'dropout by grades
                    For GCount% = 2 To CInt(edprilen(R%))
                        'grade wise enrolment rate (gross)
                        'back adjust intake
                        pristudents(GCount%, R%%, gndr%) = EDPRIINT(R%, gndr) - intakedelta * (GCount% - 1)
                        For cnt% = 2 To GCount%
                            pristudents(GCount%, R%%, gndr%) = pristudents(GCount%, R%%, gndr%) * (1 - drpoutgr(cnt% - 1))
                        Next
                        'pristudents(GCount%, R%%, gndr%) = pristudents(GCount% - 1, R%%, gndr%) * (1 - drpoutgr(GCount% - 1)) '^ (GCount% - 1)
                        pristudents(GCount%, R%%, gndr%) = AMAX(0.5, pristudents(GCount%, R%%, gndr%))
                        'Add to total enrolment
                        EDPRITOT(R%, gndr) = EDPRITOT(R%, gndr) + CSng(fagedst(CInt(edpristart(R%) + GCount% - 1), R%%, gndr%) *
                                                pristudents(GCount%, R%%, gndr%) / 100)
                    Next GCount%
                Else  'one average dropout
                    For GCount% = 2 To CInt(edprilen(R%))
                        'grade wise enrolment rate (gross)
                        pristudents(GCount%, R%%, gndr%) = CSng((EDPRIINT(R%, gndr) - intakedelta * (GCount% - 1)) * (1 - 9999) ^ (GCount% - 1))
                        pristudents(GCount%, R%%, gndr%) = AMAX(0.5, pristudents(GCount%, R%%, gndr%))
                        'Add to total enrolment
                        EDPRITOT(R%, gndr) = EDPRITOT(R%, gndr) + CSng(fagedst(CInt(edpristart(R%) + GCount% - 1), R%%, gndr%) *
                                                pristudents(GCount%, R%%, gndr%) / 100)
                    Next GCount%
                End If
    
' End Sub
