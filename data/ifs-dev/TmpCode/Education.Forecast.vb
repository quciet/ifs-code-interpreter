                    'If GRPS(1, R) = "India" And gndr = 2 Then Stop
                    'mti 2022/04/12 start
                    'caledsecint = pristudents(edprilen(R%), R%, gndr) * EDSECLOWRTRAN(R%, gndr) / 100
                    caledsecint = EDPRIENRGGRD(R%, CInt(edprilen(R%)), gndr%) * EDSECLOWRTRAN(R%, gndr) / 100
                    'mti 2022/04/12 end

                    'If GRPS(1, R) = "Congo" And gndr = 1 Then Stop




                    'mti 2024/01/24 start
                    If seclowrstudents(1, R%, gndr%) <= 0 Then
                        EdSecLowrRptrGr(1, R%, gndr) = 0
                        edSecLowrenrggr1shift(R%, gndr) = 1
                    Else
                        If caledsecint > 0 Then
                            edSecLowrenrggr1shift(R%, gndr) = EDSECLOWRENRGGRD(R%, 1, gndr%) / caledsecint
                        Else
                            edSecLowrenrggr1shift(R%, gndr) = 1
                        End If
                        'EdSecLowrRptrGr(1, R%, gndr) = CSng(Amin(0.9, AMAX(-0.3, (EDSECLOWRENRGGRD(R%, 1, gndr%) - caledsecint) / EDSECLOWRENRGGRD(R%, 1, gndr%))))
                        EdSecLowrRptrGr(1, R%, gndr) = CSng(Amin(0.9, AMAX(0, (EDSECLOWRENRGGRD(R%, 1, gndr%) - caledsecint) / EDSECLOWRENRGGRD(R%, 1, gndr%))))
                    End If
                    'mti 2024/01/24 End

                    'mti 2023/12/01 start
                    'If GRPS(1, R) = "India" And gndr = 2 Then Stop
                    For GCount% = 2 To CInt(edseclowrlen(R%))  'mti 2021/05/06
                        'If GRPS(1, R%) = "China" And gndr = 1 And GCount% = CInt(edseclowrlen(R%)) Then Stop
                        If seclowrstudents(GCount%, R%, gndr%) = 0 Then
                            EdSecLowrRptrGr(GCount%, R%, gndr) = 0
                        Else
                            EdSecLowrRptrGr(GCount%, R%, gndr) = CSng(Amin(0.9, AMAX(0, (EDSECLOWRENRGGRD(R%, GCount%, gndr%) -
                                                    (EDSECLOWRENRGGRD(R%, GCount% - 1, gndr%) *
                                                    AMAX(0.001, (1 - EDSECLOWRDRPGRD(R%, GCount% - 1, gndr%) -
                                                    EdSecLowrRptrGr(GCount% - 1, R%, gndr))))) / EDSECLOWRENRGGRD(R%, GCount%, gndr%))))
                        End If

                    Next
                    'mti 2023/12/01 end


                    'Dropoutrate = AMAX(0, 1 - (EDSECLOWRGRATE(R%, gndr) / caledsecint) ^ (1 / edseclowrlen(R%)))

                    'Progression to secondary school refers to the number of new entrants to the first grade of secondary school in a given year
