                            If i1EdPriSur(R%, gndr%) < 90 Then '95
                                pristudents(1, R%, gndr%) = AMAX(5, EDPRIINT(R%, gndr) + sEDPRIINT(R%, gndr) * (ConvergeOverPath(edPrienrggr1shift(R%, gndr), 1, EDPRISUR(R%, gndr%), i1EdPriSur(R%, gndr%), 90) - 1)) 'sEdprisur ;100
