                        'Cumdrp = 100
                        For GCount% = 1 To CInt(edprilen(R%) - 1)
                            EdPriDropoutByGrade(GCount%, R%, gndr%) = CSng(AMAX(0, Amin(0.9, EdPriDropoutByGrade(GCount%, R%, gndr%) * If(edpridrpgrdm(R%, NGender) <> 1, edpridrpgrdm(R%, NGender), edpridrpgrdm(R%, gndr)))))
