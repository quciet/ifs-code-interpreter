                edpriintnshift(R%, gndr) = EDPRIINTN(R%%, gndr) - CalcPriShift
    
    
                'First Year Primary Net Model: Calculate dropout using net intake and net enrollment rate
    pridropoutnet = edprilen(R%%) + EDPRIINTN(R%%, gndr) + EDPRIENRN(R%%, gndr) @@pridropoutnet = CalcDropoutFromEnrNIntk(edprilen(R%%), EDPRIINTN(R%%, gndr), EDPRIENRN(R%%, gndr))@@
                spridropoutnet(R%, gndr) = pridropoutnet
    
