                'AMAX(0.0000001, (IntkRateMale * fagedst(secupprStart, R%%, 1) + IntkRateFemale * fagedst(secupprStart, R%%, 2))))  '* 100
                'mti 2017/01/24 end
    
    
    SecMale = secupprStart + edsecupprlen(R%%) + R%% + Male @@SecMale = CalcPopFrom1Year(secupprStart, edsecupprlen(R%%), R%%, Male)@@
    SecFemale = secupprStart + edsecupprlen(R%%) + R%% + Female @@SecFemale = CalcPopFrom1Year(secupprStart, edsecupprlen(R%%), R%%, Female)@@
    
                EDSECUPPRENRG(R%%, Total) = (EDSECUPPRENRG(R%%, 1) * SecMale + EDSECUPPRENRG(R%%, 2) * SecFemale) _
                                        / AMAX(0.0000001, SecMale + SecFemale)
    
                EDSECUPPRVOC(R%%, Total) = (EDSECUPPRVOC(R%%, 1) * SecMale + EDSECUPPRVOC(R%%, 2) * SecFemale) _
