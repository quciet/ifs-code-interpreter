                'If GRPS(1, R%%) = "Congo, Dem. Republic of the" And gndr = 1 Then Stop
    
                For j% = 4 To NCohorts Step 1 'in case secondary graduation age is above 19; cohort 4 is 15-19
                    EdPriPopPer(j%, R%%, gndr%) = EdAttnPrimaryData(j%, R%%, gndr%)
                Next j%
    
                'If GRPS(1, R%) = "Ethiopia" Then Stop
                EdPriPopPer(4, R%%, gndr%) = Amin(100, AMAX(1, Grate))
