    ' ---- Begin Inlined Level 2: IFsEducSec_new_init:SecondaryTotals_New_Init
' Private Sub SecondaryTotals_New_Init(R%, AdultMales As Single, AdultFemales As Single, SecLowrLGGenM As Single, SecLowrLGGenF As Single, AdultMales15to24 As Single, AdultFemales15to24 As Single, AdultMales20to24 As Single, AdultFemales20to24 As Single)
                '----------------------------------------------------------------------------------
                'mti 2020/09/01  - Take procedure
    
                'Education Module - Total from male and female- Lower, Upper and Whole of Secondary
    
                ' Secondary lower
                Dim seclowrStart As Integer = CInt(edpristart(R%%) + edprilen(R%%))
    
