                    '
                    '                    Gr_Students = fagedst(edpristart(R%) + edprilen(R%) + GCount% - 1, R%, gndr%) * seclowrstudents(GCount%, R%, gndr%) / 100
                    '                    EdSecLowrTot_From_GradeEnr = EdSecLowrTot_From_GradeEnr + Gr_Students
                    '                    PopTot = PopTot + fagedst(edpristart(R%) + edprilen(R%) + GCount% - 1, R%, gndr%)
                    '                Next
