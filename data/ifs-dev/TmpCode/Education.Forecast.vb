                    sEdSecLowrSur(R%, gndr%) = EDSECLOWRSUR(R%, gndr%)

                    '   If GRPS(1,R%) = "Thailand" Then Stop

                    'Print #89, Replace(GRPS(1, R%), ",", " "); ","; gndr%; ","; GDPPCP(R%); ","; EDSECLOWRSUR(R%, gndr%); ","; EDSECLOWRENRG(R%, gndr%); ","; EDSECLOWRVOC(R%, gndr%); ","; EDSECLOWRENRGGRD(R%, 1, gndr%); ","; EDSECLOWRENRGGRD(R%, cint(edseclowrlen(R%)), gndr%); ","; edseclowrlen(R%); ","; EDSECUPPRVOC(R%, gndr%); ","; edsecupprlen(R%); ","; pristudents(CInt(edprilen(R%)), R%, gndr) * EDSECLOWRTRAN(R%, gndr) / 100; ","; EDPRICR(R%, gndr); ","; pristudents(CInt(edprilen(R%)), R%, gndr); ","; EDSECLOWRTRAN(R%, gndr)




                    If gndr = 1 Then
