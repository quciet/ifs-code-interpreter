                            seclowrstudents(1, R%, gndr%) = caledsecint * ConvergeOverPath(edSecLowrenrggr1shift(R%, gndr), 1, EDSECLOWRSUR(R%, gndr%), ilEdSecLowrSur(R%, gndr%), 99)

