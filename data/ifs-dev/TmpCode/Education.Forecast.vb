                            'If dropoutrate < 0.4 And GDPPCP(R%) < 4 Then
                            drpoutgr(1) = CSng(Amin(0.5, Dropoutrate * 2))
            
            
            
                            G2Enr = 1 - drpoutgr(1)
                            Dropoutrate = CSng(AMAX(0, 1 - ((EDPRISUR(R%, gndr) / G2Enr / 100) ^ (1 / (CInt(edprilen(R%)) - 2))))) 'dropout rate for gender
                            'End If
            
            
                            For GCount% = 2 To CInt(CInt(edprilen(R%)))
                                drpoutgr(GCount%) = Dropoutrate
                            Next GCount%
            
                        Else
                            For GCount% = 2 To CInt(CInt(edprilen(R%)))
                                drpoutgr(GCount%) = Dropoutrate
                            Next GCount%
                        End If
                        'mti April 05, 2012 -end
            
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducPri_new_init:ifsEducPri2_new_init:DropoutSpread
                        EDPRITOT(R%, gndr) = 0
    
