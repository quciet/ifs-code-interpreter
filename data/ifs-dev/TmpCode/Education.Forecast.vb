                        'EDPRISUR(R%, gndr%) = Cumdrp
                        '            'mti 2022/04/12 end
    
                        'First grade enrollment rate = intake + repeaters
                        pristudents(1, R%, gndr%) = EDPRIINT(R%, gndr%) / (1 - RptGr(1))
    
    
