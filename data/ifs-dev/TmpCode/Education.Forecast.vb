                                / AMAX(0.0000001, fagedst(seclowrStart, R%%, Male) + fagedst(seclowrStart, R%%, Female)))
    
                Dim IntkRateMale = EDSECLOWRTRAN(R%%, 1) * EDPRICR(R%%, 1)
                Dim IntkRateFemale = EDSECLOWRTRAN(R%%, 2) * EDPRICR(R%%, 2)
    
                'mti 2017/01/24 start
                'EDSECLOWRSUR(R%%, Total) = ((EDSECLOWRSUR(R%%, 1) * IntkRateMale * fagedst(seclowrStart, R%%, 1) + EDSECLOWRSUR(R%%, 2) * IntkRateFemale * fagedst(seclowrStart, R%%, 2)) / _
                'AMAX(0.0000001, (IntkRateMale * fagedst(seclowrStart, R%%, 1) + IntkRateFemale * fagedst(seclowrStart, R%%, 2))))  '* 100
