                            EDPRICR(R%%, Female) * fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Female)) /
                                AMAX(0.0000001, (fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Male) + fagedst(CInt(edpristart(R%%) + edprilen(R%%)), R%%, Female))))
            
