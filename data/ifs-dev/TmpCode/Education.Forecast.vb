                        'net equivalent of (gross) dropout
                        Dim dout = AMAX(0, 1 - ((EDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1))))
                        Dim sdout = AMAX(0, 1 - ((sEDPRISUR(R%, gndr) / 100) ^ (1 / (edprilen(R%) - 1))))
    
                        'mti check for very small dropouts (close to 100% gross survival, e.g., Uzbekistan), the survival improvement ratio might be high even with low absolute improvements
                        Dim pridropoutnet As Double
