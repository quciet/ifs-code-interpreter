                        's_growth = GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDSECLOWRGRate(R%, gndr)), 100 + 1 - 70)) / Log(100 + 1 - 70) * Log(AMAX(1.1, gEDSECLOWRGRate(R%, gndr))) / Log(70)
                        s_growth = CSng(GRate_gndr * Log(Amin(100 + 1 - Amin(100, gEDSECLOWRGRate(R%, gndr)), 100 + 1 - 70)) / Log(100 + 1 - 70) * Log(AMAX(1.1, Amin(100, gEDSECLOWRGRate(R%, gndr)))) / Log(70))
                    End If
                    gEDSECLOWRGRate(R%, gndr) = Amin(100, gEDSECLOWRGRate(R%, gndr) + s_growth) 'previous years' goal value + goal growth
    
                    EDSECLOWRGRATE(R%, gndr) = AMAX(gEDSECLOWRGRate(R%, gndr), EDSECLOWRGRATE(R%, gndr))  'take the higher of goal or base (function driven) forecast
    
