                'introduced a log formulation now

                If ftype = 1 Then         'non-log, tiered
                    s_growth = GRate_gndr * If(gEDSECUPPRGRate(R%, gndr) >= 70, (100 - Amin(100, gEDSECUPPRGRate(R%, gndr))) / (100 - 70), gEDSECUPPRGRate(R%, gndr) / 70)
