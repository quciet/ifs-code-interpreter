                IntkRateMale = EDSECUPPRTRAN(R%%, 1) * seclowrstudents(CInt(edseclowrlen(R%)), R%, Male)
                IntkRateFemale = EDSECUPPRTRAN(R%%, 2) * seclowrstudents(CInt(edseclowrlen(R%)), R%, Female)
    
