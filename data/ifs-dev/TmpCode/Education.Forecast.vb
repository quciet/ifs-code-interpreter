                    If context.HistoricMode Then
                        Call XYTABL("GDP/Capita (PPP) Versus Primary Expenditures Per Student as % of GDPPC (1970)",
                            sGDPPCP(R%), edexperstudcomp, context)
                    Else
                        'jrs 2024/07/23 added log to the name
                        'Call XYTABL("GDP/Capita (PPP) Versus Primary Expenditures Per Student as % of GDPPC (MostRecent) Log",
                        'sGDPPCP(R%), edexperstudcomp, context)
                        Call XYTABL(TFNamePriExpPerStuPctGDP, sGDPPCP(R%), edexperstudcomp, context)
                    End If
    
                    'mti 2018/06/18 Start
                    'edexperstudcomp = AMAX(1, edexperstudcomp)
    
    
                    'If frm_MainMenu.IFsGUIctrl1.cHistoricBase = True Then
                    '   SpendingContrib = 0  '0 for now
                    'Else
                    'SpendingContrib = (sEDEXPERPRI(R%) - edexperstudcomp) * edqualprispndimp  'spndedqualpri
                    'SpendingContrib = Amin(10, AMAX(-10, SpendingContrib))  'maximum possible shift is 1 standard deviation
                    'End If
    
                    'CalcScore = CalcScore + SpendingContrib
                    '------------------------------------
                    'mti 2018/06/05 End
    
                    'mti 2018/06/18 Start
                    edexperstudcomp = AMAX(1, edexperstudcomp)
    
                    If edexpperPriShift(R%) > 0 Then 'cuba
                        edexperstudcomp = edexperstudcomp + ConvergeOverTime(edexpperPriShift(R%), 0, 40) '40 'let the expected slide faster, to save quality from getting hurt
                        'base value for the convergence times for upper/lower sec per stud exp functions are 50 years
                    Else
                        edexperstudcomp = edexperstudcomp + ConvergeOverTime(edexpperPriShift(R%), 0, 50)
                        'base value for the convergence times for upper/lower sec per stud exp functions are 50 years
                    End If
    
    
                    'level effect
                    'mti 2018/07/02 start
                    Dim Spndelta = AMAX(-20, Amin(20, sEDEXPERPRI(R%) - edexperstudcomp))
    
                    Dim lvleff = 0!
                    If edqualprispndimpthreshold > 0 Then
                        lvleff = CSng(edqualprispndimpthreshold * Log(Log(Amin(20, AMAX(3, (edqualprispndimpthresholdval - sEDEXPERPRI(R%))))))) '25
                    Else
                        lvleff = 1
                    End If
                    Dim corrupteff = 0!
                    If edqualprispndimpgov > 0 Then
                        corrupteff = CSng(edqualprispndimpgov * Log(AMAX(1.01, sgovcorrupt(R%))) / Log(10)) '10 base log
                    Else
                        corrupteff = 1
                    End If
    
                    'If frm_MainMenu.IFsGUIctrl1.cHistoricBase = True Then
                    '   SpendingContrib = 0  '0 for now
                    'Else
    
                    'SpendingContrib = (sEDEXPERSEC(R%) - edexperstudcomp) * edqualsecspndimp 'spndedqualsec
    
                    'diminishing impact
                    '         If edqualprispndimpdim > 0 Then
                    '            Spndelta = edqualprispndimpdim * AMAX(-20, Amin(20, sEDEXPERPRI(R%) - edexperstudcomp))
                    '         Else
                    '            Spndelta = 1
                    '         End If
                    '         Spndelta = Spndelta * (3 - Log(Abs(Spndelta))) * 0.333
    
                    'mti 2018/07/23 Start
                    'mti 2018/07/02 Start
                    Dim SpendingContrib = 0!
                    If Spndelta > 0 Then
                        SpendingContrib = corrupteff * lvleff * Spndelta * edqualprispndimp
                    Else
                        SpendingContrib = lvleff * Spndelta * edqualprispndimp
                    End If
                    'mti 2018/07/02 End
                    'mti 2018/07/02 End
                    'mti 2018/07/23 End
    
                    If IY = 2 Then
                        sSpendingContribPri(R%) = 0
                    End If
    
                    'mov av; delay
                    SpendingContrib = 0.9! * sSpendingContribPri(R%) + 0.1! * SpendingContrib
    
                    '         If SpendingContrib > 10 Then Stop
    
                    SpendingContrib = Amin(10, AMAX(-10, SpendingContrib))  'maximum possible shift is 1 standard deviation
                    'End If
                    'CalcScore = CalcScore + SpendingContrib
