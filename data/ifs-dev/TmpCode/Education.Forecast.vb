                    End If
    
                    EDQUALPRIALL(R%, 3) = AMAX(1, Amin(100, EDQUALPRIALL(R%, 3) + SpendingContrib))
                    sSpendingContribPri(R%) = SpendingContrib
    
                    EDQUALPRIALL(R%, 3) = EDQUALPRIALL(R%, 3) + AMAX(-5, Amin(5, EdQualSecurImpact(R%, 1)))
                    'mti 2018/06/18 End
    
    
                    EDQUALPRIREAD(R%, 3) = EDQUALPRIALL(R%, 3) + EdQualPriReadShift2Tot(R%, 3)
                    EDQUALPRISCI(R%, 3) = EDQUALPRIALL(R%, 3) + EdQualPriSciShift2Tot(R%, 3)
                    EDQUALPRIMATH(R%, 3) = EDQUALPRIALL(R%, 3) + EdQualPriMathShift2Tot(R%, 3)
    
    
    
                    '--- Gender Ratio  Primary ---
                    Dim CalcRatio = 0!, CalcRatioCur = 0!
                    'jrs 2024/07/04 Call XYTABL("GDP/Capita (PPP 2011) Versus Gender Ratio in Primary Reading Scores (Log)",
                    'GDPPCP(R%), CalcRatio, context)
                    Call XYTABL(TFNameGenderRatioPriReading, GDPPCP(R%), CalcRatio, context)
                    If EdQualPriReadGRShift(R%) <= 0 Then
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualPriReadGRShift(R%), 0, 50))))
                    Else
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualPriReadGRShift(R%), 0, 300))))
                    End If
                    EDQUALPRIREAD(R%, 1) = 2 * EDQUALPRIREAD(R%, 3) / (1 + CalcRatioCur)
                    EDQUALPRIREAD(R%, 2) = EDQUALPRIREAD(R%, 1) * CalcRatioCur
    
    
                    'jrs 2024/07/04 Call XYTABL("GDP/Capita (PPP 2011) Versus Gender Ratio in Primary Science Scores (Log)",
                    'GDPPCP(R%), CalcRatio, context)
                    Call XYTABL(TFNameGenderRatioPriSci, GDPPCP(R%), CalcRatio, context)
                    If EdQualPriSciGRShift(R%) <= 0 Then
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualPriSciGRShift(R%), 0, 50))))
                    Else
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualPriSciGRShift(R%), 0, 300))))
                    End If
                    EDQUALPRISCI(R%, 1) = 2 * EDQUALPRISCI(R%, 3) / (1 + CalcRatioCur)
                    EDQUALPRISCI(R%, 2) = EDQUALPRISCI(R%, 1) * CalcRatioCur
    
    
                    'jrs 2024/07/05 Call XYTABL("GDP/Capita (PPP 2011) Versus Gender Ratio in Primary Math Scores (Log)",
                    'GDPPCP(R%), CalcRatio, context)
                    Call XYTABL(TFNameGenderRatioPriMath, GDPPCP(R%), CalcRatio, context)
                    If EdQualPriMathGRShift(R%) <= 0 Then
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualPriMathGRShift(R%), 0, 50))))
                    Else
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualPriMathGRShift(R%), 0, 300))))
                    End If
                    EDQUALPRIMATH(R%, 1) = 2 * EDQUALPRIMATH(R%, 3) / (1 + CalcRatioCur)
                    EDQUALPRIMATH(R%, 2) = EDQUALPRIMATH(R%, 1) * CalcRatioCur
    
                    'mti 2018/06/18 Start
                    'Primary all by gender
                    '         For gndr = 1 To 2  'male and female from subjectsPRIREAD(R%, gndr) + EDQUALPRIMATH(R%, gndr)) / 3
                    '           EDQUALPRIALL(R%, gndr) = (EDQUALPRISCI(R%, gndr) + EDQUALPRIREAD(R%, gndr) + EDQUALPRIMATH(R%, gndr)) / 3
                    '         Next gndr
    
    
                    'Primary Score, Multipliers
    
    
                    If edqualpriallm(R%, 3) <> 1 Then
                        edqualpriallm(R%, 1) = edqualpriallm(R%, 3)
                        edqualpriallm(R%, 2) = edqualpriallm(R%, 3)
                    End If
                    For gndr% = 1 To NGender
                        If edqualpriallm(R%, gndr%) <> 1 Then
                            edqualprimathm(R%, gndr%) = edqualpriallm(R%, gndr%)
                            edqualprireadm(R%, gndr%) = edqualpriallm(R%, gndr%)
                            edqualpriscim(R%, gndr%) = edqualpriallm(R%, gndr%)
                        End If
                    Next gndr
                    If edqualprimathm(R%, 3) <> 1 Then
                        edqualprimathm(R%, 1) = edqualprimathm(R%, 3)
                        edqualprimathm(R%, 2) = edqualprimathm(R%, 3)
                    ElseIf edqualprimathm(R%, 1) <> 1 Or edqualprimathm(R%, 2) <> 1 Then 'jrs 2024/06/27
                        edqualprimathm(R%, 3) = edqualprimathm(R%, 1) * EDQUALPRIMATH(R%, 1) / (EDQUALPRIMATH(R%, 1) + EDQUALPRIMATH(R%, 2)) +
                            edqualprimathm(R%, 2) * EDQUALPRIMATH(R%, 2) / (EDQUALPRIMATH(R%, 1) + EDQUALPRIMATH(R%, 2))
                    End If
                    If edqualprireadm(R%, 3) <> 1 Then
                        edqualprireadm(R%, 1) = edqualprireadm(R%, 3)
                        edqualprireadm(R%, 2) = edqualprireadm(R%, 3)
                    ElseIf edqualprireadm(R%, 1) <> 1 Or edqualprireadm(R%, 2) <> 1 Then 'jrs 2024/06/27
                        edqualprireadm(R%, 3) = edqualprireadm(R%, 1) * EDQUALPRIREAD(R%, 1) / (EDQUALPRIREAD(R%, 1) + EDQUALPRIREAD(R%, 2)) +
                            edqualprireadm(R%, 2) * EDQUALPRIREAD(R%, 2) / (EDQUALPRIREAD(R%, 1) + EDQUALPRIREAD(R%, 2))
                    End If
                    If edqualpriscim(R%, 3) <> 1 Then
                        edqualpriscim(R%, 1) = edqualpriscim(R%, 3)
                        edqualpriscim(R%, 2) = edqualpriscim(R%, 3)
                    ElseIf edqualpriscim(R%, 1) <> 1 Or edqualpriscim(R%, 2) <> 1 Then 'jrs 2024/06/27
                        edqualpriscim(R%, 3) = edqualpriscim(R%, 1) * EDQUALPRISCI(R%, 1) / (EDQUALPRISCI(R%, 1) + EDQUALPRISCI(R%, 2)) +
                            edqualpriscim(R%, 2) * EDQUALPRISCI(R%, 2) / (EDQUALPRISCI(R%, 1) + EDQUALPRISCI(R%, 2))
                    End If
    
                    For gndr% = 1 To 3
    
                        '            EDQUALPRIMATH(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRIMATH(R%, gndr%) * edqualpriallm(R%, gndr%)))
                        '            EDQUALPRISCI(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRISCI(R%, gndr%) * edqualpriallm(R%, gndr%)))
                        '            EDQUALPRIREAD(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRIREAD(R%, gndr%) * edqualpriallm(R%, gndr%)))
                        '            EDQUALPRIALL(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRIALL(R%, gndr%) * edqualpriallm(R%, gndr%))
    
                        EDQUALPRIMATH(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRIMATH(R%, gndr%) * edqualprimathm(R%, gndr%)))
                        EDQUALPRISCI(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRISCI(R%, gndr%) * edqualpriscim(R%, gndr%)))
                        EDQUALPRIREAD(R%, gndr%) = AMAX(1, Amin(100, EDQUALPRIREAD(R%, gndr%) * edqualprireadm(R%, gndr%)))
    
                        EDQUALPRIALL(R%, gndr%) = AMAX(1, Amin(100, (EDQUALPRIMATH(R%, gndr%) + EDQUALPRISCI(R%, gndr%) + EDQUALPRIREAD(R%, gndr%)) / 3))
                    Next gndr%
                    'mti 2018/06/18 End
    
                    'jrs 2024/06/27
                    'Mohammod suggested the following, but Population variables are not filled at this point, so
                    'I stayed with my fix that computes the total multiplier with a weighted average using the original variable
                    ''Same problem for Secondary:
                    'EDQUALPRIMATH(R%, 3) = AMAX(1, Amin(100, (EDQUALPRIMATH(R%, Male) * POPEDPRI(R%, Male) + EDQUALPRIMATH(R%, Female) * POPEDPRI(R%, Female)) / AMAX(0.00001, POPEDPRI(R%, Total))))
                    'EDQUALPRISCI(R%, 3) = AMAX(1, Amin(100, (EDQUALPRISCI(R%, Male) * POPEDPRI(R%, Male) + EDQUALPRISCI(R%, Female) * POPEDPRI(R%, Female)) / AMAX(0.00001, POPEDPRI(R%, Total))))
                    'EDQUALPRIREAD(R%, 3) = AMAX(1, Amin(100, (EDQUALPRIREAD(R%, Male) * POPEDPRI(R%, Male) + EDQUALPRIREAD(R%, Female) * POPEDPRI(R%, Female)) / AMAX(0.00001, POPEDPRI(R%, Total))))
                    'EDQUALPRIALL(R%, 3) = AMAX(1, Amin(100, (EDQUALPRIALL(R%, Male) * POPEDPRI(R%, Male) + EDQUALPRIALL(R%, Female) * POPEDPRI(R%, Female)) / AMAX(0.00001, POPEDPRI(R%, Total))))
    
    
                    'Secondary
                    'If GRPS(1,R%) = "Angola" Then Stop
    
                    'mti 2018/06/05 Start
                    'Call AnalFunc("Educ Qual Sec All, Total, WBGA 2010 (Lin) vs GDPPCPLN, Edyear25 and SecExpPer", _
                    'Array(EDEXPERSEC(R%), EDYRSAG25(R%, 3), GDPPCP(R%)), CalcScore, _
                    'Array("EdExpSecPerStud%GDPPC (Linear)", "EdYearsAge25 (Linear)", "GDPPCP (Log)"))
                    Call XYTABL(TbName2$, SEDYRSAG25(R%, 3), CalcScore, context)
    
                    '--------------------------------
                    If context.HistoricMode Then
                        Call XYTABL("GDP/Capita (PPP) Versus Secondary Expenditures Per Student as % of GDPPC (1970)",
                            sGDPPCP(R%), edexperstudcomp, context)
                    Else
                        'jrs 2024/07/23 Call XYTABL("GDP/Capita (PPP) Versus Secondary Expenditures Per Student as % of GDPPC (MostRecent)",
                        'sGDPPCP(R%), edexperstudcomp, context)
                        Call XYTABL(TFNameSecExpPerStuPctGDP, sGDPPCP(R%), edexperstudcomp, context)
                    End If
                    'If GRPS(1,R%) = "Cuba" Then Stop
    
                    'mti 2018/06/18 Start
                    edexperstudcomp = AMAX(1, edexperstudcomp)
    
                    If EdexpperSecShift(R%) > 0 Then 'cuba
                        edexperstudcomp = edexperstudcomp + ConvergeOverTime(EdexpperSecShift(R%), 0, 40) '40 'let the expected slide faster, to save quality from getting hurt
                        'base value for the convergence times for upper/lower sec per stud exp functions are 50 years
                    Else
                        edexperstudcomp = edexperstudcomp + ConvergeOverTime(EdexpperSecShift(R%), 0, 50)
                        'base value for the convergence times for upper/lower sec per stud exp functions are 50 years
                    End If
    
                    'mti 2018/07/02 Start
                    Spndelta = AMAX(-20, Amin(20, sEDEXPERSEC(R%) - edexperstudcomp))
    
                    'level effect
                    If edqualsecspndimpthreshold > 0 Then
                        lvleff = CSng(edqualsecspndimpthreshold * Log(Log(Amin(20, AMAX(3, (edqualsecspndimpthresholdval - sEDEXPERSEC(R%))))))) '30
                    Else
                        lvleff = 1
                    End If
    
                    If edqualsecspndimpgov > 0 Then
                        corrupteff = CSng(edqualsecspndimpgov * Log(AMAX(1.01, sgovcorrupt(R%))) / Log(10)) '10 base log
                    Else
                        corrupteff = 1
                    End If
    
                    'If frm_MainMenu.IFsGUIctrl1.cHistoricBase = True Then
                    '   SpendingContrib = 0  '0 for now
                    'Else
    
                    'SpendingContrib = (sEDEXPERSEC(R%) - edexperstudcomp) * edqualsecspndimp 'spndedqualsec
    
                    'diminishing impact
                    '         If edqualsecspndimpdim > 0 Then
                    '            Spndelta = edqualsecspndimpdim * AMAX(-20, Amin(20, sEDEXPERSEC(R%) - edexperstudcomp))
                    '         Else
                    '            Spndelta = 1
                    '         End If
                    '
                    '         Spndelta = Spndelta * (3 - Log(Abs(Spndelta))) * 0.333
    
                    'mti 2018/07/23 Start
                    'mti 2018/07/02 Start
                    If Spndelta > 0 Then
                        SpendingContrib = corrupteff * lvleff * Spndelta * edqualsecspndimp
                    Else
                        SpendingContrib = lvleff * Spndelta * edqualsecspndimp
                    End If
                    'mti 2018/07/02 End
                    'mti 2018/07/23 End
    
    
    
                    If IY = 2 Then
                        sSpendingContribSec(R%) = 0
                    End If
    
                    'mov av; delay
                    SpendingContrib = 0.9! * sSpendingContribSec(R%) + 0.1! * SpendingContrib
    
                    '         If SpendingContrib > 10 Then Stop
    
                    SpendingContrib = Amin(10, AMAX(-10, SpendingContrib))  'maximum possible shift is 1 standard deviation
                    'End If
                    'CalcScore = CalcScore + SpendingContrib
                    '------------------------------------
                    'mti 2018/06/05 End
                    '     If GRPS(1,R%) = "Singapore" Then Stop
                    '     If GRPS(1,R%) = "Hong Kong" Then Stop
    
                    'If EdQualSecAllShift(R%, 3) >= 0 Then
                    If EdQualSecAllShift(R%, 3) <= 0 Then
                        EDQUALSECALL(R%, 3) = AMAX(0, Amin(100, CalcScore + ConvergeOverTime(EdQualSecAllShift(R%, 3), 0, 50)))
                    Else
                        EDQUALSECALL(R%, 3) = AMAX(0, Amin(100, CalcScore + ConvergeOverTime(EdQualSecAllShift(R%, 3), 0, 85)))  '300
                    End If
    
                    EDQUALSECALL(R%, 3) = AMAX(1, Amin(100, EDQUALSECALL(R%, 3) + SpendingContrib))
                    sSpendingContribSec(R%) = SpendingContrib
                    'mti 2018/06/05 End
    
                    EDQUALSECALL(R%, 3) = EDQUALSECALL(R%, 3) + AMAX(-5, Amin(5, EdQualSecurImpact(R%, 2)))
                    'mti 2018/06/18 End
    
                    EDQUALSECREAD(R%, 3) = EDQUALSECALL(R%, 3) + EdQualSecReadShift2Tot(R%, 3)
                    EDQUALSECSCI(R%, 3) = EDQUALSECALL(R%, 3) + EdQualSecSciShift2Tot(R%, 3)
                    EDQUALSECMATH(R%, 3) = EDQUALSECALL(R%, 3) + EdQualSecMathShift2Tot(R%, 3)
    
    
                    '--- Gender Ratio  Secondary ---
                    'jrs 2024/07/05 Call XYTABL("GDP/Capita (PPP 2011) Versus Gender Ratio in Secondary Reading Scores (Log)",
                    'GDPPCP(R%), CalcRatio, context)
                    Call XYTABL(TFNameGenderRatioSecReading, GDPPCP(R%), CalcRatio, context)
                    If EdQualSecReadGRShift(R%) <= 0 Then
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualSecReadGRShift(R%), 0, 50))))
                    Else
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualSecReadGRShift(R%), 0, 300))))
                    End If
                    EDQUALSECREAD(R%, 1) = 2 * EDQUALSECREAD(R%, 3) / (1 + CalcRatioCur)
                    EDQUALSECREAD(R%, 2) = EDQUALSECREAD(R%, 1) * CalcRatioCur
    
    
                    'jrs 2024/07/05 Call XYTABL("GDP/Capita (PPP 2011) Versus Gender Ratio in Secondary Science Scores (Log)",
                    'GDPPCP(R%), CalcRatio, context)
                    Call XYTABL(TFNameGenderRatioSecSci, GDPPCP(R%), CalcRatio, context)
                    If EdQualSecSciGRShift(R%) <= 0 Then
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualSecSciGRShift(R%), 0, 50))))
                    Else
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualSecSciGRShift(R%), 0, 300))))
                    End If
                    EDQUALSECSCI(R%, 1) = 2 * EDQUALSECSCI(R%, 3) / (1 + CalcRatioCur)
                    EDQUALSECSCI(R%, 2) = EDQUALSECSCI(R%, 1) * CalcRatioCur
    
    
                    'jrs 2024/07/05 Call XYTABL("GDP/Capita (PPP 2011) Versus Gender Ratio in Secondary Math Scores (Log)",
                    'GDPPCP(R%), CalcRatio, context)
                    Call XYTABL(TFNameGenderRatioSecMath, GDPPCP(R%), CalcRatio, context)
                    If EdQualSecMathGRShift(R%) <= 0 Then
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualSecMathGRShift(R%), 0, 50))))
                    Else
                        CalcRatioCur = CSng(AMAX(0.5, Amin(1.5, CalcRatio + ConvergeOverTime(EdQualSecMathGRShift(R%), 0, 300))))
                    End If
                    EDQUALSECMATH(R%, 1) = 2 * EDQUALSECMATH(R%, 3) / (1 + CalcRatioCur)
                    EDQUALSECMATH(R%, 2) = EDQUALSECMATH(R%, 1) * CalcRatioCur
    
    
                    'mti 2018/06/18 Start
                    '         For gndr = 1 To 2  'male and female from subjectsPRIREAD(R%, gndr) + EDQUALPRIMATH(R%, gndr)) / 3
                    '           EDQUALSECALL(R%, gndr) = (EDQUALSECSCI(R%, gndr) + EDQUALSECREAD(R%, gndr) + EDQUALSECMATH(R%, gndr)) / 3
                    '         Next gndr
    
    
                    If edqualsecallm(R%, 3) <> 1 Then
                        edqualsecallm(R%, 1) = edqualsecallm(R%, 3)
                        edqualsecallm(R%, 2) = edqualsecallm(R%, 3)
                    End If
                    For gndr% = 1 To NGender
                        If edqualsecallm(R%, gndr%) <> 1 Then
                            edqualsecmathm(R%, gndr%) = edqualsecallm(R%, gndr%)
                            edqualsecreadm(R%, gndr%) = edqualsecallm(R%, gndr%)
                            edqualsecscim(R%, gndr%) = edqualsecallm(R%, gndr%)
                        End If
                    Next gndr
                    If edqualsecmathm(R%, 3) <> 1 Then
                        edqualsecmathm(R%, 1) = edqualsecmathm(R%, 3)
                        edqualsecmathm(R%, 2) = edqualsecmathm(R%, 3)
                    ElseIf edqualsecmathm(R%, 1) <> 1 Or edqualsecmathm(R%, 2) <> 1 Then 'jrs 2024/06/27
                        edqualsecmathm(R%, 3) = edqualsecmathm(R%, 1) * EDQUALSECMATH(R%, 1) / (EDQUALSECMATH(R%, 1) + EDQUALSECMATH(R%, 2)) +
                            edqualsecmathm(R%, 2) * EDQUALSECMATH(R%, 2) / (EDQUALSECMATH(R%, 1) + EDQUALSECMATH(R%, 2))
                    End If
                    If edqualsecreadm(R%, 3) <> 1 Then
                        edqualsecreadm(R%, 1) = edqualsecreadm(R%, 3)
                        edqualsecreadm(R%, 2) = edqualsecreadm(R%, 3)
                    ElseIf edqualsecreadm(R%, 1) <> 1 Or edqualsecreadm(R%, 2) <> 1 Then 'jrs 2024/06/27
                        edqualsecreadm(R%, 3) = edqualsecreadm(R%, 1) * EDQUALSECREAD(R%, 1) / (EDQUALSECREAD(R%, 1) + EDQUALSECREAD(R%, 2)) +
                            edqualsecreadm(R%, 2) * EDQUALSECREAD(R%, 2) / (EDQUALSECREAD(R%, 1) + EDQUALSECREAD(R%, 2))
                    End If
                    If edqualsecscim(R%, 3) <> 1 Then
                        edqualsecscim(R%, 1) = edqualsecscim(R%, 3)
                        edqualsecscim(R%, 2) = edqualsecscim(R%, 3)
                    ElseIf edqualsecscim(R%, 1) <> 1 Or edqualsecscim(R%, 2) <> 1 Then 'jrs 2024/06/27
                        edqualsecscim(R%, 3) = edqualsecscim(R%, 1) * EDQUALSECSCI(R%, 1) / (EDQUALSECSCI(R%, 1) + EDQUALSECSCI(R%, 2)) +
                            edqualsecscim(R%, 2) * EDQUALSECSCI(R%, 2) / (EDQUALSECSCI(R%, 1) + EDQUALSECSCI(R%, 2))
                    End If
    
    
                    For gndr% = 1 To 3
    
                        '            EDQUALsecMATH(R%, gndr%) = AMAX(1, Amin(100, EDQUALsecMATH(R%, gndr%) * edqualsecallm(R%, gndr%)))
                        '            EDQUALsecSCI(R%, gndr%) = AMAX(1, Amin(100, EDQUALsecSCI(R%, gndr%) * edqualsecallm(R%, gndr%)))
                        '            EDQUALsecREAD(R%, gndr%) = AMAX(1, Amin(100, EDQUALsecREAD(R%, gndr%) * edqualsecallm(R%, gndr%)))
                        '            EDQUALsecALL(R%, gndr%) = AMAX(1, Amin(100, EDQUALsecALL(R%, gndr%) * edqualsecallm(R%, gndr%))
    
                        EDQUALSECMATH(R%, gndr%) = AMAX(1, Amin(100, EDQUALSECMATH(R%, gndr%) * edqualsecmathm(R%, gndr%)))
                        EDQUALSECSCI(R%, gndr%) = AMAX(1, Amin(100, EDQUALSECSCI(R%, gndr%) * edqualsecscim(R%, gndr%)))
                        EDQUALSECREAD(R%, gndr%) = AMAX(1, Amin(100, EDQUALSECREAD(R%, gndr%) * edqualsecreadm(R%, gndr%)))
    
                        EDQUALSECALL(R%, gndr%) = AMAX(1, Amin(100, (EDQUALSECMATH(R%, gndr%) + EDQUALSECSCI(R%, gndr%) + EDQUALSECREAD(R%, gndr%)) / 3))
                    Next gndr%
                    'mti 2018/06/18 End
    
    
                    'adults
                    If edqualag15m(R%, Total) <> 1 Then
                        For gndr = 1 To 2
                            edqualag15m(R%, gndr) = edqualag15m(R%, Total)
                        Next gndr
                    End If
    
                    For gndr = 1 To 2
                        EdQualPriAgeDst(4, R%, gndr%) = CSng(EdQualPriAgeDst(4, R%, gndr%) * 0.8 + EDQUALPRIALL(R%, gndr) * 0.2)
                        EdQualSecAgeDst(4, R%, gndr%) = CSng(EdQualSecAgeDst(4, R%, gndr%) * 0.8 + EDQUALSECALL(R%, gndr) * 0.2)
                        For j% = NCohorts To 5 Step -1
                            EdQualPriAgeDst(j, R%, gndr%) = CSng(EdQualPriAgeDst(j, R%, gndr%) * 0.8 + EdQualPriAgeDst(j - 1, R%, gndr%) * 0.2)
                            EdQualSecAgeDst(j, R%, gndr%) = CSng(EdQualSecAgeDst(j, R%, gndr%) * 0.8 + EdQualSecAgeDst(j - 1, R%, gndr%) * 0.2)
                        Next j%
                        SumScorePri = 0
                        SumScoreSec = 0
                        SumPop = 0
                        For j% = 4 To NCohorts  '4 = 15-19
                            SumPop = CSng(SumPop + agedst(j%, R%, gndr%))
                            SumScorePri = CSng(SumScorePri + EdQualPriAgeDst(j%, R%, gndr%) * agedst(j%, R%, gndr%))
                            SumScoreSec = CSng(SumScoreSec + EdQualSecAgeDst(j%, R%, gndr%) * agedst(j%, R%, gndr%))
                        Next j%
                        EDQUALAG15PRI(R%, gndr%) = SumScorePri / SumPop  'multiplier not applied, so that we can see the base behavior through these two
                        EDQUALAG15SEC(R%, gndr%) = SumScoreSec / SumPop 'multiplier not applied, so that we can see the base behavior through these two
    
                        EDQUALAG15(R%, gndr%) = AMAX(1, Amin(100, ((EDQUALAG15PRI(R%, gndr%) + EDQUALAG15SEC(R%, gndr%)) / 2) * edqualag15m(R%, gndr)))
    
                        If gndr = 1 Then
                            SumPopMale = SumPop
                        Else
                            SumPopFemale = SumPop
                        End If
                    Next gndr
    
                    EDQUALAG15PRI(R%, Total) = (EDQUALAG15PRI(R%, 1) * SumPopMale + EDQUALAG15PRI(R%, 2) * SumPopFemale) / (SumPopMale + SumPopFemale)
                    EDQUALAG15SEC(R%, Total) = (EDQUALAG15SEC(R%, 1) * SumPopMale + EDQUALAG15SEC(R%, 2) * SumPopFemale) / (SumPopMale + SumPopFemale)
                    EDQUALAG15(R%, Total) = AMAX(1, Amin(100, ((EDQUALAG15PRI(R%, Total) + EDQUALAG15SEC(R%, Total)) / 2) * edqualag15m(R%, gndr)))
    
                    'mti 2018/01/18 end
    
    
    
    
                Next R%
    
    
                sErrorSub = PrevsErrorSub
' End Sub
    ' ---- End Inlined Level 2: IFsEduc1AllYears:IFsEducQual1AllButFirstYear
            End If
            'mti 2018/01/18 End

            'mti 2016/03/30
            'Write pop mdb - needed to create education pyramids
WritetoPOPDB(context)
    ' ---- Begin Inlined Level 2: IFsEduc1AllYears:WritetoPOPDB
' Private Sub WritetoPOPDB(context As IForecastContext) 'EdPriPopPer(), EdUpprSecPopPer(), EdTerPopPer(), EdYears())
                ' Education Module
                ' All Years: Save population with specific level of education to Database for Education Cohorts
                '=========================================================================================================
                ''mti 2016/03/30 - whole procedure
                'jrs 2024/01/24
                If MultiThreading Then
                    ifs_buffer.Post(Sub() ifsPopWorkDB.BulkInsertEdGrads(EdPriPopPer, EdUpprSecPopPer, EdTerPopPer, agedst, NCohorts, NR, IY + FirstYear - 1))
                    ifs_buffer.Post(Sub() ifsPopWorkDB.BulkInsertEdYrs15(EdYears, NCohorts, NR, IY + FirstYear - 1))
                    'mti 2024/03/25 start
                    ifs_buffer.Post(Sub() ifsPopWorkDB.BulkInsertEdYrs25(EdYears25, NCohorts, NR, IY + FirstYear - 1))
                    'mti 2024/03/25 end
                Else
                    ifsPopWorkDB.BulkInsertEdGrads(EdPriPopPer, EdUpprSecPopPer, EdTerPopPer, agedst, NCohorts, NR, IY + FirstYear - 1)
                    ifsPopWorkDB.BulkInsertEdYrs15(EdYears, NCohorts, NR, IY + FirstYear - 1)
                    'mti 2024/03/25 start
                    ifsPopWorkDB.BulkInsertEdYrs25(EdYears, NCohorts, NR, IY + FirstYear - 1)
                    'mti 2024/03/25 end
                End If
                'For tempi% = 1 To NCohorts
                '    For R% = 1 To NR%
                '        ifsPopWorkDB.Add(New EdnGradsBaseCase() With {
                '            .TimeId = CShort(IY% + FirstYear - 1),
                '            .RegionId = CShort(R%),
                '            .CohortId = CShort(tempi%),
