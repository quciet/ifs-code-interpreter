            '            EDEXPERTER(R%%) = Round(terperstdntDollar / GDPPC(R%%) / 10, 4)
            '
            '            expendsec = expendseclowr + expendsecuppr
            '            EDEXPERSEC(R%%) = Round(100 * expendsec / (EDSECTOT(R%%, 1) + EDSECTOT(R%%, 2)) / GDPPC(R%%), 4)
            '
            '            calctotcost = expendpri + expendsec + expendter
            '
            '            calctotcost = calctotcost * convtoexchange1
            '
            '        End If
            'mti 2016/01/07 - end
