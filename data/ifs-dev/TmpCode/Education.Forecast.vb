                    'mti 2016/12/09 end ConvergeOverTimeSmooth


                    'All years but first Primary Pre-Budget: Systemic Shift in Net Intake Rate
                    Dim EdAddSecLowrTemporalShift = True
                    Dim CalEDSecLowrTran2 = 0!
                    Dim CalEDSecLowrTran3 = 0!
                    Dim ss_denom = 0!
                    If EdAddSecLowrTemporalShift Then
                        If Not context.HistoricMode Then
                            'using total: as there is a non-uniform temporal shift in male and female (more for female)
