                    CompAdultEdPriCompletionPop = CSng(CompAdultEdPriCompletionPop) + CSng(EdPriPopPer(j%, R%%, gndr%) * agedst(j%, R%%, gndr%))
                    totalAdultpop = CSng(totalAdultpop) + CSng(agedst(j%, R%%, gndr%))
