            ' ---- Begin Inlined Level 3: IFsEducSec_new_init:AfterSecBudgetImpact_new_init:GradeWiseEnrollmentCalc
    ' Private Sub GradeWiseEnrollmentCalc(R%, gndr%, startcycle As Single, lencycle As Single, Intake As Single, Survival As Single, ByRef GradeStudents As Single(,,),
    ' ByRef SaveGradeStudents As Single(,,,), SGS3rdIndex%, ByRef TotStudents As Single, Optional Dropoutrate As Single = 9999, Optional SaveGradeEnrRate As Boolean = False, Optional level As String = "All")
                        'mti 2022/03/16 take proc
                        'mti 2016/03/30 - take procedure
                        'mti Education secondary lower and upper October 2007 - new proc
            
                        Dim dropoutgr(10) As Single
                        If Dropoutrate = 9999 Then
                            If edsecupprlen(R%) = 1 Then
                                Dropoutrate = 0
                            Else
                                Dropoutrate = CSng(AMAX(0, 1 - ((0 / 100) ^ (1 / (edsecupprlen(R%) - 1)))))
                            End If
                        ElseIf Dropoutrate = 8888 Then 'spread dropout
            Call DropoutSpread(edsecupprlen(R%), 0, dropoutgr)
                        ' ---- Begin Inlined Level 4: IFsEducSec_new_init:AfterSecBudgetImpact_new_init:GradeWiseEnrollmentCalc:DropoutSpread
            ' Private Sub DropoutSpread(edsecupprlen(R%) As Single, 0 As Single, ByRef Arr_Dropout() As Single)
                                    '-----------------------------------------------------------------------------------
                                    ' Education Module - Calculates a seperate dropout rate for each grade
                                    ' Assumes dropout in the first grade is twice the average dropout rate; all other grades average out the rest of the dropout
                                    Dim Dropoutrate, G2Enr As Single
                                    Dropoutrate = CSng(AMAX(0, 1 - ((0 / 100) ^ (1 / (edsecupprlen(R%) - 1)))))
                        
                                    'mti April 05, 2012 -start
                                    dropoutgr(1) = Dropoutrate
                        
                        
                                    'mti 2017/01/24 start
                                    If 0 < 100 Then  'was 90
                                        'mti 2017/01/24 end
                        
                        
                        
                                        'If dropoutrate < 0.4 And GDPPCP(R%%) < 4 Then
                                        dropoutgr(1) = CSng(Amin(0.5, Dropoutrate * 2))
                        
                        
                        
                                        G2Enr = 1 - dropoutgr(1)
                                        Dropoutrate = CSng(AMAX(0, 1 - ((0 / G2Enr / 100) ^ (1 / (edsecupprlen(R%) - 2))))) 'dropout rate for gender
                                        'End If
                        
                        
                                        For GCount% = 2 To CInt(edsecupprlen(R%))
                                            dropoutgr(GCount%) = Dropoutrate
                                        Next GCount%
                        
                                    Else
                                        For GCount% = 2 To CInt(edsecupprlen(R%))
                                            dropoutgr(GCount%) = Dropoutrate
                                        Next GCount%
                                    End If
                                    'mti April 05, 2012 -end
                        
            ' End Sub
                        ' ---- End Inlined Level 4: IFsEducSec_new_init:AfterSecBudgetImpact_new_init:GradeWiseEnrollmentCalc:DropoutSpread
                        End If
            
            
                        EDSECUPPRTOT(R%, gndr) = 0
                        If SaveGradeEnrRate Then
                            SaveSecLowUpStudentCohorts(R%%, 1, gndr%, 2%) = secupprstudents(1, R%%, gndr%)
                        End If
            
            
                        'gradewise enrolment rates and total enrolment
                        For GCount% = CInt(edsecupprlen(R%)) To 2 Step -1
                            If SaveGradeEnrRate Then
                                'save last year's grade enrollment rates for later use
                                SaveSecLowUpStudentCohorts(R%%, GCount%, gndr%, 2%) = secupprstudents(GCount%, R%%, gndr%)
            
                                'apply dropout to last year's grade enrollment rates - saved last year
                                If Dropoutrate = 8888 Then 'dropout by grade
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - dropoutgr(GCount% - 1))
                                Else 'single average dropout rate
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount% - 1, R%%, gndr%) * (1 - Dropoutrate)
                                End If
                            Else
                                'apply dropout to last year's grade enrollment rates,
                                'saved in a separate array during initial calculation of grade enrollment rates this year
                                If Dropoutrate = 8888 Then 'dropout by grade
                                    secupprstudents(GCount%, R%%, gndr%) = SaveSecLowUpStudentCohorts(R%%, GCount% - 1, gndr%, 2%) * (1 - dropoutgr(GCount% - 1))
                                Else
                                    secupprstudents(GCount%, R%%, gndr%) = SaveSecLowUpStudentCohorts(R%%, GCount% - 1, gndr%, 2%) * (1 - Dropoutrate)
                                End If
                            End If
            
                            secupprstudents(GCount%, R%%, gndr%) = AMAX(0.5, secupprstudents(GCount%, R%%, gndr%))
                            'students carried forward to the subsequent grades - using gradewise array saved before budget intervention
            
            
                            'mti 2022/03/16 start   'added to bring in students in upper grades; when transition rate multipliers are greater than 1; capped at 2
                            Select Case level
                                Case "Pri"  'Lower sec
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount%, R%%, gndr%) * Amin(2, AMAX(1, If(edpriintnm(R%%, NGender) <> 1, edpriintnm(R%%, NGender), edpriintnm(R%%, gndr))))
                                Case "SecLowr"  'Lower sec
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount%, R%%, gndr%) * Amin(2, AMAX(1, If(edseclowrtranm(R%%, NGender) <> 1, edseclowrtranm(R%%, NGender), edseclowrtranm(R%%, gndr))))
                                Case "SecUppr"  'Upper sec
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount%, R%%, gndr%) * Amin(2, AMAX(1, If(edsecupprtranm(R%%, NGender) <> 1, edsecupprtranm(R%%, NGender), edsecupprtranm(R%%, gndr))))
                                Case "Ter"  'Tertiary
                                    secupprstudents(GCount%, R%%, gndr%) = secupprstudents(GCount%, R%%, gndr%) * Amin(2, AMAX(1, If(edterintm(R%%, NGender) <> 1, edterintm(R%%, NGender), edterintm(R%%, gndr))))
                            End Select
                            'mti 2022/03/16 End
            
            
                            'Total student
                            EDSECUPPRTOT(R%, gndr) = CSng(EDSECUPPRTOT(R%, gndr) + fagedst(CInt(secStart(R%) + edseclowrlen(R%) + GCount% - 1), R%%, gndr%) *
                                        secupprstudents(GCount%, R%%, gndr%) / 100)
            
                        Next GCount%
            
                        'first graders come in with the new intake rate
                        secupprstudents(1, R%%, gndr%) = caledsecint
            
                        'add first graders to total students
                        EDSECUPPRTOT(R%, gndr) = EDSECUPPRTOT(R%, gndr) + CSng(fagedst(CInt(secStart(R%) + edseclowrlen(R%)), R%%, gndr%) * secupprstudents(1, R%%, gndr%) / 100)
    ' End Sub
            ' ---- End Inlined Level 3: IFsEducSec_new_init:AfterSecBudgetImpact_new_init:GradeWiseEnrollmentCalc
    
                    'All Years but First: Upper Secondary Final: School-age population
                    '        secupprpop(R%, gndr) = CalcPopFrom1Year(secStart(R%) + edseclowrlen(R%), edsecupprlen(R%), R%, gndr)
    
                    'All Years but First: Upper Secondary Final: gross enrollment rate, general
                    'CalEdSecUpprEnrGGen = 100 * EdSecTot_Gen / secupprpop(R%, gndr)
    
                    'mti 2014/03/27 - start - changing vocational logic from constant voc. enrollment to constant voc. share --------
    
                    'mti Jan 26, 209
