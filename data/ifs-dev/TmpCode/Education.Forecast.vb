                '    End If
    
                '    If Comp_AdultCompletionRate < AdultCompletionRate Then
                '        t_mult = CSng(t_mult - 0.00005)
                '        If t_mult < 0.00005 Then Exit For '0.0002 
                '    End If
    
                'Next
    
                'now compute and add shift factors
                'compute weighted average
                CompAdultEdPriCompletionPop = 0
                totalAdultpop = 0
    
