    ' ---- Begin Inlined Level 2: IFsEducSec_new_init:GradeSpread
' Private Sub GradeSpread(R%, gndr%, startcycle As Single, lencycle As Integer, Intake As Single, Survival As Single, Enrollment As Single, ByRef GradeStudents As Single(,,), ByRef GradeDropout As Single(,,))
                'mti 2020/09/01 New proc
                '
    
    
                'If RegName(R%%) = "Burundi" Then Stop
    
                '    SpreadStudents = True
    
                Dim pGradeStudents(10) As Single
                pGradeStudents(1) = caledseclowrint
    
                If CInt(edseclowrlen(R%)) = 2 Then
                    'Somalia ; Lower Sec
                    pGradeStudents(CInt(edseclowrlen(R%))) = AMAX(1, 2 * EDSECLOWRENRG(R%, gndr) * (1 - EDSECLOWRVOC(R%, gndr%) / 100) - pGradeStudents(1))
    
                Else
    
                    pGradeStudents(CInt(edseclowrlen(R%))) = caledseclowrint * CalEDSecLowrSur / 100
                    Dim MidEnrAvg = (EDSECLOWRENRG(R%, gndr) * (1 - EDSECLOWRVOC(R%, gndr%) / 100) * CInt(edseclowrlen(R%)) - pGradeStudents(1) - pGradeStudents(CInt(edseclowrlen(R%)))) / (CInt(edseclowrlen(R%)) - 2)
    
                    Dim MidGrade1% = CInt(edseclowrlen(R%)) \ 2 + 1
                    Dim MidGrade2% = MidGrade1
                    If CInt(edseclowrlen(R%)) Mod 2 = 0 Then  'even number of grades
                        MidGrade1 = CInt(edseclowrlen(R%)) \ 2
                        MidGrade2 = CInt(edseclowrlen(R%)) \ 2 + 1
                    End If
    
                    Dim DeltaEnr = 5
    
                    Do While True
                        If MidGrade1 <> MidGrade2 Then
                            pGradeStudents(MidGrade1) = MidEnrAvg + DeltaEnr
                            pGradeStudents(MidGrade2) = MidEnrAvg - DeltaEnr
                        Else
                            pGradeStudents(MidGrade1) = MidEnrAvg
                            pGradeStudents(MidGrade2) = pGradeStudents(MidGrade1)
                        End If
    
                        For GCount% = MidGrade1 - 1 To 2 Step -1
                            pGradeStudents(GCount%) = pGradeStudents(GCount% + 1) + DeltaEnr
                        Next
    
                        For GCount% = MidGrade2 + 1 To CInt(edseclowrlen(R%)) - 1
                            pGradeStudents(GCount%) = AMAX(0.5, pGradeStudents(GCount% - 1) - DeltaEnr)  'negatives not allowed
                        Next
                        Dim TotEnr As Single = 0
                        For GCount% = 1 To CInt(edseclowrlen(R%))
                            TotEnr = TotEnr + pGradeStudents(GCount%)
                        Next
    
                        'this should not be necessary
                        If TotEnr / CInt(edseclowrlen(R%)) > EDSECLOWRENRG(R%, gndr) * (1 - EDSECLOWRVOC(R%, gndr%) / 100) + 1 Then
                            DeltaEnr = DeltaEnr - 1
                        ElseIf TotEnr / CInt(edseclowrlen(R%)) < EDSECLOWRENRG(R%, gndr) * (1 - EDSECLOWRVOC(R%, gndr%) / 100) - 1 Then
                            DeltaEnr = DeltaEnr + 1
                        Else
                            Exit Do
                        End If
                    Loop
    
                End If
    
                For GCount% = 1 To CInt(edseclowrlen(R%)) - 1
                    EdSecLowrDropoutByGrade(GCount%, R%%, gndr%) = AMAX(-0.5, 1 - pGradeStudents(GCount% + 1) / pGradeStudents(GCount%)) 'allow more than 1?
                Next
    
                For GCount% = 1 To CInt(edseclowrlen(R%))
                    seclowrstudents(GCount%, R%%, gndr%) = pGradeStudents(GCount%)
                Next
                'If gndr = 1 Then Debug.Print Replace(RegName(R%%), ",", " "); ",";
                '    If SpreadStudents Then
                '        TotStudents = 0
                '        For GCount% = 1 To CInt(edseclowrlen(R%))
                '            seclowrstudents(GCount%, R%%, gndr%) = pGradeStudents(GCount%)
                '
                'If gndr = 1 Then Debug.Print Round(seclowrstudents(GCount%, R%%, gndr), 2); ",";
                '
                '            TotStudents = TotStudents + fagedst(edpristart(R%) + edprilen(R%) + GCount% - 1, R%%, gndr%) * seclowrstudents(GCount%, R%%, gndr%) / 100
                '        Next
                '    End If
                'If gndr = 1 Then Debug.Print
    
' End Sub
    ' ---- End Inlined Level 2: IFsEducSec_new_init:GradeSpread
                        For GCount% = 1 To CInt(edseclowrlen(R%)) '+ 1 To NPriGr
                            EDSECLOWRENRGGRD(R%, GCount%, gndr%) = seclowrstudents(GCount%, R%, gndr%)
                        Next

                    End If
                    '     If GRPS(1,R%) = "Solomon Islands" Then Stop
                    'Reconcile grade specific gross enrollment rates with Levelwide rates
                    'EDPRITOT(R%, gndr) = EDPRIENRG(R%, gndr) * POPEDPRI(R%, gndr) / 100     'mti 2021/04/27

                    'mti 2022/04/12 - start
                    EDSECLOWRTOT(R%, gndr) = EDSECLOWRENRG(R%, gndr) * POPEDSECLOWR(R%, gndr%) / 100

                    '                EdSecLowrTot_From_GradeEnr = 0
                    '                PopTot = 0
