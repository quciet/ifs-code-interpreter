                    'Security Dependence
                    '--------------------
                    'Arms % Arms Monadyc
                    '-----------------------------------------------
                    db.BulkInsertDYADINF_ARMS_PCTMONADICARMS(arms_import_stock_tot_b, CShort(FirstYear + IY - 1), NR)
                    'Arms % Mil Spending
                    '-----------------------------------------------
                    db.BulkInsertDYADINF_ARMS_PCTGDSMIL(arms_import_stock_milstock, CShort(FirstYear + IY - 1), NR)
    
                    'Political Bandwith
                    '------------------
                    'Level of representation
                    '-----------------------------------------------
                    db.BulkInsertDYADINF_LOR_AVG(lor_avg, CShort(FirstYear + IY - 1), NR)
    
                    'Economic Bandwidth
