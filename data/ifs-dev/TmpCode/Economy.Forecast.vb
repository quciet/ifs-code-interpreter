            Next R%
        End Sub
        Public Sub ifsECO3AllbutFirstYear(context As IForecastContext)
            '     All but First 3
            '     ******

            'call3:
            '   All but First 3: GDP Derivative Calculation
            '   -------------------------------------------------
            'jrs 2014/09/15
            Dim GDPRPAR As Single
            Dim LabRate As Single 'bbh 2017/10/04

            For R% = 1 To NR%
                'If RegName$(R%) = "United States Of America" Then Stop
                GDPR(R%) = 0!
                If (SGDP(R%) > 0.001) Then
                    GDPR(R%) = (GDP(R%) - SGDP(R%)) / SGDP(R%)
                End If
                SmoothGDPR(R%) = SmoothGDPR(R%) * 0.95! + GDPR(R%) * 0.05!
                'bbh 2017/10/04 begin
                LabRate = (LAB(R%) - SLab(R%)) / SLab(R%)
                SmoothLabR(R%) = SmoothLabR(R%) * 0.9! + LabRate * 0.1!
                SLab(R%) = LAB(R%)
                'bbh 2017/10/04 end
                'mti 2014/11/27 -start
                ssGDP(R%) = SGDP(R%)
                'mti 2014/11/27 -end
                'SGDP(R%) = GDP(R%) 'bbh 2022/06/23 moved to after use in IFsEcoSAM(3)

                GDPRPAR = 0!
                If (sgdprpa(R%) > 0.001) Then
                    GDPRPAR = (GDPRPA(R%) - sgdprpa(R%)) / sgdprpa(R%)
                End If
                SmoothGDPRPAR(R%) = SmoothGDPRPAR(R%) * 0.95! + GDPRPAR * 0.05!
                sgdprpa(R%) = GDPRPA(R%)
                'If RegName$(R%) = "China" Then Stop
            Next R%
        End Sub
