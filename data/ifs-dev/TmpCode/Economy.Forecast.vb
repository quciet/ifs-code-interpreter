                PovGndDiffRefAG = POVRATE420(R%, RefAGGnd, Female) - POVRATE420(R%, RefAGGnd, Male)

                'Compute percentage change in reference group gender difference
                'mti 2021/07/15 start
                If iPovGndDiffAG420(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG420(R%, RefAGGnd)) > 0.9 Then 'changed .2 to .9
                    'mti 2021/07/15 end
                    PcntChangeDiffRefAG = (PovGndDiffRefAG - iPovGndDiffAG420(R%, RefAGGnd)) / iPovGndDiffAG420(R%, RefAGGnd)
                Else
                    'use percentage point when initial difference is zero or small
                    PcntPointChangeDiffRefAG = PovGndDiffRefAG - iPovGndDiffAG420(R%, RefAGGnd)
                End If


                'Compute gender difference (and poverty rate) in other age-groups using changes in reference group gender difference
                For j% = 1 To TotPovAGCount

                    If j% <> RefAGGnd Then

                        If POVRATE420(R%, j%, Total) = 0 Then
                            POVRATE420(R%, j%, Male) = 0
                            POVRATE420(R%, j%, Female) = 0
                        Else

                            'mti 2021/07/15 start
                            If iPovGndDiffAG420(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG420(R%, RefAGGnd)) > 0.9 Then 'changed .2 to .9
                                'mti 2021/07/15 end

                                PovGndDiffAG = iPovGndDiffAG420(R%, j%) + PcntChangeDiffRefAG * iPovGndDiffAG420(R%, j%)
                            Else
                                PovGndDiffAG = iPovGndDiffAG420(R%, j%) + PcntPointChangeDiffRefAG
                            End If

                            'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                            If PovGndDiffAG >= 0 Then
                                PovGndDiffAG = CSng(Amin(PovGndDiffAG, 1.5 * POVRATE420(R%, j, Total)))
                            Else
                                PovGndDiffAG = CSng(AMAX(PovGndDiffAG, -1.5 * POVRATE420(R%, j, Total)))
                            End If

                            'mti 2020/04/29 Start
                            'POVRATE420(R%, j%, Male) = AMAX(0, (POVRATE420(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / POPPOVAG(R%, j%, Total))
                            POVRATE420(R%, j%, Male) = AMAX(0, (POVRATE420(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / AMAX(0.000001, POPPOVAG(R%, j%, Total)))
                            'mti 2020/04/29 End
                            POVRATE420(R%, j%, Female) = AMAX(0, PovGndDiffAG + POVRATE420(R%, j%, Male))
                            '
                            'Make sure there is at least some poverty in each gender
                            POVRATE420(R%, j%, Male) = AMAX(POVRATE420(R%, j%, Female) * 0.2, POVRATE420(R%, j%, Male))
                            POVRATE420(R%, j%, Female) = AMAX(POVRATE420(R%, j%, Male) * 0.2, POVRATE420(R%, j%, Female))


                        End If



                    End If

