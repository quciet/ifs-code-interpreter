                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNT685(R%%, TotPovAGCount, Male) = POVCOUNT685(R%%, TotPovAGCount, Male) + POVCOUNT685(R%%, j%, Male)
                        POVCOUNT685(R%%, TotPovAGCount, Female) = POVCOUNT685(R%%, TotPovAGCount, Female) + POVCOUNT685(R%%, j%, Female)
                    Next j%
    
    
    
                    POVRATE685(R%%, TotPovAGCount, Male) = 100 * POVCOUNT685(R%%, TotPovAGCount, Male) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Male))
                    POVRATE685(R%%, TotPovAGCount, Female) = 100 * POVCOUNT685(R%%, TotPovAGCount, Female) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Female))
                    PovGndRatioVec(R%%, TotPovAGCount) = AMAX(0.005, POVRATE685(R%%, TotPovAGCount, Female)) / AMAX(0.005, POVRATE685(R%%, TotPovAGCount, Male)) '0.001
