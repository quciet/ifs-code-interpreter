                Call XYTABL("Age Versus Differential Marginal Propensity to Consume Old",
                 (workageentry(R%) + workageretire(R%)) / 2, workercon, context)
                Call XYTABL("Age Versus Differential Marginal Propensity to Consume Old",
                 (workageretire(R%) + SLIFEXP(R%)) / 2, pensionercon, context)

                'jrs 2013/05/27 adding savings discount rate, and workageretiresv
WorkerConND = 100  + AMAX(SLIFEXP(R%), 85) + CSng(workageretiresv) + CSng(workageentry(R%)) + CSng(savingsdiscountrt(R%)) @@WorkerConND = 100 - SavingsAtWorkingAge(AMAX(SLIFEXP(R%), 85), CSng(workageretiresv), CSng(workageentry(R%)), CSng(savingsdiscountrt(R%)))@@
                CPCTND(R%) = WorkerConND

                If cpctnduse(R%) > 0 Then
                    'bbh 2014/06/18 start
                    'Find Savings needed at needed retirement age
                    'Annuity of 20 during working years PV = C * [(1-(1+i)^-n)/i]
                    SavingsNew(R%) = CSng(20 * ((1 - (1 + savingsdiscountrt(R%) / 100) ^ (workageentry(R%) - WORKAGERETIREND(R%))) /
               (savingsdiscountrt(R%) / 100)))
                    'Find current Savings
                    SavingsOld(R%) = CSng(20 * ((1 - (1 + savingsdiscountrt(R%) / 100) ^ (workageentry(R%) - workageretire(R%))) /
               (savingsdiscountrt(R%) / 100)))
                    'Find hole in $
                    SavingsNeeded(R%) = SavingsNew(R%) - SavingsOld(R%)


                    SavingsNeeded(R%) = SavingsNeeded(R%) * cpctnduse(R%) / 100
                    SavingsAdjustNeeded = SavingsNeeded(R%) / AMAX(0.0001, SavingsOld(R%)) * 100
                    workercon = workercon - Amin(15, AMAX(0, SavingsAdjustNeeded))

                    '            'jrs 2013/05/28
                    '            TotSavingsNeeded = SavingsOld(R%) + SavingsNeeded(R%) * cpctnduse(R%) / 100
                    '            'C = PV/((1-(1+i)^-n)/i)
                    '            TotSavingsNeeded = TotSavingsNeeded / _
                    '                ((1 - (1 + savingsdiscountrt(R%)) ^ (workageentry(R%) - workageretiresv)) _
                    '                / savingsdiscountrt(R%) / 100)
                    '            workercon = 100 - TotSavingsNeeded 'May replace function based computation above
                    'bbh 2014/06/18 end
                End If

                'Sub-block to adjust C based on propensity to save from functions and optional savings targeting
                youthpopshr = POPPREWORK(R%) / AMAX(0.0001, POP(R%))
                workerpopshr = POPWORKING(R%) / AMAX(0.0001, POP(R%))
                pensionerpopshr = POPRETIRED(R%) / AMAX(0.0001, POP(R%))

                youthconshr = youthpopshr * youthcon / 100
                workerconshr = workerpopshr * workercon / 100
                pensionerconshr = pensionerpopshr * pensionercon / 100

                computedcon = AMAX(0.0001, youthconshr + workerconshr + pensionerconshr) 'approximately 1
                agingadjustment = (computedcon - conpropi(R%)) * tothhinc 'ConProp is propensity for consumption
                'If RegName$(R%) = "Angola" Then Stop
                C(R%) = C(R%) + agingadjustment  'actually aging and optional savings targeting
                'bbh 2013/11/01 start
                CUpBound = ConvergeOverTime(CTotRaI(R%), 0.9, 20)
                'C(R%) = AMAX(Amin(C(R%), 0.9 * GDPRPA(R%)), 0.1 * GDPRPA(R%))
                C(R%) = AMAX(Amin(C(R%), CUpBound * GDPRPA(R%)), 0.1! * GDPRPA(R%))
                'bbh 2013/11/01 end
                'If RegName$(R%) = "Nigeria" Then Stop

                'SConProp(R%) = ComputedCon  ' Not clear if adjustment should be relative to last year; probably initial

                'Sub-block to set retiree consumption level and compute those of workers and pre-workers
                CPREWORK(R%) = youthconshr / computedcon * C(R%)
                CWORKING(R%) = workerconshr / computedcon * C(R%)

                'bbh 2020/06/13 start
                Dim PenCTarget = ConvergeOverTime(CSng(CTotRaI(R%) * GDP(R%)), CSng(0.6 * GDP(R%)), 50)
                CRETIRE(R%) = pensionerconshr / computedcon * PenCTarget
                'RETIRE(R%) = pensionerconshr / computedcon * C(R%)
                'bbh 2020/06/13 end

                HHRETIRENEED(R%) = CRETIRE(R%) * retireconsumrat 'Pensioner "fair share" is the need for consumption
                ' If RegName$(R%) = "Unitd Kingdm" Then Stop

                'Recompute CRETIRE to represent streams from capital/transfers and pensions; repesents actual consumption
                'Must adjust other consumption to that what they actually get leaves C total unchanged
                conretire = NonPenShrIncPerCapI(R%) * (GDPPC(R%) / GDPPCI(R%)) * POPRETIRED(R%) + GOVHHPENT(R%)
                CRETIRE(R%) = CSng(Amin(0.9 * C(R%), AMAX(0.001 * C(R%), conretire)))


                CNonRetire = CPREWORK(R%) + CWORKING(R%)
                Cremaining = C(R%) - CRETIRE(R%)
                CPREWORK(R%) = Cremaining * (CPREWORK(R%) / CNonRetire)
                CWORKING(R%) = Cremaining * (CWORKING(R%) / CNonRetire)

                'Convert absolute values to shares for use after all adjustments of C
                CPREWORK(R%) = CPREWORK(R%) / C(R%)
                CWORKING(R%) = CWORKING(R%) / C(R%)
                CRETIRE(R%) = CRETIRE(R%) / C(R%)


                '         If RegName$(R%) = "United States of America" Then Stop


                '         PenShrInc = GOVHHPENT(R%) / AMAX(0.00001, tothhinc)
                '         PensionAdjustment = (PenShrInc - SPenShrInc(R%)) * (PensionerCon / 100 - ComputedCon)
                '
                '         AgingAjustment = ComputedCon - SConProp(R%) 'ConProp is propensity for consumption
                '         adjustcon = AgingAjustment + PensionAdjustment
                '
                '
                '         C(R%) = C(R%) + adjustcon * tothhinc


                'SPenShrInc(R%) = PenShrInc


                'If RegName$(R%) = "Congo, Democratic Republic of" And IY% > 46 Then Stop

                'If RegName$(R%) = "Uganda" And IY% > 20 Then Stop

                '       All but First 3:  Consumption and Investment Rate Changes to Maintain Physical Balances
