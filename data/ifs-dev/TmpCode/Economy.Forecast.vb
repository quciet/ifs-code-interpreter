                'In 2017 in descending order Luxembourg, Hong Kong, Singapore, Djibouti, Malta, Ireland, and Vietnam
                EntrepotEconomy(R%) = 0
                For S% = 1 To NSec%
                    EntrepotEconomy(R%) = EntrepotEconomy(R%) + (XS(R%, S%) + MS(R%, S%)) / GDP(R%) * 100
                Next S% 'bbh 2022/12/20 End of identifying entrepot economies

                ProductivityImpBase = 0
                ProductivityImports = 0
                For S% = 1 To NSec%
                    'bbh 2011/10/31 STs for Hong Kong much higher than ZS and not used in trade base analysis
                    'xkav(R%, S%) = XS(R%, S%) / (ZS(R%, S%) + ST(R%, S%))
                    xkav(R%, S%) = XS(R%, S%) / ZS(R%, S%)
                    'bbh 2022/12/20 Added Viet Nam
                    'If (RegName$(R%) = "Hong Kong" Or RegName$(R%) = "Singapore" Or RegName$(R%) = "Viet Nam") And S% >= 4 Then 'bbh 2022/06/23 Block added for entrepot economy
