                StRatio(R%) = rsT / RStBase
                '   All but First 4, 5:  Interest Rates
                '   --------------------------------

                'bbh 2020/07/31 start 'move from mulitiplicative to additive change in stocks to make movements in both directions
                'comparable for impact of interest rates on C and IGCF
                'RDStocks are desired; rst are actual
                CompIntr = INTRI(R%) + 2 * (RDStocks - rsT) / RDStocks
                'CompIntr = INTRI(R%) * RDStocks / AMAX(0.3 * RDStocks, rsT)
                INTR(R%) = (CompIntr + SIntr(R%)) / 2 'To help kill annual oscillation
                'bbh 2022/06/23 start INTR
                'INTR(R%) = Amin(INTRI(R%) * 2, AMAX(0.01, INTR(R%)))
                INTR(R%) = Amin(INTRI(R%) * 4, AMAX(0.01, INTR(R%)))
                If INTR(R%) > SIntr(R%) Then
                    INTRChange = INTR(R%) - SIntr(R%)
                    INTRGap = INTRI(R%) * 4 - SIntr(R%)
                    INTRChange = CSng(Amin(INTRChange, 0.2 * INTRGap))
                    INTR(R%) = Amin(INTR(R%), SIntr(R%) + INTRChange)
                End If


                'If (IY% = 13) And ((RegName$(R%) = "Congo, Democratic Republic Of") Or (RegName$(R%) = "Nigeria")) Then Stop
                'Sintr(R%) = CompIntr
                'SIntr(R%) = INTR(R%) 'bbh 2022/06/23 Moved to ifsECOSAM5AllbutFirstYear so that could use to affect govexp before computing
