                    If globalfundsrecipients(R%) < 1 Then
                        GLOBALFUNDCUM = GLOBALFUNDCUM + GLOBALFUND * POVSHORTShare(R%) * (1 - globalfundsrecipients(R%))
                    End If
                End If

                GOVHHTRN(R%) = GOVHHPENT(R%) + GOVHHTRNWEL(R%, Unskilled) + GOVHHTRNWEL(R%, Skilled)


