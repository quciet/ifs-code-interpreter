                    'Amin(40, GDPPCP(R%)), rdexpcomp, context)
                    Call XYTABL(TblNameRandDPctGDP, Amin(40, GDPPCP(R%)), rdexpcomp, context)
                    'jrs 2013/11/28
                    '            Call XYTABL("GDP/Capita (PPP) Versus Years Of Educ at 15+ (2000)", _
                    '               GDPPCP(R%), yrsedcomp)
                    'jrs 2024/06/28 Call XYTABL("GDP/Capita (PPP 2005) Versus Years Of Educ at 15+ (2010) Log",
                    'GDPPCP(R%), yrsedcomp, context)
                    Call XYTABL(TblNameYrsEduc15, GDPPCP(R%), yrsedcomp, context)
                    'jrs 2024/06/19 Call XYTABL("GDP/Capita (PPP) Versus Life Expectancy (2000)",
                    'GDPPCP(R%), lifeexpcomp, context)
                    Call XYTABL(TFNameLifeExp, GDPPCP(R%), lifeexpcomp, context)
                    'jrs 2013/11/28
                    '            Call XYTABL("GDP/Capita (PPP 2005) Versus Stunting (2005) Log", _
                    '               GDPPCP(R%), stuntingcomp)
                    'jrs 2024/06/13 Call XYTABL("GDP/Capita (PPP 2005) Versus Stunting (2006) Log",
                    'GDPPCP(R%), stuntingcomp, context)
                    Call XYTABL(TblNameStunting, GDPPCP(R%), stuntingcomp, context)
                End If

                '   First Year 2:  Compute Contributions of Multiple Factors to MFPHC
                '   -----------------------------------------------------------------
                'jrs 2013/04/12 disability = SumHLYLDWork(R%) / AMAX(0.001, POP15TO65(R%))
                'bbh 2019/05/24 start
                'disability = SumHLYLDWork(R%) / AMAX(0.001, POPWORKING(R%))
                disability = SumHLYLDWork(R%) / AMAX(0.001, POPWORKING(R%)) * 100
                'bbh 2019/06/01 start
                WBGroup = GroupIDs(R%)
                'disabcontrib = AMAX(-2, (disability - GroupDisAvg(WBGroup)) * mfphlyld) 'jrs 2009/10/02 (-0.5)   'mfpdisab
                'bbh 2023/07/22 begin
                mfpdisabpar = mfphlyld 'As the disablity ratio drops from 0.1 to a very low 0.02 this parameter should decline to 0
