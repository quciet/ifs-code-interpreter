' Private Sub ComputeDyadicToMandicTradeFactors(iSector As Integer)
            Dim i As Integer
            Dim MTot() As Single, XTot() As Single

            'Imports 
            '--------------------
            ReDim MTot(NR)
            For i = 1 To NR
                For j = 1 To NR
                    MTot(j) = MTot(j) + XDYAD(i, j, i)
                Next j
            Next i
            For i = 1 To NR
                If MS(i, i) > 0 Then
                    m2dimportratioi(i, i) = MTot(i) / (MS(i, i) * 1000000000)
                Else
                    m2dimportratioi(i, i) = 1
                End If
            Next i

            'Exports 
            '--------------------
            ReDim XTot(NR)
            For i = 1 To NR
                For j = 1 To NR
                    XTot(i) = XTot(i) + XDYAD(i, j, i)
                Next j
            Next i
            For i = 1 To NR
                If XS(i, i) > 0 Then
                    m2dexportratioi(i, i) = XTot(i) / (XS(i, i) * 1000000000)
                Else
                    m2dexportratioi(i, i) = 1
                End If
            Next i
