                        BASE_POPWORK = CSng(dfBasePOPWORK(getDataFrameIdxFromDims(CShort(FirstYear + IY - 1), FirstYear, CShort(R), CShort(NR))))
                    End If
                    If dfBaseHLYLDWORK.RowCount > (IY - 1) * NR * Ntypes / 2 * 3 Then
                        BASE_SumHLYLDWork = 0
                        For z = 1 To CInt(Ntypes / 2)
                            'jrs 2024/01/05 - 2, I was ready current year, need previous year, as we do when rebuilding base
                            BASE_SumHLYLDWork = CSng(Round(BASE_SumHLYLDWork + CSng(dfBaseHLYLDWORK(getDataFrameIdxFromDims(CShort(FirstYear + IY - 2), FirstYear, CShort(R), CShort(NR), CShort(z), CShort(Ntypes / 2), 3, 3))), 5))
                        Next
                    End If
                    WBGroup = GroupIDs(R%)
                    GroupWorkPop(WBGroup) = CSng(GroupWorkPop(WBGroup) + Round(BASE_POPWORK, 5))
                    GroupDisability(WBGroup) = CSng(GroupDisability(WBGroup) + Round(BASE_SumHLYLDWork, 5))
                Next R%
            Else
                For R% = 1 To NR%
                    WBGroup = GroupIDs(R%)
                    GroupWorkPop(WBGroup) = CSng(GroupWorkPop(WBGroup) + Round(POPWORKING(R%), 5))
                    GroupDisability(WBGroup) = CSng(GroupDisability(WBGroup) + Round(SSumHLYLDWork(R%), 5))
                Next R%
            End If
            For WBGroup = 1 To 4
                GroupDisAvg(WBGroup) = CSng(Round(GroupDisability(WBGroup) / AMAX(0.001, GroupWorkPop(WBGroup)) * 100, 2))
            Next WBGroup
            'bbh 2019/06/01 end

            Dim gdpinformshrexp, gdpshadowshrexp, ExDefInfGDP, sinfcostrev, TefInfAdjustFac As Single

            MFPGLOCOR = MFPGloCorI 'bbh 2021/05/15

            For R% = 1 To NR%


                '   All but First 1:  Technological Growth:  Set Base Rates at Technology Leader Rate
                '   ---------------------------------------------------------------------------------
                'bbh 2019/09/08 start
                'Dim techpremium = PremTechConv(R%, context)
                'bbh 2021/05/15 Dim techpremium = PremTechComp(R%)
MFPPREMIUM(R%) = R% + GDPPCP @@MFPPREMIUM(R%) = PremTechComp(R%)@@
                'MFPPREMIUM(R%) = ConvergeOverTime(MFPPREMIUM(R%), 0, mfpconv2 * 2) 'bbh 2023/12/22 Test - Like MFPCORS declines
                'MFPPREMIUM(R%) = 0 'bbh 2023/12/05 test
                'If IY% = 20 And (GRPS(1, R) = "Eritrea") Then Stop  'bbh 2023/12/12
                For S% = 1 To NSec%  'Set base rates at technological leader of system
                    MFPRATE(R%, S%) = mfpleadr(S%)
                    If S% = ICT Then 'ICT growth starts very high, but gradually converges to services
                        MFPRATE(R%, S%) = ConvergeOverTime(MFPRATE(R%, S%), MFPRATE(R%, Serv), mfpconv2)
                        'Base, Target, Years
                    End If
                Next S%
