                '---------------------------------------------------------------------
                'mti 2021/01/29 - take entire procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
                'gvdb 2024/04/05
                ' unused variable
                Dim j As Integer, NormFac As Single, NonNormTot As Single 'gndr As Integer,
    
                If CSng(INCOMELT365LN(R%)) < 0.000002 Then    'no poor or less than 2 poor in total, make it 0
                    POVCOUNT365(R%%, TotPovAGCount, Total) = 0
                    POVRATE365(R%%, TotPovAGCount, Total) = 0
                    For j% = 1 To TotPovAGCount
                        POVRATE365(R%%, j%, Total) = 0
                        POVCOUNT365(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NonNormTot = 0
                For j% = 1 To TotPovAGCount - 1 'Last elenment is all ages
                    POVCOUNT365(R%%, j%, Total) = AMAX(0, POVRATE365(R%%, j%, Total) * POPPOVAG(R%%, j%, Total) / 100)
                    NonNormTot = NonNormTot + POVCOUNT365(R%%, j%, Total) 'POVRATE365(R%%, j%, Total) * POPPOVAG(R%%, j%, Total) / 100
                Next
    
                If NonNormTot = 0 Then
                    POVCOUNT365(R%%, TotPovAGCount, Total) = 0
