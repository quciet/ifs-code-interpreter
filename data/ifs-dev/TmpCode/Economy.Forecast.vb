                        sectorgr(R%, S%) = AMAX(sectorgr(R%, S%), POPR(R%) / 100 + minpcgr(R%)) 'jrs 2021/08/16
                    Next S%
                    SectorGrAgAdj(R%) = SectorGrAgAdj(R%) - igdprcor(R%)
