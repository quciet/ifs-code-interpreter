    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex55FirstYear:PovertyAdjGenderRatio
' Private Sub PovertyAdjGenderRatio(R%, PovRateVec(,,) As Single, AGCount As Integer)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - new procedure
                '(R%%, POVRATE55(), PovCountVec(), povnational_hc As Single)
                Dim AdjPovDiff As Single
                Dim j%
    
                'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                For j% = 1 To TotPovAGCount
                    If POVRATE55(R%%, j, Female) - POVRATE55(R%%, j, Male) > 1.5 * POVRATE55(R%%, j, Total) Then
                        AdjPovDiff = CSng((POVRATE55(R%%, j, Female) - POVRATE55(R%%, j, Male)) - 1.5 * POVRATE55(R%%, j, Total))
                        POVRATE55(R%%, j, Female) = POVRATE55(R%%, j, Female) - AdjPovDiff / 2
                        POVRATE55(R%%, j, Male) = POVRATE55(R%%, j, Male) + AdjPovDiff / 2
                    ElseIf POVRATE55(R%%, j, Female) - POVRATE55(R%%, j, Male) < -1.5 * POVRATE55(R%%, j, Total) Then   '1.5
                        AdjPovDiff = CSng((POVRATE55(R%%, j, Female) - POVRATE55(R%%, j, Male)) + 1.5 * POVRATE55(R%%, j, Total))
                        POVRATE55(R%%, j, Female) = POVRATE55(R%%, j, Female) + AdjPovDiff / 2
                        POVRATE55(R%%, j, Male) = POVRATE55(R%%, j, Male) - AdjPovDiff / 2
                    End If
    
                    '           'make sure there is at least some poverty in each gender
                    POVRATE55(R%%, j%, Male) = AMAX(POVRATE55(R%%, j%, Female) * 0.2, POVRATE55(R%%, j%, Male))
                    POVRATE55(R%%, j%, Female) = AMAX(POVRATE55(R%%, j%, Male) * 0.2, POVRATE55(R%%, j%, Female))
    
                Next j%
    
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSex55FirstYear:PovertyAdjGenderRatio
                'Normalize poverty across sexes within the same age group
                'mti 2021/12/28 start
