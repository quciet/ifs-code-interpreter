            '        HHINCDIS(R%%, Unskilled) = AMAX(0.8 * HHINCDIS(R%%, Unskilled), HHINCDIS(R%%, Unskilled) + XWORKREMIT(R%%) * ShrUnskilledPop)
            '        HHINCDIS(R%%, Skilled) = AMAX(0.8 * HHINCDIS(R%%, Skilled), HHINCDIS(R%%, Skilled) + XWORKREMIT(R%%) * (1 - ShrUnskilledPop))

            HHINCDIS(R%%, Unskilled) = HHINCDIS(R%%, Unskilled) + XWORKREMIT(R%%) * ShrUnskilledPop
            HHINCDIS(R%%, Skilled) = HHINCDIS(R%%, Skilled) + XWORKREMIT(R%%) * (1 - ShrUnskilledPop)
            'if RegName(R%%) = "Oman" Then Stop
            '        End If
            'bbh 2020/07/02 end
            'mti 2019/03/08 End




            '        HHINCDISPC(R%%, Unskilled) = HHINCDIS(R%%, Unskilled) / HHPOP(R%%, Unskilled)
            '        HHINCDISPC(R%%, Skilled) = HHINCDIS(R%%, Skilled) / HHPOP(R%%, Skilled)


            'bbh 2021/06/01
            FIRMINCDIS(R%%) = FIRMEARN(R%%) - FIRMTAX(R%%) - FIRMGOVSS(R%%) - HHDIVINT(R%%, Unskilled) - HHDIVINT(R%%, Skilled) _
            - INDIRECTTAX(R%%) * (FIRMEARN(R%%) / (FIRMEARN(R%%) + HHINCEARN(R%%, Unskilled) + HHINCEARN(R%%, Skilled)))

            'jrs 2024/01/29 removing HHINC
            ''bbh 2021/05/15  Keep these new two lines until have totally removed HHINC; difficulty is that some other
            ''   IFs areas, including malnutrtion in pop, use HHINC; so may be too much to remove
            'HHINC(R%%, Unskilled) = HHINCDIS(R%%, Unskilled)
            'HHINC(R%%, Skilled) = HHINCDIS(R%%, Skilled)

' End Sub
