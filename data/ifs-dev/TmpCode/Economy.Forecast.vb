                For S% = 1 To NSec%
                    VADDHHU(R%%, S%) = LABWAGES(R%%, S%, Unskilled) * LABEMPS(R%%, S%, Unskilled)
                    VADDHHS(R%%, S%) = LABWAGES(R%%, S%, Skilled) * LABEMPS(R%%, S%, Skilled)

                    '----- Common ---
                    VAddCalc = VADDHHU(R%%, S%) + VADDHHS(R%%, S%)
