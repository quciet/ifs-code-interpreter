                            ' mprclag(R%, S%) = 0.4 * (pridiff) + 0.6 * mprclag(R%, S%)

                            Call ADJSTR(PriBase, Diff1, Diff2, elmpr1adj, elmpr2adj, Mul)
                            'jrs 2024/09/26
                            'If IY >= 80 Then
                            '    Mul = 1
                            'End If
                            If S% = 6 Then
                                Mul = CSng(Mul ^ 0.5) 'bbh 2022/12/20
                            End If
                        End If
                        Dim mulswingpar = 0!
                        'Following logic limits the degree to which local price can swing imports as share of import base:
