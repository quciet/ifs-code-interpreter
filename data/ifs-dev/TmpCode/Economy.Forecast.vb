                '
                '
                '        FIRMINCDIS(R%) = FIRMEARN(R%) - FIRMTAX(R%) - FIRMGOVSS(R%) - HHDIVINT(R%, Unskilled) - HHDIVINT(R%, Skilled) ' INDIRECTTAX(R%)
                '        'mti 2016/10/20 end
                '

                '   All But First 3:  Household income: protect sign from taxes driving negative
                '   ----------------------------------------------------------------------------

                'bbh 2021/05/15 start Note: this bounding of taxes is different than in t=1, perhaps review 2 logics
                If HHINCDIS(R%, Unskilled) / AMAX(0.0001, SHHPOP(R%, Unskilled)) < 0.025 Then
                    TReduction = CSng(0.025 * SHHPOP(R%, Unskilled) - HHINCDIS(R%, Unskilled))
                    TaxTot = AMAX(0.0001, HHTAX(R%, Unskilled) + HHGOVSS(R%, Unskilled))
                    If TReduction >= TaxTot Then
                        HHTAX(R%, Unskilled) = 0
                        HHGOVSS(R%, Unskilled) = 0
                    Else
                        HHTAX(R%, Unskilled) = HHTAX(R%, Unskilled) * (1 - TReduction / TaxTot)
                        HHGOVSS(R%, Unskilled) = HHGOVSS(R%, Unskilled) * (1 - TReduction / TaxTot)
                    End If
                    HHINCDIS(R%, Unskilled) = CSng(0.025 * SHHPOP(R%, Unskilled))
