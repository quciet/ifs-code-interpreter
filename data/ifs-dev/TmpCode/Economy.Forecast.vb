                    DYADTARIFFRATE(II, j, 0) = DYADTARIFFRATE(II, j, 0) / 6
                Next j
            Next II

            ReDim TradeDeltaCum(NR, NR, NSec)
            Dim ValEst = 0!
            Dim Growth = 0!
