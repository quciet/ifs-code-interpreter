                'If GRPS(1, R) = "Sudan South" Then Stop
                HHSAV(R%, Unskilled) = HHINCDIS(R%, Unskilled) - consumhh(R%, Unskilled)
                HHSAV(R%, Skilled) = HHINCDIS(R%, Skilled) - consumhh(R%, Skilled)
                HHSAV(R%, NSkill%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) 'bbh 2020/06/13
                'Cannot sum with R%, Total, must use R%, NSkill%
                'bbh 2020/07/01 end

                'bbh 2020/07/01 start
                '        rpaadj = GDPRPA(R%) - GDP(R%)
                '        FIRMSAV(R%) = FIRMINC(R%) - FIRMTAX(R%) - INDIRECTTAX(R%) _
                '            - HHDIVINT(R%, Unskilled) - HHDIVINT(R%, Skilled) - FIRMGOVSS(R%) _
                '            - XFDIFOUT(R%) - XPORTFOUT(R%) + XFDIFIN(R%) + XPORTFIN(R%) _
                '            - XWBSUBF(R%) - rpaadj
                '            'FDI and Portfolio inflows are put earlier into firm income
                '            'GDPRPA-GDP flows into firms after households removed; need to remove,
                '            '   to revert to non-RPA FORSAV, SAVINGS
                '
                '        If XWORKREMIT(R%) < 0 Then FIRMSAV(R%) = FIRMSAV(R%) + XWORKREMIT(R%)
                '        firmsavadj = XFDIFIN(R%) - XFDIFOUT(R%) + XPORTFIN(R%) - XPORTFOUT(R%) _
                '            - XWBSUBF(R%) + XWORKREMIT(R%)  'XWORKREMIT household term?
                '        govbaladj = XWBLNFIN(R%) - XWBLNFOUT(R%) + XIMFCRFIN(R%) - XIMFCRFOUT(R%)
                '
                '        'Capital Account = - Current Account
                '        'Capital Account = FDI, portfolio, IMF, WB, other flows in - flows out +
                '        '       Balancing Debt/Reserve Change Term
                '        '   = Basic Capital Account + Balancing Debt/Reserve Change Term
                '        'Therefore Net Foreign savings (balancing term) = -Basic Capital Account - Curact
                '        FORSAV(R%) = -firmsavadj - govbaladj - (X(R%) - M(R%) + AID(R%))
                '        SAVINGS(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + _
                '            FIRMSAV(R%) + GOVBAL(R%) + FORSAV(R%) 'Should equal I(nvestment),
                '                'which is not price adjusted
                '        SavingsR(R%) = SAVINGS(R%) / GDPPOTRPA(R%)
                '
                '        SAVINGSRPA(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + _
                '            FIRMSAV(R%) + GOVBAL(R%) + FORSAVRPA(R%)


                ' Current account includes X-M, foreign aid, net remittances, WB and IMF flows
                ' Capital account includes net FDI and portfolio investment (delta assets offsetting current account balance)
                '     and the change of other assets such as govt purchases/sales of bonds, foreign currency abroad

                'FIRMSAV(R%) = FIRMINC(R%) - FIRMTAX(R%) - INDIRECTTAX(R%) _
                '    - HHDIVINT(R%, Unskilled) - HHDIVINT(R%, Skilled) - FIRMGOVSS(R%) _
                '    - XFDIFOUT(R%) - XPORTFOUT(R%) + XFDIFIN(R%) + XPORTFIN(R%) _
                '    - XWBSUBF(R%)
                'bbh 2021/06/01 FIRMSAV is all of FIRMINCDIS
                'FIRMSAV(R%) = FIRMINCDIS(R%) - FIRMTAX(R%) - INDIRECTTAX(R%) _
                '- HHDIVINT(R%, Unskilled) - HHDIVINT(R%, Skilled) - FIRMGOVSS(R%) 'bbh 2021/05/15
                FIRMSAV(R%) = FIRMINCDIS(R%)
                '  - XFDIFOUT(R%) - XPORTFOUT(R%) + XFDIFIN(R%) + XPORTFIN(R%)  'Already included in FIRMINC, which is VADD share, augmented
                '   - XWBSUBF(R%) 'should  be in GOVEXP; now bouncing around for US

                'FORSAV(R%) = -(X(R%) - M(R%) + AID(R%) + XWORKREMIT(R%)) '= -CURACT(R%)=CAPACT(R%)
                'bbh 2021/07/07 start
                'SAVINGS(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + FIRMSAV(R%) + GOVBAL(R%)              '+ FORSAV(R%) 'FORSAV are the Domestic Savings-I balancing term
                'i.e., Dom Savings - I = CURACT; Dom SAVINGS + CAPACT [or -CURACT/For Savings] - I = 0; Tot Savings - I = 0
                'was computing FORSAV here but with Base Rebuild not available first year,
                '    so switched computation of FORSAV to IFsEcoIntl just after where CURACT computed
                ' FORSAV(R%) = CURACT(R%) 'TRADEBAL + AID + XWORKREMIT - Interest [related to intl asset position, see IFsEcoIntl]
                'Note: although we want to keep Tot Savings and I in balance, not done directly; instead INTR responds to stocks,
                '   which reflect that balance
                'SavingsR(R%) = SAVINGS(R%) / GDPPOTRPA(R%)
                'bbh 2020/07/01 end
                'bbh 2021/07/07 Note: FORSAV cannot be used here becuase not available in Base Rebuild; looks to me as if computing SAVINGS here not needed;
                '   I see no use of SavingsR, Savings RI, SmoothSavingsR as computed below so I think they could be removed.

                'If RegName$(R%) = "Ethiopia" Then Stop
                If IY% = 1 Then
                    'SavingsRI(R%) = SavingsR(R%)
                    'SmoothSavingsR(R%) = SavingsR(R%)
                    hhfirmsavri(R%) = (HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + FIRMSAV(R%)) _
                    / GDPPOT(R%) * 100
                    hhfirmsavr = hhfirmsavri(R%)
                Else
                    ' SmoothSavingsR(R%) = SmoothSavingsR(R%) * 0.8 + SavingsR(R%) * 0.2
                    '            hhfirmsavr = (HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + FIRMSAV(R%)) _
                    '/ GDPPOT(R%) * 100
                    hhfirmsavr = (HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + FIRMSAV(R%)) _
                    / GDPPOTRPA(R%) * 100
                End If
                'bbh 2021/07/07 end

                'bbh 2020/07/01 start HHFirmSavTarget% to HHFirmSavTarget, next 2 active lines, should not be integer
                HHFirmSavTarget = ConvergeOverTime(hhfirmsavri(R%), 30, 80)
                'Base, Target, Years
                'Diff1 = hhfirmsavr - hhfirmsavri(R%)
                Diff1 = hhfirmsavr - HHFirmSavTarget
                'bbh 2020/07/01 end
                Diff2 = Diff1 - SHHFIRMSAVDiff(R%)
                SHHFIRMSAVDiff(R%) = Diff1
                'Call ADJSTR(100, Diff1, Diff2, 0.2, 0.4, Mul)
                Call ADJSTR(100, Diff1, Diff2, 0.05, 0.1, Mul) 'Larger numbers cause oscillation in CRA
                'jrs 2024/09/26
                'If IY >= 80 Then
                '    Mul = 1
                'End If

                'If savings too high, increase consumption
                mulcon(R%) = Mul

                'jrs 2013/06/11 *** begin ***
                'Retirement Finance
                '==================
                If IY% > 1 Then

                    'bbh 2013/08/10
                    'All but First: Compute absolute values of population group shares in C
                    CPREWORK(R%) = CPREWORK(R%) * C(R%)
                    CWORKING(R%) = CWORKING(R%) * C(R%)
                    CRETIRE(R%) = CRETIRE(R%) * C(R%) 'What pensioners actually get; dependent earlier on income/transfers, pensions
                    'If RegName$(R%) = "Angola" Then Stop

                    SCRETIRE(R%) = CRETIRE(R%) 'Save for adjustment of pension spending
                    SHHRETIRENEED(R%) = HHRETIRENEED(R%)

                    'All but First: Compute annual retirement expenditure need for entire society
                    '--------------------------------------------------------------------------
                    'bbh 2013/08/11 ' computed what they need (fair share) earlier
                    '            HHRETIRENEED(R%) = POPRETIRED(R%) * C(R%) / POP(R%) * retireconsumrat

                    'All but First 3: Compute implied annual draw down of household savings stocks
                    '------------------------------------------------------------------------
                    'HHSAVUSE(R%) = AMAX(HHRETIRENEED(R%) - GOVHHPENT(R%), 0)
                    HHSAVUSE(R%) = AMAX(CRETIRE(R%) - GOVHHPENT(R%), 0) 'actual use of savings based on actual consumption
                    HHSAVENEEDUSE = AMAX(HHRETIRENEED(R%) - GOVHHPENT(R%), 0) 'desired use of savings based on desired/fair need

                    'All but First: Compute annual flow of savings per retiree
                    '------------------------------------------------------
                    If POPRETIRED(R%) > 0 Then
                        HHSAVUSEPC(R%) = HHSAVUSE(R%) / POPRETIRED(R%)
                    Else
                        HHSAVUSEPC(R%) = 0
                    End If

                    'All but First: Compute integrated need for non-govt system savings across all existing retirees
                    '--------------------------------------------------------------------------------------------
                    'Assume each retireee lives to LIFEXP
                    'and that annual use per retiree (HHSAVUSEPC) increases at rate of igdpr (bound by 0.01 to 0.07).
                    'JRS says: this is the same as having a constant anuity discounted using igdpr as the discount rate
                    'PV = A * [(1-(1+i)^-n)/i]

                    'bbh 2013/08/11 Eliminated block below

                    '            HHSAVNEEDSTOCK(R%) = 0
                    '            If HHSAVUSE(R%) > 0 Then
                    '                If SLIFEXP(R%) < workageretire(R%) Then
                    '                    HHSAVNEEDSTOCK(R%) = HHSAVUSE(R%)
                    '                Else
                    '                    For j = workageretire(R%) To Int(SLIFEXP(R%))
                    '                        rr = AMAX(Amin(SmoothGDPR(R%), 0.07), 0.01)
                    '                        pp = Pop_AgeYear(j, R%, 1) + Pop_AgeYear(j, R%, 2)
                    '                        'HHSAVNEEDSTOCK(R%) = HHSAVNEEDSTOCK(R%) + pp * HHSAVUSEPC(R%) * ((1 - (1 + rr) ^ (j - SLIFEXP(R%))) / rr)
                    '                        HHSAVNEEDSTOCK(R%) = HHSAVNEEDSTOCK(R%) + pp * HHSAVUSEPC(R%) * (((1 + rr) ^ (SLIFEXP(R%) - j + 1) - 1) / rr)
                    '                    Next j
                    '                End If
                    '            End If

                    'bbh 2013/08/11  Eliminated block above and replaced with line below
                    '   Retirees do not run down asset stock and exhaust it on day of death; NTA project shows they increase it over time
                    '   So assume that they withdraw at a sustainable rate, namely the same discount rate at which stocks normally grow
                    'HHSAVNEEDSTOCK(R%) = HHSAVUSE(R%) / (AMAX(0.01, savingsdiscountrt(R%) / 100))
                    HHSAVNEEDSTOCK(R%) = HHSAVENEEDUSE / (AMAX(0.01, savingsdiscountrt(R%) / 100))

                    'All but First: Set accumulated savings to accumulated needs in absence of any other info about it
                    '-----------------------------------------------------------------------------------------------
                    HHSAVSTOCK(R%) = SHHSAVSTOCK(R%) * (1 + savingsdiscountrt(R%) / 100) + HHSAV(R%, 1) + HHSAV(R%, 2) - HHSAVUSE(R%)
                    'If RegName$(R%) = "United States Of America" Then Stop
                    'bbh 2013/08/03 POPRETIRED can be 0 in some scenarios (e.g. 180 retirement of SENS)
                    'bbh 2013/07/10 added multiplier on next line to represent loss of some targeted elderly savings with deaths

                    'bbh 2020/06/13 start 'Removed loss from death because assets are still there for retired
                    '            If POPRETIRED(R%) > 0 Then
                    '                SHHSAVSTOCK(R%) = HHSAVSTOCK(R%) * (1 - Amin(1, 0.5 * DEATHS(R%) / POPRETIRED(R%)))
                    '                    'unless spouse surives,savings pass to next generation
                    '            Else
                    '                SHHSAVSTOCK(R%) = HHSAVSTOCK(R%)
                    '            End If
                    SHHSAVSTOCK(R%) = HHSAVSTOCK(R%)
                    'bbh 2020/06/13 end

                    'All but First: Compute surplus or deficit of savings for retirement
                    '----------------------------------------------------------------
                    HHSAVSURSTOCK(R%) = HHSAVSTOCK(R%) - HHSAVNEEDSTOCK(R%)
                    SavSHHSavSurStock(R%) = SHHSavSurStock(R%) 'bbh 2020/06/13
                    SHHSavSurStock(R%) = HHSAVSURSTOCK(R%) 'bbh 2020/06/13
                    'bbh 2021/07/07 In the logic above, there was a signficant jump in HHRETIRENEED(R%) for the US in 2020 that led to a value here
                    '   that subsantially lowered the computation of C in 2021 and set up descrepancies in savings and investment; turned off the impact of SHHSAVSURSTOCK
                    'If RegName$(R%) = "United States Of America" And IY% >= 4 Then Stop
                End If
                'jrs 2013/06/11 *** end ***
                'bbh 2021/07/07 start
                'jrs 2020/08/28 moved from ifsEconIntl where the mumbers were not computed yet
                'SAVINGSRPA(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + _
                'FIRMSAV(R%) + GOVBAL(R%) '+ FORSAVRPA(R%) bbh 2021/07/07 FORSAV and FORSAVRPA Not available first year in rebuild of base; location was causing transient
                'bbh 2021/07/07 Also, computing SAVINGSRPA here probably not necessary
                'SAVINGS(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + _
                'FIRMSAV(R%) + GOVBAL(R%) + FORSAV(R%) 'bbh 2021/07/07
                'If RegName$(R%) = "Ethiopia" Then Stop
                'bbh 2021/07/07 end
            Next R%

            '   All Steps:  Global Gini
            '   -----------------------
            '   Prepare variables for call to Gini Calculation: can be any regional variable
            '   GiniMatrix and PopMatrix declared in Declare2; will need to be in GUI

            'jrs 2014/09/16
            Dim ICount As Integer

            For ICount% = 1 To NR%
                GiniMatrix(ICount%) = GDP(ICount%)
                PopMatrix(ICount%) = POP(ICount%)
            Next ICount%
Call GiniCalc(GiniMatrix, PopMatrix)
    ' ---- Begin Inlined Level 2: ifsECOSAMAllYears:GiniCalc
' Sub GiniCalc(GiniMatrix() As Single, PopMatrix() As Single)
                '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
                Dim ginimathold() As Single, rankscale() As Integer
                Dim LorenzX(), LorenzY() As Single
    
                ReDim ginimathold(NR%), rankscale(NR%)
                ReDim LorenzX(NR%), LorenzY(NR%)
                'jrs 2014/09/15
                Dim matlargest As Single, WGiniMatrixSum As Single, WPopSum As Single, ICount As Integer, MatSmall As Single, jCount As Integer, SmallReg As Integer
                Dim reg1 As Integer, AreaTot As Single, CumAreaEq As Single, CumAreaIneq As Single, PopCum As Single, GiniMatrixCum As Single, RegLast As Integer
                Dim reg As Integer, LPopCum As Single, LGiniMatrixCum As Single, NewAreaEqbase As Single, NewAreaEqAboveBase As Single, NewAreaIneq As Single
    
                '   Find largest per capita value and compute global sums
                matlargest = GiniMatrix(1) / PopMatrix(1)
                WGiniMatrixSum = 0
                WPopSum = 0
                For ICount% = 1 To NR% 'Copy matrix to sort into GiniMatHold and find largest value
                    ginimathold(ICount%) = GiniMatrix(ICount%) / PopMatrix(ICount%)
                    If ginimathold(ICount%) > matlargest Then
                        matlargest = ginimathold(ICount%)
                    End If
                    WGiniMatrixSum = WGiniMatrixSum + GiniMatrix(ICount%)
                    WPopSum = WPopSum + PopMatrix(ICount%)
                Next ICount%
    
                '   Rank a matrix (e.g. GDPPC) from smallest to largest and maintain pointers
                '       1-NR% in RankScale
                For ICount% = 1 To NR%
                    MatSmall = matlargest
                    For jCount% = 1 To NR%  'Find smallest value not yet identified
                        If ginimathold(jCount%) <= MatSmall Then
                            MatSmall = ginimathold(jCount%)
                            SmallReg = jCount%
                        End If
                    Next jCount%
                    rankscale(ICount%) = SmallReg
                    'Hold region number of smallest element
                    ginimathold(SmallReg) = Abs(matlargest * 2) 'Do not reuse smallest element
                Next ICount%
    
                '   Compute equality and inequality for "poorest" country
                reg1 = rankscale(1)
                AreaTot = CSng(0.5 * (PopMatrix(reg1) / WPopSum) ^ 2)
                CumAreaEq = CSng(0.5 * PopMatrix(reg1) / WPopSum * GiniMatrix(reg1) / WGiniMatrixSum)
                'e.g., if bottom 10% have 2%, then = .5 * .10 * .02 = .001
                CumAreaIneq = AreaTot - CumAreaEq
                'e.g., if looking at bottom 10% then = .5 * .1 * .1 - .001 = .004
                PopCum = PopMatrix(reg1)
                GiniMatrixCum = GiniMatrix(reg1)
                LorenzX(1) = PopMatrix(reg1) / WPopSum
                LorenzY(1) = GiniMatrix(reg1) / WGiniMatrixSum
    
    
                '   Compute equality and inequalty for all countries
                For ICount% = 2 To NR%
                    RegLast = rankscale(ICount% - 1)
                    reg = rankscale(ICount%)
                    LPopCum = PopCum
                    LGiniMatrixCum = GiniMatrixCum
                    PopCum = PopCum + PopMatrix(reg)
                    GiniMatrixCum = GiniMatrixCum + GiniMatrix(reg)
                    AreaTot = CSng(0.5 * (PopCum / WPopSum) ^ 2)
                    NewAreaEqbase = (PopMatrix(reg) / WPopSum) * (LGiniMatrixCum / WGiniMatrixSum)
                    NewAreaEqAboveBase = CSng(1 / 2 * (PopMatrix(reg) / WPopSum) *
                (GiniMatrixCum / WGiniMatrixSum - LGiniMatrixCum / WGiniMatrixSum))
                    NewAreaIneq = AreaTot - CumAreaEq - CumAreaIneq -
                NewAreaEqbase - NewAreaEqAboveBase
                    CumAreaEq = CumAreaEq + NewAreaEqbase + NewAreaEqAboveBase
                    CumAreaIneq = CumAreaIneq + NewAreaIneq
                    LorenzX(ICount%) = LorenzX(ICount% - 1) + PopMatrix(reg) / WPopSum
                    LorenzY(ICount%) = LorenzY(ICount% - 1) + GiniMatrix(reg) / WGiniMatrixSum
                Next ICount%
    
                '   Compute Gini relative to 1/2 - line of equality
                GINI = CSng(CumAreaIneq / 0.5)
    
' End Sub
    ' ---- End Inlined Level 2: ifsECOSAMAllYears:GiniCalc

            For HHCount% = 1 To NHHTypes%
                For ICount% = 1 To NR%
                    'jrs 2024/01/29 GiniMatrix(NR% * (HHCount% - 1) + ICount%) = HHINC(ICount%, HHCount%)
                    GiniMatrix(NR% * (HHCount% - 1) + ICount%) = HHINCDIS(ICount%, HHCount%)
                    PopMatrix(NR% * (HHCount% - 1) + ICount%) = HHPOP(ICount%, HHCount%)
                Next ICount%
            Next HHCount%
            '    Call GiniFullCalc(GiniMatrix(), PopMatrix())
            'The household type-based calculation above replaced by log-normal based below
Call GiniFullNew()
    ' ---- Begin Inlined Level 2: ifsECOSAMAllYears:GiniFullNew
' Sub GiniFullNew()
                '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    
                'mti lognormal GiniFll July 2006
                Dim WPopShare() As Single
                Dim WIncShare() As Single
    
                Dim LNMean() As Single
                Dim LNSD() As Single
                Dim R_PopFrac() As Single
                Dim R_IncFrac() As Single
    
                ReDim LNMean(NR%)
                ReDim LNSD(NR%)
    
                ReDim R_PopFrac(NR%)
                ReDim R_IncFrac(NR%)
    
                Dim RgnCnt%
                'jrs 2014/09/16
                Dim WPopSum As Single, WIncSum As Single, GDPPCMax As Single, IncDiv As Integer, IncInterval As Single, tGini As Single, meanconsumption As Single
                Dim scnt As Integer, TInc As Single, PopFrac As Single, IncFrac As Single, gfull1 As Single, gfull2 As Single
    
                WPopSum = 0
                WIncSum = 0
    
                GDPPCMax = 0
                For RgnCnt% = 1 To NR%
                    WPopSum = WPopSum + POP(RgnCnt%)
                    WIncSum = WIncSum + GDPPCP(RgnCnt%) * POP(RgnCnt%)
                    If GDPPCP(RgnCnt%) > GDPPCMax Then
                        GDPPCMax = GDPPCP(RgnCnt%)
                    End If
                Next RgnCnt%
    
                'take 5 times max GDPPCP and divide into IncInterval(500) dollars
                'jrs 2007/03/21 using less number of intervals
                'The intervals are bigger
                '    IncInterval = 1000
                '    IncDiv = Int(4 * GDPPCMax * 1000 / IncInterval)
                IncDiv = 200
                IncInterval = 4 * GDPPCMax * 1000 / 200 '(4*GDPPCMax * 1000 / 200)
    
                ReDim WPopShare(IncDiv)
                ReDim WIncShare(IncDiv)
    
    
                For RgnCnt% = 1 To NR%
                    R_PopFrac(RgnCnt%) = 0
                    R_IncFrac(RgnCnt%) = 0
                Next RgnCnt%
    
                'mean and standard deviation for all regions - uses GiniDOM and GDPPCP
                For RgnCnt% = 1 To NR%
                    tGini = GINIDOM(RgnCnt%) 'country's gini
                    meanconsumption = GDPPCP(RgnCnt%) 'country's mean income, use consumption?
                    'standard deviation
                    'mti Sept 04, 2009 -start
                    LNSD(RgnCnt%) = CSng(Sqrt(2) * CalcNormalInverse((tGini + 1) / 2))
                    'LNSD(RgnCnt%) = Sqr(2) * NormalInverse((tGini + 1) / 2)
                    'mti Sept 04, 2009 -end
                    'log normal mean
                    LNMean(RgnCnt%) = CSng(Log(meanconsumption * 1000) - 0.5 * (LNSD(RgnCnt%) ^ 2))
                Next RgnCnt%
    
                'population and income shares
                For scnt = 1 To IncDiv
                    WIncShare(scnt) = 0
                    WPopShare(scnt) = 0
    
                    For RgnCnt% = 1 To NR%
    
                        'cut off income
                        TInc = scnt * IncInterval
                        'If TInc < 6 * GDPPCP(RgnCnt%) * 1000 + 1 Then
                        If R_PopFrac(RgnCnt%) > 0 Then
                            PopFrac = R_PopFrac(RgnCnt%)
                            IncFrac = R_IncFrac(RgnCnt%)
                        Else
                            'percentage share (in 0 to 1) of domestic population below this income (TInc)
                            'mti Sept 04, 2009 -Start
    
                            'PopFrac = LogNormalCDF(TInc, LNMean(RgnCnt%), LNSD(RgnCnt%))
                            PopFrac = If(CalcLogNormalCDF(TInc, LNMean(RgnCnt%), LNSD(RgnCnt%)), 0)
    
    
                            'percentage share of national income held by people under this income, TInc
    
                            'IncFrac = LogNormalCDF(TInc, LNMean(RgnCnt%) + LNSD(RgnCnt%) ^ 2, LNSD(RgnCnt%))
                            IncFrac = If(CalcLogNormalCDF(TInc, CSng(LNMean(RgnCnt%) + LNSD(RgnCnt%) ^ 2), LNSD(RgnCnt%)), 0)
                            'percentage share of global income held by people under this income, TInc
    
                            'mti Sept 04, 2009 - end
    
                            If PopFrac > 0.999 Then
                                R_PopFrac(RgnCnt%) = PopFrac
                                R_IncFrac(RgnCnt%) = IncFrac
                            End If
    
                        End If
    
                        'percentage share of global population below this income (TInc)
                        WPopShare(scnt) = WPopShare(scnt) + PopFrac * (POP(RgnCnt%) / WPopSum)
    
                        WIncShare(scnt) = WIncShare(scnt) + IncFrac * ((GDPPCP(RgnCnt%) *
                                    POP(RgnCnt%)) / WIncSum)
                        'End If
                    Next RgnCnt%
                    If WPopShare(scnt) > 0.999 Then
                        Exit For
                    End If
                Next scnt
    
                'Gini using Brown's Formula for k number of cumulative population and
                'income shares; please see Chotikapanic et. al 1997
                'Gini = Summation 1 to k-1 (WIncShare(k+1)*WPopShare(k)) - Summation 1 to
                'k-1 (WIncShare(k)*WPopShare(k+1))
    
                gfull1 = 0
                gfull2 = 0
                For scnt = 1 To IncDiv - 1
                    gfull1 = gfull1 + WIncShare(scnt + 1) * WPopShare(scnt)
                Next scnt
    
                For scnt = 1 To IncDiv - 1
                    gfull2 = gfull2 + WIncShare(scnt) * WPopShare(scnt + 1)
                Next scnt
    
                GINIFULL = (gfull1 - gfull2)
    
                'jrs 2007/03/22
                '    Open PutFdrvRun$ + "ginifull.txt" For Output As #99
                '
                '    For scnt = 1 To IncDiv
                '        Print #99, WIncShare(scnt) & ", " & WPopShare(scnt)
                '    Next scnt
                '
                '    Close #99
    
' End Sub
    ' ---- End Inlined Level 2: ifsECOSAMAllYears:GiniFullNew
' End Sub
' ---- End Inlined Level 1: ifsECOSAMAllYears
        End Sub
