                POVRATE32(R%%, 1, Total) = 100 * POVCOUNT32(R%%, 1, Total) / AMAX(0.000001, POPPOVAG(R%%, 1, Total))
    
                'POVRATE32(R%%, TotPovAGCount, Total) = 100 * POVCOUNT32(R%%, TotPovAGCount, Total) / POPPOVAG(R%%, TotPovAGCount, Total)
                POVRATE32(R%%, TotPovAGCount, Total) = 100 * POVCOUNT32(R%%, TotPovAGCount, Total) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Total))
