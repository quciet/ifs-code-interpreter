            'mti 2018/10/22 Take enrtire routine

            'gvdb 2024/04/05
            ' unused variable
            Dim VAddFromLab, VADDHHUTot, VADDHHSTot, LABSkTot, LABUnSkTot, VAddCalc As Single ', hhinctot As Single
            Dim i2 As Integer, S As Integer

            LABUnSkTot = 0
            LABSkTot = 0

            For S% = 1 To NSec%
                LABUnSkTot = LABUnSkTot + LABEMPS(R%%, S%, Unskilled)
                LABSkTot = LABSkTot + LABEMPS(R%%, S%, Skilled)
            Next S%


            'Debug.Print "Country, Year, Sector, Sk Emp, UnSkEmp, Sk Wage, Unsk Wage"
            If IY% = 1 Then

                'If RegName(R%%) = "Brunei" Then Stop
                For S% = 1 To NSec%
                    VAddFromLab = VADD(R%%, S%) * (1 - alphas(R%%, S%))
                    LABWAGES(R%%, S%, Unskilled) = VAddFromLab * LABWAGESSHRSKL(R%%, S%, Unskilled) / 100 / AMAX(0.0001, LABEMPS(R%%, S%, Unskilled))
                    LABWAGES(R%%, S%, Skilled) = VAddFromLab * LABWAGESSHRSKL(R%%, S%, Skilled) / 100 / AMAX(0.0001, LABEMPS(R%%, S%, Skilled))
                Next S%

                LABWAGES(R%%, Agri, Unskilled) = CSng(Amin(0.5 * LABWAGES(R%%, Serv, Unskilled), Amin(0.5 * LABWAGES(R%%, Manu, Unskilled), LABWAGES(R%%, Agri, Unskilled))))
                LABWAGES(R%%, Agri, Skilled) = CSng(Amin(0.5 * LABWAGES(R%%, Serv, Skilled), Amin(0.9 * LABWAGES(R%%, Manu, Skilled), LABWAGES(R%%, Manu, Skilled))))

                For S% = 1 To NSec%
                    LABWAGES(R%%, S%, Skilled) = AMAX(1.2 * LABWAGES(R%%, S%, Unskilled), LABWAGES(R%%, S%, Skilled))
                Next S%


                i2 = 0
                Do While i2 < 30

                    VADDHHUTot = 0
                    VADDHHSTot = 0
                    For S% = 1 To NSec%
                        '            VADDHHU(R%%, S%) = VADD(R%%, S%) * LaborF(R%%, Unskilled, S%)
                        '            VADDHHS(R%%, S%) = VADD(R%%, S%) * LaborF(R%%, Skilled, S%)
                        '            'LABWAGES(R%%, S%, Unskilled) = VAddFromLab * LABWAGESSHRSKL(R%%, S%, Unskilled) / 100 / AMAX(0.0001, LABEMPS(R%%, S%, Unskilled))

                        VADDHHU(R%%, S%) = LABWAGES(R%%, S%, Unskilled) * LABEMPS(R%%, S%, Unskilled)
                        VADDHHS(R%%, S%) = LABWAGES(R%%, S%, Skilled) * LABEMPS(R%%, S%, Skilled)

                        '  Debug.Print RegName(R%%); ","; IY%; ","; S%; ","; LABEMPS(R%%, S%, Skilled); ","; LABEMPS(R%%, S%, Unskilled); ","; LABWAGES(R%%, S%, Skilled); ","; LABWAGES(R%%, S%, Unskilled)

                        VAddCalc = VADDHHU(R%%, S%) + VADDHHS(R%%, S%)
                        VADDHHU(R%%, S%) = VADDHHU(R%%, S%) * VADD(R%%, S%) / AMAX(0.001, VAddCalc)    ' (1 - alphas(R%%, S%))
                        VADDHHS(R%%, S%) = VADDHHS(R%%, S%) * VADD(R%%, S%) / AMAX(0.001, VAddCalc)


                        '                    VADDHHU(R%%, S%) = VADDHHU(R%%, S%) * VADD(R%%, S%) * (1 - alphas(R%%, S%)) / AMAX(0.001, VAddCalc)  ' (1 - alphas(R%%, S%))
                        '                    VADDHHS(R%%, S%) = VADDHHS(R%%, S%) * VADD(R%%, S%) * (1 - alphas(R%%, S%)) / AMAX(0.001, VAddCalc)


                        VADDHHUTot = VADDHHUTot + VADDHHU(R%%, S%)
                        VADDHHSTot = VADDHHSTot + VADDHHS(R%%, S%)


                    Next S%

                    LABWAGE(R%%, Unskilled) = VADDHHUTot / LABUnSkTot
                    LABWAGE(R%%, Skilled) = VADDHHSTot / LABSkTot

                    If LABWAGE(R%%, Skilled) / LABWAGE(R%%, Unskilled) > 1.2 Then
                        Exit Do
                    Else
                        For S% = 1 To NSec%
                            LABWAGES(R%%, S%, Skilled) = CSng(LABWAGES(R%%, S%, Skilled) * 1.05)
                        Next
                        i2 = i2 + 1
                    End If

                Loop

                For S% = 1 To NSec%
                    sLabWageS(R%%, S%, Unskilled) = LABWAGES(R%%, S%, Unskilled)
                    sLabWageS(R%%, S%, Skilled) = LABWAGES(R%%, S%, Skilled)
                Next S%


            Else  'IY%>1

                For S% = 1 To NSec%
                    LABWAGES(R%%, S%, Skilled) = sLabWageS(R%%, S%, Skilled)
                    LABWAGES(R%%, S%, Unskilled) = sLabWageS(R%%, S%, Unskilled)
                Next S%

