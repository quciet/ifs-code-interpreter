                End If




                'All But First: Compute Gender Difference and Poverty Rates by Sex
                '---------------------------------------------------------------------

                'use regression model done by Yutang to forecast gender difference in poverty in reference group (=25-34)
                'PovGndDiffRef = 2.1391 - .9123 * LabWageSexRatio  -0.6947 * EdTerEnrollGross%FtoM + 0.0583 * 100 * INCOMELTNPL0LN(R%) / POP(R%) -0.5863* GEM
                'Gender difference in percentage points = Female Poverty Rate for the age group - Male poverty rate for the age group
                'Setting the co-eff of national poverty rate to zero per BBH and DKB, thus making the whole regression relationship questionable

                If INCOMELTNPLLN(R%) = 0 Then 'no poverty
                    PovGndDiffRefAG = 0
                Else
                    'mti 2021/12/02 start

                    'old model
                    'PovGndDiffRefAGComp = 15.9283655655321 - 0 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    '+ 0.836252511514414 * Log(AMAX(0.001, CBR(R%))) - 4.81777931683614 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 7.64609858063771 * Log(AMAX(0.001, EDYRSAG20TO29(R%, Female)))

                    'new model
                    'PovGndDiffRefAGComp = -7.08408009411203 - 0 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    '+ 3.26828956352049 * Log(AMAX(0.001, CBR(R%))) - 2.6767646406953 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 6.04859617862644 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / AMAX(0.0001, EDYRSAG15(R%, Male))))

                    'mti 2021/12/09 start
                    'DKB Revision 2nd Dec, 2021
                    'PovGndDiffRefAGComp = 6.238431 - 0 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) + _
                    '2.078 * Log(AMAX(0.001, CBR(R%))) - 2 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 3.955 * Log(AMAX(0.001, EDYRSAG20TO29(R%, Female)))

                    'DKB Revision 10th Dec, 2021
                    PovGndDiffRefAGComp = CSng(-2.3428181697428 + 2.7459268337295 * Log(AMAX(0.001, GINIDOM(R%))) +
                        2.14536874195909 * Log(AMAX(0.001, 100 * POPLE15(R%) / POP(R%))) - 3.3225745577732 * Log(LABWAGESEXRAT(R%)) - 6.5717434673512 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / AMAX(0.0001, EDYRSAG15(R%, Male)))))
                    'mti 2021/12/09 End


                    PovGndDiffRefAGComp = AMAX(0, PovGndDiffRefAGComp) ' * PovGndDiffRefAGScaleUpNPL(R%))

                    If iPovGndDiffAGNPL(R%, RefAGGnd) < 0 Then
                        PovGndDiffRefAG = ConvergeOverTime(iPovGndDiffAGNPL(R%, RefAGGnd), 0, CSng(Amin(50, AMAX(10, Floor(iPovGndDiffAGNPL(R%, RefAGGnd) * 3)))))
                    Else

                        PovGndDiffRefAG = PovGndDiffRefAGComp + ConvergeOverTime(PovGndDiffRefAGShiftNPL(R%), 0, 50)  '50
                    End If

                    'mti 2021/12/02  end
                End If
                '
                'use gender gap and total (both sexes) poverty to compute female and male poverty rates - reference age group
                If POVRATENPL(R%, RefAGGnd, Total) = 0 Then
                    POVRATENPL(R%, RefAGGnd, Male) = 0
                    POVRATENPL(R%, RefAGGnd, Female) = 0
                Else

                    '           'For gender distribution of very low poverty make sure there is some poverty in each of the sexes
                    If PovGndDiffRefAG >= 0 Then
                        PovGndDiffRefAG = CSng(Amin(PovGndDiffRefAG, 1.5 * POVRATENPL(R%, RefAGGnd, Total))) '1.5

                    Else
                        PovGndDiffRefAG = CSng(AMAX(PovGndDiffRefAG, -1.5 * POVRATENPL(R%, RefAGGnd, Total)))  '-1.5
                    End If

                    'Use gender difference and total poverty to compute poverty rates for each of the sexes
                    POVRATENPL(R%, RefAGGnd, Male) = AMAX(0, (POVRATENPL(R%, RefAGGnd, Total) * POPPOVAG(R%, RefAGGnd, Total) - PovGndDiffRefAG * POPPOVAG(R%, RefAGGnd, Female)) / AMAX(0.000001, POPPOVAG(R%, RefAGGnd, Total)))
                    POVRATENPL(R%, RefAGGnd, Female) = AMAX(0, PovGndDiffRefAG + POVRATENPL(R%, RefAGGnd, Male))

                    '            'once again, make sure there is at least some poverty in each gender
                    POVRATENPL(R%, RefAGGnd, Male) = AMAX(POVRATENPL(R%, RefAGGnd, Female) * 0.2, POVRATENPL(R%, RefAGGnd, Male))
                    POVRATENPL(R%, RefAGGnd, Female) = AMAX(POVRATENPL(R%, RefAGGnd, Male) * 0.2, POVRATENPL(R%, RefAGGnd, Female))

                End If

                'Gender difference for the reference group - final
                PovGndDiffRefAG = POVRATENPL(R%, RefAGGnd, Female) - POVRATENPL(R%, RefAGGnd, Male)

                'Compute percentage change in reference group gender difference
                'mti 2021/07/15 start
                If iPovGndDiffAGNPL(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAGNPL(R%, RefAGGnd)) > 0.9 Then   'changed .2 to .9
                    'mti 2021/07/15 end
                    PcntChangeDiffRefAG = (PovGndDiffRefAG - iPovGndDiffAGNPL(R%, RefAGGnd)) / iPovGndDiffAGNPL(R%, RefAGGnd)
                Else
                    'use percentage point when initial difference is zero or small
                    PcntPointChangeDiffRefAG = PovGndDiffRefAG - iPovGndDiffAGNPL(R%, RefAGGnd)
                End If


                'Compute gender difference (and poverty rate) in other age-groups using changes in reference group gender difference
                For j% = 1 To TotPovAGCount

                    If j% <> RefAGGnd Then

                        If POVRATENPL(R%, j%, Total) = 0 Then
                            POVRATENPL(R%, j%, Male) = 0
                            POVRATENPL(R%, j%, Female) = 0
                        Else
                            'mti 2021/07/15 start - this is  new procedure anyway
                            If iPovGndDiffAGNPL(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAGNPL(R%, RefAGGnd)) > 0.9 Then   'changed .2 to .9
                                'mti 2021/07/15 end
                                PovGndDiffAG = iPovGndDiffAGNPL(R%, j%) + PcntChangeDiffRefAG * iPovGndDiffAGNPL(R%, j%)
                            Else
                                PovGndDiffAG = iPovGndDiffAGNPL(R%, j%) + PcntPointChangeDiffRefAG
                            End If

                            'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                            If PovGndDiffAG >= 0 Then
                                PovGndDiffAG = CSng(Amin(PovGndDiffAG, 1.5 * POVRATENPL(R%, j, Total)))
                            Else
                                PovGndDiffAG = CSng(AMAX(PovGndDiffAG, -1.5 * POVRATENPL(R%, j, Total)))
                            End If

                            'mti 2020/04/29 Start
                            'POVRATENPL(R%, j%, Male) = AMAX(0, (POVRATENPL(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / POPPOVAG(R%, j%, Total))
                            POVRATENPL(R%, j%, Male) = AMAX(0, (POVRATENPL(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / AMAX(0.000001, POPPOVAG(R%, j%, Total)))
                            'mti 2020/04/29 End
                            POVRATENPL(R%, j%, Female) = AMAX(0, PovGndDiffAG + POVRATENPL(R%, j%, Male))
                            '
                            'Make sure there is at least some poverty in each gender
                            POVRATENPL(R%, j%, Male) = AMAX(POVRATENPL(R%, j%, Female) * 0.2, POVRATENPL(R%, j%, Male))
                            POVRATENPL(R%, j%, Female) = AMAX(POVRATENPL(R%, j%, Male) * 0.2, POVRATENPL(R%, j%, Female))


                        End If



                    End If

                Next j%
                'mti 2020/03/18 End


                'Normalize poverty across sexes within the same age group
                'mti 2021/12/28 start
PovertyNormalizeGender(R%, POVRATENPL, POVCOUNTNPL, POVGNDRATIONPL)
    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSexNPLAllButFirst:PovertyNormalizeGender
' Private Sub PovertyNormalizeGender(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, PovGndRatioVec(,) As Single, Optional StartAG% = 1, Optional EndAG% = TotPovAGCount)
    
                'mti 2021/12/28 Take entire procedure
                'mti 2021/01/29 Take entire procedure R%%, POVRATENPL(), POVCOUNTNPL(), povnational_hc As Single
    
                'mti 2020/03/18 Whole procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
    
                Dim j As Integer, NormFac As Single
    
                For j% = StartAG% To EndAG% '1 To TotPovAGCount
                    'Debug.Print j%
                    If POVCOUNTNPL(R%%, j%, Total) = 0 Or (POVRATENPL(R%%, j%, Male) = 0 And POVRATENPL(R%%, j%, Female) = 0) Then
                        POVCOUNTNPL(R%%, j%, Male) = 0
                        POVCOUNTNPL(R%%, j%, Female) = 0
                        POVRATENPL(R%%, j%, Male) = 0
                        POVRATENPL(R%%, j%, Female) = 0
                        PovGndRatioVec(R%%, j%) = 1
    
                    Else
                        'Get headcounts by gender using rates and population by gender
                        POVCOUNTNPL(R%%, j%, Female) = POVRATENPL(R%%, j%, Female) * POPPOVAG(R%%, j%, Female) / 100
                        POVCOUNTNPL(R%%, j%, Male) = POVRATENPL(R%%, j%, Male) * POPPOVAG(R%%, j%, Male) / 100
    
                        'Compute normalization factor
                        'mti 2020/03/18 start
                        'NormFac = POVCOUNTNPL(R%%, j%, Total) / AMAX(0.0001, (POVCOUNTNPL(R%%, j%, Male) + POVCOUNTNPL(R%%, j%, Female)))
                        NormFac = POVCOUNTNPL(R%%, j%, Total) / AMAX(0.000001, (POVCOUNTNPL(R%%, j%, Male) + POVCOUNTNPL(R%%, j%, Female)))
    
    
                        'Normalize headcounts
