                        'mti 2026/06/24 end
                    End If
                    'mti 2021/12/02 End
                End If

                'mti 2020/03/18 Start
                'use gender gap and total (both sexes) poverty to compute female and male poverty rates - reference age group
                If POVRATE(R%, RefAGGnd, Total) = 0 Then
                    POVRATE(R%, RefAGGnd, Male) = 0
                    POVRATE(R%, RefAGGnd, Female) = 0
                Else

