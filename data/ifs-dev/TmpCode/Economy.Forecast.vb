                    POVCOUNT32(R%%, j%, Total) = CSng(Round(POVCOUNT32(R%%, j%, Total) * NormFac, 6))
                    If POVCOUNT32(R%%, j%, Total) < 0.000002 Then 'less than 2 poor person, make it 0
                        POVCOUNT32(R%%, j%, Total) = 0
                    End If
