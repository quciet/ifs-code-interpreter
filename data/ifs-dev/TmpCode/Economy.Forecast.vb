                    conflictind = AMAX(THREAT(R%, j%) / 100, conflictind)
                Next j

                If sfcivilwarucdpsw = 1 Then
                    conflictind = AMAX(conflictind, SFCIVILWARUCDP(R%))
                ElseIf sfcivilwarucdpsw = 3 Then 'dsb 2026/07/21
                    conflictind = AMAX(conflictind, SFCIVILWARPARDEE(R%))
                Else
                    conflictind = AMAX(conflictind, SFINTLWARALL(R%))
