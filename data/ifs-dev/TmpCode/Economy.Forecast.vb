                    For j% = 1 To TotPovAGCount
                        POVRATE365(R%%, j%, Total) = 0
                        POVCOUNT365(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NormFac = CSng(INCOMELT365LN(R%)) / NonNormTot
    
                POVCOUNT365(R%%, TotPovAGCount, Total) = CSng(INCOMELT365LN(R%)) '0  'CSng(INCOMELT365LN(R%))
    
                Dim AllAgeGroupButChild As Single
