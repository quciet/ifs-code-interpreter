                '            ICTCYBBENEFIT(R%) = (0.3 + 0.033337 * (ICTINDEX(R%) - 1)) * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 4 Then 'upper middle income average 3.7l; drop to  0.15 (.35-.1333 * 1.5)
                '            ICTCYBBENEFIT(R%) = (0.35 - 0.133 * (ICTINDEX(R%) - 2.5)) * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 7 Then 'high income is 6.7; leave at 0.15
                '            ICTCYBBENEFIT(R%) = (0.15 + 0# * (ICTINDEX(R%) - 4)) * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         Else
                '           ICTCYBBENEFIT(R%) = 0.15 * sgdpr1(R%) * ictcybbenefitm(R%)
                '         End If
                '
                '         'ICTCYBBENEFIT(R%) = ICTCYBBENEFIT(R%) * Amin(2, AMAX(0.5, ICTINDEX(R%) / ICTINDEXExp))
                '         ICTCYBBENEFIT(R%) = ICTCYBBENEFIT(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)


                If ICTINDEX(R%) >= ICTINDEXExp Then
                    ICTCYBOPCOST(R%) = 0
                Else
                    'ICTCYBOPCOST(R%) = ICTCYBBENEFIT(R%) * AMAX(0.5, (1 - ICTINDEX(R%) / ICTINDEXExp))
                    ICTCYBOPCOST(R%) = ICTCYBBENEFIT(R%) * (ICTINDEXExp - ICTINDEX(R%)) / 10
                End If

                'ICTCONSURPLUS(R%) = 0.07 * sgdpr1(R%) * ictconsurplusm(R%)

                '         If ICTINDEX(R%) < 1 Then 'low-income countries ictindex average=1.4 ; set at .3 * moving average GDPR
                '            ICTCONSURPLUS(R%) = 0.1 * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 2.5 Then 'lower-middle-income average 2.3 ; leave at .1)
                '            ICTCONSURPLUS(R%) = (0.1 + 0# * (ICTINDEX(R%) - 1)) * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 4 Then 'upper middle income average 3.7l; leave at .1)
                '            ICTCONSURPLUS(R%) = (0.1 - 0# * (ICTINDEX(R%) - 2.5)) * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 7 Then 'high income is 6.7; take to .04;( 0.1- .02* 3)
                '            ICTCONSURPLUS(R%) = (0.1 - 0.02 * (ICTINDEX(R%) - 4)) * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         Else
                '           ICTCONSURPLUS(R%) = 0.04 * sgdpr1(R%) * ictconsurplusm(R%)
                '         End If
                '
                ''If RegName(R%) = "China" Then Stop
                '
                '        ' ICTCONSURPLUS(R%) = ICTCONSURPLUS(R%) * Amin(2, AMAX(0.5, ICTINDEX(R%) / ICTINDEXExp))
                '         ICTCONSURPLUS(R%) = ICTCONSURPLUS(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)

                If ICTINDEX(R%) < ICTINDEXExp Then
                    'ICTCYBOPCOST(R%) = ICTCYBOPCOST(R%) + ICTCONSURPLUS(R%) * AMAX(0.5, (1 - ICTINDEX(R%) / ICTINDEXExp))
                    ICTCYBOPCOST(R%) = ICTCYBOPCOST(R%) + ICTCONSURPLUS(R%) * (ICTINDEXExp - ICTINDEX(R%)) / 10
