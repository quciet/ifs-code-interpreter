                'If extreme initial descrepancies this helps resolve them (e.g. bad data)
                'Call ADJSTR(GDPPOT(R%), Diff1, Diff2, elgexpdebt1, elgexpdebt2, Mul)

                'mulexp(R%) = mulexp(R%) * Mul
                'bbh 2015/03/25 start Pass through some of tax adjustment form informal GDP; is flow, and mulexp a stock

                'mti 2015/06/09 - start
                'Note for BBH: Shadow Economy not using any multiplier now

                'mti test
                'bbh 2022/06/23 start introduction of response of govt expenditures to interest rates
                '            'Takes some of the response needed when stocks are low away from all on C/GDP
                'Although some substantial swings in GOVCON, very limited in C/GDP so backed up but leaving code option
                '        Diff1 = INTR(R%) - INTRI(R%)
                '        Diff2 = INTR(R%) - SIntr(R%)
                '        Call ADJSTR(10, Diff1, Diff2, -0.1, -0.2, MulIntr)

                mulexp(R%) = mulexp(R%) * Mul '* MulIntr
                'If RegName(R%) = "Libya" And IY% + 2017 >= 2022 Then Stop   'bbh 2022/08/22
                'mulexp(R%) = mulexp(R%) * Mul / 2
                SSINTR(R%) = SIntr(R%) 'I see no place where it is actually used any more
                SIntr(R%) = INTR(R%)
                'bbh 2022/06/23 end introduction of response of govt to interest rates

                'mti 2016/11/02 Start
                'The following code seem to drive expenditure, and subsequently revenue, very high; try it with a much lower denominator than 5?
                If gdpshadowon = 0 Then

                    If gdpinformshrm(R%) <> 1 Then
                        mulexp(R%) = mulexp(R%) * (1 + (TaxInfAdjustmentFac(R%) - 1) / 10)  '5
                    End If


                Else 'If gdpshadowon = 1 Then

                    If gdpshadowshrm(R%) <> 1 Then
                        mulexp(R%) = mulexp(R%) * (1 + (TaxInfAdjustmentFac(R%) - 1) / 10)  '5
                    End If
                    '
                    '
                End If
                'mti 2016/11/02 End
                'mti 2015/06/09 - end
                'bbh 2015/03/25 end
                'If RegName$(R%) = "China" Then Stop

                'MulGovCon(R%) = MulGovCon(R%) * Mul

                '   All But First 5:  Adjustment multipliers for expenditures, targeting government consumption
                '   -------------------------------------------------------------------------------------------

                '        If frm_MainMenu.IFsGUIctrl1.cHistoricBase = True Then
                '            TBName$ = "GDP/Capita (PPP) Versus Govt Cons % GDP (1960)"
                '            Call XYTABL(TBName$, GDPPCP(R%), NormGovtDebt)
                '        Else
                '            TBName$ = "GDP/Capita (PPP) Versus Govt Cons % GDP (2000)"
                '            Call XYTABL(TBName$, GDPPCP(R%), NormGovtDebt)
                '        End If
                '        Call XYTABL(TBName$, GDPPCP(R%), GovConComp)
                '        GovConTarget% = ConvergeOverTime(GovConRGDPI(R%), GovConComp, 100)
                '                    'Base, Target, Years
                '        Diff1 = GOVCON(R%) / GDPPOT(R%) * 100 - GovConTarget%
                '        Diff2 = Diff1 - SGovConImbalance(R%)
                '        SGovConImbalance(R%) = Diff1
                '        Call ADJSTR(GDPPOT(R%), Diff1, Diff2, -0.1, -0.2, Mul)
                '        MulGovCon(R%) = MulGovCon(R%) * Mul  Not being used

                '   bbh 2019/10/15 start
                '   All But First 5:  Tariff revenue shift from Dyadic calcuation
                '   --------------------------------
                If bilateralsw > 0 Then
                    'SMTariffRevTotDyadic(R%) = 0
                    For S% = 1 To NSec%
                        'SMTariffRevTotDyadic(R%) = SMTariffRevTotDyadic(R%) + MTARIFFREV(R%, S%)
                        'bbh 2019/10/25 bound revenues from dyadic side from going negative
                        MTARIFFREV(R%, S%) = AMAX(0, MTARIFFREV(R%, S%) - MTariffRevShift(R%, S%))
                        MTARIFFTAXR(R%, S%) = MTARIFFREV(R%, S%) / AMAX(0.001, MS(R%, S%)) * 100
                        SMTariffTaxR(R%, S%) = MTARIFFTAXR(R%, S%)
                        XTARIFFTAXR(R%, S%) = XTARIFFREV(R%, S%) / AMAX(0.001, XS(R%, S%)) * 100
                        SXTariffTaxR(R%, S%) = XTARIFFTAXR(R%, S%)
                        SMTariffRev(R%, S%) = MTARIFFREV(R%, S%) 'dkb 2019/10/22
                    Next S%
                Else
                    'SMTariffRevTotDyadic(R%) = 0 'will not be used in next time step becuase dyadic is not on
                    For S% = 1 To NSec%
                        SMTariffTaxR(R%, S%) = MTARIFFTAXR(R%, S%)
                        XTARIFFREV(R%, S%) = 0
                        SXTariffTaxR(R%, S%) = 0
                    Next S%
                    'bbh 2019/10/15 end
                End If

                '   All But First 5: GDP Derivative Calculation
                '   -------------------------------------------------

                '        If GDP(R%) < 0.01 Then GDP(R%) = 0.01
                '        GDPPOT(R%) = GDPPOT(R%) - (GDPPOT(R%) - GDP(R%)) * elasit
                '        If GDPPOT(R%) < 0.001 Then GDPPOT(R%) = 0.001
                If GDPRPA(R%) < 0.01 Then
                    GDPRPA(R%) = 0.01
                End If
                GDPPOTRPA(R%) = GDPPOTRPA(R%) - (GDPPOTRPA(R%) - GDPRPA(R%)) * elasit
                If GDPPOTRPA(R%) < 0.001 Then
                    GDPPOTRPA(R%) = 0.001
                End If

                'mti 2016/07/16 End - Balancing after GOVCON adjustment, if any, in SOCIOPOL

                ' If RegName(R%) = "Benin" Then Stop

            Next R%
            'GoTo AllSteps->            
Call ifsECOSAMAllYears(context)
' ---- Begin Inlined Level 1: ifsECOSAMAllYears
' Public Sub ifsECOSAMAllYears(context As IForecastContext)
            'gvdb 2024/04/05
            ' unused variable
            'Dim rpaadj, firmsavadj, govbaladj As Single
            Dim hhfirmsavr As Single
            Dim Diff1, Diff2, Mul, HHSAVENEEDUSE As Single
            Dim HHFirmSavTarget As Single 'bbh 2020/07/01

            For R% = 1 To NR%


                '   All Steps:  Savings
                '   -------------------

                'If RegName$(R%) = "China" Then Stop
                'bbh 2020/07/01 start
                '        HHSAV(R%, Unskilled) = HHINC(R%, Unskilled) - _
                '            consumhh(R%, Unskilled) - HHTAX(R%, Unskilled) _
                '                - HHGOVSS(R%, Unskilled)
                '        'If XWORKREMIT(R%) > 0 Then HHSAV(R%, Unskilled) = HHSAV(R%, Unskilled) + XWORKREMIT(R%)
                '        HHSAV(R%, Skilled) = HHINC(R%, Skilled) - _
