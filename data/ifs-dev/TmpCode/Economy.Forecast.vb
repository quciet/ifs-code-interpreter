                    KS(R%, S%) = IDS(R%, S%) / (kgrocomps(S%) + kdrate)
                    WAGES(R%, S%) = VADD(R%, S%) * (1 - alphas(R%, S%)) / AMAX(0.01, LABS(R%, S%))
