    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex830FirstYear:PovertyNormalizeAgeGroup
' Private Sub PovertyNormalizeAgeGroup(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, povnational_hc As Single)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - take entire procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
                'gvdb 2024/04/05
                ' unused variable
                Dim j As Integer, NormFac As Single, NonNormTot As Single 'gndr As Integer,
    
                If CSng(POVMIDHIGH(R%)) < 0.000002 Then    'no poor or less than 2 poor in total, make it 0
                    POVCOUNT830(R%%, TotPovAGCount, Total) = 0
                    POVRATE830(R%%, TotPovAGCount, Total) = 0
                    For j% = 1 To TotPovAGCount
                        POVRATE830(R%%, j%, Total) = 0
                        POVCOUNT830(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NonNormTot = 0
                For j% = 1 To TotPovAGCount - 1 'Last elenment is all ages
                    POVCOUNT830(R%%, j%, Total) = AMAX(0, POVRATE830(R%%, j%, Total) * POPPOVAG(R%%, j%, Total) / 100)
                    NonNormTot = NonNormTot + POVCOUNT830(R%%, j%, Total) 'POVRATE830(R%%, j%, Total) * POPPOVAG(R%%, j%, Total) / 100
                Next
    
                If NonNormTot = 0 Then
                    POVCOUNT830(R%%, TotPovAGCount, Total) = 0
                    POVRATE830(R%%, TotPovAGCount, Total) = 0
                    For j% = 1 To TotPovAGCount
                        POVRATE830(R%%, j%, Total) = 0
                        POVCOUNT830(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NormFac = CSng(POVMIDHIGH(R%)) / NonNormTot
    
                POVCOUNT830(R%%, TotPovAGCount, Total) = CSng(POVMIDHIGH(R%)) '0  'CSng(POVMIDHIGH(R%))
    
                Dim AllAgeGroupButChild As Single
                AllAgeGroupButChild = 0
                For j% = 2 To TotPovAGCount - 1
                    'age groups other than All Ages
                    POVCOUNT830(R%%, j%, Total) = CSng(Round(POVCOUNT830(R%%, j%, Total) * NormFac, 6))
                    If POVCOUNT830(R%%, j%, Total) < 0.000002 Then 'less than 2 poor person, make it 0
                        POVCOUNT830(R%%, j%, Total) = 0
                    End If
                    'mti 2020/04/29 start
                    'POVRATE830(R%%, j%, Total) = 100 * POVCOUNT830(R%%, j%, Total) / POPPOVAG(R%%, j%, Total)
                    POVRATE830(R%%, j%, Total) = 100 * POVCOUNT830(R%%, j%, Total) / AMAX(0.000001, POPPOVAG(R%%, j%, Total))
                    'mti 2020/04/29 End
                    AllAgeGroupButChild = AllAgeGroupButChild + POVCOUNT830(R%%, j%, Total)
                Next
    
                'give the remaining, if any to 0-14 group
                POVCOUNT830(R%%, 1, Total) = CSng(AMAX(0, Round(POVCOUNT830(R%%, TotPovAGCount, Total) - AllAgeGroupButChild, 6)))
                'mti 2020/04/29 start
                'POVRATE830(R%%, 1, Total) = 100 * POVCOUNT830(R%%, 1, Total) / POPPOVAG(R%%, 1, Total)
                POVRATE830(R%%, 1, Total) = 100 * POVCOUNT830(R%%, 1, Total) / AMAX(0.000001, POPPOVAG(R%%, 1, Total))
    
                'POVRATE830(R%%, TotPovAGCount, Total) = 100 * POVCOUNT830(R%%, TotPovAGCount, Total) / POPPOVAG(R%%, TotPovAGCount, Total)
                POVRATE830(R%%, TotPovAGCount, Total) = 100 * POVCOUNT830(R%%, TotPovAGCount, Total) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Total))
                'mti 2020/04/29 End
' End Sub
