                    PRI(R%, S%) = 1.0!
                    spri(R%, S%) = 1.0!
                Next S%
                SSPREN(R%) = 1.0!
                ImportRI(R%) = ProductivityImports / ProductivityImpBase
                SImportr(R%) = ImportRI(R%)
                ' BBH 7/22/04 End V5_02
