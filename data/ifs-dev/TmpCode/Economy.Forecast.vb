    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex420FirstYear:PovertyAdjGenderRatio
' Private Sub PovertyAdjGenderRatio(R%, PovRateVec(,,) As Single, AGCount As Integer)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - new procedure
                '(R%%, POVRATE420(), PovCountVec(), povnational_hc As Single)
                Dim AdjPovDiff As Single
                Dim j%
    
                'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                For j% = 1 To TotPovAGCount
                    If POVRATE420(R%%, j, Female) - POVRATE420(R%%, j, Male) > 1.5 * POVRATE420(R%%, j, Total) Then
                        AdjPovDiff = CSng((POVRATE420(R%%, j, Female) - POVRATE420(R%%, j, Male)) - 1.5 * POVRATE420(R%%, j, Total))
                        POVRATE420(R%%, j, Female) = POVRATE420(R%%, j, Female) - AdjPovDiff / 2
                        POVRATE420(R%%, j, Male) = POVRATE420(R%%, j, Male) + AdjPovDiff / 2
                    ElseIf POVRATE420(R%%, j, Female) - POVRATE420(R%%, j, Male) < -1.5 * POVRATE420(R%%, j, Total) Then   '1.5
                        AdjPovDiff = CSng((POVRATE420(R%%, j, Female) - POVRATE420(R%%, j, Male)) + 1.5 * POVRATE420(R%%, j, Total))
                        POVRATE420(R%%, j, Female) = POVRATE420(R%%, j, Female) + AdjPovDiff / 2
                        POVRATE420(R%%, j, Male) = POVRATE420(R%%, j, Male) - AdjPovDiff / 2
                    End If
    
                    '           'make sure there is at least some poverty in each gender
                    POVRATE420(R%%, j%, Male) = AMAX(POVRATE420(R%%, j%, Female) * 0.2, POVRATE420(R%%, j%, Male))
                    POVRATE420(R%%, j%, Female) = AMAX(POVRATE420(R%%, j%, Male) * 0.2, POVRATE420(R%%, j%, Female))
    
                Next j%
    
' End Sub
