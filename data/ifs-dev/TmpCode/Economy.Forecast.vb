                Diff1 = SHHSavSurStock(R%) / 25
                Diff2 = (SHHSavSurStock(R%) - SavSHHSavSurStock(R%)) / 25

                'bbh 2021/09/09 Tried lower PID elasticities to smooth C/GDP, but no real impact; went back to higher ones
                'Call ADJSTR(GDP(R%), Diff1, Diff2, 0.05, 0.1, Mul)
                Call ADJSTR(GDP(R%), Diff1, Diff2, 0.1, 0.2, Mul)
                'jrs 2024/09/26
                'If IY >= 80 Then
                '    Mul = 1
                'End If

                'bbh 2021/07/07 In the logic above, there was a signficant jump in HHRETIRENEED(R%) for the US in 2020 that led to a value here
                '   that subsantiall lowered the computation of C in 2021 and set up descrepancies in savings and investment; turned off the impact of SHHSAVSURSTOCK
                '   by adding the next line, Mul=1;but later found other issues causing the problem so commented it out;
                '   may wish to turn on again if do pension related work for high-income countries and find issues around C behavior
                'Mul = 1 'bbh 2021/09/21 Still again proved not to be an issue to have active Mul here, so reset to active after testing 1 again
                'consumhh(R%, Unskilled) = hhdispincperm(R%, Unskilled) * CRaI(R%, Unskilled)
                'consumhh(R%, Skilled) = hhdispincperm(R%, Skilled) * CRaI(R%, Skilled)
                'bbh 2020/08/26 start
                consumhh(R%, Unskilled) = hhincunskilled * scra(R%, Unskilled) * Mul
                If consumhh(R%, Unskilled) < 0 Then
                    Stop
                End If
                'consumhh(R%, Unskilled) = hhdispincperm(R%, Unskilled) * scra(R%, Unskilled) * Mul
