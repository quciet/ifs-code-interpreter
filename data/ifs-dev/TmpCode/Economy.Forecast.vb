                        '                If sxkav(R%, S%) + smkav(R%, S%) > 1 Then
                        '                        'Scale back big traders (e.g. H Kong)
                        '                    elxpr1adj = elxpr1 * (1 / (sxkav(R%, S%) + smkav(R%, S))) ^ 2
                        '                    elmpr1adj = elmpr1 * (1 / (sxkav(R%, S%) + smkav(R%, S))) ^ 2
                        '                    elxpr2adj = elxpr2 * (1 / (sxkav(R%, S%) + smkav(R%, S))) ^ 2
                        '                    elmpr2adj = elmpr2 * (1 / (sxkav(R%, S%) + smkav(R%, S))) ^ 2
                        ''                ElseIf SXKAV(r%, s%) + SMKAV(r%, s%) < 1 Then
                        '                        'Scale up smaller traders (e.g. US)
