                sedyrsag15(R%) = EDYRSAG15(R%, 3) 'For year 2
                EDYRSAG15I(R%) = EDYRSAG15(R%, 3) 'bbh 2020/04/18
                'If RegName$(R%) = "China" Then Stop
                hlexpcontrib = (GDS(R%, Health) / GDP(R%) * 100 - HlExpComp) * mfphlspn '0.3
                lifeexpcontrib = (LIFEXP(R%, 3) - lifeexpcomp) * mfplife 'bbh 2019/05/24 changed from 0.1 to 0.0
                'jrs 2016/12/01 stuntcontrib = (HLSTUNT(R%) - stuntingcomp) * mfpstunt
                stuntcontrib = (HLSTUNTWORK(R%) - stuntingcomp) * mfpstunt

                'mti 2014/03/27 - start
edVoccontrib = R + eEDSECLOWRVOCTot(R) + eEDSECUPPRVOCTot(R) + sEDSECLOWRVOCTot(R) + sEDSECUPPRVOCTot(R) + sedVocContrib(R) + EDSECLOWRVOC + EDSECUPPRVOC + mfpedvoc @@edVoccontrib = VocContrib(R, eEDSECLOWRVOCTot(R), eEDSECUPPRVOCTot(R), sEDSECLOWRVOCTot(R), sEDSECUPPRVOCTot(R), sedVocContrib(R))@@

                'jrs 2013/11/15 MFPHC(R%) = edexpcontrib + edyrscontrib + stuntcontrib + disabcontrib '+ hlexpcontrib + lifeexpcontrib
                'mti 2018/01/18 start
                'MFPHC(R%) = edexpcontrib + edyrscontrib + stuntcontrib + disabcontrib + lifexpedyrsboost + edVoccontrib 'adding life expectancy boost directly
                'bbh 2019/05/24 added lifexpcontrib back into this and removed lifexpedyrsboost
MFPHC(R%) = edexpcontrib + edyrscontrib + stuntcontrib + disabcontrib + lifeexpcontrib + edVoccontrib  + R% + sEdQualAg15(R%) + context + EDQUALAG15 + mfpedqual @@MFPHC(R%) = edexpcontrib + edyrscontrib + stuntcontrib + disabcontrib + lifeexpcontrib + edVoccontrib + EdQualContrib(R%, sEdQualAg15(R%), context)@@
                'If RegName$(R%) = "Nigeria" Then Stop

                'mti 2018/01/18 End
                'mti 2014/03/27 - end

                '   First Year 2:  Compute Contributions of Multiple Factors to MFPSC
                '   -----------------------------------------------------------------
                'bbh 2011/04/09 start
                '         energyterm = ENX(R%) * WEPBYEAR / GDP(R%)
                'bbh 2011/04/30
                energydepend(R%) = ENX(R%) * ENPRI(R%) / GDP(R%)
                If context.HistoricMode = True Then
                    Call XYTABL("GDP/Capita (PPP) Versus Freedom -Logged And Inverted (Earliest)",
                    GDPPCP(R%), FreeComp, context)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Economic Freedom (1970)", _
                    '                GDPPCP(R%), econfreecomp)
                Else
                    'jrs 2013/11/28
                    '            Call AnalFunc("Feeedom (Inverted) With GDPPCP And EdYears 15 (2005)", _
                    '                Array(GDPPCP(R%), EDYRSAG15(R%, 3)), FreeComp)
