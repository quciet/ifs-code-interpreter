                    EmplGap = LAB(R%) - sumld
                    LABUNEMPR(R%) = EmplGap / LAB(R%) 'Temporary but real, allowing negative unemployment
                    labunemprtrgtyr(R%) = 50
                    LabUnEmplTar = ConvergeOverTime(LABUNEMPRi(R%), LabUnEmpRateTarget(R%), labunemprtrgtyr(R%)) / 100
                    sLABWAGEIND(R%) = CSng(1 + (LabUnEmplTar - LABUNEMPR(R%)) * 0.5)
                    sLABWAGEIND(R%) = AMAX(0.5, Amin(3, sLABWAGEIND(R%))) 'bbh 2021/11/26 Constraints are just beyond 2100 extremes in market switch off Base

                    Dim Diffl1 = LabUnEmplTar - LABUNEMPR(R%)
                    '        If IY% = 2 Then sLabUnEmplDeviation(R%) = Diffl1
                    '        Diffl2 = Diffl1 - sLabUnEmplDeviation(R%)
                    '        sLabUnEmplDeviation(R%) = Diffl1
                    LABUNEMPR(R%) = AMAX(1, 100 * EmplGap / LAB(R%))  'Cleaned up unemployment, limit to 1% and above
                    '        elwageunemp1 = -0.2 '-0.4
                    '        elwageunemp2 = -0.4 '-0.8
                    '        Call ADJSTR(1, Diffl1, Diffl2, elwageunemp1, elwageunemp2, Mull)

                    Dim Mull = -Diffl1 * 0.5
                    'Mull = AMAX(-0.1, Amin(0.1, Mull))
                    'Mull = AMAX(-0.2 * Mullw(R%), Amin(0.2, Mull * Mullw(R%)))
                    Mull = AMAX(-0.2 * mullw(R%), Amin(0.2 * mullw(R%), Mull))
                    'Mullw(R%) = Mullw(R%) * Mull
                    mullw(R%) = CSng(mullw(R%) + Mull)



                    '        If IY% = 2 Then MullSmooth(R%) = Diffl1 * 0.5
                    '        MullSmooth(R%) = 0.8 * MullSmooth(R%) + 0.2 * Diffl1
                    '        Mullw(R%) = Mullw(R%) - MullSmooth(R%)

                    'If RegName(R%) = "Chad" And IY% >= 65 Then Stop

                    'mti 2018/03/20 End

                    '   All but First 1:  Having used labor pressure above for price signal; adjust to maximum unemployment rate
                    '   ---------------------------------------------------------------------------------------------------------
                    '   Otherwise, labor demand (labor force) growth can set up a positive feedback loop with SSVADD

                    'MinUnempl = LABUNEMPRi(R%)
                    'mti 2017/11/06 start
                    ' If RegName$(R%) = "United States Of America" And IY% > 5 Then Stop
                    '==============================
                    'If IY% >= 29 And RegName(R%) = "Uganda" Then Stop
                    If sumld > 0.99 * LAB(R%) Then
                        For S% = 1 To NSec%
                            LABDEMS(R%, S%, Unskilled) = CSng(LABDEMS(R%, S%, Unskilled) * 0.99 * LAB(R) / sumld)
                            LABDEMS(R%, S%, Skilled) = CSng(LABDEMS(R%, S%, Skilled) * 0.99 * LAB(R) / sumld)
                        Next S%
                        sumld = 0
                        For S% = 1 To NSec%
                            sumld = sumld + LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)
                        Next S%
                    End If
                    '============================


                    'bbh 2021/09/30 start block on upward shocks
                    '   All but First 1:  Need to prevent major upward shocks in labor demand for ag when gdprext has big drops and GDPPCP post gdprext is below base year
                    '   --------------------------------------------------------------------------------------------------------------------------------------------------

                    'If IY% >= 15 And RegName(R%) = "Guinea Bissau" Then Stop
                    Dim RatioAgLabDem = (LABDEMS(R%, 1, Unskilled) + LABDEMS(R%, 1, Skilled)) / sumld
                    If RatioAgLabDem > (sShr_Agri(R%) + 0.05) Or RatioAgLabDem > (iShr_Agri(R%) + 0.1) Then
                        'If (LABDEMS(R%, 1, Unskilled) + LABDEMS(R%, 1, Skilled)) / sumld > iShr_Agri(R%) Then
                        Dim SurpAgLabDem = sumld * AMAX(RatioAgLabDem - (sShr_Agri(R%) + 0.05), (RatioAgLabDem - (iShr_Agri(R%) + 0.1)))
                        'SurpAgLabDem = (RatioAgLabDem - iShr_Agri(R%)) * sumld
                        LABS(R%, 1) = LABDEMS(R%, 1, Unskilled) + LABDEMS(R%, 1, Skilled)
                        LABDEMS(R%, 1, Unskilled) = CSng(LABDEMS(R%, 1, Unskilled) - SurpAgLabDem * LABDEMS(R%, 1, Unskilled) / LABS(R%, 1))
                        LABDEMS(R%, 1, Skilled) = CSng(LABDEMS(R%, 1, Skilled) - SurpAgLabDem * LABDEMS(R%, 1, Skilled) / LABS(R%, 1))
                        NonAgLabDemSum = 0
                        For S% = 2 To NSec%
                            NonAgLabDemSum = NonAgLabDemSum + LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)
                        Next S%
                        For S% = 2 To NSec%
                            For sk% = 1 To 2
                                LABDEMS(R%, S%, sk%) = CSng(LABDEMS(R%, S%, sk%) + LABDEMS(R%, S%, sk%) * SurpAgLabDem / NonAgLabDemSum)
                            Next sk%
                        Next S%
                    End If
                    'bbh 2021/09/30 end block on upward shocks

                    'If IY% >= 15 And RegName(R%) = "Guinea Bissau" Then Stop


                    '   All but First 1:  If Labor Market is On, Allow Demand to Drive Production Function, Else Supply
                    '   ----------------------------------------------------------------------------------------------
                    '   Turn on labor market only when willng to have demand swings drive ecoonomy

                    If labmarketsw = 1 Then 'labor market on; demand swings will drive production
                        For S% = 1 To NSec%
                            LABS(R%, S%) = LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled) 'LABDEMS(R%, S%)
                        Next S%
                    Else  'labor market off; supply normalized to demand pattern
                        'bbh 2020/04/18 start
                        '            sumld = 0 bbh 2020/12/27 jrs 2021/01/06 I added this comment, not marked by Barry
                        '            For S% = 1 To NSec% 'bbh 2020/12/27 new loop to test if labor demand change is growth driver
                        '                LABDEMS(R%, S%, Unskilled) = LABDEMSI(R%, S%, Unskilled)
                        '                LABDEMS(R%, S%, Skilled) = LABDEMSI(R%, S%, Skilled)
                        '                sumld = sumld + LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)
                        '            Next S%
                        For S% = 1 To NSec%
                            'mti 2018/08/15 start
                            'LABUNEMPR(R%) = LabUnEmpRateTarget(R%)

                            '                LABUNEMPR(R%) = 10
                            '                UNEMPR(R%) = LABUNEMPR(R%) / 100
                            '                UNEMPL(R%) = LAB(R%) * UNEMPR(R%)
                            '                LABS(R%, S%) = AMAX(0.0001, LAB(R%) * (1 - UNEMPR(R%)) * labsf(R%, S%))
                            '                sumld = AMAX(0.0001, (LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)))
                            '                LABDEMS(R%, S%, Unskilled) = LABDEMS(R%, S%, Unskilled) * LABS(R%, S%) / sumld
                            '                LABDEMS(R%, S%, Skilled) = LABDEMS(R%, S%, Skilled) * LABS(R%, S%) / sumld

                            LABUNEMPR(R%) = LABUNEMPRi(R%) * labunemprm(R%) 'bbh 2021/09/30
                            LabUnEmplTar = ConvergeOverTime(LABUNEMPRi(R%), LabUnEmpRateTarget(R%), labunemprtrgtyr(R%)) * labunemprm(R%)
                            If LabUnEmplTar <> LABUNEMPR(R%) Then
                                LABUNEMPR(R%) = LabUnEmplTar
                            End If
                            UNEMPR(R%) = LABUNEMPR(R%) / 100
                            UNEMPL(R%) = LAB(R%) * UNEMPR(R%)

                            'sumld = AMAX(0.0001, (LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)))
                            'jrs 2020/06/27 If IY = 7 And GRPS(1, R) = "China" And S = 5 Then Stop
                            LABDEMS(R%, S%, Unskilled) = LABDEMS(R%, S%, Unskilled) * AMAX(0.0001, LAB(R%) * (1 - UNEMPR(R%))) / sumld
                            LABDEMS(R%, S%, Skilled) = LABDEMS(R%, S%, Skilled) * AMAX(0.0001, LAB(R%) * (1 - UNEMPR(R%))) / sumld
                            LABS(R%, S%) = LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)
                            'If IY% >= 10 And RegName(R%) = "Taiwan" And S% = 1 Then Stop
                            'bbh 2020/04/18 end

                            'cjm 2025/04/15 start
                            LABSIDLE(R%, S%) = LABS(R%, S%) * labempidleper(R%, S%) 'Where the labempidleper default is 0, can be up to 100
                            sLABSIDLE(R%, S%) = LABSIDLE(R%, S%)
                            LABS(R%, S%) = LABS(R%, S%) - LABSIDLE(R%, S%) 'Overwriting labor by sector, subtracting the idle workers
                            'jrs 2025/06/09
                            'LABDEMS(R%, S%, Unskilled) = LABDEMS(R%, S%, Unskilled) - LABSIDLE(R%, S%) * LABDEMS(R%, S%, Unskilled) / (LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled))
                            'LABDEMS(R%, S%, Skilled) = LABDEMS(R%, S%, Skilled) - LABSIDLE(R%, S%) * LABDEMS(R%, S%, Skilled) / (LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled))
                            'cjm 2025/04/15 end
                        Next
                    End If

                    'mti 2018/05/07 Start
                    'mti 2018/05/22 Start
                    For S% = 1 To NSec%
                        For sk% = 1 To 2
                            LABEMPS(R%, S%, sk%) = LABDEMS(R%, S%, sk%)
                        Next sk%
                        LABCOEFFS(R%, S%, NSkill%) = LABCOEFFS(R%, S%, Unskilled) + LABCOEFFS(R%, S%, Skilled)
                        LABDEMS(R%, S%, NSkill%) = LABDEMS(R%, S%, Unskilled) + LABDEMS(R%, S%, Skilled)
                        LABEMPS(R%, S%, NSkill%) = LABEMPS(R%, S%, Unskilled) + LABEMPS(R%, S%, Skilled)

                        'mti 2018/10/01 Start
                        sLABS(R%, S%) = LABS(R%, S%)
                        'mti 2018/10/01 End

                    Next S%

                    'bbh 2021/09/30 To help with bound of ag labor future years
                    sShr_Agri(R%) = (LABDEMS(R%, Agri, Unskilled) + LABDEMS(R%, Agri, Skilled)) / (LAB(R%) * (1 - LABUNEMPR(R%) / 100))

                    'bbh 2021/09/30 end very long block of changes 2 ******* all the way to informal economy treatment
                    '   search for 2 ******* to find the top of it


                    '   All But First 1:  Set up for informal economy
                    '   ---------------------------------------------

                    '        egdppcp = SGDPPOTPCDALF(R%) * (1 + igdpr(R%)) / POP(R%)
                    egdppcp = SGDPPOTPCDALF(R%) * (1 + IGDPRCor(R%)) / POP(R%)
                    '        GDPPCP(R%) = egdppcp 'Temp Calculation for function
                    'GDPPCP(R%) = SGDPP(R%) * (1 + igdpr(R%)) / POP(R%)
                    GDPPCP(R%) = sgdpp(R%) * (1 + IGDPRCor(R%)) / POP(R%)

                    'mti 2014/11/27 -  start

                    '   All But First 1:  Informal Economy Labor Share
                    '   ----------------------------------------------

                    '      If RegName$(R%) = "Singapore" Then Stop
                    '
                    'Informal Labor Share Model

                    'Smoothing of GDP to take care of transients in the first few years coming from IMF data
                    gdplastyr = CSng(SGDP(R%) * 0.2 + ssGDP(R%) * 0.8)

                    'Multiple regression model DKB : (TotalTaxrate replaced with FIRMTAXR which is very different)

                    'mti 2015/01/20 - start
                    'labinformal = 113.96 - 2.402 * sedyrsag15(R%) - 2.24 * Sqr(100 * sgds(R%, RandD) / gdplastyr) - 1.6 * (100 * sgovhhtrn(R%) / gdplastyr) _
                    '- 12.19 * sgovbusregind(R%) + 11.06 * Log(sfirmtaxr(R%))
                    'mti 2015/03/04 - start
                    'labinformal = labinformcoeffintercept + labinformcoeffed * sedyrsag15(R%) + labinformcoeffRanD * Sqr(100 * sgds(R%, RandD) / gdplastyr) + labinformcoeffhhtrn * (100 * sgovhhtrn(R%) / gdplastyr) _
                    '+ labinformcoeffbus * sgovbusregind(R%) + labinformcoefftax * Log(sfirmtaxr(R%))
                    ' If RegName(R%) = "Turkmenistan" Then Stop
                    'bbh 2019/07/21 start
                    'labinformal = labinformcoeffintercept + labinformcoeffed * sedyrsag15(R%) _
                    '+ labinformcoeffhhtrn * (100 * sgovhhtrn(R%) / gdplastyr) _
                    '+ labinformcoeffbus * sgovbusregind(R%) + labinformcoefftax * Log(sfirmtaxr(R%))

                    'labinformal = labinformcoeffintercept + labinformcoeffed * sedyrsag15(R%) _
                    ' + labinformcoeffhhtrn * (100 * sgovhhtrn(R%) / gdplastyr) _
                    '+ labinformcoeffbus * sgovbusregind(R%) + labinformcoefftax * Log(AMAX(1.001, sfirmtaxr(R%)))

                    'labinformcoefftax = 5
                    LabInfEducTerm = labinformcoeffed * (sedyrsag15(R%) - iLabInfEducTerm(R%))
                    LabInfTransTerm = labinformcoeffhhtrn * ((100 * sgovhhtrn(R%) / gdplastyr) - iLabInfTransTerm(R%))
                    LabInfBusRegTerm = labinformcoeffbus * (sgovbusregind(R%) - iLabInfBusRegTerm(R%))
                    LabInfFirmTaxTerm = CSng(labinformcoefftax * (Math.Log(AMAX(1.001, sfirmtaxr(R%))) - iLabInfFirmTaxTerm(R%)))

                    'LABINFORMSHR(R%) = sLabInformShrReg(R%) + LabInfEducTerm + LabInfTransTerm + LabInfBusRegTerm + LabInfFirmTaxTerm
                    LABINFORMSHR(R%) = iLABINFORMSHR(R%) + LabInfEducTerm + LabInfTransTerm + LabInfBusRegTerm + LabInfFirmTaxTerm
                    LABINFORMSHR(R%) = CSng(0.2 * LABINFORMSHR(R%) + 0.8 * sLabInformShrReg(R%))

                    'iLABINFORMSHR(R%) = LABINFORMSHR(R%)
                    '        SLabInfEducTerm(R%) = sedyrsag15(R%)
                    '        SLabInfTransTerm(R%) = 100 * sgovhhtrn(R%) / gdplastyr
                    '        SLabInfBusRegTerm(R%) = sgovbusregind(R%)
                    '        SLabInfFirmTaxTerm(R%) = Log(AMAX(1.001, sfirmtaxr(R%)))


                    'If RegName$(R%) = "Macedonia" Then Stop
                    'mti 2015/01/20 - end

                    'If RegName(R%) = "Libya" Then Stop

                    ' If RegName$(R%) = "Uganda" Then Stop
                    '  If RegName$(R%) = "Iran" Then Stop

                    'mti 2019/01/09 start
                    'labinformal = Amin(85, AMAX(1, labinformal))
                    'mti 2015/03/04 - end
                    'bbh 2019/07/21 end

                    '        If labinformshrshift(R%) > 0 Then
                    '            labinfconvyr = 85 '40
                    '        Else
                    '            labinfconvyr = 120  '90  'lower value might raise inf share
                    '        End If


                    'mti 2015/03/04 - start


                    'LABINFORMSHR(R%) = Amin(85, AMAX(1, labinformal _
                    '+ ConvergeOverTime(labinformshrshift(R%), 0, labinfconvyr))) '3

                    '        labinformal = Amin(85, AMAX(1, labinformal _
                    ' + ConvergeOverTime(labinformshrshift(R%), 0, labinfconvyr))) '3



                    ' If RegName(R%) = "Mexico" Then Debug.Print labinformal;

                    'fix Iran? mov av here = base_0118
                    'labinformal = 0.2 * labinformal + 0.8 * sLabInformShrReg(R%)
                    'labinformal = 0.2 * LABINFORMSHR(R%) + 0.8 * sLabInformShrReg(R%)
                    labinformal = LABINFORMSHR(R%)
                    'bbh 2019/07/21 end

                    labinformaldelta = labinformal - sLabInformShrReg(R%)
                    sLabInformShrReg(R%) = labinformal

                    labinformal = Amin(85, AMAX(1, sLabInformShr(R%) + labinformaldelta))


                    LabNonAgTot = 0
                    For S% = 1 To NSec%
                        If S% <> Agri Then
                            LabNonAgTot = LabNonAgTot + LABEMPS(R%, S%, Unskilled) + LABEMPS(R%, S%, Skilled)
                        End If
                    Next S%

                    'PopUrban_Prev = POPURBAN(R%) / (1 + POPURBGR(R%) / 100)AMAX(0, POPURBAN(R%) * (POPURBGR(R%) - POPR(R%)) / 100 / (1 + POPURBGR(R%) / 100)) 'from, popurban - spopurban formula
                    labinformal_hc = LabNonAgTot * labinformal / 100
                    'PopUrbanNew = AMAX(0, POPURBAN(R%) * (POPURBGR(R%) - POPR(R%)) / 100 / (1 + POPURBGR(R%) / 100))  'from, popurban - spopurban formula

                    'PopUrbanNew = AMAX(0, POPURBAN(R%) - SPOPURBAN(R%) * (1 + POPR(R%) / 100))
                    PopUrbanNew = AMAX(0, SPOPURBAN(R%) - sPopUrban1(R%) * (1 + sPOPR(R%) / 100))


                    labinformal_hc = LabNonAgTot * labinformal / 100

                    If IY = 2 Then  '<=25
                        If PopUrbanNew > 0 Then
                            'labinformal_hc_init = LabNonAgTot * (1 - (0.0025 * (IY - 1))) * iLABINFORMSHR(R%) / 100
                            'mti 2019/02/04 start
                            'labinformal_hc_init = LabNonAgTot * iLABINFORMSHR(R%) / 100
                            labinformal_hc_init = CSng(LabNonAgTot * 0.99 * iLABINFORMSHR(R%) / 100)
                            'mti 2019/02/04 End

                            'fix Mex
                            labinfaddurbfrac(R%) = CSng(Amin(0.4, AMAX(0, (labinformal_hc_init - labinformal_hc) / PopUrbanNew))) '.4 '.6 '.9
                        Else
                            labinfaddurbfrac(R%) = 0
                        End If

                        '        Else
                        '            labinfaddurbfrac(R%) = labinfaddurbfrac(R%) * 0.1 + slabinfaddurbfrac(R%) * 0.9
                    End If

                    LABINFORMSHR(R%) = Amin(85, AMAX(1, 100 * (labinformal_hc + labinfaddurbfrac(R%) * PopUrbanNew) / LabNonAgTot))

                    ' If RegName(R%) = "Mexico" Then Debug.Print labinformaldelta; POPR(R%); POPURBGR(R%); PopUrbanNew; labinfaddurbfrac(R%); 100 * labinfaddurbfrac(R%) * PopUrbanNew / LabNonAgTot; LABINFORMSHR(R%)


                    'LABINFORMSHR(R%) = LABINFORMSHR(R%) * 0.3 + sLabInformShr(R%) * 0.7
                    sLabInformShr(R%) = LABINFORMSHR(R%)
                    'slabinfaddurbfrac(R%) = labinfaddurbfrac(R%)
                    'mti 2019/01/09 End


                    LABINFORMSHR(R%) = Amin(85, AMAX(1, LABINFORMSHR(R%) * labinformshrm(R%)))
                    '   All But First 1:  Informal Economy GDP Share
                    '   ----------------------------------------------

                    '        TbName$ = "GDP/Capita (PPP 2011) Versus LabInformal/GDPInformal (" & CStr(BaseYear) & ") Log"
                    '        TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear)
                    '        Call XYTABL(TbName$, GDPPCP(R%), informallabgdprat)

                    '        If informallabgdpratRI(R%) > 1 Then
                    '            gdpinfconvyr = 70
                    '        Else
                    '            gdpinfconvyr = 200   'this one should be slower as it takes informal GDP share upward
                    '        End If

                    If informallabgdpratRI(R%) > 1 Then
                        'GDP share higher than labor share; bring co convergence in 25 years
                        GDPINFORMSHR(R%) = Amin(85, AMAX(1, ConvergeOverTime(informallabgdpratRI(R%), 1, 25) * LABINFORMSHR(R%)))
                    Else
                        If GDPInformShrShift(R%) > 0 Then
                            'gdpinfconvyr = 70
                            gdpinfconvyr = 85 'bbh 2024/01/17 Was causing big kink in informality and GDPR; move beyond 2100
                        Else
                            gdpinfconvyr = 200   'this one should be slower as it takes informal GDP share upward
                        End If

                        '        GDPINFORMSHR(R%) = Amin(85, AMAX(3, LABINFORMSHR(R%) / (Amin(3, AMAX(1, informallabgdprat)) * ConvergeOverTime(informallabgdpratRI(R%), 1, gdpinfconvyr))))
                        '
                        'If R = 1 Then Stop
                        'gdpinformalcalc = 24.20329 + 0.194 * sLabInformShr(R%) _
                        '- 2.294 * sgovcorrupt(R%) + 11.324 * Sqr(100 * sgds(R%, RandD) / gdplastyr)

                        'gdpinformalcalc = 18.861 + 0.193 * LABINFORMSHR(R%) _
                        '- 1.585 * sgovcorrupt(R%) - 2.608 * SRANDDEXP(R%) 'Sqr(100 * sgds(R%, RandD) / gdplastyr)

                        gdpinformalcalc = gdpinformcoeffintercept + gdpinformcoefflabinf * LABINFORMSHR(R%) _
                                + gdpinformcoeffcorrupt * sgovcorrupt(R%) _
                                + gdpinformcoeffrand * SRANDDEXP(R%) 'Sqr(100 * sgds(R%, RandD) / gdplastyr)
                        GDPINFORMSHR(R%) = Amin(85, AMAX(1, gdpinformalcalc _
                    + ConvergeOverTime(GDPInformShrShift(R%), 0, gdpinfconvyr)))  '3
                        GDPINFORMSHR(R%) = Amin(LABINFORMSHR(R%), GDPINFORMSHR(R%))
                        'bbh 2015/03/24 Same factor of 8 maximum added to preprocessor
                        GDPINFORMSHR(R%) = AMAX(LABINFORMSHR(R%) / 8, GDPINFORMSHR(R%))
                    End If

                    GDPINFORMSHR(R%) = Amin(85, AMAX(1, GDPINFORMSHR(R%) * gdpinformshrm(R%)))

                    'mti 2015/06/09 - start

                    '------------------ Shadow Econommy --------------
                    If informallabgdpshadowratRI(R%) > 1 Then
                        'GDP share higher than labor share; bring co convergence in 25 years
                        GDPSHADOWSHR(R%) = Amin(85, AMAX(1, ConvergeOverTime(informallabgdpshadowratRI(R%), 1, 25) * LABINFORMSHR(R%)))
                    Else
                        If GDPShadowShrShift(R%) > 0 Then
                            gdpinfconvyr = 70
                        Else
                            gdpinfconvyr = 200   'this one should be slower as it takes informal GDP share upward
                        End If

                        'gdpinformalcalc = 36.28139 + 0.1019374 * LABINFORMSHR(R%) _
                        '- 1.884887 * sgovcorrupt(R%) - 2.957171 * SRANDDEXP(R%) 'Sqr(100 * GDS(R%, RandD) / GDP(R%))

                        gdpinformalcalc = gdpshadowcoeffintercept + gdpshadowcoefflabinf * LABINFORMSHR(R%) _
                                + gdpshadowcoeffcorrupt * sgovcorrupt(R%) _
                                + gdpshadowcoeffrand * SRANDDEXP(R%) 'Sqr(100 * sgds(R%, RandD) / gdplastyr)

                        GDPSHADOWSHR(R%) = Amin(85, AMAX(1, gdpinformalcalc _
                    + ConvergeOverTime(GDPShadowShrShift(R%), 0, gdpinfconvyr)))  '3
                        GDPSHADOWSHR(R%) = Amin(LABINFORMSHR(R%), GDPSHADOWSHR(R%))

                        'bbh 2015/03/24 Same factor of 8 maximum added to preprocessor
                        'mti: this was added by BBH; need to check if the ratio needs to be revised for shadow economy
                        'GDPSHADOWSHR(R%) = AMAX(LABINFORMSHR(R%) / 8, GDPSHADOWSHR(R%))
                    End If

                    GDPSHADOWSHR(R%) = Amin(85, AMAX(1, GDPSHADOWSHR(R%) * gdpshadowshrm(R%)))


                    '-------------------------------------------
                    'mti 2015/06/09 - end
                    '   All But First 1:  Informal Labor Split
                    '   --------------------------------------

                    'Call XYTABL("Informal Employment Versus Share Of Inf Emp Working at Inf Enterprises(MOSTRECENT) Linear", _
                    'LABINFORMSHR(R%), CalcLABINFORMSECINFTOT)

                    Dim CalcLABINFORMSECINFTOT = infinformcoeffintercept + infinformcoefflabinf * LABINFORMSHR(R%)

                    LABINFORMPCNTINF(R%, Total) = AMAX(1, Amin(100, CalcLABINFORMSECINFTOT _
            + ConvergeOverTime(LABINFORMPCNTINFTotShift(R%), 0, 30)))

                    '  If RegName(R%) = "Peru" Then Stop

                    LABINFORMPCNTINF(R%, Female) = LABINFORMPCNTINFFemShare(R%) * LABINFORMPCNTINF(R%, Total)
                    LABINFORMPCNTINF(R%, Male) = (1 - LABINFORMPCNTINFFemShare(R%)) * LABINFORMPCNTINF(R%, Total)

                    LABINFORMPCNTNONINF(R%, Total) = 100 - LABINFORMPCNTINF(R%, Total)

                    LABINFORMPCNTNONINF(R%, Female) = LABINFORMPCNTNONINFFemShare(R%) * LABINFORMPCNTNONINF(R%, Total)
                    LABINFORMPCNTNONINF(R%, Male) = (1 - LABINFORMPCNTNONINFFemShare(R%)) * LABINFORMPCNTNONINF(R%, Total)

                    'mti 2015/03/04 - end
                    'mti 2015/03/04 - end
                    'mti 2014/11/27 -  start
                Next R%


                'jrs 2012/06/15 db.Close
                'BBH 2011/04/04 End

                'jrs 2014/09/15 moved to ifsEcoMFP
                '' Notes on production function:  things to work on
                ''   1. MFPRATE is calculated 1st year including convergence premium,
                ''           but in subsequent years without
