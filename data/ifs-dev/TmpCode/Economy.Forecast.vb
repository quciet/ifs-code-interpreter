            - HHTAX(R%%, Skilled) - HHGOVSS(R%%, Skilled) _
            - INDIRECTTAX(R%%) * (HHINCEARN(R%%, Skilled) / (FIRMEARN(R%%) + HHINCEARN(R%%, Unskilled) + HHINCEARN(R%%, Skilled)))
