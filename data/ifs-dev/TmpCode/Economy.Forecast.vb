                'INDIRECTTAX(R%) = FIRMINC(R%) * INDIRECTTAXR(R%) / 100 * indirecttaxrm(R%) * mulrev(R%) * govrevm(R%)  'bbh 2016/04/05
                'bbh 2021/05/15 start
                INDIRECTTAX(R%) = (FIRMEARN(R%) + HHINCEARN(R%, Skilled) + HHINCEARN(R%, Unskilled)) * INDIRECTTAXR(R%) / 100 * indirecttaxrm(R%) * mulrev(R%) * govrevm(R%) 'bbh 2016/04/05
                'mti 2016/09/09 End

                'INDIRECTTAX(R%) = FIRMINC(R%) * INDIRECTTAXR(R%) / 100 * indirecttaxrm(R%) * mulrev(R%)

                'If RegName$(R%) = "Denmark" Then Stop

                '   All but First 3:  Household Taxes (incl SS)
                '   -------------------------------------------
                'Note:  tax rates should rise with normal GovtRev/GDP

                HHTAX(R%, Unskilled) = HHINCEARN(R%, Unskilled) * HHTAXR(R%, Unskilled) / 100 _
            * hhtaxrm(R%, Unskilled) * govrevm(R%) * mulrev(R%)
                'If RegName$(R%) = "India" And IY% >= 26 Then Stop
                'If RegName$(R%) = "Bhutan" Then Stop
                HHTAX(R%, Skilled) = HHINCEARN(R%, Skilled) * HHTAXR(R%, Skilled) / 100 _
            * hhtaxrm(R%, Skilled) * govrevm(R%) * mulrev(R%)
                HHGOVSS(R%, Unskilled) = SSWELTAXR(R%) / 100 * HHINCEARN(R%, Unskilled) _
            * ssweltaxrm(R%) * govrevm(R%) * mulrev(R%)
                HHGOVSS(R%, Skilled) = SSWELTAXR(R%) / 100 * HHINCEARN(R%, Skilled) _
            * ssweltaxrm(R%) * govrevm(R%) * mulrev(R%)
                'bbh 2021/05/15 end

                '   All but First 3:  Allow Scenario Targeting of Domestic Revenues (Aid added later)
                '   ---------------------------------------------------------------------------------

                PreSSWELTAX = HHGOVSS(R%, Unskilled) + HHGOVSS(R%, Skilled) + FIRMGOVSS(R%)
                PreGOVREV = HHTAX(R%, Unskilled) + HHTAX(R%, Skilled) + FIRMTAX(R%) +
                    INDIRECTTAX(R%) + PreSSWELTAX

                '        TAXRA(R%) = GOVREV(R%) / AMAX(0.0001, GDPPOT(R%))
                PreTAXRA = AMAX(1, PreGOVREV / AMAX(0.0001, GDPPOTRPA(R%)) * 100)
                'If IY% = 2 Then PreTAXRAi(R%) = PreTAXRA

                If govrevtrgtyr > 1 AndAlso govrevtrgtval(R%) > 1 AndAlso PreTAXRA < govrevtrgtval(R%) Then
                    TaxTar = PreTAXRA + (govrevtrgtval(R%) - PreTAXRA) / govrevtrgtyr * Amin(IY%, govrevtrgtyr)
                    'If RegName$(R%) = "Chad" And IY% >= 15 Then Stop
                    If PreTAXRA < TaxTar Then
                        TaxTarMul = TaxTar / PreTAXRA
                        FIRMTAX(R%) = FIRMTAX(R%) * TaxTarMul
                        FIRMGOVSS(R%) = FIRMGOVSS(R%) * TaxTarMul
                        INDIRECTTAX(R%) = INDIRECTTAX(R%) * TaxTarMul
                        HHTAX(R%, Unskilled) = HHTAX(R%, Unskilled) * TaxTarMul
                        HHTAX(R%, Skilled) = HHTAX(R%, Skilled) * TaxTarMul
                        HHGOVSS(R%, Unskilled) = HHGOVSS(R%, Unskilled) * TaxTarMul
                        HHGOVSS(R%, Skilled) = HHGOVSS(R%, Skilled) * TaxTarMul
                        INDIRECTTAXR(R%) = INDIRECTTAXR(R%) * TaxTarMul
                        FIRMTAXR(R%) = FIRMTAXR(R%) * TaxTarMul
                        SSWELTAXR(R%) = SSWELTAXR(R%) * TaxTarMul
                        HHTAXR(R%, Skilled) = HHTAXR(R%, Skilled) * TaxTarMul
                        HHTAXR(R%, Unskilled) = HHTAXR(R%, Unskilled) * TaxTarMul
                    End If
                End If
                '   All but First 3:  Firm and Household Taxes (incl SS) Limits with Income
                '   -----------------------------------------------------------------------
                'Note:  tax rates should rise with normal GovtRev/GDP

                TotFirmTaxRate = (FIRMTAX(R%) + FIRMGOVSS(R%) + INDIRECTTAX(R%)) / AMAX(0.001, FIRMEARN(R%)) 'bbh 2021/05/15
                If TotFirmTaxRate > 0.9 Then
                    FIRMTAX(R%) = FIRMTAX(R%) * 0.9! / TotFirmTaxRate
                    FIRMGOVSS(R%) = FIRMGOVSS(R%) * 0.9! / TotFirmTaxRate
                    INDIRECTTAX(R%) = INDIRECTTAX(R%) * 0.9! / TotFirmTaxRate
                End If
                'bbh 2021/05/29 replaced FIRMINC with FIRMEARN
                'bbh 2021/06/01 Use of indirect taxes in calc of FirmIncomeAftertaxes
                Dim FirmIncomeAfterTaxes = FIRMEARN(R%) - FIRMTAX(R%) - FIRMGOVSS(R%) _
                - INDIRECTTAX(R%) * (FIRMEARN(R%) / (FIRMEARN(R%) + HHINCEARN(R%, Unskilled) + HHINCEARN(R%, Skilled)))

                HHDIVINT(R%, Unskilled) = FirmIncomeAfterTaxes * 0.1! * (1 - FirmInvRI(R%))
                HHDIVINT(R%, Skilled) = FirmIncomeAfterTaxes * 0.9! * (1 - FirmInvRI(R%))

                TaxRateUn = (HHTAX(R%, Unskilled) + HHGOVSS(R%, Unskilled)) /
                AMAX(0.0001, HHINCEARN(R%, Unskilled)) 'bbh 2021/05/18

                If TaxRateUn > 0.9 Then
                    HHTAX(R%, Unskilled) = HHTAX(R%, Unskilled) * 0.9! / TaxRateUn
                    HHGOVSS(R%, Unskilled) = HHGOVSS(R%, Unskilled) * 0.9! / TaxRateUn
                    ' If RegName$(R%) = "Bhutan" Then Stop
                End If

                TaxRate = (HHTAX(R%, Skilled) + HHGOVSS(R%, Skilled)) /
            AMAX(0.0001, HHINCEARN(R%, Skilled)) 'bbh 2021/05/15
                If TaxRate > 0.9 Then
                    HHTAX(R%, Skilled) = HHTAX(R%, Skilled) * 0.9! / TaxRate
                    HHGOVSS(R%, Skilled) = HHGOVSS(R%, Skilled) * 0.9! / TaxRate
                    ' If RegName$(R%) = "Afghanistan" Then Stop
                End If



                'bbh 2016/04/05 end


                '   All but First 3:  Govt Consumption; will increase with GDP per capita
                '   ---------------------------------------------------------------------
                Dim GovtConsum = 0!
                If context.HistoricMode Then
                    'bbh 2014/05/11 Start
                    TbName$ = "GDP/Capita (PPP) Versus Govt Consumption (1960)"
                    Call XYTABL(TbName$, GDPPCP(R%), GovtConsum, context)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Educ as % of GDP (1960) - log", _
                    '               Amin(40, GDPPCP(R%)), edexpcomp)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Hlth as % of GDP (1990) - log", _
                    '               Amin(40, GDPPCP(R%)), HlExpComp)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp R&D as % of GNP (2000) - linear", _
                    '               Amin(40, GDPPCP(R%)), rdexpcomp)
                    '            'Call XYTABL("GDP/Capita (PPP) Versus R&D Total  as % of GNI (1980) - linear", _
                    '               Amin(40, GDPPCP(R%)), rdexpcomp)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Mil as % of GDP (1965) - linear", _
                    '                Amin(40, GDPPCP(R%)), MlExpComp)
                    '            GovtConsum = edexpcomp + HlExpComp + rdexpcomp + MlExpComp + OtExpComp(R%)
                    'bbh 2014/05/11 end
                Else
                    'If RegName(R%) = "Benin" Then Stop

                    '            TBName$ = "GDP/Capita (PPP) Versus Govt Consumption (1995)"
                    'bbh 2014/05/11 Start   Switching over from bottom up GDS to top down GOVCON
                    '       In part becuase never had added infrastructure anyway

                    '
                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP) Versus Govt Consumption (2010) Forecast"
                    Call XYTABL(TFNameGovtConsumption, GDPPCP(R%), GovtConsum, context)
                    '
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Educ as % of GDP (2002) - log", _
                    '               Amin(40, GDPPCP(R%)), edexpcomp)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Hlth as % of GDP (2000) - log", _
                    '               Amin(40, GDPPCP(R%)), HlExpComp)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp R&D as % of GNP (2000) - linear", _
                    '               Amin(40, GDPPCP(R%)), rdexpcomp)
                    '            'Call XYTABL("GDP/Capita (PPP) Versus R&D Total  as % of GNI (2000) - linear", _
                    '               Amin(40, GDPPCP(R%)), rdexpcomp)
                    '            Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Mil as % of GDP (2000) - linear", _
                    '                Amin(40, GDPPCP(R%)), MlExpComp)
                    '            GovtConsum = edexpcomp + HlExpComp + rdexpcomp + MlExpComp + OtExpComp(R%)
                    'bbh 2014/05/11 End
                End If
                GOVCON(R%) = ConvergeOverTimeRate(GovtConsum * govconr(R%), GovtConsum, CInt(govfinconv))
                'If RegName$(R%) = "Benin" Then Stop
                'Education and Health expenditures have a big impact; must be careful not to
                '    throw them around too much with convergence function (e.g. Bangladesh,
                '    Botswana are initially quite a bit off of GDPPCP function
                'GOVCON(R%) = GovtConsum * GOVCONR(R%)

                '        immadj = ExcessSt(R%) / AMAX(0.0001, GDPPOT(R%)) / 5 * 100
                immadj = ExcessSt(R%) / AMAX(0.0001, GDPPOTRPA(R%)) / 5 * 100
                'bbh 2022/10/27 Conditionally reactivated the impact of low stocks on GOVCON, at low level, if-then loop added
                If immadj < 0 And GOVCON(R%) > GovConRGDPI(R%) Then 'At this point GOVCON is a percentage of GDP, not a dollar value
                    GOVCON(R%) = GOVCON(R%) + immadj / 2
                End If
                'GOVCON(R%) = GOVCON(R%) + immadj

                'mti test
                'wagnerc = 0.1

                GOVCON(R%) = AMAX(3, Amin(90, GOVCON(R%) * (1 + IY% * wagnerc / 100)))
                GDPBASE = GDP(R%) + 0.5! * (GDPRPA(R%) - GDP(R%))
                'Shouldn't pass through entire resource-based price run-up to spending
                GOVCON(R%) = GOVCON(R%) / 100 * GDPBASE 'GDPRPA(R%) 'From % to dollars
                'bbh 2022/08/30 Start of block change because of code to eliminate duplication in later code now commented out
                GOVCON(R%) = CSng(AMAX(GOVCON(R%), Amin(0.2!, GovConRGDPI(R%) / 100 * 0.95) * GDPBASE)) 'was GDPRPA(R%) rather than GDPBASE
                'bbh 2022/08/22 put next line inside if-then
                If gdprext(R%) < -50 Then 'when outside of exogenous growth period, bound relative to GDP growth
                    'Note: at this point GDPR is decimal rate, not %; gdprext is %
                    GOVCON(R%) = Amin(GOVCON(R%), SGOVCON(R%) * (1 + GDPR(R%) * 2))  'also to prevent too much pass through of
                    'oil revenues, too quickly, to government spending; pass faster to transfers
                Else 'inside gdprext period put max rise on top of gdprext; recognizes Libya has 177% GDP bump 1 year
                    GOVCON(R%) = Amin(GOVCON(R%), SGOVCON(R%) * (1 + gdprext(R%) / 100 + 0.06!))
                End If
                'If RegName$(R%) = "Bangladesh" And IY% + 2016 >= 2025 Then Stop

                'bbh 2011/06/11
                'GOVCON(R%) = GOVCON(R%) * govexpm(R%) '* (mulexp(R%) ^ 0.5) ' * MulGovCon(R%) '* mulexp(R%)
                SGOVCON(R%) = GOVCON(R%)  'bbh 2016/04/12
                GOVCON(R%) = GOVCON(R%) * govexpm(R%) * mulexp(R%)

                'If RegName$(R%) = "Bangladesh" And IY% + 2016 >= 2025 Then Stop
                GOVCON(R%) = GOVCON(R%) * govconm(R%) 'BBH 2017/05/23

                'If RegName$(R%) = "Ethiopia" And IY% >= 11 Then Stop
                'I switched to the formulation immediately above in order to get some responsiveness to
                '   govt debt on the consumtion side, not just the revenue side.  I learned: (1) it makes little difference
                '   because govrevm is much more responsive to gdebt/gdp than is govexpm (as it should be, we don't want
                '   to throw around govcon too much; for South Africa the impacts were about 5 to 1 govrev
                '   But govbal becomes somewhat unstable near 2100 in the old formulation and even a bit more in the new
                '       so need to watch and probably fix that.

                GOVCON(R%) = GOVCON(R%) - govconwbi(R%) + XWBFLOWS(R%, 1) + XWBFLOWS(R%, 2)
                'bbh 2022/08/30 End of block change because of code to eliminate duplication in later code now commented out

                'If RegName$(R%) = "Australia" Then Stop
                '   All but First 3:  Govt Transfers; Typical Increase with GDP per capita
                '   ---------------------------------------------------------------------
                ' If RegName(R%) = "Somalia" Then Stop
                'bbh 2012/12/22

                'mti 2016/09/09 Start
                'TbName$ = "GDP/Capita (PPP 2005) Versus Subsidies/Transfers % GDP (2010) Log"
                'jrs 2024/06/20 TbName$ = "GDP/Capita (PPP 2011) Versus Transfers (Pension and Welfare) as % GDP (2014) Log"

                'mti 2016/09/09 Start
                'mti test
                Dim govttrans = 0!
                Call XYTABL(TFNameTransfersPctGDP, GDPPCP(R%), govttrans, context)
                'Call XYTABL(TbName$, GDPPCP(R%) * 1000, govttrans)
                'mti 2016/09/09 End
                'If RegName$(R%) = "Zimbabwe" Then Stop

                'mti 2018/12/06 start
                'govttrans = AMAX(0, govttrans)
                govttrans = AMAX(0.25, govttrans)
                'mti 2018/12/06 End
                '    If RegName(R%) = "Zimbabwe" Then Stop

                'EGovExp = SGOVEXP(R%) * (1 + IGDPRCor(R%))

                'mti test
                'GOVHHTRN(R%) = ConvergeOverTime(govttrans * govhhtrnr(R%), govttrans, govfinconv)
                GOVHHTRN(R%) = ConvergeOverTime(govttrans * govhhtrnr(R%), govttrans, govfinconv)

                'Base, Target, Years
                GOVHHTRN(R%) = AMAX(0, Amin(40, GOVHHTRN(R%) * (1 + IY% * wagnerc / 100)))


                'GOVHHTRN(R%) = GOVHHTRN(R%) / 100 * EGovExp * govexpm(R%) * mulexp(R%) 'From % to dollars
                GOVHHTRN(R%) = GOVHHTRN(R%) / 100 * GDPBASE * govexpm(R%) * mulexp(R%) 'From % to dollars
                'mti 2016/09/09 End


                '        GOVHHTRN(R%) = Amin(GOVHHTRN(R%), 0.4 * GDPPOT(R%))
                GOVHHTRN(R%) = Amin(GOVHHTRN(R%), 0.4! * GDPPOTRPA(R%))
                'If RegName$(R%) = "South Africa" Then Stop

                'mti 2018/07/23 Start
                ''   All but First 3: Adjust Government Expenditures with Changes in Bilateral Aid
                ''   -----------------------------------------------------------------------------
                '        AIDGDPR = AMAX(0, AID(R%) / AMAX(0.0001, GDP(R%)))
                '
                '        'mti test - reverted
                '        AidShiftAmount = (AIDGDPR - IAIDGDPR(R%)) * GDP(R%)
                '        'AidShiftAmount = (AMAX(0, AID(R%)) - IAID(R%)) '* GDP(R%)
                '
                '
                '       'AidShiftAmount = (AIDGDPR - IAIDGDPR(R%)) * GDP(R%) * 0.5 'bbh 2016/04/13
                ''        If AidShiftAmount > 0 Then 'share it between consumption and transfers
                ''            sumexp = AMAX(0.0001, GOVCON(R%) + GOVHHTRN(R%))
                ''            govconportion = AidShiftAmount * GOVCON(R%) / sumexp
                ''        Else 'if aid shift means cutback, put most of cost on transfers
                ''            sumexp = AMAX(0.0001, GOVCON(R%) + GOVHHTRN(R%) * 3)
                ''            govconportion = Amin(0.1 * GOVCON(R%), AidShiftAmount * GOVCON(R%) / sumexp)
                ''        End If
                '  If RegName(R%) = "Guatemala" Then Stop
                '
                '        If AidShiftAmount > 0 Then 'share it between consumption and transfers
                '            govconportion = AidShiftAmount * aidrecgovconp(R%)
                '        Else 'if aid shift means cutback, put most of cost on transfers
                '            govconportion = Amin(0.1 * GOVCON(R%), AidShiftAmount * (1 - aidrecgovconp(R%)))
                '        End If
                '
                '
                ''    If IY = 2 Then Debug.Print RegName(R%), 100 * GOVCON(R%) / (GOVCON(R%) + GOVHHTRN(R%)), GDPPCP(R%)
                '        govconportion = Amin(govconportion, SGOVCON(R%) * 1.12)
                '        GovHHTrnPortion = AidShiftAmount - govconportion
                '
                '
                '        GOVCON(R%) = GOVCON(R%) + govconportion
                '            'Assumes new aid passes through to govt consumption; could target to category
                '   BBH 8/18/04 Education Expenditure Begin
                'If RegName$(R%) = "Botswana" Then Stop
                'bbh 2022/08/30 Start of block move
                'Some lines below duplicating earlier GOVCON treatment and using mulexp twice; moved up to earlier code for GOVCON
                '        GOVCON(R%) = AMAX(GOVCON(R%), Amin(0.2, GovConRGDPI(R%) / 100 * 0.95) * GDPRPA(R%))
                '        'bbh 2022/08/22 put next line inside if-then
                '        If gdprext(R%) < -50 Then 'Only bound like this if outside of exogenous growth period; Libya has 177% bump 1 yeaer
                '            GOVCON(R%) = Amin(GOVCON(R%), SGOVCON(R%) * 1.12) 'to prevent too much pass through of
                '            'oil revenues, too quickly, to government spending; pass faster to transfers
                '        End If
                '
                '        SGOVCON(R%) = GOVCON(R%)  'bbh 2016/04/12
                '        GOVCON(R%) = GOVCON(R%) * govexpm(R%) * mulexp(R%)
                '        GOVCON(R%) = GOVCON(R%) * govconm(R%) 'BBH 2017/05/23
                'bbh 2022/08/30 end of block move

                'SGOVCON(R%) = GOVCON(R%) 'bbh 2016/04/12
                'If RegName$(R%) = "Ethiopia" And IY% >= 11 Then Stop
                'Need a reasonable floor for government consumption; transfers get squeezed more
                '       in desparate situations
                'If RegName$(R%) = "Australia" Then Stop
                '   All but First 3: Adjust Government Expenditures with Changes in Bilateral Aid
                '   -----------------------------------------------------------------------------
                'bbh 2020/07/01 start
                'jrs 2022/03/03 AIDGDPR = AMAX(0, AID(R%) / AMAX(0.0001, GDP(R%))) 'not used anymore; could be removed

                If IAID(R%) > 0 Then 'initial aid recipient
                    AidShiftAmount = AID(R%) - IAID(R%) 'most often positive increment of aid received, could be reduction
                    'bbh 2020/07/01 note: aidrecgovconp was .9 all regions; meant that govt use of aid boost was raising govt consumption,
                    '     reducing stocks, and squeezing out household consumption, thereby raising poverty; reduced that to 0.5 in GlobalParameters; no code change
                    govconportion = AidShiftAmount * aidrecgovconp(R%) 'share it between consumption and transfers
                    govconportion = CSng(Amin(govconportion, SGOVCON(R%) * 0.4)) 'limit amount to add to consumption; up to 40% increase
                    GOVCON(R%) = AMAX(0.5 * GOVCON(R%), GOVCON(R%) + govconportion) 'Assumes new aid passes through to govt consumption; could target to category
                    GovHHTrnPortion = AidShiftAmount - govconportion
                    GOVHHTRN(R%) = AMAX(0.1 * GOVHHTRN(R%), GOVHHTRN(R%) + GovHHTrnPortion)
                Else 'initial aid donor
                    AidShiftAmount = AID(R%) - IAID(R%)  'most often AID higher negative than IAID, AidShiftAmount negative
                    GovHHTrnPortion = CSng(0.8 * AidShiftAmount) ' most of aid cost for givers from transfers
                    GOVHHTRN(R%) = AMAX(0.5 * GOVHHTRN(R%), GOVHHTRN(R%) + GovHHTrnPortion)
                    govconportion = AidShiftAmount - GovHHTrnPortion 'usually negative - smaller negative, still negative
                    GOVCON(R%) = AMAX(0.5 * GOVCON(R%), GOVCON(R%) + govconportion)
                End If
                'If IY = 2 Then Debug.Print RegName(R%), 100 * GOVCON(R%) / (GOVCON(R%) + GOVHHTRN(R%)), GDPPCP(R%)
                'If RegName$(R%) = "United States of America" Then Stop
                'If RegName$(R%) = "Malawi" Then Stop
                'bbh 2020/07/01 end

                '   All but First 3:  Government Transfers, Bottom-Up Pressure Calculation
                '   ----------------------------------------------------------------------

                'mti 2018/12/06 start
                'TbName$ = "GDP/Capita (PPP) Versus Public Pension % of GDP (2000)"
                'jrs 2024/07/04
                'TbName$ = "GDP/Capita (PPP) Versus Public Pension % of GDP (" & CStr(BaseYear) & ")"
                'TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
                'mti 2018/12/06 End
                '   If RegName$(R%) = "Zimbabwe" And IY > 80 Then Stop
                Call XYTABL(TFNamePublicPensionPctGDP, GDPPCP(R%), govtpensions, context)
                'bbh 2011/12/17
                If GDPPCP(R%) < 8 Then
                    Dim govtpensions8 = 0!
                    'jrs 2024/07/29 Call XYTABL(TbName$, 8, govtpensions8, context)
                    Call XYTABL(TFNamePublicPensionPctGDP, 8, govtpensions8, context)
                    'mti 2018/12/06 start
                    'govtpensions = govtpensions8 - 6 * (8 - GDPPCP(R%)) / 8
                    'interpolate from 2% to govtpensions8 as GDPPCP rises from from 0 to $8,000
                    govtpensions = govtpensions8 - AMAX(1, (govtpensions8 - 1)) * (8 - GDPPCP(R%)) / 8
                    'interpolate from 1% to govtpensions8 as GDPPCP rises from from 0 to $8,000
                    'mti 2018/12/06 End


                    'log function in TbName$ falls too steeply at bottom end
                End If
                'If RegName$(R%) = "United States of America" Then Stop
                '        GDPFactor = GDPPOT(R%) / GDPI(R%)
                GDPFactor = (GDPPOTRPA(R%) / POP(R%)) / GDPPCI(R%)
                '        govtpensions = AMAX(0.001, govtpensions / 100 * GovHHTrnPenR(R%) * GDPPOT(R%))
                govtpensions = AMAX(0.001, govtpensions / 100 * GovHHTrnPenR(R%) * GDPPOTRPA(R%))
                'jrs 2013/04/12 RetirementPopAdd = POP15TO65(R%) * (1 - labretagem(R%))
                RetirementPopAdd = POPWORKING(R%) * (1 - labretagem(R%))
                ' RetirementPopAdd = 0
                'jrs 2013/04/15 RetirementPop = AMAX(0, POPGT65(R%) + RetirementPopAdd)
                RetirementPop = AMAX(0, POPRETIRED(R%) + RetirementPopAdd)


                'mti 2018/12/06 start
                'govtpensions = AMAX(govtpensions, RetirementPop * GovHHPenPCI(R%) * GDPFactor) _
                '* mulexp(R%)

                govtpensions = CSng((0.5 * govtpensions + 0.5 * (RetirementPop * GovHHPenPCI(R%) * GDPFactor)) * mulexp(R%))


                'mti 2018/12/06 End



                'If RegName$(R%) = "Uganda" Then Stop
                'If RegName$(R%) = "Zimbabwe" Then Stop
                'bbh 2011/12/18 begin
                'jrs 2013/04/15 PopGT65Shr = POPGT65(R%) / POP(R%)
                PopGT65Shr = POPRETIRED(R%) / POP(R%)
                If PopGT65Shr < 0.2 Then

                    MaxPension = PopGT65Shr * GDP(R%) 'Pensions can be max of per capita income

                ElseIf PopGT65Shr > 0.4 Then
                    MaxPension = CSng(PopGT65Shr * GDP(R%) * 0.7) 'Pensions can be max of 70% of per capita income
                Else  'Interpolate between max of full per capita income and 70%
                    MaxPension = CSng(PopGT65Shr * (GDP(R%) - GDP(R%) * 0.3 * (PopGT65Shr - 0.2) / 0.2))
                End If
                govtpensions = Amin(govtpensions, MaxPension)
                'bbh 2011/12/18 end

                'If RegName$(R%) = "Zimbabwe" Then Stop
                '        'mti 2018/12/06 Start
                GovtWelfare = POP(R%) * GovHHWelPCI(R%) * GDPFactor * mulexp(R%)
                '        'mti 2018/12/06 End

                BottomUpCalc = AMAX(0.0001, govtpensions + GovtWelfare)
                'If RegName$(R%) = "South Africa" Then Stop




                GOVHHTRN(R%) = AMAX(GOVHHTRN(R%), BottomUpCalc)


                GOVHHTRN(R%) = Amin(GOVHHTRN(R%), 0.5! * GDPPOTRPA(R%))
                'Could average, but pressure should be seen
                '   All but First 3:  Govt Transfers; allocation to types and households
                '   ---------------------------------------------------------------------
                'If RegName(R%) = "Zimbabwe" Then Debug.Print IY; govtpensions; GovtWelfare; govtpensions / BottomUpCalc; GOVHHTRN(R%)
                GovHHPen = govtpensions / BottomUpCalc * GOVHHTRN(R%)
                GovHHWel = GOVHHTRN(R%) - GovHHPen


                'bbh 2021/05/15 2 lines
                'hhinctot = AMAX(0.0001, HHINC(R%, Unskilled) + HHINC(R%, Skilled))
                'ShrUnskilled = AMAX(0, Amin(1, HHINC(R%, Unskilled) / hhinctot))
                hhinctot = AMAX(0.0001, HHINCEARN(R%, Unskilled) + HHINCEARN(R%, Skilled))
                ShrUnskilled = AMAX(0, Amin(1, HHINCEARN(R%, Unskilled) / hhinctot))

                GovHHTrnPenUnskBase = GovHHPen * ShrUnskilled
                'jrs 2026/05/04 added * govhhtrnpenm(R%, 3)
                GOVHHTRNPEN(R%, Unskilled) = GovHHPen * govhhtrnpenm(R%, Unskilled) * govhhtrnpenm(R%, 3) * ShrUnskilled

                'jrs 2026/05/04 added * govhhtrnpenm(R%, 3)
                GOVHHTRNPEN(R%, Skilled) = (GovHHPen - GovHHTrnPenUnskBase) * govhhtrnpenm(R%, Skilled) * govhhtrnpenm(R%, 3)
                GOVHHPENT(R%) = GOVHHTRNPEN(R%, Unskilled) + GOVHHTRNPEN(R%, Skilled)


                'bbh 2013/08/11

                'If RegName$(R%) = "United States of America" And govhhpentndpctuse(R%) > 0 Then Stop

                If SCRETIRE(R%) > 0.01 * GDP(R%) AndAlso govhhpentndpctuse(R%) > 0 Then
                    'bbh 2014/06/18 start
                    MulPension(R%) = CSng(AMAX(1.0#, MulPension(R%) * (SHHRETIRENEED(R%) / SCRETIRE(R%)) ^ 0.1))
                    '            GOVHHPENTRev = GOVHHPENT(R%) * MulPension(R%)
                    '            GOVHHTRNPEN(R%, Unskilled) = GOVHHTRNPEN(R%, Unskilled) * GOVHHPENTRev / GOVHHPENT(R%)
                    '            GOVHHTRNPEN(R%, Skilled) = GOVHHTRNPEN(R%, Skilled) * GOVHHPENTRev / GOVHHPENT(R%)
                    '            GOVHHPENT(R%) = GOVHHPENTRev

                    SavingsNew(R%) = CSng(20 * ((1 - (1 + savingsdiscountrt(R%) / 100) ^ (workageentry(R%) - WORKAGERETIREND(R%))) /
               (savingsdiscountrt(R%) / 100)))
                    'Find current Savings
                    SavingsOld(R%) = CSng(20 * ((1 - (1 + savingsdiscountrt(R%) / 100) ^ (workageentry(R%) - workageretire(R%))) /
               (savingsdiscountrt(R%) / 100)))
                    'Find hole in $
                    SavingsNeeded(R%) = SavingsNew(R%) - SavingsOld(R%)

                    SavingsNeeded(R%) = SavingsNeeded(R%) * govhhpentndpctuse(R%) / 100
                    PensionAdjustNeeded = SavingsNeeded(R%) / AMAX(0.0001, SavingsOld(R%)) * 100
                    DiffPen = Amin(25, AMAX(0, PensionAdjustNeeded)) / 100 * AMAX(0, GOVHHPENT(R%))

                    If GOVHHPENT(R%) > 0 Then
                        GOVHHTRNPEN(R%, Unskilled) = (GOVHHTRNPEN(R%, Unskilled) + DiffPen * GOVHHTRNPEN(R%, Unskilled) / GOVHHPENT(R%)) * MulPension(R%)
                        GOVHHTRNPEN(R%, Skilled) = (GOVHHTRNPEN(R%, Skilled) + DiffPen * GOVHHTRNPEN(R%, Skilled) / GOVHHPENT(R%)) * MulPension(R%)
                        'GOVHHPENT(R%) = GOVHHPENT(R%) + DiffPen
                        GOVHHPENT(R%) = GOVHHTRNPEN(R%, Unskilled) + GOVHHTRNPEN(R%, Skilled)
                    End If

                End If


                '        'jrs 2013/05/03
                '        GOVHHPENTND(R%) = GDPPC(R%) * POPRETIRED(R%)
                '        If govhhpentndpctuse(R%) > 0 Then
                '            'jrs 2013/05/28
                '            TotSavingsNeeded = SavingsOld(R%) + SavingsNeeded(R%) * govhhpentndpctuse(R%) / 100
                '                'SavingsOld and SavingsNeeded not calculated (in IFsPop) unless workageretirendpctuse(R%) > 0  'bbh 2013/08/11
                '            DiffPen = (GOVHHPENTND(R%) - GOVHHPENT(R%)) * govhhpentndpctuse(R%) / 100
                '            If GOVHHPENT(R%) > 0 Then
                '                GOVHHTRNPEN(R%, Unskilled) = GOVHHTRNPEN(R%, Unskilled) + DiffPen * GOVHHTRNPEN(R%, Unskilled) / GOVHHPENT(R%)
                '                GOVHHTRNPEN(R%, Skilled) = GOVHHTRNPEN(R%, Skilled) + DiffPen * GOVHHTRNPEN(R%, Skilled) / GOVHHPENT(R%)
                '            Else
                '                GOVHHTRNPEN(R%, Unskilled) = GOVHHTRNPEN(R%, Unskilled) + DiffPen * ShrUnskilled
                '                GOVHHTRNPEN(R%, Skilled) = GOVHHTRNPEN(R%, Skilled) + DiffPen * (1 - ShrUnskilled)
                '            End If
                '            GOVHHPENT(R%) = GOVHHPENT(R%) + (GOVHHPENTND(R%) - GOVHHPENT(R%)) * govhhpentndpctuse(R%) / 100
                '        End If
