            ReDim RemitPerWorkerIn(NR%%), RemitPerWorkerOut(NR%%)

            'bbh 2022/12/20 Start substantial revisions to IY=1 code; suggest taking entire block
            Dim RemitSentPerWorker As Single, RemitReceivedPerWorker As Single

            GloSumWorkIn = 0
            GloSumRemitIn = 0
            GloSumGDP = 0
            GloSumPop = 0
            For R% = 1 To NR%%
                GloSumWorkIn = GloSumWorkIn + POPFOREIGNIN(R%)
                GloSumRemitIn = GloSumRemitIn + XWORKREMITIN(R%)
                GloSumGDP = GloSumGDP + GDP(R%)
                GloSumPop = GloSumPop + POP(R%)
            Next R%
            GloGDPPC = GloSumGDP / GloSumPop
            GloAvgRemitPerWorker = (GloSumRemitIn / GloSumWorkIn) / GloGDPPC

            For R% = 1 To NR%%
                If POPFOREIGNIN(R%) > 0 Then 'RemitPerWorker is ratio of remittance per worker relative to GDPPC
                    RemitPerWorkerOut(R%) = XWORKREMITOUT(R%) / POPFOREIGNIN(R%) / GDPPC(R%)
                    'bbh 2022/12/20 Added code to DataEcon to assure that if POPFOREIGNIN>0 there is value for XWORKREMITOUT (UAE and Singapore)
                Else 'In case scenarios or code send 0.0 POPFOREIGNIN above 0 in future years
                    Call XYTABL("GDP/Capita Versus Remittances Sent Out per Foreign Worker (2017)",
                    GDPPC(R%), RemitSentPerWorker, context)
                    RemitPerWorkerOut(R%) = RemitSentPerWorker
                End If
                If POPFOREIGNOUT(R%) > 0 Then 'RemitPerWorkerIn(R%) is ratio of remittance per worker relative to GDPPC
                    RemitPerWorkerIn(R%) = XWORKREMITIN(R%) / POPFOREIGNOUT(R%) / GDPPC(R%)
                Else
                    Call XYTABL("GDP/Capita Versus Remittances Received per Worker Abroad (2017)",
                    GDPPC(R%), RemitReceivedPerWorker, context)
                    RemitPerWorkerIn(R%) = RemitReceivedPerWorker
                End If
                'If RegName$(R) = "United Arab Emirates" Then Stop
            Next R%
            'bbh 2022/12/20 end substantial revisions to IY=1 code


            For R% = 1 To NR%% 'For some countries, like Mexico, this changes the intitial year value for remittances quite a bit
                XWORKREMIT(R%) = XWORKREMITIN(R%) - XWORKREMITOUT(R%)
            Next R%


