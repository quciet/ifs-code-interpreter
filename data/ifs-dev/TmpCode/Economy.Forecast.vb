                    Call XYTABL(TblNameEducExp, Amin(40, GDPPCP(R%)), edexpcomp, context)

                    'jrs 2024/06/06 
                    ' Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Hlth As % Of GDP (2000) - log",
