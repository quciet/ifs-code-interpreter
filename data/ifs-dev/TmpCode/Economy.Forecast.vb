                'bbh 2021/07/07 end

                Diff1 = (XDEBTRPA(R%) / GDPPOT(R%) - xdebttargetpergdp) * 100
                'Diff2 = (XDEBTRPA(R%) / GDPPOT(R%) - ssxdebtrpa(R%) / GDPPOT(R%)) * 100
                Diff2 = (XDEBTRPA(R%) / GDPPOT(R%) * 100) - ssxdebtrpapercent(R%)

                'bbh 2022/09/05 If/then added mostly to smooth oscillation in Luxembourg from very high asset ratios to GDP
                If XDEBTRPA(R%) / GDPPOT(R%) < -1 Then
                    Diff1 = Diff1 / Abs(XDEBTRPA(R%) / GDPPOT(R%))
                    Diff2 = Diff2 / Abs(XDEBTRPA(R%) / GDPPOT(R%))
                End If

                'bbh 2014/04/02 End Reworked exchange rate logic

