                            '        arms_total_stock_ln_ma_max = arms_total_stock_ln(i, j, 0)
                            '    End If
                            'End If 'clp 2022/03/16 commenting out unneeded code ***end*** 
                        End If
                    Next j
                Next i
                'Final Normalization 'clp 2022/03/16 commenting out unneeded code ***start*** 
                'For i = 1 To NR
                '    For j = 1 To NR
                '        If i <> j Then
                '            arms_total_stock_ln(i, j, 0) = (arms_total_stock_ln(i, j, 0) - arms_total_stock_ln_ma_min) / (arms_total_stock_ln_ma_max - arms_total_stock_ln_ma_min)
                '        End If
                '    Next j
                'Next i 'clp 2022/03/16 commenting out unneeded code ***end*** 
                'Calculate Bandwidth
                '--------------------
                For i = 1 To NR
                    For j = 1 To NR
                        If i <> j Then
                            'If i = 180 And j = 175 And IY > 2 Then Stop
                            'If i = 87 And j = 175 Then Stop
                            'jrs 2022/01/03 BANDWIDTH(i, j) = CSng(0.11 * lor_avg(i, j, 0) + 0.19 * igo_count(i, j, 0) + 0.14 * tradeagreementindex(i, j, 0) + 0.35 * ln_totaltrade(i, j, 0) + 0.13 * allianceindex(i, j, 0) + 0.08 * arms_total_stock_ln(i, j, 0))
                            BANDWIDTH(i, j) = CSng(0.11 * lor_avg(i, j, 0) + 0.19 * igo_count(i, j, 0) + 0.14 * DYADTRADEAGREEMENTINDEX(i, j) + 0.35 * ln_totaltrade(i, j, 0) + 0.13 * allianceindex(i, j, 0) + 0.08 * arms_total_stock_ln(i, j, 0))
                        End If
                    Next j
                Next i
                'Normalize Bandwith
                '-------------------
                'jrs 2021/12/15 *** start ***
                'Dim BANDWIDTH_total As Single, BANDWIDTH_min As Single, BANDWIDTH_max As Single
                'BANDWIDTH_total = 0
                'BANDWIDTH_min = -9999
                'BANDWIDTH_max = -9999
                'For i = 1 To NR
                '    For j = 1 To NR
