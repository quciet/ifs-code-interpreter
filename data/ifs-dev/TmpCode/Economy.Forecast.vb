                        'bbh 2019/10/15 start
                        Dim pridiff = spri(R%, S%) * EXRATE(R%) * (1 + iMTariffTaxR(R%, S%) / 100) - mpric * (1 + SMTariffTaxR(R%, S%) / 100)
