                    If IY > 1 Then
                        db.BulkInsertDYADTRADEAGREEMENTINDEX(DYADTRADEAGREEMENTINDEX, CShort(FirstYear + IY - 1), NR)
                    End If
                    'jrs 2025/06/04
                    'Save Bilat to Common
                    SaveBilatToCommon(DYADTRADEAGREEMENTINDEX, TRADEAGREEMENTINDEXBILAT)
    
                End Using
    
