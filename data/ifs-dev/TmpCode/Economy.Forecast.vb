                    Else
                        PovGndDiffRefAG = CSng(AMAX(PovGndDiffRefAG, -1.5 * POVRATE(R%, RefAGGnd, Total)))  '-1.5
                    End If

                    'Use gender difference and total poverty to compute poverty rates for each of the sexes
                    'mti 2020/04/29 Start
                    'POVRATE(R%, RefAGGnd, Male) = AMAX(0, (POVRATE(R%, RefAGGnd, Total) * POPPOVAG(R%, RefAGGnd, Total) - PovGndDiffRefAG * POPPOVAG(R%, RefAGGnd, Female)) / POPPOVAG(R%, RefAGGnd, Total))
                    POVRATE(R%, RefAGGnd, Male) = AMAX(0, (POVRATE(R%, RefAGGnd, Total) * POPPOVAG(R%, RefAGGnd, Total) - PovGndDiffRefAG * POPPOVAG(R%, RefAGGnd, Female)) / AMAX(0.000001, POPPOVAG(R%, RefAGGnd, Total)))
