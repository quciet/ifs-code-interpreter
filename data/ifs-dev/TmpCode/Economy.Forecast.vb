' ---- Begin Inlined Level 1: Lab_Fit_Power
' Private Sub Lab_Fit_Power(iothresh() As Single, labtab(,,) As Single, labfunc_slope(,) As Single, labfunc_intercept(,) As Single)
            'mti 2017/10/18 - New Proc



            Dim reg As New RegressionObject
            Dim X1 As Double, Y1 As Double
            Dim A As Double, B As Double
            Dim pt As Integer
            Dim sk%, S%, Thr%

            For sk% = 1 To 2
                For S% = 1 To NSec%
                    With reg
                        .Init()
                        .Degree = 1 'Degree
                        pt = 0
                        For Thr = 1 To NIOMatrices
                            If iothresh(Thr) = 0 Then
                                X1# = 1 'avoid 0 value
                            Else
                                X1# = CDbl(iothresh(Thr))
                            End If
                            Y1# = labtab(S%, sk%, Thr)
                            If X1# > 0 AndAlso Y1# > 0 Then
                                .XYAdd(Math.Log(X1#), Math.Log(Y1#))
                                pt = pt + 1
                            End If
                        Next Thr
                        A = -9999
                        B = -9999
                        If pt > 1 Then
                            A = reg.Coeff(0)
                            B = reg.Coeff(1)
                        End If
                        'Debug.Print S%, sk%, A, B
                        labfunc_intercept(S%, sk%) = CSng(Math.Exp(A))
                        labfunc_slope(S%, sk%) = CSng(B)
                    End With
                Next S%
            Next sk%



' End Sub
' ---- End Inlined Level 1: Lab_Fit_Power
