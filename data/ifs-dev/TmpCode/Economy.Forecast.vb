                        '                If SST(R%, S%) / (StBase(R%, S%) * dstl) > 1.4 Then xc(R%, S%) = Amin(1.1 * xc(R%, S%), xc(R%, S%) + 0.2 * (SST(R%, S%) - StBase(R%, S%) * dstl))
                        '                If SST(R%, S%) / (StBase(R%, S%) * dstl) < 0.6 Then xc(R%, S%) = AMAX(0.9 * xc(R%, S%), xc(R%, S%) - 0.2 * (StBase(R%, S%) * dstl - SST(R%, S%)))

                        If xc(R%, S%) < 0.0001 Then
                            xc(R%, S%) = 0.0001
                        End If
                        'dbase = CS(R%, S%) + GS(R%, S%) + INVS(R%, S%) + ZS(R%, S%) '- PFD(R%, S%)
                        'If RegName$(R%) = "Hong Kong" And S% = 4 And IY% >= 1 Then Stop

                        Dim MulInc As Single
