                    POVRATE32(R%%, j%, Total) = 100 * POVCOUNT32(R%%, j%, Total) / AMAX(0.000001, POPPOVAG(R%%, j%, Total))
                    'mti 2020/04/29 End
                    AllAgeGroupButChild = AllAgeGroupButChild + POVCOUNT32(R%%, j%, Total)
                Next
    
                'give the remaining, if any to 0-14 group
                POVCOUNT32(R%%, 1, Total) = CSng(AMAX(0, Round(POVCOUNT32(R%%, TotPovAGCount, Total) - AllAgeGroupButChild, 6)))
                'mti 2020/04/29 start
