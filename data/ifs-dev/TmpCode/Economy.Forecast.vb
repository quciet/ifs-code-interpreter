        Public Sub IFsEcoIntl1AllYears(context As IForecastContext)
            'jrs 2014/09/16
            Dim S As Integer, WX As Single, WM As Single, WT As Single, SumAid As Single, SumAidLP As Single

            'jrs 2014/04/11 *** using IFUN to avoid repeating calculation in IFUN = 3
            'If IFUN = 2 Then
            For R% = 1 To NR%
                '         X(R%) = 0!
                '         M(R%) = 0!
                XRPA(R%) = 0
                MRPA(R%) = 0

                '     All Steps:  Trade and Relative Price-Adjusted Trade
                '     ---------------------------------------------------
                For S% = 1 To NSec%
                    '            X(R%) = X(R%) + XS(R%, S%)
                    '            M(R%) = M(R%) + MS(R%, S%)
                    XRPA(R%) = XRPA(R%) + XS(R%, S%) * WP(S%) '* PRI(r%, s%) * EXRATE(r%)
                    MRPA(R%) = MRPA(R%) + MS(R%, S%) * WP(S%)

                Next S%
            Next R%

            '     All Steps:  Terms of Trade - Exogenous Change
            '     ---------------------------------------------

            WX = 0!
            WM = 0!
            termtrm = AMAX(0.1, termtrm) 'bbh 2020/05/26
            For R% = 1 To NR%
                If GDPPCI(R%) < nsdiv Then
                    XRPA(R%) = XRPA(R%) * termtrm
                    MRPA(R%) = MRPA(R%) / termtrm
                Else
                    XRPA(R%) = XRPA(R%) / termtrm
                    MRPA(R%) = MRPA(R%) * termtrm
                End If
                'bbh 2021/07/07 start Worked on this, but then moved to end of IFsEcoIntl
                '                 FORSAVRPA(R%) = MRPA(R%) - XRPA(R%) - AID(R%) ' - XWORKEMIT(R%) 'Price adjusted compatible with XDEBTRPA
                '                 'jrs 2020/08/28 moved to ifsEconSAM the members were not computed yet here
                '                 'SAVINGSRPA(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + _
                '                    FIRMSAV (R%) + GOVBAL(R%) + FORSAVRPA(R%)
                '                 FORSAV(R%) = M(R%) - X(R%) - AID(R%) ' - XWORKEMIT(R%) 'bbh 2021/07/07
                '                 SAVINGS(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + FIRMSAV(R%) + GOVBAL(R%) + FORSAV(R%)
                '                 SAVINGSRPA(R%) = HHSAV(R%, Unskilled) + HHSAV(R%, Skilled) + FIRMSAV(R%) + GOVBAL(R%) + FORSAVRPA(R%)
                '                 If RegName$(R%) = "Ethiopia" Then Stop
                'bbh 2021/07/07 end
                WX = WX + XRPA(R%)
                WM = WM + MRPA(R%)
            Next R%

            '     All Steps:  Relative-price Adjusted Trade and Payments Balances
            '     ---------------------------------------------------------------
            WX = AMAX(0.01, WX)
            WM = AMAX(0.01, WM)
            WT = (WM + WX) / 2
            WTRADE = WT / WGDP * 100
            SumAid = 0
            SumAidLP = 0
            For R% = 1 To NR%
                XRPA(R%) = XRPA(R%) / AMAX(0.01, WX) * WT
                MRPA(R%) = MRPA(R%) / AMAX(0.01, WM) * WT
                'TRADEBAL(R%) = XRPA(R%) - MRPA(R%)
                TRADEBAL(R%) = X(R%) - M(R%) 'bbh 2021/07/07
                SExRate(R%) = EXRATE(R%)
                'jrs 2014/04/11
                '             SX(R%) = X(R%)
                '             SM(R%) = M(R%)
                If IY% > 1 Then
                    aidlp(R%) = AMAX(0, Amin(1, AIDLPI(R%) * aidlpm))
                End If
                If AID(R%) > 0 Then 'Recipients
                    SumAid = SumAid + AID(R%)
                    SumAidLP = SumAidLP + AID(R%) * aidlp(R%)
                End If
            Next R%
            WorldAidLP = SumAidLP / AMAX(0.001, SumAid)

            '     All Steps:  Foreign Finance Update
            '     -------------------------------
            '       Basic Concepts
            '       CURACT = -CAPACT (within which is included - Increase in Reserves)
            '       or CURACT = -CAPACTLim - Increase in Govt Debt + Increase Reserves
            '       or Increase in Govt Debt = - CURACT - CAPACTLim + Increase Reserves

            'bbh 2022/06/23 Start Addition of elaborated intl stock and flow accouting
            'jrs 2014/09/16
            'gvdb 2024/04/05
            ' unused variable
            Dim DebtToIFIs As Single, NetFirmDebtAbroad As Single, NetGovtDebtAbroad As Single ' NetFDIFrAbroad As Single, NetPortfolioFrAbroad As Single, 
            Dim NetInterestPaidAbroad As Single, TargetRes As Single, delxreserves As Single, ReserveAbs As Single, CapActLim As Single

            For R% = 1 To NR%
                '       Current Account Balance
                '       -----------------------
                'If RegName$(R%) = "Britain" Then Stop


                DebtToIFIs = XIMFCREDIT(R%) + XWBLOANS(R%) 'These terms represent net flow in and are thererfore debt to repay/pay interest on
                'Borrowers positive; subscribers negative
                '            bbh 2022/10/27 Commented out next 3 lines; new code in preprocessor handles XFIRMDEBT better
                '            NetFDIFrAbroad = XFDISTOCK(R%) - XFDISTOUT(R%) 'The net is inward stock that will generate return flows outward; also portfolio
                '            NetPortfolioFrAbroad = XPORTFOLIO(R%) - XPORTSTOUT(R%)
                '            XFIRMDEBT(R%) = NetFDIFrAbroad + NetPortfolioFrAbroad

                'If RegName$(R%) = "United States of America" And IY% = 1 Then Stop
                NetFirmDebtAbroad = XFIRMDEBT(R%) 'Need to subtract firm assets abroad term
                NetGovtDebtAbroad = XGOVTDEBT(R%) 'Need to subtract govt assets abroad term
                NetInterestPaidAbroad = DebtToIFIs * lintr + NetFirmDebtAbroad * lintr +
                 NetGovtDebtAbroad * lintr
                CURACT(R%) = TRADEBAL(R%) + AID(R%) + XWORKREMIT(R%) '- NetInterestPaidAbroad Turn back off for now
                'Definitionally, CURACT does include trade balance, unilateral transfers such as remittances and aid, and
                '   also income receipts (e.g. dividend and interest payments from foreign assets); was finding that
                '   the Interest term here was not behaving very well; need to revisit foreign assets treatment
                'FORSAV(R%) = CURACT(R%) 'bbh 2020/07/07
                'FORSAV(R%) = -CURACT(R%) 'bbh 2021/07/07 'this is right, -CURACT, but FORSAV now computed elsewhere
                'For S% = 1 To NSec% 'bbh 2022/12/13 For-Next added because earlier SMTariffRev was added to GOVREV, so this needed in SAM logic
                '    CURACT(R%) = CURACT(R%) + SMTariffRev(R%, S%) 'bbh 2024/06/29 Commented out For-next block becuase rise in CURACT and negative XDEBTRPA affects trade perversely
                'Next S%
                If IY% = 1 Then 'bbh 2022/12/20 If then Else block
                    SSCurActRGDP(R%) = CURACT(R%) / GDPPOT(R%)
                Else
                    SSCurActRGDP(R%) = SCurActRGDP(R%)
                End If
                SCurActRGDP(R%) = CURACT(R%) / GDPPOT(R%) 'bbh 2022/12/20

                CURACTNETPRI(R%) = -NetInterestPaidAbroad / GDPPOT(R%) * 100 '- NetInterestPaidAbroad Turn back off for now
                CURACTNETSEC(R%) = (AID(R%) + XWORKREMIT(R%)) / GDPPOT(R%) * 100
                For S% = 1 To NSec% 'bbh 2022/12/13 For-Next added because earlier SMTariffRev was added to GOVREV, so this needed in SAM logic
                    CURACTNETSEC(R%) = CURACTNETSEC(R%) + SMTariffRev(R%, S%) / GDPPOT(R%) * 100
                Next S
                CURACTDATATOP(R%) = TRADEBAL(R%) / GDPPOT(R%) * 100 + CURACTNETPRI(R%) + CURACTNETSEC(R%)
                If IY% = 1 Then
                    SXNFA(R%) = XNFA(R%)
                    SXNIIP(R%) = XNIIP(R%)
                Else
                    XNFA(R%) = SXNFA(R%) + CURACTDATATOP(R%) 'Is %; includes all Current account terms
                    SXNFA(R%) = XNFA(R%)
                    'ssxdebtrpa(R%) = sxdebtrpa(R%)
                    ssxdebtrpapercent(R%) = sxdebtrpa(R%) / GDPPOT(R%) * 100 'Save XDEBT as % of GDP for comparison with current values in computing EXRATE
                    'If RegName$(R%) = "Luxembourg" And IY% >= 77 Then Stop
                    XDEBTRPA(R%) = sxdebtrpa(R%) - CURACT(R%) 'Leaving out CURACTNETPRI/Intereset for now; if go there, could use next line
                    'XDEBTRPA(R%) = -XNFA(R%) / 100 * GDPPOT(R%) 'Conceptually XDEBTRPA was like XNIIP; now like XNFA but opposite sign
                    sxdebtrpa(R%) = XDEBTRPA(R%)
                    'If RegName$(R%) = "Luxembourg" And IY% >= 77 Then Stop
                    XNIIP(R%) = SXNIIP(R%) + (XPORTFOUT(R%) - XPORTFIN(R%) + XFDIFOUT(R%) - XFDIFIN(R%)) / GDPPOT(R%) * 100
                    SXNIIP(R%) = XNIIP(R%)
                End If
                'bbh 2022/06/23 End Addition of elaborated/revised intl stock and flow accouting

                '       Reserves - treated as necessary level in the long run
                '       -----------------------------------------------------

                'TargetRes = SXReserves(R%)
                'DelXReserves = TargetRes - SXReserves(R%)
                'XRESERVES(R%) = SXReserves(R%) + DelXReserves
                'SXReserves(R%) = XRESERVES(R%)
                'LIQUIDITY(R%) = CURACT(R%) / AMAX(0.001, XRESERVES(R%)) * 100

                ' Save reserves in absolute levels (SXReserves); Report as % of GDP (XRESERVES)
                TargetRes = ConvergeOverTime(SXReserves(R%) / GDPPOT(R%) * 100, 15, govfinconv)
                'Base, Target, Years
                delxreserves = TargetRes / 100 * GDPPOT(R%) - SXReserves(R%)
                If IY% >= 2 Then
                    XRESERVES(R%) = TargetRes
                End If
                ReserveAbs = TargetRes / 100 * GDPPOT(R%)
                SXReserves(R%) = ReserveAbs
                LIQUIDITY(R%) = CURACT(R%) / AMAX(0.001, ReserveAbs) * 100
                If XRESERVES(R%) < 0.001 Then
                    LIQUIDITY(R%) = -9999
                End If

                'bbh 2022/06/23 Start changes to govt debt flows; govt not reponsible for FDI and portfolio debt
                '   Those belong in net international investment position and firm postions; but responsible for IFI debt
                '       Capital Account
                '       -----------------------------------------------------

                CapActLim = XIMFCRFIN(R%) - XIMFCRFOUT(R%) _
                + XWBLNFIN(R%) - XWBLNFOUT(R%)

                '       Government External Debt Changes Needed/Available for Balancing
                '           Could be Short-term, Mid- to Long-Term; IFI sources, etc.
                '       ---------------------------------------------------------------

                'XGOVTDEBTBF(R%) = -CURACT(R%) - capactlim + delxreserves 'Basic Govt Debt
                XGOVTDEBTBF(R%) = -CURACT(R%) - CapActLim '+ delxreserves
                'bbh 2022/06/23 End changes to govt debt flows;
                'Reserves as liability in one country are asset elsewhere, so until spread
                '   across origin-target countries should not add to debt
                'Net IMF and WB contributions to capactlim are not now being balanced by
                '   subscriptions as asset
                'Ultimately, world sum of XGOVTEDBTF should be 0

                '        GrantPortion = AID(R%) * (1 - aidlp)

                'bbh 2014/04/02 This code now called 2 times in ModelRun; line below can only be computed once
                '   or it makes ssxdebtrpa = XDEBTRPA
                'jrs 2014/04/11 If IFUN = 2 Then
                'ssxdebtrpa(R%) = XDEBTRPA(R%) 'bbh 2022/06/23
                'jrs 2014/04/11 End If

            Next R%

            '     All Steps:  North/South Gap and Terms of Trade
            '     ----------------------------------------------
            'jrs 2014/09/16
            Dim GDPNO As Single, GDPSO As Single, PNO As Single, PSO As Single, Sum As Single, SMAN As Single, TN As Single, TS As Single, TWN As Single
            Dim TWS As Single, EXM1 As Single, EXM2 As Single

            GDPNO = 0!
            GDPSO = 0!
            PNO = 0!
            PSO = 0!
            Sum = 0
            SMAN = 0
            TN = 0 'bbh 2023/01/02  broke up a line that put this and next three together with :  symbols between them
            TS = 0
            TWN = 0
            TWS = 0
            For R% = 1 To NR%
                EXM1 = EXRATE(R%) / termtrm
                EXM2 = EXRATE(R%) * termtrm
                For S% = 1 To NSec%
                    Sum = Sum + ZS(R%, S%)
                    If GDPPCI(R%) >= nsdiv Then
                        TN = TN + XS(R%, S%)
                        TWN = TWN + XS(R%, S%) * PRI(R%, S%) * EXM1
                    Else
                        TS = TS + XS(R%, S%)
                        TWS = TWS + XS(R%, S%) * PRI(R%, S%) * EXM2
                    End If
                Next S%
            Next R%
            For R% = 1 To NR
                If GDPPCI(R%) > nsdiv Then
                    PNO = PNO + POP(R%)
                    GDPNO = GDPNO + GDP(R%)
                Else
                    PSO = PSO + POP(R%)
                    GDPSO = GDPSO + GDP(R%)
                End If
                gdppchold(R%) = GDPPOT(R%) / AMAX(0.001, POP(R%))
            Next R%

            'jrs 2014/09/16
            Dim GDPPCLargest As Single, ICount As Integer, MatSmall As Single, jCount As Integer, SmallReg As Integer

            GDPPCLargest = 100000000
            For ICount% = 1 To NR%
                MatSmall = GDPPCLargest
                For jCount% = 1 To NR%  'Find smallest value not yet identified
                    If gdppchold(jCount%) <= MatSmall Then
                        MatSmall = gdppchold(jCount%)
                        SmallReg = jCount%
                    End If
                Next jCount%
                gdppcrank(ICount%) = SmallReg
                'Hold region number of smallest element
                gdppchold(SmallReg) = Abs(GDPPCLargest * 2) 'Do not reuse smallest element
            Next ICount%

            'jrs 2014/09/16
            Dim topgdp As Single, toppop As Single, botgdp As Single, botpop As Single, WPOP10 As Single, PopCount As Integer, PopFrac As Single

            topgdp = 0
            toppop = 0
            botgdp = 0
            botpop = 0
            WPOP10 = CSng(0.1 * WPOP)
            '      For ICount% = 1 To 20
            '            botgdp = botgdp + GDPPOT(gdppcrank(ICount%))
            '            botpop = botpop + POP(gdppcrank(ICount%))
            '      Next ICount%
            '      For ICount% = NR% - 20 To NR%
            '            topgdp = topgdp + GDPPOT(gdppcrank(ICount%))
            '            toppop = toppop + POP(gdppcrank(ICount%))
            '      Next ICount%
            PopCount = 0
            For ICount% = 1 To NR%
                If PopCount + POP(gdppcrank(ICount%)) < WPOP10 Then
                    botgdp = botgdp + GDPPOT(gdppcrank(ICount%))
                    botpop = botpop + POP(gdppcrank(ICount%))
                    PopCount = PopCount + CInt(POP(gdppcrank(ICount%)))
                Else
                    PopFrac = (WPOP10 - PopCount) / AMAX(0.001, POP(gdppcrank(ICount%)))
                    botgdp = botgdp + GDPPOT(gdppcrank(ICount%)) * PopFrac
                    botpop = botpop + POP(gdppcrank(ICount%)) * PopFrac
                    Exit For
                End If
            Next ICount%
            PopCount = 0
            For ICount% = NR% To 0 Step -1
                If PopCount + POP(gdppcrank(ICount%)) < WPOP10 Then
                    topgdp = topgdp + GDPPOT(gdppcrank(ICount%))
                    toppop = toppop + POP(gdppcrank(ICount%))
                    PopCount = CInt(PopCount + POP(gdppcrank(ICount%)))
                Else
                    PopFrac = (WPOP10 - PopCount) / AMAX(0.001, POP(gdppcrank(ICount%)))
                    topgdp = topgdp + GDPPOT(gdppcrank(ICount%)) * PopFrac
                    toppop = toppop + POP(gdppcrank(ICount%)) * PopFrac
                    Exit For
                End If
            Next ICount%

            NSGAPRTB = (topgdp / AMAX(0.001, toppop)) / ((AMAX(0.001, botgdp) / AMAX(0.001, botpop)))

            GDPNO = CSng(GDPNO / AMAX(PNO, 0.01))
            GDPSO = CSng(GDPSO / AMAX(PSO, 0.01))
            NSGAPR = CSng(GDPNO / AMAX(GDPSO, 0.01))
            NSGAPA = GDPNO - GDPSO
            TERMTR = CSng(TWS * TN / AMAX(TS * TWN, 0.01))
            WGDPPC = WGDP / WPOP

        End Sub
