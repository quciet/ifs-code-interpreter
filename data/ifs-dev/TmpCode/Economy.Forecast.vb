                '   But when gdprext operative, final GDP is determinant via VADD and disposable income; no adjustment
                If gdprext(R%) < -90 Then
                    C(R%) = C(R%) * (GDPPOT(R%) + GDP(R%)) / 2 / GDP(R%)
                End If

                'If RegName$(R%) = "United States of America" And IY% >= 7 Then Stop
