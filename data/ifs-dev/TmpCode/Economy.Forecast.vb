                    PcntChangeDiffRefAG = (PovGndDiffRefAG - iPovGndDiffAG(R%, RefAGGnd)) / iPovGndDiffAG(R%, RefAGGnd)
                Else
                    'use percentage point when initial difference is zero or small
                    PcntPointChangeDiffRefAG = PovGndDiffRefAG - iPovGndDiffAG(R%, RefAGGnd)
                End If


                'Compute gender difference (and poverty rate) in other age-groups using changes in reference group gender difference
                For j% = 1 To TotPovAGCount

                    If j% <> RefAGGnd Then

                        If POVRATE(R%, j%, Total) = 0 Then
                            POVRATE(R%, j%, Male) = 0
                            POVRATE(R%, j%, Female) = 0
                        Else

                            'mti 2021/07/15 start
                            If iPovGndDiffAG(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG(R%, RefAGGnd)) > 0.9 Then ' changed .2 to .9
                                'mti 2021/07/15 end
                                PovGndDiffAG = iPovGndDiffAG(R%, j%) + PcntChangeDiffRefAG * iPovGndDiffAG(R%, j%)
                            Else
                                PovGndDiffAG = iPovGndDiffAG(R%, j%) + PcntPointChangeDiffRefAG
                            End If

                            'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                            If PovGndDiffAG >= 0 Then
                                PovGndDiffAG = CSng(Amin(PovGndDiffAG, 1.5 * POVRATE(R%, j, Total)))
                            Else
                                PovGndDiffAG = CSng(AMAX(PovGndDiffAG, -1.5 * POVRATE(R%, j, Total)))
                            End If

                            POVRATE(R%, j%, Male) = AMAX(0, (POVRATE(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / POPPOVAG(R%, j%, Total))
                            POVRATE(R%, j%, Female) = AMAX(0, PovGndDiffAG + POVRATE(R%, j%, Male))
                            '
                            'Make sure there is at least some poverty in each gender
                            'mti 2020/04/29 Start
                            'POVRATE(R%, j%, Male) = AMAX(0, (POVRATE(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / POPPOVAG(R%, j%, Total))
                            POVRATE(R%, j%, Male) = AMAX(0, (POVRATE(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / AMAX(0.000001, POPPOVAG(R%, j%, Total)))
                            'mti 2020/04/29 End
                            POVRATE(R%, j%, Female) = AMAX(POVRATE(R%, j%, Male) * 0.2, POVRATE(R%, j%, Female))


                        End If



                    End If

                Next j%
                'mti 2020/03/18 End

                'Normalize poverty across sexes within the same age group
