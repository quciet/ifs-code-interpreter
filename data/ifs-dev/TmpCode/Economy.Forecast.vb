                    If GRPS(1, R%) = "Central African Republic" And context.HistoricMode = False Then
                        MFPRATE(R%, S%) = CSng(MFPRATE(R%, S%) + 0.01)
                    End If
                    'bbh 2019/09/08 end
                    '            Else
                    '                MFPRATE(R%, S%) = MFPRATE(R%, S%) + techpremium / 100 _
                    '+ mfpbasgr + mfpbasinc * zy + glocorrect 'no growth boost if have historic
                    '            End If
                    'If RegName$(R%) = "United States Of America" And IY% >= 5 And S% = 5 Then Stop
                    'bbh 7/2/2009 end
                Next S%
                'If RegName$(R%) = "Brunei" Then Stop

                '   All but First 1:  Productivity Growth:  Compute Productivity Components - Basic Inputs
                '   --------------------------------------------------------------------------------------

                EGDP = SGDP(R%) * (1 + IGDPRCor(R%))
                If context.HistoricMode Then
                    Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Educ As % Of GDP (1960) - log",
                    Amin(40, GDPPCP(R%)), edexpcomp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Hlth As % Of GDP (1990) - log",
                    Amin(40, GDPPCP(R%)), HlExpComp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus R&D Total  As % Of GNI (1980) - linear",
                    Amin(40, GDPPCP(R%)), rdexpcomp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus Years Of Educ at 15+ (1960)",
                    GDPPCP(R%), yrsedcomp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus Life Expectancy (1970)",
                    GDPPCP(R%), lifeexpcomp, context)
                    Call XYTABL("GDP/Capita (PPP 2005) Versus Stunting (2005) Log",
                    GDPPCP(R%), stuntingcomp, context)
                Else
                    'jrs 2024/06/06 
                    'Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Educ As % Of GDP (2002) - log",
                    'Amin(40, GDPPCP(R%)), edexpcomp, context)
                    Call XYTABL(TblNameEducExp, Amin(40, GDPPCP(R%)), edexpcomp, context)

                    'jrs 2024/06/06 
                    'Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Hlth As % Of GDP (2000) - log",
                    'Amin(40, GDPPCP(R%)), HlExpComp, context)
                    Call XYTABL(TblNameHealthExp, Amin(40, GDPPCP(R%)), HlExpComp, context)

                    'jrs 2013/11/28
                    '            Call XYTABL("GDP/Capita (PPP) Versus R&D Total  As % Of GNI (2000) - linear", _
                    '               Amin(40, GDPPCP(R%)), rdexpcomp)
                    'jrs 2024/06/28 Call XYTABL("GDP/Capita (PPP 2005) Versus R&D Total  As % Of GDP (2009) Linear",
                    'Amin(40, GDPPCP(R%)), rdexpcomp, context)
                    Call XYTABL(TblNameRandDPctGDP, Amin(40, GDPPCP(R%)), rdexpcomp, context)
                    'jrs 2013/11/28 Call XYTABL("GDP/Capita (PPP) Versus Years Of Educ at 15+ (2000)", _
                    '   GDPPCP(R%), yrsedcomp)
                    'jrs 2024/06/28 Call XYTABL("GDP/Capita (PPP 2005) Versus Years Of Educ at 15+ (2010) Log",
                    'GDPPCP(R%), yrsedcomp, context)
                    Call XYTABL(TblNameYrsEduc15, GDPPCP(R%), yrsedcomp, context)
                    'jrs 2024/06/19 Call XYTABL("GDP/Capita (PPP) Versus Life Expectancy (2000)",
                    'GDPPCP(R%), lifeexpcomp, context)
                    Call XYTABL(TFNameLifeExp, GDPPCP(R%), lifeexpcomp, context)
                    'jrs 2013/11/28 Call XYTABL("GDP/Capita (PPP 2005) Versus Stunting (2005) Log", _
                    'GDPPCP(R%), stuntingcomp)
                    'jrs 2024/06/13 Call XYTABL("GDP/Capita (PPP 2005) Versus Stunting (2006) Log",
                    'GDPPCP(R%), stuntingcomp, context)
                    Call XYTABL(TblNameStunting, GDPPCP(R%), stuntingcomp, context)
                End If

                '   All but First 1:  Productivity Growth:  Compute Productivity Components - Human Capital
                '   --------------------------------------------------------------------------------------

                edexpcontrib = (sgds(R%, Educ) * (1 + IGDPRCor(R%)) / EGDP * 100 - edexpcomp) * mfpedspn '0.3
                'bbh 2013/08/04 slow down life expectancy impact when sceenario pushes it very fast
                LifExpFac = Amin(SLIFEXP(R%), SLIFEXPSlow(R%) + 2)
