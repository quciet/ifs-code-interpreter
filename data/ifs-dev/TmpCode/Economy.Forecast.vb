    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex32FirstYear:IFsEcoPovBroadAG
' Private Sub IFsEcoPovBroadAG(R%, Pov15PCTVec(,) As Single, Pov25PCTVec(,) As Single, PovCountVec(,,) As Single, agEnd() As Single)
                '-----------------------------------------------------------------------
                'mti 2021/12/28 New Procedure
    
                'Get Poverty Counts
                Dim Pop15Plus(3) As Single, Pop25Plus(3) As Single, gndr As Integer, j As Integer
                For gndr = 1 To NGender%
                    POV15PCT32(R%%, gndr%) = POVCOUNT32(R%%, TotPovAGCount, gndr%)
                    POV25PCT32(R%%, gndr%) = POVCOUNT32(R%%, TotPovAGCount, gndr%)
                    Pop15Plus(gndr%) = POPPOVAG(R%%, TotPovAGCount, gndr%)
                    Pop25Plus(gndr%) = POPPOVAG(R%%, TotPovAGCount, gndr%)
    
                    For j% = 1 To TotPovAGCount - 1
                        If agEnd(j) <= 3 Then   '15+
                            'jrs 2026/05/11 - shouldn't be Male but gender
                            'POV15PCT32(R%%, gndr%) = POV15PCT32(R%%, gndr%) - POVCOUNT32(R%%, j, Male)
                            POV15PCT32(R%%, gndr%) = POV15PCT32(R%%, gndr%) - POVCOUNT32(R%%, j, gndr%)
                            Pop15Plus(gndr%) = Pop15Plus(gndr%) - POPPOVAG(R%%, j, gndr%)
                        End If
                        If agEnd(j) <= 5 Then   '25+
                            'jrs 2026/05/11 - shouldn't be Male but gender
                            'POV25PCT32(R%%, gndr%) = POV25PCT32(R%%, gndr%) - POVCOUNT32(R%%, j, Male)
                            POV25PCT32(R%%, gndr%) = POV25PCT32(R%%, gndr%) - POVCOUNT32(R%%, j, gndr%)
                            Pop25Plus(gndr%) = Pop25Plus(gndr%) - POPPOVAG(R%%, j, gndr%)
                        End If
                    Next
                    POV15PCT32(R%%, gndr%) = 100 * POV15PCT32(R%%, gndr%) / AMAX(0.000001, Pop15Plus(gndr%))
                    POV25PCT32(R%%, gndr%) = 100 * POV25PCT32(R%%, gndr%) / AMAX(0.000001, Pop25Plus(gndr%))
                Next
    
    
                '    POV15PCT32(R%%, Male) = POVCOUNT32(R%%, TotPovAGCount, Male) - POVCOUNT32(R%%, 1, Male)
                '    POV25PCT32(R%%, Male) = POV15PCT32(R%%, Male) - POVCOUNT32(R%%, 2, Male)
                '    POV15PCT32(R%%, Female) = POVCOUNT32(R%%, TotPovAGCount, Female) - POVCOUNT32(R%%, 1, Female)
                '    POV25PCT32(R%%, Female) = POV15PCT32(R%%, Female) - POVCOUNT32(R%%, 2, Female)
                '    POV15PCT32(R%%, Total) = POV15PCT32(R%%, Male) + POV15PCT32(R%%, Female)
