                '----------------------------------------------

                'use regression model done by Yutang to forecast gender difference in poverty in reference group (=25-34)
                'PovGndDiffRef = 2.1391 - .9123 * LabWageSexRatio  -0.6947 * EdTerEnrollGross%FtoM + 0.0583 * 100 * INCOMELT190LN(R%) / POP(R%) -0.5863* GEM
                'Gender difference in percentage points = Female Poverty Rate for the age group - Male poverty rate for the age group
                'Setting the co-eff of national poverty rate to zero per BBH and DKB, thus making the whole regression relationship questionable
                'jrs 2025/09/12 added 2021
                'jrs 2022/11/22
                If (INCOMELT190LN(R%) = 0 And ConstantDollarsYear = 2011) Or (INCOMELT215LN(R%) = 0 And ConstantDollarsYear = 2017 Or
                    POVEXTREME(R%) = 0 And ConstantDollarsYear = 2021) Then 'no poverty
                    PovGndDiffRefAG = 0
                Else
                    'mti 2021/10/15 start
                    'PovGndDiffRefAGComp = -6.094 - 0.388 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    '+ 2.324 * Log(AMAX(0.001, CBR(R%))) - 2.456 * Log(LABWAGESEXRAT(R%)) - 4.214 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / EDYRSAG15(R%, Male)))

                    'mti 2021/12/09 start   DB Revised Regression

                    'PovGndDiffRefAGComp = -7.36375656091479 - 0.153807813024734 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / AMAX(0.00001, HHPOP(R%, Unskilled)))) _
                    '+ 2.693768741951 * Log(AMAX(0.001, CBR(R%))) - 2.7432958799481 * Log(LABWAGESEXRAT(R%)) - 5.79263679194351 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / AMAX(0.0001, EDYRSAG15(R%, Male))))

                    'mti 2026/07/05 start
                    'earlier regresssion from DB
                    'PovGndDiffRefAGComp = CSng(-6.87728552651767 + 2.66773468871275 * Log(AMAX(0.001, GINIDOM(R%))) +
                    '    3.07978974074148 * Log(AMAX(0.001, 100 * POPLE15(R%) / POP(R%))) - 3.4263931890851 * Log(LABWAGESEXRAT(R%)) - 6.90507123458496 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / AMAX(0.0001, EDYRSAG15(R%, Male)))))

                    'Regression with new data
                    PovGndDiffRefAGComp = CSng(-2.84621304469689 + 1.25134911188867 * Log(AMAX(0.001, GINIDOM(R%))) +
                        1.44023689738012 * Log(AMAX(0.001, 100 * POPLE15(R%) / POP(R%))) - 0.621784157012075 * Log(LABWAGESEXRAT(R%)) - 3.25714234081806 * Log(AMAX(0.001, EDYRSAG25(R%, Female) / AMAX(0.0001, EDYRSAG25(R%, Male)))))
