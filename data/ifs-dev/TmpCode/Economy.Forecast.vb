    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex420AllButFirst:PovertyNormalizeGender
' Private Sub PovertyNormalizeGender(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, PovGndRatioVec(,) As Single, Optional StartAG% = 1, Optional EndAG% = TotPovAGCount)
    
                'mti 2021/12/28 Take entire procedure
                'mti 2021/01/29 Take entire procedure R%%, POVRATE420(), POVCOUNT420(), povnational_hc As Single
    
                'mti 2020/03/18 Whole procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
    
                Dim j As Integer, NormFac As Single
    
                For j% = StartAG% To EndAG% '1 To TotPovAGCount
                    'Debug.Print j%
                    If POVCOUNT420(R%%, j%, Total) = 0 Or (POVRATE420(R%%, j%, Male) = 0 And POVRATE420(R%%, j%, Female) = 0) Then
                        POVCOUNT420(R%%, j%, Male) = 0
                        POVCOUNT420(R%%, j%, Female) = 0
                        POVRATE420(R%%, j%, Male) = 0
                        POVRATE420(R%%, j%, Female) = 0
                        PovGndRatioVec(R%%, j%) = 1
    
                    Else
                        'Get headcounts by gender using rates and population by gender
                        POVCOUNT420(R%%, j%, Female) = POVRATE420(R%%, j%, Female) * POPPOVAG(R%%, j%, Female) / 100
                        POVCOUNT420(R%%, j%, Male) = POVRATE420(R%%, j%, Male) * POPPOVAG(R%%, j%, Male) / 100
    
                        'Compute normalization factor
                        'mti 2020/03/18 start
                        'NormFac = POVCOUNT420(R%%, j%, Total) / AMAX(0.0001, (POVCOUNT420(R%%, j%, Male) + POVCOUNT420(R%%, j%, Female)))
                        NormFac = POVCOUNT420(R%%, j%, Total) / AMAX(0.000001, (POVCOUNT420(R%%, j%, Male) + POVCOUNT420(R%%, j%, Female)))
    
    
                        'Normalize headcounts
                        'mti 2021/07/15 start
                        POVCOUNT420(R%%, j%, Female) = CSng(Amin(POPPOVAG(R%%, j%, Female), Round(POVCOUNT420(R%%, j%, Female) * NormFac, 6)))
                        POVCOUNT420(R%%, j%, Male) = CSng(Amin(POPPOVAG(R%%, j%, Male), AMAX(0, Round(POVCOUNT420(R%%, j%, Total) - POVCOUNT420(R%%, j%, Female), 6))))
    
                        'Just in case male had to be bounded at 100; give all of the remainder to female
                        POVCOUNT420(R%%, j%, Female) = CSng(AMAX(0, Round(POVCOUNT420(R%%, j%, Total) - POVCOUNT420(R%%, j%, Male), 6)))
                        'mti 2021/07/15 end
    
                        '            POVCOUNT420(R%%, j%, Male) = Round(POVCOUNT420(R%%, j%, Male) * NormFac, 6)
                        '            POVCOUNT420(R%%, j%, Female) = AMAX(0, Round(POVCOUNT420(R%%, j%, Total) - POVCOUNT420(R%%, j%, Male), 6))
    
    
    
                        'recompute (normalized) rates by gender
                        POVRATE420(R%%, j%, Female) = 100 * POVCOUNT420(R%%, j%, Female) / AMAX(0.000001, POPPOVAG(R%%, j%, Female))
                        POVRATE420(R%%, j%, Male) = 100 * POVCOUNT420(R%%, j%, Male) / AMAX(0.000001, POPPOVAG(R%%, j%, Male))
    
                        'Compute gender ratio
                        '            If POVRATE420(R%%, j%, Female) = 0 Or POVRATE420(R%%, j%, Male) = 0 Then
                        '                PovGndRatioVec(R%%, j%) = 1
                        '            Else
    
                        'PovGndRatioVec(R%%, j%) = POVRATE420(R%%, j%, Female) / POVRATE420(R%%, j%, Male)  '0.001
                        'less than half a percent poverty in either group consisdered as equal poverty
                        PovGndRatioVec(R%%, j%) = AMAX(0.005, POVRATE420(R%%, j%, Female)) / AMAX(0.005, POVRATE420(R%%, j%, Male)) '0.001
                        '                If PovGndRatioVec(R%%, j%) > 15 Then Stop
    
                        '            End If
                        'mti 2020/03/18 End
                    End If
                Next j%
    
    
                'mti 2020/03/25 Start
                If POVCOUNT420(R%%, TotPovAGCount, Total) = 0 Then
                    POVCOUNT420(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT420(R%%, TotPovAGCount, Female) = 0
                    POVRATE420(R%%, TotPovAGCount, Male) = 0
                    POVRATE420(R%%, TotPovAGCount, Female) = 0
                    PovGndRatioVec(R%%, TotPovAGCount) = 1
                Else
                    'If RegName(R%%) = "India" Then Stop
                    POVCOUNT420(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT420(R%%, TotPovAGCount, Female) = 0
                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNT420(R%%, TotPovAGCount, Male) = POVCOUNT420(R%%, TotPovAGCount, Male) + POVCOUNT420(R%%, j%, Male)
                        POVCOUNT420(R%%, TotPovAGCount, Female) = POVCOUNT420(R%%, TotPovAGCount, Female) + POVCOUNT420(R%%, j%, Female)
                    Next j%
    
    
    
                    POVRATE420(R%%, TotPovAGCount, Male) = 100 * POVCOUNT420(R%%, TotPovAGCount, Male) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Male))
                    POVRATE420(R%%, TotPovAGCount, Female) = 100 * POVCOUNT420(R%%, TotPovAGCount, Female) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Female))
                    PovGndRatioVec(R%%, TotPovAGCount) = AMAX(0.005, POVRATE420(R%%, TotPovAGCount, Female)) / AMAX(0.005, POVRATE420(R%%, TotPovAGCount, Male)) '0.001
                End If
                'mti 2020/03/25 End
    
                'mti 2021/12/28 start
                '15 plus and 25 plus computation taken to new procedure
                'mti 2021/12/28 End
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSex420AllButFirst:PovertyNormalizeGender
