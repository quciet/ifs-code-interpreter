' ---- Begin Inlined Level 1: ComputeEarnings
' Private Sub ComputeEarnings(R%, IY%)
            '-------------------------------------------------------------------

            'mti 2018/10/22 Take enrtire routine

            'gvdb 2024/04/05
            ' unused variable
            Dim VAddFromLab, VADDHHUTot, VADDHHSTot, LABSkTot, LABUnSkTot, VAddCalc As Single ', hhinctot As Single
            Dim i2 As Integer, S As Integer

            LABUnSkTot = 0
            LABSkTot = 0

            For S% = 1 To NSec%
                LABUnSkTot = LABUnSkTot + LABEMPS(R%%, S%, Unskilled)
                LABSkTot = LABSkTot + LABEMPS(R%%, S%, Skilled)
            Next S%


            'Debug.Print "Country, Year, Sector, Sk Emp, UnSkEmp, Sk Wage, Unsk Wage"
            If IY% = 1 Then

                'If RegName(R%%) = "Brunei" Then Stop
                For S% = 1 To NSec%
                    VAddFromLab = VADD(R%%, S%) * (1 - alphas(R%%, S%))
                    LABWAGES(R%%, S%, Unskilled) = VAddFromLab * LABWAGESSHRSKL(R%%, S%, Unskilled) / 100 / AMAX(0.0001, LABEMPS(R%%, S%, Unskilled))
                    LABWAGES(R%%, S%, Skilled) = VAddFromLab * LABWAGESSHRSKL(R%%, S%, Skilled) / 100 / AMAX(0.0001, LABEMPS(R%%, S%, Skilled))
                Next S%

                LABWAGES(R%%, Agri, Unskilled) = CSng(Amin(0.5 * LABWAGES(R%%, Serv, Unskilled), Amin(0.5 * LABWAGES(R%%, Manu, Unskilled), LABWAGES(R%%, Agri, Unskilled))))
                LABWAGES(R%%, Agri, Skilled) = CSng(Amin(0.5 * LABWAGES(R%%, Serv, Skilled), Amin(0.9 * LABWAGES(R%%, Manu, Skilled), LABWAGES(R%%, Manu, Skilled))))

                For S% = 1 To NSec%
                    LABWAGES(R%%, S%, Skilled) = AMAX(1.2 * LABWAGES(R%%, S%, Unskilled), LABWAGES(R%%, S%, Skilled))
                Next S%


                i2 = 0
                Do While i2 < 30

                    VADDHHUTot = 0
                    VADDHHSTot = 0
                    For S% = 1 To NSec%
                        '            VADDHHU(R%%, S%) = VADD(R%%, S%) * LaborF(R%%, Unskilled, S%)
                        '            VADDHHS(R%%, S%) = VADD(R%%, S%) * LaborF(R%%, Skilled, S%)
                        '            'LABWAGES(R%%, S%, Unskilled) = VAddFromLab * LABWAGESSHRSKL(R%%, S%, Unskilled) / 100 / AMAX(0.0001, LABEMPS(R%%, S%, Unskilled))

                        VADDHHU(R%%, S%) = LABWAGES(R%%, S%, Unskilled) * LABEMPS(R%%, S%, Unskilled)
                        VADDHHS(R%%, S%) = LABWAGES(R%%, S%, Skilled) * LABEMPS(R%%, S%, Skilled)

                        '  Debug.Print RegName(R%%); ","; IY%; ","; S%; ","; LABEMPS(R%%, S%, Skilled); ","; LABEMPS(R%%, S%, Unskilled); ","; LABWAGES(R%%, S%, Skilled); ","; LABWAGES(R%%, S%, Unskilled)

                        VAddCalc = VADDHHU(R%%, S%) + VADDHHS(R%%, S%)
                        VADDHHU(R%%, S%) = VADDHHU(R%%, S%) * VADD(R%%, S%) / AMAX(0.001, VAddCalc)    ' (1 - alphas(R%%, S%))
                        VADDHHS(R%%, S%) = VADDHHS(R%%, S%) * VADD(R%%, S%) / AMAX(0.001, VAddCalc)


                        '                    VADDHHU(R%%, S%) = VADDHHU(R%%, S%) * VADD(R%%, S%) * (1 - alphas(R%%, S%)) / AMAX(0.001, VAddCalc)  ' (1 - alphas(R%%, S%))
                        '                    VADDHHS(R%%, S%) = VADDHHS(R%%, S%) * VADD(R%%, S%) * (1 - alphas(R%%, S%)) / AMAX(0.001, VAddCalc)


                        VADDHHUTot = VADDHHUTot + VADDHHU(R%%, S%)
                        VADDHHSTot = VADDHHSTot + VADDHHS(R%%, S%)


                    Next S%

                    LABWAGE(R%%, Unskilled) = VADDHHUTot / LABUnSkTot
                    LABWAGE(R%%, Skilled) = VADDHHSTot / LABSkTot

                    If LABWAGE(R%%, Skilled) / LABWAGE(R%%, Unskilled) > 1.2 Then
                        Exit Do
                    Else
                        For S% = 1 To NSec%
                            LABWAGES(R%%, S%, Skilled) = CSng(LABWAGES(R%%, S%, Skilled) * 1.05)
                        Next
                        i2 = i2 + 1
                    End If

                Loop

                For S% = 1 To NSec%
                    sLabWageS(R%%, S%, Unskilled) = LABWAGES(R%%, S%, Unskilled)
                    sLabWageS(R%%, S%, Skilled) = LABWAGES(R%%, S%, Skilled)
                Next S%


            Else  'IY%>1

                For S% = 1 To NSec%
                    LABWAGES(R%%, S%, Skilled) = sLabWageS(R%%, S%, Skilled)
                    LABWAGES(R%%, S%, Unskilled) = sLabWageS(R%%, S%, Unskilled)
                Next S%

                'HHINC(R%%, Unskilled) = 0
                'HHINC(R%%, Skilled) = 0
                HHINCEARN(R%%, Unskilled) = 0 'bbh 2021/05/15 replacing 2 HHINC lines wih HHINCEARN
                HHINCEARN(R%%, Skilled) = 0

                For S% = 1 To NSec%
                    VADDHHU(R%%, S%) = LABWAGES(R%%, S%, Unskilled) * LABEMPS(R%%, S%, Unskilled)
                    VADDHHS(R%%, S%) = LABWAGES(R%%, S%, Skilled) * LABEMPS(R%%, S%, Skilled)

                    '----- Common ---
                    VAddCalc = VADDHHU(R%%, S%) + VADDHHS(R%%, S%)
                    'bbh 2020/08/05 Start At some point review all RPA variable use, not clear when important and has been inconsistent
                    '   but know it is mostly for big oil producers
                    'bbh 2020/08/20 start
                    'If CAPUT(R%%, S%) > caputtar And gdprext(R%%) < -70 Then
                    If gdprext(R%%) > -70 Then 'bbh 2021/08/04 'Growth is exogenous
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / ((CAPUT(R%%, S%) / caputtar) ^ 0.5))
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / ((CAPUT(R%%, S%) / caputtar) ^ 0.5))
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VaddPreCaput(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VaddPreCaput(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        'bbh 2021/09/09 Begin: removed CAPUT adjustment; was keeping;; was keeping VADD drop in 2020 from affecting HHINCEARN, HHINCDIS, and C
                        '                    VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        '                    VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        'bbh 2021/09/09 end
                        'bbh 2021/07/07 Not clear why we need the use of CAPUT here on this branch; useful to review and perhaps remove
                    Else
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VaddPreCaput(R%%, S%)
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VaddPreCaput(R%%, S%)

                        'bbh 2021/08/04 added caput adjustment here also; If Else not really needed; CAPUT should always affect household VADD, but not total VADD
                        'bbh 2021/09/09 start: removed CAPUT adjustment once again
                        VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        '                    VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        '                    VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        'bbh 2021/09/09 end
                    End If
                    'bbh 2020/08/20 end
                    '                VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADDRPA(R%%, S%)
                    '                VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADDRPA(R%%, S%)
                    'bbh 2020/08/05 end
                Next S%


                For S% = 1 To NSec%  'kept constant for now
                    sLabWageS(R%%, S%, Unskilled) = LABWAGES(R%%, S%, Unskilled)
                    sLabWageS(R%%, S%, Skilled) = LABWAGES(R%%, S%, Skilled)
                Next S%

            End If
            'bbh 2021/05/15 start replacing HHINC with HHINCEARN and FIRMINC with FIRMEARN
            HHINCEARN(R%%, Unskilled) = 0
            HHINCEARN(R%%, Skilled) = 0
            FIRMEARN(R%%) = 0
            For S% = 1 To NSec%
                VADDHHU(R%%, S%) = VADDHHU(R%%, S%) * (1 - CDALF(R%%))
