                        cmd2.ExecuteNonQuery()
                    End Using
                    db.Database.AutoTransactionsEnabled = False
                    db.ChangeTracker.AutoDetectChangesEnabled = False
                    db.ChangeTracker.LazyLoadingEnabled = False

