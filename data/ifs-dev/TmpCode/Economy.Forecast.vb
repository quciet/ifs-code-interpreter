            'All But First: Compute population by poverty age-sex grouping
            '------------------------------------------------------------
            'Aggagedstflex agStart, agEnd, POPPOVAG 'agedstpov


            'All But First: Compue poverty rates by age group for both sexes combined
            '--------------------------------------------------------------------------
            For R% = 1 To NR%

                If INCOMELT550LN(R%) = 0 Then 'no poverty
                    POVRATE55(R%, RefAGTot, Total) = 0
                Else
                    'poverty rate,  both sexes = national poverty rate, when reference AG is All Ages
                    POVRATE55(R%, RefAGTot, Total) = 100 * INCOMELT550LN(R%) / POP(R%)
                End If

                'mti 2021/12/28 start
                If povagesexagratnat <> 0 Then

                    For j% = 1 To TotPovAGCount
                        'Poverty (Age group - multiple of all ages)
                        PovRateRatioToRefAG_Cur = iPovRateRatioToRefAG55(R%, j%) * povagesexagratnat
                        POVRATE55(R%, j%, Total) = AMAX(0, Amin(100, POVRATE55(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                    Next

                Else
                    'mti 2021/12/28 End
                    'income target covered up so far (will be equated to poverty target covered up so far)
                    IncomeTrgt = 37.5  'computation by Yutang/Dave from avg of all HIC countries with 2000 to 2015 data

                    If iGDPPCP(R%) >= IncomeTrgt Then
                        'at year 1 country already at target income; poverty ratio to ref group merges to target value temporally
                        For j% = 1 To TotPovAGCount
                            'temporal (20 yr) convergence of initial ratio to target ratio
                            PovRateRatioToRefAG_Cur = ConvergeOverTime(iPovRateRatioToRefAG55(R%, j%), CSng(PovRateRatioToRefAG_Trgt(j%)), 20) 'AMAX(0, (can be in both direction)
                            'POVRATE55(R%, j%, Total) = POVRATE55(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur
                            POVRATE55(R%, j%, Total) = AMAX(0, Amin(100, POVRATE55(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                        Next

                        'once converged even if an extreme prolonged recession brings GDPPCP(R%) below target; AG pov ratio to ref won't move;

                    Else
                        If sGDPPCP(R%) >= IncomeTrgt Then  'sGDPPCP(R%) saved in more than 1 place populat, AG, Infra (?) save in economy after external
                            IncTrgtCovd = 1
                        Else  'negatives will also be handled below
                            IncTrgtCovd = (sGDPPCP(R%) - iGDPPCP(R%)) / (IncomeTrgt - iGDPPCP(R%))

                            If sGDPPCP(R%) < iGDPPCP(R%) Then  'declining income; increasing national poverty

                                For j% = 1 To TotPovAGCount - 1
                                    If PovRateRatioToRefAG_Trgt(j%) < iPovRateRatioToRefAG55(R%, j%) Then  'Venzuela: 60+: 1.4 initial; .52 target
                                        IncTrgtCovd = 0 'initial AG/refAG Pov ratio higher than target;
                                    End If
                                Next
                            End If

                        End If


                        For j% = 1 To TotPovAGCount

                            'Poverty (AG multiple of all ages) target covered up so far  = IncTrgtCovd
                            PovRateRatioToRefAG_Cur = CSng(iPovRateRatioToRefAG55(R%, j%) + IncTrgtCovd * (PovRateRatioToRefAG_Trgt(j%) - iPovRateRatioToRefAG55(R%, j%)))  'AMAX(0, (can be in both direction)

