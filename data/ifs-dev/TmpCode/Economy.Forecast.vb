' ---- Begin Inlined Level 1: ForAid
' Private Sub ForAid(NR%)
            '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
            '   Last Changed by BBH: 2005
            'mti 2016/11/02 - Take full procedure

            'mti 2016/11/02 Start
            Dim calaidrec As Single
            'jrs 2014/09/15
            Dim AIDP As Single, AIDR As Single, R As Integer, AIDTot As Single

            If IY = 1 Then
                ReDim AidRecPcntShift(NR%%), AidRecPcnt(NR%%)
                'mti 2016/11/02 End

                '   FOREIGN AID CALCULATION
                '   -----------------------

                'mti 2016/11/02 Start
                For R% = 1 To NR%%
                    calaidrec = CSng(5.3753 * Math.Log(aidgradpoint) - 5.3753 * Math.Log(GDPPCP(R%)))
                    AidRecPcntShift(R%) = AIDREC(R%) - AMAX(0, calaidrec)
                    AidRecPcnt(R%) = AIDREC(R%)
                Next


            Else
                For R% = 1 To NR%%
                    'path obtained from a regression of aidrec% with GDPPCP with graduation at 14k (regression saved in TablFunc)
                    'Intercept = 5.3753 * Log(aidgradpoint)
                    calaidrec = CSng(5.3753 * Math.Log(aidgradpoint) - 5.3753 * Math.Log(GDPPCP(R%)))
                    'bbh 2020/05/07 start
                    'The line below was causing major transients in aid receipts after 2015+75 is 2090, even as approached after 2085
                    'Problem likely related to magnitude of AidRecPcntShift from year 1, but code there not transparent so not clear how to fix
                    'My extension to 100 years will leave a problem for runs of that length, probably even 95 years
                    'AidRecPcnt(R%) = Amin(90, (AMAX(0, AMAX(0, calaidrec) + ConvergeOverTime(AidRecPcntShift(R%), 0, 75))) * aidrecm(R%))
                    'AidRecPcnt(R%) = Amin(90, (AMAX(0, AMAX(0, calaidrec) + ConvergeOverTime(AidRecPcntShift(R%), 0, 100))) * aidrecm(R%))
                    'bbh 2024/06/28 Moved convergence time to 140 so as to push out beyond year in which all countries are in base case reaching aidgradpoint
                    AidRecPcnt(R%) = Amin(90, (AMAX(0, AMAX(0, calaidrec) + ConvergeOverTime(AidRecPcntShift(R%), 0, 140))) * aidrecm(R%))
                    'jrs 2025/03/11
                    AidRecPcnt(R%) = Amin(90, AMAX(0, AidRecPcnt(R%) + aidrecadd(R%)))
                    'bbh 2020/05/07 end
                Next

            End If
            'mti 2016/11/02 End

            AIDP = 0!
            AIDR = 0!

            '   Determine Size of Aid Pool and Aid Demands
            '   ------------------------------------------
            '
            'bbh 2022/04/19 start: Introduce gross aid receipts as step toward net (AID)
            For R% = 1 To NR%%


                AIDRECEIPT(R%) = AidRecPcnt(R%) / 100 * GDP(R%)
                AIDDONATE(R%) = aiddon(R%) / 100 * GDP(R%)

                AIDR = AIDR + AIDRECEIPT(R%)
                AIDP = AIDP + AIDDONATE(R%)

                '        'mti 2016/11/02 Start
                '        'AID(R%) = (aidrec(R%) - aiddon(R%)) / 100 * GDP(R%)
                '        AID(R%) = (AidRecPcnt(R%) - aiddon(R%)) / 100 * GDP(R%)
                '        'mti 2016/11/02 End
                '
                '        If (AID(R%) > 0) Then    'Net Aid recipient
                '            AIDR = AIDR + AID(R%)
                '        Else                     'Aid donor (AID is negative)
                '            AIDP = AIDP + AID(R%)
                '        End If

            Next R%

            '   Impose Aid Pool on Recipients and Donors
            '   ----------------------------------------
            If AIDR < 0.01 Then
                AIDR = 0.01
            End If
            If AIDP < 0.01 Then
                AIDP = 0.01
            End If
            'bbh 2024/06/28 Start switch from control by donor pool to control by recipient demand
            'As recipient need/demand disappears, donor pool should phase down to lower and then zero values
            'But when we determine donor pool changes only by receipt demand, we lose some scenario control over donor-specific aid, which
            '   was being done by changing the aiddon parameter.  We can, however, gain somewhat more control over country-specific receipts via
            '   the use of aidrecm.  We could consider sharing control from donor and recipient sides by averaging AIDR and AIDP, but
            '   problem with that is that as only 1-3 countries are below aidgradpoint over time, the amount of aid forced on them from
            '   the donor side becomes ridicously high, the same problem that motivates movement from donor pool to recipient pool control.
            '   And recipient control with aidrecm is problematic becuase it is a multiplier on AidRecPcnt that is phased out over time; would
            '   probably be better for scenarios to have an additive % of GDP multiplier on recipient side.  Could also have an additive % of GDP
            '   on the donor side and protect that in the logic below by adding it the normalized donations and renormalizing receipts.
            '   Bottom line: donor and recipient control (particularly donor) have inherent problems; but if had% of GDP additive parameters for
            '   both, could redo logic below to protect those.  That might also enhance bilateral treatment.
            AIDTot = AIDR
            'AIDTot = AIDP
            For R% = 1 To NR%%
                'If (AIDRECEIPT(R%) > 0) Then
                '    AIDRECEIPT(R%) = AIDRECEIPT(R%) * AIDTot / AIDR
                'End If
                If (AIDDONATE(R%) > 0) Then
                    AIDDONATE(R%) = AIDDONATE(R%) * AIDTot / AIDP
                End If
                'bbh 2024/06/28 End switch from control by donor pool to control by recipient demand
                AID(R%) = AIDRECEIPT(R%) - AIDDONATE(R%) 'Net aid as used extensively aross model
            Next R%

            '    If AIDR < 0.01 Then AIDR = 0.01
            '    If AIDP > -0.01 Then AIDP = -0.01
            '    AIDTot = -AIDP
            '    For R% = 1 To NR%%
            '        If (AID(R%) > 0) Then    'Net Aid Recipient
            '            AID(R%) = AID(R%) * AIDTot / AIDR
            '        End If
            '    Next R%
            'bbh 2022/04/19 end: Introduce gross aid receipts as step toward net (AID)


            '***START*** clp 2023/12/20 create new process for adding dyadic aid flows that also increases monadic; Calls in ifsEcoDyadic1AllButFirst
            'and ifsEcoDyadic1FirstYear; dyadaidexoadd also added to ForAid at end
            If bilateralsw > 0 Then
                For R% = 1 To NR%%
                    For P = 1 To NR%%
                        AIDDONATE(R%) = AIDDONATE(R%) + dyadaidexoadd(R%, P)
                        AIDRECEIPT(R%) = AIDRECEIPT(R%) + dyadaidexoadd(P, R%)
                    Next P
                    AID(R%) = AIDRECEIPT(R%) - AIDDONATE(R%) 'Net aid as used extensively aross model
                Next R%
            End If
            '***END*** clp 2023/12/20 create new process for adding dyadic aid flows that also increases monadic; Calls in ifsEcoDyadic1AllButFirst
            'and ifsEcoDyadic1FirstYear; dyadaidexoadd also added to ForAid at end

' End Sub
' ---- End Inlined Level 1: ForAid

            'If IY% = 2 Then
            '    Open PutFdrv$ + "Runfiles\" + "Debug.dat" For Output As #6
