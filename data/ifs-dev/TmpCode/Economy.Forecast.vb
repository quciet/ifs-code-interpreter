                            Mul = CSng(Mul ^ 0.5) 'bbh 2022/12/20  ICT is so concentrated in a few countries that need to avoid big trade changes
                        End If
                        '                MulSwing = AMAX(0.1, 1 - sxkav(R%, S%) * 3)
                        '                Mul = AMAX(1 - MulSwing, Amin(1 + MulSwing, Mul))

