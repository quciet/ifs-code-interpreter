                SGDP(R%) = GDP(R%) 'bbh 2022/06/23 moved to after use here rather than at end of IFsEco; does not seem to be used before here; e.g., dyadic use is later
                HHINCDISPERM(R%, Total) = HHINCDISPERM(R%, Unskilled) + HHINCDISPERM(R%, Skilled) 'bbh 2022/06/23
                SHHINCDISPERM(R%, Unskilled) = HHINCDISPERM(R%, Unskilled)
                SHHINCDISPERM(R%, Skilled) = HHINCDISPERM(R%, Skilled)
