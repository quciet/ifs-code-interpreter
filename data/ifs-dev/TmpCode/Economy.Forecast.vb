                '         Y2Conv = 2040 - BaseYear
                '         ICTINDEXExp = ConvergeOverTime(ICTINDEXExp, ICTIndexExp2, Y2Conv)

                ICTINDEXExp = CSng(Intrcpt + BCoeFF * Math.Log(GDPPCP(R%)))
                'mti 2015/05/13 -end

                'bbh 2015/06/07 start
                ICTINDEXExp = AMAX(0.3, ICTINDEXExp)

                ' BBH tried hard to match ICTCYBENEFIT and ICTCONSURPLUS to historical data with ICTINDEX breakpoint code
                '   Focused on avoiding transients for WB income categories and world
                '   Problems included skimpy historical data esp lower income countries and some jumps across ICTIndex
                '      categories that messed up ictindexm scenarios - index rise could push into new category and create
                '      perverse effects such as higher index lowered GDPGR contribution for lower middle income countries
                '   So shifted to more generic formulations immediately below; historical fit is not quite as good
                '      But fit is messy and often simple average very differnet than GDP-weighted ones
                CybGrBenShr = CSng(0.3 - 0.15 * Amin(1, (GDPPCP(R%) / 40)))
                CybConSurShr = CSng(0.1 - 0.05 * Amin(1, (GDPPCP(R%) / 40)))
                ICTCYBBENEFIT(R%) = CybGrBenShr * sgdpr1(R%) * ictcybbenefitm(R%)
                ICTCYBBENEFIT(R%) = ICTCYBBENEFIT(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)
                ICTCONSURPLUS(R%) = CybConSurShr * sgdpr1(R%) * ictconsurplusm(R%)
                ICTCONSURPLUS(R%) = ICTCONSURPLUS(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)

                '         If ICTINDEX(R%) < 1 Then 'low-income countries ictindex average=1.4 ; set at .3 * moving average GDPR
                '            ICTCYBBENEFIT(R%) = 0.3 * sgdpr1(R%) * ictcybbenefitm(R%)
                '
