    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSexFirstYear:PovertyAdjGenderRatio
' Private Sub PovertyAdjGenderRatio(R%, PovRateVec(,,) As Single, AGCount As Integer)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - new procedure
                '(R%%, POVRATE(), PovCountVec(), povnational_hc As Single)
                Dim AdjPovDiff As Single
                Dim j%
    
                'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                For j% = 1 To TotPovAGCount
                    If POVRATE(R%%, j, Female) - POVRATE(R%%, j, Male) > 1.5 * POVRATE(R%%, j, Total) Then
                        AdjPovDiff = CSng((POVRATE(R%%, j, Female) - POVRATE(R%%, j, Male)) - 1.5 * POVRATE(R%%, j, Total))
                        POVRATE(R%%, j, Female) = POVRATE(R%%, j, Female) - AdjPovDiff / 2
                        POVRATE(R%%, j, Male) = POVRATE(R%%, j, Male) + AdjPovDiff / 2
                    ElseIf POVRATE(R%%, j, Female) - POVRATE(R%%, j, Male) < -1.5 * POVRATE(R%%, j, Total) Then   '1.5
                        AdjPovDiff = CSng((POVRATE(R%%, j, Female) - POVRATE(R%%, j, Male)) + 1.5 * POVRATE(R%%, j, Total))
                        POVRATE(R%%, j, Female) = POVRATE(R%%, j, Female) + AdjPovDiff / 2
                        POVRATE(R%%, j, Male) = POVRATE(R%%, j, Male) - AdjPovDiff / 2
                    End If
    
                    '           'make sure there is at least some poverty in each gender
                    POVRATE(R%%, j%, Male) = AMAX(POVRATE(R%%, j%, Female) * 0.2, POVRATE(R%%, j%, Male))
                    POVRATE(R%%, j%, Female) = AMAX(POVRATE(R%%, j%, Male) * 0.2, POVRATE(R%%, j%, Female))
    
                Next j%
    
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSexFirstYear:PovertyAdjGenderRatio
                'Normalize poverty across sexes within the same age group
                'mti 2021/12/28 start
PovertyNormalizeGender(R%, POVRATE, POVCOUNT, POVGNDRATIO)
    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSexFirstYear:PovertyNormalizeGender
' Private Sub PovertyNormalizeGender(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, PovGndRatioVec(,) As Single, Optional StartAG% = 1, Optional EndAG% = TotPovAGCount)
    
                'mti 2021/12/28 Take entire procedure
                'mti 2021/01/29 Take entire procedure R%%, POVRATE(), POVCOUNT(), povnational_hc As Single
    
                'mti 2020/03/18 Whole procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
    
                Dim j As Integer, NormFac As Single
    
                For j% = StartAG% To EndAG% '1 To TotPovAGCount
                    'Debug.Print j%
                    If POVCOUNT(R%%, j%, Total) = 0 Or (POVRATE(R%%, j%, Male) = 0 And POVRATE(R%%, j%, Female) = 0) Then
                        POVCOUNT(R%%, j%, Male) = 0
                        POVCOUNT(R%%, j%, Female) = 0
                        POVRATE(R%%, j%, Male) = 0
                        POVRATE(R%%, j%, Female) = 0
                        PovGndRatioVec(R%%, j%) = 1
    
                    Else
                        'Get headcounts by gender using rates and population by gender
                        POVCOUNT(R%%, j%, Female) = POVRATE(R%%, j%, Female) * POPPOVAG(R%%, j%, Female) / 100
                        POVCOUNT(R%%, j%, Male) = POVRATE(R%%, j%, Male) * POPPOVAG(R%%, j%, Male) / 100
    
                        'Compute normalization factor
                        'mti 2020/03/18 start
                        'NormFac = POVCOUNT(R%%, j%, Total) / AMAX(0.0001, (POVCOUNT(R%%, j%, Male) + POVCOUNT(R%%, j%, Female)))
                        NormFac = POVCOUNT(R%%, j%, Total) / AMAX(0.000001, (POVCOUNT(R%%, j%, Male) + POVCOUNT(R%%, j%, Female)))
    
    
                        'Normalize headcounts
                        'mti 2021/07/15 start
                        POVCOUNT(R%%, j%, Female) = CSng(Amin(POPPOVAG(R%%, j%, Female), Round(POVCOUNT(R%%, j%, Female) * NormFac, 6)))
                        POVCOUNT(R%%, j%, Male) = CSng(Amin(POPPOVAG(R%%, j%, Male), AMAX(0, Round(POVCOUNT(R%%, j%, Total) - POVCOUNT(R%%, j%, Female), 6))))
    
                        'Just in case male had to be bounded at 100; give all of the remainder to female
                        POVCOUNT(R%%, j%, Female) = CSng(AMAX(0, Round(POVCOUNT(R%%, j%, Total) - POVCOUNT(R%%, j%, Male), 6)))
                        'mti 2021/07/15 end
    
                        '            POVCOUNT(R%%, j%, Male) = Round(POVCOUNT(R%%, j%, Male) * NormFac, 6)
                        '            POVCOUNT(R%%, j%, Female) = AMAX(0, Round(POVCOUNT(R%%, j%, Total) - POVCOUNT(R%%, j%, Male), 6))
    
    
    
                        'recompute (normalized) rates by gender
                        POVRATE(R%%, j%, Female) = 100 * POVCOUNT(R%%, j%, Female) / AMAX(0.000001, POPPOVAG(R%%, j%, Female))
                        POVRATE(R%%, j%, Male) = 100 * POVCOUNT(R%%, j%, Male) / AMAX(0.000001, POPPOVAG(R%%, j%, Male))
    
                        'Compute gender ratio
                        '            If POVRATE(R%%, j%, Female) = 0 Or POVRATE(R%%, j%, Male) = 0 Then
                        '                PovGndRatioVec(R%%, j%) = 1
                        '            Else
    
                        'PovGndRatioVec(R%%, j%) = POVRATE(R%%, j%, Female) / POVRATE(R%%, j%, Male)  '0.001
                        'less than half a percent poverty in either group consisdered as equal poverty
                        PovGndRatioVec(R%%, j%) = AMAX(0.005, POVRATE(R%%, j%, Female)) / AMAX(0.005, POVRATE(R%%, j%, Male)) '0.001
                        '                If PovGndRatioVec(R%%, j%) > 15 Then Stop
    
                        '            End If
                        'mti 2020/03/18 End
                    End If
                Next j%
    
    
                'mti 2020/03/25 Start
                If POVCOUNT(R%%, TotPovAGCount, Total) = 0 Then
                    POVCOUNT(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT(R%%, TotPovAGCount, Female) = 0
                    POVRATE(R%%, TotPovAGCount, Male) = 0
                    POVRATE(R%%, TotPovAGCount, Female) = 0
                    PovGndRatioVec(R%%, TotPovAGCount) = 1
                Else
                    'If RegName(R%%) = "India" Then Stop
                    POVCOUNT(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT(R%%, TotPovAGCount, Female) = 0
                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNT(R%%, TotPovAGCount, Male) = POVCOUNT(R%%, TotPovAGCount, Male) + POVCOUNT(R%%, j%, Male)
                        POVCOUNT(R%%, TotPovAGCount, Female) = POVCOUNT(R%%, TotPovAGCount, Female) + POVCOUNT(R%%, j%, Female)
                    Next j%
    
    
    
                    POVRATE(R%%, TotPovAGCount, Male) = 100 * POVCOUNT(R%%, TotPovAGCount, Male) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Male))
                    POVRATE(R%%, TotPovAGCount, Female) = 100 * POVCOUNT(R%%, TotPovAGCount, Female) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Female))
                    PovGndRatioVec(R%%, TotPovAGCount) = AMAX(0.005, POVRATE(R%%, TotPovAGCount, Female)) / AMAX(0.005, POVRATE(R%%, TotPovAGCount, Male)) '0.001
                End If
                'mti 2020/03/25 End
    
                'mti 2021/12/28 start
                '15 plus and 25 plus computation taken to new procedure
                'mti 2021/12/28 End
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSexFirstYear:PovertyNormalizeGender
