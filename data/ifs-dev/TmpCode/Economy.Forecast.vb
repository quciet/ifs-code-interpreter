                        'If RegName$(R%) = "India" And S% = 5 And IY% >= 20 Then Stop

                        'SXKAV(R%, S%) * elasxinc(R%) * (ZS(R%, S%) - SZS(R%, S%)))
                        'jrs 2016/12/21
                        If 4 = 4 Then
                            szs(R%, S%) = zsp(R%, S%)
