                '        HHSAVNEEDSTOCK(R%) = HHSAVUSE(R%) / (AMAX(0.01, savingsdiscountrt(R%) / 100))
                ' 'If RegName$(R%) = "United States of America" Then Stop
                '
                '        'First Year: Set accumulated savings to accumulated needs in absence of any other info about it
                '        '-----------------------------------------------------------------------------------------------
                '        HHSAVSTOCK(R%) = hhsaveneedrat(R%) * HHSAVNEEDSTOCK(R%)
                '        SHHSAVSTOCK(R%) = HHSAVSTOCK(R%)
                '
                '        'First Year: Compute surplus or deficit of savings for retirement
                '        '----------------------------------------------------------------
                '        HHSAVSURSTOCK(R%) = HHSAVSTOCK(R%) - HHSAVNEEDSTOCK(R%)
                '        'jrs 2013/06/11 *** end ***

                '   First Year:  Poverty Gap
                '   -------------------------------------------
                'jrs 2016/01/14 not needed anymore since LNMean is based on 1.9 from above
                '        'jrs 2016/01/04 *** begin ***
                '        'LNMean is being recomputed for the $2011 numbers now, but this is still using $2005
                '        portionpoor = Amin(0.99, INCOMELT125CS2005(R%) / AMAX(0.0001, POP(R%)))
                '        NInv = CalcNormalInverse(portionpoor)
                '        LNMean = Log(456.25) - lnstddev * NInv
                '         If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                '            meanbackcalc = Exp(709)
                '        Else
                '            meanbackcalc = Exp(LNMean + 0.5 * (lnstddev ^ 2))
                '        End If
                '        'jrs 2016/01/04 *** end ***

                'mti Spt 04, 2009
                'jrs 2010/08/13 IncFrac = CalcLogNormalCDF(365, LNMean + lnstddev ^ 2, lnstddev)
                IncFrac = If(CalcLogNormalCDF(365 * 1.9, CSng(LNMean + lnstddev ^ 2), lnstddev), 0) 'jrs 2016/01/14 used to be 365 * 1.25
                'IncFrac = LogNormalCDF(365, LNMean + lnstddev ^ 2, lnstddev)
                'mti Spt 04, 2009

                'LNMean and LNSD are lognormal mean and standard deviation calculated before
                'LogNormalCDF is the function in the StatSupport.bas
                'jrs 2016/01/14
                'PopFrac = Amin(0.99, INCOMELT125CS2005(R%) / AMAX(0.0001, POP(R%)))
                PopFrac = CSng(Amin(0.99, INCOMELT190LN(R%) / AMAX(0.0001, POP(R%))))
                'PopFrac = Percentage of people below Poverty Line
                'i.e., HeadCount Index; IncBelow1Dollar% (between 0 and 1) in this case
                'In first year, LN=CS Incomelt1
                'MeanInc = Mean of Annual Income or Consumption in PPP$ PovLineInc = 365
                'Poverty Line Annual Income; $365 PPP in this case
                'jrs 2010/08/13 POVGAP(R%) = AMAX(0, PopFrac - (meanbackcalc / 365) * IncFrac) * 100
                'changing poverty line to 1.25 dollars a day

                'mti 2015/03/25 - start
                'jrs 2022/11/22
                If ConstantDollarsYear = 2011 Then
                    calcPovGap = CSng(AMAX(0, PopFrac - (meanbackcalc / (365 * 1.9)) * IncFrac) * 100)
                    PovGapShift(R%) = POVGAP(R%) - calcPovGap
                    'Else
                    'jrs 2023/02/15    CalcPovGap = AMAX(0, PopFrac - (meanbackcalc / (365 * 2.15)) * IncFrac) * 100
                End If

                'If GRPS(1, R%) = "Sudan South" Then Stop
                'Keeping the commented out codes from JRS/BBH
                'POVGAP(R%) = AMAX(0, PopFrac - (meanbackcalc / 456.25) * IncFrac) * 100
                'Poverty Gap According to Analytical Formula
                'PG = PopFrac - (MeanInc / PovLineInc) * IncFrac

                'jrs 2022/11/18 *** start ***
                '       First Year:  Back-calculate Mean of Consumption for Log Normal $2.15 ($2017)
                '       --------------------------------------------------------------------------
                'jrs 2023/01/30 moved down to avoid transient in pov gap
                portionpoor = CSng(Amin(0.99, INCOMELT215LN(R%) / AMAX(0.0001, POP(R%))))
                portionpoor = CSng(Round(portionpoor, 12)) 'jrs 2020/03/14 diffs with .NET
                NInv = CalcNormalInverse(portionpoor)
                NInv = CSng(Round(NInv, 6)) 'jrs 2020/03/10 differences with .NET

                'mti 2021/10/15 start
                NInv = AMAX(-3, NInv)
                'mti 2021/10/15 End

                'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))

                LNMean = CSng(Log(365 * 2.15) - lnstddev * NInv)
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = CSng(Exp(709))
                Else
                    meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                End If
                'In dollars, not thoUSAnds
                meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                NSNARAT215(R%) = CSng(Round((meanbackcalc / 1000) / AMAX(0.0001, meanconsumption), 6)) 'jrs 2020/03/10 added round to match vb6.
                bNoPoor215 = (portionpoor = 0)
                'jrs 2022/11/18 *** end ****

                'jrs 2023/02/15
                If ConstantDollarsYear = 2017 Then
                    calcPovGap = CSng(AMAX(0, PopFrac - (meanbackcalc / (365 * 2.15)) * IncFrac) * 100)
                    PovGapShift(R%) = POVGAP(R%) - calcPovGap
                End If


                'jrs 2025/09/12 *** start ***
                '       First Year:  Back-calculate Mean of Consumption for Log Normal $3.00 ($2021)
                '       --------------------------------------------------------------------------
                'jrs 2023/01/30 moved down to avoid transient in pov gap
                portionpoor = CSng(Amin(0.99, POVEXTREME(R%) / AMAX(0.0001, POP(R%))))
                portionpoor = CSng(Round(portionpoor, 12)) 'jrs 2020/03/14 diffs with .NET
                NInv = CalcNormalInverse(portionpoor)
                NInv = CSng(Round(NInv, 6)) 'jrs 2020/03/10 differences with .NET

                'mti 2021/10/15 start
                NInv = AMAX(-3, NInv)
                'mti 2021/10/15 End

                'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))

                LNMean = CSng(Log(365 * 3) - lnstddev * NInv)
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = CSng(Exp(709))
                Else
                    meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                End If
                'In dollars, not thoUSAnds
                meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                NSNARAT300(R%) = CSng(Round((meanbackcalc / 1000) / AMAX(0.0001, meanconsumption), 6)) 'jrs 2020/03/10 added round to match vb6.
                bNoPoor300 = (portionpoor = 0)
                'jrs 2025/09/12 *** end ****

                'jrs 2025/09/12
                If ConstantDollarsYear = 2021 Then
                    calcPovGap = CSng(AMAX(0, PopFrac - (meanbackcalc / (365 * 3)) * IncFrac) * 100)
                    PovGapShift(R%) = POVGAP(R%) - calcPovGap
                End If

                'mti 2015/03/25 - end
                '   First Year:  Back-calculate Mean of Consumption for Log Normal $2
                '   -----------------------------------------------------------------

                portionpoor = CSng(Amin(0.99, INCOMELT200CS2005(R%) / AMAX(0.0001, POP(R%))))
                'jrs 2008/07/17
                '        If portionpoor < 0.001 Then
                '            NSNARAT2(R%) = -1 'jrs 2008/07/17
                '        Else

                'mti Sept 04, 2009 -start
                NInv = CalcNormalInverse(portionpoor)
                'NInv = NormalInverse(portionpoor)

                'mti 2021/10/15 start
                NInv = AMAX(-3, NInv)
                'mti 2021/10/15 End

                'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))
                'lnstddev = Sqr(2) * NormalInverse((GINIDOM(R%) + 1) / 2)

                'mti Sept 04, 2009 - end
                LNMean = CSng(Log(730) - lnstddev * NInv)
                'jrs 2008/07/17
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = CSng(Exp(709))
                Else
                    meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                End If
                'In dollars, not thousands
                meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                NSNARAT2(R%) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
                'jrs 2008/07/17 End If
                NSNARATI2(R%) = NSNARAT2(R%)
                'jrs 2008/07/18
                'check that ratio NSNARAT to NSNARAT2 is not too big
                If bNoPoor1 AndAlso portionpoor > 0 Then
                    'recompute NSNARAT in order to make it possible to estimate between $1 and $2/day

                    'mti Sept 04, 2009 - start
                    'mti 2020/03/13 NInv = CalcNormalInverse(0.001)
                    NInv = CalcNormalInverse(portionpoor / 10)
                    'NInv = NormalInverse(0.001)

                    'mti 2021/10/15 start
                    NInv = AMAX(-3, NInv)
                    'mti 2021/10/15 End

                    'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                    lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))
                    'lnstddev = Sqr(2) * NormalInverse((GINIDOM(R%) + 1) / 2)
                    'mti Sept 04, 2009 -end

                    'jrs 2010/08/13 LNMean = Log(365) - lnstddev * NInv
                    LNMean = CSng(Log(456.25) - lnstddev * NInv)
                    If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                        meanbackcalc = CSng(Exp(709))
                    Else
                        meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                    End If
                    'In dollars, not thousands
                    meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                    NSNARAT(R%) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
                    'this will produce smaller shifts, all of them at most 0.001
                    NSNARATI1(R%) = NSNARAT(R%)
                End If

                'jrs 2008/07/16
                If context.HistoricMode = False Then
                    If NSNARAT2(R%) / NSNARAT(R%) > 1.8 AndAlso portionpoor > 0 AndAlso context.DevelopmentMode Then
                        Debug.Print(GRPS(1, R%) & ", NSNARAT2= " & NSNARAT2(R%) & ", NSNARAT= " & NSNARAT(R%) &
                        vbCr & "Warning: This can produce problems in poverty calculations.")
                        'vbInformation, "Economic SAM Module"
                    End If
                End If

                'jrs 2015/11/18 *** begin ***
                '       First Year:  Back-calculate Mean of Consumption for Log Normal $3.1 ($2011)
                '       --------------------------------------------------------------------------
                portionpoor = CSng(Amin(0.99, INCOMELT310LN(R%) / AMAX(0.0001, POP(R%))))

                NInv = CalcNormalInverse(portionpoor)

                'mti 2021/10/15 start
                NInv = AMAX(-3, NInv)
                'mti 2021/10/15 End

                'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))

                LNMean = CSng(Log(365 * 3.1) - lnstddev * NInv)
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = CSng(Exp(709))
                Else
                    meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                End If
                'In dollars, not thousands
                meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                NSNARAT31(R%) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
                'check that ratio NSNARAT19 to NSNARAT31 is not too big
                If bNoPoor19 AndAlso portionpoor > 0 Then
                    'recompute NSNARAT19 in order to make it possible to estimate between $1 and $2/day
                    'mti 2020/03/13 NInv = CalcNormalInverse(0.001)
                    NInv = CalcNormalInverse(portionpoor / 10)

                    'mti 2021/10/15 start
                    NInv = AMAX(-3, NInv)
                    'mti 2021/10/15 End

                    'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                    lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))

                    LNMean = CSng(Log(365 * 1.9) - lnstddev * NInv)
                    If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                        meanbackcalc = CSng(Exp(709))
                    Else
                        meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                    End If
                    'In dollars, not thousands
                    meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                    NSNARAT19(R%) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
                End If

                If context.HistoricMode = False Then
                    If NSNARAT31(R%) / NSNARAT19(R%) > 1.8 AndAlso portionpoor > 0 AndAlso context.DevelopmentMode Then
                        Debug.Print(GRPS(1, R%) & ", NSNARAT31= " & NSNARAT31(R%) & ", NSNARAT19= " & NSNARAT19(R%) &
                vbCr & "Warning: This can produce problems in poverty calculations.")
                        'vbInformation, "Economic SAM Module"
                    End If
                End If
                'jrs 2015/11/18 *** end ***

                'mti 2021/01/29 Start NSNARAT32(R%)

                '       First Year:  Back-calculate Mean of Consumption for Log Normal $3.2 ($2011)
                '       --------------------------------------------------------------------------
                'mti 2021/06/30
PovRatInit(INCOMELT320LN(R%), POP(R%), GINIDOM(R%), C(R%), PPPCONV(R%), 3.2, POVGAP32(R%), PovGap32Shift(R%), NSNARAT32(R%), "NSNARAT32", 1.9, NSNARAT19(R%), "NSNARAT19", bNoPoor19, GRPS(1, R%), context)
' ---- Begin Inlined Level 1: PovRatInit
' Private Sub PovRatInit(PovHC As Single, PopHC As Single, GiniInd As Single, ConsumptionTot As Single, PPPConversion As Single, PovThreshold As Single, PovGapVal As Single, ByRef PovGapShiftVal As Single, ByRef NSNARatThreshold As Single, ThreshName$,
' PovThresholdComp As Single, ByRef NSNARatComp As Single, CompName$, NoPoorComp As Boolean, GRPSName$, context As IForecastContext, Optional ComputePovGap As Boolean = False)

            '-------------------------------------------------------------
            'mti 2021/06/30 Take Procedure
            Dim portionpoor As Single
            Dim CompMult As Single
            'gvdb 2024/04/05
            ' unused variable
            Dim NInv As Single, lnstddev As Single, LNMean As Single, meanbackcalc As Single, meanconsumption As Single, IncFrac As Single ' , PopFrac As Single
            Dim CalcPovGap As Single

            portionpoor = CSng(Amin(0.99, INCOMELT320LN(R%) / AMAX(0.0001, POP(R%))))

            'Inverse of (standard) normal
            NInv = CalcNormalInverse(portionpoor)

            'mti 2021/10/15 start
            NInv = AMAX(-3, NInv)
            'mti 2021/10/15 End

            'lognormal standard dev (note - should be same as the one for 1.90)
            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))

            LNMean = CSng(Log(365 * 3.2) - lnstddev * NInv)
            If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                meanbackcalc = CSng(Exp(709))
            Else
                meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
            End If


            'mti 2021/06/30 start
            IncFrac = CSng(CalcLogNormalCDF(365 * 3.2, CSng(LNMean + lnstddev ^ 2), lnstddev))
            CalcPovGap = AMAX(0, portionpoor - (meanbackcalc / (365 * 3.2)) * IncFrac) * 100
            'mti 2021/07/15 start
            If CalcPovGap > 0 Then
                POVGAP32(R%) = CalcPovGap
            End If
            PovGap32Shift(R%) = POVGAP32(R%) - CalcPovGap
            'mti 2021/07/15 End
            'mti 2021/06/30 end

            'In dollars, not thoUSAnds
            meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
            NSNARAT32(R%) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)




            'Debug.Print RegName(R%); ","; GDPPCP(R%); ","; NSNARAT19(R%); ","; NSNARatInit; ","; C(R%) / GDP(R%); ","; 100 * INCOMELT190LN(R%) / AMAX(0.0001, POP(R%)); ","; 100 * INCOMELT320LN(R%) / AMAX(0.0001, POP(R%))
            '
            'If RegName(R%) = "Bahrain" Then Stop
            'If RegName(R%) = "Germany" Then Stop


            'check that ratio NSNARAT19 to NSNARAT31 is not too big
            If bNoPoor19 And portionpoor > 0 Then
                'recompute NSNARAT19 in order to make it possible to estimate between $1 and $2/day
                NInv = CalcNormalInverse(0.001) 'mti 2020/03/13
                'NInv = CalcNormalInverse(portionpoor / 10)

                'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                lnstddev = CSng(Sqrt(2) * CalcNormalInverse((GINIDOM(R%) + 1) / 2))

                LNMean = CSng(Log(365 * 1.9) - lnstddev * NInv)
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = CSng(Exp(709))
                Else
                    meanbackcalc = CSng(Exp(LNMean + 0.5 * (lnstddev ^ 2)))
                End If
                'In dollars, not thoUSAnds
                meanconsumption = C(R%) / AMAX(0.0001, POP(R%)) * PPPCONV(R%)
                NSNARAT19(R%) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
            End If


            If Not context.HistoricMode Then
                'mti 2021/03/29 If "NSNARAT32"$ = "NSNARAT32" Then CompMult = 1.8
                If "NSNARAT32"$ = "NSNARAT32" Then
                    CompMult = 2.5
                End If
                If "NSNARAT32"$ = "NSNARAT365" Then
                    CompMult = 2.5
                End If
                'mti 2021/03/29 If "NSNARAT32"$ = "NSNARAT55" Then CompMult = 3
                If "NSNARAT32"$ = "NSNARAT55" Then
                    CompMult = 3.5
                End If
                If "NSNARAT32"$ = "NSNARAT55" Then
                    CompMult = 3.5
                End If

                'mti 2021/07/15 start
                If "NSNARAT32"$ = "NSNARATNPL" Then
                    CompMult = CSng(AMAX(2, 1.5 * 3.2 / 1.9))
                End If
                'mti 2021/07/15 End

                If NSNARAT32(R%) / NSNARAT19(R%) > CompMult And portionpoor > 0 And context.DevelopmentMode Then
                    Debug.Print(GRPS(1, R%) & ", " & "NSNARAT32" & "= " & NSNARAT32(R%) & ", " & "NSNARAT19" & "= " & NSNARAT19(R%) &
                    "Warning: This can produce problems in poverty calculations.")
                    'vbInformation, "Economic SAM Module"
                End If
            End If


' End Sub
