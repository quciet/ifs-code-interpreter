                '                VADDF(R%%, S%) = (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar)) - VADDHHU(R%%, S%) - VADDHHS(R%%, S%)
                '                'VADDF(R%%, S%) = (VaddPreCaput(R%%, S%) / (CAPUT(R%%, S%) / caputtar)) - VADDHHU(R%%, S%) - VADDHHS(R%%, S%)
                '            Else 'growth is endogenous
                '                VADDF(R%%, S%) = VADD(R%%, S%) - VADDHHU(R%%, S%) - VADDHHS(R%%, S%)
                '                'VADDF(R%%, S%) = VaddPreCaput(R%%, S%) - VADDHHU(R%%, S%) - VADDHHS(R%%, S%)
                '            End If
                VADDF(R%%, S%) = VADD(R%%, S%) - VADDHHU(R%%, S%) - VADDHHS(R%%, S%)
                'bbh 2021/08/04 end

                'bbh 2021/07/07 end
                'bbh 2020/08/20 end
                'bbh 2020/08/05 end
                FIRMEARN(R%%) = FIRMEARN(R%%) + VADDF(R%%, S%)
            Next S%


            'Earnings: Household and Firm
            '--------------------------------------
            '

            'HHINCEARN(R%%, Unskilled) = HHINC(R%%, Unskilled)
            'HHINCEARN(R%%, Skilled) = HHINC(R%%, Skilled)

            ''mti 2018/05/22 Start
            'HHINCEARN(R%%, NSkill%) = HHINCEARN(R%%, Skilled) + HHINCEARN(R%%, Unskilled)
            ''mti 2018/05/22 End

            'mti 2018/10/22 start

            LABWAGE(R%%, Unskilled) = HHINCEARN(R%%, Unskilled) / LABUnSkTot
            LABWAGE(R%%, Skilled) = HHINCEARN(R%%, Skilled) / LABSkTot
            'jrs 2023/03/15 LABWAGE(R%%, NSkill%) = HHINCEARN(R%%, NSkill%) / AMAX(0.0001, (LABUnSkTot + LABSkTot))
            LABWAGE(R%%, NSkill%) = (HHINCEARN(R%%, Unskilled) + HHINCEARN(R%%, Skilled)) / AMAX(0.0001, (LABUnSkTot + LABSkTot))
            'mti 2018/10/22 End

            'jrs 2026/02/20
            For S% = 1 To NSec
                LABWAGES(R%%, S%, NSkill%) = CSng((LABWAGES(R%%, S, Unskilled) * LABEMPS(R%%, S%, Unskilled) +
                    LABWAGES(R%%, S%, Skilled) * LABEMPS(R%%, S%, Skilled)) /
                    AMAX((LABEMPS(R%%, S%, Unskilled) + LABEMPS(R%%, S%, Skilled)), 0.0000001))
            Next

            'FIRMEARN(R%%) = FIRMINC(R%%)
            'bbh 2021/05/15 end

            'mti 2020/02/28 Start
            If IY% = 1 Then
                iLABWAGESEXRAT(R%%) = LABWAGESEXRAT(R%%)
            Else
                'base case uses the base/initial year value throughout the horizon; multiplier changes it
                LABWAGESEXRAT(R%%) = iLABWAGESEXRAT(R%%) * labwagesexratm(R%%)
            End If
            'mti 2020/02/28 End
