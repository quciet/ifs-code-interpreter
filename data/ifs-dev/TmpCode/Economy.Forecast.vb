                If HHINCDIS(R%, Skilled) / AMAX(0.0001, SHHPOP(R%, Skilled)) < 0.025 Then
                    TReduction = CSng(0.025 * SHHPOP(R%, Skilled) - HHINCDIS(R%, Skilled))
                    TaxTot = AMAX(0.0001, HHTAX(R%, Skilled) + HHGOVSS(R%, Skilled))
                    If TReduction >= TaxTot Then
                        HHTAX(R%, Skilled) = 0
                        HHGOVSS(R%, Skilled) = 0
                    Else
                        HHTAX(R%, Skilled) = HHTAX(R%, Skilled) * (1 - TReduction / TaxTot)
                        HHGOVSS(R%, Skilled) = HHGOVSS(R%, Skilled) * (1 - TReduction / TaxTot)
                    End If
                    HHINCDIS(R%, Skilled) = CSng(0.025 * SHHPOP(R%, Skilled))
