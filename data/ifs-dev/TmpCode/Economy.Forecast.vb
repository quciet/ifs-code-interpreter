                        'bbh 2022/12/20 Added Viet Nam
                        'If (RegName$(R%) = "Hong Kong" Or RegName$(R%) = "Singapore" Or RegName$(R%) = "Viet Nam") And S% >= 4 Then  'bbh 2022/06/23 Block added for entrepot economy
                        If (EntrepotEconomy(R%) > 200 And S% >= 4) Then 'bbh 2022/12/20 Replaced above with general reference to entrepot economies
                            If gdprext(R%) < -99 Then 'endogenous 'bbh 2022/09/05 added if-then-else block
                                xbase = (sxkav(R%, S%) * (SXS(R%, S%) + SMS(R%, S%)) +
