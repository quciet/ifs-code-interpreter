                    'mti 2020/04/29 End
                    AllAgeGroupButChild = AllAgeGroupButChild + POVCOUNT365(R%%, j%, Total)
                Next
    
                'give the remaining, if any to 0-14 group
                POVCOUNT365(R%%, 1, Total) = CSng(AMAX(0, Round(POVCOUNT365(R%%, TotPovAGCount, Total) - AllAgeGroupButChild, 6)))
                'mti 2020/04/29 start
                'POVRATE365(R%%, 1, Total) = 100 * POVCOUNT365(R%%, 1, Total) / POPPOVAG(R%%, 1, Total)
                POVRATE365(R%%, 1, Total) = 100 * POVCOUNT365(R%%, 1, Total) / AMAX(0.000001, POPPOVAG(R%%, 1, Total))
    
                'POVRATE365(R%%, TotPovAGCount, Total) = 100 * POVCOUNT365(R%%, TotPovAGCount, Total) / POPPOVAG(R%%, TotPovAGCount, Total)
                POVRATE365(R%%, TotPovAGCount, Total) = 100 * POVCOUNT365(R%%, TotPovAGCount, Total) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Total))
                'mti 2020/04/29 End
