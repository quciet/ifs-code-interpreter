' Sub GiniDomCalcFunc(GiniMatrix() As Single, PopMatrix() As Single, R%)
            '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
            Dim ginimathold() As Single, rankscale() As Integer
            Dim LorenzX(), LorenzY() As Single

            ReDim ginimathold(NHHTypes%), rankscale(NHHTypes%)
            ReDim LorenzX(NHHTypes%), LorenzY(NHHTypes%)

            'jrs 2014/09/16
            Dim matlargest As Single, WGiniMatrixSum As Single, ICount As Integer, MatSmall As Single, jCount As Integer, SmallReg As Integer, reg1 As Integer
            Dim AreaTot As Single, CumAreaEq As Single, CumAreaIneq As Single, PopCum As Single, GiniMatrixCum As Single, RegLast As Integer, reg As Integer
            Dim LPopCum As Single, LGiniMatrixCum As Single, NewAreaEqbase As Single, NewAreaEqAboveBase As Single, NewAreaIneq As Single

            '   Find largest per capita value and compute global sums
            'bbh 2020/08/13
            For ICount% = 1 To NHHTypes%
                'bbh 2021/05/15 GiniMatrix(ICount%) = AMAX(0.001, HHINC(R%%, ICount%))
                GiniMatrix(ICount%) = AMAX(0.001, HHINCDIS(R%%, ICount%))

                PopMatrix(ICount%) = AMAX(0.001, HHPOP(R%%, ICount%))
            Next ICount%

            matlargest = GiniMatrix(1) / PopMatrix(1)
            WGiniMatrixSum = 0
            '    POP(R%%) = 0
            For ICount% = 1 To NHHTypes% 'Copy matrix to sort into GiniMatHold and find largest value
                ginimathold(ICount%) = GiniMatrix(ICount%) / PopMatrix(ICount%)
                If ginimathold(ICount%) > matlargest Then
                    matlargest = ginimathold(ICount%)
                End If
                WGiniMatrixSum = WGiniMatrixSum + GiniMatrix(ICount%)
                '        POP(R%%) = POP(R%%) + PopMatrix(ICount%)
            Next ICount%

            '   Rank a matrix (e.g. GDPPC) from smallest to largest and maintain pointers
            '       1-NHHTypes% in RankScale
            For ICount% = 1 To NHHTypes%
                MatSmall = matlargest
                For jCount% = 1 To NHHTypes%  'Find smallest value not yet identified
                    If ginimathold(jCount%) <= MatSmall Then
                        MatSmall = ginimathold(jCount%)
                        SmallReg = jCount%
                    End If
                Next jCount%
                rankscale(ICount%) = SmallReg
                'Hold region number of smallest element
                ginimathold(SmallReg) = Math.Abs(matlargest * 2) 'Do not reuse smallest element
            Next ICount%

            '   Compute equality and inequality for "poorest" country
            reg1 = rankscale(1)
            AreaTot = CSng(0.5 * (PopMatrix(reg1) / POP(R%%)) ^ 2)
            CumAreaEq = CSng(0.5 * PopMatrix(reg1) / POP(R%%) * GiniMatrix(reg1) / WGiniMatrixSum)
            'e.g., if bottom 10% have 2%, then = .5 * .10 * .02 = .001
            CumAreaIneq = AreaTot - CumAreaEq
            'e.g., if looking at bottom 10% then = .5 * .1 * .1 - .001 = .004
            PopCum = PopMatrix(reg1)
            GiniMatrixCum = GiniMatrix(reg1)
            LorenzX(1) = PopMatrix(reg1) / POP(R%%)
            LorenzY(1) = GiniMatrix(reg1) / WGiniMatrixSum


            '   Compute equality and inequalty for all countries
            For ICount% = 2 To NHHTypes%
                RegLast = rankscale(ICount% - 1)
                reg = rankscale(ICount%)
                LPopCum = PopCum
                LGiniMatrixCum = GiniMatrixCum
                PopCum = PopCum + PopMatrix(reg)
                GiniMatrixCum = GiniMatrixCum + GiniMatrix(reg)
                AreaTot = CSng(0.5 * (PopCum / POP(R%%)) ^ 2)
                NewAreaEqbase = (PopMatrix(reg) / POP(R%%)) * (LGiniMatrixCum / WGiniMatrixSum)
                NewAreaEqAboveBase = CSng(1 / 2 * (PopMatrix(reg) / POP(R%%)) *
                    (GiniMatrixCum / WGiniMatrixSum - LGiniMatrixCum / WGiniMatrixSum))
                NewAreaIneq = AreaTot - CumAreaEq - CumAreaIneq -
                    NewAreaEqbase - NewAreaEqAboveBase
                CumAreaEq = CumAreaEq + NewAreaEqbase + NewAreaEqAboveBase
                CumAreaIneq = CumAreaIneq + NewAreaIneq
                LorenzX(ICount%) = LorenzX(ICount% - 1) + PopMatrix(reg) / POP(R%%)
                LorenzY(ICount%) = LorenzY(ICount% - 1) + GiniMatrix(reg) / WGiniMatrixSum
            Next ICount%

            '   Compute Gini relative to 1/2 - line of equality
            GiniDomCalc = CSng(AMAX(0.001, Amin(0.8, CumAreaIneq / 0.5)))

