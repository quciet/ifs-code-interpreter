            '    IFsCyb sgdpr1(), iCostChangeFac(), sICTCYBBENTOTCUM(), sICTCYBRISKTOTCUM(), iLCybCrimeEspF, TechLeadRegion%
            'bbh 2015/05/17
            'IFsCyb sgdpr1(), iCostChangeFac(), sICTCYBBENTOTCUM(), sICTCYBRISKTOTCUM(), GDPICyb(), ICTGrowthCumCompound(), ICTSurplusCumCompound(), iLCybCrimeEspF, TechLeadRegion%
            'bbh 2015/06/06

IFsCyb(sgdpr1, iCostChangeFac, sICTCYBBENTOTCUM, sICTCYBRISKTOTCUM, GDPICyb, ICTGrowthCumCompound, ICTSurplusCumCompound, ICTIndexB4Mul, iLCybCrimeEspF, TechLeadRegion%, context)
' ---- Begin Inlined Level 1: IFsCyb
' Private Sub IFsCyb(sgdpr1() As Single, iCostChangeFac() As Single, sICTCYBBENTOTCUM() As Single, sICTCYBRISKTOTCUM() As Single, GDPICyb() As Single,
' ICTGrowthCumCompound() As Single, ICTSurplusCumCompound() As Single, ICTIndexB4Mul() As Single, ByRef iLCybCrimeEspF As Single, TechLeadRegion%, context As IForecastContext)
            'mti 2015/05/06 - new proc
            Dim R%, TbName$, evt%, cst%
            Dim ICTCyberSecSpendExp As Single, ICTIndexContrib As Single
            Dim ICTINDEXExp As Single, CostChangeFac As Single, CybCrimeEspF As Single, ICTCybEvtScale As Single

            'mti 2015/05/13 - start
            'gvdb 2024/04/05
            ' unused variable
            'Dim ICTIndexExp2 As Single, Y2Conv As Integer
            'mti 2015/05/13 - end

            'mti 2015/05/13 -start
            Dim Intrcpt, BCoeFF As Single
            'bbh 2015/06/06 start
            'Need to set up relationship parameters for expected ICTIndex without multiplier on ICTIndex
            '   Otherwise rise in ictindexm causes shift upward in estimated function with GDPPPCP and expected ICTINDEX
            '   meaning that scenario has no growth benefits or consumer surplus benefits and can raise opportunity costs
            Dim CybGrBenShr, CybConSurShr As Single
            For R% = 1 To NR%
                ICTIndexB4Mul(R%) = ICTINDEX(R%) / ictindexm(R%)
            Next R%
            LogRegRun(GDPPCP, ICTIndexB4Mul, Intrcpt, BCoeFF)
            'LogRegRun GDPPCP(), ICTINDEX(), Intrcpt, BCoeFF
            'bbh 2015/06/06 end

            'mti 2015/05/13 -end
            'jrs 2026/05/18
            If IY = 1 Then
                TbNameICT$ = "ICT Development Index Versus ICT Cyber Security Index (" & CStr(BaseYear) & ") Linear"
                TbNameICT$ = getFunctionNameYrOrMstRct(TbNameICT$, BaseYear, context)
            End If

            For R% = 1 To NR%

                If IY = 1 Then
                    sgdpr1(R%) = GDPR(R%)
                End If


                '--------- Cyber Benefit --------------

                'mti 2015/05/13 - start
                '         ' Expected Level of ICT
                '         ICTINDEXExp = -9.9348 + 1.5915 * Log(GDPPCP(R%) * 1000)  'function drawn with GDPPCP in thousand $
                '
                '
                '         ICTIndexExp2 = 2.2638 + 0.6849 * Log(GDPPCP(R%) * 1000)
                '         Y2Conv = 2040 - BaseYear
                '         ICTINDEXExp = ConvergeOverTime(ICTINDEXExp, ICTIndexExp2, Y2Conv)

                ICTINDEXExp = CSng(Intrcpt + BCoeFF * Math.Log(GDPPCP(R%)))
                'mti 2015/05/13 -end

                'bbh 2015/06/07 start
                ICTINDEXExp = AMAX(0.3, ICTINDEXExp)

                ' BBH tried hard to match ICTCYBENEFIT and ICTCONSURPLUS to historical data with ICTINDEX breakpoint code
                '   Focused on avoiding transients for WB income categories and world
                '   Problems included skimpy historical data esp lower income countries and some jumps across ICTIndex
                '      categories that messed up ictindexm scenarios - index rise could push into new category and create
                '      perverse effects such as higher index lowered GDPGR contribution for lower middle income countries
                '   So shifted to more generic formulations immediately below; historical fit is not quite as good
                '      But fit is messy and often simple average very differnet than GDP-weighted ones
                CybGrBenShr = CSng(0.3 - 0.15 * Amin(1, (GDPPCP(R%) / 40)))
                CybConSurShr = CSng(0.1 - 0.05 * Amin(1, (GDPPCP(R%) / 40)))
                ICTCYBBENEFIT(R%) = CybGrBenShr * sgdpr1(R%) * ictcybbenefitm(R%)
                ICTCYBBENEFIT(R%) = ICTCYBBENEFIT(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)
                ICTCONSURPLUS(R%) = CybConSurShr * sgdpr1(R%) * ictconsurplusm(R%)
                ICTCONSURPLUS(R%) = ICTCONSURPLUS(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)

                '         If ICTINDEX(R%) < 1 Then 'low-income countries ictindex average=1.4 ; set at .3 * moving average GDPR
                '            ICTCYBBENEFIT(R%) = 0.3 * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 2.5 Then 'lower-middle-income average 2.3 ; take to 0.35 (0.3 + 0.0333*1.5)
                '            ICTCYBBENEFIT(R%) = (0.3 + 0.033337 * (ICTINDEX(R%) - 1)) * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 4 Then 'upper middle income average 3.7l; drop to  0.15 (.35-.1333 * 1.5)
                '            ICTCYBBENEFIT(R%) = (0.35 - 0.133 * (ICTINDEX(R%) - 2.5)) * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 7 Then 'high income is 6.7; leave at 0.15
                '            ICTCYBBENEFIT(R%) = (0.15 + 0# * (ICTINDEX(R%) - 4)) * sgdpr1(R%) * ictcybbenefitm(R%)
                '
                '         Else
                '           ICTCYBBENEFIT(R%) = 0.15 * sgdpr1(R%) * ictcybbenefitm(R%)
                '         End If
                '
                '         'ICTCYBBENEFIT(R%) = ICTCYBBENEFIT(R%) * Amin(2, AMAX(0.5, ICTINDEX(R%) / ICTINDEXExp))
                '         ICTCYBBENEFIT(R%) = ICTCYBBENEFIT(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)


                If ICTINDEX(R%) >= ICTINDEXExp Then
                    ICTCYBOPCOST(R%) = 0
                Else
                    'ICTCYBOPCOST(R%) = ICTCYBBENEFIT(R%) * AMAX(0.5, (1 - ICTINDEX(R%) / ICTINDEXExp))
                    ICTCYBOPCOST(R%) = ICTCYBBENEFIT(R%) * (ICTINDEXExp - ICTINDEX(R%)) / 10
                End If

                'ICTCONSURPLUS(R%) = 0.07 * sgdpr1(R%) * ictconsurplusm(R%)

                '         If ICTINDEX(R%) < 1 Then 'low-income countries ictindex average=1.4 ; set at .3 * moving average GDPR
                '            ICTCONSURPLUS(R%) = 0.1 * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 2.5 Then 'lower-middle-income average 2.3 ; leave at .1)
                '            ICTCONSURPLUS(R%) = (0.1 + 0# * (ICTINDEX(R%) - 1)) * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 4 Then 'upper middle income average 3.7l; leave at .1)
                '            ICTCONSURPLUS(R%) = (0.1 - 0# * (ICTINDEX(R%) - 2.5)) * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         ElseIf ICTINDEX(R%) < 7 Then 'high income is 6.7; take to .04;( 0.1- .02* 3)
                '            ICTCONSURPLUS(R%) = (0.1 - 0.02 * (ICTINDEX(R%) - 4)) * sgdpr1(R%) * ictconsurplusm(R%)
                '
                '         Else
                '           ICTCONSURPLUS(R%) = 0.04 * sgdpr1(R%) * ictconsurplusm(R%)
                '         End If
                '
                ''If RegName(R%) = "China" Then Stop
                '
                '        ' ICTCONSURPLUS(R%) = ICTCONSURPLUS(R%) * Amin(2, AMAX(0.5, ICTINDEX(R%) / ICTINDEXExp))
                '         ICTCONSURPLUS(R%) = ICTCONSURPLUS(R%) * (1 + (ICTINDEX(R%) - ICTINDEXExp) / 10)

                If ICTINDEX(R%) < ICTINDEXExp Then
                    'ICTCYBOPCOST(R%) = ICTCYBOPCOST(R%) + ICTCONSURPLUS(R%) * AMAX(0.5, (1 - ICTINDEX(R%) / ICTINDEXExp))
                    ICTCYBOPCOST(R%) = ICTCYBOPCOST(R%) + ICTCONSURPLUS(R%) * (ICTINDEXExp - ICTINDEX(R%)) / 10
                End If
                ICTCYBOPCOST(R%) = ICTCYBOPCOST(R%) + ictcybopcostadd(R%)
                'bbh 2015/06/07 emd

                ICTCYBBENTOT(R%) = ICTCYBBENEFIT(R%) + ICTCONSURPLUS(R%)

                '--------- Cyber Cost --------------
                'mti 2015/04/29 - start - need to check call seq here
                'ICTCYBSECSPEND(R%) = Amin(0.1, AMAX(0.001, (INFRAINDICT(R%) / 83.33) * GDPPCP(R%) / 500)) '83.33 is the max of InfraindICT

                'ICTCyberSecSpendExp = Amin(0.4, (Log(Amin(10, ICTINDEX(R%))) / 3.65) * (Log(Amin(80, GDPPCP(R%))) / 6.95))
                'avoiding negatives
                ICTCyberSecSpendExp = CSng(Amin(0.4, (Log(AMAX(1.01, Amin(10, ICTINDEX(R%)))) / 3.65) * (Log(Amin(80000, GDPPCP(R%) * 1000)) / 17.805)))
                '  Debug.Print IY; RegName(R%)
                ICTCYBSECSPEND(R%) = ICTCyberSecSpendExp * ictcybsecspendm(R%)
                'If RegName(R%) = "Somalia" And IY > 15 And ICTCYBSECSPEND(R%) <= 0 Then Stop

                'jrs 2026/05/18 take out of the loop
                'TbName$ = "ICT Development Index Versus ICT Cyber Security Index (" & CStr(BaseYear) & ") Linear"
                'TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
                Call XYTABL(TbNameICT$, ICTINDEX(R%), ICTIndexContrib, context)

                '    If RegName(R%) = "Somalia" Then Stop 'And IY > 20
                '    If RegName(R%) = "United States Of America" Then Stop

                ICTCYBSECURITY(R%) = CSng(ICTIndexContrib * ((ICTCYBSECSPEND(R%) / ICTCyberSecSpendExp) ^ 0.2) * ictcybsecuritym(R%))

                If IY = 1 Then
                    'initial values for cost increment
                    iCostChangeFac(R%) = CSng(AMAX(5.5, ICTINDEX(R%) / (ICTCYBSECURITY(R%) + 0.1)))  'prevent it from being too low for countries like Somalia, Chad
                    'initial year cost of leader country
                    If R% = 1 Then
                        iLCybCrimeEspF = CSng(-0.0738 + 0.0605 * ICTINDEX(TechLeadRegion%%)) 'this needs just one time calculation; TechLeadRegion%% = USA
                    End If
                End If

                'Changes in core cost from ICT diffusion and worsening security situation
                CostChangeFac = CSng(ICTINDEX(R%) / (ICTCYBSECURITY(R%) + 0.1) / iCostChangeFac(R%))

                'Function of crime and espionage related cost (as a % of GDP) over ICT Dev Index (needs to put it in TablFunc)
                CybCrimeEspF = CSng(-0.0738 + 0.0605 * ICTINDEX(R%))
                '     If IY = 2 Then Stop
                'Scaling of cyber cost to initial year cost of leader country
                ICTCybEvtScale = iLCybCrimeEspF - CybCrimeEspF

                '       If RegName(R%) = "Somalia" Then Stop 'And IY > 20
                '    If RegName(R%) = "United States Of America" And IY > 50 Then Stop
                '
                '    If RegName(R%) = "Uganda" And IY > 50 Then Stop

                ICTCYBEVTCOST(R%) = 0

                'mti 2015/06/09 - start
                For evt% = 1 To 4  'event type: Hactivism, Cybcrime, Cybespion, Cybterror
                    For cst% = 1 To 3 'attacker/defender
                        ICTCYBEVTCOST(R%) = ICTCYBEVTCOST(R%) + ictcybevprob(evt, cst) * ictcybevcost(evt, cst)
                    Next cst%
                    ICTCYBEVTCOST(R%) = ICTCYBEVTCOST(R%) * ictcybevtcostm(R%, evt%)
                Next evt%

                ICTCYBEVTCOST(R%) = AMAX(0.01, (ICTCYBEVTCOST(R%) * CostChangeFac - ICTCybEvtScale)) '* ictcybevtcostm(R%))

                'mti 2015/06/09 - end


                ICTCYBRISKTOT(R%) = ICTCYBSECSPEND(R%) + ICTCYBEVTCOST(R%) + ICTCYBOPCOST(R%)

                'mti 2015/05/13 - start

                'bbh 2015/05/17 begin
                'ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) + (((1 + ICTCYBBENTOT(R%) / 100) ^ IY - 1) _
                '+ ((1 + ICTCONSURPLUS(R%) / 100) ^ IY - 1)) * GDP(R%)
                If IY = 1 Then
                    sICTCYBBENTOTCUM(R%) = 0
                    GDPICyb(R%) = GDP(R%)
                    ICTGrowthCumCompound(R%) = 1 + ICTCYBBENEFIT(R%) / 100
                    ICTSurplusCumCompound(R%) = 1 + ICTCONSURPLUS(R%) / 100
                Else
                    ICTGrowthCumCompound(R%) = ICTGrowthCumCompound(R%) * (1 + ICTCYBBENEFIT(R%) / 100)
                    ICTSurplusCumCompound(R%) = ICTSurplusCumCompound(R%) * (1 + ICTCONSURPLUS(R%) / 100)
                End If
                'ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) + (((1 + ICTCYBBENTOT(R%) / 100) ^ IY - 1) _
                '+ ((1 + ICTCONSURPLUS(R%) / 100) ^ IY - 1)) * GDP(R%)
                'ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) + _
                '((ICTCYBBENEFIT(R%) / 100) * ((1 + (ICTCYBBENEFIT(R%) / 100)) ^ IY) + _
                '(ICTCONSURPLUS(R%) / 100) * ((1 + (ICTCONSURPLUS(R%) / 100)) ^ IY)) * GDP(R%)

                'If RegName(R%) = "United States Of America" Then Stop

                ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) +
            ((ICTGrowthCumCompound(R%) - 1) + (ICTSurplusCumCompound(R%) - 1)) * GDPICyb(R%)
                'bbh 2015/05/17 end

                ICTCYBRISKTOTCUM(R%) = sICTCYBRISKTOTCUM(R%) + ICTCYBRISKTOT(R%) * GDP(R%) / 100

                'mti 2015/05/13 - end

                'mti 2015/06/01 - start
                ICTCYBBENEFITNET(R%) = ICTCYBBENTOT(R%) - ICTCYBRISKTOT(R%)
                ICTCYBBENEFITCUMNET(R%) = ICTCYBBENTOTCUM(R%) - ICTCYBRISKTOTCUM(R%)

                'mti 2015/06/01 - end

                sICTCYBBENTOTCUM(R%) = ICTCYBBENTOTCUM(R%)
                sICTCYBRISKTOTCUM(R%) = ICTCYBRISKTOTCUM(R%)
                'mti 2015/05/06 - end

                sgdpr1(R%) = CSng(0.8 * sgdpr1(R%) + 0.2 * GDPR(R%))
                'mti Jan 27 2015 - end
            Next R%
' End Sub
' ---- End Inlined Level 1: IFsCyb

            'mti 2015/05/06 - end
            '



        End Sub
