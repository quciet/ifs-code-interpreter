                    'jrs 2022/01/11
                    igdprcor(R%) = CSng(AMAX(0.001, AMAX(Amin(igdpr(R%), 0.2), POPR(R%) / 100 + minpcgr(R%)))) 'jrs 2021/08/16
                    'igdprcor(R%) = CSng(AMAX(0.001, AMAX(Amin(igdpr(R%), 0.2), (CBR(R%) - CDR(R%)) / 1000 + minpcgr(R%)))) 'jrs 2021/08/16
                Else
