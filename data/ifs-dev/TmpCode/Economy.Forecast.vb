                            POVRATE32(R%, j%, Total) = AMAX(0, Amin(100, POVRATE32(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                        Next

                        'once converged even if an extreme prolonged recession brings GDPPCP(R%) below target; AG pov ratio to ref won't move;

                    Else
                        If sGDPPCP(R%) >= IncomeTrgt Then  'sGDPPCP(R%) saved in more than 1 place populat, AG, Infra (?) save in economy after external
                            IncTrgtCovd = 1
                        Else  'negatives will also be handled below
                            IncTrgtCovd = (sGDPPCP(R%) - iGDPPCP(R%)) / (IncomeTrgt - iGDPPCP(R%))

                            If sGDPPCP(R%) < iGDPPCP(R%) Then  'declining income; increasing national poverty

                                For j% = 1 To TotPovAGCount - 1
                                    If PovRateRatioToRefAG_Trgt(j%) < iPovRateRatioToRefAG32(R%, j%) Then  'Venzuela: 60+: 1.4 initial; .52 target
                                        IncTrgtCovd = 0 'initial AG/refAG Pov ratio higher than target;
                                    End If
                                Next
                            End If

                        End If


                        For j% = 1 To TotPovAGCount

                            'Poverty (AG multiple of all ages) target covered up so far  = IncTrgtCovd
                            PovRateRatioToRefAG_Cur = CSng(iPovRateRatioToRefAG32(R%, j%) + IncTrgtCovd * (PovRateRatioToRefAG_Trgt(j%) - iPovRateRatioToRefAG32(R%, j%)))  'AMAX(0, (can be in both direction)

                            POVRATE32(R%, j%, Total) = AMAX(0, Amin(100, POVRATE32(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                        Next
                    End If
                    'mti 2021/12/28 start
                End If
                'mti 2021/12/28 End

                If povagesexnormstatic = 0 Then
                    'base case: using national poverty forecast for normalizing: top-down
