                                xabsmod(Actor, S%) = CSng(xabsmod(Actor, S%) + SXDYAD_Norm(Actor, Partner, S%%) / AMAX(SMS(Partner, S%%) * 1000000000, 0.000000001) * mbasediff(Partner, S%))
