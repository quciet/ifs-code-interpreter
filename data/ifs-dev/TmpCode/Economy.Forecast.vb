                For R% = 1 To NR%
    
                    If POVMIDHIGH(R%) > 0 Then
                        'mti 2021/06/30 start
                        'PerPoorShortFall = 365 * 8.3 * (POVGAP(R%) / 100) * POP(R%) / POVMIDHIGH(R%) / 1000  'in thoUSAnd dollars
                        PerPoorShortFall = 365 * 8.3 * (POVGAP830(R%) / 100) * POP(R%) / POVMIDHIGH(R%) / 1000   'in thoUSAnd dollars
                        'mti 2021/06/30 ends
                    Else
                        PerPoorShortFall = 0
                    End If
                    POVSHORT830(R%, TotPovAGCount, Male) = 0
                    POVSHORT830(R%, TotPovAGCount, Female) = 0
                    POVSHORT830(R%, TotPovAGCount, Total) = 0
                    POVSHORTSEXDIFF830(R%, TotPovAGCount) = 0
    
    
                    For j% = 1 To TotPovAGCount - 1
                        POVSHORT830(R%, j%, Male) = POVCOUNT830(R%, j%, Male) * PerPoorShortFall  'million people * thoUSAnd dollars = billion dollars
                        POVSHORT830(R%, j%, Female) = POVCOUNT830(R%, j%, Female) * PerPoorShortFall
                        POVSHORT830(R%, j%, Total) = POVSHORT830(R%, j%, Male) + POVSHORT830(R%, j%, Female)
    
                        POVSHORTSEXDIFF830(R%, j%) = AMAX(0, POVSHORT830(R%, j%, Female) - POVSHORT830(R%, j%, Male))
    
                        POVSHORT830(R%, TotPovAGCount, Male) = POVSHORT830(R%, TotPovAGCount, Male) + POVSHORT830(R%, j%, Male)
