                            Growth = CSng(Exp(ValEst) / SXDYADGravity(II, j, Serv))
                        Else
                            Growth = 1
                        End If
                        SXDYADGravity(II, j, Serv) = CSng(Exp(ValEst))
                        XDYAD(II, j, Serv) = SXDYAD(II, j, Serv) * Growth
                        'jrs 2019/09/26 *** end ***

                        'Apply Same Growth to all Sectors
                        'jrs 2019/09/26
                        XDYAD(II, j, 0) = 0
                        For k = 1 To NSec
                            XDYAD(II, j, 0) = XDYAD(II, j, 0) + XDYAD(II, j, k)
                            'Save exports before affected by parameters
                            'jrs 2017/05/23
                            'move down to use it for military
                            'SXDYAD(II, j, k) = XDYAD(II, j, k)
                        Next k

                        'All but First: Apply Tariff logic
                        Dim m As Integer = 1
                        For k = 0 To NSec
                            If tradecostgeneral(II, j, k) <> 1 Then
                                Dim TradeDelta As Double, TradeWithOthrPartners As Double
                                TradeDelta = XDYAD(II, j, k) * tradeelastpriceexportsdyad(II, j, k) * (tradecostgeneral(II, j, k) - 1)
                                'jrs 2017/02/10
                                TradeDelta = AMAX(TradeDelta, -1 * XDYAD(II, j, k))
                                TradeDeltaCum(II, j, k) = CSng(TradeDeltaCum(II, j, k) + TradeDelta)
                                For m = 1 To NR
                                    If m <> j Then
                                        TradeWithOthrPartners = TradeWithOthrPartners + XDYAD(II, m, k)
                                    End If
                                Next m
                                If TradeWithOthrPartners > 0 Then
                                    For m = 1 To NR
                                        'If GRPS(1, II) = "Cyprus" And GRPS(1, M) = "Belgium" And FirstYear + IY - 1 >= 2029 Then Stop
                                        If m <> j Then
                                            TradeDeltaCum(II, m, k) = CSng(TradeDeltaCum(II, m, k) + tradeelastpriceexportsdyad(II, m, k) * TradeDelta * XDYAD(II, m, k) / TradeWithOthrPartners)
                                            'jrs 2017/02/10
                                            TradeDeltaCum(II, m, k) = AMAX(TradeDeltaCum(II, m, k), -1 * XDYAD(II, m, k))
                                        End If
                                    Next m
                                End If
                            End If
                        Next k
                    End If
                Next j
            Next II

            'End Sub)

            'All but First: Apply Tariff Changes
            Dim bTradeFlag As Boolean = False
            Dim contig1 = 1%
            Dim GDPPCP_hl = 0!
            Dim DEMOCPOLITY_hl = 0!

            For II = 1 To NR
                For j = 1 To NR
                    'If GRPS(1, II) = "Cyprus" And GRPS(1, j) = "Belgium" And FirstYear + IY - 1 >= 2029 Then Stop
                    bTradeFlag = False
                    For k = 1 To NSec
                        If TradeDeltaCum(II, j, k) <> 0 Then
                            XDYAD(II, j, k) = XDYAD(II, j, k) + TradeDeltaCum(II, j, k)
                            'jrs 2017/02/10 XDYAD(II, j, 0) = XDYAD(II, j, 0) + TradeDeltaCum(II, j, k)
                            bTradeFlag = True
                        End If
                    Next k
                    'jrs 2017/02/10
                    If bTradeFlag Then
                        'Reset total value
                        XDYAD(II, j, 0) = 0
                        For k = 1 To NSec
                            XDYAD(II, j, 0) = XDYAD(II, j, 0) + XDYAD(II, j, k)
                        Next k
                    End If

                    If TradeDeltaCum(II, j, 0) <> 0 Then
                        If XDYAD(II, j, 0) <> 0 Then
                            For k = 1 To NSec
                                'If IY = 18 And II = 34 And j = 178 And k = 6 Then Stop
                                XDYAD(II, j, k) = XDYAD(II, j, k) + TradeDeltaCum(II, j, 0) * XDYAD(II, j, k) / XDYAD(II, j, 0)
                            Next k
                        Else
                            For k = 1 To NSec
                                XDYAD(II, j, k) = XDYAD(II, j, k) + TradeDeltaCum(II, j, 0) / 6
                            Next k
                        End If
                        XDYAD(II, j, 0) = XDYAD(II, j, 0) + TradeDeltaCum(II, j, 0)
                    End If
                Next j
            Next II

            'jrs 2019/09/26
            For II = 1 To NR
                For j = 1 To 3
                    SAGX(II, j) = AGX(II, j)
                Next j
                For j = 1 To NEP 'clp 2024/08/20 energy type count fixes for bilateral ***START***
                    SENP(II, j) = ENP(II, j)
                Next j
                For j = 1 To NSec
                    SXS(II, j) = XS(II, j)
                Next j 'clp 2024/08/20 energy type count fixes for bilateral SXS(II, j) = XS(II, j) ***END***
            Next II

            'jrs 2022/04/20
            'All but first: Generate ranked propensity scores for LOR
            '--------------------------------------------------------
            Dim z As Double, lorscore As Double
            Dim affinityRank(NR, NR) As Integer
            If IY > 2 Then
                For ii = 1 To NR
                    Dim scores As Dictionary(Of Integer, Double) = New Dictionary(Of Integer, Double)
                    For j = 1 To NR
                        If j <> ii Then
                            z = -6.610434 + (8.361949 * SXDYAD2(ii, j, 5)) + (-0.0001667 * DistanceBilat(ii, j)) +
                            (10.11272 * SPOWER(ii)) + (10.84424 * SPOWER(j)) + (0.0192345 * DYADPOLITYAFFINITY(ii, j)) +
                            (0.2697322 * (SPOWER(ii) * DYADPOLITYAFFINITY(ii, j))) + (0.1356601 * (SPOWER(j) * DYADPOLITYAFFINITY(ii, j))) +
                            (0.0569043 * Log(GDPPCP(ii))) + (0.2907447 * Log(GDPPCP(j)))
                            lorscore = tradeexportdyadm2(ii, j, 5) * (Exp(z) / Exp(1 + z)) + loradd(ii, j)
                        Else
                            lorscore = 0
                        End If
                        scores.Add(j, lorscore)
                    Next
                    Dim ranks = From entry In scores Order By entry.Value Select entry

                    Dim jj As Integer = 0
                    For Each item In ranks
                        jj = jj + 1
                        affinityRank(ii, jj) = item.Key
                    Next
                Next
            End If

            'jrs 2017/05/08
            'All but first: Forecast logic for Military, FDI, AID, MIGRANT, LOR
            '--------------------------------------------------------------------
            'jrs 2026/05/25
            '        Parallel.For(1, NR + 1,
            'Sub(II)

            'End Sub)

            For II = 1 To NR
                For j = 1 To NR
                    'jrs 2022/04/20 Polity affinity
                    DYADPOLITYAFFINITY(II, j) = 20 - Abs(DEMOCPOLITY(II) - DEMOCPOLITY(j))

                    'If GRPS(1, II) = "United States of America" And GRPS(1, j) = "Australia" Then Stop
                    'Forecast of Military exports, use same growth of manufactures
                    'jrs 2017/07/07
                    If II <> j AndAlso SXDYAD2(II, j, 1) <> 0 Then
                        'If GRPS(1, II) = "United States of America" And GRPS(1, j) = "Saudi Arabia" Then Stop
                        'XDYADMIL = E ^ { -1.414 + (0.272 * POWERGPI_a) + (-0.0378 * POWERGPI_p) + [0.0530 * LN(MDYADENE)] + [0.633 * LN(GDS{Military}_a)] + [0.296 * LN(GDS{Military}_p)] + (0.800 * contig1) }
                        If contiguity(II, j) = 1 Then
                            contig1 = 1
                        Else
                            contig1 = 0
                        End If
                        'Estimate Values
                        'jrs 2017/08/07 Call AnalFunc("Log of Bilateral Military Exports", _
                        'Array(SPOWERGPI(II), SPOWERGPI(j), XDYAD(j, II, 2), sgds(II, Mil), sgds(j, Mil), contig1), ValEst, _
                        'Array("POWERGPI_a", "POWERGPI_p", "MDYADENE", "GDSMIL_a", "GDSMIL_p", "contig1"))
                        'jrs 2022/03/18 changing to use sGDS instead, found by Caleb
                        Call AnalFunc("Log of Bilateral Military Exports",
                        New Single() {XDYAD(j, II, 2), sgds(II, Mil), sgds(j, Mil), contig1, DistanceBilat(II, j)}, ValEst,
                        New String() {"MDYADENE", "GDSMIL_a", "GDSMIL_p", "contig1", "DISTANCE"}, context)

                        If SXDYADGravityMIL(II, j) <> 0 Then
                            Growth = CSng(Exp(ValEst) / SXDYADGravityMIL(II, j))
                        Else
                            Growth = 1
                        End If
                        SXDYADGravityMIL(II, j) = Exp(ValEst)
                        XDYAD2(II, j, 1) = SXDYAD2(II, j, 1) * Growth
                    End If
                    '                    If SXDYAD(II, j, 4) <> 0 Then
                    '                        XDYAD2(II, j, 1) = SXDYAD2(II, j, 1) * XDYAD(II, j, 4) / SXDYAD(II, j, 4)
                    '                    Else
                    '                        XDYAD2(II, j, 1) = SXDYAD2(II, j, 1)
                    '                    End If

                    'All but first: Forecast of FDI exports, avg growth between XFDIFIN, XFDIOUT
                    '-----------------------------------------------------------------------------
                    'jrs 2017/06/12 use the gravity logic instead
                    '                    If SXFDIFOUT2(II) <> 0 And SXFDIFIN2(j) <> 0 Then
                    '                        XDYAD2(II, j, 2) = SXDYAD2(II, j, 2) * (XFDIFOUT(II) / SXFDIFOUT2(II) + XFDIFIN(j) / SXFDIFIN2(j)) / 2
                    '                    ElseIf SXFDIFOUT2(II) <> 0 Then
                    '                        XDYAD2(II, j, 2) = SXDYAD2(II, j, 2) * (XFDIFOUT(II) / SXFDIFOUT2(II))
                    '                    ElseIf SXFDIFIN2(j) <> 0 Then
                    '                        XDYAD2(II, j, 2) = SXDYAD2(II, j, 2) * (XFDIFIN(j) / SXFDIFIN2(j))
                    '                    Else
                    '                        XDYAD2(II, j, 2) = SXDYAD2(II, j, 2)
                    '                    End If
                    If II <> j Then
                        Call AnalFunc("Log of Bilateral FDI",
                        New Single() {SGDP(II), SGDP(j), DistanceBilat(II, j), XDYAD(II, j, 0)}, ValEst,
                        New String() {"GDP_A", "GDP_B", "DISTANCE", "XDYAD"}, context)

                        If SXDYADGravity2(II, j) <> 0 Then
                            Growth = CSng(Exp(ValEst) / SXDYADGravity2(II, j))
                        Else
                            Growth = 1
                        End If
                        SXDYADGravity2(II, j) = Exp(ValEst)
                        XDYAD2(II, j, 2) = SXDYAD2(II, j, 2) * Growth
                    End If
                    'Forecast of AID exports, use monadyc variable growth
                    'jrs 2022/04/29 Design by Caleb, new AID formulation
                    'If AID(II) < 0 AndAlso SAID(II) < 0 AndAlso AID(j) > 0 AndAlso SAID(j) > 0 Then
                    '    XDYAD2(II, j, 3) = SXDYAD2(II, j, 3) * (AID(II) / SAID(II) + AID(j) / SAID(j)) / 2
                    'ElseIf AID(II) < 0 AndAlso SAID(II) < 0 Then
                    '    XDYAD2(II, j, 3) = SXDYAD2(II, j, 3) * AID(II) / SAID(II)
                    'ElseIf AID(j) > 0 AndAlso SAID(j) > 0 Then
                    '    XDYAD2(II, j, 3) = SXDYAD2(II, j, 3) * AID(j) / SAID(j)
                    'Else
                    '    XDYAD2(II, j, 3) = SXDYAD2(II, j, 3)
                    'End If
                    If II <> j Then
                        'jrs 2022/05/27 added /100 to both power meassures
                        Call AnalFunc("Bilateral Aid Exports",
                        New Single() {sGDPPCP(II), sGDPPCP(j), SPOWER(II) / 100, SPOWER(j) / 100}, ValEst,
                        New String() {"GDPPCP_A", "GDPPCP_B", "POWER_A", "POWER_B"}, context)

                        If SXDYADGravity3(II, j) <> 0 Then
                            Growth = CSng(Exp(ValEst) / SXDYADGravity3(II, j))
                        Else
                            Growth = 1
                        End If
                        SXDYADGravity3(II, j) = Exp(ValEst)
                        'And FirstYear + IY - 1 >= 2020 
                        'If GRPS(1, II) = "United States of America" And GRPS(1, j) = "Ukraine" Then
                        '    Debug.Print((FirstYear + IY - 1).ToString & "," & SXDYAD2(II, j, 3).ToString & "," & Growth & "," & ValEst)
                        'End If
                        'If GRPS(1, II) = "China" And GRPS(1, j) = "Palestine" Then Stop
                        XDYAD2(II, j, 3) = SXDYAD2(II, j, 3) * Growth
                    End If

                    'jrs 2017/12/01 moved to pop
                    '                    'jrs 2017/11/23 Migrants(ii) < 0 is migrants leaving country ii, only using growth if one of the countries is going the right direction
                    '                    'since XDYAD(ii, j) is the exports from ii to j
                    '                    'jrs 2017/11/22 added a Maximum growth rate of 100% (or a factor of 2)
                    '                    'Forecast of MIGRANT exports
                    '                    If (MIGRANTS(II) < 0 And smigrants(II) < 0 And MIGRANTS(j) > 0 And smigrants(j) > 0) Then
                    '                        XDYAD2(II, j, 4) = SXDYAD2(II, j, 4) * Amin((MIGRANTS(II) / smigrants(II) + MIGRANTS(j) / smigrants(j)) / 2, 2)
                    '                    ElseIf MIGRANTS(II) < 0 And smigrants(II) < 0 Then
                    '                        XDYAD2(II, j, 4) = SXDYAD2(II, j, 4) * Amin(MIGRANTS(II) / smigrants(II), 2)
                    '                    ElseIf MIGRANTS(j) > 0 And smigrants(j) > 0 Then
                    '                        XDYAD2(II, j, 4) = SXDYAD2(II, j, 4) * Amin(MIGRANTS(j) / smigrants(j), 2)
                    '                    Else
                    '                        XDYAD2(II, j, 4) = SXDYAD2(II, j, 4)
                    '                    End If
                    'Forecast of LOR exports
                    'jrs 2022/01/07 keep it consant
                    'If SDIPLOEMBASSY2(II) > 0 Then
                    '    XDYAD2(II, j, 5) = SXDYAD2(II, j, 5) * SDIPLOEMBASSY(II) / SDIPLOEMBASSY2(II)
                    'Else
                    '    XDYAD2(II, j, 5) = SXDYAD2(II, j, 5)
                    'End If
                    XDYAD2(II, j, 5) = SXDYAD2(II, j, 5)
                    'Forecast for IGO
                    'jrs 2017/08/07
                    '                    If SDIPLOIGO2(II) > 0 Then
                    '                        IGO(II, j) = SIGO(II, j) * SDIPLOIGO(II) / SDIPLOIGO2(II)
                    '                    Else
                    '                        IGO(II, j) = SIGO(II, j)
                    '                    End If

                    If II <> j Then
                        If sGDPPCP(II) > sGDPPCP(j) Then
                            GDPPCP_hl = CSng(sGDPPCP(II) / AMAX(sGDPPCP(j), 0.000001))
                        Else
                            GDPPCP_hl = CSng(sGDPPCP(j) / AMAX(sGDPPCP(II), 0.000001))
                        End If
                        If SDEMOCPOLITY(II) > SDEMOCPOLITY(j) Then
                            DEMOCPOLITY_hl = CSng(SDEMOCPOLITY(II) / AMAX(SDEMOCPOLITY(j), 0.000001))
                        Else
                            DEMOCPOLITY_hl = CSng(SDEMOCPOLITY(j) / AMAX(SDEMOCPOLITY(II), 0.000001))
                        End If

                        Call AnalFunc("Log of Weighted IGO membership",
                        New Single() {SGDP(II), SGDP(j), DistanceBilat(II, j), SWGDP, GDPPCP_hl, DEMOCPOLITY_hl, XDYAD(II, j, 0) + XDYAD(j, II, 0)}, ValEst,
                      New String() {"GDP_a", "GDP_p", "DISTANCE", "WGDP", "GDPPCP_hl", "DEMOCPOLITY_hl", "XDYAD_MDYAD"}, context)
                        ValEst = CSng(Exp(ValEst))

                        If SDYADIGOGRAVITY(II, j) > 0 Then
                            IGO(II, j) = SIGO(II, j) * ValEst / SDYADIGOGRAVITY(II, j)
                            SDYADIGOGRAVITY(II, j) = ValEst
                            IGO(II, j) = Min(Min(IGO(II, j), SDIPLOIGO(II)), SDIPLOIGO(j)) 'clp 2022/06/12 add min of monadics
                        Else
                            IGO(II, j) = SIGO(II, j)
                            IGO(II, j) = Min(Min(IGO(II, j), SDIPLOIGO(II)), SDIPLOIGO(j)) 'clp 2022/06/12 add min of monadics
                        End If
                    End If

                    'Forecast for Alliance, using average of embassies and treaties
                    'jrs 2022/01/07 keep it constant
                    'If SDIPLOEMBASSY2(II) > 0 AndAlso SDIPLOTREATY2(II) > 0 Then
                    '    ALLIANCE(II, j) = SALLIANCE(II, j) * (SDIPLOEMBASSY(II) / SDIPLOEMBASSY2(II) + SDIPLOTREATY(II) / SDIPLOTREATY2(II)) / 2
                    'ElseIf SDIPLOEMBASSY2(II) > 0 Then
                    '    ALLIANCE(II, j) = SALLIANCE(II, j) * SDIPLOEMBASSY(II) / SDIPLOEMBASSY2(II)
                    'ElseIf SDIPLOTREATY2(II) > 0 Then
                    '    ALLIANCE(II, j) = SALLIANCE(II, j) * SDIPLOTREATY(II) / SDIPLOTREATY2(II)
                    'Else
                    '    ALLIANCE(II, j) = SALLIANCE(II, j)
                    'End If
                    ALLIANCE(II, j) = SALLIANCE(II, j)
                    'Forecast for Treaty
                    If SDIPLOTREATY2(II) > 0 Then
                        TREATY(II, j) = STREATY(II, j) * SDIPLOTREATY(II) / SDIPLOTREATY2(II)
                    Else
                        TREATY(II, j) = STREATY(II, j)
                    End If

                    'jrs 2017/12/01 index #4 is no longer needed here, moved to POP
                    'save values for growth logic
                    For k = 1 To 3
                        SXDYAD2(II, j, k) = XDYAD2(II, j, k)
                    Next k
                    SXDYAD2(II, j, 5) = XDYAD2(II, j, 5)

                    'moved from above to be used in military
                    For k = 0 To NSec
                        SXDYAD(II, j, k) = XDYAD(II, j, k)
                    Next k
                    SIGO(II, j) = IGO(II, j)
                    SALLIANCE(II, j) = ALLIANCE(II, j)
                    STREATY(II, j) = TREATY(II, j)
                Next j
                'jrs 2022/04/20 *** start ***
                If IY > 2 Then
                    Dim diff As Single, tmp As Single, currIdx As Integer, currRank As Integer
                    diff = SDIPLOEMBASSY(II) - SDIPLOEMBASSY2(II)
                    If diff > 0 Then
                        currIdx = NR
                    Else
                        currIdx = 2
                    End If
                    Do While diff <> 0 And currIdx > 0 And currIdx <= NR
                        If diff > 0 Then
                            'need to add more embassies
                            currRank = affinityRank(II, currIdx)
                            tmp = CSng(Amin(1 - SXDYAD2(II, currRank, 5), diff))
                            XDYAD2(II, currRank, 5) = SXDYAD2(II, currRank, 5) + tmp
                            diff = diff - tmp
                            currIdx = currIdx - 1
                        Else
                            'need to remove embassies
                            currRank = affinityRank(II, currIdx)
                            tmp = CSng(Amin(SXDYAD2(II, currRank, 5), -1 * diff))
                            XDYAD2(II, currRank, 5) = SXDYAD2(II, currRank, 5) - tmp
                            diff = diff + tmp
                            currIdx = currIdx + 1
                        End If
                        SXDYAD2(II, currRank, 5) = XDYAD2(II, currRank, 5)
                    Loop
                End If
                'jrs 2022/04/20 *** end ***

            Next II

            'jrs 2017/05/22
            'Save FDI, AID, MIGRANTS
            For II = 1 To NR
                SXFDIFOUT2(II) = XFDIFOUT(II)
                SXFDIFIN2(II) = XFDIFIN(II)
                SAID(II) = AID(II)
                'jrs 2017/12/01 smigrants(II) = MIGRANTS(II)
                SDIPLOEMBASSY2(II) = SDIPLOEMBASSY(II)
                SDIPLOIGO2(II) = SDIPLOIGO(II)
                SDIPLOTREATY2(II) = SDIPLOTREATY(II)
            Next II

            'All but First: Apply Multiplier
            Dim bResum As Boolean
            For II = 1 To NR
                For j = 1 To NR
                    bResum = False
                    For k = 1 To NSec
                        If tradeexportdyadm(II, j, k) <> 1 Then
                            bResum = True
                            XDYAD(II, j, k) = XDYAD(II, j, k) * tradeexportdyadm(II, j, k)
                        End If
                        'jrs 2025/08/12 avoid negatives, caused by tariffs or others
                        XDYAD(II, j, k) = AMAX(XDYAD(II, j, k), 0)
                    Next k
                    If bResum Then
                        XDYAD(II, j, 0) = 0
                        For k = 1 To NSec
                            XDYAD(II, j, 0) = XDYAD(II, j, 0) + XDYAD(II, j, k)
                        Next k
                    End If
                Next j
            Next II

            'jrs 2017/05/08
            'Apply multipliers
            For II = 1 To NR
                For j = 1 To NR
                    'If GRPS(1, II) = "China" And GRPS(1, j) = "Palestine" Then Stop
                    'jrs 2017/12/01 moved #4 to POP
                    '1. Military, 2. FDI, 3. AID, 4. MIgrant, 5. LOR
                    For k = 1 To 3
                        XDYAD2(II, j, k) = XDYAD2(II, j, k) * tradeexportdyadm2(II, j, k)
                        'jrs 2017/11/22 monadic multiplier affects dyadic variable
                        '                        If k = 4 Then
                        '                            XDYAD2(II, j, k) = XDYAD2(II, j, k) * migrateoutm(II)
                        '                            XDYAD2(II, j, k) = XDYAD2(II, j, k) * migrateinm(j)
                        '                        End If
                    Next k
                    'jrs 2022/04/28 added dyadmilmstockadd, xdyadaidadd
                    XDYAD2(II, j, 1) = XDYAD2(II, j, 1) + dyadmilmstockadd(II, j)
                    XDYAD2(II, j, 3) = XDYAD2(II, j, 3) + xdyadaidadd(II, j)
                    'jrs 2022/01/18 added + loradd
                    XDYAD2(II, j, 5) = XDYAD2(II, j, 5) * tradeexportdyadm2(II, j, 5) + loradd(II, j)
                    IGO(II, j) = IGO(II, j) * igom(II, j)
                    'jrs 2022/01/18 added + allianceadd
                    ALLIANCE(II, j) = ALLIANCE(II, j) * alliancem(II, j) + allianceadd(II, j)
                    TREATY(II, j) = TREATY(II, j) * treatym(II, j)
                Next j
            Next II

            'If FirstYear + IY - 1 > 2028 Then Stop
            'All but First: Save to pooled exports/imports variables by sector
            '----------------------------------------
            If bilateraltradeforwardlinksw <> 0 Then
                'Adjust xs
AdjustXSMS()
' ---- Begin Inlined Level 1: AdjustXSMS
' Private Sub AdjustXSMS()
            Dim i As Integer, j As Integer, k As Integer, TotVal As Single
            'Exports
            For i = 1 To NR
                For k = 1 To NSec
                    TotVal = 0
                    For j = 1 To NR
                        TotVal = TotVal + XDYAD(i, j, k)
                    Next j
                    If TotVal > 0 Then 'jrs 2017/01/12
                        XS(i, k) = (1 - bilateraltradeforwardlinksw) * XS(i, k) + bilateraltradeforwardlinksw * TotVal / 1000000000
                    End If
                Next k
            Next i
            'Imports
            For i = 1 To NR
                For k = 1 To NSec
                    TotVal = 0
                    For j = 1 To NR
                        TotVal = TotVal + XDYAD(j, i, k)
                    Next j
                    If TotVal > 0 Then 'jrs 2017/01/12
                        MS(i, k) = (1 - bilateraltradeforwardlinksw) * MS(i, k) + bilateraltradeforwardlinksw * TotVal / 1000000000
                    End If
                Next k
            Next i
' End Sub
' ---- End Inlined Level 1: AdjustXSMS
            End If

            'All but First: Adjust X and M to match data
            '-------------------------------------------
            If bilateraltradeforwardlinksw <> 1 Then
                'jrs 2024/11/25
                For II = 1 To 6
ComputeAdjTrade(II)
' ---- Begin Inlined Level 1: ComputeAdjTrade
' Private Sub ComputeAdjTrade(iSector As Integer)
            Dim i As Integer

            'Imports
            '-------
            For i = 1 To NR
                MSAdj(i, II) = MS(i, II) * m2dimportratioi(i, II)
            Next

            'Exports
            '--------
            For i = 1 To NR
                XSAdj(i, II) = XS(i, II) * m2dexportratioi(i, II)
            Next
' End Sub
' ---- End Inlined Level 1: ComputeAdjTrade
                Next
AdjustXDyadic(context)
' ---- Begin Inlined Level 1: AdjustXDyadic
