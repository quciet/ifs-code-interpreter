            If IY% = 2 Then

                WGDPGrowth = (WGDP - WGDPI) / WGDPI
                If context.HistoricMode Then
                    WFDIGRI = WFDIGR - WGDPGrowth
                Else
                    'bbh 2016/02/17 lks to slks
                    WFDIGRI = (WFDIFLOWS * (1 + WFDIGR) -
                WFDIStock / slks(Manu)) / AMAX(0.001, WFDIStock) - WGDPGrowth
                End If
                'bbh 2016/12/15 end
                'bbh 2017/1/13 end

                '   All but First:  Save 2nd year values for life expectancy (health) gap
                '   ----------------------------------------------------------------------

                'jrs 2024/06/19 TbName$ = "GDP/Capita (PPP) Versus Life Expectancy (2005)"
                Call XYTABL(TFNameLifeExp, WGDP / AMAX(0.001, WPOP), WLIFEXPComp, context)
                WLifExp = 0
                For R% = 1 To NR%
                    WLifExp = WLifExp + SLIFEXP(R%) * POP(R%)
                Next R%
                WLifExp = WLifExp / AMAX(0.001, WPOP)
                WLifExpGapI = WLifExp - WLIFEXPComp 'Year 2 calc only
                'bbh 2013/08/03 Start - bound life expectancy contribution
                SWifExpGap = WLifExpGapI
            End If
            '   All but First:  FDI global adjustment with life expectancy (health)
            '   ------------------------------------------------------------------
            If IY% > 2 Then
                'jrs 2024/06/19 TbName$ = "GDP/Capita (PPP) Versus Life Expectancy (2005)"
                Call XYTABL(TFNameLifeExp, WGDP / AMAX(0.001, WPOP), WLIFEXPComp, context)
                WLifExp = 0
                For R% = 1 To NR%
                    WLifExp = WLifExp + SLIFEXP(R%) * POP(R%)
                Next R%
                WLifExp = WLifExp / AMAX(0.001, WPOP)
                '        WLifExpGap = WLifExp - WLIFEXPComp
                WLifExpGap = Amin(WLifExp - WLIFEXPComp, SWifExpGap + 2)
                'Bound to avoid problems with accelerate life expectancy scenarios
                SWifExpGap = WLifExpGap
                'bbh 2013/08/03 end
                WLifExpTerm = WLifExpGap - WLifExpGapI
            Else
                WLifExpTerm = 0
            End If

            '   All but First:  FDI global stock determination
            '   ----------------------------------------------

            'bbh 2017/1/13 start; putting back multiplier approach option becuase is throughout sce files; so will have multiplier and additive control
            'bbh 2016/12/15 start
            WFDIR = ConvergeOverTime(WFDIGRI, WFDIGR, 20)
            If xfdiwgrm < 0.999 OrElse xfdiwgrm > 1.001 Then 'Makes old and less good multiplier approach default; not ideal, and should only use for
                'existing .sce files with that parameter in them; use xfdiwgradd for all new scenario work on FDI; use of both likely to cause transients
                WFDI = Amin(2 * WGDP, SWFDIRGDP * WGDP * (1 + WFDIR * xfdiwgrm))
            Else
                WFDI = Amin(2 * WGDP, SWFDIRGDP * WGDP * (1 + xfdiwgradd / 100)) ' changed multiplier on growth add to growth add
            End If
            'bbh 2016/12/15 end
            'bbh 2017/1/13 end

            SWFDIRGDP = WFDI / WGDP
            WFDI = WFDI + WLifExpTerm * elfdilifexp * WFDI 'add increment from life expectancy .05
            'but keep outside of compounding loop
            wfdiin = 0
            wfdiout = 0

            '   All but First:  FDI country/region stocks in and out
            '   ----------------------------------------------------
            'jrs 2014/09/16
            Dim fdiratio As Single, XFDICalcConv As Single, fdir As Single, XFDICalcGroRate As Single

            '  If IY% = 4 Then Open PutFdrv$ + "Runfiles\" + "Debug.dat" For Output As #6
            For R% = 1 To NR%
                'jrs 2024/06/12 TbName$ = "GDP/Capita (PPP) Versus FDI Stock Inflows Over GDP (2000)"
                Call XYTABL(TbNameFDIStockInf, GDPPCP(R%), fdiratio, context)

                fdiratio = ConvergeOverTime(SXFDIGDPIn(R%), fdiratio, 100)
                XFDICalcConv = GDPPOT(R%) * fdiratio
                'If RegName$(R%) = "United States of America" And IY% >= 20 Then Stop

                fdir = ConvergeOverTime(sxfdistockr(R%), xfdistockr(R%), 10)
                'Base, Target, Years
                XFDICalcGroRate = sxfdistock(R%) * (1 + fdir / 100) * xfdistockm(R%)
                XFDISTOCK(R%) = (XFDICalcConv + 2 * XFDICalcGroRate) / 3
                'XFDISTOCK(R%) = Amin(XFDISTOCK(R%), 2 * GDPPOT(R%))
                XFDISTOCK(R%) = Amin(XFDISTOCK(R%), 3 * GDPPOT(R%)) 'bbh 2022/09/05 Was binding Hong Kong, Singapore, others and causing fditerm in IGCF calc to oscillate
                wfdiin = wfdiin + XFDISTOCK(R%)
                'If RegName$(R%) = "China" Then Stop

                'jrs 2024/06/12 TbName$ = "GDP/Capita (PPP) Versus FDI Stock Outflows Over GDP (2000)"
                Call XYTABL(TbNameFDIStockOut, GDPPCP(R%), fdiratio, context)
                fdiratio = ConvergeOverTime(SXFDIGDPOUT(R%), fdiratio, 100)
                'If IY = 18 And R = 79 Then Stop
                XFDISTOUT(R%) = GDPPOT(R%) * fdiratio
                fdir = ConvergeOverTime(SXFDISTOUTR(R%), xfdistockr(R%), 10)
                'Base, Target, Years
                XFDISTOUT(R%) = XFDISTOUT(R%) * (1 + fdir / 100) * xfdistoutm(R%)
                'XFDISTOUT(R%) = Amin(XFDISTOUT(R%), 2 * GDPPOT(R%))
                XFDISTOUT(R%) = Amin(XFDISTOUT(R%), 3 * GDPPOT(R%)) 'bbh 2022/09/05 Was binding Hong Kong, Singapore, others and causing fditerm in IGCF calc to oscillate
                'If IY% >= 4 And RegName$(R%) = "Unitd Kingdm" Then Stop
                wfdiout = wfdiout + XFDISTOUT(R%)

                '     If IY% = 4 Then _
                'Print #6, R%, wfdiout, GDPPCP(R%), fdiratio, GDPPOT(R%), RegName$(R%)
            Next R%

            ' If IY% = 4 Then Close #6

            For R% = 1 To NR%
                XFDISTOCK(R%) = XFDISTOCK(R%) / wfdiin * WFDI
                'If RegName$(R%) = "Azerbaijan" Then Stop
                XFDISTOUT(R%) = XFDISTOUT(R%) / wfdiout * WFDI
                'If IY% >= 4 And RegName$(R%) = "Unitd Kingdm" Then Stop
                '        SXFDIGDPIn(R%) = XFDISTOCK(R%) / AMAX(0.001, GDP(R%))
            Next R%
            '   All but First:  FDI country/region flows in and out - initial
            '   -------------------------------------------------------------
            'jrs 2014/09/16
            Dim DepreciatedStockIn As Single, DepreciatedStockOut As Single

            For R% = 1 To NR%
                'mti June 2010 - run to run historical -start
                DepreciatedStockIn = sxfdistock(R%) - sxfdistock(R%) / slks(Manu)
                DepreciatedStockOut = sxfdistout(R%) - sxfdistout(R%) / slks(Manu)
                'mti June 2010 - run to run historical - end
                XFDIFIN(R%) = AMAX(sxfdistock(R%) * 0.01, XFDISTOCK(R%) - DepreciatedStockIn)

                'If RegName$(R%) = "China" Then Stop
                'If IY = 18 And GRPS(1, R) = "Israel" Then Stop
                XFDIFOUT(R%) = AMAX(sxfdistout(R%) * 0.01, XFDISTOUT(R%) - DepreciatedStockOut)
            Next R%

            '   All but First:  FDI country/region flows in and out - life expect (health adjust)
            '   ---------------------------------------------------------------------------------
            'jrs 2014/09/16
            Dim WSumXFDIFIN As Single, WSumXFDIFINPReAdj As Single, WSumXFDIFOUT As Single, lifexpcomp As Single, lifexpterm As Single, lifexpgap As Single
            Dim FDIAdjFac As Single

            WSumXFDIFIN = 0
            WSumXFDIFINPReAdj = 0
            WSumXFDIFOUT = 0
            For R% = 1 To NR%
                'jrs 2024/06/19 TbName$ = "GDP/Capita (PPP) Versus Life Expectancy (2005)"
                Call XYTABL(TFNameLifeExp, GDP(R%) / AMAX(0.001, POP(R%)), lifexpcomp, context)
                If IY% = 2 Then
                    lifexpgapinti(R%) = SLIFEXP(R%) - lifexpcomp
                    lifexpterm = 0
                    'bbh 2013/08/03 start; bound life expectancy gap growth from SENS scenarios
                    SLifExpGapInt(R%) = lifexpgapinti(R%)
                Else
                    'LifExpGap = SLIFEXP(R%) - lifexpcomp
                    lifexpgap = Amin(SLIFEXP(R%) - lifexpcomp, SLifExpGapInt(R%) + 2)
                    'If RegName$(R%) = "Angola" Then Stop
                    SLifExpGapInt(R%) = lifexpgap
                End If
                'bbh 2013/08/03 end

                WSumXFDIFINPReAdj = WSumXFDIFINPReAdj + XFDIFIN(R%)
                FDIAdjFac = CSng(Amin(0.5, AMAX(-0.5, lifexpterm * 0.05)))
                'have cut parameter back from .09 in empirical analysis; compound
                'effects in dynamic analysis with stock change
                'bbh 2019/03/15 1 line changed, 1 added
                'XFDIFIN(R%) = XFDIFIN(R%) + FDIAdjFac * XFDIFIN(R%)
                XFDIFIN(R%) = (XFDIFIN(R%) + FDIAdjFac * XFDIFIN(R%)) * xfdifinm(R%)
                XFDIFOUT(R%) = XFDIFOUT(R%) * xfdifoutm(R%)
                'If RegName$(R%) = "China" And IY% = 35 Then Stop
                WSumXFDIFIN = WSumXFDIFIN + XFDIFIN(R%)
                WSumXFDIFOUT = WSumXFDIFOUT + XFDIFOUT(R%)
            Next R%
            'If IY% >= 34 Then Stop
            For R% = 1 To NR%
                XFDIFIN(R%) = XFDIFIN(R%) * WSumXFDIFINPReAdj / WSumXFDIFIN
                'If RegName$(R%) = "China" Then Stop
                XFDIFOUT(R%) = XFDIFOUT(R%) * WSumXFDIFINPReAdj / WSumXFDIFOUT
                'If RegName$(R%) = "China" And IY% >= 34 Then Stop
            Next R%
            '   All but First:  FDI country/region stocks recomputed with flow adjustments
            '   --------------------------------------------------------------------------
            'jrs 2014/09/16
            Dim WStockIn As Single, WStockOut As Single

            WStockIn = 0
            WStockOut = 0
            For R% = 1 To NR%
                'bbh 2016/02/17 2 lines lks to slks
                XFDISTOCK(R%) = sxfdistock(R%) + XFDIFIN(R%) - sxfdistock(R%) / slks(Manu)
                XFDISTOUT(R%) = sxfdistout(R%) + XFDIFOUT(R%) - sxfdistout(R%) / slks(Manu)
                'If IY% >= 4 And RegName$(R%) = "Unitd Kingdm" Then Stop
                WSumXFDIFINPReAdj = WSumXFDIFINPReAdj + XFDIFIN(R%)
                'If RegName$(R%) = "China" And IY% >= 34 Then Stop
                WStockIn = WStockIn + XFDISTOCK(R%)
                WStockOut = WStockOut + XFDISTOUT(R%)
            Next R%
            'Stop
            For R% = 1 To NR%
                XFDISTOCK(R%) = XFDISTOCK(R%) / WStockIn * WFDI
                XFDISTOUT(R%) = XFDISTOUT(R%) / WStockOut * WFDI
                'If IY% >= 4 And RegName$(R%) = "Unitd Kingdm" Then Stop
                WSumXFDIFINPReAdj = WSumXFDIFINPReAdj + XFDIFIN(R%)
                'If RegName$(R%) = "China" And IY% >= 34 Then Stop
                sxfdistock(R%) = XFDISTOCK(R%)
                sxfdistout(R%) = XFDISTOUT(R%)
            Next R%
            '   All but First:  Portfolio Investment (Bonds and Equity)
            '   ------------------------------------------------------
            'jrs 2014/09/16
            Dim WPORTFOLIOR As Single, WPortfolioIn As Single, WPortfolioOut As Single, PortfolioRatio As Single, PortfolioR As Single

            'bbh 2011/11/12
            'WPORTFOLIOR = ConvergeOverTime(0.1, 0.005, 10)
            WPORTFOLIOR = ConvergeOverTime(PortGRI, 0.005, 10)
            If IY% < 10 Then
                WPortfolio = CSng(Amin(0.5 * WGDP, SWPortfolioRGDP * WGDP * (1 + WPORTFOLIOR * xportwgrm)))
                SWPortfolioRGDP = WPortfolio / WGDP
            Else
                WPortfolio = CSng(Amin(0.5 * WGDP, SWPortfolioRGDP * WGDP * (1 + 0.005 * xportwgrm)))
                SWPortfolioRGDP = WPortfolio / WGDP
            End If
            WPortfolioIn = 0
            WPortfolioOut = 0

            For R% = 1 To NR%
                'If RegName$(R%) = "Iceland" And IY% >= 79 Then Stop
                If XPortfolioI(R%) > 0 Then
                    TbName$ = "GDP/Capita (PPP) Versus Portfolio Stock Inflows Over GDP (2000)"
                    Call XYTABL(TbName$, GDPPCP(R%), PortfolioRatio, context)
                    PortfolioRatio = ConvergeOverTime(SXPortGDPIn(R%), PortfolioRatio, 100)
                    XPORTFOLIO(R%) = GDPPOT(R%) * PortfolioRatio
                    'If RegName$(R%) = "Luxembourg" Then Stop
                    PortfolioR = ConvergeOverTime(SXPortfolioR(R%), xportr(R%), 10)
                    'Base, Target, Years
                    XPORTFOLIO(R%) = XPORTFOLIO(R%) * (1 + PortfolioR / 100) * xportfoliom(R%)
                    XPORTFOLIO(R%) = CSng(Amin(XPORTFOLIO(R%), 0.5 * GDPPOT(R%)))
                Else 'Data do not include portfolio investment across developed countries, so
                    'leave it out here to avoid big transients; unfortunate
                    XPORTFOLIO(R%) = 0
                End If
                WPortfolioIn = WPortfolioIn + XPORTFOLIO(R%)

                TbName$ = "GDP/Capita (PPP) Versus Portfolio Stock Outflows Over GDP (2000)"
                Call XYTABL(TbName$, GDPPCP(R%), PortfolioRatio, context)
                PortfolioRatio = ConvergeOverTime(SXPortGDPOUT(R%), PortfolioRatio, 100)
                XPORTSTOUT(R%) = GDPPOT(R%) * PortfolioRatio
                PortfolioR = ConvergeOverTime(SXPORTSTOUTR(R%), xportr(R%), 10)
                'Base, Target, Years
                XPORTSTOUT(R%) = XPORTSTOUT(R%) * (1 + PortfolioR / 100) * xportstoutm(R%)
                XPORTSTOUT(R%) = CSng(Amin(XPORTSTOUT(R%), 0.5 * GDPPOT(R%)))
                WPortfolioOut = WPortfolioOut + XPORTSTOUT(R%)
                'If RegName$(R%) = "Iceland" And IY% >= 79 Then Stop
            Next R%

            For R% = 1 To NR%
                'If RegName$(R%) = "Iceland" And IY% >= 79 Then Stop
                XPORTFOLIO(R%) = XPORTFOLIO(R%) / AMAX(0.001, WPortfolioIn) * WPortfolio
                XPORTSTOUT(R%) = XPORTSTOUT(R%) / AMAX(0.001, WPortfolioOut) * WPortfolio
                XPORTFIN(R%) = XPORTFOLIO(R%) - SXPortfolio(R%)
                'If RegName$(R%) = "Luxembourg" Then Stop
                'If RegName$(R%) = "Iceland" And IY% >= 79 Then Stop
                XPORTFOUT(R%) = XPORTSTOUT(R%) - SXPORTSTOUT(R%)
                SXPortfolio(R%) = XPORTFOLIO(R%)
                SXPORTSTOUT(R%) = XPORTSTOUT(R%)
                'If RegName$(R%) = "Iceland" And IY% >= 79 Then Stop
            Next R%
            '   All but First:  IMF Capitalizations
            '   -----------------------------------
            'jrs 2014/09/16
            Dim TotalIMFRepayPlusSub As Single, TotalIMFLending As Single, XIMFCRRepayTot As Single, XIMFCRNewTot As Single, XIMFNewSubTot As Single
            'Dim simfcrintr As Single
            Dim MaxSub As Single

            '    XIMFCREDITTOT = SXIMFCREDITTOT * (1 + ximfcreditr / 100)
            XIMFCREDITTOT = SXIMFCREDITTOT
            '    SXIMFCREDITTOT = XIMFCREDITTOT
            TotalIMFRepayPlusSub = 0
            TotalIMFLending = 0
            XIMFCRRepayTot = 0
            XIMFCRNewTot = 0
            XIMFNewSubTot = 0

            For R% = 1 To NR%

                '   All but First:  IMF Credits
                '   ---------------------------

                'If SXIMFCREDIT(R%) > 0 Then 'borrowers, credit users 'bbh 2020/08/15
                If XIMFCREDITI(R%) > -0.0001 Then  'borrowers, credit users  'bbh 2020/08/15 use of SXWBLOANS caused oscillation
                    '           XIMFCRFOUT(R%) = SXIMFCREDIT(R%) * simfcrintr / 100 _
                    ' + SXIMFCREDIT(R%) / AMAX(1, ximfcrrepr)
                    XIMFCRFOUT(R%) = SXIMFCREDIT(R%) * ximfcrintr / 100 _
                    + SXIMFCREDIT(R%) / AMAX(1, ximfcrrepr) 'bbh 2020/08/15 Corrected simfcrintr to ximfcrintr

                    '                                CXIMFCRFOUT(ICount%) = (CXIMFCREDIT(ICount%) * sximfcrintr / 100 _
                    '                    + CXIMFCREDIT(ICount%) / AMAX(1, sximfcrrepr))

                    'repayments, principal plus interest, as in preprocessor
                    XIMFCRRepayTot = XIMFCRRepayTot + XIMFCRFOUT(R%)
                Else 'subscriber, contributor
                    'XIMFCRFOUT(R%) = SXIMFCREDITTOT * ximfcreditr / 100 _
                    '* XIMFCREDITSUBI(R%) / XIMFCREDITTOTI
                    MaxSub = 0.001! * GDPPOT(R%)
                    XIMFSUBF(R%) = Amin(MaxSub, SXIMFSUBF(R%) * (1 + ximfcreditr / 100))
                    SXIMFSUBF(R%) = XIMFSUBF(R%)
                    XIMFNewSubTot = XIMFNewSubTot + XIMFSUBF(R%)
                End If
                'TotalIMFRepayPlusSub = TotalIMFRepayPlusSub + XIMFCRFOUT(R%)

            Next R%

            '    TotalIMFAvailAssets = TotalIMFRepayPlusSub
            '    TotalIMFCredits = 0
            '    For R% = 1 To NR%
            '        XIMFCRFIN(R%) = TotalIMFAvailAssets * (XIMFCRFINI(R%) / AMAX(0.001, XIMFFLOWSINTOTI)) _
            '            * ximfcrfinm(R%)
            '        TotalIMFCredits = TotalIMFCredits + XIMFCRFIN(R%)
            '        XIMFCREDIT(R%) = SXIMFCREDIT(R%) + XIMFCRFIN(R%) - XIMFCRFOUT(R%)
            '        SXIMFCREDIT(R%) = XIMFCREDIT(R%)
            '    Next R%
            '    For R% = 1 To NR%
            '        XIMFCRFIN(R%) = XIMFCRFIN(R%) * TotalIMFAvailAssets / AMAX(0.001, TotalIMFCredits)
            '    Next R%

            For R% = 1 To NR%
                XIMFCRFIN(R%) = XIMFFLOWSINTOTI * XIMFCREDITTOT / XIMFCREDITTOTI _
            * (XIMFCRFINI(R%) / AMAX(0.001, XIMFFLOWSINTOTI))
                XIMFCRNewTot = XIMFCRNewTot + XIMFCRFIN(R%)
            Next R%
            SXIMFCREDITTOT = XIMFCREDITTOT + XIMFCRRepayTot - XIMFCRNewTot + XIMFNewSubTot * ximfcreqr
            '   All but First:  Adjust IMF Lending Pattern by Agent Predictions
            '   ---------------------------------------------------------------
            'jrs 2014/09/16
            Dim XIMFCRCompTot As Single

            XIMFCRCompTot = 0
            For R% = 1 To NR%
                XIMFCRFIN(R%) = IMFCREDITPI(R%) / 100 * GDPPOT(R%) * ximfcrfinm(R%)
                'Replace this with WB-like estimate
                'Tie to solvency/liquidity
                'Increase to one country comes from other countries
                XIMFCRCompTot = XIMFCRCompTot + XIMFCRFIN(R%)
            Next R%
            For R% = 1 To NR%
                XIMFCRFIN(R%) = XIMFCRFIN(R%) * XIMFCRNewTot / AMAX(0.001, XIMFCRCompTot)
                SXIMFCRFIN(R%) = XIMFCRFIN(R%)
                XIMFCREDIT(R%) = SXIMFCREDIT(R%) + XIMFCRFIN(R%) - XIMFCRFOUT(R%) - XIMFSUBF(R%)
                SXIMFCREDIT(R%) = XIMFCREDIT(R%)
            Next R%

            '   All but First:  WB Capitalizations
            '   -----------------------------------
            'jrs 2014/09/16
            Dim TotalWBRepayPlusSub As Single, TotalWBLending As Single, xwblnrepaytot As Single, xwblnnewtot As Single, xwbnewsubtot As Single

            XWBLOANSTOT = sxwbloanstot '* (1 + xwbloanr / 100)
            TotalWBRepayPlusSub = 0
            TotalWBLending = 0

            xwblnrepaytot = 0
            xwblnnewtot = 0
            xwbnewsubtot = 0

            '   All but First:  WB Loans
            '   ------------------------

            For R% = 1 To NR%
                'If SXWBLOANS(R%) > 0 Then 'borrowers, credit users 'bbh 2020/08/15
                If XWBLOANSI(R%) > -0.0001 Then 'borrowers, credit users 'bbh 2020/08/15 use of SXWBLOANS caused oscillation
                    XWBLNFOUT(R%) = SXWBLOANS(R%) * xwblnintr / 100 _
                + SXWBLOANS(R%) / AMAX(1, xwblnrepr)
                    xwblnrepaytot = xwblnrepaytot + XWBLNFOUT(R%)
                    'repayments, principal plus interest, as in preprocessor
                Else 'subscriber, contributor
                    MaxSub = 0.001! * GDPPOT(R%)
                    XWBSUBF(R%) = Amin(MaxSub, SXWBSUBF(R%) * (1 + xwbloanr / 100))
                    SXWBSUBF(R%) = XWBSUBF(R%)
                    xwbnewsubtot = xwbnewsubtot + XWBSUBF(R%)
                    XWBLNFOUT(R%) = XWBLNFOUTI(R%) 'bbh 2020/08/15 ; value should be 0 as set for subscribers in preprocessor
                End If
            Next R%
            '    XWBNewLoanCap = xwblnrepaytot + xwbnewsubtot 'Should subtract out admin

            For R% = 1 To NR%
                '        XWBLNFIN(R%) = XWBFLOWSINTOTI * XWBLOANSTOT / XWBLOANSTOTI _
                '            * (XWBLNFINI(R%) / AMAX(0.001, XWBFLOWSINTOTI))
                XWBLNFIN(R%) = wbloansrgdpi(R%) / 100 * GDPPOT(R%)
                '        xwblnnewtot = xwblnnewtot + XWBLNFIN(R%)
                'If RegName$(R%) = "Angola" Then Stop
            Next R%
            xwblnnewtot = XWBFLOWSINTOTI * XWBLOANSTOT / XWBLOANSTOTI
            sxwbloanstot = XWBLOANSTOT + xwblnrepaytot - xwblnnewtot + xwbnewsubtot * xwblneqr
            '     All but First:  Adjust WB Lending Pattern by Agent Predictions
            '     --------------------------------------------------------------
            'jrs 2014/09/16
            Dim xwblncomptot As Single

            xwblncomptot = 0
            Dim Prediction = 0!
            For R% = 1 To NR%
                aidpergdp(R%) = AMAX(0, AID(R%) / GDPPOT(R%) * 100)
                Call AnalFunc("World Bank Loans as % of Recipient GDP",
            New Single() {GDPPCP(R%), GINIDOM(R%), aidpergdp(R%)}, Prediction,
            New String() {"GDPPCP", "GINIDOM", "AIDPERGDP"}, context) 'jrs 2014/10/09 added DepVar Names to check order
                Prediction = AMAX(0#, Amin(10, Prediction))
                If wbloanspi(R%) > 0 Then
                    XWBLNFIN(R%) = XWBLNFIN(R%) * Prediction / wbloanspi(R%) * xwblnfinm(R%)
                    'Multiplier will increase loans to one country at expense of others
                    '   If want to increase WB loans overall look to xwbloanr
                End If
                xwblncomptot = xwblncomptot + XWBLNFIN(R%)
                'If R% <= 4 Then Stop
                'If RegName$(R%) = "Angola" Then Stop
            Next R%
            For R% = 1 To NR%
                XWBLNFIN(R%) = XWBLNFIN(R%) / AMAX(0.001, xwblncomptot) * xwblnnewtot
                XWBLOANS(R%) = SXWBLOANS(R%) + XWBLNFIN(R%) - XWBLNFOUT(R%) - XWBSUBF(R%)
                'If XWBLOANS(R%) > 0 And R = 179 Then Stop
                SXWBLOANS(R%) = XWBLOANS(R%)
                'If RegName$(R%) = "Angola" Then Stop
            Next R%

            '   All but First:  WB Flows by Target Without Recipient Country (same code in 1st step)
            '   ------------------------------------------------------------------------------------
            For R% = 1 To NR%
                Dim SumFlows = 0!
                For ft% = 1 To NWBTar%
                    XWBFLOWS(R%, ft%) = XWBLNFIN(R%) * xwbsectar(ft%) / 100 * sxwbflowsr(R%, ft%)
                    SumFlows = SumFlows + XWBFLOWS(R%, ft%)
                Next ft%
                If SumFlows > 0.01 Then
                    For ft% = 1 To NWBTar%
                        XWBFLOWS(R%, ft%) = XWBFLOWS(R%, ft%) * XWBLNFIN(R%) / SumFlows
                    Next ft%
                End If
                'If RegName$(R%) = "Angola" Then Stop
            Next R%

            'bbh 2020/03/09 start - replaced commmented out code with subroutine
            '   All but First:  Worker Remittances
            '   ----------------------------------

Call RemittancesAllbutFirstYear(NR%)
' ---- Begin Inlined Level 1: RemittancesAllbutFirstYear
' Sub RemittancesAllbutFirstYear(NR%)

            GloSumRemitIn = 0
            GloSumRemitOut = 0
            For R% = 1 To NR%% 'As GDPPC rises, remittances per worker rise, both directions
                'XWORKREMITOUT(R%) = POPFOREIGNIN(R%) * RemitPerWorkerOut(R%) * GDPPC(R%)
                'XWORKREMITIN(R%) = POPFOREIGNOUT(R%) * RemitPerWorkerIn(R%) * GDPPC(R%)
