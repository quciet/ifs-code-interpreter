                        '                MBase = smkav(r%, S%) * IDBase(r%, S%) + _
                        '                    smkav(r%, S%) * elasminc(r%) * (DBASE - IDBase(r%, S%))

                        '                mbase = smkav(R%, S%) * smoothdbase(R%, S%) + _
