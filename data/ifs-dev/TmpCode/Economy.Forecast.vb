            Dim SUM1 As Single, Sum2 As Single, SVADDGR As Single, NonPrimVadd As Single, KGroComp As Single, lfgr As Single, kdrate As Single 'jrs 2021/08/16 MinPCGr As Single, 
            Dim ProductivityImpBase As Single, ProductivityImports As Single, M_Base As Single, s2 As Integer

            'jrs 2021/08/02
            Dim igdprbase(,) As Single
            ReDim igdprbase(1, NR)

            For R% = 1 To NR%
                SUM1 = 0#
                Sum2 = 0#

                For S% = 1 To NSec%
                    SUM1 = SUM1 + CDALF(R%) * VADD(R%, S%)
                    Sum2 = Sum2 + salpha(S%) * VADD(R%, S%)
                Next S%

                For S% = 1 To NSec%
                    alphas(R%, S%) = SUM1 / Sum2 * salpha(S%)
                    alphas(R%, S%) = AMAX(0, Amin(alphas(R%, S%), 1))
                    salphas(R%, S%) = alphas(R%, S%) / CDALF(R%)
                Next S%
                'If RegName$(R%) = "Chad" Then Stop

