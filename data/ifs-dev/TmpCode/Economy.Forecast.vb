            Next II
            'jrs 2019/09/20 *** Trade Complementary Index end ***

            'jrs 2019/09/26
            'total for TCI and Tariffs
            For II = 1 To NR
                For j = 1 To NR
                    DYADTRADECOMPLEMENT(II, j, 0) = 0
                    DYADTARIFFRATE(II, j, 0) = 0
                    For k = 1 To 6
