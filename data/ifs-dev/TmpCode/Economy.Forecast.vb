                    ICTCYBEVTCOST(R%) = ICTCYBEVTCOST(R%) * ictcybevtcostm(R%, evt%)
                Next evt%

                ICTCYBEVTCOST(R%) = AMAX(0.01, (ICTCYBEVTCOST(R%) * CostChangeFac - ICTCybEvtScale)) '* ictcybevtcostm(R%))

                'mti 2015/06/09 - end


                ICTCYBRISKTOT(R%) = ICTCYBSECSPEND(R%) + ICTCYBEVTCOST(R%) + ICTCYBOPCOST(R%)

                'mti 2015/05/13 - start

                'bbh 2015/05/17 begin
                'ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) + (((1 + ICTCYBBENTOT(R%) / 100) ^ IY - 1) _
                '+ ((1 + ICTCONSURPLUS(R%) / 100) ^ IY - 1)) * GDP(R%)
                If IY = 1 Then
                    sICTCYBBENTOTCUM(R%) = 0
                    GDPICyb(R%) = GDP(R%)
                    ICTGrowthCumCompound(R%) = 1 + ICTCYBBENEFIT(R%) / 100
                    ICTSurplusCumCompound(R%) = 1 + ICTCONSURPLUS(R%) / 100
                Else
                    ICTGrowthCumCompound(R%) = ICTGrowthCumCompound(R%) * (1 + ICTCYBBENEFIT(R%) / 100)
                    ICTSurplusCumCompound(R%) = ICTSurplusCumCompound(R%) * (1 + ICTCONSURPLUS(R%) / 100)
                End If
                'ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) + (((1 + ICTCYBBENTOT(R%) / 100) ^ IY - 1) _
                '+ ((1 + ICTCONSURPLUS(R%) / 100) ^ IY - 1)) * GDP(R%)
                'ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) + _
                '((ICTCYBBENEFIT(R%) / 100) * ((1 + (ICTCYBBENEFIT(R%) / 100)) ^ IY) + _
                '(ICTCONSURPLUS(R%) / 100) * ((1 + (ICTCONSURPLUS(R%) / 100)) ^ IY)) * GDP(R%)

                'If RegName(R%) = "United States Of America" Then Stop

                ICTCYBBENTOTCUM(R%) = sICTCYBBENTOTCUM(R%) +
            ((ICTGrowthCumCompound(R%) - 1) + (ICTSurplusCumCompound(R%) - 1)) * GDPICyb(R%)
                'bbh 2015/05/17 end

                ICTCYBRISKTOTCUM(R%) = sICTCYBRISKTOTCUM(R%) + ICTCYBRISKTOT(R%) * GDP(R%) / 100

                'mti 2015/05/13 - end

                'mti 2015/06/01 - start
                ICTCYBBENEFITNET(R%) = ICTCYBBENTOT(R%) - ICTCYBRISKTOT(R%)
                ICTCYBBENEFITCUMNET(R%) = ICTCYBBENTOTCUM(R%) - ICTCYBRISKTOTCUM(R%)

                'mti 2015/06/01 - end

                sICTCYBBENTOTCUM(R%) = ICTCYBBENTOTCUM(R%)
                sICTCYBRISKTOTCUM(R%) = ICTCYBRISKTOTCUM(R%)
                'mti 2015/05/06 - end

