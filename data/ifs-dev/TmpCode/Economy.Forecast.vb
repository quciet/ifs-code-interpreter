                        'less than half a percent poverty in either group consisdered as equal poverty
                        PovGndRatioVec(R%%, j%) = AMAX(0.005, POVRATE420(R%%, j%, Female)) / AMAX(0.005, POVRATE420(R%%, j%, Male)) '0.001
                        '                If PovGndRatioVec(R%%, j%) > 15 Then Stop
    
                        '            End If
                        'mti 2020/03/18 End
                    End If
                Next j%
    
    
                'mti 2020/03/25 Start
                If POVCOUNT420(R%%, TotPovAGCount, Total) = 0 Then
                    POVCOUNT420(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT420(R%%, TotPovAGCount, Female) = 0
                    POVRATE420(R%%, TotPovAGCount, Male) = 0
