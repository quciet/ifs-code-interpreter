                    'Debug.Print j%
                    If POVCOUNT55(R%%, j%, Total) = 0 Or (POVRATE55(R%%, j%, Male) = 0 And POVRATE55(R%%, j%, Female) = 0) Then
                        POVCOUNT55(R%%, j%, Male) = 0
                        POVCOUNT55(R%%, j%, Female) = 0
                        POVRATE55(R%%, j%, Male) = 0
                        POVRATE55(R%%, j%, Female) = 0
                        PovGndRatioVec(R%%, j%) = 1
    
                    Else
                        'Get headcounts by gender using rates and population by gender
                        POVCOUNT55(R%%, j%, Female) = POVRATE55(R%%, j%, Female) * POPPOVAG(R%%, j%, Female) / 100
                        POVCOUNT55(R%%, j%, Male) = POVRATE55(R%%, j%, Male) * POPPOVAG(R%%, j%, Male) / 100
    
                        'Compute normalization factor
                        'mti 2020/03/18 start
                        'NormFac = POVCOUNT55(R%%, j%, Total) / AMAX(0.0001, (POVCOUNT55(R%%, j%, Male) + POVCOUNT55(R%%, j%, Female)))
                        NormFac = POVCOUNT55(R%%, j%, Total) / AMAX(0.000001, (POVCOUNT55(R%%, j%, Male) + POVCOUNT55(R%%, j%, Female)))
    
    
                        'Normalize headcounts
                        'mti 2021/07/15 start
                        POVCOUNT55(R%%, j%, Female) = CSng(Amin(POPPOVAG(R%%, j%, Female), Round(POVCOUNT55(R%%, j%, Female) * NormFac, 6)))
                        POVCOUNT55(R%%, j%, Male) = CSng(Amin(POPPOVAG(R%%, j%, Male), AMAX(0, Round(POVCOUNT55(R%%, j%, Total) - POVCOUNT55(R%%, j%, Female), 6))))
    
                        'Just in case male had to be bounded at 100; give all of the remainder to female
                        POVCOUNT55(R%%, j%, Female) = CSng(AMAX(0, Round(POVCOUNT55(R%%, j%, Total) - POVCOUNT55(R%%, j%, Male), 6)))
                        'mti 2021/07/15 end
    
                        '            POVCOUNT55(R%%, j%, Male) = Round(POVCOUNT55(R%%, j%, Male) * NormFac, 6)
                        '            POVCOUNT55(R%%, j%, Female) = AMAX(0, Round(POVCOUNT55(R%%, j%, Total) - POVCOUNT55(R%%, j%, Male), 6))
    
    
    
                        'recompute (normalized) rates by gender
                        POVRATE55(R%%, j%, Female) = 100 * POVCOUNT55(R%%, j%, Female) / AMAX(0.000001, POPPOVAG(R%%, j%, Female))
                        POVRATE55(R%%, j%, Male) = 100 * POVCOUNT55(R%%, j%, Male) / AMAX(0.000001, POPPOVAG(R%%, j%, Male))
    
                        'Compute gender ratio
                        '            If POVRATE55(R%%, j%, Female) = 0 Or POVRATE55(R%%, j%, Male) = 0 Then
                        '                PovGndRatioVec(R%%, j%) = 1
                        '            Else
    
                        'PovGndRatioVec(R%%, j%) = POVRATE55(R%%, j%, Female) / POVRATE55(R%%, j%, Male)  '0.001
                        'less than half a percent poverty in either group consisdered as equal poverty
                        PovGndRatioVec(R%%, j%) = AMAX(0.005, POVRATE55(R%%, j%, Female)) / AMAX(0.005, POVRATE55(R%%, j%, Male)) '0.001
                        '                If PovGndRatioVec(R%%, j%) > 15 Then Stop
    
                        '            End If
                        'mti 2020/03/18 End
                    End If
                Next j%
    
    
                'mti 2020/03/25 Start
                If POVCOUNT55(R%%, TotPovAGCount, Total) = 0 Then
                    POVCOUNT55(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT55(R%%, TotPovAGCount, Female) = 0
                    POVRATE55(R%%, TotPovAGCount, Male) = 0
                    POVRATE55(R%%, TotPovAGCount, Female) = 0
                    PovGndRatioVec(R%%, TotPovAGCount) = 1
                Else
                    'If RegName(R%%) = "India" Then Stop
                    POVCOUNT55(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT55(R%%, TotPovAGCount, Female) = 0
                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNT55(R%%, TotPovAGCount, Male) = POVCOUNT55(R%%, TotPovAGCount, Male) + POVCOUNT55(R%%, j%, Male)
                        POVCOUNT55(R%%, TotPovAGCount, Female) = POVCOUNT55(R%%, TotPovAGCount, Female) + POVCOUNT55(R%%, j%, Female)
                    Next j%
    
    
    
