                '    hhdispinc(R%, Unskilled) = HHINC(R%, Unskilled) _
                '- HHTAX(R%, Unskilled) - HHGOVSS(R%, Unskilled)
                '    hhdispinc(R%, Skilled) = HHINC(R%, Skilled) _
