                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNT420(R%%, TotPovAGCount, Male) = POVCOUNT420(R%%, TotPovAGCount, Male) + POVCOUNT420(R%%, j%, Male)
                        POVCOUNT420(R%%, TotPovAGCount, Female) = POVCOUNT420(R%%, TotPovAGCount, Female) + POVCOUNT420(R%%, j%, Female)
                    Next j%
    
    
    
                    POVRATE420(R%%, TotPovAGCount, Male) = 100 * POVCOUNT420(R%%, TotPovAGCount, Male) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Male))
                    POVRATE420(R%%, TotPovAGCount, Female) = 100 * POVCOUNT420(R%%, TotPovAGCount, Female) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Female))
                    PovGndRatioVec(R%%, TotPovAGCount) = AMAX(0.005, POVRATE420(R%%, TotPovAGCount, Female)) / AMAX(0.005, POVRATE420(R%%, TotPovAGCount, Male)) '0.001
