                'bbh 2020/07/31 end

                '        INTR(R%) = LongTermIntr(R%) * RDStocks / AMAX(0.3 * RDStocks, RSt)

                '   All but First 4, 5:  Adjust I and INVS by Change in Stocks
                '       - changes meaning from gross capital formation to total investment,
                '           with addition of changes in stocks
                '       - recompute stocks in
                '           physical models so as to preserve accounting balances
                '   -------------------------------------------------------------
                'bbh 2021/07/07 start
                'oldstocks = 0
                'newstocks = 0
                suminvs = 0 'bbh 2022/12/20 This variable could be removed from code, not ever used after computation below
                DeltaStocks = 0
                For S% = 1 To NSec%
                    'If RegName$(R%) = "Angola" Then Stop
                    suminvs = suminvs + INVS(R%, S%)
                    '            If ((S% > Ener) Or (S% = Agri And agon < 0.9) Or _
                    '(S% = Ener And enon < 0.9)) Then 'bbh 2022/12/13  Also tried commenting out the If and End If statements here so that ag and energy stocks also would be PDF based
                    'Same problems recognized as when do that around price and Excess Stock logic; Ag stocks for some countries huge and cause bad Excess Stock behavior
                    'But:  Using PFD logic for stocks in Econ model rather than taking from Ag model greatly improves behavior of S (foreign and domestic) - I should equal 0.0
                    'bbh 2022/12/20 Again using all 6 sectors, but only for computation of I from IGCF - make sure that the IFs stdatement just above is commented out
                    'DStocks = CS(R%, S%) + INVS(R%, S%) + GS(R%, S%) + XS(R%, S%)
                    'DStocks = PFD(R%, S%) + MS(R%, S%) - DStocks
                    'DeltaStocks = DeltaStocks + DStocks
                    st_red = CS(R%, S%) + INVS(R%, S%) + GS(R%, S%) + XS(R%, S%)
                    'recomputed = sstphys(R%, S%) + PFD(R%, S%) + MS(R%, S%) - st_red
                    'oldstocks = oldstocks + sstphys(R%, S%)
                    'newstocks = newstocks + recomputed
                    'sstphys(R%, S%) = recomputed
                    'suminvs = suminvs + INVS(R%, S%)
                    DeltaStocks = DeltaStocks + PFD(R%, S%) + MS(R%, S%) - st_red
                    'If RegName$(R%) = "United States Of America" And IY% >= 45 Then Stop  'bbh 2021/07/07
                    'Development note:  The stocks computed here for ag and en are very
                    'different than those coming from the physcial models; they are
                    'residuals only for the purpose of balancing expenditure components;
                    'remember that PFD has no counterpart in the ag/en models
                    'End If 'bbh 2022/12/13 'bbh 2022/12/20 Again exploring using all 6 sectors, but only for computation of I from IGC
                Next S%
                'i(R%) = IGCF(R%) + newstocks - oldstocks
                I(R%) = IGCF(R%) + DeltaStocks 'bbh 2021/07/07 end
                'jrs 2023/10/23
                If ifsexomodelid > 0 Then
                    ReplaceVarWithExogenousForecastxReg("I", "", "", CStr(FirstYear + IY - 1), R%, context)
                End If
                SI(R%) = I(R%)

                'I(R%) = IGCF(R%) + DeltaStocks

                'If RegName$(R%) = "Angola" Then Stop

                'bbh 2020/08/03 start  INVS already computed in IFsEcoSam from IGCF and should Not be adjusted by change in stocks
                '        StockChng = newstocks - oldstocks
                '        For S% = 1 To NSec%
                '            INVS(R%, S%) = INVS(R%, S%) + StockChng * INVS(R%, S%) / AMAX(0.001, suminvs)
                'If RegName$(R%) = "Central AfR" And IY% >= 10 Then Stop
                '
                '        Next S%
                'bbh 2020/08/03 end
                'If RegName$(R%) = "Angola" Then Stop

                '        This redefinition of INVS to include delta stocks is done now for SAM,
                '           but it would be better to carry another variable to SAM (or to add
                '           delta stocks there; INVS is used appropriatly in st_red above and
                '           ideally should show the origin of IGCF, not I

            Next R

            'jrs 2022/04/04
            'All but First 5: Arms Exports and Imports
            '-------------------------------------------
            Dim globalSumOfImports, globalSumOfExports As Single
            globalSumOfImports = 0
            globalSumOfExports = 0

            For R% = 1 To NR%
                XARMS(R%) = (GDP(R%) * iXARMSTOGDP(R%) + xarmsadd(R%)) * xarmsm(R%)
                MARMS(R%) = CSng(Amin((GDP(R%) * iMARMSTOGDP(R%) + marmsadd(R%)) * marmsm(R%), sgds(R%, Mil) * armsimmaxpctmilexp(R%))) 'clp 11/16/2022 adding armsimmaxpctmilexp
                globalSumOfExports = globalSumOfExports + XARMS(R%)
                globalSumOfImports = globalSumOfImports + MARMS(R%)
            Next R%

            'Normalize
            For R% = 1 To NR%
                XARMS(R%) = XARMS(R%) * globalSumOfImports / globalSumOfExports
            Next R%


            ''jrs 2008/11/07
            'If IY > 21 Then
            '    Open FdrvRun$ & "ifslog.txt" For Append As #500
            '    Print #500, "End Of Call4"
            '    Close #500
