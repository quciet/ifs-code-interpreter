                '           more than investment which swings freely
                '       ---------------------------------------------------------------------------------------

                '        If smoothintr(R%) - INTRI(R%) >= 0 Then
                '            Diff1 = smoothintr(R%) - INTRI(R%)
                '        Else
                '            InverseCalc = INTRI(R%) / AMAX(0.01, smoothintr(R%))
                '            Diff1 = -(InverseCalc * INTRI(R%) - INTRI(R%))
                '        End If
                If smoothintr(R%) - LongTermIntr(R%) >= 0 Then
                    Diff1 = smoothintr(R%) - LongTermIntr(R%)
                Else 'bbh 2022/10/27 Put higher floor on divisor for inversecalc
                    inversecalc = LongTermIntr(R%) / AMAX(AMAX(0.01, 0.5 * LongTermIntr(R%)), smoothintr(R%))
                    'inversecalc = LongTermIntr(R%) / AMAX(0.01, smoothintr(R%))
                    Diff1 = -(inversecalc * LongTermIntr(R%) - LongTermIntr(R%))
                End If

                If IY% = 2 Then
                    SIntRDiff1(R%) = Diff1
                End If
                Diff2 = Diff1 - SIntRDiff1(R%)
                SIntRDiff1(R%) = Diff1

                'bbh 2020/07/01 start decrease swing of consumption with interest rates
                '        CPar1 = -0.1
                '        CPar2 = -0.2
                'CPar1 = CSng(-Amin(0.5, AMAX(0.05, 0.3 / (AMAX(0.0001, GDPPCP(R%)) / 2)))) 'bbh 2021/08/04 increased rate of C change, 2 lines
                'CPar2 = CSng(-Amin(1.0#, AMAX(0.1, 0.6 / (AMAX(0.0001, GDPPCP(R%)) / 2))))
                '        CPar1 = -Amin(0.5, AMAX(0.1, 0.6 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                '        CPar2 = -Amin(1#, AMAX(0.2, 1.2 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                'CPar1 = -Amin(0.9, AMAX(0.3, 0.9 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                'CPar2 = -Amin(1.8, AMAX(0.6, 1.8 / (AMAX(0.0001, GDPPCP(R%)) / 2)))

                CPar1 = CSng(-Amin(0.9, AMAX(0.3, 0.9 / (AMAX(0.0001, GDPPCP(R%)) / 2)))) 'bbh 2021/08/04 increased rate of C change, 2 lines
                CPar2 = CSng(-Amin(1.8, AMAX(0.6, 1.8 / (AMAX(0.0001, GDPPCP(R%)) / 2))))

                Call ADJSTR(100, Diff1, Diff2, CPar1, CPar2, Mul)
                'jrs 2024/09/26
                'If IY >= 80 Then
                '    Mul = 1
                'End If

                'Mul = 1 'bbh 2021/08/04 No need to take out impact of LongTermIntr after changes (/25) to impact of SHHSavSurStock(R%)
                '        cramul(R%) = cramul(R%) * Mul 'bbh 2021/09/21
                cramul(R%) = 1 'bbh 2021/09/21 Turning off cumulative mul affect via cramul helped stock/C behavior; suggests problem with INTR,
                'so just leave Mul active in C impact
                'If RegName$(R%) = "Congo, Democratic Republic of" And IY% >= 17 Then Stop

                'immadj = ExcessSt(R%) / 2
                'immadj = ExcessSt(R%) / 6 'bbh 2021/09/21, changed from /12 when removed cramul impact; gave more to immediate excess stocks; then /4 below
                'immadj = ExcessSt(R%) / 12 'bbh 2020/06/13 decrease swing of consumption with stocks
                'bbh 2020/07/23 'deficit should somewhat more lower C
                'If ExcessSt(R%) < 0 Then immadj = AMAX(-GDP(R%) * 0.15, ExcessSt(R%) / 6) 'bbh 2021/09/21

                'bbh 2024/10/24 immadj = ExcessSt(R%) / 4 'bbh 2021/09/21 changed from /6 to give still more impact to excess stocks without cramul affect
                'immadj = ExcessSt(R%) / 12 'bbh 2024/10/24 'Traced late 2100s oscillation in Luxembourg C and trade to this; replaced line just above (/4)
                immadj = ExcessSt(R%) / 8 'bbh 2024/10/24 variation on change above to reduce longer waves in C

                'immadj = ExcessSt(R%) / 6 'bbh 2022/10/27 Reduce impact on C/GDP of excess to slow upward response and overshoot
                If ExcessSt(R%) < 0 Then
                    immadj = AMAX(-GDP(R%) * 0.15, ExcessSt(R%) / 4) 'bbh 2021/09/21 from /12
                End If

                'bbh 2020/07/01 end
                CHold = C(R%)

                'bbh 2020/07/14 start  'if there are excess stocks and/or low interest rate, can let CAPUT adjustment and
                'stock depreciation take care of it; if shortage, need to adjust C and IGCF
                'Ended up not using If condition below, ut may want to revisit later; a problem is that
                '   in base case low income countries already have considerable shortage of stocks due to having high
