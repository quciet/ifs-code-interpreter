                    M_Base = CS(R%, S%) + GS(R%, S%) + INVS(R%, S%) + ZS(R%, S%) '- PFD(R%, S%)
                    mkav(R%, S%) = CSng(MS(R%, S%) / AMAX(M_Base, 0.0001))
                    If S% >= 4 Then
