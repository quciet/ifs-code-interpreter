                        Dim elxpr2adj = elxpr2
                        Dim elmpr1adj = elmpr1
                        Dim elmpr2adj = elmpr2
                        '                End If
                        '                PriBase = AMAX(WP(S%), spri(R%, S%) * EXRATE(R%)) 'bbh 2022/12/20 Was in use before work on it
                        PriBase = 1 'bbh 2022/12/20 This works better for countries as disparate as Yemen and Hongkong relative to other bases tried
                        'If EXRATE grows very high, like Qatar, WP inadequate
                        Mul = 0!
                        Call ADJSTR(PriBase, Diff1, Diff2, elxpr1adj, elxpr2adj, Mul)
                        'jrs 2024/09/26
                        'If IY >= 80 Then
                        '    Mul = 1
                        'End If
