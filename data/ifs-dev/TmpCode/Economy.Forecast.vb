                '        'Diff2 = ChangeInDebt(R%) - SChangeInDebt(R%)
                '        Diff1 = ChangeInDebt(R%) + XDEBT(R%) - XDebtTargetPerGDP * GDPPOT(R%)
                '        Diff2 = Diff1 - SXDebtImbalance(R%)
                '        SXDebtImbalance(R%) = Diff1
