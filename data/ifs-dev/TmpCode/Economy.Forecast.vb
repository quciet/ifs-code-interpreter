                    FBICSUM = 0
                    For j = 1 To NR%
                        allycount = allycount + ally(R%, j%)
                        conflictind = AMAX(THREAT(R%, j%) / 100, conflictind)
                        FBICSUM = FBICSUM + INFLUENCE(R%, j%)
                    Next j

