    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSexNPLFirstYear:PovertyNormalizeGender
' Private Sub PovertyNormalizeGender(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, PovGndRatioVec(,) As Single, Optional StartAG% = 1, Optional EndAG% = TotPovAGCount)
    
                'mti 2021/12/28 Take entire procedure
                'mti 2021/01/29 Take entire procedure R%%, POVRATENPL(), POVCOUNTNPL(), povnational_hc As Single
    
                'mti 2020/03/18 Whole procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
    
                Dim j As Integer, NormFac As Single
    
                For j% = StartAG% To EndAG% '1 To TotPovAGCount
                    'Debug.Print j%
                    If POVCOUNTNPL(R%%, j%, Total) = 0 Or (POVRATENPL(R%%, j%, Male) = 0 And POVRATENPL(R%%, j%, Female) = 0) Then
                        POVCOUNTNPL(R%%, j%, Male) = 0
                        POVCOUNTNPL(R%%, j%, Female) = 0
                        POVRATENPL(R%%, j%, Male) = 0
                        POVRATENPL(R%%, j%, Female) = 0
                        PovGndRatioVec(R%%, j%) = 1
    
                    Else
                        'Get headcounts by gender using rates and population by gender
                        POVCOUNTNPL(R%%, j%, Female) = POVRATENPL(R%%, j%, Female) * POPPOVAG(R%%, j%, Female) / 100
                        POVCOUNTNPL(R%%, j%, Male) = POVRATENPL(R%%, j%, Male) * POPPOVAG(R%%, j%, Male) / 100
    
                        'Compute normalization factor
                        'mti 2020/03/18 start
                        'NormFac = POVCOUNTNPL(R%%, j%, Total) / AMAX(0.0001, (POVCOUNTNPL(R%%, j%, Male) + POVCOUNTNPL(R%%, j%, Female)))
                        NormFac = POVCOUNTNPL(R%%, j%, Total) / AMAX(0.000001, (POVCOUNTNPL(R%%, j%, Male) + POVCOUNTNPL(R%%, j%, Female)))
    
    
                        'Normalize headcounts
                        'mti 2021/07/15 start
                        POVCOUNTNPL(R%%, j%, Female) = CSng(Amin(POPPOVAG(R%%, j%, Female), Round(POVCOUNTNPL(R%%, j%, Female) * NormFac, 6)))
                        POVCOUNTNPL(R%%, j%, Male) = CSng(Amin(POPPOVAG(R%%, j%, Male), AMAX(0, Round(POVCOUNTNPL(R%%, j%, Total) - POVCOUNTNPL(R%%, j%, Female), 6))))
    
                        'Just in case male had to be bounded at 100; give all of the remainder to female
                        POVCOUNTNPL(R%%, j%, Female) = CSng(AMAX(0, Round(POVCOUNTNPL(R%%, j%, Total) - POVCOUNTNPL(R%%, j%, Male), 6)))
                        'mti 2021/07/15 end
    
                        '            POVCOUNTNPL(R%%, j%, Male) = Round(POVCOUNTNPL(R%%, j%, Male) * NormFac, 6)
                        '            POVCOUNTNPL(R%%, j%, Female) = AMAX(0, Round(POVCOUNTNPL(R%%, j%, Total) - POVCOUNTNPL(R%%, j%, Male), 6))
    
    
    
                        'recompute (normalized) rates by gender
                        POVRATENPL(R%%, j%, Female) = 100 * POVCOUNTNPL(R%%, j%, Female) / AMAX(0.000001, POPPOVAG(R%%, j%, Female))
                        POVRATENPL(R%%, j%, Male) = 100 * POVCOUNTNPL(R%%, j%, Male) / AMAX(0.000001, POPPOVAG(R%%, j%, Male))
    
                        'Compute gender ratio
                        '            If POVRATENPL(R%%, j%, Female) = 0 Or POVRATENPL(R%%, j%, Male) = 0 Then
                        '                PovGndRatioVec(R%%, j%) = 1
                        '            Else
    
                        'PovGndRatioVec(R%%, j%) = POVRATENPL(R%%, j%, Female) / POVRATENPL(R%%, j%, Male)  '0.001
                        'less than half a percent poverty in either group consisdered as equal poverty
                        PovGndRatioVec(R%%, j%) = AMAX(0.005, POVRATENPL(R%%, j%, Female)) / AMAX(0.005, POVRATENPL(R%%, j%, Male)) '0.001
                        '                If PovGndRatioVec(R%%, j%) > 15 Then Stop
    
                        '            End If
                        'mti 2020/03/18 End
                    End If
                Next j%
    
    
                'mti 2020/03/25 Start
                If POVCOUNTNPL(R%%, TotPovAGCount, Total) = 0 Then
                    POVCOUNTNPL(R%%, TotPovAGCount, Male) = 0
                    POVCOUNTNPL(R%%, TotPovAGCount, Female) = 0
                    POVRATENPL(R%%, TotPovAGCount, Male) = 0
                    POVRATENPL(R%%, TotPovAGCount, Female) = 0
                    PovGndRatioVec(R%%, TotPovAGCount) = 1
                Else
                    'If RegName(R%%) = "India" Then Stop
                    POVCOUNTNPL(R%%, TotPovAGCount, Male) = 0
                    POVCOUNTNPL(R%%, TotPovAGCount, Female) = 0
                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNTNPL(R%%, TotPovAGCount, Male) = POVCOUNTNPL(R%%, TotPovAGCount, Male) + POVCOUNTNPL(R%%, j%, Male)
                        POVCOUNTNPL(R%%, TotPovAGCount, Female) = POVCOUNTNPL(R%%, TotPovAGCount, Female) + POVCOUNTNPL(R%%, j%, Female)
                    Next j%
    
    
    
                    POVRATENPL(R%%, TotPovAGCount, Male) = 100 * POVCOUNTNPL(R%%, TotPovAGCount, Male) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Male))
                    POVRATENPL(R%%, TotPovAGCount, Female) = 100 * POVCOUNTNPL(R%%, TotPovAGCount, Female) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Female))
                    PovGndRatioVec(R%%, TotPovAGCount) = AMAX(0.005, POVRATENPL(R%%, TotPovAGCount, Female)) / AMAX(0.005, POVRATENPL(R%%, TotPovAGCount, Male)) '0.001
                End If
                'mti 2020/03/25 End
    
                'mti 2021/12/28 start
                '15 plus and 25 plus computation taken to new procedure
                'mti 2021/12/28 End
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSexNPLFirstYear:PovertyNormalizeGender
