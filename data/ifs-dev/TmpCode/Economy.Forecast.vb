                    '---
                    'Save DYADIC DEPENDENCE
                    '-----------------------------------------------
                    db.BulkInsertDYADDEPENDENCE(DEPENDENCE, CShort(FirstYear + IY - 1), NR)
                    'Save DYADIC BANDWIDTH
                    '-----------------------------------------------
                    db.BulkInsertDYADBANDWIDTH(BANDWIDTH, CShort(FirstYear + IY - 1), NR)
                    'Save DYADIC INFLUENCE
                    '-----------------------------------------------
                    db.BulkInsertDYADINFLUENCE(INFLUENCE, CShort(FirstYear + IY - 1), NR)
                    'jrs 2020/07/09 *** BEGIN ***
                    'Save INFLUENCE DIMENSIONS
    
                    'Aid % GDP
                    '-----------------------------------------------
                    db.BulkInsertDYADINF_AID_PCTGDP(aid_a_gdp_b, CShort(FirstYear + IY - 1), NR)
                    'Aid % Total Aid
                    '-----------------------------------------------
                    db.BulkInsertDYADINF_AID_PCTTOTALAID(aid_a_allaid_b, CShort(FirstYear + IY - 1), NR)
