                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / ((CAPUT(R%%, S%) / caputtar) ^ 0.5))
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VaddPreCaput(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VaddPreCaput(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        'bbh 2021/09/09 Begin: removed CAPUT adjustment; was keeping;; was keeping VADD drop in 2020 from affecting HHINCEARN, HHINCDIS, and C
                        '                    VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        '                    VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        'bbh 2021/09/09 end
                        'bbh 2021/07/07 Not clear why we need the use of CAPUT here on this branch; useful to review and perhaps remove
                    Else
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        'VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VaddPreCaput(R%%, S%)
                        'VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VaddPreCaput(R%%, S%)

                        'bbh 2021/08/04 added caput adjustment here also; If Else not really needed; CAPUT should always affect household VADD, but not total VADD
                        'bbh 2021/09/09 start: removed CAPUT adjustment once again
                        VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADD(R%%, S%)
                        '                    VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        '                    VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * (VADD(R%%, S%) / (CAPUT(R%%, S%) / caputtar))
                        'bbh 2021/09/09 end
                    End If
                    'bbh 2020/08/20 end
                    '                VADDHHU(R%%, S%) = VADDHHU(R%%, S%) / AMAX(0.001, VAddCalc) * VADDRPA(R%%, S%)
                    '                VADDHHS(R%%, S%) = VADDHHS(R%%, S%) / AMAX(0.001, VAddCalc) * VADDRPA(R%%, S%)
                    'bbh 2020/08/05 end
                Next S%


                For S% = 1 To NSec%  'kept constant for now
                    sLabWageS(R%%, S%, Unskilled) = LABWAGES(R%%, S%, Unskilled)
                    sLabWageS(R%%, S%, Skilled) = LABWAGES(R%%, S%, Skilled)
                Next S%

            End If
            'bbh 2021/05/15 start replacing HHINC with HHINCEARN and FIRMINC with FIRMEARN
            HHINCEARN(R%%, Unskilled) = 0
            HHINCEARN(R%%, Skilled) = 0
            FIRMEARN(R%%) = 0
            For S% = 1 To NSec%
                VADDHHU(R%%, S%) = VADDHHU(R%%, S%) * (1 - CDALF(R%%))
                HHINCEARN(R%%, Unskilled) = HHINCEARN(R%%, Unskilled) + VADDHHU(R%%, S%)
                VADDHHS(R%%, S%) = VADDHHS(R%%, S%) * (1 - CDALF(R%%))
                HHINCEARN(R%%, Skilled) = HHINCEARN(R%%, Skilled) + VADDHHS(R%%, S%)
                'bbh 2020/08/05 Start
                'VADDF(R%%, S%) = VADD(R%%, S%) - VADDHHU(R%%, S%) - VADDHHS(R%%, S%)
                'bbh 2020/08/20 start

                'bbh 2021/08/04 start  Total VADD finalized in IFsEco; household adjusts with CAPUT to help on stocks, above; change firm but leave VADD total alone
                'If CAPUT(R%%, S%) > caputtar And gdprext(R%%) < -70 Then
                'If CAPUT(R%%, S%) > caputtar And gdprext(R%%) > -70 Then 'bbh 2021/07/07 start 'bbh 2021/08/04
                '            If gdprext(R%%) > -70 Then 'bbh 2021/08/04 Growth exogenous
