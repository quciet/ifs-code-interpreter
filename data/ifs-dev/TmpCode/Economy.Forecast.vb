                    mfpdisabpar = CSng(mfphlyld * (1 - Amin(1, (0.1 - disabilityratio) / 0.08)))
                End If
                'disabcontrib = AMAX(-2, (disability - GroupDisAvg(WBGroup)) * mfphlyld) 'jrs 2009/10/02 (-0.5)
                disabcontrib = AMAX(-2, (disability - GroupDisAvg(WBGroup)) * mfpdisabpar)
                'bbh 2023/07/22 end
                'bbh 2019/06/01 end

                'Kosovo and to lesser degree Hong Kong have huge rates of disability, probably bad data
                '   This bound protects against extreme drag of disability and vicious growth cycle
                'disabcontrib = (disability - WorldDisAvg) * mfphlyld 'jrs 2009/10/02 (-0.5)   'mfpdisab
                'bbh 2019/05/24 end
                edexpcontrib = (GDS(R%, Educ) / GDP(R%) * 100 - edexpcomp) * mfpedspn '0.3
                'bbh 2019/05/24 commented following line, not clear why double parameter logic was there
                'lifexpedyrsboost = (LIFEXP(R%, 3) - lifeexpcomp) * mfpedlifexp * mfpedyrs '0.035 '10 years adds equivalent of 0.35 years
