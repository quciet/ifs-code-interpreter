                    'hhincunskilled = HHINCDISPERM(R%, Unskilled)
                    hhincskilled = ConvergeOverTimeStartX(HHINCDIS(R%, Skilled), HHINCDISPERM(R%, Skilled), LastExogenousYear(R%) + 5, LastExogenousYear(R%))
                    hhincunskilled = ConvergeOverTimeStartX(HHINCDIS(R%, Unskilled), HHINCDISPERM(R%, Unskilled), LastExogenousYear(R%) + 5, LastExogenousYear(R%))
                    'jrs 2022/05/25 *** end ***
                End If
