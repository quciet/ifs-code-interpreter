            '   ----------------------------------------------------------------------
            'jrs 2014/09/16
            'Dim WorldDisability As Single, WorldWorkPop As Single, R As Integer, z As Integer, WorldDisAvg As Single, edexpcomp As Single, HlExpComp As Single
            Dim R As Integer, z As Integer, edexpcomp As Single, HlExpComp As Single 'bbh 2019/06/01 removed several from previous
            Dim rdexpcomp As Single, yrsedcomp As Single, lifeexpcomp As Single, stuntingcomp As Single, disability As Single, disabcontrib As Single
            Dim mfpdisabpar As Single, disabilityratio As Single 'bbh 2023/07/22

            'gvdb 2024/04/05
            ' unused variable
            Dim edexpcontrib As Single, edyrscontrib As Single, hlexpcontrib As Single, lifeexpcontrib As Single ' lifexpedyrsboost As Single,
            Dim edVoccontrib As Single, FreeComp As Single, EconFreeComp As Single, PolityDemocComp As Single, GovtEffComp As Single, Prediction As Single
            Dim corrupcomp As Single, econfreecontrib As Single, freecontrib As Single, politydemoccontrib As Single, govteffcontrib As Single
            'Dim eleccontrib As Single, roadcontrib As Single, telecontrib As Single, netcontrib As Single, 
            Dim InfraIndTradCompLt5 As Single, InfraIndTradCompGt40 As Single
            Dim InfraIndTradComp As Single, infratradcontrib As Single, INFRAINDICT_Prev As Single, IndICTContrib As Single, infraictcontrib As Single
            Dim InfOthSpndExp As Single, InfOthSpndComp As Single, infothspndcontrib As Single, rdexpcontrib As Single, ecintcontrib As Single
            Dim avgcontrib As Single, FactorC As Single
            Dim WBGroup As Integer 'bbh 2019/06/01

            gLoadWBGroupIds(GroupIDs)
            For WBGroup = 1 To 4
                GroupDisability(WBGroup) = 0
                GroupWorkPop(WBGroup) = 0
            Next WBGroup

            ReDim MFPCOR(NR%)
            ReDim MFPBAS(NR%)

            For R% = 1 To NR%
                SumHLYLDWork(R%) = 0
                For z = 1 To CInt(Ntypes / 2)
                    'jrs 2021/08/09 changed rounding to 5
                    SumHLYLDWork(R%) = CSng(SumHLYLDWork(R%) + Round(HLYLDWORK(R%, z, 3), 5))
                    'SumHLYLDWork(R%) = SumHLYLDWork(R%) + Round(HLYLDWORK(R%, z, 3), 5) 'bbh 2021/08/04 Round ,3 was causing transient in Tonga MFPHC -
                    'Disability was going from .004 ro .005 in the MFPHC computation between 2039 and 2040 and causing a signficant downward shift in MFPHC and GDPR
                    'But when I go to Round ,5, it causes a run-to-run error between the base case and the first run after it.
                Next z
                SSumHLYLDWork(R%) = SumHLYLDWork(R%)
                'bbh 2019/06/04 start
                If GroupIDs(R%) < 1 OrElse GroupIDs(R%) > 4 Then
                    GroupIDs(R%) = 1
                End If
                'bbh 2019/06/04 end
                WBGroup = GroupIDs(R%)
                GroupWorkPop(WBGroup) = GroupWorkPop(WBGroup) + POPWORKING(R%)
                GroupDisability(WBGroup) = GroupDisability(WBGroup) + SumHLYLDWork(R%)
            Next R%
            For WBGroup = 1 To 4
                GroupDisAvg(WBGroup) = GroupDisability(WBGroup) / AMAX(0.001, GroupWorkPop(WBGroup)) * 100
            Next WBGroup
            'bbh 2019/06/01 end

            '   First Year 2:  Government Expenditures that Affect Economic Performance and MPF
            '   -------------------------------------------------------------------------------

            For R% = 1 To NR%

                If context.HistoricMode = True Then
                    Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Educ As % Of GDP (1960) - log",
                    Amin(40, GDPPCP(R%)), edexpcomp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus Govt Exp Hlth As % Of GDP (1990) - log",
                    Amin(40, GDPPCP(R%)), HlExpComp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus R&D Total  As % Of GNI (1980) - linear",
                    Amin(40, GDPPCP(R%)), rdexpcomp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus Years Of Educ at 15+ (1960)",
                    GDPPCP(R%), yrsedcomp, context)
                    Call XYTABL("GDP/Capita (PPP) Versus Life Expectancy (1970)",
                    GDPPCP(R%), lifeexpcomp, context)
                    Call XYTABL("GDP/Capita (PPP 2005) Versus Stunting (2005) Log",
