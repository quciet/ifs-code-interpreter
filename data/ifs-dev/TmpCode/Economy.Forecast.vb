                Next
    
                If NonNormTot = 0 Then
                    POVCOUNT55(R%%, TotPovAGCount, Total) = 0
                    POVRATE55(R%%, TotPovAGCount, Total) = 0
                    For j% = 1 To TotPovAGCount
                        POVRATE55(R%%, j%, Total) = 0
                        POVCOUNT55(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NormFac = CSng(INCOMELT550LN(R%)) / NonNormTot
    
