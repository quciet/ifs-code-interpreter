MFPKN(R%) = rdexpcontrib + ecintcontrib  + R% + sEdTerGrSciEn(R%) + context + EDTERGRATE + EDTERGRSCIEN + GDPPCP + mfpedscien @@MFPKN(R%) = rdexpcontrib + ecintcontrib + EdTerSciContrib(R%, sEdTerGrSciEn(R%), context)@@
                'If RegName$(R%) = "Guatemala" Then Stop
                'mti 2014/03/27 - end
                ' If R = 1 Then Stop
                'Should add a link to FDI stocks here (relative to relationship between
                '   stocks expected at each level of GDP (see FDI stock calculation)
                '   More generally, trade, FDI, perhaps remittances could operationalize
                '   economic openness/freedom

                '   All but First 1:  Productivity Growth:  Adjust Productivity Components
                '       for Complementarities
                '   ------------------------------------------------------------------------
                'If RegName$(R%) = "Afghanistan" Then Stop

                '   All but First 1:  Productivity Growth:  Compute Productivity Components - Final
                '   -------------------------------------------------------------------------------
                'If IY = 13 Then Debug.Print RegName(R%); ","; IY; ","; MFPHC(R%); ","; MFPSC(R%); ","; MFPPC(R%); ","; MFPKN(R%); ",";
                avgcontrib = (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 4 / 100
                FactorC = MFPHC(R%) / 100 - avgcontrib
MFPHC(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPHC(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                'If RegName$(R%) = "Nigeria" Then Stop
                'If RegName$(R%) = "Nigeria" And (IY% = 11) Then Stop
                FactorC = MFPSC(R%) / 100 - avgcontrib
MFPSC(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPSC(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                FactorC = MFPPC(R%) / 100 - avgcontrib
MFPPC(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPPC(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                FactorC = MFPKN(R%) / 100 - avgcontrib
MFPKN(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPKN(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                'If RegName$(R%) = "Guatemala" Then Stop
                'If IY = 13 Then Debug.Print MFPHC(R%); ","; MFPSC(R%); ","; MFPPC(R%); ","; MFPKN(R%)
                'If RegName$(R%) = "China" Then Stop
                'If RegName$(R%) = "Sweden" Then Stop
                ' If RegName(R%) = "Afghanistan" Then Stop

                'mti October 20, 2011 - start
                avgcontrib = (MFPHC(R%) + MFPSC(R%) + MFPPCDEM(R%) + MFPKN(R%)) / 4 / 100
                FactorC = MFPPC(R%) / 100 - avgcontrib
MFPPCDEM(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPPCDEM(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                'mti October 20, 2011 - end

                '   All but First 1:  Productivity Growth:  Adjust Base Rate from Technology
                '   ------------------------------------------------------------------------

                'GDPPC(R%) = sgdp(R%) * (1 + igdpr(R%)) / POP(R%)
                GDPPC(R%) = SGDP(R%) * (1 + IGDPRCor(R%)) / POP(R%)



                Dim SumVadd = 0!
                For S% = 1 To NSec%
                    SumVadd = SumVadd + SmVadd(R%, S%)
                    'If RegName$(R%) = "Ukraine" And S% = 2 Then Stop
                Next S%
                MFPCOR(R%) = 0
                MFPBAS(R%) = 0
                'bbh 2017/01/25 start   Code below was making Eq Guinea highest GDP per capita in 2100, other anomolies
                'Change back to not using it does lead to negative growth in some countries, mostly oil producers
                'bbh 2011/11/10 With 50 years and high MFPCORI, high countries like Singapore turn negative
                mfpconvadj = mfpconv(R%)
                '        If MFPCORI(R%) <= 2 Or GDPPCIP(R%) < 30 Then
                '           mfpconvadj = mfpconv(R%)
                '        Else
                '           mfpconvadj = mfpconv(R%) '+ Amin(mfpconv(R%), 50 * (MFPCORI(R%) - 2) / 2)
                '        End If
                'bbh 2017/01/25 end

                'mti 2014/11/27 - start

                'bbh 2020/03/26 start - take all of rest of procedure if possible
                '   All but First 1:  TEF Adjustment Factor from Informal Economy
                '   --------------------------------------------------------------

                '         TbName$ = "GDP/Capita (PPP 2011) Versus Informal Share of GDP (" & CStr(BaseYear) & ") Log"
                '         TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear)
                '         Call XYTABL(TbName$, GDPPCP(R%), gdpinformshrexp)
                '         gdpinformshrexp = AMAX(1, gdpinformshrexp) 'bbh 2015/03/25

                'bbh 2015/06/20 start
                If gdpshadowon = 0 Then
                    'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2011) Versus Informal Share of GDP (" & CStr(BaseYear) & ") Log"
                    'TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, context)
                    Call XYTABL(TFNameInformalShareGDP, GDPPCP(R%), gdpinformshrexp, context)
                    gdpinformshrexp = AMAX(1, gdpinformshrexp) 'bbh 2015/03/25
                Else
                    'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2011) Versus Shadow Economy Share of Total(" & CStr(BaseYear) & ") Log"
                    Call XYTABL(TFNameShadowEcoShare, GDPPCP(R%), gdpshadowshrexp, context)
                    gdpshadowshrexp = AMAX(1, gdpshadowshrexp)
                End If

                'mti 2015/06/09 - start
                If gdpshadowon = 0 Then
                    ExDefInfGDP = (GDPINFORMSHR(R%) - gdpinformshrexp) / 100
                Else
                    'ExDefInfGDP = (GDPSHADOWSHR(R%) - gdpinformshrexp) / 100
                    ExDefInfGDP = (GDPSHADOWSHR(R%) - gdpshadowshrexp) / 100 'bbh 2015/06/20
                End If
                'mti 2015/06/09 - end

                'bbh 2015/03/28 start change from function to actual ratio
                '         TbName$ = "GDP/Capita (PPP 2011) Versus LabInformal/GDPInformal (" & CStr(BaseYear) & ") Log"
                '         TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear)
                '         Call XYTABL(TbName$, GDPPCP(R%), InfCost)

                'bbh 2015/06/21 start
                If gdpshadowon = 0 Then
                    'sinfcostrev = LABINFORMSHR(R%) / AMAX(1, GDPINFORMSHR(R%))
                    sinfcostrev = LABINFORMSHR(R%) / 10 'bbh 2021/09/30  When GDPINFORMSHR got low,formulation was unstable
                    SInfCost(R%) = CSng(SInfCost(R%) * 0.95 + 0.05 * sinfcostrev)
                Else
                    sinfcostrev = LABINFORMSHR(R%) / AMAX(1, GDPSHADOWSHR(R%))
                    If sinfcostrev < 1.1 Then 'allow more adjustment when ratio is near 1 (will be stable)
                        SInfCost(R%) = CSng(SInfCost(R%) * 0.75 + 0.25 * sinfcostrev)
                    Else
                        SInfCost(R%) = CSng(SInfCost(R%) * 0.9 + 0.1 * sinfcostrev)
                    End If
                End If

                'Moving average must slow this very much or it will set up an oscillating negative
                'feedback over TEF, GDPPOT, FDI, FirmInc, GovHHTRN, etc; nasty - bbh 2015/03/28
                SInfCost(R%) = Amin(3, AMAX(1, SInfCost(R%)))
                'bbh 2015/06/21 end
                TefInfAdjustFac = (1 / AMAX(0.001, (1 - ExDefInfGDP) + ExDefInfGDP * SInfCost(R%))) / stefinfadjust(R%)
                stefinfadjust(R%) = 1 / AMAX(0.001, (1 - ExDefInfGDP) + ExDefInfGDP * SInfCost(R%))
                'bbh 2015/03/28 end
                TefInfAdjustFac = TefInfAdjustFac - 1

                'mti 2014/11/27 - end

                '   All but First 1:  TEF Adjustment Factor from Productivity elements and correction factor
                '   ----------------------------------------------------------------------------------------

                'bbh 2020/03/26 start of main changes of this date
                '  As the share of agriculture in total GDP declines, the growth correction calcuated for other sectors in year 1 declines
                'bbh 2020/07/01  Back out ylm impact on ag VADD becuase should not affect productivity in other sectors
                'CorrectReduction = SectorGrAgAdj(R%) * (VaddShrAgGDPI(R%) - (SVADD(R%, 1) / AMAX(0.01, SGDP(R%)))) / AMAX(0.001, othe(R%))
                'bbh 2021/04/12 More explanation of CorrectReduction and CorrectReduced Block
                '  In LDCs, agriculture is big as share of GDP; with GDPPCP growth, it tends to decline rapidly; MFPCORSI is often quite different from 0 for the ag sector
                '  Thus, when the ag share drops, it can swing the growth rates of LDCs greatly in ways not really rooted in substance; for instance, Uganda has a very large
                '  negative correction for agriculture some positive in other sectors, so it was getting a large boost before  long in growth;
                '  Sierra Leone much the other direction; SSA mostly other direction (drag on growth given high positive MFPCORSI in ag)
                '  The computation of SectorGrAgAdj in year 1 was set up to facilitate offset of the impact of ag sector decline by shifting some of its correction to other sectors
                '  It generally works, for instance by signficantly reducing the surge that was occuring in GDPR for Uganda
                CorrectReduction = SectorGrAgAdj(R%) * (VaddShrAgGDPI(R%) - (sVADD(R%, 1) / AMAX(0.001, SYLM(R%)) / AMAX(0.01, SGDP(R%)))) / AMAX(0.001, VaddShrAgGDPI(R%))
                'bbh 2023/07/22 Start addition of correction for energy sector growth differential with igdprcor; done in 3rd year and later because, unlike tgryl in ag, there is no growth
                '  rate for the energy sector coming into the model's first year from preprocessor; moreover, can't be done in the 2nd year because the calculations of ENP and ZS in the energy
                '  model follow the calculation here of adjustments for TEF, making it necessary to use SZS and SSZS to compute them
                '  Search on lines with CorrectIncreaseFromEn for changes

                'If IY% >= 20 And ((GRPS(1, R) = "Eritrea") Or (GRPS(1, R) = "Congo, Dem. Republic of the") Or (GRPS(1, R) = "Syrian Arab Republic")) Then Stop  'bbh 2023/12/12
                'If IY% = 20 And (GRPS(1, R) = "Eritrea") Then Stop  'bbh 2023/12/12

                CorrectIncreaseFromEn = 0
                If IY% >= 3 Then
                    CorrectIncreaseFromEn = sVADD(R%, Ener) / AMAX(0.01, SGDP(R%)) * (igdprcor(R%) - (szs(R%, Ener) - sszs(R%, Ener)) / AMAX(0.0001, sszs(R%, Ener)))
                End If
                'CorrectIncreaseFromEn = 0
                For S% = 1 To NSec%
                    qualityterms = (MFPHC(R%) + MFPSC(R%) + MFPPC(R%)) / 100
                    'jrs 2014/08/14 *** begin ***
                    '            If MFPCORS(R%, S%) < 0 Then
                    '                'correctionterm = ConvergeOverTime(MFPCorS(R%, S%), 0, mfpconv(R%) * 0.2)
                    '                correctionterm = ConvergeOverTime(MFPCORS(R%, S%), 0, mfpconv(R%))
                    '                    'Base, Target, Years
                    '            Else
                    '                 correctionterm = ConvergeOverTime(MFPCORS(R%, S%), 0, mfpconvadj)
                    '                    'Base, Target, Years
                    '            End If

                    If S% = 1 Then
                        CorrectReduced = MFPCorSI(R%, S%)
                        'If GRPS(1, R%) = "Eritrea" And (IY% = 25) Then Stop  'bbh 2023/12/12
                        'If IY% = 20 And (GRPS(1, R) = "Eritrea") Then Stop  'bbh 2023/12/12
                    Else
                        CorrectReduced = MFPCorSI(R%, S%) - CorrectReduction
                        'If S% = 5 And GRPS(1, R%) = "Eritrea" And (IY% = 20) Then Stop  'bbh 2023/12/12
                    End If

                    'If RegName$(R%) = "China" And S% = 2 Then Stop

                    'bbh 2021/04/12 addition of 4 code lines and comments below
                    '    The reduction of ag in Sierra Leone with a very large Postive MFPCORSI, in interaction with the SectorGrAgAdj correction described above
                    '    was shifting the reduction of the positive contribution of correction from ag to other sectors and increasing their growth greatly
                    '    above initial MFPCORSI levels; the philosophy around correction factors adjustment was not to push them away from 0 much further than the
                    '    initial conditions and not to move them beyond convergence to 0 than then in the other direction; the new checks below avoid those issues
                    'If correction is taking in wrong direction, then override and leave correction reduction to mfpconv(R%) time
                    If SectorGrAgAdj(R%) < 0 And MFPCorSI(R%, S%) > 0 Then
                        CorrectReduced = MFPCorSI(R%, S%)
                    End If
                    If SectorGrAgAdj(R%) > 0 And MFPCorSI(R%, S%) < 0 Then
                        CorrectReduced = MFPCorSI(R%, S%)
                    End If
                    'If correction has overshot, then stop reduction in correction at 0
                    If CorrectReduced < 0 And MFPCorSI(R%, S%) > 0 Then
                        CorrectReduced = 0
                    End If
                    If CorrectReduced > 0 And MFPCorSI(R%, S%) < 0 Then
                        CorrectReduced = 0
                    End If
                    'bbh 2021/04/12 end
                    'If S = 5 And GRPS(1, R) = "Eritrea" And (IY% = 20) Then Stop  'bbh 2023/12/12
                    If MFPCorSI(R%, S%) < 0 Then
                        'correctionterm = ConvergeOverTime(MFPCorS(R%, S%), 0, mfpconv(R%) * 0.2)
                        'correctionterm = ConvergeOverTime(MFPCorSI(R%, S%), 0, mfpconv(R%)) 'bbh 2023/12/28 commented out
                        'correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%))
                        'Base, Target, Years
                        If CorrectReduced < -0.01 Then 'bbh 2023/12/28 If-then added to replace line above and converge high MFPCORS values faster when above 1%
                            correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%) / CSng((-CorrectReduced * 100) ^ 0.5))
                        Else
                            correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%))
                        End If
                    Else
                        'correctionterm = ConvergeOverTime(MFPCorSI(R%, S%), 0, mfpconvadj)
                        'correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%)) 'bbh 2023/12/28 commented out
                        If CorrectReduced > 0.01 Then 'bbh 2023/12/28 If-then added to replace line above and converge high MFPCORS values faster when above 1%
                            correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%) / CSng((CorrectReduced * 100) ^ 0.5))
                        Else
                            correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%))
                        End If
                        'If CorrectReduced > 0.01 Then correctionterm = ConvergeOverTime(CorrectReduced, 0, mfpconv(R%) / ((CorrectReduced ^ 0.5) * 100))
                        'bbh 2023/12/28 Above line added: Large positive corrections suggest overly large initial adjustments that should be phased out
                        'Base, Target, Years
                    End If
                    'bbh 2020/03/26 end of main changes
                    'If S = 5 And GRPS(1, R) = "Eritrea" And (IY% = 20) Then Stop  'bbh 2023/12/121
                    'correctionterm = 0 'bbh 2023/12/06 test
                    'CorrectIncreaseFromEn = 0 'bbh 2023/12/06 test

                    MFPCORS(R%, S%) = correctionterm * 100
                    MFPCORS(R%, S%) = MFPCORS(R%, S%) + CorrectIncreaseFromEn * 100 'bbh 2023/07/22

                    'jrs 2014/08/13 *** end ***

                    'Note: value of mfpconv(R%) makes great difference in behavior for many countries
                    ' e.g. China has growth far above basic mfp rates and low mfpconv(R%)
                    '       brings it down fast
                    ' e.g. Czech Rep has growth well below basic mfp so low mfpconv(R%)
                    '       brings it up fast
                    'Most countries with negative MFPCorS are transition economies and
                    '       should recover fairly fast
                    'bbh 2020/12/23 Start:  use of correction term when growth is exogenous changes behavior with igdpr; don't
                    '            If gdprext(R%) > -50 Then
                    'bbh 2021/05/15 start MFPGROWTH for MFPGro
                    MFPGROWTH(R%, S%) = MFPRATE(R%, S%) + MFPKN(R%) / 100 + qualityterms _
                    + correctionterm + CorrectIncreaseFromEn 'bbh 2023/07/22
                    'If S = 5 And GRPS(1, R) = "Ethiopia" And (IY% = 10 Or IY% = 31) Then Stop  'bbh 2023/12/121
                    'bbh 2023/07/22 End addition of correction for energy sector growth differential
                    '            Else
                    '                MFPGro(R%, S%) = MFPRATE(R%, S%) + MFPKN(R%) / 100 + qualityterms
                    '            End If
                    'bbh 2020/12/23 end
                    MFPGROWTH(R%, S%) = CSng(AMAX(-0.3, Amin(0.3, MFPGROWTH(R%, S%))))
                    tef(R%, S%) = tef(R%, S%) * (1 + MFPGROWTH(R%, S%))
                    'If GRPS(1, R) = "Israel" And FirstYear + IY - 1 >= 2135 Then Stop
                    'bbh 2021/05/15 end

                    'mti 2014/11/27 - start

                    'bbh 2019/03/15 start
                    'tefinfadjm(R%) = 0 'bbh 2023/12/06 test
                    InfImpTEF = TefInfAdjustFac * tefinfadjm(R%)
                    'tef(R%, S%) = tef(R%, S%) * (1 + TefInfAdjustFac * tefinfadjm(R%))
                    tef(R%, S%) = tef(R%, S%) * (1 + InfImpTEF)
                    If IY% = 2 Then
                        SInfImpTEF(R%, S%) = 0
                    End If
                    'ECGRINFTEF(R%, S%) = (InfImpTEF - SInfImpTEF(R%, S%)) * 100 'Percentage change on last year's
                    ECGRINFTEF(R%, S%) = InfImpTEF * 100  'Percentage impact on top of stock of imapct last year
                    SInfImpTEF(R%, S%) = InfImpTEF
                    'mti 2014/11/27 - end

                    '   All but First 1:  TEF Adjustment Factor from Climate Change
                    '   --------------------------------------------------------------------------------
                    'bbh 2019/03/15 moved climate change here from inside loop only for exogenous growth rates

                    'climeconimpstk = 10 'bbh 2023/12/06 probably raise limit on parameter in IFsvar and change in files

                    ClimImpTEF = SClimEconImp(R%) / 100 * climeconimpstk 'bbh 2020/02/24 two lines
                    'ClimImpTEF = -SClimEconImp(R%) / 100 * climeconimpstk
                    'tef(R%, S%) = tef(R%, S%) * (1 - SClimEconImp(R%) / 100 * climeconimpstk)
                    'bbh 2020/02/24 start
                    'The impact on tef is cumulative across time; hence the impact of climate on tef each year
                    '   should probably be only the increasing impact of climate change, not the cumulative
                    '   from year 1; otherwise double counting/compounding
                    tef(R%, S%) = tef(R%, S%) * (1 - (ClimImpTEF - SClimImpTEF(R%, S%)))

                    'If IY = 40 And GRPS(1, R) = "Eritrea" And S% = 5 Then Stop
                    'tef(R%, S%) = tef(R%, S%) * (1 + ClimImpTEF)
                    'bbh 2020/02/24 end
                    ' ECGRCLIMTEF(R%, S%) = (ClimImpTEF - SClimImpTEF(R%, S%)) * 100 'Percentage change on last year's
                    ECGRCLIMTEF(R%, S%) = -ClimImpTEF * 100  ''bbh 2020/02/24 two lines
                    'ECGRCLIMTEF(R%, S%) = ClimImpTEF * 100  'Percentage impact on top of stock of imapct last year
                    SClimImpTEF(R%, S%) = ClimImpTEF
                    'bbh 2019/03/15 end
                    tef(R%, S%) = AMAX(0.01, Amin(tef(R%, S%), 100000))

                    'mti October 03, 2011 -start
                    TEFF(R%, S%) = tef(R%, S%)
                    'mti October 03, 2011 - end

                    MFPCOR(R%) = MFPCOR(R%) + correctionterm * 100 * SmVadd(R%, S%)
                    MFPBAS(R%) = MFPBAS(R%) + MFPRATE(R%, S%) * 100 * SmVadd(R%, S%)
                    'If RegName$(R%) = "United States of America" And IY% >= 50 And S% = 4 Then Stop
                Next S%
                'If IY = 11 And GRPS(1, R) = "China" Then Stop
                MFPBAS(R%) = MFPBAS(R%) / AMAX(0.001, SumVadd)
                MFPCOR(R%) = MFPCOR(R%) / AMAX(0.001, SumVadd)
                MFPTOT(R%) = MFPBAS(R%) + MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%) + MFPCOR(R%)
                SYLM(R%) = ylm(R%) 'bbh 2020/07/01
                'If RegName$(R%) = "China" Then Stop
            Next R%
            'bbh 2020/03/26 end

            '   In October, 2003 did extensive analysis of production function
            '       and drivers of growth
            '   Found that mfpconv(R%), as discussed above, was very important
            '   Also, the decline of CDALF, when endogenized with GDPPC as below,
            '       substantially affects growth
            '   Also, CAPUT swings can substantially change growth
            '   In general, other terms were less significant


' End Sub
' ---- End Inlined Level 1: IFsEcoMFP_AllButFist
            End Using
        End Sub
        Public Sub ifsECOSAM1AllbutFirstYear(context As IForecastContext)
            'call1:

            '   All but First 1: Temporary Domestic GINI Needed in IFsEcoIntl
            '   -------------------------------------------------------------
            'ttt 2019/10/08 TakeOut
            Array.Copy(sGINIDOM, GINIDOM, NR + 1)
            'For R% = 1 To NR%
            '    GINIDOM(R%) = sGINIDOM(R%)
            '    '        GINIDOM(R%) = GINIDomI(R%) ' Temporary - remove after complete IFsEco Divide
            'Next R%
        End Sub
        Public Sub ifsECO2AllbutFirstYear(context As IForecastContext)
            '     All but First 2
            '     ******

            'call2:

            'jrs 2014/09/15
            Dim vadd_k As Single, vadd_l As Single, intsp As Single, intspmul As Single, cond As Boolean, TotalSVadd As Single, TotalVadd As Single
            'gvdb 2024/04/05
            ' unused variable
            Dim TotalSVaddPhy As Single, TotalVaddPhy As Single, SumVadd As Single, sumvadds As Single ', sumcompgr As Single, SumAdjGr As Single
            'Dim SumAdjGDP As Single
            Dim adjgr As Single, SumCaputAdjVadd As Single, shomf As Single ' stcomp As Single, caput_1 As Single,
            Dim vadd_con As Single ', GDPPotPC As Single, ConversionRatio As Single, BaseRatio As Single 'jrs 2014/10/24 , ConversionRatio95 As Single
            Dim ActualGDPInc As Single, NeededGDPInc As Single, NeededNonPhyAdj As Single 'bbh 2017/10/18
            Dim CaputImp, ClimImp As Single 'bbh 2019/03/15
            Dim COVIDShock As Single 'bbh 2020/12/17 Ultimately to add to common as parameter to show years where there is disruptive growth shock
            'jrs 2014/10/24 Dim MaxChange As Single, BaseRatio95 As Single

            WGDP = 0!

            'bbh 2020/12/17 Start COVIDShock below could be replaced by parameter to turn on for 2020-2021, off for other years
            '   but setting it in scenario files could be messy when base years change; must continue to have only
            '  Code here should still work with base years other than 2015
            If IY% = 2 Then
                COVIDShock = 0
            End If
            If IY% - 1 + FirstYear = 2020 And gdprext(USAidx) < 0 Then
                COVIDShock = 1 'checking USA for exogenous negative growth, not ideal but works
            End If
            'bbh 2020/12/17 end

            'ttt 2019/10/08 TakeOut
            Array.Copy(SKS, KS, SKS.Length)

            For R% = 1 To NR%
                'If RegName(R%) = "Solomon Islands" Then Stop
                GDP(R%) = 0!
                GDPRPA(R%) = 0
                GDPPOTRPA(R%) = 0
                GDPPOT(R%) = 0!
                SSPREN(R%) = spri(R%, 2)
                'jrs 2025/12/03
                Dim enpmTot As Single = 1
                Dim ENPTOT, ENPTOTOrg As Single
                ENPTOT = 0
                ENPTOTOrg = 0
                For ee% = 1 To Renew
                    ENPTOT = ENPTOT + ENP(R%, ee%)
                    If enpm(R%, ee%) > 0 And enpm(R%, ee%) <> 1 Then
                        ENPTOTOrg = ENPTOTOrg + ENP(R%, ee%) / enpm(R%, ee%)
                    Else
                        ENPTOTOrg = ENPTOTOrg + ENP(R%, ee%)
                    End If
                Next ee%
                If ENPTOT <> ENPTOTOrg Then
                    'there's a scenario
                    enpmTot = ENPTOT / ENPTOTOrg
                End If


                '   All but First 2:  Gross Production
                '   ----------------------------------
                'ttt 2019/10/08 TakenOut
                'For S% = 1 To NSec%
                '    KS(R%, S%) = SKS(R%, S%)
                'Next S%

                'If RegName$(R%) = "Unitd Kingdm" Then Stop
                'egdppcp = SGDPPOTPCDALF(R%) * (1 + igdpr(R%)) / POP(R%)
                egdppcp = SGDPPOTPCDALF(R%) * (1 + igdprcor(R%)) / POP(R%)
                TbName$ = "GDP/Capita (PPP) Versus Cobb-Douglas Alpha (GTAP 5)"

                '        Call XYTABL(TBName$, GDPPCIP(R%), CDALF(R%))
                ' If RegName$(R%) = "Austria" Then Stop

                Call XYTABL(TbName$, egdppcp, CDALF(R%), context)
                'jrs 2024/10/10 If GRPS(1, R) = "United States Of America" And FirstYear + IY - 1 >= 2125 Then Stop
                CDALF(R%) = AMAX(0.05, Amin(CDALF(R%) / 100, 1))
                'CDALF(R%) = AMAX(0.2, Amin(CDALF(R%) / 100, 1)) 'bbh 2024/10/10 Replace this with line above, earlier commented out
                'CDALF(R%) = CDALFi(R%) 'bbh 2024/10/10 moving away from problematic function above that drops CDALF so much long-term and in SSP5
                'But the use of CDALFi causes huge growth in GDP compared to base as it was, especially in 2200 runs

                'bbh 2019/03/15 start
