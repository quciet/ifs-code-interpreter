    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex830AllButFirst:PovertyNormalizeGender
' Private Sub PovertyNormalizeGender(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, PovGndRatioVec(,) As Single, Optional StartAG% = 1, Optional EndAG% = TotPovAGCount)
    
                'mti 2021/12/28 Take entire procedure
                'mti 2021/01/29 Take entire procedure R%%, POVRATE830(), POVCOUNT830(), povnational_hc As Single
    
                'mti 2020/03/18 Whole procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
    
                Dim j As Integer, NormFac As Single
    
                For j% = StartAG% To EndAG% '1 To TotPovAGCount
                    'Debug.Print j%
                    If POVCOUNT830(R%%, j%, Total) = 0 Or (POVRATE830(R%%, j%, Male) = 0 And POVRATE830(R%%, j%, Female) = 0) Then
                        POVCOUNT830(R%%, j%, Male) = 0
                        POVCOUNT830(R%%, j%, Female) = 0
                        POVRATE830(R%%, j%, Male) = 0
                        POVRATE830(R%%, j%, Female) = 0
                        PovGndRatioVec(R%%, j%) = 1
    
                    Else
                        'Get headcounts by gender using rates and population by gender
                        POVCOUNT830(R%%, j%, Female) = POVRATE830(R%%, j%, Female) * POPPOVAG(R%%, j%, Female) / 100
                        POVCOUNT830(R%%, j%, Male) = POVRATE830(R%%, j%, Male) * POPPOVAG(R%%, j%, Male) / 100
    
                        'Compute normalization factor
                        'mti 2020/03/18 start
                        'NormFac = POVCOUNT830(R%%, j%, Total) / AMAX(0.0001, (POVCOUNT830(R%%, j%, Male) + POVCOUNT830(R%%, j%, Female)))
                        NormFac = POVCOUNT830(R%%, j%, Total) / AMAX(0.000001, (POVCOUNT830(R%%, j%, Male) + POVCOUNT830(R%%, j%, Female)))
    
    
                        'Normalize headcounts
                        'mti 2021/07/15 start
                        POVCOUNT830(R%%, j%, Female) = CSng(Amin(POPPOVAG(R%%, j%, Female), Round(POVCOUNT830(R%%, j%, Female) * NormFac, 6)))
                        POVCOUNT830(R%%, j%, Male) = CSng(Amin(POPPOVAG(R%%, j%, Male), AMAX(0, Round(POVCOUNT830(R%%, j%, Total) - POVCOUNT830(R%%, j%, Female), 6))))
    
                        'Just in case male had to be bounded at 100; give all of the remainder to female
                        POVCOUNT830(R%%, j%, Female) = CSng(AMAX(0, Round(POVCOUNT830(R%%, j%, Total) - POVCOUNT830(R%%, j%, Male), 6)))
                        'mti 2021/07/15 end
    
                        '            POVCOUNT830(R%%, j%, Male) = Round(POVCOUNT830(R%%, j%, Male) * NormFac, 6)
                        '            POVCOUNT830(R%%, j%, Female) = AMAX(0, Round(POVCOUNT830(R%%, j%, Total) - POVCOUNT830(R%%, j%, Male), 6))
    
    
    
                        'recompute (normalized) rates by gender
                        POVRATE830(R%%, j%, Female) = 100 * POVCOUNT830(R%%, j%, Female) / AMAX(0.000001, POPPOVAG(R%%, j%, Female))
                        POVRATE830(R%%, j%, Male) = 100 * POVCOUNT830(R%%, j%, Male) / AMAX(0.000001, POPPOVAG(R%%, j%, Male))
    
                        'Compute gender ratio
                        '            If POVRATE830(R%%, j%, Female) = 0 Or POVRATE830(R%%, j%, Male) = 0 Then
                        '                PovGndRatioVec(R%%, j%) = 1
                        '            Else
    
                        'PovGndRatioVec(R%%, j%) = POVRATE830(R%%, j%, Female) / POVRATE830(R%%, j%, Male)  '0.001
                        'less than half a percent poverty in either group consisdered as equal poverty
                        PovGndRatioVec(R%%, j%) = AMAX(0.005, POVRATE830(R%%, j%, Female)) / AMAX(0.005, POVRATE830(R%%, j%, Male)) '0.001
                        '                If PovGndRatioVec(R%%, j%) > 15 Then Stop
    
                        '            End If
                        'mti 2020/03/18 End
                    End If
                Next j%
    
    
                'mti 2020/03/25 Start
                If POVCOUNT830(R%%, TotPovAGCount, Total) = 0 Then
                    POVCOUNT830(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT830(R%%, TotPovAGCount, Female) = 0
                    POVRATE830(R%%, TotPovAGCount, Male) = 0
                    POVRATE830(R%%, TotPovAGCount, Female) = 0
                    PovGndRatioVec(R%%, TotPovAGCount) = 1
                Else
                    'If RegName(R%%) = "India" Then Stop
                    POVCOUNT830(R%%, TotPovAGCount, Male) = 0
                    POVCOUNT830(R%%, TotPovAGCount, Female) = 0
                    For j% = 1 To TotPovAGCount - 1
                        POVCOUNT830(R%%, TotPovAGCount, Male) = POVCOUNT830(R%%, TotPovAGCount, Male) + POVCOUNT830(R%%, j%, Male)
                        POVCOUNT830(R%%, TotPovAGCount, Female) = POVCOUNT830(R%%, TotPovAGCount, Female) + POVCOUNT830(R%%, j%, Female)
                    Next j%
    
    
    
                    POVRATE830(R%%, TotPovAGCount, Male) = 100 * POVCOUNT830(R%%, TotPovAGCount, Male) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Male))
                    POVRATE830(R%%, TotPovAGCount, Female) = 100 * POVCOUNT830(R%%, TotPovAGCount, Female) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Female))
                    PovGndRatioVec(R%%, TotPovAGCount) = AMAX(0.005, POVRATE830(R%%, TotPovAGCount, Female)) / AMAX(0.005, POVRATE830(R%%, TotPovAGCount, Male)) '0.001
