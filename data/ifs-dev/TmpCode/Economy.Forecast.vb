    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex32FirstYear:PovertyAdjGenderRatio
' Private Sub PovertyAdjGenderRatio(R%, PovRateVec(,,) As Single, AGCount As Integer)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - new procedure
                '(R%%, POVRATE32(), PovCountVec(), povnational_hc As Single)
                Dim AdjPovDiff As Single
                Dim j%
    
                'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                For j% = 1 To TotPovAGCount
                    If POVRATE32(R%%, j, Female) - POVRATE32(R%%, j, Male) > 1.5 * POVRATE32(R%%, j, Total) Then
                        AdjPovDiff = CSng((POVRATE32(R%%, j, Female) - POVRATE32(R%%, j, Male)) - 1.5 * POVRATE32(R%%, j, Total))
                        POVRATE32(R%%, j, Female) = POVRATE32(R%%, j, Female) - AdjPovDiff / 2
                        POVRATE32(R%%, j, Male) = POVRATE32(R%%, j, Male) + AdjPovDiff / 2
                    ElseIf POVRATE32(R%%, j, Female) - POVRATE32(R%%, j, Male) < -1.5 * POVRATE32(R%%, j, Total) Then   '1.5
                        AdjPovDiff = CSng((POVRATE32(R%%, j, Female) - POVRATE32(R%%, j, Male)) + 1.5 * POVRATE32(R%%, j, Total))
                        POVRATE32(R%%, j, Female) = POVRATE32(R%%, j, Female) + AdjPovDiff / 2
                        POVRATE32(R%%, j, Male) = POVRATE32(R%%, j, Male) - AdjPovDiff / 2
                    End If
    
                    '           'make sure there is at least some poverty in each gender
                    POVRATE32(R%%, j%, Male) = AMAX(POVRATE32(R%%, j%, Female) * 0.2, POVRATE32(R%%, j%, Male))
                    POVRATE32(R%%, j%, Female) = AMAX(POVRATE32(R%%, j%, Male) * 0.2, POVRATE32(R%%, j%, Female))
    
                Next j%
    
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSex32FirstYear:PovertyAdjGenderRatio
