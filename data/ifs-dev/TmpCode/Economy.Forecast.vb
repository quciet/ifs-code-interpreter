                End If




                'All But First: Compute Gender Difference and Poverty Rates by Sex
                '---------------------------------------------------------------------

                'use regression model done by Yutang to forecast gender difference in poverty in reference group (=25-34)
                'PovGndDiffRef = 2.1391 - .9123 * LabWageSexRatio  -0.6947 * EdTerEnrollGross%FtoM + 0.0583 * 100 * POVMIDHIGH(R%) / POP(R%) -0.5863* GEM
                'Gender difference in percentage points = Female Poverty Rate for the age group - Male poverty rate for the age group
                'Setting the co-eff of national poverty rate to zero per BBH and DKB, thus making the whole regression relationship questionable

                If POVMIDHIGH(R%) = 0 Then 'no poverty
                    PovGndDiffRefAG = 0
                Else
                    'mti 2021/12/02 start

                    'mti 2021/12/09 start
                    'old model
                    'PovGndDiffRefAGComp = 0.374873505136305 - 0.118922278178841 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    '+ 1.61325904049342 * Log(AMAX(0.001, CBR(R%))) - 3.47318707075832 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 1.82274427824389 * Log(AMAX(0.001, EDYRSAG20TO29(R%, Female)))

                    'mti 2026/07/05 start
                    'earlier regresssion from DB
                    ''DB Revised Regression
                    'PovGndDiffRefAGComp = CSng(-4.48628245082222 + 3.14560964152763 * Log(AMAX(0.001, GINIDOM(R%))) +
                    '        2.95337035687509 * Log(AMAX(0.001, 100 * POPLE15(R%) / POP(R%))) - 3 * Log(LABWAGESEXRAT(R%)) - 1.04253358408289 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / AMAX(0.0001, EDYRSAG15(R%, Male)))))

                    ''mti 2021/12/09 End

                    'Regression with new data: t-stat low and sign counterintuitive for POPLE15 share and WageSexRatio; so dropped those two; R-squared is still very low
                    PovGndDiffRefAGComp = CSng(3.06074790345258 + 1.24168577812169 * Log(AMAX(0.001, GINIDOM(R%))) -
                                2.16672903164361 * Log(AMAX(0.001, EDYRSAG25(R%, Female) / AMAX(0.0001, EDYRSAG25(R%, Male)))))
                    'mti 2026/07/05 end

                    'new model
                    'PovGndDiffRefAGComp = -7.02169351621106 - 0 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    ' + 3.23633235710923 * Log(AMAX(0.001, CBR(R%))) - 0 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 0.927868342951644 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / EDYRSAG15(R%, Male)))



                    PovGndDiffRefAGComp = AMAX(0, PovGndDiffRefAGComp) ' * PovGndDiffRefAGScaleUp830(R%))


                    If iPovGndDiffAG830(R%, RefAGGnd) < 0 Then 'mti 2021/12/02 start
                        PovGndDiffRefAG = ConvergeOverTime(iPovGndDiffAG830(R%, RefAGGnd), 0, CSng(Amin(50, AMAX(10, Floor(iPovGndDiffAG830(R%, RefAGGnd) * 3)))))
                    Else
                        PovGndDiffRefAG = PovGndDiffRefAGComp + ConvergeOverTime(PovGndDiffRefAGShift830(R%), 0, 50)
                    End If
                    'mti 2021/12/02 end
                End If
                '
                'use gender gap and total (both sexes) poverty to compute female and male poverty rates - reference age group
                If POVRATE830(R%, RefAGGnd, Total) = 0 Then
                    POVRATE830(R%, RefAGGnd, Male) = 0
                    POVRATE830(R%, RefAGGnd, Female) = 0
                Else

                    '           'For gender distribution of very low poverty make sure there is some poverty in each of the sexes
                    If PovGndDiffRefAG >= 0 Then
                        PovGndDiffRefAG = CSng(Amin(PovGndDiffRefAG, 1.5 * POVRATE830(R%, RefAGGnd, Total))) '1.5

                    Else
                        PovGndDiffRefAG = CSng(AMAX(PovGndDiffRefAG, -1.5 * POVRATE830(R%, RefAGGnd, Total)))  '-1.5
                    End If

                    'Use gender difference and total poverty to compute poverty rates for each of the sexes
                    POVRATE830(R%, RefAGGnd, Male) = AMAX(0, (POVRATE830(R%, RefAGGnd, Total) * POPPOVAG(R%, RefAGGnd, Total) - PovGndDiffRefAG * POPPOVAG(R%, RefAGGnd, Female)) / AMAX(0.000001, POPPOVAG(R%, RefAGGnd, Total)))
                    POVRATE830(R%, RefAGGnd, Female) = AMAX(0, PovGndDiffRefAG + POVRATE830(R%, RefAGGnd, Male))

                    '            'once again, make sure there is at least some poverty in each gender
                    POVRATE830(R%, RefAGGnd, Male) = AMAX(POVRATE830(R%, RefAGGnd, Female) * 0.2, POVRATE830(R%, RefAGGnd, Male))
                    POVRATE830(R%, RefAGGnd, Female) = AMAX(POVRATE830(R%, RefAGGnd, Male) * 0.2, POVRATE830(R%, RefAGGnd, Female))

                End If

                'Gender difference for the reference group - final
                PovGndDiffRefAG = POVRATE830(R%, RefAGGnd, Female) - POVRATE830(R%, RefAGGnd, Male)

                'Compute percentage change in reference group gender difference
                'mti 2021/07/15 start
                If iPovGndDiffAG830(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG830(R%, RefAGGnd)) > 0.9 Then     'changed .2 to .9
                    'mti 2021/07/15 end
                    PcntChangeDiffRefAG = (PovGndDiffRefAG - iPovGndDiffAG830(R%, RefAGGnd)) / iPovGndDiffAG830(R%, RefAGGnd)
                Else
                    'use percentage point when initial difference is zero or small
                    PcntPointChangeDiffRefAG = PovGndDiffRefAG - iPovGndDiffAG830(R%, RefAGGnd)
                End If


                'Compute gender difference (and poverty rate) in other age-groups using changes in reference group gender difference
                For j% = 1 To TotPovAGCount

                    If j% <> RefAGGnd Then

                        If POVRATE830(R%, j%, Total) = 0 Then
                            POVRATE830(R%, j%, Male) = 0
                            POVRATE830(R%, j%, Female) = 0
                        Else

                            'mti 2021/07/15 start
                            If iPovGndDiffAG830(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG830(R%, RefAGGnd)) > 0.9 Then ' changed .2 to .9
                                'mti 2021/07/15 end
                                PovGndDiffAG = iPovGndDiffAG830(R%, j%) + PcntChangeDiffRefAG * iPovGndDiffAG830(R%, j%)
                            Else
                                PovGndDiffAG = iPovGndDiffAG830(R%, j%) + PcntPointChangeDiffRefAG
                            End If

                            'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                            If PovGndDiffAG >= 0 Then
                                PovGndDiffAG = CSng(Amin(PovGndDiffAG, 1.5 * POVRATE830(R%, j, Total)))
                            Else
                                PovGndDiffAG = CSng(AMAX(PovGndDiffAG, -1.5 * POVRATE830(R%, j, Total)))
                            End If

                            'mti 2020/04/29 Start
                            'POVRATE830(R%, j%, Male) = AMAX(0, (POVRATE830(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / POPPOVAG(R%, j%, Total))
                            POVRATE830(R%, j%, Male) = AMAX(0, (POVRATE830(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / AMAX(0.000001, POPPOVAG(R%, j%, Total)))
                            'mti 2020/04/29 End
                            POVRATE830(R%, j%, Female) = AMAX(0, PovGndDiffAG + POVRATE830(R%, j%, Male))
                            '
                            'Make sure there is at least some poverty in each gender
                            POVRATE830(R%, j%, Male) = AMAX(POVRATE830(R%, j%, Female) * 0.2, POVRATE830(R%, j%, Male))
                            POVRATE830(R%, j%, Female) = AMAX(POVRATE830(R%, j%, Male) * 0.2, POVRATE830(R%, j%, Female))


                        End If



                    End If

                Next j%
                'mti 2020/03/18 End


