                '   - is in essence an unbalanced set of initial conditions in LDCs.  Real world or data-based?
                '       C(R%) = AMAX(0.5 * C(R%), C(R%) * cramul(R%) * mulcon(R%) * Mul + immadj)
                'If ExcessSt(R%) < 0 Or cramul(R%) < 1 Then
                'If GRPS(1, R%) = "Sudan South" And FirstYear + IY - 1 >= 2055 Then Stop
                C(R%) = AMAX(0.5 * C(R%), C(R%) * cramul(R%) * mulcon(R%) * Mul + immadj)
                'End If
                'bbh 2020/07/14 end

                If C(R%) / POP(R%) < CPCI(R%) AndAlso CPCI(R%) < 0.15 Then
                    'Don't let C per capita fall below very low level
                    '   which can result in C,Ag cut back below starvation level
                    C(R%) = Amin(CHold, CPCI(R%) * POP(R%))
                End If

                'If RegName$(R%) = "Nigeria" Then Stop
                'If GRPS(1, R%) = "Iraq" And FirstYear + IY - 1 = 2033 Then Stop
                consumtotal = AMAX(0.0001, consumhh(R%, Unskilled) + consumhh(R%, Skilled))
                consumhh(R%, Unskilled) = consumhh(R%, Unskilled) / consumtotal * C(R%)
                consumhh(R%, Skilled) = consumhh(R%, Skilled) / consumtotal * C(R%)

                '       All but First 3:  Investment Rate Changes to Maintain Physical Balances
                '       ------------------------------------------------------------------------

                'bbh 2020/07/01 start increase swing of investment with interest rates
                'GDPPCP/2 term allows more volatility of I in countries with very low GDPPCP
                'On 7/14 decreased again somewhat
                '        IPar1 = -Amin(0.9, AMAX(0.2, 0.4 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                '        IPar2 = -Amin(1.8, AMAX(0.4, 0.6 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                'IPar1 = CSng(-Amin(0.9, AMAX(0.5, 0.9 / (AMAX(0.0001, GDPPCP(R%)) / 2))))
                'IPar2 = CSng(-Amin(1.8, AMAX(1.0#, 1.8 / (AMAX(0.0001, GDPPCP(R%)) / 2))))
                '        IPar1 = -Amin(0.6, AMAX(0.1, 0.6 / (GDPPCP(R%) / 2)))
                '        IPar2 = -Amin(1.2, AMAX(0.2, 1.2 / (GDPPCP(R%) / 2)))
                'bbh 2020/07/01 end
                'bbh 2020/07/23 start
                '        IPar1 = -Amin(0.9, AMAX(0.5, 0.9 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                '        IPar2 = -Amin(1.8, AMAX(1#, 1.8 / (AMAX(0.0001, GDPPCP(R%)) / 2)))


                'Uganda related test -- INTR change to additive slowed down change in it
                IPar1 = CSng(-Amin(0.9, AMAX(0.2, 0.4 / (AMAX(0.0001, GDPPCP(R%)) / 2))))
                IPar2 = CSng(-Amin(1.8, AMAX(0.4, 0.6 / (AMAX(0.0001, GDPPCP(R%)) / 2))))
                '        IPar1 = -Amin(0.9, AMAX(0.4, 0.8 / (AMAX(0.0001, GDPPCP(R%)) / 2)))
                '        IPar2 = -Amin(1.8, AMAX(0.8, 1.2 / (AMAX(0.0001, GDPPCP(R%)) / 2)))

                'bbh 2020/07/23 end
                Call ADJSTR(100, Diff1, Diff2, IPar1, IPar2, Mul)
                'jrs 2024/09/26
                'If IY >= 80 Then
                '    Mul = 1
                'End If

                'bbh 2022/10/27 As with impact on C/GDP, use only Mul
                'iramul(R%) = iramul(R%) * Mul
                iramul(R%) = 1

                If IY% = 2 Then
                    smoothsavingsterm(R%) = 1
                Else
                    '            savingsterm = (SmoothSavingsR(R%) / AMAX(0.001, SavingsRI(R%)))
                    '            smoothsavingsterm(R%) = smoothsavingsterm(R%) * 0.8 + savingsterm * 0.2
                End If
                'bbh 2020/07/01 shift more of absorption of excess stocks from C to I
                'immadj = ExcessSt(R%) / 6

                'bbh 2020/07/23 Start
                ''immadj = ExcessSt(R%) / 2
                'immadj = ExcessSt(R%) / 4
                'In short run small changes in IGCF can help address stock surpluses and shortages
                '        If ExcessSt(R%) > 0 Then 'surplus should slightly cut investment or not change it (contrary to lower INTR effect)
                '            immadj = -ExcessSt(R%) / 8  'Let caput change and stock throwaway do most of work
                '        Else 'defict should slightly raise investment or not change it (contrary to higher INTR effect)
                '            immadj = -ExcessSt(R%) / 8
                '        End If

                If ExcessSt(R%) < 0 Then 'deficit should slightly lower investment
                    immadj = AMAX(-irai(R%) * GDPPOTRPA(R%) * 0.1, ExcessSt(R%) / 8)
                    '           iramul(R%) = iramul(R%) + 0.5 * (immadj / (GDP(R%) * irai(R%)))
                Else
                    'immadj = 0
                    immadj = ExcessSt(R%) / 10 'bbh 2022/10/27 /4 for C and C/GDP normally about 2.5 times IGCF/GDP
                End If

                'immadj = 0
                'bbh 2020/07/23 end

                'BBH 7/27/04 Begin
                '        NetFDIRGDP = (SXFDIFIN(R%) - SXFDIFOUT(R%) * xfdioutf) / AMAX(0.0001, GDPPOT(R%))
                NetFDIRGDP = (SXFDIFIN(R%) - SXFDIFOUT(R%) * xfdioutf) / AMAX(0.0001, GDPPOTRPA(R%))
                fditerm = NetFDIRGDP - netfdirgdpi(R%)
                'bbh 2020/07/01 begin
                NetPortfolioRGDP = (SXPORTFIN(R%) - SXPORTFOUT(R%) * xfdioutf) / AMAX(0.0001, GDPPOTRPA(R%))
                portfolioterm = NetPortfolioRGDP - netportfoliorgdpi(R%)
                '        If gdprext(R%) > -70 Then 'bbh 2021/09/21 Turned off portfolio/fdi impacts on IGCF when growth exogenous because lag of one year
                '            'caused perverse behavior with COVID shock; flows dropped year after shock and then surged 2nd year after; e.g. SAfrica issue
                '            'But with it off the post exogenous transient became somewhat worse and 2021-2023 behavior not good, so turned zeros back off
                '            fditerm = 0
                '            portfolioterm = 0
                '        End If 'bbh 2021/09/21 end

                'bbh 2020/07/14 start  'if there are excess stocks and/or low interest rate, can let CAPUT adjustment and
                'stock depreciation take care of it; if shortage, need to adjust C and IGCF
                '        IGCF(R%) = GDPPOT(R%) * (irai(R%) + fditerm) * _
                'smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                '         If ExcessSt(R%) < 0 Or iramul(R%) < 1 Then
                'bbh 2020/07/23 start  - only really swings only with stocks; more in short run than consumption does;
                'but C has basic multiplier terms that allow it to move longer term
                'Shouldn't there be long term movement of this like there is of C; low or high irai should perhaps converge to target?

                'bbh 2020/08/01 begin use of GDPPOTRPA(r%) for some energy/raw materails exporters esp can really mess us response of IGCF
                'IGCF(R%) = GDPPOTRPA(R%) * (irai(R%) + fditerm + portfolioterm) * _
                'smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                '            IGCF(R%) = GDP(R%) * (irai(R%) + fditerm + portfolioterm) * _
                '                smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                'If IY = 19 And GRPS(1, R) = "Israel" Then Stop
                'bbh 2022/08/30 put next line inside if-then
                'bbh 2022/10/17 Converging irai toward global norm over time Start
                'jrs 2024/10/03
                Dim iraiConverge = ConvergeOverTime(irai(R%), 0.25, 100)
                'Dim iraiConverge = ConvergeOverTime(irai(R%), 0.25, 200)
                If gdprext(R%) < -50 Then 'endogenous gdp growth rate
                    IGCF(R%) = GDPPOT(R%) * (iraiConverge + fditerm + portfolioterm) *
                    smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                    'IGCF(R%) = GDPPOT(R%) * (irai(R%) + fditerm + portfolioterm) * _
                    'smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                Else 'exogenous gdp growth rate
                    IGCF(R%) = GDP(R%) * (iraiConverge + fditerm + portfolioterm) *
                     smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                    'IGCF(R%) = GDP(R%) * (irai(R%) + fditerm + portfolioterm) * _
                    'smoothsavingsterm(R%) * iramul(R%) * Mul + immadj
                End If

                'bbh 2022/10/17 Converging irai toward global norm over time End

                'bbh 2020/08/01 end

                'If RegName$(R%) = "Unitd Kingdm" And IY% >= 6 Then Stop

                'IGCF(R%) = GDPPOTRPA(R%) * (irai(R%) + fditerm + portfolioterm) + immadj
                'bbh 2020/07/23 end
                '         Else
                '            IGCF(R%) = GDPPOTRPA(R%) * (irai(R%) + fditerm + portfolioterm)
                '         End If
                'bbh 2020/07/14 end


                'If RegName$(R%) = "Congo, Democratic Republic of" And IY% >= 17 Then Stop
                'bbh 2020/07/01 end
                'IGCF(R%) = GDPPOTRPA(R%) * (irai(R%) + fditerm) * _
                'smoothsavingsterm(R%)


                'If RegName$(R%) = "Israel" Then Stop
                'BBH 7/27/04 End
                'Almost certainly need something like Immadj on capital spending; also link to
                '   savings as in smoothsavingsterm
                'work on again with more stable overall model behavior
                'bbh 2020/08/10 Start Need to relax growth in IGCF given short-term downward shock of COVID
                'Code change basically removes any constraint; not clear if should still keep some
                GDPRMAX = CSng(1 + SmoothGDPRPAR(R%) + 0.5)
                'GDPRMAX = Csng(1 + SmoothGDPRPAR(R%) + 0.05)
                'bbh 2020/08/10 end
                '        IGCF(R%) = Amin(SIGCF(R%) * 1.09, IGCF(R%))
                IGCF(R%) = Amin(SIGCF(R%) * GDPRMAX, IGCF(R%))
                'If RegName$(R%) = "Congo, Democratic Republic of" And IY% >= 40 Then Stop
                '        SIRA(R%) = AMAX(0.05, Amin(IGCF(R%) / AMAX(0.0001, GDPPOT(R%)), 0.4))
                'bbh 2022/08/30 put next line inside if-then
                If gdprext(R%) < -50 Then 'endogenous gdp growth rate
                    sira(R%) = CSng(AMAX(0.05, Amin(IGCF(R%) / AMAX(0.0001, GDPPOTRPA(R%)), 0.4)))
                Else 'exogenous gdp growth rate
                    sira(R%) = CSng(AMAX(0.05, Amin(IGCF(R%) / AMAX(0.0001, GDP(R%)), 0.4)))
                End If

                'BBH August 19, 2009 Begin
                'bbh 2022/10/17 Start removal of demographics from impact on IGCF and C;
                '   earlier treatment of life cycle did C impact and IGCF affected already via ST and INTR by C/HHSAV tradeoff

                '       All but First 3:  Investment/Consumption Trade-Off from Exogenous Multiplier
                '       ----------------------------------------------------------------------------


                '        Call XYTABL("GDP/Capita (PPP) Versus Life Expectancy (2000)", _
                'GDPPCP(R%), lifeexpcomp)
                'bbh 2013/08/03 start; bound growth in life expectancy gap to avoid spike
                '        If IY% = 2 Then
                '            lifexpgap = lifexpgapi(R%)
                '        Else
                '            lifexpgap = Amin(SLIFEXP(R%) - lifeexpcomp, SLifExpGap(R%) + 2)
                '        End If
                'bbh 2013/08/10
                'lifeadjrate = AMAX(-0.3, Amin(0.3, (lifexpgap - lifexpgapi(R%)) * 0.1)) 'mfplife
                '        lifeadjrate = AMAX(-0.1, Amin(0.1, (lifexpgap - lifexpgapi(R%)) * 0.01)) 'mfplife
                '        lifexpterm = IGCF(R%) * lifeadjrate
                '        SLifExpGap(R%) = lifexpgap
                'LifExpTerm = IGCF(R%) * AMAX(-0.3, Amin(0.3, ((SLIFEXP(R%) - lifeexpcomp) - LifExpGapI(R%)) * 0.1)) 'mfplife
                'bbh 2013/08/03 end

                invm(R%) = CSng(AMAX(0.5, Amin(1.5, invm(R%))))
                iadj = IGCF(R%) * (invm(R%) - 1) ' + lifexpterm
                IGCF(R%) = IGCF(R%) + iadj '+ SavingsAgeAdj(R%) 'Age structure adjustment term from IFsPop
                C(R%) = C(R%) - iadj
                'If RegName$(R%) = "Nigeria" Then Stop


                '       All but First 3:  Bounds
                '       ------------------------

                'IGCF(R%) = AMAX(0.05 * GDPPOT(R%), Amin(IGCF(R%), 0.4 * GDPPOT(R%)))
                'IUppBound = AMAX(IRA(R%), 0.4)
                'bbh 2022/10/17 0.4 was too low for China base year and three others; raised to 0.45
                IUppBound = 0.45

                '        IGCF(R%) = AMAX(0.1 * GDPPOT(R%), Amin(IGCF(R%), IUppBound * GDPPOT(R%)))
                'bbh 2022/08/30 put next line inside if-then
                If gdprext(R%) < -50 Then 'endogenous gdp growth rate
                    IGCF(R%) = AMAX(0.1 * GDPPOTRPA(R%), Amin(IGCF(R%), IUppBound * GDPPOTRPA(R%)))
                Else 'exogenous gdp growth rate
                    IGCF(R%) = AMAX(0.1 * GDP(R%), Amin(IGCF(R%), IUppBound * GDP(R%)))
                End If
                'bbh 2022/10/14 Not adjusting by age here any more
                'SIGCF(R%) = IGCF(R%) - lifexpterm - SavingsAgeAdj(R%) 'Don't make demographic impact cumulative
                SIGCF(R%) = IGCF(R%) 'Don't make demographic impact cumulative
                'bbh 2022/10/17 End removal of demographics from impact on IGCF and C
                'BBH August 19, 2009 End

                'bbh 2020/08/29
                conbase = AMAX(0.001, (hhincunskilled + hhincskilled))
                'conbase = AMAX(0.001, (hhdispincperm(R%, Unskilled) + hhdispincperm(R%, Skilled)))
                'If RegName$(R%) = "Ethiopia" And IY% >= 25 Then Stop
                'CLowBound = Amin(temp1 / 100, AMAX(CTotRaI(R%) - 0.3, Amin(0.4, CTotRaI(R%))))
                '        bbh 2022/10/27 Set lower limits on C/GDP - Burundi, CAR, and Seychelles hitting earlier
                If GDPPCP(R%) < 10 Then
                    CLowBound = CSng(Amin(TEMP1 / 100, AMAX(Amin(0.5, CTotRaI(R%) - 0.3), Amin(0.4, CTotRaI(R%)))))
                Else
                    CLowBound = CSng(Amin(TEMP1 / 100, AMAX(Amin(0.4, CTotRaI(R%) - 0.3), Amin(0.35, CTotRaI(R%)))))
                End If

                'If IY% + 2016 = 2052 And (RegName$(R%) = "Burundi" Or RegName$(R%) = "Seychelles" Or RegName$(R%) = "Central African Republic") Then Stop
                '        C(R%) = AMAX(CLowBound * GDPPOT(R%), Amin(C(R%), 1.4 * conbase))
                'bbh 2013/11/01 start
                UpBoundC = ConvergeOverTime(1.8, 1.4, 20)
                'C(R%) = AMAX(CLowBound * GDPPOTRPA(R%), Amin(C(R%), UpBoundC * conbase))
                C(R%) = AMAX(CLowBound * GDPPOT(R%), Amin(C(R%), UpBoundC * conbase)) 'bbh 2022/06/23 replaced above line
                'C(R%) = AMAX(CLowBound * GDPPOTRPA(R%), Amin(C(R%), 1.4 * conbase))
                'bbh 2013/11/01 end

                'If RegName$(R%) = "Nigeria" Then Stop

                'C(R%) = AMAX(0.1 * conbase, Amin(C(R%), 1.4 * conbase))
                'If RegName$(R%) = "Congo, Democratic Republic of" And IY% > 46 Then Stop

                '       All but First 3:  Ratios
                '       ------------------------

                '        IRA(R%) = IGCF(R%) / AMAX(0.0001, GDPPOT(R%))
                IRA(R%) = IGCF(R%) / AMAX(0.0001, GDPPOTRPA(R%))
                'bbh 2022/08/30 put next line inside if-then
                If gdprext(R%) < -50 Then 'endogenous gdp growth rate
                    IRA(R%) = IGCF(R%) / AMAX(0.0001, GDPPOTRPA(R%))
                Else 'exogenous gdp growth rate
                    IRA(R%) = IGCF(R%) / AMAX(0.0001, GDP(R%))
                End If

                'If RegName$(R%) = "Madagascar" And IY% >= 10 Then Stop
                'If RegName$(R%) = "Qatar" And IY% >= 33 Then Stop
                'If GRPS(1, R%) = "Iraq" And FirstYear + IY - 1 = 2033 Then Stop
                consumtotal = AMAX(0.0001, consumhh(R%, Unskilled) + consumhh(R%, Skilled))
                consumhh(R%, Unskilled) = consumhh(R%, Unskilled) / consumtotal * C(R%)
                consumhh(R%, Skilled) = consumhh(R%, Skilled) / consumtotal * C(R%)

                'bbh 2020/08/29 2 lines replaced
                CRA(R%, Unskilled) = consumhh(R%, Unskilled) / AMAX(0.0001, hhincunskilled)
                CRA(R%, Skilled) = consumhh(R%, Skilled) / AMAX(0.0001, hhincskilled)
                '        CRA(R%, Unskilled) = consumhh(R%, Unskilled) / AMAX(0.0001, hhdispincperm(R%, Unskilled))
                '        CRA(R%, Skilled) = consumhh(R%, Skilled) / AMAX(0.0001, hhdispincperm(R%, Skilled))

                'mti 2018/05/22 start
                'bbh 2020/08/26
                CRA(R%, NSkill) = (consumhh(R%, Unskilled) + consumhh(R%, Skilled)) / AMAX(0.001, (conbase))
                'CRA(R%, NSkill) = (consumhh(R%, Unskilled) + consumhh(R%, Skilled)) / AMAX(0.001, (hhdispinc(R%, Unskilled) + hhdispinc(R%, Skilled)))
                'mti 2018/05/22 End

                'bbh 2020/07/23 start - move scra up higher so that picks up distal forces, but not proximate from INTR, Excess stocks
                scra(R%, Unskilled) = CRA(R%, Unskilled) 'bbh 2020/08/22 changed back to using it here
                scra(R%, Skilled) = CRA(R%, Skilled)
                'bbh 2020/07/23 end
            Next R%
        End Sub
        Public Sub ifsECOSAM4AllbutFirstYear(context As IForecastContext)
            'VB6: IFsEcoSAM
            'call4:
            '   All but First 4:  Expenditure Components by Origin Sector - Consumption
            '   -----------------------------------------------------------------------
            'jrs 2014/09/16
            Dim ConsumDetermined As Single, IncreaseC As Single, MinIGCF As Single, ProblemAmt As Single, DecreaseG As Single, SumCS As Single
            'bbh 2020/07/01 Change HHFirmSavTarget from Integer to Single
            'gvdb 2024/04/05
            ' unused variable
            Dim residc As Single ' , rpaadj As Single, firmsavadj As Single, govbaladj As Single, hhfirmsavr As Single, HHFirmSavTarget As Single
            'Dim HHSAVENEEDUSE As Single

            For R% = 1 To NR%
                '       All but First 4:  Adjust Consumption if Agricultural/Energy Submodels Need More
                '       -------------------------------------------------------------------------------

                If (agon > 0.5) OrElse (enon > 0.5) Then
                    'Needs to be in call4: because call2 to IFsAg computes CS
                    '    If RegName$(R%) = "Benin" Then Stop
                    ConsumDetermined = 0
                    If agon > 0.5 Then
                        ConsumDetermined = ConsumDetermined + CS(R%, 1)
                    End If
                    If enon > 0.5 Then
                        ConsumDetermined = ConsumDetermined + CS(R%, 2)
                    End If
                    If ConsumDetermined > 0.95 * C(R%) Then 'Bring down I somewhat to support c
                        IncreaseC = ConsumDetermined - 0.95! * C(R%)
                        MinIGCF = 0.03! * GDPPOTRPA(R%)
                        If IGCF(R%) - IncreaseC < MinIGCF Then 'Increase C less, take some from Ag,En
                            ProblemAmt = MinIGCF - (IGCF(R%) - IncreaseC)
                            CS(R%, 1) = CS(R%, 1) - ProblemAmt * CS(R%, 1) / ConsumDetermined
                            CS(R%, 2) = CS(R%, 2) - ProblemAmt * CS(R%, 2) / ConsumDetermined
                            IncreaseC = IncreaseC - ProblemAmt
                            IncreaseC = AMAX(0, IncreaseC)
                        End If
                        'If RegName$(R%) = "Congo, Democratic Republic of" And IY% > 40 Then Stop
                        IGCF(R%) = IGCF(R%) - IncreaseC
                        If IGCF(R%) < 0.05 * GDPPOTRPA(R%) Then
                            DecreaseG = CSng(Amin(0.05 * GDPPOTRPA(R%) - IGCF(R%), 0.3 * GOVCON(R%)))
                            GOVCON(R%) = GOVCON(R%) - DecreaseG
                            IGCF(R%) = IGCF(R%) + DecreaseG
                        End If

                        'IGCF(R%) = AMAX(0.001 * GDPPOT(R%), IGCF(R%) - IncreaseC)
                        C(R%) = C(R%) + IncreaseC
                        'If RegName$(R%) = "Nigeria" Then Stop
                    End If
                End If

                'bbh 2021/06/01 start
                '       All but First 4:  Adjust Consumption if Remittances have risen relative to Base Case
                '       -----------------------------------------------------------------------------------
                '                ReDim DeathsBase(IY)
                '                frm_MainMenu.IFsGUIctrl1.getLoadForDisplay "DEATHS", -1, GRPS(1, R%), R%, "", -1, "", -1, _
                '                "", 1, True, True, False, 1, DeathsBase, 1, 1, FirstYear, FirstYear + IY - 1, _
                '                0, True, "", False
                '                If DeathsBase(IY) > 0 Then
                If NotBaseRun > 0.5 Then
                    ReDim REMITBASE(IY)
                    If dfBaseXWORKREMIT.RowCount > (IY - 1) * NR Then
                        REMITBASE(IY) = CSng(dfBaseXWORKREMIT(getDataFrameIdxFromDims(CShort(FirstYear + IY - 1), FirstYear, CShort(R), CShort(NR))))
                    End If

                    If XWORKREMIT(R%) - REMITBASE(IY) > 0.001 * C(R%) Then
                        'If RegName$(R%) = "Yemen" Then Stop
                        C(R%) = CSng(C(R%) + Amin(0.1 * C(R%), XWORKREMIT(R%) - REMITBASE(IY)))
                        'bbh 2021/06/15 C(R%) = Amin(C(R%), HHINCDIS(R%, Unskilled) + HHINCDIS(R%, Skilled))
                    End If
                End If
                'bbh 2021/06/01 end

                'If RegName$(R%) = "Qatar" And IY% >= 33 Then Stop
                '       All but First 4:  Compute Total CS
                '       ----------------------------------

                'bbh 2019/03/09 delete start
                '        For S% = 1 To NSec% 'Needs to be in call4: because call2 to IFsAg computes CS
                '            If ((S% > Ener) Or (S% = Agri And agon < 0.5) Or (S% = Ener And enon < 0.5)) Then
                '                CS(R%, S%) = sminex(R%, S%) + smarbd(R%, S%) * (C(R%) - sfloor(R%))
                '                CS(R%, S%) = AMAX(0.2 * sminex(R%, S%), CS(R%, S%))
                ''If RegName$(R%) = "Afghanistan" And S% = 6 Then Stop
                '            End If
                '        Next S%
                ''    If IY% > 36 And RegName$(R%) = "Tajikistan" Then Stop
                '
                '        SumCS = 0
                '        For S% = 3 To NSec%
                '            SumCS = SumCS + CS(R%, S%)
                '        Next S%
                '        residc = C(R%) - CS(R%, 1) - CS(R%, 2)
                '        If residc < 0.1 * C(R%) Then
                '            IncreaseC = 0.1 * C(R%) - residc
                ''            MinIGCF = 0.001 * GDPPOT(R%)
                '            MinIGCF = 0.05 * GDPPOTRPA(R%)
                '            If IGCF(R%) - IncreaseC < MinIGCF Then
                '                IncreaseC = IncreaseC - (MinIGCF - (IGCF(R%) - IncreaseC))
                '                IncreaseC = AMAX(0, IncreaseC)
                '            End If
                ''If RegName$(R%) = "Congo, Democratic Republic of" And IY% > 40 Then Stop
                '            IGCF(R%) = IGCF(R%) - IncreaseC
                '            C(R%) = C(R%) + IncreaseC
                '            residc = C(R%) - CS(R%, 1) - CS(R%, 2)
                ''    If IY% > 36 And RegName$(R%) = "Tajikistan" Then Stop
                '            residc = AMAX(0.001, residc)
                '        End If
                '        For S% = 3 To NSec% 'Normalize nonphysical sectors to remainder of C
                '            'Mul = AMAX(C(R%) * 0.1, (C(R%) - CS(R%, 1) - CS(R%, 2)))
                '            CS(R%, S%) = CS(R%, S%) / AMAX(0.001, SumCS) * residc 'Mul
                ''If RegName$(R%) = "Afghanistan" And S% = 6 Then Stop
                '
                '        Next S%
                'bbh 2019/03/09 delete end

                'If RegName$(R%) = "Nigeria" Then Stop
                consumtotal = AMAX(0.0001, consumhh(R%, Unskilled) + consumhh(R%, Skilled))
                consumhh(R%, Unskilled) = consumhh(R%, Unskilled) / consumtotal * C(R%)
                consumhh(R%, Skilled) = consumhh(R%, Skilled) / consumtotal * C(R%)



                ' bbh 2019/03/09 start revised section
                '       All but First 4:  Compute CS by sector and skill level
                '       ------------------------------------------------------

                '         SumCSU = 0
                '         SumCSS = 0
                'bbh 2021/05/15 start HHINC to HHINCDIS
                For HHType% = 1 To 2
                    For S% = 1 To NSec%
                        ' CSHHU(R%, S%) = CS(R%, S%) * consumhh(R%, Unskilled) / C(R%)
                        'CSHHS(R%, S%) = CS(R%, S%) * consumhh(R%, Skilled) / C(R%)
                        If S% = 1 Then
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, AG (2015 Model) Log",
                            'HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_AG_AS_PCT_C, HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)

                            '                    Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, AG (2015 Model) Log", _
                            '                      HHINCPCI(R%, HHType%), CsComp) 'bbh 2020/12/27

                            'HHPOP computed in All but First 5; Might be possible to advance?
                            CsComp = AMAX(0.02, CsComp)
                        ElseIf S% = 2 Then
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, EN (2015 Model) Linear",
                            'HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_EN_AS_PCT_C, HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)

                            '                    Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, EN (2015 Model) Linear", _
                            '                      HHINCPCI(R%, HHType%), CsComp) 'bbh 2020/12/27

                            CsComp = AMAX(0.03, CsComp)
                        ElseIf S% = 3 Then
                            ' CsComp = 0.00001 'bbh 2024/06/22 Replaced this with same logic and function as for energy, new code just below
                            Call XYTABL(TblFuncNameCS_EN_AS_PCT_C, HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)
                            CsComp = AMAX(0.02, CsComp) 'bbh 2024/06/22 end replacement
                        ElseIf S% = 4 Then
                            'jrs 2024/06/11 
                            'Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, MN (2015 Model) Linear",
                            'HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_MN_AS_PCT_C, HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)


                            '                     Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, MN (2015 Model) Linear", _
                            '                      HHINCPCI(R%, HHType%), CsComp) 'bbh 2020/12/27

                            CsComp = AMAX(0.1, CsComp)
                        ElseIf S% = 5 Then
                            'jrs 2024/06/11 
                            'Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, SR (2015 Model) Log",
                            'HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_SR_AS_PCT_C, HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)

                            '                      Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, SR (2015 Model) Log", _
                            '                      HHINCPCI(R%, HHType%), CsComp) 'bbh 2020/12/27

                            CsComp = CSng(Amin(0.9, CsComp))
                        ElseIf S% = 6 Then
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, IC (2015 Model) Log",
                            'HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_IC_AS_PCT_C, HHINCDIS(R%, HHType%) / SHHPOP(R%, HHType%), CsComp, context)

                            '                    Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, IC (2015 Model) Log", _
                            '                      HHINCPCI(R%, HHType%), CsComp) 'bbh 2020/12/27
                            'bbh 2021/05/15 end HHINC to HHINCDIS
                            CsComp = CSng(Amin(0.16, CsComp))
                        End If

                        If ((S% > Ener) OrElse (S% = Agri AndAlso agon < 0.9) OrElse (S% = Ener AndAlso enon < 0.9)) Then
                            If HHType% = 1 Then
                                CSHHU(R%, S%) = consumhh(R%, Unskilled) * (CsComp + ConvergeOverTime(CSHHUShift(R%, S%), 0, 100))
                                '                    SumCSU = SumCSU + CSHHU(R%, S%)
                            Else
                                CSHHS(R%, S%) = consumhh(R%, Skilled) * (CsComp + ConvergeOverTime(CSHHSShift(R%, S%), 0, 100))
                                'If GRPS(1, R%) = "Iraq" And S% = 5 And FirstYear + IY - 1 = 2033 Then Stop
                                '                    SumCSS = SumCSS + CSHHS(R%, S%)
                            End If

                        Else 'Divide energy and ag according to consumption share
                            CSHHU(R%, S%) = CS(R%, S%) * consumhh(R%, Unskilled) / AMAX(0.001, C(R%))
                            CSHHS(R%, S%) = CS(R%, S%) * consumhh(R%, Skilled) / AMAX(0.001, C(R%))
                        End If
                    Next S%
                Next HHType%
                '        For S% = 1 To NSec%
                '            CSHHU(R%, S%) = CSHHU(R%, S%) * consumhh(R%, Unskilled) / SumCSU
                '            CSHHS(R%, S%) = CSHHS(R%, S%) * consumhh(R%, Skilled) / SumCSS
                '        Next S%

                'If RegName$(R%) = "United States of America" Then Stop

                ' bbh 2019/03/09 end revised section

                ' bbh 2019/03/09 beginning of edit section, removing old marginal budget/Engel's approach
                '   and leaving residual sector normalization

                '   All but First 4:  Expenditure Components by Origin Sector - Consumption, Unskilled
                '   ----------------------------------------------------------------------------------

                '        For S% = 1 To NSec% 'Needs to be in call4: because call2 to IFsAg computes CS
                '            If ((S% > Ener) Or (S% = Agri And agon < 0.9) Or (S% = Ener And enon < 0.9)) Then
                '                CSHHU(R%, S%) = sminexhh(R%, S%, Unskilled) + smarbdhh(R%, S%, Unskilled) * _
                '                    (consumhh(R%, Unskilled) - sfloorhh(R%, Unskilled))
                '                CSHHU(R%, S%) = AMAX(0.2 * sminexhh(R%, S%, Unskilled), CSHHU(R%, S%))
                '            Else
                '                CSHHU(R%, S%) = CS(R%, S%) * consumhh(R%, Unskilled) / AMAX(0.001, C(R%))
                '                    'Divide energy and ag according to consumption share
                '            End If
                '        Next S%
                SumCS = 0
                For S% = 3 To NSec%
                    SumCS = SumCS + CSHHU(R%, S%)
                Next S%
                'jrs 2025/09/17
                If SumCS > 10000000.0 Then
                    Stop
                End If
                For S% = 3 To NSec% 'Normalize nonphysical sectors to remainder of C
                    residc = AMAX(0.05 * consumhh(R%, Unskilled),
                (consumhh(R%, Unskilled) - CSHHU(R%, 1) - CSHHU(R%, 2)))
                    CSHHU(R%, S%) = CSHHU(R%, S%) / AMAX(0.001, SumCS) * residc
                    'jrs 2025/09/17
                    If CSHHU(R%, S%) > 10000000.0 Then
                        Stop
                    End If
                    CSHHU(R%, S%) = AMAX(0.0001, CSHHU(R%, S%))
                Next S%

                '   All but First 4:  Expenditure Components by Origin Sector - Consumption, Skilled
                '   ----------------------------------------------------------------------------------

                '        For S% = 1 To NSec% 'Needs to be in call4: because call2 to IFsAg computes CS
                '            If ((S% > Ener) Or (S% = Agri And agon < 0.9) Or (S% = Ener And enon < 0.9)) Then
                '                CSHHS(R%, S%) = sminexhh(R%, S%, Skilled) + smarbdhh(R%, S%, Skilled) * _
                '                    (consumhh(R%, Skilled) - sfloorhh(R%, Skilled))
                '                CSHHS(R%, S%) = AMAX(0.2 * sminexhh(R%, S%, Skilled), CSHHS(R%, S%))
                '            Else
                '                CSHHS(R%, S%) = CS(R%, S%) * consumhh(R%, Skilled) / AMAX(0.001, C(R%))
                '                    'Divide energy and ag according to consumption share
                '            End If
                '        Next S%
                'If RegName$(R%) = "Hong Kong" And IY% >= 91 Then Stop

                SumCS = 0
                For S% = 3 To NSec%
                    SumCS = SumCS + CSHHS(R%, S%)
                Next S%
                For S% = 3 To NSec% 'Normalize nonphysical sectors to remainder of C
                    residc = AMAX(0.05 * consumhh(R%, Skilled),
                consumhh(R%, Skilled) - CSHHS(R%, 1) - CSHHS(R%, 2))
                    CSHHS(R%, S%) = CSHHS(R%, S%) / AMAX(0.001, SumCS) * residc
                    CSHHS(R%, S%) = AMAX(0.0001, CSHHS(R%, S%))
                Next S%
                ' bbh 2019/03/09 end of edit section, removing old marginal budget/Engel's approach
                '   and leaving residual sector normalization

                '   All but First 4:  Expenditure Components by Origin Sector
                '   ---------------------------------------------------------

                SumCS = 0
                For S% = 1 To NSec%
                    CS(R%, S%) = CSHHU(R%, S%) + CSHHS(R%, S%)
                    SumCS = SumCS + CS(R%, S%)
                    'If RegName$(R%) = "Afghanistan" And S% = 6 Then Stop

                Next S%
                'If GRPS(1, R%) = "Iraq" And FirstYear + IY - 1 = 2033 Then Stop
                If SumCS > C(R%) Then
                    IncreaseC = SumCS - C(R%)
                    MinIGCF = 0.01! * GDPPOTRPA(R%)
                    If IGCF(R%) - IncreaseC < MinIGCF Then
                        IncreaseC = IncreaseC - (MinIGCF - (IGCF(R%) - IncreaseC))
                        IncreaseC = AMAX(0, IncreaseC)
                    End If
                    'If RegName$(R%) = "Congo, Democratic Republic of" And IY% > 40 Then Stop
                    IGCF(R%) = IGCF(R%) - IncreaseC
                    C(R%) = C(R%) + IncreaseC
                    consumtotal = AMAX(0.0001, consumhh(R%, Unskilled) + consumhh(R%, Skilled))
                    consumhh(R%, Unskilled) = consumhh(R%, Unskilled) / consumtotal * C(R%)
                    consumhh(R%, Skilled) = consumhh(R%, Skilled) / consumtotal * C(R%)
                End If

                'jrs 2019/05/02
                If cconstsw(R%) > 0 Then
                    C(R%) = sc(R%)
                End If

                'jrs 2019/05/03 *** BEGIN ***
                If cexovals(R%) > -100 Then
                    C(R%) = cexovals(R%)
                End If
                'jrs 2019/05/03 *** END ***

                'jrs 2019/05/03 Exogenous Models
                If ifsexomodelid > 0 Then
                    ReplaceVarWithExogenousForecastxReg("C", "", "", CStr(FirstYear + IY - 1), R%, context)
                End If

                'jrs 2017/12/05
                sc(R%) = C(R%)

                'If RegName$(R%) = "Qatar" And IY% >= 33 Then Stop

                '   All but First 4:  Expenditure Components by Origin Sector
                '   ---------------------------------------------------------

                For S% = 1 To NSec%
                    GS(R%, S%) = GOVCON(R%) * sgspl(R%, S%)
                    INVS(R%, S%) = IGCF(R%) * SISPL(R%, S%)
                    'If RegName$(R%) = "Qatar" And S% = 5 And IY% >= 33 Then Stop
                    'If RegName$(R%) = "Afghanistan" And S% = 6 Then Stop

                Next S%

                '   All but First 4:  Save FDI Flow Data for Use Next Step
                '   ------------------------------------------------------

                SXFDIFIN(R%) = XFDIFIN(R%)
                SXFDIFOUT(R%) = XFDIFOUT(R%)
                'bbh 2020/07/01 2 lines added
                SXPORTFIN(R%) = XPORTFIN(R%)
                SXPORTFOUT(R%) = XPORTFOUT(R%)

            Next R%
        End Sub
        Public Sub ifsECO4AllbutFirstYear(context As IForecastContext)
            'call4:

            ''jrs 2008/11/07
            'If IY > 21 Then
            '    Open FdrvRun$ & "ifslog.txt" For Append As #500
            '    Print #500, "Investment by Destination"
            '    Close #500
            'End If


            '   All but First 4:  Investment by Destination
            '   -------------------------------------------
            'jrs 2014/09/15
            Dim tids As Single, Diff1 As Single, Diff2 As Single, Mul As Single, MinIDS As Single
            'jrs 2024/09/26
            'testing reducing oscilations after 50 years
            'If IY >= 50 Then Stop
            'elinst1 = ConvergeOverTimeFromStartYear(elinst1, 0, 75, 50)
            'elinst2 = ConvergeOverTimeFromStartYear(elinst2, 0, 75, 50)
            'If IY >= 50 Then
            '    elinst1 = 0
            '    elinst2 = 0
            'End If

            For R% = 1 To NR%

                tids = 0!
                For S% = 1 To NSec%
                    'If RegName$(R%) = "China" And S% = 2 Then Stop

                    'bbh 2020/08/03 Start
                    StBase(R%, S%) = zsp(R%, S%) + ims(R%, S%) * GDPPOT(R%) / GDPI(R%) 'bbh 2021/09/30 ims DOES NOT grow and fixed causes problems, e.g. Vietnam materials
                    'StBase(R%, S%) = CS(R%, S%) + GS(R%, S%) + INVS(R%, S%) + XS(R%, S%) 'bbh 2024/06/01 Replaced above supply side stock base line with demand-side block here and below
                    'But does not work well in part becuase entrepot economies like Djibouti and UAE are messed up by not responding to import side and/or smoothed behavior of ims (maybe ixs)
                    'For row = 1 To NSec%
                    '    AMat(R%, row, S%) = EIOMat(R%, row, S%, context)
                    '    ints(row, S%) = zsp(R%, S%) * AMat(R%, row, S%)
                    '    StBase(R%, S%) = StBase(R%, S%) + ints(row, S%)
                    'Next row 'bbh 2024/06/01 end of trial replacment

                    'StBase(R%, S%) = PFD(R%, S%) + ims(R%, S%) * GDPPOT(R%) / GDPI(R%) 'bbh 2022/10/27
                    'StBase(R%, S%) = PFD(R%, S%) + MovAvgMS(R%, S%) 'bbh 2022/10/27 Replaced line above for more control over import contribution to stock need
                    'StBase(R%, S%) = zsp(R%, S%) + ims(R%, S%) 'bbh 2021/09/21 ims itself grows; GTPPOT/GDPI was causing problems
                    'for countries like China with large stock demands
                    'StBase(R%, S%) = VADD(R%, S%) + ims(R%, S%) * GDPPOT(R%) / GDPI(R%)
                    'bbh 2020/08/03 end

                    'mti 2018/10/01 Start
                    '            StBase(R%, S%) = zsp(R%, S%) + sms(R%, S%)
                    'mti 2018/10/01 End
                    'If GRPS(1, R%) = "Israel" And S% = 3 And IY >= 50 Then Stop
                    If ((S% > Ener) OrElse (S% = Agri AndAlso agon < 0.9) OrElse (S% = Ener AndAlso enon < 0.9)) Then
                        Diff1 = SST(R%, S%) - dstl * StBase(R%, S%)
                        'Diff2 = sst(R%, S%) - SSTS(R%, S%) * (1! + igdpr(R%))
                        Diff2 = SST(R%, S%) - SSTS(R%, S%) * (1.0! + igdprcor(R%))
                        Call ADJSTR(StBase(R%, S%), Diff1, Diff2, elinst1, elinst2, Mul)
                        'jrs 2024/09/26
                        'If IY >= 50 Then
                        '    'Mul = 1
                        '    Mul = AMAX(Amin(Mul, CSng(1 + 0.04)), CSng(1 - 0.04))
                        '    'If GRPS(1, R) = "Israel" Then
                        '    '    Debug.Print("IY = " & IY.ToString & " S = " & S.ToString & " IDSMul = " & Mul.ToString & " StBase = " & StBase(R%, S%) & " Diff1 = " & Diff1.ToString & " Diff2 = " & Diff2.ToString)
                        '    'End If
                        'End If
                        'mti 2018/07/02 Start
                        IDS(R%, S%) = IGCF(R%) * IDK(R%, S%) * idsm(R%, S%) * Mul
                        'mti 2018/07/02 End
                    End If
                    MinIDS = IDK(R%, S%) * IGCF(R%) * 0.5!
                    'If GRPS(1, R%) = "Guinea Bissau" And S% = 2 And IY >= 7 Then Stop
                    IDS(R%, S%) = AMAX(MinIDS, Amin(IDS(R%, S%), IGCF(R%)))



                    If S% = 1 Then
                        IDS(R%, S%) = CSng(Amin(IGCF(R%) * 0.3, Amin(IGCF(R%) * sidk(R%, S%) * 2.5, IDS(R%, S%))))
                        'If RegName$(R%) = "Congo, Democratic Republic Of" And IY% >= 50 Then Stop
                    End If
                    If S% = 2 Then
                        'jrs 2022/04/18
                        'if IGCF(R%) * sidk(R%, S%) > 0.1 then
                        'jrs 2022/05/02 If GRPS(1, R%) <> "Guinea Bissau" Or context.HistoricMode = True Then
                        If ennoprodsw(R%) = 0 Or context.HistoricMode = True Then
                            IDS(R%, S%) = CSng(Amin(IGCF(R%) * 0.5, Amin(IGCF(R%) * sidk(R%, S%) * 3, IDS(R%, S%))))
                        End If
                    End If

                    tids = tids + IDS(R%, S%)
                Next S%

                For S% = 1 To NSec%
                    IDS(R%, S%) = IDS(R%, S%) * IGCF(R%) / tids
