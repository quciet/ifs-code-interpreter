    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex365FirstYear:PovertyAdjGenderRatio
' Private Sub PovertyAdjGenderRatio(R%, PovRateVec(,,) As Single, AGCount As Integer)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - new procedure
                '(R%%, POVRATE365(), PovCountVec(), povnational_hc As Single)
                Dim AdjPovDiff As Single
                Dim j%
    
                'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                For j% = 1 To TotPovAGCount
                    If POVRATE365(R%%, j, Female) - POVRATE365(R%%, j, Male) > 1.5 * POVRATE365(R%%, j, Total) Then
                        AdjPovDiff = CSng((POVRATE365(R%%, j, Female) - POVRATE365(R%%, j, Male)) - 1.5 * POVRATE365(R%%, j, Total))
                        POVRATE365(R%%, j, Female) = POVRATE365(R%%, j, Female) - AdjPovDiff / 2
                        POVRATE365(R%%, j, Male) = POVRATE365(R%%, j, Male) + AdjPovDiff / 2
                    ElseIf POVRATE365(R%%, j, Female) - POVRATE365(R%%, j, Male) < -1.5 * POVRATE365(R%%, j, Total) Then   '1.5
                        AdjPovDiff = CSng((POVRATE365(R%%, j, Female) - POVRATE365(R%%, j, Male)) + 1.5 * POVRATE365(R%%, j, Total))
                        POVRATE365(R%%, j, Female) = POVRATE365(R%%, j, Female) + AdjPovDiff / 2
                        POVRATE365(R%%, j, Male) = POVRATE365(R%%, j, Male) - AdjPovDiff / 2
                    End If
    
                    '           'make sure there is at least some poverty in each gender
                    POVRATE365(R%%, j%, Male) = AMAX(POVRATE365(R%%, j%, Female) * 0.2, POVRATE365(R%%, j%, Male))
                    POVRATE365(R%%, j%, Female) = AMAX(POVRATE365(R%%, j%, Male) * 0.2, POVRATE365(R%%, j%, Female))
    
                Next j%
    
' End Sub
