            End If

            For R% = 1 To NR%
                'bbh 2020/08/24 start
                '       All but First 3:  Computation to a Working/Permament Version of Disposal Houshold Income
                '       ----------------------------------------------------------------------------------------

                'bbh 2021/05/15 start
                'bbh 2022/01/30 Start: Switch to variable added to Common
                '        hhdispincperm(R%, Skilled) = hhdispincperm(R%, Skilled) * (1 + igdprcor(R%)) * 0.7 _
                '            + HHINCDIS(R%, Skilled) * 0.3
                '        hhdispincperm(R%, Unskilled) = hhdispincperm(R%, Unskilled) * (1 + igdprcor(R%)) * 0.7 _
                '            + HHINCDIS(R%, Unskilled) * 0.3
                '        HHINCDISPERM(R%, Skilled) = SHHINCDISPERM(R%, Skilled) * (1 + igdprcor(R%)) * 0.7 _
                '            + HHINCDIS(R%, Skilled) * 0.3
                '        HHINCDISPERM(R%, Unskilled) = SHHINCDISPERM(R%, Unskilled) * (1 + igdprcor(R%)) * 0.7 _
                '            + HHINCDIS(R%, Unskilled) * 0.3

                'bbh 2022/06/23 Replaced 2 perm disposable income lines above with these; some country's growth varies greatly from igdrcor over time
                HHINCDISPERM(R%, Skilled) = SHHINCDISPERM(R%, Skilled) / SGDP(R%) * GDP(R%) * 0.7! _
                + HHINCDIS(R%, Skilled) * 0.3!
                HHINCDISPERM(R%, Unskilled) = SHHINCDISPERM(R%, Unskilled) / SGDP(R%) * GDP(R%) * 0.7! _
                + HHINCDIS(R%, Unskilled) * 0.3!
