                    End If
                    POVSHORT685(R%, TotPovAGCount, Male) = 0
                    POVSHORT685(R%, TotPovAGCount, Female) = 0
                    POVSHORT685(R%, TotPovAGCount, Total) = 0
                    POVSHORTSEXDIFF685(R%, TotPovAGCount) = 0
    
    
                    For j% = 1 To TotPovAGCount - 1
                        POVSHORT685(R%, j%, Male) = POVCOUNT685(R%, j%, Male) * PerPoorShortFall  'million people * thoUSAnd dollars = billion dollars
                        POVSHORT685(R%, j%, Female) = POVCOUNT685(R%, j%, Female) * PerPoorShortFall
                        POVSHORT685(R%, j%, Total) = POVSHORT685(R%, j%, Male) + POVSHORT685(R%, j%, Female)
    
                        POVSHORTSEXDIFF685(R%, j%) = AMAX(0, POVSHORT685(R%, j%, Female) - POVSHORT685(R%, j%, Male))
    
                        POVSHORT685(R%, TotPovAGCount, Male) = POVSHORT685(R%, TotPovAGCount, Male) + POVSHORT685(R%, j%, Male)
                        POVSHORT685(R%, TotPovAGCount, Female) = POVSHORT685(R%, TotPovAGCount, Female) + POVSHORT685(R%, j%, Female)
    
                        POVSHORTSEXDIFF685(R%, TotPovAGCount) = POVSHORTSEXDIFF685(R%, TotPovAGCount) + POVSHORTSEXDIFF685(R%, j%)
                    Next j%
    
                    POVSHORT685(R%, TotPovAGCount, Total) = POVSHORT685(R%, TotPovAGCount, Male) + POVSHORT685(R%, TotPovAGCount, Female)
    
                Next R%
    
