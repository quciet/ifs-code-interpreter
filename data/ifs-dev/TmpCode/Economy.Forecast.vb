    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSexNPLFirstYear:PovertyAdjGenderRatio
' Private Sub PovertyAdjGenderRatio(R%, PovRateVec(,,) As Single, AGCount As Integer)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - new procedure
                '(R%%, POVRATENPL(), PovCountVec(), povnational_hc As Single)
                Dim AdjPovDiff As Single
                Dim j%
    
                'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                For j% = 1 To TotPovAGCount
                    If POVRATENPL(R%%, j, Female) - POVRATENPL(R%%, j, Male) > 1.5 * POVRATENPL(R%%, j, Total) Then
                        AdjPovDiff = CSng((POVRATENPL(R%%, j, Female) - POVRATENPL(R%%, j, Male)) - 1.5 * POVRATENPL(R%%, j, Total))
                        POVRATENPL(R%%, j, Female) = POVRATENPL(R%%, j, Female) - AdjPovDiff / 2
                        POVRATENPL(R%%, j, Male) = POVRATENPL(R%%, j, Male) + AdjPovDiff / 2
                    ElseIf POVRATENPL(R%%, j, Female) - POVRATENPL(R%%, j, Male) < -1.5 * POVRATENPL(R%%, j, Total) Then   '1.5
                        AdjPovDiff = CSng((POVRATENPL(R%%, j, Female) - POVRATENPL(R%%, j, Male)) + 1.5 * POVRATENPL(R%%, j, Total))
                        POVRATENPL(R%%, j, Female) = POVRATENPL(R%%, j, Female) + AdjPovDiff / 2
                        POVRATENPL(R%%, j, Male) = POVRATENPL(R%%, j, Male) - AdjPovDiff / 2
                    End If
    
                    '           'make sure there is at least some poverty in each gender
                    POVRATENPL(R%%, j%, Male) = AMAX(POVRATENPL(R%%, j%, Female) * 0.2, POVRATENPL(R%%, j%, Male))
                    POVRATENPL(R%%, j%, Female) = AMAX(POVRATENPL(R%%, j%, Male) * 0.2, POVRATENPL(R%%, j%, Female))
    
                Next j%
    
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSexNPLFirstYear:PovertyAdjGenderRatio

