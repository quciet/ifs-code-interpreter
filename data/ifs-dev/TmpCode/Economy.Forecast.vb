                    New Single() {GDPPCP(R%), EDYRSAG15(R%, 3)}, FreeComp,
                    New String() {"GDP2005PCPPP(MOSTRECENT)/ 1000 (Log)", "EdYearsAge15Total(MOSTRECENT) (Linear)"}, context) 'jrs 2014/10/09 added DepVar Names to check order
                    'Keep consistent with SocioPol (DomPol)
                    '            TbName$ = "GDP/Capita (PPP) Versus Economic Freedom (" & CStr(BaseYear) & ") Log"
                    '            TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear)
                    '            Call XYTABL(TbName$, GDPPCP(R%), econfreecomp)
                    'To be compatible with DataEcon and SocioPol
                End If
                'bbh 2011/04/30
                'jrs 2013/11/28
                '         Call AnalFunc("Economic Freedom (2005)", _
                '            Array(GDPPCP(R%), DEMOCPOLITY(R%), energydepend(R%)), EconFreeComp) 'Using bivariate in preprocessor
                Call AnalFunc("Economic Freedom (2010)",
                New Single() {GDPPCP(R%), DEMOCPOLITY(R%), energydepend(R%)}, EconFreeComp,
                New String() {"GDPPCP (Log)", "DEMOCPOLITY (Linear)", "ENX*ENPRI/GDP(Linear)"}, context) 'jrs 2014/10/09 added DepVar Names to check order 'Using bivariate in preprocessor

                EconFreeComp = AMAX(1, Amin(EconFreeComp, 10))
                FreeComp = AMAX(1, Amin(FreeComp, 14))

                Call AnalFunc("Polity Democracy versus GEM, YTHBULGE, En Export Dependence (2010)",
                New Single() {GEM(R%), YTHBULGE(R%), energydepend(R%)}, PolityDemocComp,
                New String() {"GEM[0](0) (Linear)", "YTHBULGE[0](0) (Linear)", "EnExValPerGDP(0) (Linear)"}, context) 'jrs 2014/10/09 added DepVar Names to check order
                PolityDemocComp = AMAX(1, Amin(20, PolityDemocComp))
                '         Call AnalFunc("Governance Effectiveness (2006)", _
                '            Array(GDPPCP(R%), EDYRSAG15(R%, 3)), GovtEffComp)
                'bbh 2011/04/30
                Call AnalFunc("Governance Effectiveness (2005)",
                New Single() {GDPPCP(R%), DEMOCPOLITY(R%), energydepend(R%)}, GovtEffComp,
                New String() {"GDPPCP", "DEMOCPOLITY", "EnExDep"}, context) 'jrs 2014/10/09 added DepVar Names to check order 'Using bivariate in preprocessor
                'bbh 2011/09/21 Function now estimated with forecasts (0-5)/not data (-2.5 to 2/5)
                'GovtEffComp = AMAX(0, Amin(5, GovtEffComp + 2.5))
                GovtEffComp = AMAX(0, Amin(5, GovtEffComp))


                'bbh 2011/04/13
                '         TbName$ = "GDP/Capita (PPP 2000) Versus TI Corruption Perception (" & CStr(BaseYear) & ") Linear"
                '         TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear)
                '         Call XYTABL(TbName$, GDPPCP(R%), corrupcomp)
                'bbh 2011/04/30 start
                'EnergyDepend(R%) = ENX(R%) * ENPRI(R%) / GDP(R%)
                'BBH 2011/08/19
                'Call AnalFunc("Governance Corruption (2005)", _
                'Array(GDPPCP(R%), DEMOCPOLITY(R%), energydepend(R%)), corrupcomp)
                Call AnalFunc("GOVCORRUPTversus GDPPCP, DEMOCPOLITY, GEM, Ex Export Depend (2010)",
                New Single() {GDPPCP(R%), DEMOCPOLITY(R%), GEM(R%), energydepend(R%)}, Prediction,
                New String() {"GDPPCP[0](0) (Linear)", "DEMOCPOLITY[0](0) (Linear)", "GEM[0](0) (Linear)", "EnExValPerGDP(0) (Linear)"}, context) 'jrs 2014/10/09 added DepVar Names to check order
                'bbh 2011/04/30 end
                corrupcomp = AMAX(1, Amin(10, Prediction))
                'To be compatible Sociopol; have used simpler function for DataEcon hole filling
                'bbh 2011/04/13 end

                econfreecontrib = (ECONFREE(R%) - EconFreeComp) * mfpefree '0.1
                freecontrib = (FREEDOM(R%) - FreeComp) * mfpfree '0
                politydemoccontrib = (DEMOCPOLITY(R%) - PolityDemocComp) * mfpdemoc '0
                'If RegName$(R%) = "Afghanistan" Then Stop
                govteffcontrib = (GOVEFFECT(R%) - GovtEffComp) * mfpgoveff '0.5 '(1/2 of 1% / se of .5) * .5
                corrupcomp = (GOVCORRUPT(R%) - corrupcomp) * mfpgovcor '0.2 '(1/2 of 1% / se of 1.4) * .5
                'bbh 2011/09/21
                '         If confforsw = 1 Then
                '            conflictcontrib = SFINTLWARALL(R%) * mfpconflict
                '         Else
                '            conflictcontrib = 0
                '         End If
                MFPSC(R%) = econfreecontrib + govteffcontrib + corrupcomp + freecontrib + politydemoccontrib
                '+ conflictcontrib
                'bbh 2011/09/21 end
                'If RegName$(R%) = "Algeria" Then Stop

                '   First Year 2:  Compute Contributions of Multiple Factors to MFPPC
                '   -----------------------------------------------------------------
                'jrs 2024/06/19 translate in synch
                Call XYTABL("GDP/Capita (PPP) Versus Infrastructure Index Traditional (2010) Log",
                GDPPCP(R%), InfraIndTradCompLt5, context)
                'Call XYTABL(TFNameInfraIndexTrad, GDPPCP(R%), InfraIndTradCompLt5, context)
                Call XYTABL("GDP/Capita (PPP) Versus Infrastructure Index Traditional (2100) Log",
                GDPPCP(R%), InfraIndTradCompGt40, context)

                If GDPPCP(R%) <= 5 Then
                    InfraIndTradComp = InfraIndTradCompLt5
                ElseIf GDPPCP(R%) >= 40 Then
                    InfraIndTradComp = InfraIndTradCompGt40
                Else
                    InfraIndTradComp = (40 - GDPPCP(R%)) / 35 * InfraIndTradCompLt5 + (GDPPCP(R%) - 5) / 35 * InfraIndTradCompGt40
                End If

                'mti Sep 12, 2011 - end

                'mti April 05, 2012 - start
                INFRAINDTRADEXP(R%) = InfraIndTradComp
                'mti April 05, 2012 - end

                '8% growth as a result of improvement in the index by 1 point (which is huge); so mfpinfrindtrad should be 8
                infratradcontrib = (INFRAINDTRAD(R%) - InfraIndTradComp) * mfpinfrindtrad '0.000001
                'mti July 18, 2011 -end
                'mti June 08, 2011 -end

                'save it as the value two years back- for use in year 2

INFRAINDICT_Prev = R% + ICTBROAD + ICTBROADMOBIL + ICTMOBIL + ictmobilsaturation + igdpr + infraindictcompwt + INFRATELE @@INFRAINDICT_Prev = ComputeInfraIndICTPrev(R%)@@

                'mti July 25, 2012 -end



                'save it as the value two years back- for use in year 2
                SSINFRAINDICT(R%) = INFRAINDICT_Prev

                'mti October 20, 2011 - start
                SSINFRAINDICTDEM(R%) = INFRAINDICT_Prev
                'mti October 20, 2011 -end

                'mti August 22, 2011 -start
                'current
                IndICTContrib = (INFRAINDICT(R%) - INFRAINDICT_Prev)  '0.000001
                sictindexm(R) = ictindexm(R) 'bbh 2015/06/27
                sIndICTcontrib(R%) = IndICTContrib
                infraictcontrib = IndICTContrib * mfpinfrindict  '0.000001
                'mti August 22, 2011 -end


                'mti July 25, 2012 - start
                'Expected value of infraother spending as a % of GDP
                'mfpinfrothspnd = 0.2
                InfOthSpndExp = CSng(Amin(4, 1.8162 + 0.061 * Log(GDPPCP(R%))))
                'mti Sep 08, 2012 - start
                'InfOthSpndComp = GDS(R%, InfraOther) / GDP(R%) * 100
                InfOthSpndComp = Amin(4, GDS(R%, InfraOther) / GDP(R%) * 100)
                'mti Sep 08, 2012- end

                'mti 2018/07/23 start
                infothspndcontrib = (InfOthSpndComp - InfOthSpndExp) * mfpiospn '* 0.2 ' mfpinfrothspnd
                'mti 2018/07/23 end
                'mti July 25, 2012 - end

                'mti July 25, 2012 - start
                'MFPPC(R%) = infratradcontrib + infraICTcontrib
                MFPPC(R%) = infratradcontrib + infraictcontrib + infothspndcontrib
                'mti July 25, 2012 - end

                '   First Year 2:  Compute Contributions of Multiple Factors to MFPKN
                '   -----------------------------------------------------------------

                'Call XYTABL("GDP/Capita (PPP) Versus Govt Exp R&D As % Of GNP (2000) - linear", _
                'Amin(40, GDPPCP(R%)), rdexpcomp)
                rdexpcontrib = (RANDDEXP(R%) - rdexpcomp) * mfprandd '0.5
                'ecintcontrib = (ECONINTEG(R%) - 50) / 10 * 0.2 'mfpconint
                'bbh 2016/01/19
                'ecintcontrib = (TradeTerm(R%) - tradetermI(R%)) / 10 * mfpeconint
                'bbh 2018/04/19 start
                'ecintcontrib = (TradeTerm(R%) - TradeTermMa(R%)) / 10 * mfpeconint
                ecintcontrib = 0  'In second year this term will be 0; no real basis for MA until future years
                'bbh 2018/04/19 end
                'If RegName$(R%) = "Sweden" Then Stop
                '    If R% = 1 Then Stop
                'mti 2014/03/27 - start
                'MFPKN(R%) = rdexpcontrib + ecintcontrib
MFPKN(R%) = rdexpcontrib + ecintcontrib  + R% + sEdTerGrSciEn(R%) + context + EDTERGRATE + EDTERGRSCIEN + GDPPCP + mfpedscien @@MFPKN(R%) = rdexpcontrib + ecintcontrib + EdTerSciContrib(R%, sEdTerGrSciEn(R%), context)@@
                'If RegName$(R%) = "Guatemala" Then Stop
                'mti 2014/03/27 - end

                ' If RegName$(R%) = "Australia" Then Stop
                ' If RegName$(R%) = "Somalia" Then Stop
                '   First Year 2:  Productivity Growth:  Adjust Productivity Components
                '       for Complementarities
                '   ------------------------------------------------------------------------
                avgcontrib = (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 4 / 100
                FactorC = MFPHC(R%) / 100 - avgcontrib
MFPHC(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPHC(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                FactorC = MFPSC(R%) / 100 - avgcontrib
MFPSC(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPSC(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                FactorC = MFPPC(R%) / 100 - avgcontrib
MFPPC(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPPC(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                FactorC = MFPKN(R%) / 100 - avgcontrib
MFPKN(R%) = (FactorC) + avgcontrib + avgcontrib) * 100 @@MFPKN(R%) = (MFPContribAdj(FactorC) + avgcontrib) * 100@@
                '   If RegName(R%) = "Afghanistan" Then Stop
                'mti October 20, 2011 - start
                MFPPCDEM(R%) = MFPPC(R%)
                'mti October 20, 2011 - end

            Next R%
            senpriceterm = 0

            '   First Year 2:  Predicted Technological Growth Rate
            '   ------------------------------------------------
            'jrs 2014/09/16
            'bbh 2021/05/15 Dim GloGDP As Single, techpremium As Single, S As Integer
            Dim GloGDP As Single, S As Integer 'bbh 2021/05/15
            Dim KGroComp As Single, lfgr As Single, egdppc As Single, TbName As String
            Dim pcdalf As Single, pcdalflag As Single, palphas As Single, palphaslag As Single, NextYear As Single, ThisYear As Single, AlphaShiftTerm As Single
            Dim cda_1 As Single, kdrate As Single, vaddpred As Single, KContrib As Single, LContrib As Single, NumNWPPer As Single, SumVadd As Single
            Dim LabCoefNextYearUnskilled As Single, LabCoefNextYearSkilled As Single, LabForceGrowthRateAdj As Single  'bbh 2020/12/27

            'bbh 2021/05/15 glocorrect = 0
            MFPGLOCOR = 0

            GloGDP = 0
            'bbh 2019/09/08 start
            For WBGroup = 1 To 4
                WBGroupCorrectTot(WBGroup) = 0
                WBGroupVadd(WBGroup) = 0
                WBGroupPop(WBGroup) = 0
                WBGroupGDPP(WBGroup) = 0
                WBGroupGDPPCP(WBGroup) = 0
            Next WBGroup

            '   bbh 2021/06/01 start calculate if igdpr is higher than base case igdpr and if so compute difference
            '   First Year 2:  Use WPOP to see if current run is base rebuild or not
            '   --------------------------------------------------------
            ReDim WPOPBase(IY)
            If dfBaseWPOP.RowCount > 0 Then
                WPOPBase(IY) = CSng(dfBaseWPOP(CInt(IY)))
            End If

            If WPOPBase(IY) > 0 Then
                NotBaseRun = 1 'true
            Else
                NotBaseRun = 0
            End If

            For R% = 1 To NR%

                If NotBaseRun > 0.5 Then 'if not base run see if igdpr has scenraio value and compute difference
                    ReDim IGDPRBase(IY)
                    If dfBaseigdpr.RowCount > (IY - 1) * NR Then
                        IGDPRBase(IY) = CSng(dfBaseigdpr(getDataFrameIdxFromDims(CShort(FirstYear + IY - 1), FirstYear, CShort(R), CShort(NR))))
                    End If

                    IGDPRDif(R%) = igdpr(R%) - IGDPRBase(IY)
                Else
                    IGDPRDif(R%) = 0
                End If

                '   First Year 2:  Set initial calculation step toward MFP growth at that of system leader
                '   --------------------------------------------------------------------------
                'bbh 2021/06/01 end

                'techpremium = PremTechConv(R%, context)
                'Call XYTABL("GDP/Capita Versus Technological Premium", GDPPC(r%), PremTechConv)
                For S% = 1 To NSec%
                    MFPRATE(R%, S%) = mfpleadr(S%) '+ techpremium / 100
                Next S%
                'bbh 2019/09/08 end
                'If RegName$(R%) = "Myanmar" Then Stop

                '   First Year 2:  Compute Capital and Labor Growth Rates (repeated from 1st call)
                '   ------------------------------------------------------------------------------
                Call XYTABL("Investment Ratio Versus Capital Growth Rate",
                IGCF(R%) / GDP(R%), KGroComp, context)
                KGroComp = KGroComp / 100 / 2  'Should probably compute capital growth as residual
                'and use technological growth as exogenous; this function cut in half because
                'apparently growing too fast
                'bbh 2022/01/30 See also the first year determination of KS in IFsEco and same date comments about the
                '   challenges facing that calculation; same function there directing total investment into sectors
                '   Would be much stronger if had sector specific KS and IDS as inputs to the model.
                '   If had sector specific IDS and VADD growth, and given LKS for depreciation, could compute KS better
                'lfgr = POPR(R%) / 100 + femshrlabi(R%) / 100 * femshrgr / 100 + MIGRATE(R%) / 100
                lfgr = POPR(R%) / 100 + femshrlabi(R%) / 100 * femshrgr / 100
                'jrs 2024/01/18
                If BaseYear > 2014 And context.HistoricMode = False Then
                    If GDPPCP(R%) < 5 Then
                        lfgr = CSng(lfgr + 0.009) 'bbh 2024/01/15 Test because POPR < LAB growth lI countries (*2 was too much)
                    End If
                End If

                '   First Year 2:  Predicted CDALF and ALPHAS
                '   ---------------------------------------
                'egdppc = GDPP(R%) * (1 + igdpr(R%)) / (POP(R%) * (1 + POPR(R%) / 100))
                egdppc = GDPP(R%) * (1 + IGDPRCor(R%)) / (POP(R%) * (1 + POPR(R%) / 100))
                TbName$ = "GDP/Capita (PPP) Versus Cobb-Douglas Alpha (GTAP 5)"
                Call XYTABL(TbName$, egdppc, pcdalf, context)
                Call XYTABL(TbName$, GDPPCP(R%), pcdalflag, context)

                'pcdalf = AMAX(0.05, Amin(pcdalf / 100, 1))
                'pcdalflag = AMAX(0.05, Amin(pcdalflag / 100, 1))
                'pcdalf = AMAX(0.2, Amin(pcdalf / 100, 1))
                pcdalf = AMAX(0.05, Amin(pcdalf / 100, 1)) 'bbh 2024/10/10 Replaced above
                pcdalflag = AMAX(0.05, Amin(pcdalflag / 100, 1)) 'bbh 2024/10/10 Replaced above
                For S% = 1 To NSec%
                    palphas = pcdalf * salphas(R%, S%)
                    palphas = AMAX(0, Amin(palphas, 1))
                    palphaslag = pcdalflag * salphas(R%, S%)
                    palphaslag = AMAX(0, Amin(palphaslag, 1))
                    NextYear = CSng(KS(R%, S%) ^ palphas * LABS(R%, S%) ^ (1 - palphas))
                    ThisYear = CSng(KS(R%, S%) ^ palphaslag * LABS(R%, S%) ^ (1 - palphaslag))
                    AlphaShiftTerm = NextYear / AMAX(0.0001, ThisYear)

                    '   First Year 2:  Compute Cobb-Douglas Scaling Parameter and sector spetific capital growth
                    '   ----------------------------------------------------------------------------------------
                    cda_1 = CSng(KS(R%, S%) ^ palphas * LABS(R%, S%) ^ (1 - palphas))
                    cda(R%, S%) = VADD(R%, S%) / AMAX(0.0001, cda_1)

                    kdrate = 1 / AMAX(5, lks(S%))
                    If KGroComp + kdrate <= 0.005 Then
                        kgrocomps(S%) = CSng(-kdrate + 0.005)
                    Else
                        kgrocomps(S%) = KGroComp
                    End If

                    '   bbh 2020/12/28 start
                    '    Block added and change to LContrib computing MFPCORS passes through some of changing labor requirements with economic growth
                    '    Shift of labor across time from agriculture to manufactures and services increases its productivity and raises growth rate, especially
                    '    in lower-income countries with large agricultural sectors; ideally would raise LContrib in response to such shift but no way now in model
                    '    to do this in first year when MFPCORS is computed; a raise in LContrib lowers MFPCORS and therefore growth post exogenous period

                    '    First Year 2:  Adjust Labor Force Growth Rate by Labor Coefficients
                    '   --------------------------------------------------------------------

                    GDPPCP(R%) = GDPPCP(R%) * (1 + igdpr(R%) - POPR(R%) / 100)
LabCoefNextYearUnskilled = R% + Unskilled + S% + context + GDPPCP + igdpr + POPR @@LabCoefNextYearUnskilled = LaborF(R%, Unskilled, S%, context)@@
LabCoefNextYearSkilled = R% + Skilled + S% + context + GDPPCP + igdpr + POPR @@LabCoefNextYearSkilled = LaborF(R%, Skilled, S%, context)@@
                    GDPPCP(R%) = GDPPCP(R%) / (1 + igdpr(R%) - POPR(R%) / 100)
                    LabForceGrowthRateAdj = (LABCOEFFS(R%, S%, Unskilled) + LABCOEFFS(R%, S%, Skilled)) / (LabCoefNextYearUnskilled + LabCoefNextYearSkilled)
                    LabForceGrowthRateAdj = CSng(AMAX(1, 1 + (LabForceGrowthRateAdj - 1) * 0.5)) 'bbh 2023/07/22  Computed but not used below
                    'bbh 2021/06/01 'backed out IGDPRDif so that change in igdpr does not get offset or magnified by switch
                    If igdpr(R%) - IGDPRDif(R%) < 0.02 Then
                        LabForceGrowthRateAdj = 1 'Don't want to raise labor contribution and lower correction factor for very slow growing countries
                    End If
                    'If S% = 1 Or S% = 2 Then LabForceGrowthRateAdj = 1  'does not seem to change correction factors for India
                    'If RegName$(R%) = "India" Then Stop

                    '   First Year 2:  Compute Technological Growth Rate
                    '   ----------------------------------------------
                    'knowledgeterm = techpremium / 100
                    vaddpred = VADD(R%, S%) * (1 + sectorgr(R%, S%))
                    KContrib = CSng((KS(R%, S%) * (1 + kgrocomps(S%))) ^ palphas)
                    'LContrib = CSng((LABS(R%, S%) * (1 + lfgr)) ^ (1 - palphas)) 'about 7.5% gdpr India, when igdpr only about 5.5%
                    'LContrib = CSng((LABS(R%, S%) * (lfgr + LabForceGrowthRateAdj)) ^ (1 - palphas)) 'about 6-6.5% India with the change
                    LContrib = CSng((LABS(R%, S%) * (lfgr + 1)) ^ (1 - palphas)) 'bbh 2023/07/22 Return to earlier formulation

                    'LContrib = (LABS(R%, S%) * (1 + lfgr)) ^ (1 - palphas) * LabForceGrowthRateAdj 'about 1.5-2% India

                    '            If S% = 4 Or S% = 5 And RegName$(R%) = "India" Then 'bbh 2020/12/27
                    '                LContrib = (LABS(R%, S%) * (1 + lfgr + 0.02)) ^ (1 - palphas)
                    '            End If
                    '           bbh 2020/12/28 end
                    'bbh 2021/05/15 MFPGro(R%, S%) = vaddpred / (cda(R%, S%) * KContrib * LContrib * AlphaShiftTerm) - 1
                    MFPGROWTH(R%, S%) = vaddpred / (cda(R%, S%) * KContrib * LContrib * AlphaShiftTerm) - 1
                    'MFPCorS(R%, S%) = MFPGro(R%, S%) - MFPRATE(R%, S%) - knowledgeterm _
                    '- (MFPHC(R%) + MFPSC(R%) + MFPKN(R%)) / 100
                    'bbh 2021/05/15 MFPCORS(R%, S%) = MFPGro(R%, S%) - MFPRATE(R%, S%) _
                    '- (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 100
                    MFPCORS(R%, S%) = MFPGROWTH(R%, S%) - MFPRATE(R%, S%) _
                    - (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 100
                    'If RegName$(R%) = "United States Of America" And S% = 4 Then Stop
                    'bbh 2019/09/08 start
                    WBGroupCorrectTot(GroupIDs(R%)) = WBGroupCorrectTot(GroupIDs(R%)) + MFPCORS(R%, S%) * VADD(R%, S%)
                    'glocorrect = glocorrect + MFPCORS(R%, S%) * VADD(R%, S%)
                    WBGroupVadd(GroupIDs(R%)) = WBGroupVadd(GroupIDs(R%)) + VADD(R%, S%)
                    'GloGDP = GloGDP + VADD(R%, S%)
                    'Base for bringing regional MFP growth to predicted over time
                Next S%
                WBGroupPop(GroupIDs(R%)) = WBGroupPop(GroupIDs(R%)) + POP(R%)
                WBGroupGDPP(GroupIDs(R%)) = WBGroupGDPP(GroupIDs(R%)) + GDPP(R%)
            Next R%
            For WBGroup = 1 To 4
                WBGroupCorrect(WBGroup) = WBGroupCorrectTot(WBGroup) / AMAX(0.001, WBGroupVadd(WBGroup)) * 100
                'bbh 2020/03/26 Added line below: don't let correction for income groups below leader go negative
                WBGroupCorrect(WBGroup) = AMAX(0, WBGroupCorrect(WBGroup))
                WBGroupGDPPCP(WBGroup) = WBGroupGDPP(WBGroup) / AMAX(0.0001, WBGroupPop(WBGroup))
            Next WBGroup
            'glocorrect = glocorrect / AMAX(0.001, GloGDP)

            For R% = 1 To NR%
                'bbh 2021/05/15 techpremium = PremTechComp(R%) / 100
MFPPREMIUM(R%) = R% + GDPPCP / 100 @@MFPPREMIUM(R%) = PremTechComp(R%) / 100@@

                'If (GRPS(1, R) = "Eritrea") Then Stop  'bbh 2023/12/12
                'MFPPREMIUM(R%) = 0 'bbh 2023/12/05 test

                For S% = 1 To NSec%
                    MFPRATE(R%, S%) = MFPRATE(R%, S%) + MFPPREMIUM(R%) 'techpremium 'bbh 2021/05/15
                    'bbh 2021/05/15 MFPCORS(R%, S%) = MFPGro(R%, S%) - MFPRATE(R%, S%) _
                    '- (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 100
                    MFPCORS(R%, S%) = MFPGROWTH(R%, S%) - MFPRATE(R%, S%) _
                   - (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 100

                    'bbh 2021/05/15 glocorrect = glocorrect + MFPCORS(R%, S%) * VADD(R%, S%)
                    MFPGLOCOR = MFPGLOCOR + MFPCORS(R%, S%) * VADD(R%, S%)

                    GloGDP = GloGDP + VADD(R%, S%)
                    'Base for bringing regional MFP growth to predicted over time
                Next S%
            Next R%
            'bbh 2021/05/15 glocorrect = glocorrect / AMAX(0.001, GloGDP)
            MFPGLOCOR = MFPGLOCOR / AMAX(0.001, GloGDP)
            MFPGloCorI = MFPGLOCOR 'bbh 2021/05/15

            '   First Year 2:  Compute sectoral correction factor
            '   -------------------------------------------------
            For R% = 1 To NR%
                For S% = 1 To NSec%
                    MFPRATE(R%, S%) = MFPRATE(R%, S%) + MFPGLOCOR '+glocorrect 'bbh 2021/05/15
                    'bbh 2021/05/15 MFPCORS(R%, S%) = MFPGro(R%, S%) - MFPRATE(R%, S%) _
                    '- (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 100
                    'bbh 2021/06/01 added IGDPRDif to MFPCORS if igdpr has changed
                    MFPCORS(R%, S%) = MFPGROWTH(R%, S%) - MFPRATE(R%, S%) _
                - (MFPHC(R%) + MFPSC(R%) + MFPPC(R%) + MFPKN(R%)) / 100 + IGDPRDif(R%)

                    'bbh 2011/12/17
                    MFPCORS(R%, S%) = CSng(Amin(0.1, MFPCORS(R%, S%))) 'Qatar correction

                    'jrs 2014/08/13
                    MFPCorSI(R%, S%) = MFPCORS(R%, S%)
                    MFPCORS(R%, S%) = MFPCORS(R%, S%) * 100

                    'Country has growth initially tied to energy production/exports that
                    'are not really productivity; ideally control for this in some other way
                    MFPRATE(R%, S%) = MFPRATE(R%, S%) + mfpbasgr 'allows additional system shift
                Next S%
                'bbh 2019/09/08 end
                'If RegName$(R%) = "United States Of America" Then Stop
                ' BBH 5/14/04 Begin V5_0
                'jrs 2024/06/19 Call XYTABL("GDP/Capita (PPP) Versus Internet Percent Use (2000)",
                'Amin(40, GDPPCP(R)), NumNWPPer, context)
                Call XYTABL(TFNameInternetPctUse, Amin(40, GDPPCP(R)), NumNWPPer, context)
                NumNWPShift(R%) = NUMNWP(R%) / POP(R%) * 100 - NumNWPPer
                snumnwp(R%) = NUMNWP(R%)
                numnwpmin(R%) = NUMNWP(R%)
                SPredNUMNWP(R%) = NUMNWP(R%)
