' Private Sub IFsEcoPovAgeSex420AllButFirst()

            '   All But First:  Poverty by age-sex
            '   -------------------------------------------


            'All But First: Compute population by poverty age-sex grouping
            '------------------------------------------------------------
            'Aggagedstflex agStart, agEnd, POPPOVAG 'agedstpov


            'All But First: Compue poverty rates by age group for both sexes combined
            '--------------------------------------------------------------------------
            For R% = 1 To NR%

                If POVMIDLOW(R%) = 0 Then 'no poverty
                    POVRATE420(R%, RefAGTot, Total) = 0
                Else
                    'poverty rate,  both sexes = national poverty rate, when reference AG is All Ages
                    POVRATE420(R%, RefAGTot, Total) = 100 * POVMIDLOW(R%) / POP(R%)
                End If

                'mti 2021/12/28 start
                If povagesexagratnat <> 0 Then

                    For j% = 1 To TotPovAGCount
                        'Poverty (Age group - multiple of all ages)
                        PovRateRatioToRefAG_Cur = iPovRateRatioToRefAG420(R%, j%) * povagesexagratnat
                        POVRATE420(R%, j%, Total) = AMAX(0, Amin(100, POVRATE420(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                    Next

                Else
                    'mti 2021/12/28 End

                    'income target covered up so far (will be equated to poverty target covered up so far)
                    IncomeTrgt = 37.5  'computation by Yutang/Dave from avg of all HIC countries with 2000 to 2015 data

                    If iGDPPCP(R%) >= IncomeTrgt Then
                        'at year 1 country already at target income; poverty ratio to ref group merges to target value temporally
                        For j% = 1 To TotPovAGCount
                            'temporal (20 yr) convergence of initial ratio to target ratio
                            PovRateRatioToRefAG_Cur = ConvergeOverTime(iPovRateRatioToRefAG420(R%, j%), CSng(PovRateRatioToRefAG_Trgt(j%)), 20) 'AMAX(0, (can be in both direction)
                            'POVRATE420(R%, j%, Total) = POVRATE420(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur
                            POVRATE420(R%, j%, Total) = AMAX(0, Amin(100, POVRATE420(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                        Next

                        'once converged even if an extreme prolonged recession brings GDPPCP(R%) below target; AG pov ratio to ref won't move;

                    Else
                        If sGDPPCP(R%) >= IncomeTrgt Then  'sGDPPCP(R%) saved in more than 1 place populat, AG, Infra (?) save in economy after external
                            IncTrgtCovd = 1
                        Else  'negatives will also be handled below
                            IncTrgtCovd = (sGDPPCP(R%) - iGDPPCP(R%)) / (IncomeTrgt - iGDPPCP(R%))

                            If sGDPPCP(R%) < iGDPPCP(R%) Then  'declining income; increasing national poverty

                                For j% = 1 To TotPovAGCount - 1
                                    If PovRateRatioToRefAG_Trgt(j%) < iPovRateRatioToRefAG420(R%, j%) Then  'Venzuela: 60+: 1.4 initial; .52 target
                                        IncTrgtCovd = 0 'initial AG/refAG Pov ratio higher than target;
                                    End If
                                Next
                            End If

                        End If


                        For j% = 1 To TotPovAGCount

                            'Poverty (AG multiple of all ages) target covered up so far  = IncTrgtCovd
                            PovRateRatioToRefAG_Cur = CSng(iPovRateRatioToRefAG420(R%, j%) + IncTrgtCovd * (PovRateRatioToRefAG_Trgt(j%) - iPovRateRatioToRefAG420(R%, j%)))  'AMAX(0, (can be in both direction)

                            POVRATE420(R%, j%, Total) = AMAX(0, Amin(100, POVRATE420(R%, RefAGTot, Total) * PovRateRatioToRefAG_Cur))
                        Next
                    End If
                    'mti 2021/12/28 start
                End If
                'mti 2021/12/28 End

                If povagesexnormstatic = 0 Then
                    'base case: using national poverty forecast for normalizing: top-down
PovertyNormalizeAgeGroup(R%, POVRATE420, POVCOUNT420, CSng(POVMIDLOW(R%)))
    ' ---- Begin Inlined Level 2: IFsEcoPovAgeSex420AllButFirst:PovertyNormalizeAgeGroup
' Private Sub PovertyNormalizeAgeGroup(R%, PovRateVec(,,) As Single, PovCountVec(,,) As Single, povnational_hc As Single)
                '---------------------------------------------------------------------
                'mti 2021/01/29 - take entire procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)
                'gvdb 2024/04/05
                ' unused variable
                Dim j As Integer, NormFac As Single, NonNormTot As Single 'gndr As Integer,
    
                If CSng(POVMIDLOW(R%)) < 0.000002 Then    'no poor or less than 2 poor in total, make it 0
                    POVCOUNT420(R%%, TotPovAGCount, Total) = 0
                    POVRATE420(R%%, TotPovAGCount, Total) = 0
                    For j% = 1 To TotPovAGCount
                        POVRATE420(R%%, j%, Total) = 0
                        POVCOUNT420(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NonNormTot = 0
                For j% = 1 To TotPovAGCount - 1 'Last elenment is all ages
                    POVCOUNT420(R%%, j%, Total) = AMAX(0, POVRATE420(R%%, j%, Total) * POPPOVAG(R%%, j%, Total) / 100)
                    NonNormTot = NonNormTot + POVCOUNT420(R%%, j%, Total) 'POVRATE420(R%%, j%, Total) * POPPOVAG(R%%, j%, Total) / 100
                Next
    
                If NonNormTot = 0 Then
                    POVCOUNT420(R%%, TotPovAGCount, Total) = 0
                    POVRATE420(R%%, TotPovAGCount, Total) = 0
                    For j% = 1 To TotPovAGCount
                        POVRATE420(R%%, j%, Total) = 0
                        POVCOUNT420(R%%, j%, Total) = 0
                    Next
                    Exit Sub
                End If
    
                NormFac = CSng(POVMIDLOW(R%)) / NonNormTot
    
                POVCOUNT420(R%%, TotPovAGCount, Total) = CSng(POVMIDLOW(R%)) '0  'CSng(POVMIDLOW(R%))
    
                Dim AllAgeGroupButChild As Single
                AllAgeGroupButChild = 0
                For j% = 2 To TotPovAGCount - 1
                    'age groups other than All Ages
                    POVCOUNT420(R%%, j%, Total) = CSng(Round(POVCOUNT420(R%%, j%, Total) * NormFac, 6))
                    If POVCOUNT420(R%%, j%, Total) < 0.000002 Then 'less than 2 poor person, make it 0
                        POVCOUNT420(R%%, j%, Total) = 0
                    End If
                    'mti 2020/04/29 start
                    'POVRATE420(R%%, j%, Total) = 100 * POVCOUNT420(R%%, j%, Total) / POPPOVAG(R%%, j%, Total)
                    POVRATE420(R%%, j%, Total) = 100 * POVCOUNT420(R%%, j%, Total) / AMAX(0.000001, POPPOVAG(R%%, j%, Total))
                    'mti 2020/04/29 End
                    AllAgeGroupButChild = AllAgeGroupButChild + POVCOUNT420(R%%, j%, Total)
                Next
    
                'give the remaining, if any to 0-14 group
                POVCOUNT420(R%%, 1, Total) = CSng(AMAX(0, Round(POVCOUNT420(R%%, TotPovAGCount, Total) - AllAgeGroupButChild, 6)))
                'mti 2020/04/29 start
                'POVRATE420(R%%, 1, Total) = 100 * POVCOUNT420(R%%, 1, Total) / POPPOVAG(R%%, 1, Total)
                POVRATE420(R%%, 1, Total) = 100 * POVCOUNT420(R%%, 1, Total) / AMAX(0.000001, POPPOVAG(R%%, 1, Total))
    
                'POVRATE420(R%%, TotPovAGCount, Total) = 100 * POVCOUNT420(R%%, TotPovAGCount, Total) / POPPOVAG(R%%, TotPovAGCount, Total)
                POVRATE420(R%%, TotPovAGCount, Total) = 100 * POVCOUNT420(R%%, TotPovAGCount, Total) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Total))
                'mti 2020/04/29 End
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSex420AllButFirst:PovertyNormalizeAgeGroup
                Else
                    'national poverty rate (top-down) frozen for normalization: POVRATE420(R, Total, Total) - is bottom up national poverty
