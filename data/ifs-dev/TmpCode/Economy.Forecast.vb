                SExRate(R%) = 1
                EXRATE(R%) = 1
                AIDLPI(R%) = aidlp(R%)

                '   First Year:  Foreign Direct Investment
                '   --------------------------------------

                sxfdistock(R%) = XFDISTOCK(R%)
                If XFDISTOCK(R%) > 0.001 Then
                    FDIGrowth = XFDIFIN(R%) - XFDISTOCK(R%) / lks(Manu)
                    'SXFDISTOCKR(R%) = (XFDIFIN(R%) / XFDISTOCK(R%)) * 100
                    sxfdistockr(R%) = (FDIGrowth / XFDISTOCK(R%)) * 100
                Else
                    sxfdistockr(R%) = 0
                End If
                'If RegName$(R%) = "India" Then Stop

                sxfdistout(R%) = XFDISTOUT(R%)
                If XFDISTOUT(R%) > 0.001 Then
                    FDIGrowth = XFDIFOUT(R%) - XFDISTOUT(R%) / lks(Manu)
                    SXFDISTOUTR(R%) = FDIGrowth / XFDISTOUT(R%) * 100
                Else
                    SXFDISTOUTR(R%) = 0
                End If
                SXFDIGDPOUT(R%) = XFDISTOUT(R%) / GDP(R%)
                SXFDIGDPIn(R%) = XFDISTOCK(R%) / GDP(R%)

                WFDIStock = WFDIStock + XFDISTOCK(R%)
                WFDIFLOWS = WFDIFLOWS + XFDIFIN(R%)
                WGDPI = WGDPI + GDP(R%)

                '   First Year:  Portfolio Investment
                '   --------------------------------------

                WPortfolio = WPortfolio + XPORTFOLIO(R%)
                WPOrtFIn = WPOrtFIn + XPORTFIN(R%)

            Next R%
            'bbh 2011/11/12 'Adjusts initital porfolio stock growth rate so that
            'flows do not have transient after 1st year
            If context.HistoricMode = True Then
                PortGRI = 0.02
            Else
                PortGRI = CSng(AMAX(0.005, WPOrtFIn / WPortfolio - 0.03))
            End If

            For R% = 1 To NR%
                '        XPORTFOUT(R%) = WPortFIn * XPORTSTOUT(R%) / AMAX(0.001, WPortfolio)
                'Assumes Pre-Processor assures world Stocks = World Stocks Out
                SXPortfolio(R%) = XPORTFOLIO(R%)
                XPortfolioI(R%) = XPORTFOLIO(R%)
                If XPORTFOLIO(R%) > 0.001 Then
                    SXPortfolioR(R%) = XPORTFIN(R%) / XPORTFOLIO(R%) * 100
                Else
                    SXPortfolioR(R%) = 0
                End If
                SXPORTSTOUT(R%) = XPORTSTOUT(R%)
                If XPORTSTOUT(R%) > 0.001 Then
                    SXPORTSTOUTR(R%) = XPORTFOUT(R%) / XPORTSTOUT(R%) * 100
                Else
                    SXPORTSTOUTR(R%) = 0
                End If
                SXPortGDPOUT(R%) = XPORTSTOUT(R%) / GDP(R%)
                SXPortGDPIn(R%) = XPORTFOLIO(R%) / GDP(R%)
                'If RegName$(R%) = "Bahamas" Or RegName$(R%) = "United States of America" Then Stop

                '   First Year:  Firm Debt - Guaranteed and Not
                '   -------------------------------------------

                'XFIRMDEBT(R%) = 0 'bbh 2021/09/21 XFIRMDEBT not adequately forecast, but trial with 0 did not work
                SXFIRMDEBT(R%) = XFIRMDEBT(R%)

                '   First Year:  IMF Obligations, Flows
                '   -----------------------------------

                SXIMFCREDIT(R%) = XIMFCREDIT(R%)
                If XIMFCREDIT(R%) > 0 Then ' borrowers
                    SUMIMFFLOWSIN = SUMIMFFLOWSIN + XIMFCRFIN(R%)
                    SUMIMFFLOWSOUT = SUMIMFFLOWSOUT + XIMFCRFOUT(R%)
                    XIMFCREDITTOT = XIMFCREDITTOT + XIMFCREDIT(R%)
                End If
            Next R%
            XIMFFLOWSINTOTI = SUMIMFFLOWSIN
            SXIMFCREDITTOT = AMAX(0.0001, XIMFCREDITTOT) * (1 + ximfcreditr / 100) 'increased by new subscriptions
            XIMFCREDITTOTI = XIMFCREDITTOT

            For R% = 1 To NR%
                '        If XIMFCREDIT(R%) < 0 Then  ' subscribers; determine 1st year and total subscriptions
                '            XIMFCREDITSUBI(R%) = -XIMFCREDIT(R%)
                '                'assumes subscriptions set equal to credits in preprocessor
                '            XIMFCRFOUT(R%) = (SUMIMFFLOWSIN - SUMIMFFLOWSOUT) _
                '                * XIMFCREDITSUBI(R%) / XIMFCREDITTOT
                '        Else
                '            XIMFCREDITSUBI(R%) = 0
                '        End If
                If XIMFCREDIT(R%) < 0 Then 'lenders
                    XWBLOANSUBI(R%) = -XIMFCREDIT(R%)
                    SXIMFSUBF(R%) = XIMFSUBF(R%)
                End If
                XIMFCRFINI(R%) = XIMFCRFIN(R%)
                SXIMFCRFIN(R%) = XIMFCRFIN(R%)
                XIMFCRFOUTI(R%) = XIMFCRFOUT(R%)
                XIMFCREDITI(R%) = XIMFCREDIT(R%) 'bbh 2020/08/15

                '   First Year:  IMF Lending Predictions
                '   ----------------------------------------------------------

                Prediction = XIMFCRFINI(R%) / GDPPOT(R%) * 100
                IMFCREDITPI(R%) = AMAX(0#, Amin(100, Prediction))
            Next R%

            '   First Year:  WB Obligations, Flows
            '   -----------------------------------
            For R% = 1 To NR%
                SXWBLOANS(R%) = XWBLOANS(R%)
                If XWBLOANS(R%) > 0 Then ' borrowers
                    SUMWBFLOWSIN = SUMWBFLOWSIN + XWBLNFIN(R%)
                    SUMWBFLOWSOUT = SUMWBFLOWSOUT + XWBLNFOUT(R%)
                    XWBLOANSTOT = XWBLOANSTOT + XWBLOANS(R%)
                End If
            Next R%
            XWBFLOWSINTOTI = SUMWBFLOWSIN
            sxwbloanstot = AMAX(0.0001, XWBLOANSTOT) * (1 + xwbloanr / 100) 'increased by new subscriptions
            XWBLOANSTOTI = XWBLOANSTOT

            For R% = 1 To NR%
                If XWBLOANS(R%) < 0 Then 'lenders
                    XWBLOANSUBI(R%) = -XWBLOANS(R%)
                    SXWBSUBF(R%) = XWBSUBF(R%)
                End If
                XWBLNFINI(R%) = XWBLNFIN(R%)
                XWBLNFOUTI(R%) = XWBLNFOUT(R%)
                XWBLOANSI(R%) = XWBLOANS(R%) 'bbh 2020/08/15 - keep track of whether borrowers or only subscribers to bank
            Next R%

            '     First Year:  WB Flows by Target Without Recipient Country (reproduced all but first)
            '     -----------------------------------------------------------------------------------
            'jrs 2014/09/15
            Dim SumFlows As Single, ft As Integer, Reduc As Single
            For R% = 1 To NR%
                SumFlows = 0
                For ft% = 1 To NWBTar%
                    XWBFLOWS(R%, ft%) = XWBLNFIN(R%) * xwbsectar(ft%) / 100
                    SumFlows = SumFlows + XWBFLOWS(R%, ft%)
                Next ft%
                If SumFlows > 0.01 Then
                    For ft% = 1 To NWBTar%
                        XWBFLOWS(R%, ft%) = XWBFLOWS(R%, ft%) * XWBLNFIN(R%) / SumFlows
                    Next ft%
                End If

                '   First Year:  Adjust World Bank Flows for OverExpenditure
                '   ----------------------------------------------------------

                For ft% = 1 To NWBTar%
                    xwbflowsI(R%, ft%) = XWBFLOWS(R%, ft%)
                Next ft%

                'If RegName$(R%) = "Mali" Then Stop
                If XWBFLOWS(R%, 1) > 0.9 * GDS(R%, Educ) Then
                    'compare flows to educ with expendutures on it
                    Reduc = CSng(XWBFLOWS(R%, 1) - 0.9 * GDS(R%, Educ))
                    xwbflowsI(R%, 1) = XWBFLOWS(R%, 1) - Reduc
                    xwbflowsI(R%, 5) = XWBFLOWS(R%, 5) + Reduc
                End If
                If XWBFLOWS(R%, 2) > 0.9 * GDS(R%, Health) Then
                    'compare flows to health with expendutures on it
                    Reduc = CSng(XWBFLOWS(R%, 2) - 0.9 * GDS(R%, Health))
                    xwbflowsI(R%, 2) = XWBFLOWS(R%, 2) - Reduc
                    xwbflowsI(R%, 5) = XWBFLOWS(R%, 5) + Reduc
                End If
                If XWBFLOWS(R%, 3) > 0.9 * GOVHHTRNWEL(R%, 1) Then
                    'compare flows to unskilled with expendutures on them
                    Reduc = CSng(XWBFLOWS(R%, 3) - 0.9 * GOVHHTRNWEL(R%, 1))
                    xwbflowsI(R%, 3) = XWBFLOWS(R%, 3) - Reduc
                    xwbflowsI(R%, 5) = XWBFLOWS(R%, 5) + Reduc
                End If
                If XWBFLOWS(R%, 4) > 0.9 * GOVHHTRNWEL(R%, 2) Then
                    'compare flows to skilled with expendutures on them
                    Reduc = CSng(XWBFLOWS(R%, 4) - 0.9 * GOVHHTRNWEL(R%, 2))
                    xwbflowsI(R%, 4) = XWBFLOWS(R%, 4) - Reduc
                    xwbflowsI(R%, 5) = XWBFLOWS(R%, 5) + Reduc
                End If
                For ft% = 1 To NWBTar%
                    If XWBFLOWS(R%, ft%) > 0.001 Then
                        sxwbflowsr(R%, ft%) = xwbflowsI(R%, ft%) / XWBFLOWS(R%, ft%)
                    Else
                        sxwbflowsr(R%, ft%) = 1
                    End If
                Next ft%
                'If RegName$(R%) = "Angola" Then Stop
                '   First Year:  World Bank Lending Percent of GDP Predictions
                '   ----------------------------------------------------------

                aidpergdp(R%) = AMAX(0, AID(R%) / GDPPOT(R%) * 100)
                Call AnalFunc("World Bank Loans as % of Recipient GDP",
                    New Single() {GDPPCP(R%), GINIDOM(R%), aidpergdp(R%)}, Prediction,
                    New String() {"GDPPCP", "GINIDOM", "AIDPERGDP"}, context) 'jrs 2014/10/09 added DepVar Names to check order
                wbloanspi(R%) = AMAX(0#, Amin(10, Prediction))
                wbloansrgdpi(R%) = XWBLNFIN(R%) / GDPPOT(R%) * 100
                sGINIDOM(R%) = GINIDOM(R%)

                'jrs 2023/05/02
                If envtemptoginidomsw > 0 And Not XGINIDOMLOAD(R%) Then
                    XGINIDOM(R%) = GINIDOM(R%)
                    XGINIDOMLOAD(R%) = True
                End If

                'If RegName$(R%) = "Angola" Then Stop
                '   First Year:  Govt Debt - Short plus Medium/Long Term (MLT)
                '   ----------------------------------------------------------

                sxgovtdebt(R%) = XGOVTDEBT(R%)
                sxgovtdebtb(R%) = XGOVTDEBTB(R%)

                '   First Year:  International Financial Reserves
                '   ---------------------------------------------

                SXReserves(R%) = XRESERVES(R%) / 100 * GDP(R%)

                'bbh 2020/03/09 start comment out remittances block; handled now in subroutine called ealier
                ''   First Year:  Worker Remittances
                ''   -------------------------------

                ''        If XWORKREMIT(R%) < 0 Then
                ''        End If
                'If POPFOREIGN(R%) > 0 Then
                '    WWorkRemit = WWorkRemit - XWORKREMIT(R%)
                '    WPopForeign = WPopForeign + POPFOREIGN(R%)
                'End If

            Next R%

            'jrs 2014/09/16
            Dim SWFDI As Single, SWPortfolio As Single

            SWFDIRGDP = WFDIStock / AMAX(0.0001, WGDPI)
            SWFDI = WFDIStock
            SWPortfolioRGDP = WPortfolio / AMAX(0.0001, WGDPI)
            SWPortfolio = WPortfolio

            'WorkRemitRate = WWorkRemit / AMAX(0.001, WPopForeign)


            'For R% = 1 To NR%
            '    If Abs(POPFOREIGN(R%)) > 0.01 Then
            '        WorkRemitRateI(R%) = (Abs(XWORKREMIT(R%)) / Abs(POPFOREIGN(R%))) / WorkRemitRate
            '    Else
            '        WorkRemitRateI(R%) = 1
            '    End If
            '    'If RegName$(R%) = "Myanmar" Then Stop
            'Next R%
            'bbh 2020/03/09 end

            ' bbh 2022/06/23 Conceputally moved XDEBTRPA to XNFA in preprocessor and model; Conceptually built XNIIP to be old XDEBTRPA
            '   First Year:  Total External Debt
            '   --------------------------------
            For R% = 1 To NR%
                sxdebtrpa(R%) = XDEBTRPA(R%)
                ssxdebtrpapercent(R%) = XDEBTRPA(R%) / GDPPOT(R%) * 100 'bbh 2022/06/23

                'bbh 2020/05/26 Next two lines better in IFUN=3 or IY=1 branch with others; not used in MFP calc year 1
                '        SmTradeTerm(R%) = (X(R%) + M(R%)) / GDPPOT(R%) * 100
                '        TradeTermMa(R%) = TradeTerm(R%) 'bbh 2016/01/19
                'If RegName$(R%) = "Sweden" Then Stop
                'If RegName$(R%) = "Nigeria" Then Stop
            Next R%

            'jrs 2014/04/11 *** begin ***
            '     First Year:  Political Engagement
            '     --------------------------------
            'jrs 2014/09/16
            Dim SumODA As Single

            SumODA = 0
            For R% = 1 To NR%
                SumODA = SumODA + Abs(AID(R%))
            Next R%
            AidBenchI = SumODA / WGDP
            'jrs 2014/04/11 *** end ***

            'jrs 2024/06/12
            TbNameFDIStockInf = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus FDI Stock Inflows Over GDP (" & BaseYear & ")"
            TbNameFDIStockInf = getFunctionNameYrOrMstRct(TbNameFDIStockInf, BaseYear, context, "(PPP " & ConstantDollarsYear & ")")
            TbNameFDIStockOut = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus FDI Stock Outflows Over GDP (" & BaseYear & ")"
            TbNameFDIStockOut = getFunctionNameYrOrMstRct(TbNameFDIStockOut, BaseYear, context, "(PPP " & ConstantDollarsYear & ")")

            IFsEcoIntl1AllYears(context)
            IFsEcoIntl2AllYears(context)
        End Sub
