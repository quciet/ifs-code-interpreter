                        End If 'bbh 2023/01/11 end of addressing issues like Sudan explosion of services growth and of net assets

                        sxkav(R%, S%) = xkav(R%, S%) * xhw + (1.0! - xhw) * xkav_cur
                        'xbase = (sxkav(R%, S%) * szs(R%, S%) + AMAX(0, ST(R%, S%)) + _
                        'sxkav(R%, S%) * elasxinc(R%) * (zsp(R%, S%) - szs(R%, S%))) * _
                        '(1! + xshift(R%))
                        'dbase = CS(R%, S%) + GS(R%, S%) + INVS(R%, S%) + zsp(R%, S%) '- PFD(R%, S%)
                        'MKAV_Cur = MS(R%, S%) / AMAX(smoothdbase(R%, S%), 0.0001)
                        If gdprext(R%) < -99 Then 'endogenous 'bbh 2022/09/05 added if-then-else block for line above block and line below block
                            MKAV_Cur = CSng(MS(R%, S%) / AMAX(smoothdbase(R%, S%), 0.0001))
                            smkav(R%, S%) = mkav(R%, S%) * mhw + (1.0! - mhw) * MKAV_Cur
                        Else 'exogenous
                            MKAV_Cur = MS(R%, S%) / (CS(R%, S%) + GS(R%, S%) + INVS(R%, S%) + ZS(R%, S%))
                            smkav(R%, S%) = MKAV_Cur
                        End If
                        'smkav(R%, S%) = mkav(R%, S%) * mhw + (1! - mhw) * MKAV_Cur
                        sxkav(R%, S%) = AMAX(0.0001, Amin(sxkav(R%, S%), XKAVMAX(R%, S%)))
                        smkav(R%, S%) = AMAX(0.0001, Amin(smkav(R%, S%), MKAVMax(R%, S%)))

                        'bbh 2024/10/22 Eliminated If-Then below.  Syria no longer such big debt issue; but Mozambique has one and this was causing big jump in
                        'service imports when the debt to GDP ratio fell below 1 - that jump interrupted fall in imports with significant upward transient
                        'If XDEBTRPA(R%) / GDP(R%) > 1 Then 'bbh 2022/06/23 Added if-then
                        '    'to control import rise in debt-ridden countries like Syria due to surplus global export capacity
                        '    'Some such countries will not be able to control simply by exchange rate decline
                        '    If smkav(R%, S%) > 0.2 Then
                        '        'If RegName$(R%) = "Syrian Arab Republic" And S% = 4 And IY% + 2016 >= 2041 And IY% + 2016 <= 2045 Then Stop
                        '        'If RegName$(R%) = "Viet Nam" And S% = 4 And IY% + 2016 >= 2084 And IY% + 2016 <= 2088 Then Stop
                        '        Mul = CSng(1 - 0.02 * (XDEBTRPA(R%) / GDP(R%) - 1))
                        '        smkav(R%, S%) = Amin(mkav(R%, S%), MKAV_Cur) * Mul
                        '    End If
                        'End If

                        XRAT = XS(R%, S%) / GDPPOT(R%)
                        If XRAT > XKAVMAXGDP(R%, S%) Then
                            sxkav(R%, S%) =
                        AMAX(0.95 * sxkav(R%, S%), sxkav(R%, S%) * XKAVMAXGDP(R%, S%) / XRAT)
                        End If
                        'If RegName$(R%) = "United States Of America" And S% = 4 And IY% >= 2 Then Stop

                        MRAT = MS(R%, S%) / GDPPOT(R%)
                        If MRAT > MKAVMAXGDP(R%, S%) Then
                            smkav(R%, S%) =
                        AMAX(0.95 * smkav(R%, S%), smkav(R%, S%) * MKAVMAXGDP(R%, S%) / MRAT)
                        End If
                        'This limit relative to GDP helps constrain trade when a sector (like ICT)
                        'grows very rapidly as a percentage of GDP;
                        'entrepot type trade is easier for small sector

                        '                xmaxgdp = XKAVMAXGDP(R%, S%) * GDP(R%) / AMAX(xbase, 0.0001)
                        '                If xmaxgdp < xkav(R%, S%) Then
                        '                    'sometimes inital exports/GDP too high; bring down over time
                        '                    xgdplim = ConvergeOverTime(xkav(R%, S%), xmaxgdp, 30)
                        '                Else
                        '                    xgdplim = xmaxgdp
                        '                End If
                        '                sxkav(R%, S%) = Amin(sxkav(R%, S%), xgdplim)

                        '                mmaxgdp = MKAVMAXGDP(R%, S%) * GDP(R%) / AMAX(dbase, 0.0001)
                        '                If mmaxgdp < mkav(R%, S%) Then
                        '                    'sometimes inital imports/GDP too high; bring down over time
                        '                    mgdplim = ConvergeOverTime(mkav(R%, S%), mmaxgdp, 30)
                        '                Else
                        '                    mgdplim = mmaxgdp
                        '                End If
                        '                smkav(R%, S%) = Amin(smkav(R%, S%), mgdplim)

                        'If RegName$(R%) = "Equa Guinea" And S% = 4 And IY% >= 2 Then Stop
                    Next R%
                    'bbh 2019/10/12 start
                Else
                    For R% = 1 To NR
                        sszs(R%, S%) = szs(R%, S%) 'bbh 2023/07/22 Intoduce 2nd year lag for use in adjusting sectoral growth rates s%>2
                        szs(R%, S%) = ZS(R%, S%) 'bbh 2023/07/22

                        SMS(R%, S%) = MS(R%, S%) 'Save this for agriculture and energy;
                        'Needed for tariff revenue calculation
                    Next R%
                    'bbh 2019/10/12 end
                End If
            Next S%

            ''jrs 2008/11/07
            'If IY > 21 Then
            '    Open FdrvRun$ & "ifslog.txt" For Append As #500
            '    Print #500, "Compute Total Trade"
            '    Close #500
            'End If
            ' BBH 7/22/04 Begin V5_02
            '   All but First 4, 5:  Compute Total Trade
            '   -------------------------------------

            For R% = 1 To NR%
                X(R%) = 0
                M(R%) = 0
                For S% = 1 To NSec%
                    X(R%) = X(R%) + XS(R%, S%)
                    M(R%) = M(R%) + MS(R%, S%)
                Next S%
            Next R%

            ''jrs 2008/11/07
            'If IY > 21 Then
            '    Open FdrvRun$ & "ifslog.txt" For Append As #500
            '    Print #500, "Compute Trade Ratio For Productivity Impact"
            '    Close #500
            'End If

            '   All but First 4, 5:  Compute Trade Ratio for Productivity Impact
            '   -------------------------------------------------------------
            'jrs 2014/09/15
            Dim ProductivityImportBase As Single
            Dim ProductivityImports As Single
            For R% = 1 To NR%
                ProductivityImportBase = 0
                ProductivityImports = 0
                For S% = Manu To NSec%
                    dbase = CS(R%, S%) + GS(R%, S%) + INVS(R%, S%) + zsp(R%, S%)
                    ProductivityImportBase = ProductivityImportBase + VADD(R%, S%) ' dbase
                    ProductivityImports = ProductivityImports + MS(R%, S%)
                Next S%
                SImportr(R%) = ProductivityImports / ProductivityImportBase
            Next R%
            ' BBH 7/22/04 End V5_02

            ''jrs 2008/11/07
            'If IY > 21 Then
            '    Open FdrvRun$ & "ifslog.txt" For Append As #500
            '    Print #500, "Stocks And Prices"
            '    Close #500
            'End If

            '   All but First 4, 5:  Stocks and Prices - Use Stocks from Physical Models if
            '        available in order to compute stock ratios for "tightness" of economy
            '   --------------------------------------------------------------------------
            'jrs 2014/09/15
            'bbh 2021/07/07 start
            'Dim RStBase As Single, RDStocks As Single, rsT As Single, ZSBase As Single, st_red As Single, CompIntr As Single, oldstocks As Single
            'Dim newstocks As Single, suminvs As Single, recomputed As Single, StockChng As Single
            Dim RStBase As Single, RDStocks As Single, rsT As Single, ZSBase As Single, st_red As Single, CompIntr As Single, DeltaStocks As Single
            'gvdb 2024/04/05
            ' unused variable
            Dim suminvs As Single, INTRChange As Single, INTRGap As Single 'bbh 2022/06/23 recomputed As Single, StockChng As Single, 
            'bbh 2021/07/07 end

            For R% = 1 To NR%
                RStBase = 0
                RDStocks = 0
                rsT = 0

                ZSBase = 0
                ExcessSt(R%) = 0
                For S% = 1 To NSec%
                    RStBase = RStBase + StBase(R%, S%)
                    If ((S% > Ener) OrElse (S% = Agri AndAlso agon < 0.9) OrElse
                    (S% = Ener AndAlso enon < 0.9)) Then
                        'bbh 2022/12/13 Tried commented If-End If statements out so as to allow PFD based calc of stock change and accumulation.
                        'Learned that there are huge ST values for ag in some countries if do that and it greatly changes behavior of model
                        'If GRPS(1, R) = "Israel" And S = 3 Then Stop
                        st_red = CS(R%, S%) + INVS(R%, S%) + GS(R%, S%) + XS(R%, S%)
                        ST(R%, S%) = SST(R%, S%) + PFD(R%, S%) + MS(R%, S%) - st_red
                        'If GRPS(1, R%) = "Iraq" And FirstYear + IY - 1 = 2029 And S% = 5 Then Stop

                        '                If S% = 1 Or S% = 2 Then 'bbh 2022/12/13 If-End If to bound ag/en stock levels from PFD calc; not working, need variation
                        '                    ST(R%, S%) = Amin(ST(R%, S%), 3 * StBase(R%, S%) * dstl)
                        '                    If ST(R%, S%) < 0 Then ST(R%, S%) = AMAX(ST(R%, S%), -3 * StBase(R%, S%) * dstl)
                        '                End If

                        'bbh 2020/08/29 Following line addition avoids disequilibrium through exogenous period, even COVID
                        'bbh 2020/11/22  Commented out the line below because was
                        'not avoiding, but causing disequilibirum AFTER COVID period with exogenous thru 2021 or 2025
                        'If gdprext(R%) > -70 Then ST(R%, S%) = StBase(R%, S%) * dstl

                        'bbh 2020/11/22 start Tested but did not use block below; shifted adjustment post intervention to CAPUT in CapacityUtil
                        '                If (gdprext(R%) > -70) And (IY% - 1 + FirstYear = 2025) Then
                        '                    ST(R%, S%) = StBase(R%, S%) * dstl
                        '                    SST(R%, S%) = ST(R%, S%)
                        '                    PRI(R%, S%) = 1
                        '                End If
                        'bbh 2020/11/22 end

                        'bbh 2020/11/14 above line does not allow some adjustments prior to end of exogenous period and then transients; bigger without it
                        ST(R%, S%) = AMAX(-10000, Amin(ST(R%, S%), 10000))
                        'If RegName$(R%) = "Afghanistan" And S% = 6 Then Stop

                        Diff1 = ST(R%, S%) - StBase(R%, S%) * dstl
                        'ExcessSt(R%) = ExcessSt(R%) + Diff1 'bbh 2020/07/01 moved below to pick up ag, en
                        If SST(R%, S%) < StBase(R%, S%) * dstl Then
                            Diff2 = ST(R%, S%) - SST(R%, S%) * (1.0! + igdprcor(R%))
                        Else
                            Diff2 = ST(R%, S%) - SST(R%, S%)
                            'If SST several times base, IGDPRCor can set up postive loop on price
                        End If
                        Call ADJSTR(StBase(R%, S%), Diff1, Diff2, elprst1, elprst2, Mul)
                        'jrs 2024/09/26
                        'If IY >= 80 Then
                        '    Mul = 1
                        'End If

                        'If RegName$(R%) = "Qatar" And IY% >= 90 And S% = 4 Then Stop
                        PRI(R%, S%) = spri(R%, S%) * Mul
                        PRI(R%, S%) = 0.98! * PRI(R%, S%) + 0.02!
                        'To rebase non-physical submodel prices towards 1 over time;
                        'They can drift because of productivity differences;
                        '   trade changes preserve drift
                        'In absence of changing cost structure,
                        '   there is no basis for change over time
                        PRI(R%, S%) = AMAX(0.01, Amin(PRI(R%, S%), 100))
                        'PriBase = PriBase + PRI(R%, S%) * ZS(R%, S%)
                        'ZSBase = ZSBase + ZS(R%, S%)
                        PriBase = PriBase + PRI(R%, S%) * zsp(R%, S%)
                        ZSBase = ZSBase + zsp(R%, S%)
                        spri(R%, S%) = PRI(R%, S%)
                        'jrs 2016/12/21
                        If IFUN = 4 Then
                            SSTS(R%, S%) = SST(R%, S%)
                        End If
                        'bbh 2021/09/21 SST(R%, S%) = ST(R%, S%)
                        'bbh 2020/07/01 start - service sector cannot really carry over excess "stocks"
                        '   and some manufacturing stocks wasted/obsolete; should use sector names in IF statements, may change
                        'bbh 2020/07/23 start
                        'bbh 2021/07/07 start
                        'jrs 2021/09/21 start: enabled again, causing oscillation
                        'bbh 2021/09/21 Block back in again
                        'bbh 2022/08/30 block back off again
                        'If (S% = 3 Or S% = 4 Or S% = 6) And SST(R%, S%) > StBase(R%, S%) * dstl Then
                        '    SST(R%, S%) = CSng(SST(R%, S%) - 0.3 * (SST(R%, S%) - StBase(R%, S%) * dstl))
                        'End If
                        'If S% = 5 And SST(R%, S%) > StBase(R%, S%) * dstl Then
                        '    SST(R%, S%) = CSng(SST(R%, S%) - 0.6 * (SST(R%, S%) - StBase(R%, S%) * dstl))
                        'End If
                        'ST(R%, S%) = SST(R%, S%) 'bbh 2020/08/21 Pass through ealier stock calc to calculations of excess stocks and reductions;
                        'bbh 2021/09/21 end of reactivate
                        'but then reset ST here to take into account reductions; only do for fully economic sectors, not ag and energy;
                        'ag reductions are done in ag model
                        'jrs 2021/09/21 end: enabled again, causing oscillation
                        'bbh 2021/07/07 end
                        'bbh 2020/07/23 end
                        'bbh 2020/07/01 end

                        'bbh 2020/07/01 start - service sector cannot really carry over excess "stocks"
                        '   and some manufacturing stocks wasted/obsolete; should use sector names in IF statements, may change
                        'bbh 2020/07/23 start
                        'bbh 2021/07/07 start
                        'bbh 2021/09/21 Block back in again  'bbh 2022/06/23 experimented with it off again; not much affect
                        '   on exploding intl debt of Brunei-Dar..e
                        '                If (S% = 3 Or S% = 4 Or S% = 6) And ST(R%, S%) > StBase(R%, S%) * dstl Then
                        '                    ST(R%, S%) = ST(R%, S%) - 0.3 * (ST(R%, S%) - StBase(R%, S%) * dstl)
                        '                End If
                        '                If S% = 5 And ST(R%, S%) > StBase(R%, S%) * dstl Then
                        '                    ST(R%, S%) = ST(R%, S%) - 0.6 * (ST(R%, S%) - StBase(R%, S%) * dstl)
                        '                End If
                        SST(R%, S%) = ST(R%, S%) 'bbh 2020/08/21 Pass through earlier stock calc to calculations of excess stocks and reductions;
                        'but then reset ST here to take into account reductions; only do for fully economic sectors, not ag and energy;
                        'ag reductions are done in ag model
                        'bbh 2021/09/21 end of reactivate
                        'bbh 2021/07/07 end
                        'bbh 2020/07/23 end
                        'bbh 2020/07/01 end

                        'bbh 2022/10/27 moved three lines from just below End If to here; ag and energy stocks dealt with in partial equilibrium models
                        '                ExcessSt(R%) = ExcessSt(R%) + ST(R%, S%) - StBase(R%, S%) * dstl 'bbh 2020/07/01 moved here to pick up ag, en
                        '                rsT = rsT + ST(R%, S%)
                        '                RDStocks = RDStocks + StBase(R%, S%) * dstl

                    End If 'bbh 2022/12/13 End of block that has been restricting ST calc to sectors 3-6; if don't restrict, PFD calc of ag stocks behaves badly
                    'bbh 2022/10/27 moved three lines from here to above End If; ag and energy stocks dealt with in partial equilibrium models
                    'If GRPS(1, R%) = "Sudan South" And FirstYear + IY - 1 >= 2054 Then Stop
                    ExcessSt(R%) = ExcessSt(R%) + ST(R%, S%) - StBase(R%, S%) * dstl 'bbh 2020/07/01 moved here to pick up ag, en
                    rsT = rsT + ST(R%, S%)
                    RDStocks = RDStocks + StBase(R%, S%) * dstl
                    ' ST(R%, S%) = SST(R%, S%) 'bbh 2020/08/21 Pass through above stocks to excess stocks; but then readjust here to take into account reductions
                Next S%


                '        For S% = 1 To NSec% 'To gradually bring prices back to base 1
                '            PRI(R%, S%) = PRI(R%, S%) * (ZSBase / PriBase) ^ 0.5
                '            spri(R%, S%) = PRI(R%, S%)
                '        Next S%
                'jrs 2016/12/21
                If IFUN = 4 Then
                    SStRatio(R%) = StRatio(R%)
                End If
                StRatio(R%) = rsT / RStBase
                '   All but First 4, 5:  Interest Rates
                '   --------------------------------

                'bbh 2020/07/31 start 'move from mulitiplicative to additive change in stocks to make movements in both directions
                'comparable for impact of interest rates on C and IGCF
                'RDStocks are desired; rst are actual
                CompIntr = INTRI(R%) + 2 * (RDStocks - rsT) / RDStocks
                'CompIntr = INTRI(R%) * RDStocks / AMAX(0.3 * RDStocks, rsT)
                INTR(R%) = (CompIntr + SIntr(R%)) / 2 'To help kill annual oscillation
                'bbh 2022/06/23 start INTR
                'INTR(R%) = Amin(INTRI(R%) * 2, AMAX(0.01, INTR(R%)))
                INTR(R%) = Amin(INTRI(R%) * 4, AMAX(0.01, INTR(R%)))
                If INTR(R%) > SIntr(R%) Then
                    INTRChange = INTR(R%) - SIntr(R%)
                    INTRGap = INTRI(R%) * 4 - SIntr(R%)
                    INTRChange = CSng(Amin(INTRChange, 0.2 * INTRGap))
                    INTR(R%) = Amin(INTR(R%), SIntr(R%) + INTRChange)
                End If


                'If (IY% = 13) And ((RegName$(R%) = "Congo, Democratic Republic Of") Or (RegName$(R%) = "Nigeria")) Then Stop
                'Sintr(R%) = CompIntr
                'SIntr(R%) = INTR(R%) 'bbh 2022/06/23 Moved to ifsECOSAM5AllbutFirstYear so that could use to affect govexp before computing
                'bbh 2022/06/23 end INTR
                'bbh 2020/07/31 end

                '        INTR(R%) = LongTermIntr(R%) * RDStocks / AMAX(0.3 * RDStocks, RSt)

                '   All but First 4, 5:  Adjust I and INVS by Change in Stocks
                '       - changes meaning from gross capital formation to total investment,
                '           with addition of changes in stocks
                '       - recompute stocks in
                '           physical models so as to preserve accounting balances
                '   -------------------------------------------------------------
                'bbh 2021/07/07 start
                'oldstocks = 0
                'newstocks = 0
                suminvs = 0 'bbh 2022/12/20 This variable could be removed from code, not ever used after computation below
                DeltaStocks = 0
                For S% = 1 To NSec%
                    'If RegName$(R%) = "Angola" Then Stop
                    suminvs = suminvs + INVS(R%, S%)
                    '            If ((S% > Ener) Or (S% = Agri And agon < 0.9) Or _
                    '(S% = Ener And enon < 0.9)) Then 'bbh 2022/12/13  Also tried commenting out the If and End If statements here so that ag and energy stocks also would be PDF based
                    'Same problems recognized as when do that around price and Excess Stock logic; Ag stocks for some countries huge and cause bad Excess Stock behavior
                    'But:  Using PFD logic for stocks in Econ model rather than taking from Ag model greatly improves behavior of S (foreign and domestic) - I should equal 0.0
                    'bbh 2022/12/20 Again using all 6 sectors, but only for computation of I from IGCF - make sure that the IFs stdatement just above is commented out
                    'DStocks = CS(R%, S%) + INVS(R%, S%) + GS(R%, S%) + XS(R%, S%)
                    'DStocks = PFD(R%, S%) + MS(R%, S%) - DStocks
                    'DeltaStocks = DeltaStocks + DStocks
                    st_red = CS(R%, S%) + INVS(R%, S%) + GS(R%, S%) + XS(R%, S%)
                    'recomputed = sstphys(R%, S%) + PFD(R%, S%) + MS(R%, S%) - st_red
                    'oldstocks = oldstocks + sstphys(R%, S%)
                    'newstocks = newstocks + recomputed
                    'sstphys(R%, S%) = recomputed
                    'suminvs = suminvs + INVS(R%, S%)
                    DeltaStocks = DeltaStocks + PFD(R%, S%) + MS(R%, S%) - st_red
                    'If RegName$(R%) = "United States Of America" And IY% >= 45 Then Stop  'bbh 2021/07/07
                    'Development note:  The stocks computed here for ag and en are very
                    'different than those coming from the physcial models; they are
                    'residuals only for the purpose of balancing expenditure components;
                    'remember that PFD has no counterpart in the ag/en models
                    'End If 'bbh 2022/12/13 'bbh 2022/12/20 Again exploring using all 6 sectors, but only for computation of I from IGC
                Next S%
                'i(R%) = IGCF(R%) + newstocks - oldstocks
                I(R%) = IGCF(R%) + DeltaStocks 'bbh 2021/07/07 end
                'jrs 2023/10/23
                If ifsexomodelid > 0 Then
                    ReplaceVarWithExogenousForecastxReg("I", "", "", CStr(FirstYear + IY - 1), R%, context)
                End If
                SI(R%) = I(R%)

                'I(R%) = IGCF(R%) + DeltaStocks

                'If RegName$(R%) = "Angola" Then Stop

                'bbh 2020/08/03 start  INVS already computed in IFsEcoSam from IGCF and should Not be adjusted by change in stocks
                '        StockChng = newstocks - oldstocks
                '        For S% = 1 To NSec%
                '            INVS(R%, S%) = INVS(R%, S%) + StockChng * INVS(R%, S%) / AMAX(0.001, suminvs)
                'If RegName$(R%) = "Central AfR" And IY% >= 10 Then Stop
                '
                '        Next S%
                'bbh 2020/08/03 end
                'If RegName$(R%) = "Angola" Then Stop

                '        This redefinition of INVS to include delta stocks is done now for SAM,
                '           but it would be better to carry another variable to SAM (or to add
                '           delta stocks there; INVS is used appropriatly in st_red above and
                '           ideally should show the origin of IGCF, not I

            Next R

            'jrs 2022/04/04
            'All but First 5: Arms Exports and Imports
            '-------------------------------------------
            Dim globalSumOfImports, globalSumOfExports As Single
            globalSumOfImports = 0
            globalSumOfExports = 0

            For R% = 1 To NR%
                XARMS(R%) = (GDP(R%) * iXARMSTOGDP(R%) + xarmsadd(R%)) * xarmsm(R%)
                MARMS(R%) = CSng(Amin((GDP(R%) * iMARMSTOGDP(R%) + marmsadd(R%)) * marmsm(R%), sgds(R%, Mil) * armsimmaxpctmilexp(R%))) 'clp 11/16/2022 adding armsimmaxpctmilexp
                globalSumOfExports = globalSumOfExports + XARMS(R%)
                globalSumOfImports = globalSumOfImports + MARMS(R%)
            Next R%

            'Normalize
            For R% = 1 To NR%
                XARMS(R%) = XARMS(R%) * globalSumOfImports / globalSumOfExports
            Next R%


            ''jrs 2008/11/07
            'If IY > 21 Then
            '    Open FdrvRun$ & "ifslog.txt" For Append As #500
            '    Print #500, "End Of Call4"
            '    Close #500
            'End If
            ' GoTo AllSteps 'need to compute trade on 4th step for Interntional Politics
ifsECOAllYears(context, IFUN)
    ' ---- Begin Inlined Level 2: ifsECO5AllbutFirstYear:ifsECOAllYears
' Public Sub ifsECOAllYears(context As IForecastContext, Optional IFUN As Integer = 0)
                'jrs 2014/09/15
                '    Dim SKS_Bas As Single, PredictionRoad As Single, RoadRatio As Single, PredictionTele As Single, TeleRatio As Single, PredictionElec As Single
                '    Dim ElecRatio As Single, nwplim As Single, PredNUMNWPGR As Single, PredNUMNWP As Single, NetComp As Single, netcompnum As Single
                '    Dim PredictionNet As Single, NetRatio As Single
                'bbh 2016/03/11
                Dim SKS_Bas As Single
    
    
                'mti 2015/05/06 - start
                '    'mti 2015/04/29 - start
                '    Dim ICTCyberSecSpendExp As Single, ICTIndexContrib As Single
                '    'mti 2015/04/29 - end
                '
                '
                '    Dim ICTINDEXExp As Single, CostChangeFac As Single, iLCybCrimeEspF As Single, CybCrimeEspF As Single, ICTCybEvtScale As Single
                '    'mti 2015/05/06 end
    
                For R% = 1 To NR%
    
    
                    '     All Steps:  Save GDP at PPP
                    '     ------------------------------------------------
    
                    sgdpp(R%) = GDPP(R%)
    
                    '     All Steps:  Update Capital
                    '     --------------------------
    
                    'If RegName$(R%) = "United States of America" Then Stop
                    For S% = 1 To NSec%
                        'If GRPS(1, R) = "Israel" And S% = 3 Then Stop
                        lks(S%) = CSng(LKStruct(S%) * (1 - 0.00667 * keqshr))
                        'mti June 2010 - run to run historical -start
                        slks(S%) = lks(S%)
                        'mti June 2010 - run to run historical -end
                        SKS_Bas = (KS(R%, S%) + (IDS(R%, S%) - KS(R%, S%) / lks(S%)))
                        'If IY = 19 And GRPS(1, R) = "Israel" And S = 4 Then Stop
                        SKS(R%, S%) = SKS_Bas * (1.0! - CIVDM(R%))
                        SKS(R%, S%) = SKS(R%, S%) * ksm(R%, S%) ' clp 2024/01/22 Adding ksm to enable destruction of capital stocks due to events such as conflict.
                        'jrs 2024/12/23
                        SKS(R%, S%) = SKS(R%, S%) + ksadd(R%, S%)
                        SKS(R%, S%) = AMAX(0.0001, Amin(SKS(R%, S%), 1000000))
                    Next S%
    
                    '   All Steps: Total Economy Multifactor Productivity
                    '   -------------------------------------------------------
    
                    MFPRATET(R%) = 0
