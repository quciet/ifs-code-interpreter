                'POVRATE365(R%%, TotPovAGCount, Total) = 100 * POVCOUNT365(R%%, TotPovAGCount, Total) / POPPOVAG(R%%, TotPovAGCount, Total)
                POVRATE365(R%%, TotPovAGCount, Total) = 100 * POVCOUNT365(R%%, TotPovAGCount, Total) / AMAX(0.000001, POPPOVAG(R%%, TotPovAGCount, Total))
                'mti 2020/04/29 End
' End Sub
    ' ---- End Inlined Level 2: IFsEcoPovAgeSex365AllButFirst:PovertyNormalizeAgeGroup
                End If




                'All But First: Compute Gender Difference and Poverty Rates by Sex
                '---------------------------------------------------------------------

                'use regression model done by Yutang to forecast gender difference in poverty in reference group (=25-34)
                'PovGndDiffRef = 2.1391 - .9123 * LabWageSexRatio  -0.6947 * EdTerEnrollGross%FtoM + 0.0583 * 100 * INCOMELT320LN(R%) / POP(R%) -0.5863* GEM
                'Gender difference in percentage points = Female Poverty Rate for the age group - Male poverty rate for the age group
                'Setting the co-eff of national poverty rate to zero per BBH and DKB, thus making the whole regression relationship questionable

                If INCOMELT365LN(R%) = 0 Then 'no poverty
                    PovGndDiffRefAG = 0
                Else
                    'mti 2021/12/02 start
                    'old model
                    'mti 2021/12/09 start
                    'old model
                    'PovGndDiffRefAGComp = 4.33416473159016 - 0.079593672350414 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    '+ 1.09540339638681 * Log(AMAX(0.001, CBR(R%))) - 3.26793215654607 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 3.021576747570333 * Log(AMAX(0.001, EDYRSAG20TO29(R%, Female)))

                    'mti 2026/07/05 start
                    'earlier regresssion from DB
                    ''DB Regression Revision
                    'PovGndDiffRefAGComp = CSng(-5.52815678628231 + 3.02662016366478 * Log(AMAX(0.001, GINIDOM(R%))) +
                    '    3.05292891620859 * Log(AMAX(0.001, 100 * POPLE15(R%) / POP(R%))) - 3 * Log(LABWAGESEXRAT(R%)) - 3.6693873239469 * Log(AMAX(0.001, EDYRSAG15(R%, Female) / AMAX(0.0001, EDYRSAG15(R%, Male)))))
                    ''mti 2021/12/09 End

                    'Regression with new data
                    PovGndDiffRefAGComp = CSng(-2.93822133229894 + 1.13583904537227 * Log(AMAX(0.001, GINIDOM(R%))) +
                        1.47828472078537 * Log(AMAX(0.001, 100 * POPLE15(R%) / POP(R%))) - 0.721154735409096 * Log(LABWAGESEXRAT(R%)) - 3.89237587644124 * Log(AMAX(0.001, EDYRSAG25(R%, Female) / AMAX(0.0001, EDYRSAG25(R%, Male)))))
                    'mti 2026/07/05 end

                    'new model
                    'PovGndDiffRefAGComp = -7.13320135137263 - 4.30248575703649E-02 * Log(AMAX(0.001, GOVHHTRNWEL(R%, Unskilled) / HHPOP(R%, Unskilled))) _
                    '+ 2.99288598446773 * Log(AMAX(0.001, CBR(R%))) - 0 * Log(AMAX(0.001, LABWAGESEXRAT(R%))) - 2.90380259609907 * Log(AMAX(0.001, EDYRSAG20TO29(R%, Female)))


                    PovGndDiffRefAGComp = AMAX(0, PovGndDiffRefAGComp)

                    If iPovGndDiffAG365(R%, RefAGGnd) < 0 Then 'mti 2021/12/02 start
                        PovGndDiffRefAG = ConvergeOverTime(iPovGndDiffAG365(R%, RefAGGnd), 0, CSng(Amin(50, AMAX(10, Floor(iPovGndDiffAG365(R%, RefAGGnd) * 3)))))
                    Else
                        PovGndDiffRefAG = PovGndDiffRefAGComp + ConvergeOverTime(PovGndDiffRefAGShift365(R%), 0, 50)  '50
                    End If
                    'mti 2021/12/02 end
                End If
                '
                'use gender gap and total (both sexes) poverty to compute female and male poverty rates - reference age group
                If POVRATE365(R%, RefAGGnd, Total) = 0 Then
                    POVRATE365(R%, RefAGGnd, Male) = 0
                    POVRATE365(R%, RefAGGnd, Female) = 0
                Else

                    '           'For gender distribution of very low poverty make sure there is some poverty in each of the sexes
                    If PovGndDiffRefAG >= 0 Then
                        PovGndDiffRefAG = CSng(Amin(PovGndDiffRefAG, 1.5 * POVRATE365(R%, RefAGGnd, Total))) '1.5

                    Else
                        PovGndDiffRefAG = CSng(AMAX(PovGndDiffRefAG, -1.5 * POVRATE365(R%, RefAGGnd, Total)))  '-1.5
                    End If

                    'Use gender difference and total poverty to compute poverty rates for each of the sexes
                    POVRATE365(R%, RefAGGnd, Male) = AMAX(0, (POVRATE365(R%, RefAGGnd, Total) * POPPOVAG(R%, RefAGGnd, Total) - PovGndDiffRefAG * POPPOVAG(R%, RefAGGnd, Female)) / AMAX(0.000001, POPPOVAG(R%, RefAGGnd, Total)))
                    POVRATE365(R%, RefAGGnd, Female) = AMAX(0, PovGndDiffRefAG + POVRATE365(R%, RefAGGnd, Male))

                    '            'once again, make sure there is at least some poverty in each gender
                    POVRATE365(R%, RefAGGnd, Male) = AMAX(POVRATE365(R%, RefAGGnd, Female) * 0.2, POVRATE365(R%, RefAGGnd, Male))
                    POVRATE365(R%, RefAGGnd, Female) = AMAX(POVRATE365(R%, RefAGGnd, Male) * 0.2, POVRATE365(R%, RefAGGnd, Female))

                End If

                'Gender difference for the reference group - final
                PovGndDiffRefAG = POVRATE365(R%, RefAGGnd, Female) - POVRATE365(R%, RefAGGnd, Male)

                'Compute percentage change in reference group gender difference
                'mti 2021/07/15 start
                If iPovGndDiffAG365(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG365(R%, RefAGGnd)) > 0.9 Then 'changed .2 to .9
                    'mti 2021/07/15 end
                    PcntChangeDiffRefAG = (PovGndDiffRefAG - iPovGndDiffAG365(R%, RefAGGnd)) / iPovGndDiffAG365(R%, RefAGGnd)
                Else
                    'use percentage point when initial difference is zero or small
                    PcntPointChangeDiffRefAG = PovGndDiffRefAG - iPovGndDiffAG365(R%, RefAGGnd)
                End If


                'Compute gender difference (and poverty rate) in other age-groups using changes in reference group gender difference
                For j% = 1 To TotPovAGCount

                    If j% <> RefAGGnd Then

                        If POVRATE365(R%, j%, Total) = 0 Then
                            POVRATE365(R%, j%, Male) = 0
                            POVRATE365(R%, j%, Female) = 0
                        Else

                            'mti 2021/07/15 start
                            If iPovGndDiffAG365(R%, RefAGGnd) <> 0 And Abs(iPovGndDiffAG365(R%, RefAGGnd)) > 0.9 Then 'changed .2 to .9
                                'mti 2021/07/15 end

                                PovGndDiffAG = iPovGndDiffAG365(R%, j%) + PcntChangeDiffRefAG * iPovGndDiffAG365(R%, j%)
                            Else
                                PovGndDiffAG = iPovGndDiffAG365(R%, j%) + PcntPointChangeDiffRefAG
                            End If

                            'Prevent the gender difference from being too large compared to total poverty and zeroing out poverty in one of the sexes
                            If PovGndDiffAG >= 0 Then
                                PovGndDiffAG = CSng(Amin(PovGndDiffAG, 1.5 * POVRATE365(R%, j, Total)))
                            Else
                                PovGndDiffAG = CSng(AMAX(PovGndDiffAG, -1.5 * POVRATE365(R%, j, Total)))
                            End If

                            'mti 2020/04/29 Start
                            'POVRATE365(R%, j%, Male) = AMAX(0, (POVRATE365(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / POPPOVAG(R%, j%, Total))
                            POVRATE365(R%, j%, Male) = AMAX(0, (POVRATE365(R%, j%, Total) * POPPOVAG(R%, j%, Total) - PovGndDiffAG * POPPOVAG(R%, j%, Female)) / AMAX(0.000001, POPPOVAG(R%, j%, Total)))
                            'mti 2020/04/29 End
                            POVRATE365(R%, j%, Female) = AMAX(0, PovGndDiffAG + POVRATE365(R%, j%, Male))
                            '
                            'Make sure there is at least some poverty in each gender
                            POVRATE365(R%, j%, Male) = AMAX(POVRATE365(R%, j%, Female) * 0.2, POVRATE365(R%, j%, Male))
                            POVRATE365(R%, j%, Female) = AMAX(POVRATE365(R%, j%, Male) * 0.2, POVRATE365(R%, j%, Female))


                        End If



                    End If

                Next j%
                'mti 2020/03/18 End


