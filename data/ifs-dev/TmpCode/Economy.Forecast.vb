                'bbh 2019/03/09 delete end


                '   First Year:  Sectoral Government and Investment
                '   -----------------------------------------
                For S% = 1 To NSec%
                    sgspl(R%, S%) = GS(R%, S%) / GOVCON(R%)
                    SISPL(R%, S%) = INVS(R%, S%) / IGCF(R%)

                Next S%

                '   First Year:  Initializations
                '   ----------------------------

                IRA(R%) = IGCF(R%) / GDP(R%)
                SIGCF(R%) = IGCF(R%)
                sira(R%) = IRA(R%)
                GDPPCI(R%) = GDPPC(R%)
                irai(R%) = IRA(R%)
                ' BBH 7/27/04
                netfdirgdpi(R%) = (XFDIFIN(R%) - XFDIFOUT(R%) * xfdioutf) / GDP(R%)
                'bbh 2020/07/01 begin
                netportfoliorgdpi(R%) = (XPORTFIN(R%) - XPORTFOUT(R%) * xfdioutf) / GDP(R%)
                'If RegName$(R%) = "United States of America" Then Stop
                SXFDIFIN(R%) = XFDIFIN(R%)
                SXFDIFOUT(R%) = XFDIFOUT(R%)
                SXPORTFIN(R%) = XPORTFIN(R%)
                SXPORTFOUT(R%) = XPORTFOUT(R%)
                'bbh 2020/07/01 end
                iramul(R%) = 1
                cramul(R%) = 1
                SIntrSAM(R%) = INTR(R%)
                SSINTR(R%) = INTR(R%)
                smoothintr(R%) = INTR(R%)
                LongTermIntr(R%) = INTR(R%)
                'jrs 2022/03/03 IAIDGDPR(R%) = AMAX(0, AID(R%) / GDP(R%))

                'mti 2018/07/23 start
                IAID(R%) = AMAX(0, AID(R%))
                'mti 2018/07/23 End

                ExcessSt(R%) = 0

                '   First Year:  Consumption - Set Up Household Propensity Differentials
                '   --------------------------------------------------------------------
                'bbh 2021/05/15 start replace hhdispinc with HHINCDIS
                'hhdispinc(R%, Unskilled) = HHINC(R%, Unskilled) _
                '   - HHTAX(R%, Unskilled) - HHGOVSS(R%, Unskilled)
                'hhdispinc(R%, Skilled) = HHINC(R%, Skilled) _
                '   - HHTAX(R%, Skilled) - HHGOVSS(R%, Skilled)
                'bbh 2020/08/13 start  - code to keep hhdispinc from going negative
                For HHType% = 1 To 2
                    ' If hhdispinc(R%, HHType%) < 0.5 * HHINC(R%, HHType%) Then
                    '    hhadj = 0.5 * HHINC(R%, HHType%) - hhdispinc(R%, HHType%)
                    If HHINCDIS(R%, HHType%) < 0.3 * HHINCEARN(R%, HHType%) Then 'bbh 2022/12/20 Oman, T-L, and Qatar at or below 50%
                        'so dropped threshold to 30% to avoid transient with subsequent years
                        hhadj = CSng(0.3 * HHINCEARN(R%, HHType%) - HHINCDIS(R%, HHType%))
                        '            If HHINCDIS(R%, HHType%) < 0.5 * HHINCEARN(R%, HHType%) Then 'bbh 2022/12/20 Threshold was 50%
                        '                hhadj = 0.5 * HHINCEARN(R%, HHType%) - HHINCDIS(R%, HHType%)
                        hhtaxtot = AMAX(0.001, HHTAX(R%, HHType%) + HHGOVSS(R%, HHType%))
                        HHTAX(R%, HHType%) = HHTAX(R%, HHType%) - hhadj * HHTAX(R%, HHType%) / hhtaxtot
                        HHGOVSS(R%, HHType%) = HHGOVSS(R%, HHType%) - hhadj * HHGOVSS(R%, HHType%) / hhtaxtot
                        HHINCDIS(R%, HHType%) = HHINCDIS(R%, HHType%) + hhadj * HHTAX(R%, HHType%) / hhtaxtot _
                         + hhadj * HHGOVSS(R%, HHType%) / hhtaxtot
                    End If
                Next HHType%
                'bbh 2020/08/13 end

                'bbh 2022/01/30 Start: Switch to variable added to Common
                '         hhdispincperm(R%, Unskilled) = HHINCDIS(R%, Unskilled)
                '         hhdispincperm(R%, Skilled) = HHINCDIS(R%, Skilled)
                HHINCDISPERM(R%, Unskilled) = HHINCDIS(R%, Unskilled)
                HHINCDISPERM(R%, Skilled) = HHINCDIS(R%, Skilled)
                SHHINCDISPERM(R%, Unskilled) = HHINCDISPERM(R%, Unskilled)
                SHHINCDISPERM(R%, Skilled) = HHINCDISPERM(R%, Skilled)
                HHINCDISPERM(R%, Total) = HHINCDIS(R%, Unskilled) + HHINCDIS(R%, Skilled)
                tothhinc = AMAX(0.001, HHINCDIS(R%, Unskilled) + HHINCDIS(R%, Skilled))
                'bbh 2022/01/30 End: Switch to variable added to Common

                'bbh 2022/01/30 Switch to variable added to Common
                AveConsum = C(R%) / tothhinc
                ' HHSavingsTotR = (TotHHInc - C(R%) - HHTAX(R%, Unskilled) - HHTAX(R%, Skilled) _
                '- HHGOVSS(R%, Unskilled) - HHGOVSS(R%, Skilled)) / TotHHInc
                Call XYTABL("GDP/Capita (PPP) Versus Differential Propensity to Consume",
                 GDPPCP(R%), consumdiff, context)
                aveconsumunskilled = Amin(100, AveConsum + consumdiff / 100)
                consumhh(R%, Unskilled) = aveconsumunskilled * HHINCDIS(R%, Unskilled)
                consumhh(R%, Skilled) = C(R%) - consumhh(R%, Unskilled)
                'If GRPS(1, R) = "Sudan South" Then Stop

                If consumhh(R%, Skilled) < 0 Then
                    ConsumShift = CSng(-consumhh(R%, Skilled) + 0.05 * HHINCDIS(R%, Skilled))
                    'jrs 2025/09/17 Doing History for Equatorial Guinea was producing negatives without the following lines
                    If ConsumShift > consumhh(R%, Unskilled) Then
                        ConsumShift = CSng(-consumhh(R%, Skilled) + 0.05 * C(R%))
                    End If

                    consumhh(R%, Unskilled) = consumhh(R%, Unskilled) - ConsumShift
                    consumhh(R%, Skilled) = consumhh(R%, Skilled) + ConsumShift
                End If
                CRA(R%, Unskilled) = consumhh(R%, Unskilled) / HHINCDIS(R%, Unskilled)
                CRA(R%, Skilled) = consumhh(R%, Skilled) / HHINCDIS(R%, Skilled)
                'mti 2018/05/22 start
                CRA(R%, NSkill) = (consumhh(R%, Unskilled) + consumhh(R%, Skilled)) / AMAX(0.001, (HHINCDIS(R%, Unskilled) + HHINCDIS(R%, Skilled)))
                'mti 2018/05/22 End
                'bbh 2021/05/15 end


                'If RegName$(R%) = "Afghanistan" Then Stop
                scra(R%, Unskilled) = CRA(R%, Unskilled)
                scra(R%, Skilled) = CRA(R%, Skilled)
                CRaI(R%, Unskilled) = CRA(R%, Unskilled)
                CRaI(R%, Skilled) = CRA(R%, Skilled)
                CTotRaI(R%) = C(R%) / GDP(R%)
                CPCI(R%) = C(R%) / POP(R%)

                'If RegName$(R%) = "United States of America" Then Stop


                ' bbh 2019/03/09 start revised section
                '       First Year: Division of Consumption by Sector into Household Types
                '       ------------------------------------------------------
                For HHType% = 1 To 2
                    For S% = 1 To NSec%
                        CSHHU(R%, S%) = CS(R%, S%) * consumhh(R%, Unskilled) / C(R%)
                        CSHHS(R%, S%) = CS(R%, S%) * consumhh(R%, Skilled) / C(R%)
                        'bbh 2021/05/15 start replace HHINC with HHINCDIS
                        If S% = 1 Then
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, AG (2015 Model) Log",
                            'HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_AG_AS_PCT_C, HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            CsComp = AMAX(0.02, CsComp)
                        ElseIf S% = 2 Then
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, EN (2015 Model) Linear",
                            'HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_EN_AS_PCT_C, HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            CsComp = AMAX(0.03, CsComp)
                        ElseIf S% = 3 Then
                            ' CsComp = 0.00001 'bbh 2024/06/22 Replaced this with same logic and function as for energy, new code just below
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, EN (2015 Model) Linear",
                            'HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_EN_AS_PCT_C, HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            CsComp = AMAX(0.02, CsComp)
                        ElseIf S% = 4 Then
                            'jrs 2024/06/11 
                            'Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, MN (2015 Model) Linear",
                            '    HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_MN_AS_PCT_C, HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)

                            CsComp = AMAX(0.1, CsComp)
                        ElseIf S% = 5 Then
                            'jrs 2024/06/11 
                            'Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, SR (2015 Model) Log",
                            '    HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_SR_AS_PCT_C, HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)

                            CsComp = CSng(Amin(0.9, CsComp))
                        ElseIf S% = 6 Then
                            'jrs 2024/06/14 Call XYTABL("GDP/Capita (PPP 2011) Versus CS Share of C, IC (2015 Model) Log",
                            'HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            Call XYTABL(TblFuncNameCS_IC_AS_PCT_C, HHINCDIS(R%, HHType%) / HHPOP(R%, HHType%), CsComp, context)
                            CsComp = CSng(Amin(0.16, CsComp))
                            'bbh 2021/05/15 end
                        End If
                        'bbh 2020/04/09 start
                        If HHType% = 1 Then
                            'CSHHUShift(R%, S%) = CSHHU(R%, S%) / consumhh(R%, Unskilled) - CsComp
                            CSHHUShift(R%, S%) = CS(R%, S%) / C(R%) - CsComp
                            'At this point no basis for difference in CS/C by household type
                        Else
                            'CSHHSShift(R%, S%) = CSHHS(R%, S%) / consumhh(R%, Skilled) - CsComp
                            CSHHSShift(R%, S%) = CS(R%, S%) / C(R%) - CsComp
                        End If
                        'bbh 2020/04/09 end
                    Next S%
                Next HHType%
                ' bbh 2019/03/09 end revised section

                ' bbh 2019/03/09 begin deleted section
                ''       First Year: Linear Expenditure System by Household Type
                ''       -------------------------------------------------------
                '
                '         For HHType% = 1 To 2
                '             sfloorhh(R%, HHType%) = 0
                '             Sum = 0
                '             For S% = 1 To NSec%
                '                 If HHType% = 1 Then
                '                     BUDSHRHH(S%, HHType%) = CSHHU(R%, S%) / AMAX(0.001, consumhh(R%, Unskilled))
                '                 Else
                '                     BUDSHRHH(S%, HHType%) = CSHHS(R%, S%) / AMAX(0.001, consumhh(R%, Skilled))
                '                 End If
                '                 Sum = Sum + engel(S%) * BUDSHRHH(S%, HHType%)
                '             Next S%
                '             Sum = AMAX(0.001, Sum)
                '             For S% = 1 To NSec%
                '                 smarbdhh(R%, S%, HHType%) = engel(S%) * BUDSHRHH(S%, HHType%) / Sum
                '                 sminexhh(R%, S%, HHType%) = consumhh(R%, HHType%) * _
                '                     (BUDSHRHH(S%, HHType%) - 0.5 * smarbdhh(R%, S%, HHType%))
                '                 sfloorhh(R%, HHType%) = sfloorhh(R%, HHType%) + sminexhh(R%, S%, HHType%)
                '             Next S%
                '         Next HHType%
                ' bbh 2019/03/09 end deleted section

                '       Consumption by Age Categories
                '       -----------------------------
                'TotHHInc = AMAX(0.01, HHDispInc(R%, Unskilled) + HHDispInc(R%, Skilled))
                'AveConsum = C(R%) / TotHHInc
                'jrs 2013/04/12 *** begin ***
                '         Call XYTABL("Age Versus Differential Marginal Propensity to Consume", _
                '                 15, YouthCon)
                '         Call XYTABL("Age Versus Differential Marginal Propensity to Consume", _
                '                 45, WorkerCon)
                '         Call XYTABL("Age Versus Differential Marginal Propensity to Consume", _
                '                 65, PensionerCon)
                Call XYTABL("Age Versus Differential Marginal Propensity to Consume Old",
                 (0 + workageentry(R%)) / 2, youthcon, context) 'bbh 2022/10/17 changed all three function references to Old; is needed Absolute, not Differential
                Call XYTABL("Age Versus Differential Marginal Propensity to Consume Old",
                 (workageentry(R%) + workageretire(R%)) / 2, workercon, context)
                Call XYTABL("Age Versus Differential Marginal Propensity to Consume Old",
                 (workageretire(R%) + LIFEXP(R%, Total)) / 2, pensionercon, context)
                'jrs 2013/04/12 *** end ***
                'jrs 2013/05/27 using workageretiresv instead to independently find required savings
                'in case changing workageretire in mixed scenario
                'jrs 2013/05/03
CPCTND(R%) = 100  + AMAX(LIFEXP(R%, 3), 85) + CSng(workageretire(R%)) + CSng(workageentry(R%)) + CSng(savingsdiscountrt(R%)) @@CPCTND(R%) = 100 - SavingsAtWorkingAge(AMAX(LIFEXP(R%, 3), 85), CSng(workageretire(R%)), CSng(workageentry(R%)), CSng(savingsdiscountrt(R%)))@@

                TotHHIncPC = tothhinc / POP(R%)
                'jrs 2013/04/12 YouthPopShr = POPLE15(R%) / POP(R%)
                youthpopshr = POPPREWORK(R%) / POP(R%)
                'jrs 2013/04/12 WorkerPopShr = POP15TO65(R%) / POP(R%)
                workerpopshr = POPWORKING(R%) / POP(R%)
                'jrs 2013/04/15 PensionerPopShr = POPGT65(R%) / POP(R%)
                pensionerpopshr = POPRETIRED(R%) / POP(R%)
                youthconshr = youthpopshr * youthcon / 100
                workerconshr = workerpopshr * workercon / 100
                pensionerconshr = pensionerpopshr * pensionercon / 100
                computedcon = AMAX(0.0001, youthconshr + workerconshr + pensionerconshr)
                'bbh 2013/08/10 3 lines added for C...
                CPREWORK(R%) = youthconshr / computedcon * C(R%)
                CWORKING(R%) = workerconshr / computedcon * C(R%)
                CRETIRE(R%) = pensionerconshr / computedcon * C(R%)
                'ConProp(R%) = ComputedCon - AveConsum
                'SConProp(R%) = ConProp(R%)
                conpropi(R%) = computedcon 'bbh 2013/08/10
                penshrinci(R%) = GOVHHPENT(R%) / tothhinc 'bbh 2013/08/10
                NonPenShrIncPerCapI(R%) = (CRETIRE(R%) - GOVHHPENT(R%)) / POPRETIRED(R%) 'bbh 2013/08/10 Can be negative
                MulPension(R%) = 1

                'bbh 2013/08/11 moved this block from above and changed HHRETIRENEED calc
                'jrs 2013/06/11 *** begin ***
                'Retirement Finance
                '==================

                'First Year: Compute annual retirement expenditure need for entire society
                '--------------------------------------------------------------------------
                'HHRETIRENEED(R%) = POPRETIRED(R%) * C(R%) / POP(R%) * retireconsumrat
                HHRETIRENEED(R%) = CRETIRE(R%) * retireconsumrat 'Assume first year "fair share" is need; can adjust with parameter

                'First Year: Compute implied annual draw down of household savings stocks
                '------------------------------------------------------------------------
                HHSAVUSE(R%) = AMAX(HHRETIRENEED(R%) - GOVHHPENT(R%), 0)

                'First Year: Compute annual flow of savings per retiree
                '------------------------------------------------------
                If POPRETIRED(R%) > 0 Then
                    HHSAVUSEPC(R%) = HHSAVUSE(R%) / POPRETIRED(R%)
                Else
                    HHSAVUSEPC(R%) = 0
                End If
                HHSAVNEEDSTOCK(R%) = HHSAVUSE(R%) / (AMAX(0.01, savingsdiscountrt(R%) / 100))
                'If RegName$(R%) = "United States of America" Then Stop

                'First Year: Set accumulated savings to accumulated needs in absence of any other info about it
                '-----------------------------------------------------------------------------------------------
                HHSAVSTOCK(R%) = hhsaveneedrat(R%) * HHSAVNEEDSTOCK(R%)
                SHHSAVSTOCK(R%) = HHSAVSTOCK(R%)

                'First Year: Compute surplus or deficit of savings for retirement
                '----------------------------------------------------------------
                HHSAVSURSTOCK(R%) = HHSAVSTOCK(R%) - HHSAVNEEDSTOCK(R%)
                SHHSavSurStock(R%) = HHSAVSURSTOCK(R%)  'bbh 2020/06/13
                SavSHHSavSurStock(R%) = 0 'bbh 2020/06/13

                SCRETIRE(R%) = CRETIRE(R%) 'Save for adjustment of pension spending
                SHHRETIRENEED(R%) = HHRETIRENEED(R%)
                'jrs 2013/06/11 *** end ***
                'bbh 2013/08/11 end move

                'bbh 2013/08/11 end

                'If RegName$(R%) = "United States of America" Then Stop

                '   Note on consumption/savings trade-off.  Three effects have been represented:
                '       Differential rates by household types
                '       Different propensity by age categories
                '       Related to number 2, different propensity for pension income relative to other
                '           income, because pensions accrue to elderly.
                '       Analysis with the last two factors suggest relatively small impact on growth rates
                '       One missing factor in model is the impact that increased pension spending per capita
                '           would have on reduced savings by 15-65 year-olds who wouth then worry less about pensions

                'mti 2018/05/22 Start
ComputeHHTypeTot(R%)
' ---- Begin Inlined Level 1: ComputeHHTypeTot
' Private Sub ComputeHHTypeTot(R%)
            '- - - - - - - - - -  Economy  - - - - - - - - - - - - - - - - - - - - -
            'mti 2018/05/22 New proc
            HHDIVINT(R%%, NSkill%) = HHDIVINT(R%%, Skilled) + HHDIVINT(R%%, Unskilled)
            HHTAX(R%%, NSkill%) = HHTAX(R%%, Skilled) + HHTAX(R%%, Unskilled)
            HHGOVSS(R%%, NSkill%) = HHGOVSS(R%%, Skilled) + HHGOVSS(R%%, Unskilled)
            GOVHHTRNPEN(R%%, NSkill%) = GOVHHTRNPEN(R%%, Skilled) + GOVHHTRNPEN(R%%, Unskilled)
            GOVHHTRNWEL(R%%, NSkill%) = GOVHHTRNWEL(R%%, Skilled) + GOVHHTRNWEL(R%%, Unskilled)
            'bbh 2021/05/15 HHINC(R%%, NSkill%) = HHINC(R%%, Skilled) + HHINC(R%%, Unskilled)
            HHINCEARN(R%%, NSkill%) = HHINCEARN(R%%, Skilled) + HHINCEARN(R%%, Unskilled)
            HHINCDIS(R%%, NSkill%) = HHINCDIS(R%%, Skilled) + HHINCDIS(R%%, Unskilled)
            HHPOP(R%%, NSkill%) = HHPOP(R%%, Skilled) + HHPOP(R%%, Unskilled)

            'bbh 2021/05/15 HHINCPC(R%%, NSkill%) = HHINC(R%%, NSkill%) / AMAX(0.001, HHPOP(R%%, NSkill%))
            HHINCPC(R%%, NSkill%) = HHINCEARN(R%%, NSkill%) / AMAX(0.001, HHPOP(R%%, NSkill%))
            HHINCDISPC(R%%, NSkill%) = HHINCDIS(R%%, NSkill%) / AMAX(0.001, HHPOP(R%%, NSkill%))

            'bbh 2021/05/15 HHTAXR(R%%, NSkill%) = 100 * (HHTAX(R%%, NSkill%) / HHINC(R%%, NSkill%))
            HHTAXR(R%%, NSkill%) = 100 * (HHTAX(R%%, NSkill%) / HHINCEARN(R%%, NSkill%))
' End Sub
' ---- End Inlined Level 1: ComputeHHTypeTot
                'mti 2018/05/22 End
                Debug.WriteLine(R.ToString)
            Next R%

ifsECOSAMAllYears(context)
' ---- Begin Inlined Level 1: ifsECOSAMAllYears
' Public Sub ifsECOSAMAllYears(context As IForecastContext)
            'gvdb 2024/04/05
            ' unused variable
            'Dim rpaadj, firmsavadj, govbaladj As Single
            Dim hhfirmsavr As Single
            Dim Diff1, Diff2, Mul, HHSAVENEEDUSE As Single
            Dim HHFirmSavTarget As Single 'bbh 2020/07/01

            For R% = 1 To NR%


                '   All Steps:  Savings
                '   -------------------

                'If RegName$(R%) = "China" Then Stop
                'bbh 2020/07/01 start
                '        HHSAV(R%, Unskilled) = HHINC(R%, Unskilled) - _
                '            consumhh(R%, Unskilled) - HHTAX(R%, Unskilled) _
                '                - HHGOVSS(R%, Unskilled)
                '        'If XWORKREMIT(R%) > 0 Then HHSAV(R%, Unskilled) = HHSAV(R%, Unskilled) + XWORKREMIT(R%)
                '        HHSAV(R%, Skilled) = HHINC(R%, Skilled) - _
