' Private Sub AdjustXSecDyadicFix(iSector As Integer)
                Dim i As Integer, j As Integer
                Dim Factors(NR, NR, 3) As Single
    
                'Adjust Imports first
                '--------------------
                ReDim MTot(NR)
                For i = 1 To NR
                    For j = 1 To NR
                        MTot(j) = MTot(j) + XDYAD(i, j, i)
                        If XDYAD(i, j, i) < 0 Then
                            Stop
                        End If
                    Next j
                Next i
                For i = 1 To NR
                    For j = 1 To NR
                        'jrs 2025/10/17 changed from 0 to 0.001 to avoid dividing by tiny numbers that create Infinity
                        'Shift to match total M
                        If MTot(j) > 0.001 Then
                            Factors(i, j, 2) = MSAdj(j, i) * 1000000000 / MTot(j)
                        End If
                    Next j
                Next i
    
                'Adjust Exports second ' clp 2024/05/23 Switched order
                '--------------------
                ReDim XTOT(NR)
                For i = 1 To NR
                    For j = 1 To NR
                        XTOT(i) = XTOT(i) + XDYAD(i, j, i)
                    Next j
                Next i
                For i = 1 To NR
                    For j = 1 To NR
                        'jrs 2025/10/17 changed from 0 to 0.001 to avoid dividing by tiny numbers that create Infinity
                        'Shift to match total X
                        If XTOT(i) > 0.001 Then
                            Factors(i, j, 1) = XSAdj(i, i) * 1000000000 / XTOT(i)
                            Factors(i, j, 3) = (Factors(i, j, 1) + Factors(i, j, 2)) / 2
                        End If
                    Next j
                Next i
    
                Dim diff1 As Single, diff2 As Single, diff3 As Single, diffMax As Single, diffMin As Single
                'Apply the Average
                For i = 1 To NR
                    For j = 1 To NR
                        If i <> j Then
                            diff1 = XDYAD(i, j, i) * (Factors(i, j, 1) - 1)
                            diff2 = XDYAD(i, j, i) * (Factors(i, j, 2) - 1)
                            diff3 = XDYAD(i, j, i) * (Factors(i, j, 3) - 1)
                            If diff2 > diff1 Then
                                diffMax = diff2
                                diffMin = diff1
                            Else
                                diffMax = diff1
                                diffMin = diff2
                            End If
                            'Check if Origin Country i can keep sending more and Destination Country j can keep receiving
                            If XS(i, i) - XTOT(i) >= diffMax And
                                    MS(j, i) - MTot(j) >= diffMax Then
                                XDYAD(i, j, i) = CSng(XDYAD(i, j, i) + diffMax)
                                If XDYAD(i, j, i) < 0 Then
                                    Stop
                                End If
                                XTOT(i) = XTOT(i) + diffMax
                                MTot(j) = MTot(j) + diffMax
                                'Check if Origin Country i needs less and Destination Country j needs less, unless j is a big country
                            ElseIf XS(i, i) - XTOT(i) <= diffMin And
                                    MS(j, i) - MTot(j) <= diffMin Then
                                XDYAD(i, j, i) = CSng(XDYAD(i, j, i) + diffMin)
                                If XDYAD(i, j, i) < 0 Then
                                    Stop
                                End If
                                XTOT(i) = XTOT(i) + diffMin
                                MTot(j) = MTot(j) + diffMin
                            Else 'Use the average
                                XDYAD(i, j, i) = CSng(XDYAD(i, j, i) + diff3)
                                If XDYAD(i, j, i) < 0 Then
                                    Stop
                                End If
                                XTOT(i) = XTOT(i) + diff3
                                MTot(j) = MTot(j) + diff3
                            End If
                        End If
                    Next
                Next
' End Sub
    ' ---- End Inlined Level 2: AdjustXDyadic:AdjustXSecDyadicFix
