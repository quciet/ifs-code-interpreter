                ' If RegName(R%) = "South Africa" Then Stop

                'mti 2019/03/08 start
                Dim ShrUnskilledPop = AMAX(0, Amin(1, SHHPOP(R%, Unskilled) / AMAX(0.0001, SHHPOP(R%, Unskilled) + SHHPOP(R%, Skilled))))

                GovHHTrnWelUnskBase = GovHHWel * ShrUnskilledPop  ' ShrUnskilled
                'jrs 2026/04/30 added * govhhtrnwelm(R%, 3) to both lines so that the Total multiplier works
                GOVHHTRNWEL(R%, Unskilled) = GovHHWel * govhhtrnwelm(R%, Unskilled) * govhhtrnwelm(R%, 3) * ShrUnskilledPop _
            + XWBFLOWS(R%, 3) - GOVHHTRNWELI(R%, Unskilled)  ' ShrUnskilled
                GOVHHTRNWEL(R%, Skilled) = (GovHHWel - GovHHTrnWelUnskBase) * govhhtrnwelm(R%, Skilled) * govhhtrnwelm(R%, 3) _
            + XWBFLOWS(R%, 4) - GOVHHTRNWELI(R%, Skilled)
                'mti 2019/03/08 End


                'bbh 2013/08/03
                'bound transfers, especially when long life expectancy is pushing up
                'GOVHHPENT(R%) = Amin(GOVHHPENT(R%), 0.2 * GDP(R%))
                SumPen = GOVHHTRNPEN(R%, Unskilled) + GOVHHTRNPEN(R%, Skilled) 'bbh 2022/06/23 Replaced line above with if-then below to normalize by skill level
                If GOVHHPENT(R%) > 0.2 * GDP(R%) Then
                    GOVHHPENT(R%) = 0.2! * GDP(R%)
                    SumPen = GOVHHTRNPEN(R%, Unskilled) + GOVHHTRNPEN(R%, Skilled)
                    GOVHHTRNPEN(R%, Unskilled) = GOVHHTRNPEN(R%, Unskilled) * GOVHHPENT(R%) / SumPen
                    GOVHHTRNPEN(R%, Skilled) = GOVHHTRNPEN(R%, Skilled) * GOVHHPENT(R%) / SumPen
                End If

                SumWel = GOVHHTRNWEL(R%, Unskilled) + GOVHHTRNWEL(R%, Skilled)
                'mti 2018/07/23 Start
                'BBH suggested changing the limit to 30% to avoid Finland from being corrected
                'If SumWel > 0.2 * GDP(R%) Then
                'bbh 2019/07/20 start  Changed 0.3 limit to 0.37 because South African data values in SeriesGovExpense%GDP have grown
                If SumWel > 0.37 * GDP(R%) Then
