                            'jrs 2019/02/05 added CSng, it was producing a negative value when reaching the Min
                            BANDWIDTH(i, j) = (CSng(BANDWIDTH(i, j)) - BANDWIDTH_min) / (BANDWIDTH_max - BANDWIDTH_min)
                            If IY > 1 Then
                                BANDWIDTH(i, j) = BANDWIDTH(i, j) + BANDWIDTHShift(i, j) 'clp 2022/05/20 shift converted to additive 
                                BANDWIDTH(i, j) = Max(BANDWIDTH(i, j), 0) 'clp 2022/06/12 added minimum of zero
                            Else
                                DataYr1 = BANDWIDTHShift(i, j)
                                If BANDWIDTH(i, j) <> 0 Then
                                    BANDWIDTHShift(i, j) = DataYr1 - BANDWIDTH(i, j) 'clp 2022/05/20 shift converted to additive 
                                Else
                                    BANDWIDTHShift(i, j) = 0 'clp 2022/05/20 shift converted to additive 
                                End If
                                BANDWIDTH(i, j) = DataYr1
                            End If
                        End If
                    Next j
                Next i
                'Calculate Influence
                '--------------------
                For i = 1 To NR
                    For j = 1 To NR
                        If i <> j Then
                            INFLUENCE(i, j) = DEPENDENCE(i, j) * BANDWIDTH(i, j)
                        End If
                    Next j
                Next i
                'Normalize INFLUENCE
                '-------------------
                'jrs 2021/12/15 Dim INFLUENCE_total As Single , INFLUENCE_min As Single, INFLUENCE_max As Single
                'INFLUENCE_total = 0
                'INFLUENCE_min = -9999
                'INFLUENCE_max = -9999
                'For i = 1 To NR
                '    For j = 1 To NR
                '        INFLUENCE_total = INFLUENCE_total + INFLUENCE(i, j)
                '    Next j
                'Next i
                'jrs 2021/12/15 *** start ***
                'For i = 1 To NR
                '    For j = 1 To NR
                '        If i <> j Then
                '            INFLUENCE(i, j) = INFLUENCE(i, j) * lor_avg_total / INFLUENCE_total
                'If INFLUENCE_min = -9999 Then
                '    INFLUENCE_min = INFLUENCE(i, j)
                '    INFLUENCE_max = INFLUENCE(i, j)
                'Else
                '    If INFLUENCE(i, j) < INFLUENCE_min Then
                '        INFLUENCE_min = INFLUENCE(i, j)
                '    End If
                '    If INFLUENCE(i, j) > INFLUENCE_max Then
                '        INFLUENCE_max = INFLUENCE(i, j)
                '    End If
                'End If
    
                'If INFLUENCE_min < 0 Then Stop
                'End If
                '    Next j
                'Next i
                'jrs 2021/12/15 *** end ***
    
                'jrs 2021/12/15
                If IY = 1 Then
                    INFLUENCE_min = fbicinfmin 'clp 2022/03/16 assigned to parameter rather than zero
                    INFLUENCE_max = fbicinfmax 'clp 2022/03/16 assigned to parameter rather than one
                    'takes 7 seconds to find the above results FinMinMaxInfluence(INFLUENCE_min, INFLUENCE_max, context)
                End If
    
                'Final Normalization
                For i = 1 To NR
                    For j = 1 To NR
                        If i <> j Then
                            INFLUENCE(i, j) = (INFLUENCE(i, j) - INFLUENCE_min) / (INFLUENCE_max - INFLUENCE_min)
                            If IY > 1 Then
                                INFLUENCE(i, j) = INFLUENCE(i, j) + INFLUENCEShift(i, j) 'clp 2022/05/20 shift converted to additive 
                                INFLUENCE(i, j) = Max(INFLUENCE(i, j), 0) 'clp 2022/06/12 added minimum of zero
                            Else
                                DataYr1 = INFLUENCEShift(i, j)
                                If INFLUENCE(i, j) <> 0 Then
                                    INFLUENCEShift(i, j) = DataYr1 - INFLUENCE(i, j) 'clp 2022/05/20 shift converted to additive 
                                Else
                                    INFLUENCEShift(i, j) = 0 'clp 2022/05/20 shift converted to additive 
                                End If
                                INFLUENCE(i, j) = DataYr1
                            End If
                        End If
                    Next j
                Next i
    
                Using db = New IFsForDyadicContext()
                    'ttt 2019/09/01 Delete, then Add later
                    'jrs 2022/06/29 db.Enter()
                    Dim conn = db.Database.GetDbConnection
                    'jrs 2022/06/29
                    If conn.State = 0 Then 'closed
                        conn.Open()
                    End If
    
                    Using cmd = conn.CreateCommand()
                        'jrs 2022/06/29
                        cmd.CommandText = "PRAGMA foreign_keys = OFF;
                            PRAGMA ignore_check_constraints = ON;
                            PRAGMA journal_mode = MEMORY;
                            PRAGMA synchronous = OFF;"
                        cmd.ExecuteNonQuery()
    
                        Dim tbls = New String() {"DYADDEPENDENCE", "DYADBANDWIDTH", "DYADINFLUENCE",
                            "DYADINF_AID_PCTGDP", "DYADINF_AID_PCTTOTALAID", "DYADINF_ARMS_PCTGDSMIL",
