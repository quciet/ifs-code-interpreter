                'ldrtvlest = CSng(1.660993 + (-0.0000000000000544 * GDP(R%) * 1000000000) + (-0.00000293 * GDPPCP(R%) * 1000) + (0.5199978 * DEMOCPOLYARCHY(R%)) +
                '        (0.0009503 * (X(R%) / GDP(R%) * 100)) + (beckleyshr * 0.0177485) + (conflictind * 0.1292389) + (0.001464 * DIPLOIGO(R%) / 7) +
                '        (0.00629 * XS(R%, 2) / X(R%) * 100) + (-0.0018747 * allycount) + (0.0000329 * XARMS(R%) * 1000))

                ldrtvlest = CSng((0.0639355 * beckleyshr) + (-1.320654 * DEMOCPOLYARCHY(R%)) + (-0.0011699 * (X(R%) / GDP(R%) * 100)) + (0.0475679 * DIPLOIGO(R%) / 7) + (AvgDistanceAtoB(R%) * -0.000000727) - 0.3788661)

                ldrtvlest = CSng((0.2692479 * beckleyshr) + (-0.1775876 * DEMOCPOLYARCHY(R%)) + (-0.0027898 * (X(R%) / GDP(R%) * 100)) + (0.1010465 * DIPLOIGO(R%) / 7) + (AvgDistanceAtoB(R%) * -0.0004044) + 3.896546)

                ldrtvlest = CSng((0.1746358 * DEMOCPOLYARCHY(R%)) + (-0.0042733 * (X(R%) / GDP(R%) * 100)) + (0.1133453 * DIPLOIGO(R%) / 7) + (AvgDistanceAtoB(R%) * -0.0003711) + 3.048309)

                ldrtvlest = CSng((1.676865 * beckleyshr) + (-6.738254 * DEMOCPOLYARCHY(R%)) + (-0.0065327 * (X(R%) / GDP(R%) * 100)) + (0.2573842 * DIPLOIGO(R%) / 7) + (AvgDistanceAtoB(R%) * -0.0001699) - 3.74905)

                'If LDRTRIP(R%) <> 0 Then
                'ldrdatalog = CSng(Log(LDRTRIP(R%)))

                'ldrtvlest = CSng(Exp(ldrtvlest))
                'If R% = 87 Then Stop
                'If R% = 179 Or R% = 180 Or R% = 34 Or R% = 62 Or R% = 58 Or R% = 139 Or R% = 122 Or R% = 154 Or R% = 87 Or R% = 171 Then Stop ' if UK, USA, CHina, Germany, France, Russia (139), Nigaruaga (122), South Africa (154), or Tonga (171), or Kiribati (87)
                'If GRPS(1, R%) = "Japan" Then Stop

                ldrtrvlshift(R%) = LDRTRIP(R%) - ldrtvlest
                'If R = 58 Then Stop

                'Else
                'ldrtrvlshift(R%) = -4.6
                'End If
                'If R% = 58 Then Stop
