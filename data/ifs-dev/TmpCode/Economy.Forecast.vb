            Dim SumWorkRemit As Single, SumGlobal As Single, WorkRemitComp As Single
            SumWorkRemit = 0
            SumGlobal = 0
            For R% = 1 To NR%
                SumWorkRemit = SumWorkRemit + Math.Abs(XWORKREMIT(R%))
                SumGlobal = SumGlobal + INFRATELE(R%) * POP(R%)
            Next R%
            WorkBenchI = SumWorkRemit / WGDP
            InfraTeleBenchI = (SumGlobal / WPOP) / 100
            For R% = 1 To NR%
                WorkRemitComp = (Math.Abs(XWORKREMIT(R%)) / GDP(R%)) / WorkBenchI
                WorkRemitComp = Amin(2, WorkRemitComp)
                PERSCON(R%) = (INFRATELE(R%) / InfraTeleBenchI + WorkRemitComp * 100) / 2
                INFRANET(R%) = NUMNWP(R%) / AMAX(0.001, POP(R%)) * 100
            Next R%
Call ScaleMe(PERSCON)
' ---- Begin Inlined Level 1: ScaleMe
' Public Sub ScaleMe(ByRef inputMatrix() As Single)
            Dim MaxVal As Single, MinVal As Single, ICount As Integer 'jrs 2014/09/16
            MaxVal = PERSCON(1)
            MinVal = PERSCON(1)
            For ICount% = 2 To NR%
                If PERSCON(ICount%) > MaxVal Then
                    MaxVal = PERSCON(ICount%)
                End If
                If PERSCON(ICount%) < MinVal Then
                    MinVal = PERSCON(ICount%)
                End If
            Next ICount%
            For ICount% = 1 To NR%
                PERSCON(ICount%) = (PERSCON(ICount%) - MinVal) /
            AMAX(0.001, (MaxVal - MinVal)) * 100
            Next ICount%
' End Sub
