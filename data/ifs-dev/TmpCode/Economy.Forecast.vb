' Private Sub PovertyShortfall(PovCountVec(,,) As Single, PovShortVec(,,) As Single, PovShortSexDiffVec(,) As Single, PovNationalHCVec() As Single, Povline As Single, PovGapVal() As Single)
    
                '---------------------------------------------------------------------
