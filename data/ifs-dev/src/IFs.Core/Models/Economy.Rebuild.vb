                                Next SCount%

                                'mti September 2017 start
                                g_pcap = GDPSum(MCount%) / AMAX(0.0001F, POPSum(MCount%))


                                IFsCoefUnskilled(LCount%, MCount%) =
                                IFsCoefUnskilled(LCount%, MCount%) / AMAX(1, IFsIOCount(MCount%)) / AMAX(0.001F, g_pcap)
                                IFsCoefSkilled(LCount%, MCount%) =
                                IFsCoefSkilled(LCount%, MCount%) / AMAX(1, IFsIOCount(MCount%)) / AMAX(0.001F, g_pcap)

                                'Original BBH
                                '            IFsCoefUnskilled(LCount%, MCount%) = _
                                '                IFsCoefUnskilled(LCount%, MCount%) / AMAX(1, IFsIOCount(MCount%))
                                '            IFsCoefSkilled(LCount%, MCount%) = _
                                '                IFsCoefSkilled(LCount%, MCount%) / AMAX(1, IFsIOCount(MCount%))

                                'mti September 2017 End




                            Next LCount%
                        Next MCount%

                        '   Save generic IO matrices and labor vectors
                        '   ------------------------------------------
                        If cntx.HistoricMode Then
                            db2.Clear(GetType(IOMatricesCalcHist))
                            SaveGenIOMatValsToIFsDb(cntx, db2.IOMatricesCalcHist, IFsIOMatrices, IOThresholds)
                            db2.Clear(GetType(IOLaborCoefsHist))
                            SaveGenIOLabValsToIFsDb(cntx, db2.IOLaborCoefsHist, IFsCoefUnskilled, IOThresholds, "Unskilled")
                            SaveGenIOLabValsToIFsDb(cntx, db2.IOLaborCoefsHist, IFsCoefSkilled, IOThresholds, "Skilled")
                        Else
                            db2.Clear(GetType(IOMatricesCalc))
                            SaveGenIOMatValsToIFsDb(cntx, db2.IOMatricesCalc, IFsIOMatrices, IOThresholds)
                            db2.Clear(GetType(IOLaborCoefs))
                            SaveGenIOLabValsToIFsDb(cntx, db2.IOLaborCoefs, IFsCoefUnskilled, IOThresholds, "Unskilled")
                            SaveGenIOLabValsToIFsDb(cntx, db2.IOLaborCoefs, IFsCoefSkilled, IOThresholds, "Skilled")
                        End If
                        db2.Flush()
                    End Using
                End Using

            End Sub

            'jrs 2025/08/19
            'If SumRow from the IO Matrix is too big to cover the trade deficit, reduce the Matrix, leaving 1%
            Private Sub checkGTAPCoversTradeDefficit(ByRef GTAPVADD() As Single?, ByRef IFsMatrix(,) As Single?, sCountry As String, cntx As IRebuildFacade)
                Dim CImps, CExps As Single?
                'Check every sector(row)
                For S% = 1 To cntx.NSec
                    Select Case S%
                        Case Agri
                            CImps = MAG(sCountry)
                            CExps = XAG(sCountry)
                        Case Ener
                            CImps = MEN(sCountry)
                            CExps = XEN(sCountry)
                        Case Mate
                            'If sCountry = "China" Then Stop
                            CImps = MMA(sCountry)
                            CExps = XMA(sCountry)
                        Case Manu
                            CImps = MMN(sCountry)
                            CExps = XMN(sCountry)
                        Case Serv
                            CImps = MSR(sCountry)
                            CExps = XSR(sCountry)
                        Case ICT
                            CImps = MIC(sCountry)
                            CExps = XIC(sCountry)
                    End Select

                    'This is only necessary when there is a trade deficit
                    If CImps > CExps Then
                        Dim RowSum As Single? = 0
                        For cc = 1 To cntx.NSec
                            RowSum = RowSum + IFsMatrix(S%, cc)
                        Next
                        Dim ColSum As Single? = 0
                        For rr = 1 To cntx.NSec
                            ColSum = ColSum + IFsMatrix(rr, S%)
                        Next
                        'This is ZS (Gross Production)
                        ColSum = ColSum + GTAPVADD(S%)
                        Dim PFD As Single? = ColSum - RowSum
                        'PFD can be negative when there's a trade deficit
                        If PFD < 0 Then
                            'But since we can't adjust trade we need room to adjust the rest, 1% of VADD
                            If -1 * PFD / GTAPVADD(S%) + 0.05 > (CImps - CExps) / ValAdd(sCountry)(S%) Then
                                Dim AdjFactor As Double?
                                AdjFactor = ((CImps - CExps) / ValAdd(sCountry)(S%)) / (-1 * PFD / GTAPVADD(S%) + 0.05)
                                For cc = 1 To cntx.NSec
                                    IFsMatrix(S%, cc) = CSng(IFsMatrix(S%, cc) * AdjFactor)
                                Next
                                RowSum = CSng(RowSum * AdjFactor)
                                ColSum = 0
                                For rr = 1 To cntx.NSec
                                    ColSum = ColSum + IFsMatrix(rr, S%)
                                Next
                                'This is ZS (Gross Production)
                                ColSum = ColSum + GTAPVADD(S%)
                                PFD = ColSum - RowSum
                                If -1 * PFD / GTAPVADD(S%) + 0.05 > (CImps - CExps) / ValAdd(sCountry)(S%) Then
                                    'It didn't work
                                    Stop
                                End If
                            End If
                        End If
                    End If
                Next
            End Sub

            'jrs 2025/04/16
            'Trying to match VADD from GTAP to Data from WDI
            Private Sub MatchGTAPVADDtoWDIVADD(ByRef GTAPVADD() As Single?, sCountry As String, cntx As IRebuildFacade)
                Dim GTAPTot As Single? = 0
                Dim GTAPTotNonData As Single? = 0
                Dim GTAPVADDNegativeCount As Integer = 0
                Dim GTAPVADDNonDataNegSUM As Single?
                Dim GTAPVADDOrg(10) As Single?
                'Loop throu each sector to compute GTAP Total
                For S% = 1 To cntx.NSec
                    GTAPTot = GTAPTot + GTAPVADD(S%)
                    GTAPVADDOrg(S%) = GTAPVADD(S%)
                    If Not bVaddData(sCountry)(S%) Then
                        GTAPTotNonData = GTAPTotNonData + GTAPVADD(S%)
                    End If
                Next
                Dim PctWDI As Single, PctGTAP As Single, PctGap As Single
                'Loop throu each sector to adjust
                For S% = 1 To cntx.NSec
                    'if it has WDI data adjust GTAP
                    If bVaddData(sCountry)(S%) Then
                        'At this point VADD is in Billion Dollars
                        PctWDI = CSng(ValAdd(sCountry)(S%) / CGDP(sCountry))
                        PctGTAP = CSng(GTAPVADD(S%) / GTAPTot)
                        PctGap = PctWDI - PctGTAP
                        GTAPVADDNegativeCount = 0
                        GTAPVADDNonDataNegSUM = 0
                        If PctGap <> 0 Then
                            'Apply the Gap to Sector to correct
                            GTAPVADD(S%) = GTAPVADD(S%) + PctGap * GTAPTot
                            'Then apply comensation to all non-data sectors
                            For S2% = 1 To cntx.NSec
                                If Not bVaddData(sCountry)(S2%) Then
                                    GTAPVADD(S2%) = GTAPVADD(S2%) - PctGap * GTAPTot * GTAPVADD(S2%) / GTAPTotNonData
                                    If GTAPVADD(S2%) < 0 Then
                                        GTAPVADDNegativeCount = GTAPVADDNegativeCount + 1
                                        GTAPVADDNonDataNegSUM = GTAPVADDNonDataNegSUM + GTAPVADD(S2%)
                                    End If
                                End If
                            Next
                            'Adjusting new non data total
                            GTAPTotNonData = GTAPTotNonData - PctGap * GTAPTot
                            'Fix Negatives if necessary
                            If GTAPVADDNegativeCount > 0 Then
                                For S2% = 1 To cntx.NSec
                                    If Not bVaddData(sCountry)(S2%) Then
                                        'if there's room, adjust positives to compensate
                                        If GTAPVADDNegativeCount * 0.01 * GTAPTot - GTAPVADDNonDataNegSUM < GTAPTotNonData + GTAPVADDNonDataNegSUM Then
                                            'if positive add any remaining negative fixes
                                            If GTAPVADD(S2%) > 0 Then
                                                GTAPVADD(S2%) = CSng(GTAPVADD(S2%) - (GTAPVADDNegativeCount * 0.01 * GTAPTot - GTAPVADDNonDataNegSUM) * GTAPVADD(S2%) / (GTAPTotNonData + GTAPVADDNonDataNegSUM))
                                            Else
                                                GTAPVADD(S2%) = CSng(0.01 * GTAPTot)
                                            End If
                                        Else 'if no room, go back to originals
                                            If GTAPVADD(S2%) <= 0 Then
                                                GTAPVADD(S2%) = GTAPVADDOrg(S%)
                                            End If
                                        End If
                                    End If
                                Next
                            End If
                        End If
                    End If
                Next
            End Sub

