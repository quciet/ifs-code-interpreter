                            If ExportsTbl.ContainsKey(sActor + ";" + sPartner) Then
                                CDYADPOPFOREIGN(sActor).Add(sPartner, getYearOrEarliestWithinRange(ExportsTbl, yrs, sActor + ";" + sPartner, cntx.FirstYear, 20))
