                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If
                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If
                            ElseIf CDYADMIGRANTFORCEDRETURNYRS.ContainsKey(keyi) Then
                                If CDYADMIGRANTFORCEDRETURNYRS(keyi).ContainsKey(keyj) Then
                                    If CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k).HasValue Then
                                        If Not CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If
                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If
                            End If
                        Next k
                    Next keyj

                    AbelGrossIn.Add(keyi, 0)
                    AbelGrossOut.Add(keyi, 0)
                    Shares.Add(keyi, New Dictionary(Of String, Single?))
                    Shares(keyi).Add("Total", 0)
                    Dim VarVals(YrsCount) As Single
                    AbelGrossInYrs.Add(keyi, VarVals)
                    Dim VarVals2(YrsCount) As Single
                    AbelGrossOutYrs.Add(keyi, VarVals2)
                    SharesYrs.Add(keyi, New Dictionary(Of String, Single?()))
                    Dim VarVals3(YrsCount) As Single?
                    SharesYrs(keyi).Add("Total", VarVals3)
                Next keyi
                Shares.Add("Total", New Dictionary(Of String, Single?))
                SharesYrs.Add("Total", New Dictionary(Of String, Single?()))

                For Each keyi In cntx.Regionalization.Keys
                    For Each keyj In cntx.Regionalization.Keys
                        If CXDYADMIGRANT.ContainsKey(keyi) Then
                            If CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                'jrs 2018/04/02 added if not isnull
                                If CXDYADMIGRANT(keyi)(keyj).HasValue Then
                                    AbelGrossIn(keyj) = AbelGrossIn(keyj) + CXDYADMIGRANT(keyi)(keyj)
                                    AbelGrossOut(keyi) = AbelGrossOut(keyi) + CXDYADMIGRANT(keyi)(keyj)
                                    'If key = 70 Then
                                    '    Debug.Print j & ", " & AbelGrossOut(key) / 5
                                    'End If
                                    Shares(keyi).Add(keyj, CXDYADMIGRANT(keyi)(keyj))
                                    Dim VarVals(YrsCount) As Single?
                                    SharesYrs(keyi).Add(keyj, VarVals)
                                    If Not Shares("Total").ContainsKey(keyj) Then
                                        Shares("Total").Add(keyj, 0)
                                    End If
                                    If Not SharesYrs("Total").ContainsKey(keyj) Then
                                        Dim VarVals2(YrsCount) As Single?
                                        SharesYrs("Total").Add(keyj, VarVals2)
                                    End If
                                    Shares("Total")(keyj) = Shares("Total")(keyj) + CXDYADMIGRANT(keyi)(keyj)
                                    Shares(keyi)("Total") = Shares(keyi)("Total") + CXDYADMIGRANT(keyi)(keyj)
                                End If
                            End If
                        End If

                        If CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                            If CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                'jrs 2018/03/19
                                For k = 1 To YrsCount - 1
                                    If CXDYADMIGRANTYRS(keyi)(keyj)(k).HasValue Then
                                        AbelGrossInYrs(keyj)(k) = AbelGrossInYrs(keyj)(k) + CSng(CXDYADMIGRANTYRS(keyi)(keyj)(k))
                                        AbelGrossOutYrs(keyi)(k) = AbelGrossOutYrs(keyi)(k) + CSng(CXDYADMIGRANTYRS(keyi)(keyj)(k))
                                        'jrs 2024/12/19
                                        If Not SharesYrs(keyi).ContainsKey(keyj) Then
                                            Dim VarVals(YrsCount) As Single?
                                            SharesYrs(keyi).Add(keyj, VarVals)
                                        End If
                                        SharesYrs(keyi)(keyj)(k) = CXDYADMIGRANTYRS(keyi)(keyj)(k)
                                        'jrs 2024/12/19
                                        If Not SharesYrs("Total").ContainsKey(keyj) Then
                                            Dim VarVals2(YrsCount) As Single?
                                            SharesYrs("Total").Add(keyj, VarVals2)
                                        End If

                                        SharesYrs("Total")(keyj)(k) = SharesYrs("Total")(keyj)(k) + CXDYADMIGRANTYRS(keyi)(keyj)(k)
                                        SharesYrs(keyi)("Total")(k) = SharesYrs(keyi)("Total")(k) + CXDYADMIGRANTYRS(keyi)(keyj)(k)
                                    End If
                                Next k
                            End If
                        End If
                    Next keyj
                Next keyi

                Dim AbelNet As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim AbelNetYrs As Dictionary(Of String, Single?()) = New Dictionary(Of String, Single?())

                For Each key In cntx.Regionalization.Keys
                    AbelNet.Add(key, AbelGrossIn(key) - AbelGrossOut(key))
                    Dim VarVals(YrsCount) As Single?
                    AbelNetYrs.Add(key, VarVals)
                    'jrs 2018/03/19
                    For k = 1 To YrsCount - 1
                        AbelNetYrs(key)(k) = AbelGrossInYrs(key)(k) - AbelGrossOutYrs(key)(k)
                    Next k
                Next

                yrs = cntx.GetYears(cntx.MigrantsTbl).OrderBy(Function(y) y).ToArray()
                migTbl = cntx.GetDice(cntx.MigrantsTbl, yrs)
                YrIdx = getYearIdx(yrs, sYr)

                Dim Total As Single?

                For Each key In cntx.Regionalization.Keys
                    'If key = "Brazil" Then Stop
                    If migTbl(key)(YrIdx).HasValue Then
                        Total = AbelGrossIn(key) + AbelGrossOut(key)
                        If AbelNet(key) < migTbl(key)(YrIdx) * 1000000 Then
                            'jrs 2024/10/17 If Total > 0 Then
                            If Total > 0 AndAlso AbelGrossOut(key) - (migTbl(key)(YrIdx) * 1000000 - AbelNet(key)) * AbelGrossOut(key) / Total > 0 Then
                                AbelGrossIn(key) = AbelGrossIn(key) + (migTbl(key)(YrIdx) * 1000000 - AbelNet(key)) * AbelGrossIn(key) / Total
                                AbelGrossOut(key) = AbelGrossOut(key) - (migTbl(key)(YrIdx) * 1000000 - AbelNet(key)) * AbelGrossOut(key) / Total
                            Else
                                AbelGrossIn(key) = AbelGrossIn(key) + (migTbl(key)(YrIdx) * 1000000 - AbelNet(key))
                            End If
                        ElseIf AbelNet(key) > migTbl(key)(YrIdx) * 1000000 Then
                            'jrs 2024/10/17 If Total > 0 Then
                            If Total > 0 AndAlso AbelGrossIn(key) - (AbelNet(key) - migTbl(key)(YrIdx) * 1000000) * AbelGrossIn(key) / Total > 0 Then
                                AbelGrossOut(key) = AbelGrossOut(key) + (AbelNet(key) - migTbl(key)(YrIdx) * 1000000) * AbelGrossOut(key) / Total
                                AbelGrossIn(key) = AbelGrossIn(key) - (AbelNet(key) - migTbl(key)(YrIdx) * 1000000) * AbelGrossIn(key) / Total
                            Else
                                AbelGrossOut(key) = AbelGrossOut(key) + AbelNet(key) - migTbl(key)(YrIdx) * 1000000
                            End If
                        End If
                    End If

                    'jrs 2018/03/19
                    For k = 1 To YrsCount - 1
                        If migTbl(key)(YrIdx - YrsCount + k).HasValue Then
                            Total = AbelGrossInYrs(key)(k) + AbelGrossOutYrs(key)(k)
                            If AbelNetYrs(key)(k) < migTbl(key)(YrIdx - YrsCount + k) * 1000000 Then
                                If Total > 0 Then
                                    AbelGrossInYrs(key)(k) = AbelGrossInYrs(key)(k) + CSng((migTbl(key)(YrIdx - YrsCount + k) * 1000000 - AbelNetYrs(key)(k)) * AbelGrossInYrs(key)(k) / Total)
                                    AbelGrossOutYrs(key)(k) = AbelGrossOutYrs(key)(k) - CSng((migTbl(key)(YrIdx - YrsCount + k) * 1000000 - AbelNetYrs(key)(k)) * AbelGrossOutYrs(key)(k) / Total)
                                Else
                                    AbelGrossInYrs(key)(k) = AbelGrossInYrs(key)(k) + CSng((migTbl(key)(YrIdx - YrsCount + k) * 1000000 - AbelNetYrs(key)(k)))
                                End If
                            ElseIf AbelNetYrs(key)(k) > migTbl(key)(YrIdx - YrsCount + k) * 1000000 Then
                                If Total > 0 Then
                                    AbelGrossOutYrs(key)(k) = AbelGrossOutYrs(key)(k) + CSng((AbelNetYrs(key)(k) - migTbl(key)(YrIdx - YrsCount + k) * 1000000) * AbelGrossOutYrs(key)(k) / Total)
                                    AbelGrossInYrs(key)(k) = AbelGrossInYrs(key)(k) - CSng((AbelNetYrs(key)(k) - migTbl(key)(YrIdx - YrsCount + k) * 1000000) * AbelGrossInYrs(key)(k) / Total)
                                Else
                                    AbelGrossOutYrs(key)(k) = AbelGrossOutYrs(key)(k) + CSng(AbelNetYrs(key)(k) - migTbl(key)(YrIdx - YrsCount + k) * 1000000)
                                End If
                            End If
                        End If
                    Next k
                Next key

                'Replace net value with recomputed In - Out
                For Each key In cntx.Regionalization.Keys
                    AbelNet(key) = AbelGrossIn(key) - AbelGrossOut(key)
                    'jrs 2018/03/19
                    For k = 1 To YrsCount - 1
                        AbelNetYrs(key)(k) = AbelGrossInYrs(key)(k) - AbelGrossOutYrs(key)(k)
                    Next k
                Next

                'Advance years
                'If initialization uses sYr = 2015, and base year is already 2017, need to advance
                'gvdb 2024/04/05
                ' unused variable
                'Dim T As Integer,
                Dim newAbelGrossIn As Single?
                'jrs 2021/07/27
                Dim newAbelGrossOut As Single?

                For Each key In cntx.Regionalization.Keys
                    'jrs 2021/07/27
                    'For T = 1 To cntx.BaseYear - sYr
                    '    If migTbl(key)(YrIdx + T).HasValue Then
                    '        newAbelGrossIn = AbelGrossIn(key)
                    '        If migTbl(key)(YrIdx + T - 1).HasValue Then
                    '            newAbelGrossIn = newAbelGrossIn - migTbl(key)(YrIdx + T - 1) * 1000000
                    '        End If
                    '        If AbelGrossIn(key) + AbelGrossOut(key) > 0 Then
                    '            newAbelGrossIn = newAbelGrossIn - migTbl(key)(YrIdx + T) * 1000000 * AbelGrossIn(key) / (AbelGrossIn(key) + AbelGrossOut(key))
                    '        End If
                    '        AbelGrossIn(key) = newAbelGrossIn
                    '        AbelGrossOut(key) = AbelGrossIn(key) - migTbl(key)(YrIdx + T) * 1000000
                    '    End If
                    'Next T
                    If cntx.BaseYear > CInt(sYr) Then
                        If migTbl(key)(YrIdx + cntx.BaseYear - CInt(sYr)).HasValue And migTbl(key)(YrIdx).HasValue Then
                            'More Inmigrants
                            If migTbl(key)(YrIdx + cntx.BaseYear - CInt(sYr)) > migTbl(key)(YrIdx) Then
                                newAbelGrossIn = migTbl(key)(YrIdx + cntx.BaseYear - CInt(sYr)) - migTbl(key)(YrIdx)
                                newAbelGrossIn = newAbelGrossIn * 1000000
                                'jrs 2021/08/06 if emmigrants are more better to reduce
                                If AbelGrossOut(key) > AbelGrossIn(key) And AbelGrossOut(key) > newAbelGrossIn Then
                                    AbelGrossOut(key) = AbelGrossOut(key) - newAbelGrossIn
                                Else
                                    AbelGrossIn(key) = AbelGrossIn(key) + newAbelGrossIn
                                End If
                            Else 'More Emmigrants
                                newAbelGrossOut = migTbl(key)(YrIdx) - migTbl(key)(YrIdx + cntx.BaseYear - CInt(sYr))
                                newAbelGrossOut = newAbelGrossOut * 1000000
                                'jrs 2021/08/06 if immigrants are more better to reduce
                                If AbelGrossIn(key) > AbelGrossOut(key) And AbelGrossIn(key) > newAbelGrossOut Then
                                    AbelGrossIn(key) = AbelGrossIn(key) - newAbelGrossOut
                                Else
                                    AbelGrossOut(key) = AbelGrossOut(key) + newAbelGrossOut 'jrs 2021/08/03 I was using GrossIn incorrectly
                                End If
                            End If
                        End If
                    End If

                Next

                'update final flow matrix
                For Each keyi In cntx.Regionalization.Keys
                    For Each keyj In cntx.Regionalization.Keys
                        If Shares("Total").ContainsKey(keyj) Then
                            If Shares("Total")(keyj) > 0 Then
                                If Shares(keyi).ContainsKey(keyj) Then
                                    If Not CXDYADMIGRANT.ContainsKey(keyi) Then
                                        CXDYADMIGRANT.Add(keyi, New Dictionary(Of String, Single?))
                                    End If
                                    If Not CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                        CXDYADMIGRANT(keyi).Add(keyj, 0)
                                    End If
                                    CXDYADMIGRANT(keyi)(keyj) = AbelGrossIn(keyj) * Shares(keyi)(keyj) / Shares("Total")(keyj)
                                End If
                            End If
                        ElseIf Shares(keyi).ContainsKey(keyj) Then
                            If Shares(keyi)("Total") > 0 Then
                                CXDYADMIGRANT(keyi)(keyj) = AbelGrossOut(keyi) * Shares(keyi)(keyj) / Shares(keyi)("Total")
                            Else
                                CXDYADMIGRANT(keyi)(keyj) = Shares(keyi)(keyj)
                            End If
                        End If

                        If CXDYADMIGRANT.ContainsKey(keyi) Then
                            If CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                If Not CMDYADMIGRANT.ContainsKey(keyj) Then
                                    CMDYADMIGRANT.Add(keyj, New Dictionary(Of String, Single?))
                                End If
                                If Not CMDYADMIGRANT(keyj).ContainsKey(keyi) Then
                                    CMDYADMIGRANT(keyj).Add(keyi, 0)
                                End If
                                CMDYADMIGRANT(keyj)(keyi) = CXDYADMIGRANT(keyi)(keyj)
                            End If
                        End If

                        'jrs 2018/03/19
                        For k = 1 To YrsCount - 1
                            If Shares("Total").ContainsKey(keyj) Then
                                If SharesYrs("Total")(keyj)(k) > 0 Then
                                    CXDYADMIGRANTYRS(keyi)(keyj)(k) = AbelGrossInYrs(keyj)(k) * SharesYrs(keyi)(keyj)(k) / SharesYrs("Total")(keyj)(k)
                                End If
                            ElseIf SharesYrs(keyi).ContainsKey(keyj) Then
                                If SharesYrs(keyi)("Total")(k) > 0 Then
                                    CXDYADMIGRANTYRS(keyi)(keyj)(k) = AbelGrossOutYrs(keyi)(k) * SharesYrs(keyi)(keyj)(k) / SharesYrs(keyi)("Total")(k)
                                Else
                                    CXDYADMIGRANTYRS(keyi)(keyj)(k) = SharesYrs(keyi)(keyj)(k)
                                End If
                            End If
                        Next k
                    Next
                Next

                'Forced population (Refugees)
                '----------------------------
                yrs = cntx.GetYearsDyad("SeriesMigrationForcedStock").OrderBy(Function(y) y).ToArray()
                migTbl = cntx.GetDiceDyad("SeriesMigrationForcedStock", yrs)
                YrIdx = CShort(yrs.Count - 1)
                'sYr = yrs(YrIdx) 'dsb 2025/10/27
                Dim sYrForcedStock As Short
                sYrForcedStock = yrs(YrIdx)

                CDYADPOPFOREIGNFORCED = New Dictionary(Of String, Dictionary(Of String, Single?))

                For Each item In migTbl
                    sActor = item.Key.Split(";".ToCharArray)(0)
                    If Not CDYADPOPFOREIGNFORCED.ContainsKey(sActor) Then
                        CDYADPOPFOREIGNFORCED.Add(sActor, New Dictionary(Of String, Single?))
                    End If
                    sPartner = item.Key.Split(";".ToCharArray)(1)
                    CDYADPOPFOREIGNFORCED(sActor).Add(sPartner, migTbl(item.Key)(YrIdx))
                Next

                'jrs 2018/02/28
                'Check that there's enough room in Total vs Forced and Return
                '------------------------------------------------------------
                For Each keyi In cntx.Regionalization.Keys
                    For Each keyj In cntx.Regionalization.Keys
                        If CDYADMIGRANTFORCED.ContainsKey(keyi) And CDYADMIGRANTFORCEDRETURN.ContainsKey(keyi) Then
                            If CDYADMIGRANTFORCED(keyi).ContainsKey(keyj) And CDYADMIGRANTFORCEDRETURN(keyi).ContainsKey(keyj) Then
                                If CDYADMIGRANTFORCED(keyi)(keyj).HasValue And CDYADMIGRANTFORCEDRETURN(keyi)(keyj).HasValue Then
                                    If Not CXDYADMIGRANT.ContainsKey(keyi) Then
                                        CXDYADMIGRANT.Add(keyi, New Dictionary(Of String, Single?))
                                    End If
                                    If Not CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                        CXDYADMIGRANT(keyi).Add(keyj, 0)
                                    End If

                                    If CXDYADMIGRANT(keyi)(keyj) < CDYADMIGRANTFORCED(keyi)(keyj) + CDYADMIGRANTFORCEDRETURN(keyi)(keyj) Then
                                        CXDYADMIGRANT(keyi)(keyj) = CDYADMIGRANTFORCED(keyi)(keyj) + CDYADMIGRANTFORCEDRETURN(keyi)(keyj)
                                    End If
                                End If
                            ElseIf CDYADMIGRANTFORCED(keyi).ContainsKey(keyj) Then
                                If Not CXDYADMIGRANT.ContainsKey(keyi) Then
                                    CXDYADMIGRANT.Add(keyi, New Dictionary(Of String, Single?))
                                End If
                                If Not CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                    CXDYADMIGRANT(keyi).Add(keyj, 0)
                                End If

                                If CXDYADMIGRANT(keyi)(keyj) < CDYADMIGRANTFORCED(keyi)(keyj) Then
                                    CXDYADMIGRANT(keyi)(keyj) = CDYADMIGRANTFORCED(keyi)(keyj)
                                End If
                            ElseIf CDYADMIGRANTFORCEDRETURN(keyi).ContainsKey(keyj) Then
                                If Not CXDYADMIGRANT.ContainsKey(keyi) Then
                                    CXDYADMIGRANT.Add(keyi, New Dictionary(Of String, Single?))
                                End If
                                If Not CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                    CXDYADMIGRANT(keyi).Add(keyj, 0)
                                End If

                                If CXDYADMIGRANT(keyi)(keyj) < CDYADMIGRANTFORCEDRETURN(keyi)(keyj) Then
                                    CXDYADMIGRANT(keyi)(keyj) = CDYADMIGRANTFORCEDRETURN(keyi)(keyj)
                                End If
                            End If
                        ElseIf CDYADMIGRANTFORCED.ContainsKey(keyi) Then
                            If CDYADMIGRANTFORCED(keyi).ContainsKey(keyj) Then
                                If Not CXDYADMIGRANT.ContainsKey(keyi) Then
                                    CXDYADMIGRANT.Add(keyi, New Dictionary(Of String, Single?))
                                End If
                                If Not CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                    CXDYADMIGRANT(keyi).Add(keyj, 0)
                                End If

                                If CXDYADMIGRANT(keyi)(keyj) < CDYADMIGRANTFORCED(keyi)(keyj) Then
                                    CXDYADMIGRANT(keyi)(keyj) = CDYADMIGRANTFORCED(keyi)(keyj)
                                End If
                            End If
                        ElseIf CDYADMIGRANTFORCEDRETURN.ContainsKey(keyi) Then
                            If CDYADMIGRANTFORCEDRETURN(keyi).ContainsKey(keyj) Then
                                If Not CXDYADMIGRANT.ContainsKey(keyi) Then
                                    CXDYADMIGRANT.Add(keyi, New Dictionary(Of String, Single?))
                                End If
                                If Not CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                    CXDYADMIGRANT(keyi).Add(keyj, 0)
                                End If

                                If CXDYADMIGRANT(keyi)(keyj) < CDYADMIGRANTFORCEDRETURN(keyi)(keyj) Then
                                    CXDYADMIGRANT(keyi)(keyj) = CDYADMIGRANTFORCEDRETURN(keyi)(keyj)
                                End If
                            End If
                        End If

                        'jrs 2018/03/19
                        For k = 1 To YrsCount - 1
                            If CDYADMIGRANTFORCEDYRS.ContainsKey(keyi) And CDYADMIGRANTFORCEDRETURNYRS.ContainsKey(keyi) Then
                                If CDYADMIGRANTFORCEDYRS(keyi).ContainsKey(keyj) And CDYADMIGRANTFORCEDRETURNYRS(keyi).ContainsKey(keyj) Then
                                    If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k).HasValue And CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k).HasValue Then
                                        If Not CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If

                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) + CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) + CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                ElseIf CDYADMIGRANTFORCEDYRS(keyi).ContainsKey(keyj) Then
                                    If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k).HasValue Then
                                        If Not CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If

                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                ElseIf CDYADMIGRANTFORCEDRETURNYRS(keyi).ContainsKey(keyj) Then
                                    If CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k).HasValue Then
                                        If Not CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If

                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If
                            ElseIf CDYADMIGRANTFORCEDYRS.ContainsKey(keyi) Then
                                If CDYADMIGRANTFORCEDYRS(keyi).ContainsKey(keyj) Then
                                    If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k).HasValue Then
                                        If Not CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If

                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If
                            ElseIf CDYADMIGRANTFORCEDRETURNYRS.ContainsKey(keyi) Then
                                If CDYADMIGRANTFORCEDRETURNYRS(keyi).ContainsKey(keyj) Then
                                    If CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k).HasValue Then
                                        If Not CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                                            CXDYADMIGRANTYRS.Add(keyi, New Dictionary(Of String, Single?()))
                                        End If
                                        If Not CXDYADMIGRANTYRS(keyi).ContainsKey(keyj) Then
                                            Dim YrVals(YrsCount) As Single?
                                            CXDYADMIGRANTYRS(keyi).Add(keyj, YrVals)
                                        End If

                                        If CXDYADMIGRANTYRS(keyi)(keyj)(k) < CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k) Then
                                            CXDYADMIGRANTYRS(keyi)(keyj)(k) = CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If
                            End If
                        Next k
                    Next
                Next

                BalanceMigrationFlowsInAndOut(cntx, AbelGrossIn, AbelGrossOut, 1000000)

                'jrs 2018/03/19
                For k = 1 To YrsCount - 1
                    'If k = 6 Then Stop
                    BalanceMigrationFlowsInAndOutYrs(cntx, AbelGrossInYrs, AbelGrossOutYrs, k, 1000000)
                Next k

                For Each keyi In cntx.Regionalization.Keys
                    If CXDYADMIGRANTYRS.ContainsKey(keyi) Then
                        CDYADMIGVOLYRS.Add(keyi, New Dictionary(Of String, Single?()))
                        For Each keyj In CXDYADMIGRANTYRS(keyi).Keys
                            Dim VarVals(YrsCount) As Single?
                            CDYADMIGVOLYRS(keyi).Add(keyj, VarVals)

                            For k = 1 To YrsCount - 1
                                CDYADMIGVOLYRS(keyi)(keyj)(k) = If(CXDYADMIGRANTYRS(keyi)(keyj)(k), 0)
                                If CDYADMIGRANTFORCEDYRS.ContainsKey(keyi) Then
                                    If CDYADMIGRANTFORCEDYRS(keyi).ContainsKey(keyj) Then
                                        If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k).HasValue Then
                                            CDYADMIGVOLYRS(keyi)(keyj)(k) = CDYADMIGVOLYRS(keyi)(keyj)(k) - CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If

                                If CDYADMIGRANTFORCEDRETURNYRS.ContainsKey(keyi) Then
                                    If CDYADMIGRANTFORCEDRETURNYRS(keyi).ContainsKey(keyj) Then
                                        If CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k).HasValue Then
                                            CDYADMIGVOLYRS(keyi)(keyj)(k) = CDYADMIGVOLYRS(keyi)(keyj)(k) - CDYADMIGRANTFORCEDRETURNYRS(keyi)(keyj)(k)
                                        End If
                                    End If
                                End If

                                If CDYADMIGVOLYRS(keyi)(keyj)(k) < 0 Then
                                    CDYADMIGVOLYRS(keyi)(keyj)(k) = 0
                                End If
                            Next k
                        Next keyj
                    End If
                Next keyi

                yrs = cntx.GetYears("POP").OrderBy(Function(y) y).ToArray()
                Dim poptbl As IDictionary(Of String, Single?()) = cntx.GetDice("POP", yrs)
                Dim YrsPopLag As Short
                YrsPopLag = yrs(0) - sYrsMig0

                Dim DyadPreForcedMig As Dictionary(Of String, Dictionary(Of String, Single?())) = New Dictionary(Of String, Dictionary(Of String, Single?()))
                Dim DyadPreVolMig As Dictionary(Of String, Dictionary(Of String, Single?())) = New Dictionary(Of String, Dictionary(Of String, Single?()))
                Dim PreYrCount As Integer

                CDyadPreForcedMigPct = New Dictionary(Of String, Dictionary(Of String, Single?()))
                CDyadPreVolMigPct = New Dictionary(Of String, Dictionary(Of String, Single?()))

                'look at years after 1990 where voluntary migration is greater than forced migration
                For Each keyi In cntx.Regionalization.Keys
                    CDyadPreForcedMigPct.Add(keyi, New Dictionary(Of String, Single?()))
                    CDyadPreVolMigPct.Add(keyi, New Dictionary(Of String, Single?()))
                    DyadPreForcedMig.Add(keyi, New Dictionary(Of String, Single?()))
                    DyadPreVolMig.Add(keyi, New Dictionary(Of String, Single?()))
                    If Not CDYADMIGRANTFORCEDYRS.ContainsKey(keyi) Then
                        CDYADMIGRANTFORCEDYRS.Add(keyi, New Dictionary(Of String, Single?()))
                    End If
                    If Not CDYADMIGVOLYRS.ContainsKey(keyi) Then
                        CDYADMIGVOLYRS.Add(keyi, New Dictionary(Of String, Single?()))
                    End If
                    For Each keyj In cntx.Regionalization.Keys
                        Dim VarValsMig(3) As Single?
                        CDyadPreForcedMigPct(keyi).Add(keyj, VarValsMig)
                        Dim VarValsMig2(3) As Single?
                        CDyadPreVolMigPct(keyi).Add(keyj, VarValsMig2)
                        Dim VarValsMig3(3) As Single?
                        DyadPreForcedMig(keyi).Add(keyj, VarValsMig3)
                        Dim VarValsMig4(3) As Single?
                        DyadPreVolMig(keyi).Add(keyj, VarValsMig4)
                        If Not CDYADMIGRANTFORCEDYRS(keyi).ContainsKey(keyj) Then
                            Dim VarVals(YrsForcedCount) As Single?
                            CDYADMIGRANTFORCEDYRS(keyi).Add(keyj, VarVals)
                        End If
                        If Not CDYADMIGVOLYRS(keyi).ContainsKey(keyj) Then
                            Dim VarVals(YrsCount) As Single?
                            CDYADMIGVOLYRS(keyi).Add(keyj, VarVals)
                        End If
                        If keyi <> keyj Then
                            PreYrCount = 0
                            'If i = 70 And j = 108 Then Stop
                            For k = YrsCount - 1 To 1 Step -1
                                If If(CDYADMIGVOLYRS(keyi)(keyj)(k), 0) > If(CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k), 0) Then
                                    If If(CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k), 0) < 0.1 * CXDYADMIGRANTYRS(keyi)(keyj)(k) Then
                                        PreYrCount = PreYrCount + 1
                                        DyadPreForcedMig(keyi)(keyj)(PreYrCount) = If(CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k), 0)
                                        DyadPreVolMig(keyi)(keyj)(PreYrCount) = If(CDYADMIGVOLYRS(keyi)(keyj)(k), 0)
                                        If k - YrsPopLag - 1 > 0 Then
                                            If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount) = DyadPreForcedMig(keyi)(keyj)(PreYrCount) / poptbl(keyi)(k - YrsPopLag - 1)
                                                CDyadPreVolMigPct(keyi)(keyj)(PreYrCount) = DyadPreVolMig(keyi)(keyj)(PreYrCount) / poptbl(keyi)(k - YrsPopLag - 1)
                                            End If
                                        End If
                                        If PreYrCount = 3 Then
                                            Exit For 'Next dyad
                                        End If
                                    End If
                                End If
                            Next k
                            If PreYrCount > 0 And PreYrCount < 3 Then
                                For k = PreYrCount + 1 To 3
                                    DyadPreForcedMig(keyi)(keyj)(k) = -1
                                    DyadPreVolMig(keyi)(keyj)(k) = -1
                                Next k
                            ElseIf PreYrCount = 0 Then
                                For k = YrsCount - 1 To 1 Step -1
                                    If PreYrCount = 0 Then
                                        If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k).HasValue And CDYADMIGVOLYRS(keyi)(keyj)(k).HasValue Then
                                            PreYrCount = PreYrCount + 1
                                            DyadPreForcedMig(keyi)(keyj)(PreYrCount) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                            DyadPreVolMig(keyi)(keyj)(PreYrCount) = CDYADMIGVOLYRS(keyi)(keyj)(k)
                                            If k - YrsPopLag - 1 > 0 Then
                                                If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                    CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount) = DyadPreForcedMig(keyi)(keyj)(PreYrCount) / poptbl(keyi)(k - YrsPopLag - 1)
                                                    CDyadPreVolMigPct(keyi)(keyj)(PreYrCount) = DyadPreVolMig(keyi)(keyj)(PreYrCount) / poptbl(keyi)(k - YrsPopLag - 1)
                                                End If
                                            End If
                                        End If
                                    ElseIf PreYrCount < 3 Then
                                        If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k).HasValue And CDYADMIGVOLYRS(keyi)(keyj)(k).HasValue Then
                                            PreYrCount = PreYrCount + 1
                                            If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) < DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1) Then
                                                DyadPreForcedMig(keyi)(keyj)(PreYrCount) = DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1)
                                                DyadPreVolMig(keyi)(keyj)(PreYrCount) = DyadPreVolMig(keyi)(keyj)(PreYrCount - 1)
                                                CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount) = CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount - 1)
                                                CDyadPreVolMigPct(keyi)(keyj)(PreYrCount) = CDyadPreVolMigPct(keyi)(keyj)(PreYrCount - 1)
                                                If PreYrCount = 2 Then
                                                    DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                                    DyadPreVolMig(keyi)(keyj)(PreYrCount - 1) = CDYADMIGVOLYRS(keyi)(keyj)(k)
                                                    If k - YrsPopLag - 1 > 0 Then
                                                        If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                            CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount - 1) = DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1) / poptbl(keyi)(k - YrsPopLag - 1)
                                                            CDyadPreVolMigPct(keyi)(keyj)(PreYrCount - 1) = DyadPreVolMig(keyi)(keyj)(PreYrCount - 1) / poptbl(keyi)(k - YrsPopLag - 1)
                                                        End If
                                                    End If
                                                Else
                                                    If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) < DyadPreForcedMig(keyi)(keyj)(PreYrCount - 2) Then
                                                        DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1) = DyadPreForcedMig(keyi)(keyj)(PreYrCount - 2)
                                                        DyadPreVolMig(keyi)(keyj)(PreYrCount - 1) = DyadPreVolMig(keyi)(keyj)(PreYrCount - 2)
                                                        CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount - 1) = CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount - 2)
                                                        CDyadPreVolMigPct(keyi)(keyj)(PreYrCount - 1) = CDyadPreVolMigPct(keyi)(keyj)(PreYrCount - 2)

                                                        DyadPreForcedMig(keyi)(keyj)(PreYrCount - 2) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                                        DyadPreVolMig(keyi)(keyj)(PreYrCount - 2) = CDYADMIGVOLYRS(keyi)(keyj)(k)

                                                        If k - YrsPopLag - 1 > 0 Then
                                                            If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                                CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount - 2) = DyadPreForcedMig(keyi)(keyj)(PreYrCount - 2) / poptbl(keyi)(k - YrsPopLag - 1)
                                                                CDyadPreVolMigPct(keyi)(keyj)(PreYrCount - 2) = DyadPreVolMig(keyi)(keyj)(PreYrCount - 2) / poptbl(keyi)(k - YrsPopLag - 1)
                                                            End If
                                                        End If

                                                    Else
                                                        DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                                        DyadPreVolMig(keyi)(keyj)(PreYrCount - 1) = CDYADMIGVOLYRS(keyi)(keyj)(k)
                                                        If k - YrsPopLag - 1 > 0 Then
                                                            If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                                CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount - 1) = DyadPreForcedMig(keyi)(keyj)(PreYrCount - 1) / poptbl(keyi)(k - YrsPopLag - 1)
                                                                CDyadPreVolMigPct(keyi)(keyj)(PreYrCount - 1) = DyadPreVolMig(keyi)(keyj)(PreYrCount - 1) / poptbl(keyi)(k - YrsPopLag - 1)
                                                            End If
                                                        End If
                                                    End If
                                                End If
                                            Else
                                                DyadPreForcedMig(keyi)(keyj)(PreYrCount) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                                DyadPreVolMig(keyi)(keyj)(PreYrCount) = CDYADMIGVOLYRS(keyi)(keyj)(k)
                                                If k - YrsPopLag - 1 > 0 Then
                                                    If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                        CDyadPreForcedMigPct(keyi)(keyj)(PreYrCount) = DyadPreForcedMig(keyi)(keyj)(PreYrCount) / poptbl(keyi)(k - YrsPopLag - 1)
                                                        CDyadPreVolMigPct(keyi)(keyj)(PreYrCount) = DyadPreVolMig(keyi)(keyj)(PreYrCount) / poptbl(keyi)(k - YrsPopLag - 1)
                                                    End If
                                                End If
                                            End If
                                        End If
                                    ElseIf CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) < DyadPreForcedMig(keyi)(keyj)(3) And CDYADMIGVOLYRS(keyi)(keyj)(k).HasValue Then
                                        If CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) > DyadPreForcedMig(keyi)(keyj)(2) Then
                                            DyadPreForcedMig(keyi)(keyj)(3) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                            DyadPreVolMig(keyi)(keyj)(3) = CDYADMIGVOLYRS(keyi)(keyj)(k)
                                            If k - YrsPopLag - 1 > 0 Then
                                                If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                    CDyadPreForcedMigPct(keyi)(keyj)(3) = DyadPreForcedMig(keyi)(keyj)(3) / poptbl(keyi)(k - YrsPopLag - 1)
                                                    CDyadPreVolMigPct(keyi)(keyj)(3) = DyadPreVolMig(keyi)(keyj)(3) / poptbl(keyi)(k - YrsPopLag - 1)
                                                End If
                                            End If

                                        ElseIf CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k) < DyadPreForcedMig(keyi)(keyj)(1) Then
                                            DyadPreForcedMig(keyi)(keyj)(3) = DyadPreForcedMig(keyi)(keyj)(2)
                                            DyadPreForcedMig(keyi)(keyj)(2) = DyadPreForcedMig(keyi)(keyj)(1)
                                            DyadPreForcedMig(keyi)(keyj)(1) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                            DyadPreVolMig(keyi)(keyj)(3) = DyadPreVolMig(keyi)(keyj)(2)
                                            DyadPreVolMig(keyi)(keyj)(2) = DyadPreVolMig(keyi)(keyj)(1)
                                            DyadPreVolMig(keyi)(keyj)(1) = CDYADMIGVOLYRS(keyi)(keyj)(k)

                                            CDyadPreForcedMigPct(keyi)(keyj)(3) = CDyadPreForcedMigPct(keyi)(keyj)(2)
                                            CDyadPreForcedMigPct(keyi)(keyj)(2) = CDyadPreForcedMigPct(keyi)(keyj)(1)
                                            CDyadPreVolMigPct(keyi)(keyj)(3) = CDyadPreVolMigPct(keyi)(keyj)(2)
                                            CDyadPreVolMigPct(keyi)(keyj)(2) = CDyadPreVolMigPct(keyi)(keyj)(1)

                                            If k - YrsPopLag - 1 > 0 Then
                                                If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                    CDyadPreForcedMigPct(keyi)(keyj)(1) = DyadPreForcedMig(keyi)(keyj)(1) / poptbl(keyi)(k - YrsPopLag - 1)
                                                    CDyadPreVolMigPct(keyi)(keyj)(1) = DyadPreVolMig(keyi)(keyj)(1) / poptbl(keyi)(k - YrsPopLag - 1)
                                                End If
                                            End If
                                        Else
                                            DyadPreForcedMig(keyi)(keyj)(3) = DyadPreForcedMig(keyi)(keyj)(2)
                                            DyadPreForcedMig(keyi)(keyj)(2) = CDYADMIGRANTFORCEDYRS(keyi)(keyj)(k)
                                            DyadPreVolMig(keyi)(keyj)(3) = DyadPreVolMig(keyi)(keyj)(2)
                                            DyadPreVolMig(keyi)(keyj)(2) = CDYADMIGVOLYRS(keyi)(keyj)(k)

                                            CDyadPreForcedMigPct(keyi)(keyj)(3) = CDyadPreForcedMigPct(keyi)(keyj)(2)
                                            CDyadPreVolMigPct(keyi)(keyj)(3) = CDyadPreVolMigPct(keyi)(keyj)(2)

                                            If k - YrsPopLag - 1 > 0 Then
                                                If poptbl(keyi)(k - YrsPopLag - 1) > 0 Then
                                                    CDyadPreForcedMigPct(keyi)(keyj)(2) = DyadPreForcedMig(keyi)(keyj)(2) / poptbl(keyi)(k - YrsPopLag - 1)
                                                    CDyadPreVolMigPct(keyi)(keyj)(2) = DyadPreVolMig(keyi)(keyj)(2) / poptbl(keyi)(k - YrsPopLag - 1)
                                                End If
                                            End If
                                        End If
                                    End If
                                Next k
                            End If 'ElseIf PreYrCount = 0 Then
                        End If 'if i <> j then
                    Next
                Next

                CDyadPreForcedMigPctAvg = New Dictionary(Of String, Dictionary(Of String, Single?))
                CDyadPreVolMigPctAvg = New Dictionary(Of String, Dictionary(Of String, Single?))

                'Compute the Average
                Dim AvgSum As Single?, AvgSum2 As Single?, AvgCount As Integer
                For Each keyi In cntx.Regionalization.Keys
                    CDyadPreForcedMigPctAvg.Add(keyi, New Dictionary(Of String, Single?))
                    CDyadPreVolMigPctAvg.Add(keyi, New Dictionary(Of String, Single?))
                    For Each keyj In cntx.Regionalization.Keys
                        Dim VarValsMig(3) As Single?
                        CDyadPreForcedMigPctAvg(keyi).Add(keyj, 0)
                        CDyadPreVolMigPctAvg(keyi).Add(keyj, 0)
                        If keyi <> keyj Then
                            AvgCount = 0
                            AvgSum = 0
                            AvgSum2 = 0
                            For k = 1 To 3
                                If CDyadPreForcedMigPct(keyi)(keyj)(k) = -1 Then
                                    Exit For
                                Else
                                    AvgSum = AvgSum + CDyadPreForcedMigPct(keyi)(keyj)(k)
                                    AvgSum2 = AvgSum2 + CDyadPreVolMigPct(keyi)(keyj)(k)
                                    AvgCount = AvgCount + 1
                                End If
                            Next k
                            If AvgCount > 0 Then
                                CDyadPreForcedMigPctAvg(keyi)(keyj) = AvgSum / AvgCount / 10000
                                CDyadPreVolMigPctAvg(keyi)(keyj) = AvgSum2 / AvgCount / 10000
                            End If
                        End If
                    Next
                Next
            End Sub

            Private Sub MigrantFlowFill0s(cntx As IRebuildFacade, YrIdx As Integer, YrList As Short(), migTbl As IDictionary(Of String, Single?()))
                Dim TotYrs As Integer = YrList.Count
                'For countries with 0 Total Emigrant, or 0 Total Imigrants look for a year with data different than 0
                'Check Total Emigrants first
                Dim Total0s As Integer
                Total0s = 0
                Dim CtrysWith0 As List(Of String) = New List(Of String)
                Dim j As Integer
                For Each keyi In cntx.Regionalization.Keys
                    j = 0
                    If CXDYADMIGRANT.ContainsKey(keyi) Then
                        For Each keyj In CXDYADMIGRANT(keyi).Keys
                            If CXDYADMIGRANT(keyi)(keyj) > 0 Then
                                Exit For
                            End If
                            j = j + 1
                        Next
                        If j = CXDYADMIGRANT(keyi).Keys.Count Then
                            'All are 0s
                            Total0s = Total0s + 1
                            'ReDim Preserve CtrysWith0(Total0s)
                            CtrysWith0.Add(keyi)
                        End If
                    Else
                        'All are 0s
                        Total0s = Total0s + 1
                        'ReDim Preserve CtrysWith0(Total0s)
                        CtrysWith0.Add(keyi)
                    End If
                Next

                'Check Total Immigrants second
                Dim TotalIm0s As Integer
                TotalIm0s = 0
                Dim CtrysWithIm0 As List(Of String) = New List(Of String)
                For Each keyi In cntx.Regionalization.Keys
                    j = 0
                    For Each keyj In cntx.Regionalization.Keys
                        If CXDYADMIGRANT.ContainsKey(keyj) Then
                            If CXDYADMIGRANT(keyj).ContainsKey(keyi) Then
                                If CXDYADMIGRANT(keyj)(keyi) > 0 Then
                                    Exit For
                                End If
                            End If
                        End If
                        j = j + 1
                    Next
                    If j = cntx.Regionalization.Keys.Count Then
                        'All are 0s
                        TotalIm0s = TotalIm0s + 1
                        'ReDim Preserve CtrysWithIm0(Total0s)
                        CtrysWithIm0.Add(keyi)
                    End If
                Next

                Dim yr As Short
                Dim sActor As String, sPartner As String
                'For each country found
                For Each key0 In CtrysWith0
                    'Find year to use
                    yr = 0
                    'jrs 2022/01/27 added amin( , YrIdx) -> Syria, Turkey was using 2020 instead of 2015 data
                    For j = Amin(TotYrs - 1, YrIdx) To 0 Step -1
                        For Each keyB In cntx.Regionalization.Keys
                            If migTbl.ContainsKey(key0 + ";" + keyB) Then
                                If migTbl(key0 + ";" + keyB)(j) > 0 Then
                                    yr = YrList(j)
                                    j = 0
                                    Exit For
                                End If
                            End If
                        Next
                    Next
                    'If j < TotYrs Then
                    If yr > 0 Then
                        'Read data from table
                        'For Each item In (From s In migTbl Where s.Key = key0 + ";*") 'LIKE
                        For Each item In (From s In migTbl)
                            If item.Key.Split(";".ToCharArray)(0) = key0 Then
                                'Reload the array
                                sActor = key0
                                sPartner = item.Key.Split(";".ToCharArray)(1)
                                If cntx.HistoricMode Then
                                    CXDYADMIGRANT(sActor)(sPartner) = getYearOrEarliestWithinRange(migTbl, YrList, item.Key, cntx.FirstYear, 20) / 5 'jrs 2021/08/03 added /5
                                Else
                                    CXDYADMIGRANT(sActor)(sPartner) = getYearOrMstRct(migTbl, YrList, item.Key, yr) / 5 'jrs 2021/08/03 added /5
                                End If
                                CMDYADMIGRANT(sPartner)(sActor) = CXDYADMIGRANT(sActor)(sPartner)
                            End If
                        Next
                    End If
                Next

                'For each country found
                For Each key0 In CtrysWithIm0
                    'Find year to use
                    yr = 0
                    'jrs 2022/01/27 added amin( , YrIdx) -> Syria, Turkey was using 2020 instead of 2015 data
                    For j = Amin(TotYrs - 1, YrIdx) To 0 Step -1
                        For Each keyA In cntx.Regionalization.Keys
                            If migTbl.ContainsKey(keyA + ";" + key0) Then
                                If migTbl(keyA + ";" + key0)(j) > 0 Then
                                    yr = YrList(j)
                                    j = 0
                                    Exit For
                                End If
                            End If
                        Next
                    Next j
                    'If j < TotYrs Then
                    If yr > 0 Then
                        'Read data from table
                        'For Each item In (From s In migTbl Where s.Key = "*;" + key0) 'LIKE
                        For Each item In (From s In migTbl)
                            If item.Key.Split(";".ToCharArray)(1) = key0 Then
