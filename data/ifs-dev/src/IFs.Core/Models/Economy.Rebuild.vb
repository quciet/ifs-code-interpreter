                cSANITATIONCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cSANITATIONCOST")

                cWATSAFECOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cWATSAFECOST")
                cINFRATELECOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cINFRATELECOST")
                cICTMOBILCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cICTMOBILCOST")
                cICTBROADCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cICTBROADCOST")
                cICTBROADMOBILCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cICTBROADMOBILCOST")

                cLANDIRCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cLANDIRCOST")
                cWATWASTETREATCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cWATWASTETREATCOST")
                cSANITATIONIMPCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cSANITATIONIMPCOST")
                cWATSAFEIMPCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cWATSAFEIMPCOST")
                cINFRAELECACCRURALCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cINFRAELECACCRURALCOST")
                cINFRAELECACCURBANCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cINFRAELECACCURBANCOST")

