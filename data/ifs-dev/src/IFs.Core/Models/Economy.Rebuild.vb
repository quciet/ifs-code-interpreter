            Private Sub PrintIOTab()
                Dim t, i, j As Integer
                Dim sLine As String
                'Open file
                Dim objWriter = New System.IO.StreamWriter(PutFdrvRun + "iotab.csv", append:=False)
                For t = 1 To 9
                    For i = 1 To 6
                        For j = 1 To 6
