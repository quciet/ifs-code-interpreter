        Class GDPAggregator
            Inherits DefaultSumAggregator

            <ExportsAsset("CGDP")>
            <ExportsAsset("CGDPPCP")>
            <ExportsAsset("CGDPPCPLT20")>
            <ExportsAsset("CGDPPCPLT30")>
            <ExportsAsset("CGDPPCPLT50")>
            <ExportsAsset("CGDPPC")>
            <ExportsAsset("CGDPAdj")>
            <ExportsAsset("CGDPPCP2005")>
            <ImportsAsset("CPOP")>
            Public Overrides Function Normalize(seriesName As String, cntx As IRebuildFacade) As IDictionary(Of String, Single?)
                Dim CPOP As IDictionary(Of String, Single?) = cntx.Fetch(Of IDictionary(Of String, Single?))("CPOP")
                Dim CGDP As IDictionary(Of String, Single?) = New Dictionary(Of String, Single?) '= MyBase.Normalize(seriesName, cntx)
                Dim ValHold As Single?
                If cntx.HistoricMode Then
                    Dim years As Short()
                    'jrs 2022/11/01 flex constant dollars
                    years = (From y In cntx.GetYears("GDP" & ConstantDollarsYear.ToString)
                             Where y >= cntx.FirstYear And y <= cntx.LastYear
                             Order By y Ascending
                    ).Take(cntx.LastYear - cntx.FirstYear + 1).ToArray
                    Dim diceGDP As IDictionary(Of String, Single?()) = cntx.GetDice("GDP" & ConstantDollarsYear.ToString, years)
                    Dim GDPANN As Single?
                    For Each key In cntx.Regionalization.Keys
                        For YearCount% = 1 To cntx.LastYear - cntx.FirstYear + 1 '1960 To 2000
                            GDPANN = diceGDP(key)(YearCount - 1)
                            If GDPANN.HasValue Then
                                ValHold = CSng(GDPANN * (1 - 0.03) ^ (YearCount% - 1))
                                Exit For
                            End If
                        Next YearCount%
                        CGDP.Add(key, ValHold)
                    Next
                Else
                    'jrs 2022/11/01 flex constant dollars
                    CGDP = cntx.GetSlice("GDP" & ConstantDollarsYear.ToString, cntx.FirstYear, DefaultPolicy)
                End If
                For Each key In cntx.Regionalization.Keys
                    If Not CGDP(key).HasValue Then
                        CGDP.Remove(key)
                        CGDP.Add(key, AMAX(1, CPOP(key)))
                    End If
                Next

                Dim CGDPPCP As IDictionary(Of String, Single?) = New Dictionary(Of String, Single?) ' MyBase.Normalize(seriesName, cntx)

                Dim bUSA As Boolean
                bUSA = cntx.Regionalization.Keys.Contains("United States of America")
                Dim CGDPCapUSA As Single?
                If bUSA Then
                    CGDPCapUSA = CGDP("United States of America") / CPOP("United States of America")
                Else
                    CGDPCapUSA = CGDP("California") / CPOP("California")
                End If

                If Not cntx.HistoricMode Then
                    'jrs 2022/11/01 flex constant dollars
                    Dim yrsGDP As Short() = cntx.GetYears("GDP" & ConstantDollarsYear.ToString).OrderBy(Function(y) y).ToArray()
                    Dim diceGDP As IDictionary(Of String, Single?()) = cntx.GetDice("GDP" & ConstantDollarsYear.ToString, yrsGDP)
                    Using db2 As IFs2Context = New IFs2Context()
                        db2.Clear(GetType(SeriesRegGDP2011))
                        RegionalizeFullTableSUM(diceGDP, yrsGDP, cntx, db2.SeriesRegGDP2011)
                        db2.Flush()
                    End Using
                End If

                Dim CGDPPCP2005 As IDictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                If cntx.HistoricMode Then
                    'jrs 2022/11/01 
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim years As Short() = cntx.GetYears("GDPPCP" & ConstantDollarsYear.ToString).OrderBy(Function(y) y).ToArray()
                    Dim GDPPCPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("GDPPCP" & ConstantDollarsYear.ToString, years)
                    Dim years2005 As Short() = cntx.GetYears("SeriesGDP2005PCPPP").OrderBy(Function(y) y).ToArray()
                    Dim GDPPCP2005Tbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesGDP2005PCPPP", years2005)

                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(GDPPCPTbl, years, key, cntx.FirstYear, HistDist)  'read in dollars
                        CGDPPCP.Add(key, ValHold)

                        ValHold = getClosestYrVal(GDPPCP2005Tbl, years2005, key, cntx.FirstYear, HistDist)  'read in dollars
                        CGDPPCP2005.Add(key, ValHold)
                    Next

                    'CGDPPCP = cntx.GetSlice("GDPPCP", "Earliest")
                    'CGDPPCP2005 = cntx.GetSlice("SeriesGDP2005PCPPP", "Earliest")

                    'mti 2019/04/29  Flex Hist Base End

                Else
                    'jrs 2022/11/01
                    CGDPPCP = cntx.GetSlice("GDPPCP" & ConstantDollarsYear.ToString, cntx.FirstYear, DefaultPolicy)
                    CGDPPCP2005 = cntx.GetSlice("SeriesGDP2005PCPPP", cntx.FirstYear, DefaultPolicy)
                End If

                Dim CGDPPC As IDictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                '   Save GDP/Cap (Purchasing Power) by Country for Weighting Purposes
                '   -----------------------------------------------------------------
                Dim TbName As String, ValHold2005 As Single?
                Dim EstimateGDPPCPHis As SeriesEstimator = cntx.GetRegression("GDP/Capita Versus GDP/Capita at Purchasing Power Parity (1980)").ToEstimator(CGDPPC)
                TbName$ = "GDP/Capita Versus GDP/Capita at Purchasing Power Parity (" & CStr(cntx.FirstYear) & ") Power Function"
                TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.FirstYear, cntx)
                Dim EstimateGDPPCP As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPC)
                For Each key In cntx.Regionalization.Keys
                    CGDPPC.Add(key, CGDP(key) / CPOP(key))
                    If cntx.HistoricMode Then
                        ValHold = CGDPPCP(key)  'read in dollars
                        If Not ValHold.HasValue Or ValHold < 0.001 Then
                            CGDPPCP(key) = EstimateGDPPCPHis(key)
                        Else
                            CGDPPCP(key) = ValHold / 1000 'Convert to 1000s
                        End If
                        'bbh 2014/09/13 start
                        ValHold = CGDPPCP2005(key)  'read in dollars
                        If Not ValHold.HasValue Or ValHold < 0.001 Then
                            CGDPPCP2005(key) = EstimateGDPPCPHis(key)
                        Else
                            CGDPPCP2005(key) = ValHold / 1000 'Convert to 1000s
                        End If

                        'jrs 2014/10/24 CGDPPCP95(key) = CGDPPCP(key)
                    Else
                        'jrs 2006/11/29 const to vars ValHold = GDPPCPTbl(keyi)(2000) 'read dollars
                        ValHold = CGDPPCP(key) 'read dollars
                        'bbh 2014/09/13 start
                        ValHold2005 = CGDPPCP2005(key)
                        If Not ValHold.HasValue Or ValHold < 0.001 Then
                            If Not ValHold2005.HasValue Then
                                'jrs 2006/12/14 TBName$ = "GDP/Capita Versus GDP/Capita at Purchasing Power Parity (2000) Power Function"
                                'Call XYTABL(TbName$, CGDPPC(key), GDPPCatPPP)
                                CGDPPCP(key) = EstimateGDPPCP(key)
                            Else
                                CGDPPCP(key) = ValHold2005 / 1000
                            End If
                        Else
                            CGDPPCP(key) = ValHold / 1000 'Convert to 1000s
                        End If
                        If Not ValHold2005.HasValue Then
                            CGDPPCP2005(key) = CGDPPCP(key)
                        Else
                            CGDPPCP2005(key) = ValHold2005 / 1000
                        End If
                    End If
                Next

                Dim Ratio As Single?
                If bUSA Then
                    Ratio = CGDPCapUSA / CGDPPCP("United States of America")
                Else
                    Ratio = CGDPCapUSA / CGDPPCP("California")
                End If

                If Ratio < 1.01 And Ratio > 0.99 Then Ratio = 1 'Data are aligned adequately; no adjustment

                '   Adjust PPP to currency year of GDP (which will be base year currency, e.g. 2000 $)
                '   In the process, adjust US GDP PPP to US GDP at market prices; US is numeraire
                '   Also reconcile GDPs at Exchange Rate and Purchasing Power if Greatly Different
                '   As of January 2009 GDP per capita at PPP for all of world start with ICP data revision
                '       as reflected in 2008 WDI release of GDP per capita at PPP data;
                '       so China is much lower than before (at $4088 in 2005 in WDI/ICT, probably in 2005$);
                '       But US PPP in that data for 2005 is higher than US GDP/Cap at market prices from WDI (in 2000$),
                '       So process computes factor to bring US GDP/Cap at PPP in 2005  from ICP 2005$ down to WDI value
                '       of US GDP/Cap at MER in 2005 in 2000$; that factor applied to China and others effectively
                '       converts roughly from 2005$ to 2000$, but still uses core relative alues of newest ICT PPP data
                '   ------------------------------------------------------------------------------
                Dim CGDPAdj As IDictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                For Each key In cntx.Regionalization.Keys
                    CGDPPCP(key) = CGDPPCP(key) * Ratio
                    CGDPAdj.Add(key, 1)
                    If CGDPPCP(key) > 10 * CGDPPC(key) Then
                        CGDPPC(key) = CSng(0.1 * CGDPPCP(key))
                        CGDPAdj(key) = CGDPPC(key) * CPOP(key) / CGDP(key)
                        CGDP(key) = CGDPPC(key) * CPOP(key)
                    End If
                    If CGDPPC(key) > 2 * CGDPPCP(key) Then
                        CGDPPCP(key) = CSng(0.5 * CGDPPC(key))
                    End If
                Next

                cntx.Store("CGDPPCP", CGDPPCP)
                cntx.Store("CGDPPCPLT20", CGDPPCP.ToDictionary(Function(s) s.Key, Function(s) ApplyUpperBound(s.Value, 20.0F)))
                cntx.Store("CGDPPCPLT30", CGDPPCP.ToDictionary(Function(s) s.Key, Function(s) ApplyUpperBound(s.Value, 30.0F)))
                cntx.Store("CGDPPCPLT50", CGDPPCP.ToDictionary(Function(s) s.Key, Function(s) ApplyUpperBound(s.Value, 50.0F)))
                cntx.Store("CGDPPC", CGDPPC)
                cntx.Store("CGDPAdj", CGDPAdj)
                cntx.Store("CGDP", CGDP)
                cntx.Store("CGDPPCP2005", CGDPPCP2005)

                Return CGDP
            End Function

        End Class

