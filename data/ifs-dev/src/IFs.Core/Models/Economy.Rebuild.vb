                                      Join s2 In cntx.GetSlice("SeriesGovtCalcHealthTotGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesGovtCalcEdCenGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Join s4 In cntx.GetSlice("SeriesGovtCalcEdTotGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s4.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value, Value4 = s4.Value)
                        GExpHlCen.Add(item.Key, If(item.Value, 0))
                        GExpHlTot.Add(item.Key, If(item.Value2, 0))
                        GExpEdCen.Add(item.Key, If(item.Value3, 0))
                        GExpEdTot.Add(item.Key, If(item.Value4, 0))
                    Next
                End If 'if history else forecast

                '-- Infrastructure Expenditure : Build up from components calculated in DataInfra: for historical and regular base--
                'switch to turn infrastructure finance on and off
                Dim GDSInfraNew As Single?, GDSInfraMaint As Single?, GDSInfra As Single?
                For Each key In cntx.Regionalization.Keys
                    If infrafinon = 1 Then
                        GDSInfraNew = 0
                        GDSInfraMaint = 0

                        For InfCt% = 1 To cntx.NInfraType
                            GDSInfraNew = GDSInfraNew + infrainvnewpubshrm(1, InfCt%) * cINFRAINVESTNEW(key)(InfCt%)
                            GDSInfraMaint = GDSInfraMaint + infrainvmaintpubshrm(1, InfCt%) * cINFRAINVESTMAINT(key)(InfCt%)
                        Next


                        GDSInfra = GDSInfraNew + GDSInfraMaint 'billion dollars
                    Else 'infrastructure financing is not modeled at all
                        GDSInfra = 0
                    End If

                    'convert billions of $ to % of GDP and cap at 10% of GDP : capping needed for countries like Bhutan
                    GExpInfra.Add(key, Amin(10, 100 * GDSInfra / CGDP(key)))

                    'non-core or 'other' infrastructure as a % of GDP - using function estimated by DSR
                    GExpInfraOther.Add(key, CSng(1.8162 + 0.061 * Log(CSng(CGDPPCP(key)))))
                Next

                For Each key In cntx.Regionalization.Keys
                    '   Convert percentages back to absolute government expenditures
                    '   ------------------------------------------------------------
                    GExpDef(key) = GExpDef(key) / 100 * CGDP(key) ' CGCon(key)
                    GExpHl(key) = GExpHl(key) / 100 * CGDP(key) 'CGCon(key)
                    GExpEd(key) = GExpEd(key) / 100 * CGDP(key) 'CGCon(key)
                    GExpRandD(key) = GExpRandD(key) / 100 * CGDP(key) 'CGCon(key)
                    GExpInfra(key) = GExpInfra(key) / 100 * CGDP(key) ' CGCon(key)
                    GExpInfraOther(key) = GExpInfraOther(key) / 100 * CGDP(key) ' CGCon(key)
                    'jrs 2014/04/29
                    TExpHl(key) = TExpHl(key) / 100 * CGDP(key)
                    'jrs 2014/05/05
                    PrivExpHl(key) = PrivExpHl(key) / 100 * CGDP(key)

                    '--mti 2013/08/05 - Other not known at this point
                    'GExpOt(key) = GExpOt(key) / 100 * CGDP(key) ' CGCon(key)
                    GExpOt.Add(key, 0)
                    '--mti 2013/08/05 -end


                    '        GExpAid(key) = GExpAid(key) / 100 * CGCon(key)
                    'This assumes that for aid recipients, govt expenditure numbers
                    '   all have that aid built in
                    'For aid donors, aid is in other expenditures

                    'bbh 2014/01/24 Start
                    GExpHlCen(key) = GExpHlCen(key) / 100 * CGDP(key)
                    GExpEdCen(key) = GExpEdCen(key) / 100 * CGDP(key)
                    GExpHlTot(key) = GExpHlTot(key) / 100 * CGDP(key)
                    GExpEdTot(key) = GExpEdTot(key) / 100 * CGDP(key)
                    GExpHlLocal.Add(key, AMAX(0, GExpHlTot(key) - GExpHlCen(key)))
                    GExpEdLocal.Add(key, AMAX(0, GExpEdTot(key) - GExpEdCen(key)))
                    'If key = "Afghanistan" Then Stop
                    'bbh 2014/01/24 end

                Next

                ' mark pre-processedGovCon for all three series
                Me.processedGovCon = True
            End Sub

            Public Sub NewGovConAdjAggregator(cntx As IRebuildFacade)
                cINFRAROADPAVEDCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cINFRAROADPAVEDCOST")
                cINFRAROADUNPAVEDCOST = cntx.Fetch(Of IDictionary(Of String, Single?))("cINFRAROADUNPAVEDCOST")
