                                    'CLABWAGES(ctry.Country, SCount%, Skilled) = IFsSkilledWage(SCount%) / AMAX(0.001, IFsSkilledLab(SCount%))
                                    'CLABWAGES(ctry.Country, SCount%, Total) = (IFsUnskilledWage(SCount%) + IFsSkilledWage(SCount%)) / AMAX(0.001, IFsUnskilledLab(SCount%) + IFsSkilledLab(SCount%))
                                    '-------------------------

                                    'divide factor payments by labor (units of factor payments is million dollar (found through IFs ceck with two GTAP datasets: factor payment and labor/wage
                                    'CLABWAGES(ctry.Country, SCount%, Unskilled) = IFsUnskilled(SCount%) / AMAX(0.001, IFsUnskilledLab(SCount%)) / 1000
                                    'CLABWAGES(ctry.Country, SCount%, Skilled) = IFsSkilled(SCount%) / AMAX(0.001, IFsSkilledLab(SCount%)) / 1000
                                    'CLABWAGES(ctry.Country, SCount%, Total) = (IFsUnskilled(SCount%) + IFsSkilled(SCount%)) / AMAX(0.001, IFsUnskilledLab(SCount%) + IFsSkilledLab(SCount%))
                                    TotPayments = AMAX(0.001F, IFsUnskilled(SCount%) + IFsSkilled(SCount%))
                                    CLABWAGESSHRSKL(ctry.Country)(SCount%, Unskilled) = 100 * IFsUnskilled(SCount%) / TotPayments
