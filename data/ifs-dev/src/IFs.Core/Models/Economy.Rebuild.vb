            Private Sub ComputeLaborFunctionsCountry(cntx As IRebuildFacade) '(GLABEMPS(), GVADD(), GGDPPCP(), TotGTAP%)
                Dim reg As New RegressionObject
                'jrs 2018/09/20 Dim X1(255) As Double, Y1(255) As Double, Y_Pred(255) As Double, Residual(255) As Double
                Dim iSize As Integer
                iSize = AMAX(NR, cntx.Regionalization.Keys.Count)
                Dim X1() As Double, Y1() As Double, Y_Pred() As Double, Residual() As Double
                ReDim X1(iSize), Y1(iSize), Y_Pred(iSize), Residual(iSize)


                Dim IFsCoefFuncA(5, 10) As Double, IFsCoefFuncB(5, 10) As Double  'skill, sector

                Dim IFsCoeffRsqrd(5, 10) As Double, IFsCoeffStdErr(5, 10) As Double   'skill, sector

                Dim A As Double, B As Double
                Dim pt As Integer
                Dim sk%, S%, gcnt%
                Dim SSE As Double, YBAR As Double, SST As Double, Residual_Avg As Double, StdErr As Double
                'gvdb 2024/04/05
                ' unused variable
                'Dim InFile$, 
                Dim sec_name$, func_name$, skill_name$, UsedRun$, UsedHistRun$, UsedPre$, UsedHistPre$

                Dim msg As String
                msg$ = "Error computing labor coefficient functions."

                Try
                    Dim X1Val As Single?, Y1Val As Single?
                    For sk% = 1 To 2
                        For S% = 1 To cntx.NSec
                            'jrs 2018/09/20 Erase X1, Y1, Y_Pred
                            ReDim X1(iSize), Y1(iSize), Y_Pred(iSize)
                            With reg
                                .Init()
                                .Degree = 1 'Degree
                                pt = 0

                                For Each key In cntx.Regionalization.Keys
                                    X1Val = CGDPPCP(key)  ' in thousand dollars
                                    Y1Val = 1000 * CLABEMPS(key)(S%, sk%) / AMAX(0.0001F, CVADD(key)(S%))
                                    'labor coeff: labor in millions; VAdd in billions; 'the above gives labor per million dollar output

                                    If X1Val > 0 And Y1Val > 0 Then
                                        pt = pt + 1
                                        X1(pt) = CDbl(X1Val)
                                        Y1(pt) = CDbl(Y1Val)
                                        'power function is same as a linear on log-log
                                        .XYAdd(Log(X1(pt)), Log(Y1(pt)))
                                    End If
                                Next key

                                A = -9999
                                B = -9999
                                If pt > 1 Then
                                    A = reg.Coeff(0)
                                    B = reg.Coeff(1)
                                    'convert back to power
                                    IFsCoefFuncA(sk%, S%) = Exp(A)
                                    IFsCoefFuncB(sk%, S%) = B
                                End If
                                'Debug.Print S%, sk%, A, B

                            End With



                            'Calculate R-Squared
                            If pt > 1 Then
                                SSE = 0
                                YBAR = 0

                                For gcnt = 1 To pt   'TotGTAP% 'NR
                                    'If X1(gcnt) > 0 And Y1(gcnt) > 0 Then
                                    Y_Pred(gcnt) = A + B * Log(X1(gcnt))
                                    SSE = SSE + (Log(Y1(gcnt)) - Y_Pred(gcnt)) ^ 2
                                    YBAR = YBAR + Log(Y1(gcnt))
                                    'End If
                                Next gcnt

                                YBAR = YBAR / pt
                                SST = 0
                                For gcnt = 1 To pt  'TotGTAP% 'NR
                                    'If Y1(gcnt) > 0 And X1(gcnt) > 0 Then
                                    SST = SST + (Log(Y1(gcnt)) - YBAR) ^ 2
                                    'End If
                                Next gcnt

                                IFsCoeffRsqrd(sk%, S%) = 1 - (SSE / SST)

                                'Std Dev
                                YBAR = YBAR / pt
                                Residual_Avg = 0
                                For gcnt = 1 To pt  'TotGTAP% 'NR
                                    If Y1(gcnt) > 0 And X1(gcnt) > 0 Then
                                        Residual(gcnt) = Y1(gcnt) - Y_Pred(gcnt)
                                        Residual_Avg = Residual_Avg + Residual(gcnt)
                                    End If
                                Next gcnt
                                Residual_Avg = Residual_Avg / pt

                                StdErr = 0
                                For gcnt = 1 To pt  'TotGTAP% 'NR
                                    If Y1(gcnt) > 0 And X1(gcnt) > 0 Then
                                        StdErr = StdErr + ((Residual(gcnt) - Residual_Avg) ^ 2) / pt
                                    End If
                                Next gcnt
                                If StdErr > 0 Then
                                    IFsCoeffStdErr(sk%, S%) = Sqrt(StdErr)
                                End If
                            End If

