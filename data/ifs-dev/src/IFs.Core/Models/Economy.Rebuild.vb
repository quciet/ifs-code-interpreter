                                            Else
                                                TotLabSupAllOther = TotLabSupAllOther - CLABEMPS(ctry.Country)(SCount%, Unskilled) - CLABEMPS(ctry.Country)(SCount%, Skilled)
                                            End If
                                        Next SCount%

                                        NRatio = TotLabSupAllOther / AMAX(0.0000001, TotLabEmpAllOther)
                                        For SCount% = 1 To NSec%
