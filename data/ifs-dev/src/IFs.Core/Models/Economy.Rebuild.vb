            Friend Sub SaveIORegMatrix(Of T As {New, IGTAPIOAggReg, GTAPIOAggReg})(IOCountryMatrix As Dictionary(Of String, Single?(,)), cntx As IRebuildFacade, VarReg As Microsoft.EntityFrameworkCore.DbSet(Of T))
                '   Compute Regional Distribution Data
                '   ----------------------------------
                Dim RegWeight(NR) As Single, RegHold(NR) As Single
                Dim ValHold As Single?, RegionAverage As Single?
                Dim msg As String, ColumnName As String
                For reg% = 1 To NR

                    '   Put Into Cohort Field of Region Record
                    '   --------------------------------------------------------------------------
                    'Dim row As CohortRegion = New CohortRegion ' New cannot be used on a class that is MustInherit
                    'Dim row As PopAgeCohortRegionMale = New PopAgeCohortRegionMale
                    Dim row As T = New T()
                    row.Region = cntx.GetDimension(1).Buckets.Item(CShort(reg%))
                    row.Number = reg%

                    '       Compute regional weights
                    '       ------------------------
                    RegWeight(reg%) = 0

                    For Each ctry As KeyValuePair(Of String, Integer) In (From r In cntx.Regionalization Where r.Value = reg%)
                        RegWeight(reg%) = RegWeight(reg%) + CSng(CGDP(ctry.Key))
                    Next
                    If RegWeight(reg%) <= 0 Then
                        msg$ = "Important Warning:  No non-null members of Region "
                        msg$ = msg$ + cntx.GetDimension(1).Buckets.Item(CShort(reg%)) + " for IO computation "
