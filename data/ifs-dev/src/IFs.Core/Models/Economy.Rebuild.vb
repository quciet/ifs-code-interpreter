                        'Find lognormal distribution parameters, LNMean (mu) and lnstddev (sigma) using poverty rate at $1.9 poverty line
                        '-------------------------------------------------------------------------------
                        portionpoor = CSng(Amin(0.9, CINCOMELT19(key) / AMAX(0.0001, CPOP(key))))
                        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                        NInv = CalcNormalInverse(portionpoor)
                        LNMean = CSng(Log(365 * 1.9) - lnstddev * NInv)

                        'Find portionpoor for $3.2 line using the distribution parameters
                        '---------------------------------------------------------------
                        portionpoor = CalcLogNormalCDF(365 * 3.2, LNMean, lnstddev)
                        CINCOMELT32(key) = CSng(Amin(0.9 * CPOP(key), portionpoor * CPOP(key)))
                    End If 'end of If CINCOMELT32(key) < CINCOMELT19(key) Then

