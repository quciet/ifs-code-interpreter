                                    IFsUnskilled(LCount%) / AMAX(0.001F, IFsColSums(LCount%))
                                    IFsCoefSkilled(LCount%, matval) = IFsCoefSkilled(LCount%, matval) +
                                    IFsSkilled(LCount%) / AMAX(0.001F, IFsColSums(LCount%))

