                            sPartner = key2
                            'jrs 2024/12/19 added andalso
                            If sActor < sPartner AndAlso ExportsTbl.ContainsKey(sActor + ";" + sPartner) Then
                                CDistance(sActor).Add(sPartner, getYearOrEarliestWithinRange(ExportsTbl, yrs, sActor + ";" + sPartner, cntx.FirstYear, 20))
                                'jrs 2024/12/19
                                If Not CDistance.ContainsKey(sPartner) Then
                                    CDistance.Add(sPartner, New Dictionary(Of String, Single?))
                                End If

                                CDistance(sPartner).Add(sActor, CDistance(sActor)(sPartner))
                            End If
                        Next
                    Next
                Else
                    For Each item In (From s In cntx.GetSliceDyad("SeriesDistanceCEPII", cntx.BaseYear, CoalescePolicy.MostRecent) Select Key = s.Key, Value = s.Value)
                        sActor = item.Key.Split(";".ToCharArray)(0)
                        If Not CDistance.ContainsKey(sActor) Then
                            CDistance.Add(sActor, New Dictionary(Of String, Single?))
                        End If
                        sPartner = item.Key.Split(";".ToCharArray)(1)
                        If Not CDistance.ContainsKey(sPartner) Then
                            CDistance.Add(sPartner, New Dictionary(Of String, Single?))
                        End If
                        If sActor < sPartner Then
                            CDistance(sActor).Add(sPartner, item.Value)
                            CDistance(sPartner).Add(sActor, item.Value)
                        End If
                    Next
                End If

                'Fill holes for Distance
                '------------------------
                For Each key In cntx.Regionalization.Keys
                    For Each key2 In cntx.Regionalization.Keys
                        If key <> key2 Then
                            If CDistance.ContainsKey(key) Then
                                If CDistance(key).ContainsKey(key2) Then
                                    If Not CDistance(key)(key2).HasValue Then
                                        CDistance(key)(key2) = 20000
                                    End If
                                Else
                                    CDistance(key).Add(key2, 20000)
                                End If
                            Else
                                CDistance.Add(key, New Dictionary(Of String, Single?))
                                CDistance(key).Add(key2, 20000)
                            End If
                        End If
                    Next
                Next

                'jrs 2019/08/28 *** begin ***
                '2.  Load the CEPII Zeros Matrix (CZM) from data
                '-----------------------------------------------
                Dim CZM As Dictionary(Of String, Dictionary(Of String, Boolean()))
                CZM = New Dictionary(Of String, Dictionary(Of String, Boolean()))

                For Each keyi In cntx.Regionalization.Keys
                    CZM.Add(keyi, New Dictionary(Of String, Boolean()))
                    For Each keyj In cntx.Regionalization.Keys
                        If keyi <> keyj Then
                            Dim VarBoolVals(6) As Boolean
                            CZM(keyi).Add(keyj, VarBoolVals)
                            'jrs 2023/04/20
                            If CXDYADAGR.ContainsKey(keyi) AndAlso CXDYADAGR(keyi).ContainsKey(keyj) Then
                                CZM(keyi)(keyj)(1) = CBool(If(Not CXDYADAGR(keyi)(keyj).HasValue, False, CXDYADAGR(keyi)(keyj) = 0))
                            End If
                            If CXDYADENE.ContainsKey(keyi) AndAlso CXDYADENE(keyi).ContainsKey(keyj) Then
                                CZM(keyi)(keyj)(2) = CBool(If(Not CXDYADENE(keyi)(keyj).HasValue, False, CXDYADENE(keyi)(keyj) = 0))
                            End If
                            If CXDYADMAT.ContainsKey(keyi) AndAlso CXDYADMAT(keyi).ContainsKey(keyj) Then
                                CZM(keyi)(keyj)(3) = CBool(If(Not CXDYADMAT(keyi)(keyj).HasValue, False, CXDYADMAT(keyi)(keyj) = 0))
                            End If
                            If CXDYADMAN.ContainsKey(keyi) AndAlso CXDYADMAN(keyi).ContainsKey(keyj) Then
                                CZM(keyi)(keyj)(4) = CBool(If(Not CXDYADMAN(keyi)(keyj).HasValue, False, CXDYADMAN(keyi)(keyj) = 0))
                            End If
                            If CXDYADICT.ContainsKey(keyi) AndAlso CXDYADICT(keyi).ContainsKey(keyj) Then
                                CZM(keyi)(keyj)(5) = CBool(If(Not CXDYADICT(keyi)(keyj).HasValue, False, CXDYADICT(keyi)(keyj) = 0))
                            End If
                            If CXDYADSER.ContainsKey(keyi) AndAlso CXDYADSER(keyi).ContainsKey(keyj) Then
                                CZM(keyi)(keyj)(6) = CBool(If(Not CXDYADSER(keyi)(keyj).HasValue, False, CXDYADSER(keyi)(keyj) = 0))
                            End If
                        End If
                    Next
                Next

                '3.  Estimate the Gravity-Flows Matrix (GFM) using the gravity equation
                '----------------------------------------------------------------------
                Dim GFM As Dictionary(Of String, Dictionary(Of String, Single()))
                GFM = New Dictionary(Of String, Dictionary(Of String, Single()))
                Dim ValEst As Single
                For Each key In cntx.Regionalization.Keys
                    GFM.Add(key, New Dictionary(Of String, Single()))
                    For Each key2 In cntx.Regionalization.Keys
                        For k = 1 To NSec
                            If key <> key2 Then
                                If CZM.ContainsKey(key) AndAlso CZM(key).ContainsKey(key2) AndAlso CZM(key)(key2)(k) Then
                                    '4.  Merge the Trade-Flows Matrix and the Gravity-Flows Matrix with CEPII Zeros (there should be no replacements in the Trade-Flows Matrix)
                                    ValEst = 0
                                    Select Case k
                                        Case 1
                                            If Not CXDYADAGR.ContainsKey(key) Then
                                                CXDYADAGR.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADAGR(key).ContainsKey(key2) Then
                                                CXDYADAGR(key).Add(key2, 0)
                                            End If
                                        Case 2
                                            If Not CXDYADENE.ContainsKey(key) Then
                                                CXDYADENE.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADENE(key).ContainsKey(key2) Then
                                                CXDYADENE(key).Add(key2, 0)
                                            End If
                                        Case 3
                                            If Not CXDYADMAT.ContainsKey(key) Then
                                                CXDYADMAT.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADMAT(key).ContainsKey(key2) Then
                                                CXDYADMAT(key).Add(key2, 0)
                                            End If
                                        Case 4
                                            If Not CXDYADMAN.ContainsKey(key) Then
                                                CXDYADMAN.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADMAN(key).ContainsKey(key2) Then
                                                CXDYADMAN(key).Add(key2, 0)
                                            End If
                                        Case 5
                                            If Not CXDYADSER.ContainsKey(key) Then
                                                CXDYADSER.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADSER(key).ContainsKey(key2) Then
                                                CXDYADSER(key).Add(key2, 0)
                                            End If
                                        Case 6
                                            If Not CXDYADICT.ContainsKey(key) Then
                                                CXDYADICT.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADICT(key).ContainsKey(key2) Then
                                                CXDYADICT(key).Add(key2, 0)
                                            End If
                                    End Select
                                Else
                                    Call AnalFunc("Log of Bilateral Exports",
                                    New Single() {CSng(CGDP(key)), CSng(CGDP(key2)), CSng(CDistance(key)(key2)), CSng(CDYADTRADECOMPLEMENTTOT(key)(key2)), CSng(CDYADTARIFFRATETOT(key)(key2))}, ValEst,
                                    New String() {"GDP_A", "GDP_B", "DISTANCE", "TCIEXAIMBALLGOODS", "TARIFFALLGOODS"}, cntx)
                                    ValEst = CSng(Exp(Amin(ValEst, 709)))
                                End If
                                If Not GFM(key).ContainsKey(key2) Then
                                    Dim VarVals(NSec) As Single
                                    GFM(key).Add(key2, VarVals)
                                End If
                                GFM(key)(key2)(k) = ValEst
                            End If
                        Next k
                    Next
                Next
                '5.  Estimate the Gravity-Shares matrix from Gravity-Flows Matrix (with zeros)
                Dim GSM As Dictionary(Of String, Dictionary(Of String, Single()))
                GSM = New Dictionary(Of String, Dictionary(Of String, Single()))
                Dim rowTot As Single
                For Each key In cntx.Regionalization.Keys
                    GSM.Add(key, New Dictionary(Of String, Single()))
                    For k = 1 To NSec
                        rowTot = 0
                        For Each key2 In GFM(key).Keys
                            rowTot = rowTot + GFM(key)(key2)(k)
                            If Not GSM(key).ContainsKey(key2) Then
                                Dim VarVals(NSec) As Single
                                GSM(key).Add(key2, VarVals)
                            End If
                        Next
                        If rowTot > 0 Then
                            For Each key2 In GFM(key).Keys
                                GSM(key)(key2)(k) = GFM(key)(key2)(k) / rowTot
                            Next
                        End If
                    Next k
                Next
                '6.  Estimate the Trade-Shares Matrix from Trade-Flows Matrix (with zeros) using the above procedure
                Dim TSM As Dictionary(Of String, Dictionary(Of String, Single()))
                TSM = New Dictionary(Of String, Dictionary(Of String, Single()))
                Dim rowSUM As Dictionary(Of String, Single())
                rowSUM = New Dictionary(Of String, Single())
                For Each key In cntx.Regionalization.Keys
                    TSM.Add(key, New Dictionary(Of String, Single()))
                    Dim VarSums(NSec) As Single
                    rowSUM.Add(key, VarSums)
                    For k = 1 To NSec
                        rowTot = 0
                        Select Case k
                            Case 1
                                For Each key2 In cntx.Regionalization.Keys
                                    Dim VarVals(NSec) As Single
                                    TSM(key).Add(key2, VarVals)
                                Next

                                If CXDYADAGR.ContainsKey(key) Then
                                    For Each key2 In CXDYADAGR(key).Keys
                                        rowTot = rowTot + CSng(If(CXDYADAGR(key)(key2), 0))
                                    Next
                                    If rowTot > 0 Then
                                        For Each key2 In CXDYADAGR(key).Keys
                                            If CXDYADAGR(key)(key2).HasValue Then
                                                TSM(key)(key2)(k) = CSng(CXDYADAGR(key)(key2) / rowTot)
                                            End If
                                        Next
                                    End If
                                End If
                            Case 2
                                If CXDYADENE.ContainsKey(key) Then
                                    For Each key2 In CXDYADENE(key).Keys
                                        rowTot = rowTot + CSng(If(CXDYADENE(key)(key2), 0))
                                    Next
                                    If rowTot > 0 Then
                                        For Each key2 In CXDYADENE(key).Keys
                                            If CXDYADENE(key)(key2).HasValue Then
                                                TSM(key)(key2)(k) = CSng(CXDYADENE(key)(key2) / rowTot)
                                            End If
                                        Next
                                    End If
                                End If
                            Case 3
                                If CXDYADMAT.ContainsKey(key) Then
                                    For Each key2 In CXDYADMAT(key).Keys
                                        rowTot = rowTot + CSng(If(CXDYADMAT(key)(key2), 0))
                                    Next
                                    If rowTot > 0 Then
                                        For Each key2 In CXDYADMAT(key).Keys
                                            If CXDYADMAT(key)(key2).HasValue Then
                                                TSM(key)(key2)(k) = CSng(CXDYADMAT(key)(key2) / rowTot)
                                            End If
                                        Next
                                    End If
                                End If
                            Case 4
                                If CXDYADMAN.ContainsKey(key) Then
                                    For Each key2 In CXDYADMAN(key).Keys
                                        rowTot = rowTot + CSng(If(CXDYADMAN(key)(key2), 0))
                                    Next
                                    If rowTot > 0 Then
                                        For Each key2 In CXDYADMAN(key).Keys
                                            If CXDYADMAN(key)(key2).HasValue Then
                                                TSM(key)(key2)(k) = CSng(CXDYADMAN(key)(key2) / rowTot)
                                            End If
                                        Next
                                    End If
                                End If
                            Case 5
                                If CXDYADSER.ContainsKey(key) Then
                                    For Each key2 In CXDYADSER(key).Keys
                                        rowTot = rowTot + CSng(If(CXDYADSER(key)(key2), 0))
                                    Next
                                    If rowTot > 0 Then
                                        For Each key2 In CXDYADSER(key).Keys
                                            If CXDYADSER(key)(key2).HasValue Then
                                                TSM(key)(key2)(k) = CSng(CXDYADSER(key)(key2) / rowTot)
                                            End If
                                        Next
                                    End If
                                End If
                            Case 6
                                If CXDYADICT.ContainsKey(key) Then
                                    For Each key2 In CXDYADICT(key).Keys
                                        rowTot = rowTot + CSng(If(CXDYADICT(key)(key2), 0))
                                    Next
                                    If rowTot > 0 Then
                                        For Each key2 In CXDYADICT(key).Keys
                                            If CXDYADICT(key)(key2).HasValue Then
                                                TSM(key)(key2)(k) = CSng(CXDYADICT(key)(key2) / rowTot)
                                            End If
                                        Next
                                    End If
                                End If
                        End Select
                        rowSUM(key)(k) = rowTot
                    Next k
                Next
                '7.  Calculate the Export Adjustment Value (XSAdjVal) by subtracting the row-sum of the Trade-Flows Matrix from XS
                Dim XSAdjVal As Dictionary(Of String, Single())
                XSAdjVal = New Dictionary(Of String, Single())
                For Each key In cntx.Regionalization.Keys
                    Dim VarVals(NSec) As Single
                    XSAdjVal.Add(key, VarVals)
                    For k = 1 To NSec
                        XSAdjVal(key)(k) = CSng(CXS(key)(k) * 1000000000 - rowSUM(key)(k))
                    Next k
                Next

                '8.  Calculate the Export Adjustment Share (XSAdjShr) by dividing XSAdjVal by XS
                Dim XSAdjShr As Dictionary(Of String, Single())
                XSAdjShr = New Dictionary(Of String, Single())
                For Each key In cntx.Regionalization.Keys
                    Dim VarVals(NSec) As Single
                    XSAdjShr.Add(key, VarVals)
                    For k = 1 To NSec
                        If CXS(key)(k) > 0 Then
                            XSAdjShr(key)(k) = CSng(XSAdjVal(key)(k) / (CXS(key)(k) * 1000000000))
                        End If
                    Next k
                Next

                'Filling Holes
                '=============
                Dim NullShares As Dictionary(Of String, Single())
                NullShares = New Dictionary(Of String, Single())

                For Each key In cntx.Regionalization.Keys
                    'jrs 2024/11/25 For Serbia the sum of Bilateral data was $44 Million, while the Monadic estimation of exports was $4 Billion
                    'Not trying to consolidate anymore
                    Exit For

                    Dim VarVals(NSec) As Single
                    NullShares.Add(key, VarVals)
                    For k = 1 To NSec
                        'If key = "Serbia" And k = 2 Then Stop

                        '2.  If XSAdjVal is negative: Distribute XSAdjVal across Trade-Flows (rows) according to Trade-Shares values, treating nulls as zeros.
                        'This will reduce all (non-zero, non-null) Trade-Flows values
                        If XSAdjVal(key)(k) < 0 Then
                            'jrs 2020/05/22 added AMAX to avoid negatives
                            Select Case k
                                Case 1
                                    For Each key2 In cntx.Regionalization.Keys
                                        If Not CXDYADAGR(key).ContainsKey(key2) Then
                                            CXDYADAGR(key).Add(key2, 0)
                                        End If
                                        CXDYADAGR(key)(key2) = AMAX(CXDYADAGR(key)(key2) + TSM(key)(key2)(k) * XSAdjVal(key)(k), 0)
                                    Next
                                Case 2
                                    For Each key2 In cntx.Regionalization.Keys
                                        If Not CXDYADENE(key).ContainsKey(key2) Then
                                            CXDYADENE(key).Add(key2, 0)
                                        End If
                                        CXDYADENE(key)(key2) = AMAX(CXDYADENE(key)(key2) + TSM(key)(key2)(k) * XSAdjVal(key)(k), 0)
                                    Next
                                Case 3
                                    For Each key2 In cntx.Regionalization.Keys
                                        If Not CXDYADMAT(key).ContainsKey(key2) Then
                                            CXDYADMAT(key).Add(key2, 0)
                                        End If
                                        CXDYADMAT(key)(key2) = AMAX(CXDYADMAT(key)(key2) + TSM(key)(key2)(k) * XSAdjVal(key)(k), 0)
                                    Next
                                Case 4
                                    For Each key2 In cntx.Regionalization.Keys
                                        If Not CXDYADMAN(key).ContainsKey(key2) Then
                                            CXDYADMAN(key).Add(key2, 0)
                                        End If
                                        CXDYADMAN(key)(key2) = AMAX(CXDYADMAN(key)(key2) + TSM(key)(key2)(k) * XSAdjVal(key)(k), 0)
                                    Next
                                Case 5
                                    For Each key2 In cntx.Regionalization.Keys
                                        If Not CXDYADSER(key).ContainsKey(key2) Then
                                            CXDYADSER(key).Add(key2, 0)
                                        End If
                                        CXDYADSER(key)(key2) = AMAX(CXDYADSER(key)(key2) + TSM(key)(key2)(k) * XSAdjVal(key)(k), 0)
                                    Next
                                Case 6
                                    For Each key2 In cntx.Regionalization.Keys
                                        If Not CXDYADICT(key).ContainsKey(key2) Then
                                            CXDYADICT(key).Add(key2, 0)
                                        End If
                                        CXDYADICT(key)(key2) = AMAX(CXDYADICT(key)(key2) + TSM(key)(key2)(k) * XSAdjVal(key)(k), 0)
                                    Next
                            End Select
                        ElseIf XSAdjVal(key)(k) > 0 Then     '3.  Else, calculate Null Shares (NullShr) as the sum of Gravity-Shares values
                            rowTot = 0
                            Select Case k
                                Case 1
                                    For Each key2 In GSM(key).Keys
                                        If Not CXDYADAGR.ContainsKey(key) OrElse Not CXDYADAGR(key).ContainsKey(key2) OrElse Not CXDYADAGR(key)(key2).HasValue Then
                                            NullShares(key)(k) = NullShares(key)(k) + GSM(key)(key2)(k)
                                        End If
                                    Next
                                    '4.1.  If NullShr > XSAdjShr
                                    If NullShares(key)(k) > XSAdjShr(key)(k) Then
                                        For Each key2 In GSM(key).Keys
                                            '4.  If corresponding Trade-Flows values are null
                                            If Not CXDYADAGR.ContainsKey(key) Then
                                                CXDYADAGR.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADAGR(key).ContainsKey(key2) OrElse Not CXDYADAGR(key)(key2).HasValue Then
                                                '4.1.1.  Distribute all of XSAdjVal across "null" Trade-Flows values according to their corresponding Gravity-Shares values after normalizing so that the sum of "null" Gravity-Shares equals 1. For example, for Ctry1, since NullShr > XSAdjShr, normalize the two "null" Gravity-Shares elements (0.25 and 0.4) so that they equal 1. Instead of normalizing each Gravity-Shares element, I have represented this operation instead by taking the inverse of the NullShr, but it could also be done on the Gravity-Shares elements. Then distribute XSAdjVal.
                                                CXDYADAGR(key)(key2) = XSAdjVal(key)(k) * GSM(key)(key2)(k) / NullShares(key)(k)
                                            End If
                                        Next
                                    Else     '4.2.  If NullShr < XSAdjShr
                                        For Each key2 In GSM(key).Keys
                                            If Not CXDYADAGR.ContainsKey(key) Then
                                                CXDYADAGR.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            '4.  If corresponding Trade-Flows values are null
                                            If Not CXDYADAGR(key).ContainsKey(key2) OrElse Not CXDYADAGR(key)(key2).HasValue Then
                                                '4.2.1.  Distribute the product of XSAdjVal and NullShr across "null" Trade-Flows values according to their corresponding Gravity-Shares values.
                                                CXDYADAGR(key)(key2) = XSAdjVal(key)(k) * NullShares(key)(k) * GSM(key)(key2)(k)
                                            End If
                                        Next
                                        '4.2.2.  Reestimate a Trade-Shares matrix from the current Adjusted Trade-Flows Matrix
                                        For Each key2 In CXDYADAGR(key).Keys
                                            rowTot = rowTot + CSng(If(CXDYADAGR(key)(key2), 0))
                                        Next
                                        If rowTot > 0 Then
                                            For Each key2 In CXDYADAGR(key).Keys
                                                If CXDYADAGR(key)(key2).HasValue Then
                                                    TSM(key)(key2)(k) = CSng(CXDYADAGR(key)(key2) / rowTot)
                                                End If
                                            Next
                                        End If
                                        '4.2.3.  Distribute the remaining value of XSAdjVal according to the Reestiamted Trade-Shares Matrix
                                        For Each key2 In TSM(key).Keys
                                            If Not CXDYADAGR(key).ContainsKey(key2) Then
                                                CXDYADAGR(key).Add(key2, 0)
                                            End If
                                            CXDYADAGR(key)(key2) = CXDYADAGR(key)(key2) + XSAdjVal(key)(k) * (1 - NullShares(key)(k)) * TSM(key)(key2)(k)
                                        Next
                                    End If
                                Case 2
                                    For Each key2 In GSM(key).Keys
                                        If Not CXDYADENE.ContainsKey(key) OrElse Not CXDYADENE(key).ContainsKey(key2) OrElse Not CXDYADENE(key)(key2).HasValue Then
                                            NullShares(key)(k) = NullShares(key)(k) + GSM(key)(key2)(k)
                                        End If
                                    Next
                                    '4.1.  If NullShr > XSAdjShr
                                    If NullShares(key)(k) > XSAdjShr(key)(k) Then
                                        For Each key2 In GSM(key).Keys
                                            '4.  If corresponding Trade-Flows values are null
                                            If Not CXDYADENE.ContainsKey(key) Then
                                                CXDYADENE.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADENE(key).ContainsKey(key2) OrElse Not CXDYADENE(key)(key2).HasValue Then
                                                '4.1.1.  Distribute all of XSAdjVal across "null" Trade-Flows values according to their corresponding Gravity-Shares values after normalizing so that the sum of "null" Gravity-Shares equals 1. For example, for Ctry1, since NullShr > XSAdjShr, normalize the two "null" Gravity-Shares elements (0.25 and 0.4) so that they equal 1. Instead of normalizing each Gravity-Shares element, I have represented this operation instead by taking the inverse of the NullShr, but it could also be done on the Gravity-Shares elements. Then distribute XSAdjVal.
                                                CXDYADENE(key)(key2) = XSAdjVal(key)(k) * GSM(key)(key2)(k) / NullShares(key)(k)
                                            End If
                                        Next
                                    Else     '4.2.  If NullShr < XSAdjShr
                                        For Each key2 In GSM(key).Keys
                                            If Not CXDYADENE.ContainsKey(key) Then
                                                CXDYADENE.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            '4.  If corresponding Trade-Flows values are null
                                            If Not CXDYADENE(key).ContainsKey(key2) OrElse Not CXDYADENE(key)(key2).HasValue Then
                                                '4.2.1.  Distribute the product of XSAdjVal and NullShr across "null" Trade-Flows values according to their corresponding Gravity-Shares values.
                                                CXDYADENE(key)(key2) = XSAdjVal(key)(k) * NullShares(key)(k) * GSM(key)(key2)(k)
                                            End If
                                        Next
                                        '4.2.2.  Reestimate a Trade-Shares matrix from the current Adjusted Trade-Flows Matrix
                                        For Each key2 In CXDYADENE(key).Keys
                                            rowTot = rowTot + CSng(If(CXDYADENE(key)(key2), 0))
                                        Next
                                        If rowTot > 0 Then
                                            For Each key2 In CXDYADENE(key).Keys
                                                If CXDYADENE(key)(key2).HasValue Then
                                                    TSM(key)(key2)(k) = CSng(CXDYADENE(key)(key2) / rowTot)
                                                End If
                                            Next
                                        End If
                                        '4.2.3.  Distribute the remaining value of XSAdjVal according to the Reestiamted Trade-Shares Matrix
                                        For Each key2 In TSM(key).Keys
                                            If Not CXDYADENE(key).ContainsKey(key2) Then
                                                CXDYADENE(key).Add(key2, 0)
                                            End If
                                            CXDYADENE(key)(key2) = CXDYADENE(key)(key2) + XSAdjVal(key)(k) * (1 - NullShares(key)(k)) * TSM(key)(key2)(k)
                                        Next
                                    End If
                                Case 3
                                    For Each key2 In GSM(key).Keys
                                        If Not CXDYADMAT.ContainsKey(key) OrElse Not CXDYADMAT(key).ContainsKey(key2) OrElse Not CXDYADMAT(key)(key2).HasValue Then
                                            NullShares(key)(k) = NullShares(key)(k) + GSM(key)(key2)(k)
                                        End If
                                    Next
                                    '4.1.  If NullShr > XSAdjShr
                                    If NullShares(key)(k) > XSAdjShr(key)(k) Then
                                        For Each key2 In GSM(key).Keys
                                            '4.  If corresponding Trade-Flows values are null
                                            If Not CXDYADMAT.ContainsKey(key) Then
                                                CXDYADMAT.Add(key, New Dictionary(Of String, Single?))
                                            End If
                                            If Not CXDYADMAT(key).ContainsKey(key2) OrElse Not CXDYADMAT(key)(key2).HasValue Then
                                                '4.1.1.  Distribute all of XSAdjVal across "null" Trade-Flows values according to their corresponding Gravity-Shares values after normalizing so that the sum of "null" Gravity-Shares equals 1. For example, for Ctry1, since NullShr > XSAdjShr, normalize the two "null" Gravity-Shares elements (0.25 and 0.4) so that they equal 1. Instead of normalizing each Gravity-Shares element, I have represented this operation instead by taking the inverse of the NullShr, but it could also be done on the Gravity-Shares elements. Then distribute XSAdjVal.
                                                CXDYADMAT(key)(key2) = XSAdjVal(key)(k) * GSM(key)(key2)(k) / NullShares(key)(k)
                                            End If
                                        Next
