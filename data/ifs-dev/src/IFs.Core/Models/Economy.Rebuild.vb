            Private Sub ReadPovRateAGEU(key As String, DatTbl2 As IEnumerable(Of PovAgeSexCtry60EU), sTblName As String,
                                      PovRateArr As Dictionary(Of String, Dictionary(Of Integer, Single?)),
                                      PopPovArr As Dictionary(Of String, Dictionary(Of Integer, Single?)),
                                      agStart As Integer(), agEnd As Integer(), PovRateAgeMult As Single?(),
                                      NatPovPcnt As Single?, Optional AGAgg As Boolean = True)
                'mti 2021/10/15 new Proc

                '
                Dim DatTbl As PovAgeSexCtry60EU
                DatTbl = DatTbl2.Where(Function(g) g.Country = key).Single()
                Dim AGNameAgg As Boolean = False
                AGNameAgg = True      'EU tables for Med50 -> NPL needs to be chacked by AgeGroup Names

                Dim TotFld = 11
                Dim val As Single?, FldName As String, FldPart1 As String, FldPart2 As String
                Dim AgNme As String, AgNme1 As String, AgNme2 As String
                Dim PopAGCount As Single, PcntRate As Single?, PopTot As Single?
                Dim AGCount As Integer

                For FldCount = 1 To TotFld
                    Select Case FldCount
                        Case 1
                            val = DatTbl.a0_4
                            FldName = "0-4"
                            FldPart1 = "0"
                            FldPart2 = "4"
                        Case 2
                            val = DatTbl.a5_9
                            FldName = "5-9"
                            FldPart1 = "5"
                            FldPart2 = "9"
                        Case 3
                            val = DatTbl.a10_14
                            FldName = "10-14"
                            FldPart1 = "10"
                            FldPart2 = "14"
                        Case 4
                            val = DatTbl.a15_24
                            FldName = "15-24"
                            FldPart1 = "15"
                            FldPart2 = "24"
                        Case 5
                            val = DatTbl.a25_34
                            FldName = "25-34"
                            FldPart1 = "25"
                            FldPart2 = "34"
                        Case 6
                            val = DatTbl.a35_39
                            FldName = "35_39"
                            FldPart1 = "35"
                            FldPart2 = "39"
                        Case 7
                            val = DatTbl.a40_44
                            FldName = "40-44"
                            FldPart1 = "40"
                            FldPart2 = "44"
                        Case 8
                            val = DatTbl.a45_49
                            FldName = "45-49"
                            FldPart1 = "45"
                            FldPart2 = "49"
                        Case 9
                            val = DatTbl.a50_54
                            FldName = "50-54"
                            FldPart1 = "50"
                            FldPart2 = "54"
                        Case 10
                            val = DatTbl.a55_59
                            FldName = "55-59"
                            FldPart1 = "55"
                            FldPart2 = "59"
                        Case 11
                            val = DatTbl.a60andOver
                            FldName = "60 and over"
                            FldPart1 = ""
                            FldPart2 = ""
                    End Select
                    If Not val.HasValue Then Exit For

                    For AGCount = 1 To TotPovAGCount% - 1
                        AgNme = AGName(AGCount)
                        If FldName.Trim.ToUpper = AgNme.Trim.ToUpper Then 'match or 60 and over
                            PovRateArr(key)(AGCount) = val
                            Exit For

                        ElseIf FldName.IndexOf("-") > 0 Then '45-49 etc

                            If AgNme.IndexOf("-") > 0 Then
                                'AgNme1 = Left(AgNme, InStr(AgNme, "-") - 1)
                                AgNme1 = AgNme.Substring(0, AgNme.IndexOf("-") - 1)
                                'AgNme2 = Right(AgNme, Len(AgNme) - InStr(AgNme, "-"))
                                AgNme2 = AgNme.Substring(AgNme.IndexOf("-"))

                                If FldPart1 = AgNme1 And CInt(FldPart1) Mod 5 = 0 And CInt(FldPart1) <> 0 Then

                                    PopAGCount = CSng(CInt(FldPart1) / 5)
                                    PcntRate = val
                                    PopTot = cagedstM(key)("Cohort" & PopAGCount.ToString) + cagedstF(key)("Cohort" & PopAGCount.ToString)
                                    If Not PovRateArr(key)(AGCount).HasValue Then PovRateArr(key)(AGCount) = 0
                                    PovRateArr(key)(AGCount) = PovRateArr(key)(AGCount) _
                                        + PopTot * PcntRate / 100
                                    Exit For
                                ElseIf FldPart2 = AgNme2 And (CInt(FldPart2) + 1) Mod 5 = 0 And CInt(FldPart2) <> 0 Then

                                    PopAGCount = CSng((CInt(FldPart2) + 1) / 5)
                                    PcntRate = val
                                    PopTot = cagedstM(key)("Cohort" + PopAGCount.ToString) + cagedstF(key)("Cohort" & PopAGCount.ToString)
                                    PovRateArr(key)(AGCount) = PovRateArr(key)(AGCount) _
                                        + PopTot * PcntRate / 100
                                    PovRateArr(key)(AGCount) = CSng(100 * PovRateArr(key)(AGCount) / AMAX(0.000001, PopPovArr(key)(AGCount)))
                                    Exit For
                                End If
                            End If



                        End If


                    Next
                Next



            End Sub

