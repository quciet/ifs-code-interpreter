        Public Iterator Function RebuildEco(context As IRebuildContext) As IEnumerable(Of IDataframe)
            'jrs 2020/08/19 removed temporarily while we get better data
            '<RebuildsVariable("aidlp", AggregatorType:=GetType(EconomicAggregator))>

            Yield context.Query("AGMVALUE").Filter(BaseYearOnly).Execute()
            Yield context.Query("AGXVALUE").Filter(BaseYearOnly).Execute()
            Yield context.Query("XDEBTRPA").Filter(BaseYearOnly).Execute()
            Yield context.Query("GOVEXP").Filter(BaseYearOnly).Execute()

            Dim dfTmp As IDataframe = context.Query("GOVCONLOCAL").Filter(BaseYearOnly).Execute()
            Dim dfGOVCONLOCAL As Dataframe = Dataframe.Create("GOVCONLOCAL", context, context.FirstYear, context.LastYear, Nothing)
            Dim tmpIdx As Integer
            Dim R As Short
            For R = 1 To CShort(NR)
                tmpIdx = getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR))
                For y = FirstYear To LastYear
                    dfGOVCONLOCAL(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(tmpIdx)
                Next
            Next
            Yield dfGOVCONLOCAL

            dfTmp = context.Query("GOVREVLOCAL").Filter(BaseYearOnly).Execute()
            Dim dfGOVREVLOCAL As Dataframe = Dataframe.Create("GOVREVLOCAL", context, context.FirstYear, context.LastYear, Nothing)
            For R = 1 To CShort(NR)
                tmpIdx = getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR))
                For y = FirstYear To LastYear
                    dfGOVREVLOCAL(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(tmpIdx)
                Next
            Next
            Yield dfGOVREVLOCAL

            dfTmp = context.Query("GOVEXPLOCAL").Filter(BaseYearOnly).Execute()
            Dim dfGOVEXPLOCAL As Dataframe = Dataframe.Create("GOVEXPLOCAL", context, context.FirstYear, context.LastYear, Nothing)
            For R = 1 To CShort(NR)
                tmpIdx = getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR))
                For y = FirstYear To LastYear
                    dfGOVEXPLOCAL(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(tmpIdx)
                Next
            Next
            Yield dfGOVEXPLOCAL

            Yield context.Query("XFIRMDEBT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XGOVTDEBT").Filter(BaseYearOnly).Execute()

            dfTmp = context.Query("GOVTDEBTD").Filter(BaseYearOnly).Execute()
            Dim dfGOVTDEBTD As Dataframe = Dataframe.Create("GOVTDEBTD", context, context.FirstYear, context.LastYear, Nothing)
            For R = 1 To CShort(NR)
                tmpIdx = getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR))
                For y = FirstYear To LastYear
                    dfGOVTDEBTD(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(tmpIdx)
                Next
            Next
            Yield dfGOVTDEBTD

            Yield context.Query("XGOVTDEBTB").Filter(BaseYearOnly).Execute()

            Yield context.Query("GOVHHPENT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XFDISTOCK").Filter(BaseYearOnly).Execute()
            Yield context.Query("XFDISTOUT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XFDIFIN").Filter(BaseYearOnly).Execute()
            Yield context.Query("XFDIFOUT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XPORTFIN").Filter(BaseYearOnly).Execute()
            Yield context.Query("XPORTFOUT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XPORTFOLIO").Filter(BaseYearOnly).Execute()
            Yield context.Query("XPORTSTOUT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XWBLOANS").Filter(BaseYearOnly).Execute()
            Yield context.Query("XWBSUBF").Filter(BaseYearOnly).Execute()
            Yield context.Query("XIMFSUBF").Filter(BaseYearOnly).Execute()
            Yield context.Query("XWBLNFIN").Filter(BaseYearOnly).Execute()
            dfTmp = context.Query("XWBLNFOUT").Filter(BaseYearOnly).Execute()
            Dim dfXWBLNFOUT As Dataframe = Dataframe.Create("XWBLNFOUT", context, context.FirstYear, context.LastYear, Nothing)
            For R = 1 To CShort(NR)
                tmpIdx = getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR))
                For y = FirstYear To LastYear
                    dfXWBLNFOUT(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(tmpIdx)
                Next
            Next
            Yield dfXWBLNFOUT

            Yield context.Query("XIMFCREDIT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XIMFCRFIN").Filter(BaseYearOnly).Execute()
            dfTmp = context.Query("XIMFCRFOUT").Filter(BaseYearOnly).Execute()
            Dim dfXIMFCRFOUT As Dataframe = Dataframe.Create("XIMFCRFOUT", context, context.FirstYear, context.LastYear, Nothing)
            For R = 1 To CShort(NR)
                tmpIdx = getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR))
                For y = FirstYear To LastYear
                    dfXIMFCRFOUT(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(tmpIdx)
                Next
            Next
            Yield dfXIMFCRFOUT

            'bbh 2022/04/22 *** start ***
            Yield context.Query("CURACTDATATOP").Filter(BaseYearOnly).Execute()
            Yield context.Query("CURACTDATABOTTOM").Filter(BaseYearOnly).Execute()
            Yield context.Query("CURACTNETPRI").Filter(BaseYearOnly).Execute()
            Yield context.Query("CURACTNETSEC").Filter(BaseYearOnly).Execute()
            'bbh 2022/04/22 *** end ***

            'bbh 2022/06/23
            Yield context.Query("XNFA").Filter(BaseYearOnly).Execute()
            Yield context.Query("XNIIP").Filter(BaseYearOnly).Execute()

            Yield context.Query("INCOMELT125CS2005").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT200CS2005").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT190LN").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT310LN").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT320LN").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT550LN").Filter(BaseYearOnly).Execute()
            'jrs 2022/11/17 *** start ***
            Yield context.Query("INCOMELT215LN").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT365LN").Filter(BaseYearOnly).Execute()
            Yield context.Query("INCOMELT685LN").Filter(BaseYearOnly).Execute()
            'jrs 2022/11/17 *** end ***
            'jrs 2025/09/12 *** start ***
            Yield context.Query("POVEXTREME").Filter(BaseYearOnly).Execute()
            Yield context.Query("POVMIDLOW").Filter(BaseYearOnly).Execute()
            Yield context.Query("POVMIDHIGH").Filter(BaseYearOnly).Execute()
            'jrs 2025/09/12 *** end ***
            Yield context.Query("INCOMELTNPLLN").Filter(BaseYearOnly).Execute()
            'jrs 2022/11/23
            dfTmp = context.Query("povnational").Filter(BaseYearOnly).Execute()
            Dim dfpovnational As Dataframe = Dataframe.Create("povnational", context, context.FirstYear, context.LastYear, 0)
            For y = FirstYear To LastYear
                For R = 1 To CShort(NR)
                    dfpovnational(getDataFrameIdxFromDims(y, FirstYear, R, CShort(NR))) = dfTmp(getDataFrameIdxFromDims(FirstYear, FirstYear, R, CShort(NR)))
                Next
            Next
            Yield dfpovnational

            Yield context.Query("POVGAP").Filter(BaseYearOnly).Execute()
            Yield context.Query("POVGAP32").Filter(BaseYearOnly).Execute()
            Yield context.Query("POVGAP55").Filter(BaseYearOnly).Execute()
            'jrs 2022/11/21 start
            Yield context.Query("POVGAP365").Filter(BaseYearOnly).Execute()
            Yield context.Query("POVGAP685").Filter(BaseYearOnly).Execute()
            'jrs 2022/11/21 end
            'jrs 2025/09/15 start
            Yield context.Query("POVGAP420").Filter(BaseYearOnly).Execute()
            Yield context.Query("POVGAP830").Filter(BaseYearOnly).Execute()
            'jrs 2025/09/15 end
            Yield context.Query("XWORKREMIT").Filter(BaseYearOnly).Execute()
            Yield context.Query("XWORKREMITIN").Filter(BaseYearOnly).Execute()
            Yield context.Query("XWORKREMITOUT").Filter(BaseYearOnly).Execute()
            dfTmp = context.Query("XFINUNEXP").Filter(BaseYearOnly).Execute()
            Dim dfXFINUNEXP As Dataframe = Dataframe.Create("XFINUNEXP", context, context.FirstYear, context.LastYear, 0)
