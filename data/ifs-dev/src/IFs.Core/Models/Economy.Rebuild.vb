                CXFinUnexp = New Dictionary(Of String, Single?)
                CHHTaxRUnskilled = New Dictionary(Of String, Single?)
                CHHTaxRSkilled = New Dictionary(Of String, Single?)

                GDPGRBal = New Dictionary(Of String, Single?)

                CGDPR = New Dictionary(Of String, Single?())
                GDPRYEXT = New Dictionary(Of Integer, Single?())

                CIGDPR = New Dictionary(Of String, Single?)
                CINTR = New Dictionary(Of String, Single?)
                CGINIDOM = New Dictionary(Of String, Single?)
                CINCOMELT1 = New Dictionary(Of String, Single?)
                CINCOMELT2 = New Dictionary(Of String, Single?)
                CINCOMELT19 = New Dictionary(Of String, Single?)
                CINCOMELT31 = New Dictionary(Of String, Single?)
                CPOVGAP = New Dictionary(Of String, Single?)

                'mti 2021/06/30 start
                CPOVGAP32 = New Dictionary(Of String, Single?)
                CPOVGAP55 = New Dictionary(Of String, Single?)
                'mti 2021/06/30 End

                'jrs 2022/11/10
                CINCOMELT215 = New Dictionary(Of String, Single?)
                CINCOMELT365 = New Dictionary(Of String, Single?)
                CINCOMELT685 = New Dictionary(Of String, Single?)

                'jrs 2025/09/12
                CINCOMELT300 = New Dictionary(Of String, Single?)
                CINCOMELT420 = New Dictionary(Of String, Single?)
                CINCOMELT830 = New Dictionary(Of String, Single?)

                'jrs 2022/11/21
                CPOVGAP365 = New Dictionary(Of String, Single?)
                CPOVGAP685 = New Dictionary(Of String, Single?)

                'jrs 2025/09/15
                CPOVGAP420 = New Dictionary(Of String, Single?)
                CPOVGAP830 = New Dictionary(Of String, Single?)

                CCS = New Dictionary(Of String, Single?())
                CGS = New Dictionary(Of String, Single?())
                CINVS = New Dictionary(Of String, Single?())
                CMS = New Dictionary(Of String, Single?())
                CXS = New Dictionary(Of String, Single?())
                CPFD = New Dictionary(Of String, Single?())
                CZS = New Dictionary(Of String, Single?())
                CVADD = New Dictionary(Of String, Single?())

                EnMul = New Dictionary(Of String, Single?)
                IOMatMul = New Dictionary(Of String, Single?())

                FIPSCodes = New Dictionary(Of String, String)

                CCGDP = New Dictionary(Of String, Single?)

                CPOVRATEMALE = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEFEMALE = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEBOTHSEXES = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVGNDRATIO = New Dictionary(Of String, Dictionary(Of Integer, Single?))

                ReDim POVRATEMALE(NR, TotPovAGCount), POVRATEFEMALE(NR, TotPovAGCount), POVRATEBOTHSEXES(NR, TotPovAGCount)
                ReDim POVGNDRATIO(NR, TotPovAGCount)
                'mti 2021/01/29
                ReDim POVGNDRATIO32(NR, TotPovAGCount), POVGNDRATIO55(NR, TotPovAGCount)
                'mti 2021/07/15
                ReDim POVGNDRATIONPL(NR, TotPovAGCount)

                CPopPovAGFemale = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPopPovAGMale = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPopPovAGBothSexes = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                ReDim PopPovAGFemale(NR, TotPovAGCount), PopPovAGMale(NR, TotPovAGCount)

                'mti 2021/01/29 start
                CINCOMELT32 = New Dictionary(Of String, Single?)

                CPOVRATEMALE32 = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEFEMALE32 = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEBOTHSEXES32 = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVGNDRATIO32 = New Dictionary(Of String, Dictionary(Of Integer, Single?))

                ReDim POVRATEMALE32(NR, TotPovAGCount), POVRATEFEMALE32(NR, TotPovAGCount), POVRATEBOTHSEXES32(NR, TotPovAGCount)

                CINCOMELT55 = New Dictionary(Of String, Single?)

                CPOVRATEMALE55 = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEFEMALE55 = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEBOTHSEXES55 = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVGNDRATIO55 = New Dictionary(Of String, Dictionary(Of Integer, Single?))

                ReDim POVRATEMALE55(NR, TotPovAGCount), POVRATEFEMALE55(NR, TotPovAGCount), POVRATEBOTHSEXES55(NR, TotPovAGCount)

                'mti 2021/01/29 End

                'mti 2021/07/15 start
                CPOVGAPNPL = New Dictionary(Of String, Single?)
                CINCOMELTNPL = New Dictionary(Of String, Single?)
                CPOVRATEMALENPL = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEFEMALENPL = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVRATEBOTHSEXESNPL = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                CPOVGNDRATIONPL = New Dictionary(Of String, Dictionary(Of Integer, Single?))
                Cpovnational = New Dictionary(Of String, Single?)

                ReDim POVRATEMALENPL(NR, TotPovAGCount), POVRATEFEMALENPL(NR, TotPovAGCount), POVRATEBOTHSEXESNPL(NR, TotPovAGCount)
                'mti 2021/07/15 End

                'bbh 2022/04/22 Old computation of CPOPFOREIGN from MigrantStocks was before had good data on POPFOREIGNIN and POPFOREIGNOUT
                '   The latter two are now treated in DataPop and really POPFOREIGN should be also; with better data now on remittances also,
                '   and with gross popforeign and xworkremit, don't need old adjustments of those two in net value form to be consistent in sign/magnitude
                CPOPFOREIGN = New Dictionary(Of String, Single?)
                For Each key In cntx.Regionalization.Keys
                    CPOPFOREIGN(key) = CPOPFOREIGNIN(key) - CPOPFOREIGNOUT(key)
                Next

                processed = False
            End Sub

            <ExportsAsset("CINCOMELTMID")>
            <ExportsAsset("CGINIDOM")>
            <ExportsAsset("ValAddManu")>
            <ExportsAsset("CGCon")>
            <ExportsAsset("GExpDef")>
            Private Sub PreProcess(cntx As IRebuildFacade)
                If Me.processed Then
                    Return
                End If

                InitVars(cntx)

                NewGovConAggregator()

                Me.PreProcessGovCon(cntx)

                Dim objWriter = New System.IO.StreamWriter(cntx.PutFdrvRun + "progress.txt", append:=True)
                objWriter.WriteLine("Processing Data on Economies - Please Wait")
                objWriter.Close()

                Dim ValHold As Single?
                Dim i As Integer

                Using db As IFsContext = New IFsContext()
                    If cntx.HistoricMode Then
                        Dim gp As GlobalParametersHist
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "WEPBYEAR").Single()
                        WorldEP = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XWBLNINTR").Single()
                        sxwblnintr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XWBLNREPR").Single()
                        sxwblnrepr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XWBLOANR").Single()
                        sxwbloanr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XWBLNEQR").Single()
                        sxwblneqr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XIMFCRINTR").Single()
                        sximfcrintr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XIMFCRREPR").Single()
                        sximfcrrepr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XIMFCREDITR").Single()
                        sximfcreditr = CSng(gp.Value)
                        gp = db.GlobalParametersHist.Where(Function(g) g.ParameterName = "XIMFCREQR").Single()
                        sximfcreqr = CSng(gp.Value)

                        Dim gp2 As GlobalParametersMultipleHist
                        gp2 = db.GlobalParametersMultipleHist.Single()
                        worldap1 = CSng(gp2.WORLDAP1)
                        worldap2 = CSng(gp2.WORLDAP2)
                    Else
                        Dim gp As GlobalParameters
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "WEPBYEAR").Single()
                        WorldEP = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XWBLNINTR").Single()
                        sxwblnintr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XWBLNREPR").Single()
                        sxwblnrepr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XWBLOANR").Single()
                        sxwbloanr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XWBLNEQR").Single()
                        sxwblneqr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XIMFCRINTR").Single()
                        sximfcrintr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XIMFCRREPR").Single()
                        sximfcrrepr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XIMFCREDITR").Single()
                        sximfcreditr = CSng(gp.Value)
                        gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "XIMFCREQR").Single()
                        sximfcreqr = CSng(gp.Value)

                        Dim gp2 As GlobalParametersMultiple
                        gp2 = db.GlobalParametersMultiple.Single()
                        worldap1 = CSng(gp2.WORLDAP1)
                        worldap2 = CSng(gp2.WORLDAP2)
                    End If
                End Using

                Dim SUMRemitNormPaid As Single?, SUMRemitNormReceived As Single?
                'jrs 2022/11/01 flexible constant dollars
                'jrs 2021/10/15 start RemitPaid and Received are now % of GDP
                If cntx.HistoricMode Then
                    'LINQ syntax
                    SUMRemitNormPaid = (From s In cntx.GetSlice("SeriesXWorkerRemitPaidGDP", "Earliest")
                                        Join r In cntx.GetSlice("GDP" & ConstantDollarsYear.ToString, "Earliest") On s.Key Equals r.Key
                                        Select Key = s.Key, Value = s.Value * r.Value / 100).Sum(Function(item) item.Value)
                    SUMRemitNormReceived = (From s In cntx.GetSlice("SeriesXWorkerRemitReceivedGDP", "Earliest")
                                            Join r In cntx.GetSlice("GDP" & ConstantDollarsYear.ToString, "Earliest") On s.Key Equals r.Key
                                            Select Key = s.Key, Value = s.Value * r.Value / 100).Sum(Function(item) item.Value)
                Else
                    SUMRemitNormPaid = (From s In cntx.GetSlice("SeriesXWorkerRemitPaidGDP", "MostRecent")
                                        Join r In cntx.GetSlice("GDP" & ConstantDollarsYear.ToString, "MostRecent") On s.Key Equals r.Key
                                        Select Key = s.Key, Value = s.Value * r.Value / 100).Sum(Function(item) item.Value)
                    SUMRemitNormReceived = (From s In cntx.GetSlice("SeriesXWorkerRemitReceivedGDP", "MostRecent")
                                            Join r In cntx.GetSlice("GDP" & ConstantDollarsYear.ToString, "MostRecent") On s.Key Equals r.Key
                                            Select Key = s.Key, Value = s.Value * r.Value / 100).Sum(Function(item) item.Value)
                End If
                'jrs 2021/10/15 end
                'bbh 2022/04/22 start Replace remittance data adjustment factors from global sums as average of paid and received to adjustment to total received value
                'RemitNormPaid = (SUMRemitNormPaid + SUMRemitNormReceived) / (2 * SUMRemitNormPaid)
                'RemitNormReceived = (SUMRemitNormPaid + SUMRemitNormReceived) / (2 * SUMRemitNormReceived)
                RemitNormPaid = SUMRemitNormReceived / SUMRemitNormPaid
                RemitNormReceived = 1
                'bbh 2022/04/22 end

                'bbh 2022/06/04 start
                '   Read International Flow Data, Compare with Current Account, and Adjust Trade to Assure that
                '       Current Account Components are Consistent with the Current Account
                '   ----------------------------------------------------------------------
                ReadAndProcessIntlFlowData(cntx)

                '   Read and Normalize Sectoral Trade Flows to Total Trade Data
                '   -----------------------------------------------------------
                ReadAndNormalizeTradeData(cntx)
                'bbh 2022/06/04 end

                '   Read Value Added in 3 sectors (plus IND and ICT) and Split it across cntx.NSec sectors
                '   ----------------------------------------------------------------------
                Dim PCapHigh As Single?, ValAddInd As Single?, TotalVadPrim As Single?, TotalPrim As Single?
                Dim temp As Single?, TotalInd As Single?
                PCapHigh = 0
                'jrs 2025/04/11
                'jrs 2025/04/16 move out the declaration to access it in InputOutputDataLoad
                'Dim bVaddData As Dictionary(Of String, Boolean())
                bVaddData = New Dictionary(Of String, Boolean())

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriTables As New List(Of String)
                    Dim DictTbls As New List(Of IDictionary(Of String, Single?()))
                    Dim yrss As New List(Of Short())
                    SeriTables.Add("VaddAg")
                    SeriTables.Add("VaddInd")
                    SeriTables.Add("VaddSer")
                    SeriTables.Add("VaddICTGDP")
                    SeriTables.Add("VaddMan")
                    Dim Estimators As New List(Of SeriesEstimator)

                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Ag (1970)").ToEstimator(CGDPPCP))
                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Ind (1970)").ToEstimator(CGDPPCP))
                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Ser (1970)").ToEstimator(CGDPPCP))
                    'NONE for ICTGDP
                    Estimators.Add(Nothing)
                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Man (1970)").ToEstimator(CGDPPCP))

                    For i = 0 To SeriTables.Count - 1
                        yrss.Add(cntx.GetYears(SeriTables(i)).OrderBy(Function(y) y).ToArray())
                        DictTbls.Add(cntx.GetDice(SeriTables(i), yrss(i)))
                    Next
                    For Each key In cntx.Regionalization.Keys
                        Dim ValAddVals(6) As Single?
                        ValAdd.Add(key, ValAddVals)
                        'jrs 2025/05/07
                        Dim bValAddVals(6) As Boolean
                        bVaddData.Add(key, bValAddVals)

                        For i = 0 To SeriTables.Count - 1
                            ValHold = getClosestYrVal(DictTbls(i), yrss(i), key, cntx.FirstYear, HistDist)
                            Select Case i
                                Case 0 'Agri
                                    ValAdd(key)(Agri) = ValHold
                                    If Not (ValAdd(key)(Agri).HasValue) Or ValAdd(key)(Agri) < 1 Then 'Agriculture
                                        ValAdd(key)(Agri) = Estimators(i)(key)
                                    Else 'jrs 2025/05/07
                                        bVaddData(key)(Agri) = True
                                    End If
                                Case 1
                                    ValAddInd = ValHold  'Includes Manufacturing, En, Raw Mats
                                    If Not (ValAddInd.HasValue) Then 'Industry
                                        ValAddInd = Estimators(i)(key)
                                    End If
                                Case 2
                                    ValAdd(key)(Serv) = ValHold
                                    If Not (ValAdd(key)(Serv).HasValue) OrElse ValAdd(key)(Serv) < 2 Then 'Services
                                        ValAdd(key)(Serv) = Estimators(i)(key)
                                    Else 'jrs 2025/05/07
                                        bVaddData(key)(Serv) = True
                                    End If
                                Case 3
                                    ValAdd(key)(ICT) = ValHold 'ICT
                                Case 4
                                    ValAdd(key)(Manu) = ValHold
                                    If Not (ValAdd(key)(Manu).HasValue) OrElse ValAdd(key)(Manu) < 2 Then 'Manufacturing
                                        ValAdd(key)(Manu) = Estimators(i)(key)
                                    Else 'jrs 2025/05/07
                                        bVaddData(key)(Manu) = True
                                    End If
                            End Select
                        Next
                        TotalVadPrim = AMAX(5, ValAddInd - ValAdd(key)(Manu))
                        'Allocate other industrial vadd to energy, raw mats based on exports
                        TotalPrim = AMAX(0.001F, XEN(key) + XMA(key))
                        ValAdd(key)(Ener) = AMAX(2, TotalVadPrim * XEN(key) / TotalPrim)
                        ValAdd(key)(Mate) = AMAX(2, TotalVadPrim * XMA(key) / TotalPrim)
                    Next

                    'mti 2019/04/29  Flex Hist Base End
                Else 'forecast
                    'jrs 2025/05/15
                    Dim TbNameVADDAgg = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Value Added in Ag (" & CStr(cntx.BaseYear) & ") Power"
                    TbNameVADDAgg = getFunctionNameYrOrMstRct(TbNameVADDAgg, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'Dim XYTABL As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Ag (1995)").ToEstimator(CGDPPCP)
                    Dim XYTABL As SeriesEstimator = cntx.GetRegression(TbNameVADDAgg).ToEstimator(CGDPPCP)
                    Dim TbNameVADDInd = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Value Added in Ind (" & CStr(cntx.BaseYear) & ") Log"
                    TbNameVADDInd = getFunctionNameYrOrMstRct(TbNameVADDInd, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'Dim XYTABL2 As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Ind (1995)").ToEstimator(CGDPPCP)
                    Dim XYTABL2 As SeriesEstimator = cntx.GetRegression(TbNameVADDInd).ToEstimator(CGDPPCP)
                    Dim TbNameVADDSer = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Value Added in Ser (" & CStr(cntx.BaseYear) & ") Log"
                    TbNameVADDSer = getFunctionNameYrOrMstRct(TbNameVADDSer, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'Dim XYTABL3 As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Value Added in Ser (1995)").ToEstimator(CGDPPCP)
                    Dim XYTABL3 As SeriesEstimator = cntx.GetRegression(TbNameVADDSer).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("VaddAg", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("VaddInd", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("VaddSer", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Join s4 In cntx.GetSlice("VaddICTGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s4.Key
                                      Join s5 In cntx.GetSlice("VaddMan", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s5.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value,
                    Value4 = s4.Value, Value5 = s5.Value)
                        'If item.Key = "Ethiopia" Then Stop
                        'jrs 2025/04/11
                        Dim bValAddVals(6) As Boolean
                        bVaddData.Add(item.Key, bValAddVals)

                        Dim ValAddVals(6) As Single?
                        ValAdd.Add(item.Key, ValAddVals)
                        ValAdd(item.Key)(Agri) = item.Value
                        If Not (ValAdd(item.Key)(Agri).HasValue) Or ValAdd(item.Key)(Agri) < 1 Then 'Agriculture
                            ValAdd(item.Key)(Agri) = XYTABL(item.Key)
                        ElseIf CGDPPCP(item.Key) < 1 Then
                            'Some very poor country ag vadd% data far too low; perhaps informal omitted
                            'e.g. Eritrea
                            temp = XYTABL(item.Key)
                            If ValAdd(item.Key)(Agri) < 0.7 * temp Then ValAdd(item.Key)(Agri) = CSng(0.7 * temp)
                        Else 'jrs 2025/04/11
                            bVaddData(item.Key)(Agri) = True
                        End If
                        ValAddInd = item.Value2 'Includes Manufacturing, En, Raw Mats
                        If Not (ValAddInd.HasValue) Then 'Industry; Industry more complete than Manuf
                            ValAddInd = XYTABL2(item.Key)
                        End If

                        ValAdd(item.Key)(Serv) = item.Value3
                        'jrs 2025/04/11
                        bVaddData(item.Key)(Serv) = item.Value3.HasValue
                        If CGDPPCP(item.Key) < 1 Then
                            'Some very poor country sr vadd% data far too high
                            'e.g. Eritrea
                            temp = XYTABL3(item.Key)
                            If ValAdd(item.Key)(Serv) > 1.3 * temp Then
                                ValAdd(item.Key)(Serv) = CSng(1.3 * temp)
                                'jrs 2025/04/11
                                bVaddData(item.Key)(Serv) = False
                            End If

                        End If

                        If Not (ValAdd(item.Key)(Serv).HasValue) Or ValAdd(item.Key)(Serv) < 2 Then 'Services
                            ValAdd(item.Key)(Serv) = XYTABL3(item.Key)
                            'jrs 2025/04/11
                            bVaddData(item.Key)(Serv) = False
                        End If

                        ValAdd(item.Key)(ICT) = item.Value4
                        'jrs 2025/04/11
                        bVaddData(item.Key)(ICT) = item.Value4.HasValue


                        ValAdd(item.Key)(Manu) = item.Value5
                        'jrs 2025/04/11
                        bVaddData(item.Key)(Manu) = item.Value5.HasValue
                        If Not (ValAdd(item.Key)(Manu).HasValue) Or ValAdd(item.Key)(Manu) < 2 Then 'Manufacturing
                            TotalInd = AMAX(0.001F, XEN(item.Key) + XMA(item.Key) + XMN(item.Key))
                            ValAdd(item.Key)(Ener) = AMAX(2, ValAddInd * XEN(item.Key) / TotalInd)
                            ValAdd(item.Key)(Mate) = AMAX(2, ValAddInd * XMA(item.Key) / TotalInd)
                            ValAdd(item.Key)(Manu) = AMAX(2, ValAddInd * XMN(item.Key) / TotalInd)
                            'jrs 2025/04/11
                            bVaddData(item.Key)(Manu) = False
                        Else 'Have Manuf, split remainder 2 ways
                            TotalVadPrim = AMAX(5, ValAddInd - ValAdd(item.Key)(Manu))
                            'Allocate other industrial vadd to energy, raw mats based on exports
                            TotalPrim = AMAX(0.001F, XEN(item.Key) + XMA(item.Key))
                            ValAdd(item.Key)(Ener) = AMAX(2, TotalVadPrim * XEN(item.Key) / TotalPrim)
                            ValAdd(item.Key)(Mate) = AMAX(2, TotalVadPrim * XMA(item.Key) / TotalPrim)
                        End If
                    Next

                End If 'if history else forecast

                'bbh 2024/05/24 Begin long block of changes and additions
                '    Rebalance Services and Manufacturing if Very Extreme Difference
                '    ---------------------------------------------------------------
                Dim SumVadd As Single?, ValTot As Single?, pcap As Single?, ValTotDefExcess As Single?, ValTotAllocate As Single?
                For Each key In cntx.Regionalization.Keys
                    If ValAdd(key)(Serv) > 9 * ValAdd(key)(Manu) Then 'bbh 2024/05/24 this If-Then-Else moved up here and commented out further down
                        SumVadd = ValAdd(key)(Manu) + ValAdd(key)(Serv)
                        'bbh 2024/06/26 changed from 19, 0.05, 0.95 to boost Manu more, esp in South Sudan
                        ValAdd(key)(Manu) = CSng(0.1 * SumVadd)
                        ValAdd(key)(Serv) = CSng(0.9 * SumVadd)
                        'jrs 2025/04/11 Ignoring the data
                        bVaddData(key)(Manu) = False
                        bVaddData(key)(Serv) = False
                    End If

                    '   Identify ICT Size 'bbh 2024/05/24 this If-Then-Else new
                    '       ----------------
                    If Not (ValAdd(key)(ICT).HasValue) Then
                        'ValAdd(key)(ICT) = ICTShare(key) bbh 2021/08/04 Djibouti value from function is too low relative to other countries and labor share
                        ValAdd(key)(ICT) = AMAX(2, ICTShare(key))
                    End If

                    '   Sum ValAdd, ValTotDefExcess, ValTotAllocate, and allocate DefExcess to Ener, Mate, ICT and/or to All sectors
                    '   'bbh 2024/05/24 this Section of code new, starts here
                    '   ------------------------------------------------------------------------------------------------------------
                    ValTot = 0
                    'jrs 2025/04/11
                    Dim ValTotFromData As Single? = 0

                    For jCount% = 1 To cntx.NSec
                        ValTot = ValTot + AMAX(1, ValAdd(key)(jCount%))
                        'jrs 2025/04/11
                        If bVaddData(key)(jCount%) Then
                            ValTotFromData = ValTotFromData + AMAX(1, ValAdd(key)(jCount%))
                        End If
                    Next jCount%
                    'If key = "Guyana" Then Stop
                    ' ValTotAllocate = ValAdd(key)(Ener) + ValAdd(key)(Mate) + ValAdd(key)(ICT)
                    'bbh 2024/07/16 Start Jose replace entire block from here to end
                    ValTotDefExcess = 100 - ValTot
                    'If ValTotDefExcess > 10 Then ValTotDefExcess = 10 'Cannot expect Ener, Mate, ICT to absorb more than 10% of a ValAdd deficit without
                    ''setting up surpluses relative to domestic final demand and then oscillations (e.g.in Guyana with more than 20% deficit
                    If ValTotDefExcess > 0 Then 'Allocate the ValAdd Deficit from 100% of GDP to all sectors, even Agri, Manu, Serv where data are good
                        For jCount% = 1 To cntx.NSec 'Boost of each sector's ValAdd proportionate to original databased value
                            'jrs 2025/04/11
                            'ValAdd(key)(jCount%) = ValAdd(key)(jCount%) + ValTotDefExcess * ValAdd(key)(jCount%) / ValTot
                            'Only apply it to sectors with no data
                            If Not bVaddData(key)(jCount%) Then
                                ValAdd(key)(jCount%) = ValAdd(key)(jCount%) + ValTotDefExcess * ValAdd(key)(jCount%) / (ValTot - ValTotFromData)
                            End If
                            'If key = "India" And jCount% = 2 Then Stop
                            If jCount% = 2 And ValAdd(key)(Ener) / ValTot < 0.1 Then 'Especially lacking historical VADD for energy and there being CS headroom
                                'for energy, devote more than the proportionate share to it, up to 10% of ValTot
                                'This action could push resultant sum of ValAdd above 100%; normalized back to it after allocations are complete
                                'ValAdd(key)(jCount%) = Amin(CSng(0.1 * ValTot), ValAdd(key)(jCount%) + ValTotDefExcess * ValAdd(key)(jCount%) / ValTot)
                                ValAdd(key)(jCount%) = Amin(CSng(0.1 * ValTot), ValAdd(key)(jCount%) + ValTotDefExcess)
                            End If
                        Next jCount%
                    Else  'Process surplus ValTot (which is negative signed ValTotDefExcess)
                        If -ValTotDefExcess < 0.5 * ValAdd(key)(Ener) Then 'Reduce energy value added by full amount of surplus if reduces by 1/2 or less
                            ValAdd(key)(Ener) = ValAdd(key)(Ener) + ValTotDefExcess
                        Else 'Reduce energy value added by 50% and calculate remaining surplus
                            ValTotDefExcess = ValTotDefExcess + ValAdd(key)(Ener) * CSng(0.5)
                            ValAdd(key)(Ener) = ValAdd(key)(Ener) * CSng(0.5)
                            For jCount% = 1 To cntx.NSec 'Allocate the remaining surplus to all sectors, even Agri, Manu, Serv where data are good
                                'jrs 2025/04/11
                                'bbh 2024/07/14 with Jose saw that needed a negative sign in front of ValTotDefExcess
                                'ValAdd(key)(jCount%) = ValAdd(key)(jCount%) - Amin(CSng(ValAdd(key)(jCount%) * 0.5), -ValTotDefExcess * ValAdd(key)(jCount%) / ValTot)
                                If Not bVaddData(key)(jCount%) Then
                                    ValAdd(key)(jCount%) = ValAdd(key)(jCount%) - Amin(CSng(ValAdd(key)(jCount%) * 0.5), -ValTotDefExcess * ValAdd(key)(jCount%) / (ValTot - ValTotFromData))
                                End If
                            Next jCount%
                        End If
                    End If
                    'If key = "India" Then Stop
                    'If key = "United States of America" Then Stop

                    'ElseIf ValTotDefExcess < 0 And -ValTotDefExcess < 0.5 * ValAdd(key)(Ener) Then 'bbh 2024/07/10 Added ElseIf and next line to focus surplus reduction on energy
                    '    ValAdd(key)(Ener) = ValAdd(key)(Ener) + ValTotDefExcess
                    'Else 'Bring down the surplus, but avoid destroying more than half of value added in target sectors
                    '    For jCount% = 1 To cntx.NSec
                    '        'bbh 2024/07/14 with Jose saw that needed a negative sign in front of ValTotDefExcess
                    '        ValAdd(key)(jCount%) = ValAdd(key)(jCount%) - Amin(CSng(ValAdd(key)(jCount%) * 0.5), -ValTotDefExcess * ValAdd(key)(jCount%) / ValTot)
                    '    Next jCount%
                    'End If
                    'bbh 2024/07/16 End

                    'If ValTotDefExcess > 0 Then 'Allocate the Deficit from 100% to all but Agri, Manu, and Serv for which data are good; tried but messes those sectors up
                    '    ValAdd(key)(Ener) = ValAdd(key)(Ener) + ValTotDefExcess * ValAdd(key)(Ener) / ValTotAllocate
                    '    ValAdd(key)(Mate) = ValAdd(key)(Mate) + ValTotDefExcess * ValAdd(key)(Mate) / ValTotAllocate
                    '    ValAdd(key)(ICT) = ValAdd(key)(ICT) + ValTotDefExcess * ValAdd(key)(ICT) / ValTotAllocate
                    'Else 'Bring down the surplus, but avoid destroying more than half of value added in target sectors
                    '    ValAdd(key)(Ener) = ValAdd(key)(Ener) - Amin(CSng(ValAdd(key)(Ener) * 0.5), ValTotDefExcess * ValAdd(key)(Ener) / ValTotAllocate)
                    '    ValAdd(key)(Mate) = ValAdd(key)(Mate) - Amin(CSng(ValAdd(key)(Mate) * 0.5), ValTotDefExcess * ValAdd(key)(Mate) / ValTotAllocate)
                    '    ValAdd(key)(ICT) = ValAdd(key)(ICT) - Amin(CSng(ValAdd(key)(ICT) * 0.5), ValTotDefExcess * ValAdd(key)(ICT) / ValTotAllocate)
                    'End If
                    'If key = "India" Then Stop
                    'If key = "Guyana" Then Stop
                    ValTot = 0
                    For jCount% = 1 To cntx.NSec
                        ValTot = ValTot + AMAX(1, ValAdd(key)(jCount%))
                    Next jCount%
                    For jCount% = 1 To cntx.NSec 'Normalization of % values unnecessary given normalization below of dollar values, but
                        'useful in debugging to see how things have developed, especially given special boost to energy above
                        ValAdd(key)(jCount%) = AMAX(1, ValAdd(key)(jCount%)) / ValTot * 100
                    Next jCount% 'bbh 2024/05/24 this Section of code new, ends here
                    'If key = "India" Then Stop
                    'If key = "Guyana" Then Stop

                    ''       Compute ICT Size and Reduce Manufacturing and Services Accordingly
                    '        'bbh 2024/05/24 This section of code commented and ICT ValAdd being left as separate from Ag, Indu/Manu, Serv
                    '           because of shortage in sum of those in data from 100% of GDP
                    ''       ------------------------------------------------------------------
                    'Dim SumVadd As Single?, ValTot As Single?, pcap As Single?
                    'For Each key In cntx.Regionalization.Keys
                    '    If Not (ValAdd(key)(ICT).HasValue) Then
                    '        'ValAdd(key)(ICT) = ICTShare(key) bbh 2021/08/04 Djibouti value from function is too low relative to other countries and labor share
                    '        ValAdd(key)(ICT) = AMAX(2, ICTShare(key))
                    '    End If

                    '    SumVadd = ValAdd(key)(Manu) + ValAdd(key)(Serv)
                    '    ValAdd(key)(Manu) = AMAX(CSng(0.1 * ValAdd(key)(Manu)),
                    '    ValAdd(key)(Manu) - ValAdd(key)(ICT) * ValAdd(key)(Manu) / SumVadd)
                    '    ValAdd(key)(Serv) = AMAX(CSng(0.1 * ValAdd(key)(Serv)),
                    '    ValAdd(key)(Serv) - ValAdd(key)(ICT) * ValAdd(key)(Serv) / SumVadd)

                    '    ''       Rebalance Services and Manufacturing if Necessary
                    ''            bbh 2024/05/24 this If-Then-Else moved up further and commented out here
                    ''       -------------------------------------------------

                    'If ValAdd(key)(Serv) > 19 * ValAdd(key)(Manu) Then 
                    '    SumVadd = ValAdd(key)(Manu) + ValAdd(key)(Serv)
                    '    ValAdd(key)(Manu) = CSng(0.05 * SumVadd)
                    '    ValAdd(key)(Serv) = CSng(0.95 * SumVadd)
                    'End If
                    'If key = "India" Then Stop

                    'bbh 2024/05/24 End long block of changes and additions

                    '   Normalize Value Added to 100% and Compute it in Value Terms Using GDP
                    '   ---------------------------------------------------------------------

                    ValTot = 0
                    For jCount% = 1 To cntx.NSec
                        ValTot = ValTot + AMAX(1, ValAdd(key)(jCount%))
                    Next jCount%
                    For jCount% = 1 To cntx.NSec
                        ValAdd(key)(jCount%) =
                        AMAX(1, ValAdd(key)(jCount%)) / ValTot * CGDP(key)
                    Next jCount%

                    '   Compute Highest Per Capita GDP
                    '   ------------------------------
                    'If key = "Denmark" Then Stop

                    pcap = CGDP(key) / CPOP(key)
                    If pcap > PCapHigh Then PCapHigh = pcap

                Next

                '   Read and Balance Rest of Expenditure Components
                '   -----------------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriTables As New List(Of String)
                    Dim DictTbls As New List(Of IDictionary(Of String, Single?()))
                    Dim yrss As New List(Of Short())
                    SeriTables.Add("SeriesHouseConGDP")
                    SeriTables.Add("SeriesGovConGDP")
                    SeriTables.Add("SeriesInvestGrCapFormGDP")

                    Dim Estimators As New List(Of SeriesEstimator)

                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Pers Consumption (1960)").ToEstimator(CGDPPCP))
                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Govt Cons % GDP (1960)").ToEstimator(CGDPPCP))
                    Estimators.Add(cntx.GetRegression("GDP/Capita (PPP) Versus Investment, Fixed (1960)").ToEstimator(CGDPPCP))
                    Dim Slice1961 = cntx.GetSlice("SeriesInvestGrCapFormGDP", 1961)
                    For i = 0 To SeriTables.Count - 1
                        yrss.Add(cntx.GetYears(SeriTables(i)).OrderBy(Function(y) y).ToArray())
                        DictTbls.Add(cntx.GetDice(SeriTables(i), yrss(i)))
                    Next
                    For Each key In cntx.Regionalization.Keys
                        For i = 0 To SeriTables.Count - 1
                            ValHold = getClosestYrVal(DictTbls(i), yrss(i), key, cntx.FirstYear, HistDist)
                            Select Case i
                                Case 0
                                    CPCON.Add(key, ValHold)
                                Case 1
                                    CGCon.Add(key, ValHold)
                                Case 2
                                    CINVEST.Add(key, ValHold)
                            End Select
                        Next
                        If key = "China" Then
                            CINVEST(key) = Slice1961(key)
                            'Great Leap Forward messed up 1960 data
                        End If
                        If Not (CPCON(key).HasValue) Then
                            CPCON(key) = Estimators(0)(key)
                        End If
                        If Not (CGCon(key).HasValue) Then
                            CGCon(key) = Estimators(1)(key)
                        End If
                        If Not (CINVEST(key).HasValue) Then
                            CINVEST(key) = Estimators(2)(key)
                        End If
                    Next

                    'mti 2019/04/29  Flex Hist Base End

                Else 'forecast 
                    'jrs 2025/03/04
                    Dim TbNamePersCons As String = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Pers Consumption (" & CStr(cntx.BaseYear) & ")"
                    TbNamePersCons = getFunctionNameYrOrMstRct(TbNamePersCons, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'Dim XYTABL As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Pers Consumption (1995)").ToEstimator(CGDPPCP)
                    Dim XYTABL As SeriesEstimator = cntx.GetRegression(TbNamePersCons).ToEstimator(CGDPPCP)

                    Dim TbName As String
                    'jrs 2024/06/12 TbName$ = "GDP/Capita (PPP) Versus Govt Cons % GDP (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Govt Cons % GDP (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Dim XYTABL2 As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    'jrs 2024/06/19
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Investment, Fixed (" & BaseYear & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'Dim XYTABL3 As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Investment, Fixed (1995)").ToEstimator(CGDPPCP)
                    Dim XYTABL3 As SeriesEstimator = cntx.GetRegression(TbName$).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesHouseConGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGovConGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesInvestGrCapFormGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value)
                        CPCON.Add(item.Key, item.Value)
                        CGCon.Add(item.Key, item.Value2)
                        CINVEST.Add(item.Key, item.Value3)
                        If Not (CPCON(item.Key).HasValue) Then
                            CPCON(item.Key) = XYTABL(item.Key)
                        End If
                        If Not (CGCon(item.Key).HasValue) Then
                            CGCon(item.Key) = XYTABL2(item.Key)
                        End If
                        If Not (CINVEST(item.Key).HasValue) Then
                            CINVEST(item.Key) = XYTABL3(item.Key)
                        End If
                    Next
                End If 'if history else forecast

                Dim CGConFromSectors As Single?
                For Each key In cntx.Regionalization.Keys
                    CPCON(key) = AMAX(30, Amin(80, CPCON(key)))
                    CGCon(key) = AMAX(9, Amin(35, CGCon(key)))
                    'Bangalesh data puts it less than 5%; seems impossible
                    'CINVEST(key) = AMAX(5, Amin(40, CINVEST(key)))
                    CINVEST(key) = AMAX(10, Amin(40, CINVEST(key))) 'bbh 2024/06/26 Amax was too low only for Sudan South and Djibouti

                    CGovCon.Add(key, CGCon(key) / 100 * CGDP(key)) 'Convert to dollars
                    'If key = "Singapore" Then Stop
                    'mti 2013/07/31 - Reorganize for GovCon - start
                    'sum up dollar values
                    CGConFromSectors = GExpDef(key) + GExpEd(key) + GExpRandD(key) + GExpHl(key) + GExpInfra(key) + GExpInfraOther(key)
                    CGConFromSectors = CGConFromSectors + CSng(0.01 * CGConFromSectors)  'at least one percent for other
                    CGovCon(key) = AMAX(CGovCon(key), CGConFromSectors)

                    CGCon(key) = AMAX(9, Amin(35, 100 * CGovCon(key) / CGDP(key)))
                    CGovCon(key) = CGCon(key) / 100 * CGDP(key) 'Convert again to dollars - in case capped - not needed as it is done later
                    'mti 2013/07/31 - Reorganize for GovCon - end

                    'bbh 2014/01/24
                    'If key = "Afghanistan" Then Stop
                    '        CGovConLocal(key) = (GExpHlLocal(key) + GExpEdLocal(key)) / 100 * CGDP(key)
                    CGovConLocal.Add(key, GExpHlLocal(key) + GExpEdLocal(key)) 'bbh 2014/04/15

                Next

                '   Read Informal Economy Data
                '   --------------------------
                '
                'This routine has reached 64k limit; so a separate sub was needed
                Call ReadInformalEconomy(cntx)

                ''''  'Note on movement of GOVCON code from DataSocioPol.bas to here
                '   When can work with Mohammod  change logic so that Govcon is big enough to handle it and bring it here
                '   Build up to Govcon instead of normalizing components into govcon


                '
                '   Compute IO Matrices
                '   -------------------
                Call InputOutputData(cntx)

                '
                '   Social Accounting Matrix (Financial Flow) Tables - Domestic
                '   -----------------------------------------------------------

                'Revenue and expenditure series information
                ' Revenues---------------------
                '   Revenue series that have high values for Germany, other federal systems are total
                '   Revenue series that have high values for Micronesia, Afghanistan,
                '        other heavy aid recipients, include foreign aid

                '   SeriesTotRev%GDPIMF (TotRevIMFTbl) is total revenue with aid and covers many countries
                '        (but only from 1990); Germany low 40s, US low 30s; Micronesia about 70%

                '   SeriesGovRevOECD%GDP (GovRevOECDTbl)is total revenue with aid for limited country set
                '         Germany low 40s, US low 30s; foreign aid? no Micronesia or Afghanistan

                '   SeriesGovtCalcRevTot%GDP (GovTotRevGFSTbl) is total revenue (foreign aid?)
                '      calcuated with values only to 2011; no Micronesia or Afghanistan

                '   SeriesGovtCurRev%GDP (GovRevTbl) was WDI for central revenue .... foreign aid
                '      when was WDI Germany values in high 20s
                '      Now is labeled in DataDict as ICTD series for central revenue; Germany about 12%;
                '           US high teens

                '   SeriesGovtCalcRevCen%GDP (GovCenRevGFSTbl) is IMF GFS for central revenue
                '      Germany was about 15 until 1998 then about 30 to 2011; series looks messed up
                '      US high teens; foreign aid? no Micronesia or Afghanistan

                '   Possibly to add: SeriesGovRevGenTot%GDP, from ICTD defined as Tot Rev, Gen Gov, %GDP
                '      Is actually decimal form not %; appears no aid (Micronesia abot 20%; Afghan 8%)
                '      Does not really look like total govt: Germany only 30%, France 35%
                '      (old WDI central was 45%), US 25%+.
                '      Series looks questionable to use even if put from decimal to %

                ' Expenditures-----------------------
                '   Series GovTotalOutlays%GDP (GovTotExpTbl), OECD
                '       Germany 45%, France 55%; US 38% (no China, India, Brazil)
                '
                '   SeriesGovtCalcExpendTot%GDP (GovTotExpGFSTbl)  IMF GFS calculated
                '       Germany 45%, France 55%; US 40%
                '
                '   SeriesGovExpense%GDP (GovExpTbl), WDI Central govt; good coverage (Afghan 40-50%)
                '
                '   SeriesGovtCalcExpendCen%GDP (GovCenExpGFSTbl)  IMF GFS calculated
                '       Germany 30%, France 48%; US 25-30%


                'GovCon is taken from WDI series GovCon$GDP and defn says General.  Probably is:  OECD about 18%, France 23-24%,
                '   US 16%.  Those are nicely covered by OECD GovTotalOUtlays%GDP which lets transfers be larger than GovCon; when
                '   compare to GovExpense%GDP (most likely central only) find problem in that leaves little headroom
                '   for transfer payments.

                '
                '   Social Accounting Matrix (Financial Flow) Variables - Domestic
                '   --------------------------------------------------------------

                '   Note on initialization philosophy:
                '       Data on government consumption (CGovCon, read and balanced earlier) are
                '           pretty good; so are data on government revenue as % of GDP (Total and Central)
                '       Use these heavily to organize initial SAM structure

                '   bbh 2017/04/21 START - revision of revenue and expenditure logics

                '   At one time used calculated series from Government Financial Statistics (GFS) to fill in total govt revenues
                '       Problem with that is updating it off-line with vb code; in 2017 was already behind (2011 latest)
                '       IMF series GovRevIMFTbl covers 181 countries with much data and is total govt (US rises from about 20 to 30%
                '           and includes aid receipts (adds a whole lot to Micronesia govt revenues, also Afghanistan, etc.)
                '       OECD less extensive and shorter than IMF, but also is total, so makes good primary back-up
                '       WDI series is extensive but only central govt
                '       ICTD revenue series appears only central (test Germany against IMF series to see how much lower it is)

                '   ----------------------------------------------------------------------------------

                'bbh 2019/10/25 start
                '   Use tariff revenue data from dyadic data (table generated by Extended Feature) to fill countries as possible
                '       Before turning to series in IFsHist Series to fill a couple of holes and reconcile with other govt revenue streams
                Using db As IFsContext = New IFsContext()
                    Dim rsD As IEnumerable(Of TariffRevPerSectorCountry)
                    'gvdb 2024/04/05
                    ' update for EF new syntax
                    rsD = db.TariffRevPerSectorCountry.AsEnumerable()
                    For Each item In rsD
                        'read dyadic analysis based import tariff rates by sector
                        'if null set to 0; and many bilateral countries do not have data
                        Dim VarVals(6) As Single?
                        CTariffTaxR.Add(item.Country, 0)
                        If item.Agriculture.HasValue Then
                            CTariffTaxR(item.Country) = CTariffTaxR(item.Country) + item.Agriculture  'jrs 2019/11/08 / 1000
                        End If
                        If item.Energy.HasValue Then
                            CTariffTaxR(item.Country) = CTariffTaxR(item.Country) + item.Energy  'jrs 2019/11/08 / 1000
                        End If
                        If item.Materials.HasValue Then
                            CTariffTaxR(item.Country) = CTariffTaxR(item.Country) + item.Materials  'jrs 2019/11/08 / 1000
                        End If
                        If item.Manufactures.HasValue Then
                            CTariffTaxR(item.Country) = CTariffTaxR(item.Country) + item.Manufactures  'jrs 2019/11/08 / 1000
                        End If
                        If item.Services.HasValue Then
                            CTariffTaxR(item.Country) = CTariffTaxR(item.Country) + item.Services  'jrs 2019/11/08 / 1000
                        End If
                        If item.ICT.HasValue Then
                            CTariffTaxR(item.Country) = CTariffTaxR(item.Country) + item.ICT  'jrs 2019/11/08 / 1000
                        End If
                    Next
                End Using
                '    'bbh 2019/10/25 end

                '   Total Govt Revenues (as % of GDP)
                '   ---------------------------------
                Dim govrevtot As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim govrevtotdat As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim CGovTotExp As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    'GFS Source; does not go back as far as WDI
                    Dim Estimator As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP 2005) Versus Govt Revenue Total (1989) Linear").ToEstimator(CGDPPCP)
                    Dim SeriesTable As String = "SeriesGovtCalcRevTotGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = Estimator(key)
                        End If
                        govrevtot.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim XYTABL As SeriesEstimator, TbName As String
                    'jrs 2024/06/27 TbName$ = "GDP/Capita (PPP 2011) Versus Govt Revenue Total (2011) Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Govt Revenue Total (" & BaseYear & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    XYTABL = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    'jrs 2021/09/17 FM primary, FMS secondary, others terciary
                    'IMF primmary
                    For Each item In (From s In cntx.GetSlice("SeriesTotRevGDPIMF", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGovRevOECDGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesGovtCalcRevTotGDP", cntx.BaseYear) On s.Key Equals s3.Key
                                      Join s31 In cntx.GetSlice("SeriesGovtCalcRevTotGDP", "MostRecent") On s.Key Equals s31.Key
                                      Join s33 In cntx.GetSlice("SeriesGovtGenRevGDPFM", cntx.BaseYear) On s.Key Equals s33.Key
                                      Join s4 In cntx.GetSlice("SeriesGovtGenRevGDPFM", "MostRecent") On s.Key Equals s4.Key
                                      Join s5 In cntx.GetSlice("SeriesGovtGenExpGDPFM", cntx.BaseYear) On s.Key Equals s5.Key
                                      Join s6 In cntx.GetSlice("SeriesGovtGenExpGDPFM", "MostRecent") On s.Key Equals s6.Key
                                      Join s7 In cntx.GetSlice("SeriesGovtCalcExpendTotGDP", cntx.BaseYear) On s.Key Equals s7.Key
                                      Join s8 In cntx.GetSlice("SeriesGovtCalcExpendTotGDP", "MostRecent") On s.Key Equals s8.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, GFSRev = s3.Value, GFSRevMR = s31.Value,
                                        FMRev = s33.Value, FMRevMR = s4.Value, FMExp = s5.Value, FMExpMR = s6.Value,
                                        GFSExp = s7.Value, GFSExpMR = s8.Value)
                        'jrs 2021/09/17 start 
                        'govrevtot.Add(item.Key, item.Value)
                        govrevtot.Add(item.Key, Nothing)
                        CGovTotExp.Add(item.Key, Nothing)

                        If item.FMRev.HasValue And item.FMExp.HasValue Then
                            govrevtot(item.Key) = item.FMRev
                            CGovTotExp(item.Key) = item.FMExp
                        End If
                        If Not govrevtot(item.Key).HasValue Then
                            If item.GFSRev.HasValue And item.GFSExp.HasValue Then
                                govrevtot(item.Key) = item.GFSRev
                                CGovTotExp(item.Key) = item.GFSExp
                            End If
                        End If
                        'years don't match try only FM
                        If Not govrevtot(item.Key).HasValue Then
                            If (item.FMRev.HasValue Or item.FMRevMR.HasValue) And (item.FMExp.HasValue Or item.FMExpMR.HasValue) Then
                                govrevtot(item.Key) = If(item.FMRev, item.FMRevMR)
                                CGovTotExp(item.Key) = If(item.FMExp, item.FMExpMR)
                            End If
                        End If
                        'If only FM don't match try only GFS
                        If Not govrevtot(item.Key).HasValue Then
                            If (item.GFSRev.HasValue Or item.GFSRevMR.HasValue) And (item.GFSExp.HasValue Or item.GFSExpMR.HasValue) Then
                                govrevtot(item.Key) = If(item.GFSRev, item.GFSRevMR)
                                CGovTotExp(item.Key) = If(item.GFSExp, item.GFSExpMR)
                            End If
                        End If
                        'If only GFS don't match start over with FM without matching
                        If Not (govrevtot(item.Key).HasValue) Then
                            govrevtot(item.Key) = If(item.FMRev, item.FMRevMR)
                        End If
                        'GFS secondary (not great)
                        If Not (govrevtot(item.Key).HasValue) Then
                            govrevtot(item.Key) = If(item.GFSRev, item.GFSRevMR)
                        End If
                        'jrs 2021/09/17 end

                        govrevtotdat.Add(item.Key, True) 'bbh 2017/09/01 Temporary, may be proven false below
                        If Not (govrevtot(item.Key).HasValue) Or govrevtot(item.Key) < 4 Then 'OECD secondary
                            'bbh 2017/09/01 set lower limit at 4 given data for Nigeria just below 5 and other country near 2
                            '   here and below; was 5
                            govrevtot(item.Key) = item.Value2

                            'jrs 2021/09/17 applied above already
                            'If Not (govrevtot(item.Key).HasValue) Or govrevtot(item.Key) < 4 Then 'GFS calculated is ok tertiary backup but
                            '    'in 2017 May only had values to 2011 so very weak
                            '    govrevtot(item.Key) = item.Value3
                            'End If

                            If Not (govrevtot(item.Key).HasValue) Or govrevtot(item.Key) < 4 Then
                                govrevtotdat(item.Key) = False 'bbh 2017/09/01

                                govrevtot(item.Key) = XYTABL(item.Key)
                            End If

                        End If
                        'If CGovTotExp(item.Key) > 0.8 * CGDP(item.Key) Then CGovTotExp(item.Key) = CSng(0.8 * CGDP(item.Key)) 'bbh 2021/09/21
                        If CGovTotExp(item.Key) > 80 Then CGovTotExp(item.Key) = 80  'bbh 2023/01/08 Above line was wrong because CGovTotExp is % and CGDP is $
                    Next
                End If

                '   Use data from WDI and Government Financial Statistics (GFS) to get central govt revenues
                '   ----------------------------------------------------------------------------------
                Dim govrevcen As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim GovExpCentral As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim Estimator As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Govt Revenue (1970)").ToEstimator(CGDPPCP)
                    Dim SeriesTable As String = "SeriesGovtCurRevGDP"
                    Dim SeriesTable2 As String = "SeriesGovtCalcRevCenGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim yrs2 As Short() = cntx.GetYears(SeriesTable2).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    Dim DictTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable2, yrs2)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = getClosestYrVal(DictTbl2, yrs2, key, cntx.FirstYear, HistDist)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimator(key)
                        End If
                        govrevcen.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim XYTABL As SeriesEstimator, TbName As String
                    TbName$ = "GDP/Capita (PPP) Versus Govt Revenue (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    XYTABL = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    'IMF primmary
                    For Each item In (From s In cntx.GetSlice("SeriesGovtCurRevGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGovtCalcRevCenGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        'WDI primary
                        govrevcen.Add(item.Key, item.Value)
                        'GFS secondary (not great)
                        If Not (govrevcen(item.Key).HasValue) Then
                            govrevcen(item.Key) = item.Value2
                        End If

                        If Not (govrevcen(item.Key).HasValue) Or govrevcen(item.Key) < 3 Then    'Function tertiary 'bbh 2017/09/01 was bound at 5
                            govrevcen(item.Key) = XYTABL(item.Key)
                            If govrevtotdat(item.Key) = True Then 'bbh 2017/09/01 revision of sgh fix
                                govrevcen(item.Key) = Amin(govrevcen(item.Key), govrevtot(item.Key))
                            End If
                        End If

                    Next
                End If

                '   Check total above central; compute local; save total for work with revenue streams
                '   ----------------------------------------------------------------------------------
                For Each key In cntx.Regionalization.Keys
                    'govrevtot(key) = AMAX(govrevtot(key), govrevcen(key)) 'bbh 2023/01/08 Removed this line becuase it was badly messing up Congo
                    'which has no recent data for govrevcen and earlier year values that are much larger than good recent govrevtot data
                    'In general, the govrevtot data now mostly come from SeriesGenRev%GDPFM (IMF Fiscal Monitor) and are very complete, so protect them
                    govrevtot(key) = Amin(75, govrevtot(key))
                    CGovRevLocal.Add(key, govrevtot(key) - govrevcen(key))
                    'GovRevPer = GovRevTot 'Gov Revenues not computed in preprocessor to save;
                    GovRevPerSave.Add(key, govrevtot(key)) 'bbh 2017/05/21; not saved for 1st model year, but needed below
                Next

                '   Begin expenditures with centrsl; no real total expenditure data found
                '   ---------------------------------------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesGovExpenseGDP"
                    Dim SeriesTable2 As String = "SeriesGovtCalcExpendCenGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim yrs2 As Short() = cntx.GetYears(SeriesTable2).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    Dim DictTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable2, yrs2)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = getClosestYrVal(DictTbl2, yrs2, key, cntx.FirstYear, HistDist)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = CGCon(key) + 1
                        End If
                        GovExpCentral.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2005) Versus Govt Expense % GDP (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Govt Expense % GDP (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Dim XYTBL As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesGovExpenseGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGovtCalcExpendCenGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        GovExpCentral.Add(item.Key, item.Value)
                        'Back up with GFS calculation (weak given 2011 latest in 2017)
                        If Not GovExpCentral(item.Key).HasValue Then
                            GovExpCentral(item.Key) = item.Value2
                        End If
                        If Not GovExpCentral(item.Key).HasValue Then
                            GovExpCentral(item.Key) = XYTBL(item.Key)
                        End If
                    Next
                End If

                '   Go to total govt expenditures and filling holes when have data in order to compute local govt
                '       When do not have total and therefore ability to compute local govt,
                '       estimate at 2-14% of GDP (OECD gap between total and central is 14%)
                '       North, Walli, Weingast p. 10 have table showing grows from 1-2% to 16%
                '   ---------------------------------------------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    'GFS starts in 1989, thicker
                    Dim SeriesTable As String = "SeriesGovtCalcExpendTotGDP"
                    'OECD Data; starts in 1993; thin
                    Dim SeriesTable2 As String = "SeriesGovTotalOutlaysGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim yrs2 As Short() = cntx.GetYears(SeriesTable2).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    Dim DictTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable2, yrs2)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = getClosestYrVal(DictTbl2, yrs2, key, cntx.FirstYear, HistDist)
                        End If
                        CGovTotExp.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesGovTotalOutlaysGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGovtCalcExpendTotGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesGovtGenExpGDPFM", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, FMExp = s3.Value)

                        'jrs 2021/09/17 CGovTotExp.Add(item.Key, item.Value)
                        'FM primary
                        If Not CGovTotExp(item.Key).HasValue Then
                            CGovTotExp(item.Key) = item.FMExp
                        End If
                        'GFS secondary; may want to not use
                        If Not CGovTotExp(item.Key).HasValue Then
                            CGovTotExp(item.Key) = item.Value2
                        End If
                        'Use OECD primary
                        If Not CGovTotExp(item.Key).HasValue Then
                            CGovTotExp(item.Key) = item.Value
                        End If
                        If item.Key = "Ireland" And cntx.BaseYear = 2010 Then CGovTotExp(item.Key) = 46
                        '2010 in Ireland messed up because of bank bailout
                    Next
                End If

                For Each key In cntx.Regionalization.Keys
                    'If CGovTotExp(key) > 0.8 * CGDP(key) Then CGovTotExp(key) = CSng(0.8 * CGDP(key)) 'bbh 2021/09/21
                    If CGovTotExp(key) > 80 Then CGovTotExp(key) = 80  'bbh 2023/01/08 Above line was wrong because CGovTotExp is % and CGDP is $

                    If Not (CGovTotExp(key).HasValue) Then
                        CGovExpLocal.Add(key, 2 + 12 * Amin(20, CGDPPCP(key)) / 20)
                        CGovExp.Add(key, GovExpCentral(key) + CGovExpLocal(key)) 'Add Central plus local to get total
                    Else
                        CGovExpLocal.Add(key, AMAX(1, CGovTotExp(key) - GovExpCentral(key)))
                        CGovExp.Add(key, CGovTotExp(key))
                    End If
                Next
                'Another way to get to total govt expenditures would be to use only OECD data (not GFS) and for all
                '    other countries CGovExp(key)= govrevtot + (GovExpCentral-GovRevCen)
                'That is, assume that local govts have no fiscal imbalance of their own and that total imbalance
                '    is same as central imbalance (with pretty good WDI data)
                'One problem is that in 2017 we know China local has large deficits; probably not picked up in any of
                '    of our data anyway, but hate to foreclose possible future accounting for it.

                '   Make sure expenditures total cover GovCon
                '   --------------------------------------------------------------------
                Dim GConPercent As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                For Each key In cntx.Regionalization.Keys
                    ' bbh 2012/04/12  If/end below was commented out at one point without explanation
                    'so was perhaps a problem; but without it, countries like China had GovCon>GovExp
                    'In general, govcon and govexp seem low in data, so when there is problem, boost
                    GConPercent.Add(key, CGovCon(key) / CGDP(key) * 100)
                    If CGovExp(key) <= GConPercent(key) + 1 Then 'Make sure expenditures
                        'sufficiently above consumption for some transfer payments
                        CGovExp(key) = GConPercent(key) + 1
                    End If
                    'bbh 2012/01/24  'Will boost only Myanmar, where data is about 3% and not believable
                    CGovExp(key) = AMAX(CGovExp(key), 7)
                    CGovExp(key) = CGovExp(key) / 100 * CGDP(key) 'Convert to Dollars

                    'mti 2018/07/23 Start
                    'CGovExpLocal(key) = AMAX(1, CGovExp(key) - GovExpCentral )
                    CGovExpLocal(key) = AMAX(1, CGovExp(key) - GovExpCentral(key) / 100 * CGDP(key))
                    'mti 2018/07/23 End
                    'If key = "Canada" Then Stop

                    '   bbh 2017/04/21 END- revision of revenue and expenditure logics
                Next

                '   On to Revenue source specification
                '   Proceed by reading what know about corporate, indirect, SS/Welfare taxes as contributions
                '       to govt revenue and computing household taxes as residual
                '   IMF Total revenue data include foreign aid so need to back it out of tax collection
                '   ----------------------------------------------------------------------------------

                '       Compute firm and other tax rates as percent of total taxes
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesTaxCorpTot"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        CFirmTaxR.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesTaxCorpTot", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CFirmTaxR.Add(item.Key, item.Value)
                    Next
                End If

                Dim TbName2 As String
                'jrs 2024/06/18 TbName2$ = "GDP/Capita (PPP) Versus Corporate Tax % Of Total (" & CStr(cntx.BaseYear) & ")"
                TbName2$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Corporate Tax % of Total (" & CStr(cntx.BaseYear) & ")"
                TbName2$ = getFunctionNameYrOrMstRct(TbName2$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                Dim XYTBL2 As SeriesEstimator = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP)

                For Each key In cntx.Regionalization.Keys
                    If Not CFirmTaxR(key).HasValue Then
                        CFirmTaxR(key) = XYTBL2(key)
                    End If
                Next

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim Estimator As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus SS Tax % Of Total (1970)").ToEstimator(CGDPPCP)
                    Dim SeriesTable As String = "SeriesTaxSocSecCurRev"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = Estimator(key)
                        End If
                        CSSWelTaxR.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    'jrs 2025/05/08 TbName$ = "GDP/Capita (PPP) Versus SS Tax % Of Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus SS Tax % of Total (" & CStr(cntx.BaseYear) & ")"
                    'TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Dim XYTBL As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesTaxSocSecCurRev", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CSSWelTaxR.Add(item.Key, item.Value)
                        If Not CSSWelTaxR(item.Key).HasValue Then
                            CSSWelTaxR(item.Key) = XYTBL(item.Key)
                        End If
                    Next
                End If

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim Estimator As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Indirect Tax % Of Total (1970)").ToEstimator(CGDPPCP)
                    Dim SeriesTable As String = "SeriesTaxGoodSerCurRev"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = Estimator(key)
                        End If
                        CIndirectTaxR.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    'jrs 2024/06/10 TbName$ = "GDP/Capita (PPP) Versus Indirect Tax % Of Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Indirect Tax % of Total (" & CStr(cntx.BaseYear) & ")"
                    'TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Dim XYTBL As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesTaxGoodSerCurRev", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CIndirectTaxR.Add(item.Key, item.Value)
                        If Not CIndirectTaxR(item.Key).HasValue Then
                            CIndirectTaxR(item.Key) = XYTBL(item.Key)
                        End If
                    Next
                End If

                'bbh 2019/09/13 *** begin ***
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesTaxImportDutiesRev"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = 10
                        End If
                        CTariffTaxR(key) = ValHold
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesTaxImportDutiesRev", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        'bbh 2019/10/25 start
                        'bbh 2019/10/28 start 'Eliminating effort to fill holes with WDI data; sets up large shift factors in model because dyadic model brings in 0s
                        'for any country with holes
                        If Not CTariffTaxR(item.Key).HasValue Then 'try to fill holes in series from dyadic data above from WDI table (e.g. Botswana, Swaziland)
                            CTariffTaxR(item.Key) = 0
                        End If
                        'CTariffTaxR(item.Key) = item.Value
                        'If Not CTariffTaxR(item.Key).HasValue Then 'still null, fill with approximate global average rate
                        '    CTariffTaxR(item.Key) = 5
                        'End If
                        '       It appears in analysis against OECD data that tariff tax rates from WDI are actually shares of central govt revenue/not total,
                        '           so need adjustment of central govt rate downward to be used in analysis against general govt revenues in preprocessor and model
                        '          CGovRevLocal is still %, will be converted further down to billion $
                        'CTariffTaxR(item.Key) = CTariffTaxR(item.Key) * (GovRevPerSave(item.Key) - CGovRevLocal(item.Key)) / AMAX(0.01, GovRevPerSave(item.Key))
                        'CTariffTaxR(item.Key) = Amin(CTariffTaxR(item.Key), 50) 'WDI series for some like Lesotho are 60 or above
                        'Else 'convert calculation from earlier read of dyadic data from billion dollars to share of govt revenue
                        CTariffTaxR(item.Key) = CTariffTaxR(item.Key) / (CGDP(item.Key) * GovRevPerSave(item.Key) / 100) * 100 'Here GovRevPerSave is % of GDP, need GovRev
                        'End If
                        'bbh 2019/10/28 end
                        'bbh 2019/10/25 end
                    Next
                End If
                'bbh 2019/09/13 *** end ***

                'jrs 2026/04/08 *** start ****
                'Reading data for Tax Income as % of Total Revenue
                'before we were assuming 100%, meaning all Revenue comming from Taxes
                'but not the case for countries like Kuwait or Norway
                'Including Social Contributions in tax revenue
                Dim CGovTaxAsPctTotRev As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                For Each item In (From s In cntx.GetSlice("SeriesGovRevGenTaxRevGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Join s2 In cntx.GetSlice("SeriesGovRevGenTotRevGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                  Join s3 In cntx.GetSlice("SeriesGovRevGenSocialConGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                  Join s4 In cntx.GetSlice("SeriesGovRevGenTaxIncIGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s4.Key
                                  Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = If(s3.Value, 0), Value4 = s4.Value)
                    If item.Value4.HasValue AndAlso item.Value2.HasValue AndAlso item.Value2 > 0 Then
                        CHHTaxR.Add(item.Key, item.Value4 / item.Value2 * 100)
                    Else
                        CHHTaxR.Add(item.Key, Nothing)
                    End If
                    If item.Value.HasValue AndAlso item.Value2.HasValue AndAlso item.Value2 > 0 Then
                        CGovTaxAsPctTotRev.Add(item.Key, (item.Value + item.Value3) / item.Value2 * 100)
                        CGovTaxAsPctTotRev(item.Key) = Amin(100, CGovTaxAsPctTotRev(item.Key)) 'Make sure tax share of total revenue is not above 100%)
                    Else
                        CGovTaxAsPctTotRev.Add(item.Key, 100)
                    End If
                Next

                'jrs 2026/04/08 *** end ****

                Dim OtherTax As Single?
                For Each key In cntx.Regionalization.Keys
                    'If key = "France" Then Stop
                    '   bbh 2019/10/12 start
                    '       It appears in analysis against OECD data that tariff tax rates from WDI are actually shares of central govt revenue/not total,
                    '           so need adjustment of central govt rate downward to be used in analysis against general govt revenues in preprocessor and model
                    '          CGovRevLocal is still %, will be converted further down to billion $
                    'CTariffTaxR(key) = CTariffTaxR(key) * (GovRevPerSave(key) - CGovRevLocal(key)) / AMAX(0.01, GovRevPerSave(key))
                    '   bbh 2019/10/12 end

                    'bbh2019/09/13 CHHTaxR.Add(key, 100 - CFirmTaxR(key) - CIndirectTaxR(key) - CSSWelTaxR(key))
                    'jrs 2026/04/08 CHHTaxR.Add(key, 100 - CFirmTaxR(key) - CIndirectTaxR(key) - CSSWelTaxR(key) - CTariffTaxR(key))
                    If Not CHHTaxR(key).HasValue Then
                        CHHTaxR(key) = CGovTaxAsPctTotRev(key) - CFirmTaxR(key) - CIndirectTaxR(key) - CSSWelTaxR(key) - CTariffTaxR(key)
                    End If
                    'Household taxes as residual % of total govt revenue
                    'have left out nontax revenue
                    'If key = "Mali" Then Stop
                    If CHHTaxR(key) < 1 Then
                        'Make sure household share of total taxes is at least 1%
                        'OtherTax = CFirmTaxR(key) + CIndirectTaxR(key) + CSSWelTaxR(key) 'bbh 2019/09/13 2 lines
                        OtherTax = CFirmTaxR(key) + CIndirectTaxR(key) + CSSWelTaxR(key) + CTariffTaxR(key)

                        'mti 2016/10/20 start - change from % of GDP to % of Rev; affects only Spain and Poland (v 7.26)
                        '            CFirmTaxR(key) = CFirmTaxR(key) * (GovRevPer - 1) / OtherTax
                        '            CSSWelTaxR(key) = CSSWelTaxR(key) * (GovRevPer - 1) / OtherTax
                        '            CIndirectTaxR(key) = CIndirectTaxR(key) * (GovRevPer - 1) / OtherTax

                        CFirmTaxR(key) = CFirmTaxR(key) * 99 / OtherTax
                        CSSWelTaxR(key) = CSSWelTaxR(key) * 99 / OtherTax
                        CIndirectTaxR(key) = CIndirectTaxR(key) * 99 / OtherTax
                        CTariffTaxR(key) = CTariffTaxR(key) * 99 / OtherTax 'bbh 2019/09/13

                        CHHTaxR(key) = 1
                        'mti 2016/10/20 end
                    End If
                Next

                '   On to Expenditure calcuation for transfer payments
                '   bbh 2011/12/22
                '   Read Total Subsidies and other Transfers, Includes Social Security and Social Assistance Benefits,
                '       also includes grants to foreign govts and IOs, employer social benefits, tranfers to private
                '       and public enterprises; this is Total Transfers cateegory like GovCon is total consumption
                '   -------------------------------------------------------------------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesGovSSWelBenExp"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        CGovSSWel.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesGovSSWelBenExp", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CGovSSWel.Add(item.Key, item.Value)
                    Next
                End If

                'mti 2016/10/20 Fix Transfer Function in Pre-Processor Start
                TbName2$ = "GDP/Capita (PPP 2011) Versus Transfers (Pension and Welfare) as % GDP (" & CStr(cntx.BaseYear) & ") Log"
                TbName2$ = getFunctionNameYrOrMstRct(TbName2$, cntx.BaseYear, cntx)
                XYTBL2 = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP)

                For Each key In cntx.Regionalization.Keys
                    If Not CGovSSWel(key).HasValue Then
                        CGovSSWel(key) = XYTBL2(key)
                        CGovSSWel(key) = AMAX(2, CGovSSWel(key))
                        '       Possibly use similar logic to that in pensions below to handle lowest income countries
                        CGovSSWel(key) = CGovSSWel(key) / 100 * CGDP(key) 'Result in dollars; function as % of GDP
                    Else
                        CGovSSWel(key) = CGovSSWel(key) / 100 * CGovExp(key) 'Result in dollars; table as % of expenditure

                        'mti 2018/07/23 Start
                        '            If key = "South Africa" Then Stop
                        'sgh 2018/08/28 change 0.35 to 0.45 so the warning doesn't go off
                        '            If CGovSSWel(key) > 0.35 * CGDP(key) Then
                        If CGovSSWel(key) > 0.45 * CGDP(key) Then
                            Dim msg As String
                            'this is welfare plus pension
                            msg$ = "Important Warning:  Value for transfer spending "
                            msg$ = msg$ + " of " + key + " is "
                            msg$ = msg$ + " too high. Please check data series."
                            Debug.Print(msg$)
                        End If
                        'mti 2018/07/23 End
                    End If

                    'bbh 2022/08/30 If-then below: Although poor form to make country-specific additions to code, Micronesia is unusual situation because
                    '   US is giving about 1/4 of GDP to country as aid ($100 million) and that is going to govt revenues; some could be going to a trust fund for use post 2024, but
                    '   high C/GDP ratio and limited household earnings suggest most is going to transfer payments; our data have null values in SeriesGovSSWelBen%Exp for them
                    '   and values for GovExp that are about the same amount too low
                    If key = "Micronesia" Then
                        CGovExp(key) = CGovExp(key) + 25.0! / 100 * CGDP(key)
                        CGovSSWel(key) = 25.0! / 100 * CGDP(key)
                    End If
                Next

                '   Reconcile often very bad data on total expenditures, goverment consumption and transfers
                '       Give priority to Govcon because need to cover all of the consumption spelled out by category
                '   -------------------------------------------------------------------------------------------------
                '       Note:  In Economy.bas, AID only affects GOVBAL, not GOVEXP directly
                '       Govcon+SSWEL=GOVEXP; give priority first to boosting Govcon, then reducing sswel, then boosting Govexp
                'i.e. protext all of govcon and boost if possible; reduce sswel as needed; reduce govexp after sswel

                Dim Unused As Single?, Overspend As Single?
                For Each key In cntx.Regionalization.Keys
                    If CGovSSWel(key) + CGovCon(key) < CGovExp(key) Then 'boost govcon, need headroom later

                        'mti 2016/10/10 Start
                        Unused = CGovExp(key) - (CGovSSWel(key) + CGovCon(key))
                        CGovSSWel(key) = CGovSSWel(key) + CSng(Unused * 0.4)
                        'mti 2016/10/10 End

                        CGovCon(key) = CGovExp(key) - CGovSSWel(key)


                        'If key = "Canada" Then Stop
                    ElseIf (CGovSSWel(key) + CGovCon(key) > CGovExp(key)) Then
                        Overspend = (CGovSSWel(key) + CGovCon(key)) - CGovExp(key)
                        If Overspend <= CGovSSWel(key) Then
                            CGovSSWel(key) = CGovSSWel(key) - Overspend
                        Else
                            CGovExp(key) = AMAX(0.001F, CGovCon(key) + (Overspend - CGovSSWel(key)))
                            CGovSSWel(key) = 0
                        End If
                    End If
                Next

                '   Read Pension Spending and Fill Holes; this is subset of total CGovSSWel transfers, above
                '   ------------------------------------------------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesGovtPensionGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        CGovHHPenT.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End	
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesGovtPensionGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CGovHHPenT.Add(item.Key, item.Value)
                    Next
                End If

                'jrs 2024/07/04 TbName2$ = "GDP/Capita (PPP) Versus Public Pension % of GDP (" & CStr(cntx.BaseYear) & ")"
                TbName2$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Public Pension % of GDP (" & CStr(cntx.BaseYear) & ")"
                TbName2$ = getFunctionNameYrOrMstRct(TbName2$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                Dim govtpensions8 As Single?
                Dim CGDPPCP8 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                CGDPPCP8.Add("8", 8)
                XYTBL2 = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP8)
                govtpensions8 = XYTBL2("8")
                XYTBL2 = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP)
                Dim resbal As Single?, expendtot As Single?, NormFac As Single?
                For Each key In cntx.Regionalization.Keys
                    'bbh 2011/12/17  Block below was in both history and future blocks above; routine too large
                    '       so moved it here; when split routine, move back into both
                    If Not (CGovHHPenT(key).HasValue) Then
                        'jrs 2006/12/14 Call XYTABL("GDP/Capita (PPP) Versus Public Pension % of GDP (2000)", _
                        'CGDPPCP(key), CGovHHPenT(key))
                        CGovHHPenT(key) = XYTBL2(key)
                        'bbh 2011/12/17
                        If CGDPPCP(key) < 8 Then
                            CGovHHPenT(key) = govtpensions8 - 6 * (8 - CGDPPCP(key)) / 8
                            'interpolate from 2% to govtpensions8 as GDPPCP rises from from 0 to $8,000
                            'log function in TbName$ falls too steeply at bottom end
                        End If
                    End If
                    '        CGovHHPenT(key) = Amin(CGovHHPenT(key), 0.7 * CGovSSWel(key))
                    CGovHHPenT(key) = Amin(CSng(CGovHHPenT(key) / 100 * CGDP(key)), CSng(0.99 * CGovExp(key)))
                    'conversion to dollars
                    CGovHHPenT(key) = AMAX(CGovHHPenT(key), CSng(0.001 * CGDP(key)))
                    CGovHHPenT(key) = Amin(CGovHHPenT(key), CSng(0.6 * CGovSSWel(key)))
                    'Typically pension expenditures are about 1/3 of total transfers

                    '
                    '   Now have final CGOVCON
                    '   Normalize Expenditure Components to 100% - (X-M)
                    '   ------------------------------------------------
                    CGCon(key) = CGovCon(key) / CGDP(key) * 100 ' Convert back to %
                    'If key = "Canada" Then Stop
                    'If key = "Luxembourg" Then Stop

                    'jrs 2020/02/19 added Round to 4 in the numerator and denominator for problems comparing singles with too much precision
                    'Found it with Djibouti
                    resbal = CSng(Math.Round(CDbl(exports(key) - cimports(key)), 4) / Math.Round(CDbl(CGDP(key)), 4) * 100)
                    'If key = "Singapore" Then Stop
                    expendtot = CPCON(key) + CGCon(key) + CINVEST(key)
                    NormFac = 100 - resbal 'Have Assured earlier than ResBal < 80
                    'If key = "United States Of America" Or key = "Kiribati" Then Stop
                    'If key = "United States Of America" Then Stop
                    'bbh 2011/12/22
                    'Protect GovCon because need values fed to it by things like military spending
                    'Debug.Print(key & ", " & CStr(NormFac / expendtot))
                    If NormFac >= expendtot Then 'Increasing components
                        CPCON(key) = CPCON(key) * NormFac / expendtot * CGDP(key) / 100
                        CGCon(key) = CGCon(key) * NormFac / expendtot * CGDP(key) / 100
                        CINVEST(key) = CINVEST(key) * NormFac / expendtot * CGDP(key) / 100
                    Else 'Reducing components except CGCON
                        expendtot = CPCON(key) + CINVEST(key)
                        NormFac = 100 - resbal - CGCon(key) 'Have Assured earlier than ResBal < 80
                        CPCON(key) = CPCON(key) * NormFac / expendtot * CGDP(key) / 100 'To dollars
                        CINVEST(key) = CINVEST(key) * NormFac / expendtot * CGDP(key) / 100
                        CGCon(key) = CGCon(key) * CGDP(key) / 100 ' to dollars
                    End If
                    'If key = "Liberia" Then Stop
                    'If key = "Canada" Then Stop
                    CGovExp(key) = CGovSSWel(key) + CGCon(key) 'In dollars
                    'bbh 2013/01/23 Start
                    CGovRevLocal(key) = CGovRevLocal(key) * CGDP(key) / 100  ' to dollars
                    CGovExpLocal(key) = CGovExpLocal(key) * CGDP(key) / 100  ' to dollars
                    CGovRevLocal(key) = Amin(CGovRevLocal(key), CSng(0.5 * GovRevPerSave(key) * CGDP(key) / 100)) 'bbh 2017/05/21
                    CGovExpLocal(key) = Amin(CGovExpLocal(key), CSng(0.5 * CGovExp(key)))
                    'bbh 2013/01/23 end
                    CGovCon(key) = CGCon(key) / CGDP(key) * 100
                    'CGCON now in dollars; CGOVCON now in %
                Next

                '
                '   Split Government Consumption and Investment into Sectors of Origin
                '   ------------------------------------------------------------------
                'bbh 2024/05/24 Tie Manu/Serv shares of CGCon and CINVEST to Availability - Start
                'For Each key In cntx.Regionalization.Keys
                '    GMN.Add(key, CSng(0.1 * CGCon(key)))
                '    GSR.Add(key, CSng(0.9 * CGCon(key)))
                '    IMN.Add(key, CSng(CINVEST(key) * 0.5))
                '    ISR.Add(key, CSng(CINVEST(key) * 0.5))
                'Next
                Dim ManuforCon As Single?, ServforCon As Single?, ManuforConShr As Single?
                For Each key In cntx.Regionalization.Keys
                    ManuforCon = (CSng(ValAdd(key)(Manu) + MMN(key) - XMN(key)))
                    ServforCon = (CSng(ValAdd(key)(Serv) + MSR(key) - XSR(key)))
                    'jrs 2026/09/18
                    If ManuforCon < 0 And ServforCon < 0 Then
                        ManuforCon = 1
                        ServforCon = 1
                    ElseIf ManuforCon < 0 Then
                        ManuforCon = ServforCon / 100
                    ElseIf ServforCon < 0 Then
                        ServforCon = ManuforCon / 100
                    End If
                    ManuforConShr = ManuforCon / (ManuforCon + ServforCon)
                    GMN.Add(key, CSng(ManuforConShr * CGCon(key)))
                    GSR.Add(key, CSng((1 - ManuforConShr) * CGCon(key)))
                    IMN.Add(key, CSng(CINVEST(key) * ManuforConShr))
                    ISR.Add(key, CSng(CINVEST(key) * (1 - ManuforConShr)))
                    'If key = "Singapore" Then Stop
                Next
                'bbh 2024/05/24 Tie Manu/Serv shares of CGCon and CINVEST to Availability - End


                '
                '   Split Personal Consumption into Sectors - Use Value Added and AMAT
                '   ------------------------------------------------------------------
                Dim RowSum As Single?, ZcompAg As Single?, PFDCompAg As Single?, CCompAg As Single?
                Dim ZcompEn As Single?, PFDCompEn As Single?, CCompEn As Single? 'bbh 2024/06/22
                Dim ZcompMa As Single?, PFDCompMa As Single?, CCompMa As Single? 'bbh 2024/06/22
                Dim ZcompMn As Single?, PFDCompMn As Single?, CCompMn As Single?
                pcons = New Dictionary(Of String, Single?())
                Dim ZcompSr As Single?, PFDCompSr As Single?, CCompSr As Single?
                Dim ZcompICT As Double?, PFDCompICT As Double?, CCompICT As Double?

                For Each key In cntx.Regionalization.Keys
                    'If key = "Singapore" Then Stop
                    RowSum = 0
                    For SCount% = 1 To cntx.NSec
                        RowSum = RowSum + AMatCountry(key)(Agri, SCount%)
                    Next SCount%
                    ZcompAg = ValAdd(key)(Agri) / (1 - AMAX(0.001F, RowSum))
                    PFDCompAg = ZcompAg - ZcompAg * RowSum
                    CCompAg = PFDCompAg + MAG(key) - XAG(key)
                    Dim ValAddVals(6) As Single?
                    pcons.Add(key, ValAddVals)
                    pcons(key)(Agri) = Amin(55.0F, AMAX(1.5F, CCompAg / CPCON(key) * 100)) 'bbh 2021/04/29
                    'pcons(key)(Agri) = Amin(70.0F, AMAX(1.5F, CCompAg / CPCON(key) * 100))

                    'bbh 2024/06/22 start Add same logic for sectoral consumption to energy and materials sectors
                    'If key = "Taiwan" Then Stop
                    RowSum = 0
                    For SCount% = 1 To cntx.NSec
                        RowSum = RowSum + AMatCountry(key)(Ener, SCount%)
                    Next SCount%
                    ZcompEn = ValAdd(key)(Ener) / (1 - AMAX(0.001F, RowSum))
                    PFDCompEn = ZcompEn - ZcompEn * RowSum
                    CCompEn = PFDCompEn + MEN(key) - XEN(key)
                    pcons(key)(Ener) = Amin(10.0F, AMAX(1.5F, CCompEn / CPCON(key) * 100))
                    'If key = "India" Then Stop

                    RowSum = 0
                    For SCount% = 1 To cntx.NSec
                        RowSum = RowSum + AMatCountry(key)(Mate, SCount%)
                    Next SCount%
                    ZcompMa = ValAdd(key)(Mate) / (1 - AMAX(0.001F, RowSum))
                    PFDCompMa = ZcompMa - ZcompMa * RowSum
                    CCompMa = PFDCompMa + MMA(key) - XMA(key)
                    pcons(key)(Mate) = Amin(10.0F, AMAX(1.5F, CCompMa / CPCON(key) * 100))
                    'bbh 2024/06/22 End Add same logic for sectoral consumption to energy and materials sector

                    RowSum = 0
                    For SCount% = 1 To cntx.NSec
                        RowSum = RowSum + AMatCountry(key)(Manu, SCount%)
                    Next SCount%
                    ZcompMn = ValAdd(key)(Manu) / (1 - AMAX(0.001F, RowSum))
                    PFDCompMn = ZcompMn - ZcompMn * RowSum
                    'bbh 2014/07/29 start ArmsIm removed below because based on SeriesArmsImp%TotImp which has
                    'huge numbers (probably the dollar value not %; needs correction)
                    CCompMn = PFDCompMn + MMN(key) - XMN(key)
                    'Arms imports should be govt consumption, not household
                    ' CCompMn = PFDCompMn + MMN(key) - ArmsIm(key) - XMN(key)
                    'bbh 2014/07/29  end
                    'Arms imports should be govt consumption, not household
                    'If key = "India" Then Stop
                    'pcons(key)(Manu) = AMAX(15, (CCompMn - GMN(key) - IMN(key)) / CPCON(key) * 100) 'bbh 2021/04/29
                    pcons(key)(Manu) = AMAX(5, (CCompMn - GMN(key) - IMN(key)) / CPCON(key) * 100) 'bbh 2024/05/24 reverse change in line above change
                    'If key = "Luxembourg" Then Stop

                    RowSum = 0
                    For SCount% = 1 To cntx.NSec
                        RowSum = RowSum + AMatCountry(key)(Serv, SCount%)
                    Next SCount%
                    ZcompSr = ValAdd(key)(Serv) / (1 - AMAX(0.001F, RowSum))
                    PFDCompSr = ZcompSr - ZcompSr * RowSum
                    CCompSr = PFDCompSr + MSR(key) - XSR(key)
                    pcons(key)(Serv) = AMAX(20, (CCompSr - GSR(key) - ISR(key)) / CPCON(key) * 100) 'bbh 2021/04/29
                    'pcons(key)(Serv) = AMAX(10, (CCompSr - GSR(key) - ISR(key)) / CPCON(key) * 100)
                    'bbh 2020/04/09 start
                    RowSum = 0
                    For SCount% = 1 To NSec%
                        RowSum = RowSum + AMatCountry(key)(ICT, SCount%)
                    Next SCount%
                    ZcompICT = ValAdd(key)(ICT) / (1 - AMAX(0.001, RowSum))
                    PFDCompICT = ZcompICT - ZcompICT * RowSum
                    CCompICT = PFDCompICT + MIC(key) - XIC(key)
                    pcons(key)(ICT) = CSng(Amin(10, AMAX(1, CCompICT / CPCON(key) * 100)))
                Next

                '
                '   Split Personal Consumption into Sectors
                '   ---------------------------------------
                Dim ComputedPCONS As Single?, MaximumPCONS As Single?, PConTot As Single?
                For Each key In cntx.Regionalization.Keys
                    'bbh 2024/06/22 Start: Remove energy logic from here; added energy and materials above like other sectors
                    'pcap = CGDP(key) / CPOP(key)
                    ''        pcons(key)(Agri) = AMAX(60 - 50 * GDPLevel, 5)
                    'pcons(key)(Ener) = 5
                    'If XEN(key) / CGDP(key) > 0.1 Then 'Big exporters also consume heavily
                    '    pcons(key)(Ener) = Amin(10, CSng(5 + 0.5 * (XEN(key) / CGDP(key) - 0.1) * 100))
                    'End If

                    ''If key = "Iraq" Then Stop

                    'ComputedPCONS = CPCON(key) * pcons(key)(Ener) / 100
                    'MaximumPCONS = CSng(AppConEn(key) * WorldEP * 0.6) 'Price of Energy
                    ''If key = "Luxembourg" Then Stop
                    ''Residential and transportation about 60%; industrial is remainder
                    ''bbh 2014/04/08 start; moving away from 5% PCONS, energy; not nearly enough for Ukraine, India, etc.
                    'If ComputedPCONS > MaximumPCONS Then 'Scale back PCON, energy
                    '    '-- actually MaximumPCONS should be reasonable target
                    '    pcons(key)(Ener) = MaximumPCONS / CPCON(key) * 100
                    'Else 'Boost PCONS, but not too much; don't want it to take over C
                    '    pcons(key)(Ener) = AMAX(pcons(key)(Ener), (ComputedPCONS + MaximumPCONS) / 2 / CPCON(key) * 100)
                    'End If
                    ''bbh 2014/04/08 end
                    'bbh 2024/06/22  End: energy logic here; added energy and materials above like other sectors

                    'pcons(key)(Manu) = (20 + 20 * GDPLevel)
                    'pcons(key)(Serv) = (15 + 30 * GDPLevel)
                    '        pcons(key)(Manu) = (10 + 20 * GDPLevel)
                    '        pcons(key)(Serv) = (25 + 30 * GDPLevel)
                    'pcons(key)(ICT) = CSng(ICTShare(key) * 1.5 / 100 * (pcons(key)(Manu) + pcons(key)(Serv)))
                    ''Temporary ICT Calc
                    'pcons(key)(Manu) = CSng((1 - ICTShare(key) * 1.5 / 100) * pcons(key)(Manu))
                    'pcons(key)(Serv) = CSng((1 - ICTShare(key) * 1.5 / 100) * pcons(key)(Serv))
                    PConTot = 0
                    For jCount% = 1 To cntx.NSec
                        PConTot = PConTot + If(pcons(key)(jCount%), 0)
                    Next jCount%
                    'bbh 2020/04/09 end

                    'If key = "Ukraine" Or key = "Albania" Or key = "Armenia" Then Stop
                    'If key = "Luxembourg" Then Stop
                    'If key = "Singapore" Then Stop
                    For jCount% = 1 To cntx.NSec
                        pcons(key)(jCount%) = pcons(key)(jCount%) / PConTot * CPCON(key)
                    Next jCount%
                Next

                'BBH 2022/06/23 START OF BIG INCLUSIVE BLOCK; Jose, I suggest you look for bottom of this and take all; great many changes
                '   BBH 8/5/04 Begin
                '
                '   Social Accounting Matrix Stocks.  Begin with Stocks because some needed for flows
                '       Start with external firm debt (XFIRMDEBT) as sum of
                '           an arbitary share (50%) of Public and Publically Guaranteeed
                '           and all Private non-guaranteed debt.
                '           How should PPG debt be divided; probably public share highest for poor?
                '       External firm debt is assigned to rich countries as asset by GDP.
                '       Move to XWBLOANS and XIMFCREDIT, allocating known funding for LDCs back to
                '           devloped countries.
                '           IFI debt is assigned to rich countries as asset by GDP.
                '           The use of a multiplier effect introduces a small
                '           global imbalance in intl stock accounts; probably should be removed.
                '       Note on 2015/01/25:  WB Intl Debt Stats is now open and has quarterly external
                '           and public sector debt for high-income countries.  Should revsit process below.
                '       Then go to total external debt (XDEBTRPA)
                '           (as did with total intl trade earlier) because want
                '           global balance between assets and liabilities and becuase total external
                '           debt is encompassing concept.
                '       The key data series for XDEBTRPA covers only debtors, so must assign to creditors.
                '           Compute integration of current account over time for creditors (XDEBTACC).
                '           Use that to fill credit side holes in XDEBTRPA series.
                '           Before computing global balance on SDEBTRPA,
                '           we make sure both XFIRMDEBT and IFI debt/credits are covered for each
                '           country.
                '           Will replace XDEBTACC with data (e.g. integrated BIS/WB/IMF/OECD data)
                '               as available but even that does not include Saudi Arabia, Kuwait, etc.
                '       Calculate external govt debt (XGOVTDEBT) as total external (XDEGBTRPA)
                '           minus external firm debt (XFIRMDEBT) - leaves out households
                '       Have data on total govt debt (GOVDEBT) which includes external, so compute
                '           domestic debt (GOVTDEBTD) as residual (if XGOVTDEBT larger than GOVTDEBT,
                '           making residual 0, and pushing GOVTDEBT up to gover external.
                '       Compute also "basic" external government debt (XGOVTDEBTB) as total external minus
                '           debt to IFIs (XWBLOANS and XIMFCREDIT).  Because IFI stocks not globally
                '           balanced, XGOVDEBTB starts with small global imbalance that grows with run.
                '       In model, use current account to drive changes in govt debt (XGOVTDEBTF) and
                '           then XGOVTDEBTB.  In model add dynamically changing XWBLOANS and XIMFCREDIT to get
                '           total external govt debt (XGOVTDEBT).
                '       Integrate FDI inflows and outflows over time to compute stocks of FDI;
                '           do basic balancing, but do not link in any way to external debt
                '       Integrate portfolio flows to compute inward stocks; allocate outward stocks
                '           to rich countries by GDP.  Do not link to external debt.
                '
                '   SAM Stocks: Start with World Bank and IMF Loans and Credits - Want to be
                '       sure that external debt/assets cover known values
                '   ----------------------------------------------------
                'This is stock series; e.g. Cape Verde aout 15%; some country
                'earlier values even 50% plus
                Dim yrsWBLoansTbl As Short() = cntx.GetYears("SeriesXWBLoansGDP").OrderBy(Function(y) y).ToArray()
                Dim WBLoansTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXWBLoansGDP", yrsWBLoansTbl)

                'Again stock, e.g. big swings for Argentina as much as 12% of GDP
                Dim yrsIMFCreditTbl As Short() = cntx.GetYears("SeriesXIMFCreditGDP").OrderBy(Function(y) y).ToArray()
                Dim IMFCreditTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXIMFCreditGDP", yrsIMFCreditTbl)

                'Set GDPTbl = db2.OpenRecordset("SeriesGDP95")
                'jrs 2007/11/28
                'mti 2014/08/20 - start
                '    Set GDPTbl = db2.OpenRecordset("SeriesGDP2005")
                'Set GDPTbl = db2.OpenRecordset("SeriesGDP2011")
                Dim yrsGDPTbl As Short() = cntx.GetYears("GDP" & ConstantDollarsYear.ToString).OrderBy(Function(y) y).ToArray()
                Dim GDPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("GDP" & ConstantDollarsYear.ToString, yrsGDPTbl)

                'mti 2014/08/20 - end

                Dim GloXIMFDebt As Single? = 0
                Dim GloXWBDebt As Single? = 0
                Dim AdvGDPXIMFDebt As Single? = 0
                Dim AdvGDPXWBDebt As Single? = 0

                Dim GDPANN As Single?
                Dim PerCap As Single?

                For Each key In cntx.Regionalization.Keys

                    '
                    '       Read WB Loans as % of GDP and fill holes
                    '       ----------------------------------------

                    CXWBLOANS.Add(key, 0)
                    If cntx.HistoricMode Then
                        'mti 2019/04/29  Flex Hist Base Start
                        'CXWBLOANS(key) = WBLoansTbl.Fields("Earliest")
                        CXWBLOANS(key) = getClosestYrVal(WBLoansTbl, yrsWBLoansTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                        'mti 2019/04/29  Flex Hist Base Start
                        'GDPANN = GDPTbl.Fields("Earliest")
                        GDPANN = getClosestYrVal(GDPTbl, yrsGDPTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                        If Not CXWBLOANS(key).HasValue Or Not GDPANN.HasValue Then
                            CXWBLOANS(key) = 0
                        Else
                            GDPANN = GDPANN * CGDPAdj(key)
                            CXWBLOANS(key) = CXWBLOANS(key) / 100 * GDPANN
                        End If
                    Else
                        'jrs 2006/11/29 const to vars CXWBLOANS(key) = WBLoansTbl.Fields("2000")
                        CXWBLOANS(key) = getYearOrMstRct(WBLoansTbl, yrsWBLoansTbl, key, BaseYear)
                        'jrs 2006/11/29 const to vars GDPANN = GDPTbl.Fields("2000")
                        GDPANN = getYearOrMstRct(GDPTbl, yrsGDPTbl, key, BaseYear)
                        If Not CXWBLOANS(key).HasValue Or Not GDPANN.HasValue Then
                            CXWBLOANS(key) = 0
                        Else
                            GDPANN = GDPANN * CGDPAdj(key)
                            CXWBLOANS(key) = CXWBLOANS(key) / 100 * GDPANN
                        End If
                    End If
                    GloXWBDebt = GloXWBDebt + CXWBLOANS(key)
                    PerCap = CGDP(key) / CPOP(key)
                    If PerCap > 10 And CXWBLOANS(key) <= 0.001 Then
                        AdvGDPXWBDebt = AdvGDPXWBDebt + CGDP(key)
                    End If

                    '
                    '       Read IMF Credit as % of GDP and fill holes
                    '       ----------------------------------------

                    If cntx.HistoricMode Then
                        'mti 2019/04/29  Flex Hist Base Start
                        'CXIMFCREDIT(key) = IMFCreditTbl.Fields("Earliest")
                        CXIMFCREDIT(key) = getClosestYrVal(IMFCreditTbl, yrsIMFCreditTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                        'mti 2019/04/29  Flex Hist Base Start
                        'GDPANN = GDPTbl.Fields("Earliest")
                        GDPANN = getClosestYrVal(GDPTbl, yrsGDPTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                        If Not CXIMFCREDIT(key).HasValue Or Not GDPANN.HasValue Then
                            CXIMFCREDIT(key) = 0
                        Else
                            GDPANN = GDPANN * CGDPAdj(key)
                            CXIMFCREDIT(key) = CXIMFCREDIT(key) / 100 * GDPANN
                        End If
                    Else
                        'jrs 2006/11/29 const to vars CXIMFCREDIT(key) = IMFCreditTbl.Fields("2000")
                        CXIMFCREDIT(key) = getYearOrMstRct(IMFCreditTbl, yrsIMFCreditTbl, key, BaseYear)
                        'jrs 2006/12/01 const to vars GDPANN = GDPTbl.Fields("MostRecent")
                        GDPANN = getYearOrMstRct(GDPTbl, yrsGDPTbl, key, BaseYear)
                        If Not CXIMFCREDIT(key).HasValue Or Not GDPANN.HasValue Then
                            CXIMFCREDIT(key) = 0
                        Else
                            GDPANN = GDPANN * CGDPAdj(key)
                            CXIMFCREDIT(key) = CXIMFCREDIT(key) / 100 * GDPANN
                        End If
                    End If
                    GloXIMFDebt = GloXIMFDebt + CXIMFCREDIT(key)
                    PerCap = CGDP(key) / CPOP(key)
                    If PerCap > 10 And CXIMFCREDIT(key) <= 0.001 Then
                        AdvGDPXIMFDebt = AdvGDPXIMFDebt + CGDP(key)
                    End If

                Next


                '   Allocate World Bank Loans to Advanced Countries
                '   -----------------------------------------------

                For Each key In cntx.Regionalization.Keys
                    PerCap = CGDP(key) / CPOP(key)
                    If PerCap > 10 And CXWBLOANS(key) <= 0.001 Then
                        CXWBLOANS(key) = -CGDP(key) / AdvGDPXWBDebt * (GloXWBDebt / AMAX(1, sxwblneqr))
                    End If

                    If CXWBLOANS(key) < 0 Then 'lenders
                        CXWBSUBF(key) = -CXWBLOANS(key) * sxwbloanr / 100
                    Else
                        CXWBSUBF(key) = 0
                    End If
                Next key

                '   Allocate IMF Credits to Advanced Countries by Economic Size
                '   -----------------------------------------------------------

                For Each key In cntx.Regionalization.Keys
                    PerCap = CGDP(key) / CPOP(key)
                    If PerCap > 10 And CXIMFCREDIT(key) <= 0.001 Then
                        CXIMFCREDIT(key) = -CGDP(key) / AdvGDPXIMFDebt * (GloXIMFDebt / AMAX(1, sximfcreqr))
                    End If

                    If CXIMFCREDIT(key) < 0 Then 'lenders
                        CXIMFSUBF(key) = -CXIMFCREDIT(key) * sximfcreditr / 100
                    Else
                        CXIMFSUBF(key) = 0
                    End If
                Next key
                '
                '   Move to firm or private external debt
                '       Want to make sure total external debt/assets will cover
                '   -----------------------------------------------------------

                Dim yrsGovDebtPPGTbl As Short() = cntx.GetYears("SeriesXDEBTPPGGDP").OrderBy(Function(y) y).ToArray()
                Dim GovDebtPPGTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXDEBTPPGGDP", yrsGovDebtPPGTbl)

                Dim yrsGovDebtPNGTbl As Short() = cntx.GetYears("SeriesXDEBTPNGGDP").OrderBy(Function(y) y).ToArray()
                Dim GovDebtPNGTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXDEBTPNGGDP", yrsGovDebtPNGTbl)


                'mti 2014/08/20 - start
                'Set GDPTbl = db2.OpenRecordset("SeriesGDP95")
                '    Set GDPTbl = db2.OpenRecordset("SeriesGDP2000")
                'Set GDPTbl = db2.OpenRecordset("SeriesGDP2005")
                'Set GDPTbl = db2.OpenRecordset("SeriesGDP2011")
                'mti 2014/08/20 - end


                Dim AdvGDPXFirmDebt As Single? = 0
                '
                '   Read private debt (publically-guaranteed and not guaranteed) and fill holes
                '   --------------------------------------------------------------------------
                Dim PPGDEBT As Single?, PNGDEBT As Single?
                Dim GloXFirmDebt As Single? = 0
                Dim GDPANNs As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                For Each key In cntx.Regionalization.Keys
                    If cntx.HistoricMode Then
                        'mti 2019/04/29  Flex Hist Base Start
                        'PPGDEBT = GovDebtPPGTbl.Fields("Earliest")
                        PPGDEBT = getClosestYrVal(GovDebtPPGTbl, yrsGovDebtPPGTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                        If Not PPGDEBT.HasValue Then PPGDEBT = 0
                        'mti 2019/04/29  Flex Hist Base Start
                        'PNGDEBT = GovDebtPNGTbl.Fields("Earliest")
                        PNGDEBT = getClosestYrVal(GovDebtPNGTbl, yrsGovDebtPNGTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                        If Not PNGDEBT.HasValue Then PNGDEBT = 0
                        'mti 2019/04/29  Flex Hist Base Start
                        'GDPANN = GDPTbl.Fields("Earliest")
                        GDPANN = getClosestYrVal(GDPTbl, yrsGDPTbl, key, FirstYearHistory, HistDist)
                        'mti 2019/04/29  Flex Hist Base End
                    Else
                        'jrs 2006/11/29 const to vars PPGDEBT = GovDebtPPGTbl.Fields("2000")
                        PPGDEBT = getYearOrMstRct(GovDebtPPGTbl, yrsGovDebtPPGTbl, key, BaseYear)
                        If Not PPGDEBT.HasValue Then PPGDEBT = 0
                        'jrs 2006/11/29 const to vars PNGDEBT = GovDebtPNGTbl.Fields("2000")
                        PNGDEBT = getYearOrMstRct(GovDebtPNGTbl, yrsGovDebtPNGTbl, key, BaseYear)
                        If Not PNGDEBT.HasValue Then PNGDEBT = 0
                        'jrs 2006/11/29 const to vars GDPANN = GDPTbl.Fields("2000")
                        GDPANN = getYearOrMstRct(GDPTbl, yrsGDPTbl, key, BaseYear)

                    End If

                    GDPANNs.Add(key, GDPANN)

                    If Not GDPANN.HasValue Then
                        PPGDEBT = 0
                        PNGDEBT = 0
                    Else
                        GDPANN = GDPANN * CGDPAdj(key)
                        PPGDEBT = PPGDEBT / 100 * GDPANN
                        PNGDEBT = PNGDEBT / 100 * GDPANN
                    End If
                    'CXFIRMDEBT(key) = PNGDEBT + PPGDEBT * 0.5
                    CXFIRMDEBT(key) = PNGDEBT 'bbh 2022/06/23 PPGDEBT is actually public/govt debt, not firms
                    'Need to break PPGDEBT better between private/governmental
                    'Probably poorest countries have highest govt share
                    '        If CXFIRMDEBT(key) > CXDEBTRPA(key) Then
                    '            CXFIRMDEBT(key) = CXDEBTRPA(key)
                    '        End If
                    GloXFirmDebt = GloXFirmDebt + CXFIRMDEBT(key)
                    PerCap = CGDP(key) / CPOP(key)
                    If PerCap > 10 And CXFIRMDEBT(key) <= 0.001 Then
                        AdvGDPXFirmDebt = AdvGDPXFirmDebt + CGDP(key)
                    End If
                Next key

                '   Allocate Firm External Debt to Advanced Countries by Economic Size
                '   ------------------------------------------------------------------

                For Each key In cntx.Regionalization.Keys
                    PerCap = CGDP(key) / CPOP(key)
                    If PerCap > 10 And CXFIRMDEBT(key) <= 0.001 Then
                        CXFIRMDEBT(key) = -CGDP(key) / AdvGDPXFirmDebt * GloXFirmDebt
                    End If
                Next key

                '
                '   SAM Stocks: Move to Initial Intl Debt Position, Two Approaches
                '       (1) Data When Available and (2) Integration of Current Account When Not
                '   ------------------------------------------------------------------------------
                Dim yrsExportTbl As Short() = cntx.GetYears("SeriesExportGoodSer").OrderBy(Function(y) y).ToArray()
                Dim ExportTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesExportGoodSer", yrsExportTbl)

                Dim yrsImportTbl As Short() = cntx.GetYears("SeriesImportGoodSer").OrderBy(Function(y) y).ToArray()
                Dim ImportTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesImportGoodSer", yrsImportTbl)

                'bbh 2022/06/04 Although aid donations for base year are handled in ReadAndProcessIntlFlows,
                'need this section's access to donations, receipts, aid share to help set up debt analysis
                Dim yrsAidDonTbl As Short() = cntx.GetYears("aiddon").OrderBy(Function(y) y).ToArray()
                Dim AidDonTbl As IDictionary(Of String, Single?()) = cntx.GetDice("aiddon", yrsAidDonTbl)


                'bbh 2022/06/23 start XAssetsTbl and XNIIPTbl add
                Dim yrsXAssetsTbl As Short() = cntx.GetYears("SeriesNetForeignAssetsGDP").OrderBy(Function(y) y).ToArray()
                Dim XAssetsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesNetForeignAssetsGDP", yrsXAssetsTbl)

                Dim yrsXNIIPTbl As Short() = cntx.GetYears("SeriesNetIIPGDP").OrderBy(Function(y) y).ToArray()
                Dim XNIIPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesNetIIPGDP", yrsXNIIPTbl)


                'jrs 2022/03/21 Set XDebtRPATbl = db2.OpenRecordset("SeriesXDEBT")
                Dim yrsXDebtRPATbl As Short() = cntx.GetYears("SeriesXDEBTGDP").OrderBy(Function(y) y).ToArray()
                Dim XDebtRPATbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXDEBTGDP", yrsXDebtRPATbl)

                'jrs 2022/03/24
                Dim yrsXDebtRPA2Tbl As Short() = cntx.GetYears("SeriesXDEBT").OrderBy(Function(y) y).ToArray()
                Dim XDebtRPA2Tbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXDEBT", yrsXDebtRPA2Tbl)

                Dim yrsAidRecTbl As Short() = cntx.GetYears("SeriesAIDRecGNIOECD").OrderBy(Function(y) y).ToArray()
                Dim AidRecTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesAIDRecGNIOECD", yrsAidRecTbl)

                'bbh 2020/08/18 start SeriesAidRecGrant%Total is mislabeled, is actually aid in LCU, not grant portion
                '   do not have good series on aid vs grant portion; AidRecGrant%TotRev perhaps useful, but shows positive
                '   values for countries like Iceland/US; defn of grants includes flows other than aid
                '   Switched to it here but need to keep looking for series; am now setting aidlp in IFs.mdb/Global Parameters
                '   to override values here
                Dim yrsAidShareTbl As Short() = cntx.GetYears("SeriesAidRecGrantTotRev").OrderBy(Function(y) y).ToArray()
                Dim AidShareTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesAidRecGrantTotRev", yrsAidShareTbl)
                'Set AidShareTbl = db2.OpenRecordset("SeriesAidRecGrant%Total")
                'bbh 2020/08/18 end

                '    AdvGDPXDebt = 0

                'jrs 2006/12/28 const to vars
                Dim iBaseYear As Integer
                If BaseYear > yrsGDPTbl(yrsGDPTbl.Length - 1) Then
                    iBaseYear = yrsGDPTbl(yrsGDPTbl.Length - 1)
                Else
                    iBaseYear = BaseYear
                End If

                '   Integrate Debt Caculation Using Current Account Data
                '   ----------------------------------------------------

                Dim ExportAnn As Single?, ImportAnn As Single?
                For Each key In cntx.Regionalization.Keys
                    CXDEBTACC(key) = 0
                    '    If CountryName(key) = "Jordan" Then Stop
                    'jrs 2006/11/30 const to vars For YearCount% = 1960 To 2000

                    Dim YearCount As Short
                    For YearCount = 1960 To CShort(iBaseYear)
                        'Yearstr$ = Trim$(Str$(YearCount%))
                        Dim YearIdx = getYearIdx(yrsGDPTbl, YearCount)
                        GDPANN = GDPTbl(key)(YearIdx)
                        'jrs 2022/08/30 check Year not BaseYear
                        'jrs 2011/07/25 added check for Year
                        If yrsExportTbl.Contains(YearCount) Then
                            YearIdx = getYearIdx(yrsExportTbl, YearCount)
                            ExportAnn = ExportTbl(key)(YearIdx)
                        Else
                            ExportAnn = Nothing
                        End If
                        'jrs 2022/08/30 check Year not BaseYear
                        'jrs 2011/07/25 added check for Year
                        If yrsImportTbl.Contains(YearCount) Then
                            YearIdx = getYearIdx(yrsImportTbl, YearCount)
                            ImportAnn = ImportTbl(key)(YearIdx)
                        Else
                            ImportAnn = Nothing
                        End If
                        'jrs 2006/12/01 const to vars AidDonAnn = AidDonTbl.Fields("MostRecent")
                        'BaseYear -> just to remember to add Function to check that this field exist
                        'jrs 2006/12/11 const to vars AidDonAnn = AidDonTbl.Fields(YearStr$)

                        'mti June 2013 - start
                        Dim AidDonAnn As Single? = Nothing
                        'mti June 2013 - end

                        If yrsAidDonTbl.Contains(YearCount) Then
                            YearIdx = getYearIdx(yrsAidDonTbl, YearCount)
                            AidDonAnn = AidDonTbl(key)(YearIdx)
                        Else
                            AidDonAnn = Nothing
                        End If

                        If Not AidDonAnn.HasValue Then
                            If YearCount < 1990 Then
                                'mti 2019/04/29  Flex Hist Base Start
                                'AidDonAnn = AidDonTbl.Fields("Earliest")
                                AidDonAnn = getClosestYrVal(AidDonTbl, yrsAidDonTbl, key, FirstYearHistory, HistDist)
                                'mti 2019/04/29  Flex Hist Base End
                            Else
                                AidDonAnn = getMR(AidDonTbl, yrsAidDonTbl, key)
                            End If
                        End If

                        'Aid Don data only from 1990; Rec from 1960
                        Dim AidRecAnn As Single?
                        'jrs 2006/12/27 const to vars AidRecAnn = AidRecTbl.Fields(YearStr$)
                        If yrsAidRecTbl.Contains(YearCount) Then
                            YearIdx = getYearIdx(yrsAidRecTbl, YearCount)
                            AidRecAnn = AidRecTbl(key)(YearIdx)
                        Else
                            AidRecAnn = Nothing
                        End If

                        'jrs 2006/12/27 const to vars AidGrantShare = AidShareTbl.Fields(YearStr$)
                        Dim AidGrantShare As Single?
                        If yrsAidShareTbl.Contains(YearCount) Then
                            YearIdx = getYearIdx(yrsAidShareTbl, YearCount)
                            AidGrantShare = AidShareTbl(key)(YearIdx)
                        Else
                            AidGrantShare = Nothing
                        End If


                        If (GDPANN.HasValue) Then
                            'bbh 2014/07/29 start  E.g. for China have imports from 1960, exports from 1970
                            'This change had no real impact because XDEBTPRPA is really based on data for
                            'debtors and calcuation for creditors
                            'Problem here:  the data have China as a substantial debtor rather than creditor
                            If Not ExportAnn.HasValue Or Not ImportAnn.HasValue Then
                                ExportAnn = 0
                                ImportAnn = 0
                            End If
                            'If IsNull(ExportAnn) Then ExportAnn = 0
                            'If IsNull(ImportAnn) Then ExportAnn = 0
                            'bbh 2014/07/29 end

                            If Not AidDonAnn.HasValue Then AidDonAnn = 0
                            If Not AidRecAnn.HasValue Then AidRecAnn = 0
                            'bbh 2014/07/29 start  AidGrant share is based on SeriesAidRec%GNI, which has
                            'inappropriate data; may put back in later, but now not necessary
                            If AidGrantShare.HasValue Then
                                AidDonAnn = AidDonAnn * (1 - AidGrantShare / 100)
                                AidRecAnn = AidRecAnn * (1 - AidGrantShare / 100)
                            End If
                            AidDonAnn = 0
                            AidRecAnn = 0
                            'bbh 2014/07/29 end
                            'bbh 2016/04/06
                            'DebtAdd = (ImportAnn - ExportAnn - AddRecAnn + AidDonAnn) / 100 * GDPANN
                            Dim DebtAdd = (ImportAnn - ExportAnn - AidRecAnn + AidDonAnn) / 100 * GDPANN
                            'Debt is positive for debtors, negative for creditors
                            CXDEBTACC(key) = CXDEBTACC(key) + DebtAdd
                        End If
                    Next YearCount
                    'bbh 2016/04/06  process not very good, e.g. Timor-Leste; bound it
                    'If CXDEBTACC(key) > (2 * CGDP(key)) Then Stop
                    CXDEBTACC(key) = Amin(CXDEBTACC(key), 2 * CGDP(key))
                    'If CXDEBTACC(key) < (-2 * CGDP(key)) Then Stop
                    'jrs 2021/12/15, we also get very big negative values, like Brunei, which produces about 200 Billion, vs a GDP of only 17 Billion
                    CXDEBTACC(key) = AMAX(CXDEBTACC(key), -2 * CGDP(key))

                    '
                    '   Read External Debt from Data - Debtors only available, not creditors
                    '   --------------------------------------------------------------------

                    If cntx.HistoricMode Then 'Removed reads/fixes of CXNFA; at end of XDEBTRPA logic will set as equal/reversed sign
                        'mti 2019/04/29  Flex Hist Base Start
                        'CXDEBTRPA(key) = XDebtRPATbl.Fields("Earliest")
                        'bbh 2022/06/23 start First look at XAssets (net foreign assets) data from IMF Fin Stat, then other sources
                        CXDEBTRPA(key) = getClosestYrVal(XAssetsTbl, yrsXAssetsTbl, key, FirstYearHistory, HistDist) '182 of 186 countries 2022/06
                        CXNFA(key) = getClosestYrVal(XAssetsTbl, yrsXAssetsTbl, key, FirstYearHistory, HistDist) '182 of 186 countries 2022/06
                        If CXDEBTRPA(key).HasValue Then CXDEBTRPA(key) = -CXDEBTRPA(key)  'Convert assets to debt
                        If Not CXDEBTRPA(key).HasValue Then
                            CXDEBTRPA(key) = getClosestYrVal(XDebtRPATbl, yrsXDebtRPATbl, key, FirstYearHistory, HistDist)
                        End If
                        If Not CXNFA(key).HasValue Then
                            CXNFA(key) = getClosestYrVal(XDebtRPATbl, yrsXDebtRPATbl, key, FirstYearHistory, HistDist)
                            CXNFA(key) = -CXNFA(key)
                        End If
                        'mti 2019/04/29  Flex Hist Base End
                        CXDEBTACC(key) = 0
                    Else
                        'jrs 2006/12/01 const to vars CXDEBTRPA(key) = XDebtRPATbl.Fields("MostRecent")
                        CXDEBTRPA(key) = getYearOrMstRct(XAssetsTbl, yrsXAssetsTbl, key, BaseYear) '182 of 186 countries 2022/06
                        CXNFA(key) = getYearOrMstRct(XAssetsTbl, yrsXAssetsTbl, key, BaseYear) '182 of 186 countries 2022/06
                        If CXDEBTRPA(key).HasValue Then CXDEBTRPA(key) = -CXDEBTRPA(key)  'Convert assets to debt
                        If Not CXDEBTRPA(key).HasValue Then
                            CXDEBTRPA(key) = getYearOrMstRct(XDebtRPATbl, yrsXDebtRPATbl, key, BaseYear)
                        End If
                        If Not CXNFA(key).HasValue Then
                            CXNFA(key) = getYearOrMstRct(XDebtRPATbl, yrsXDebtRPATbl, key, BaseYear)
                            CXNFA(key) = -CXNFA(key)
                        End If

                    End If

                    'If CountryName$(key) = "Cuba" Then Stop
                    'jrs 2022/03/21
                    CXDEBTRPA(key) = CXDEBTRPA(key) * CGDP(key) / 100 'All series for and use of XDEBTRPA to this point
                    'is as % of GDP; convert to billion dollars


                    'jrs 2022/03/24
                    If Not CXDEBTRPA(key).HasValue Then 'XDebtRPA2Tb is in billion dollars; not using this series for XNFA
                        If cntx.HistoricMode Then
                            CXDEBTRPA(key) = getClosestYrVal(XDebtRPA2Tbl, yrsXDebtRPA2Tbl, key, FirstYearHistory, HistDist)
                        Else
                            CXDEBTRPA(key) = getYearOrMstRct(XDebtRPA2Tbl, yrsXDebtRPA2Tbl, key, BaseYear)
                        End If
                    End If

                    ' If IsNull(CXDEBTRPA(key)) Then Stop

                    If Not CXDEBTRPA(key).HasValue Then CXDEBTRPA(key) = CXDEBTACC(key)
                    If Not CXNFA(key).HasValue Then CXNFA(key) = -CXDEBTACC(key) / CGDP(key) * 100
                    'bbh 2016/04/06 if comment out next, useless line, there is enough room
                    '        CXDEBTRPA(key) = CXDEBTRPA(key) ' / 1000
                    'Shouldn't it be this?  Try


                    If cntx.HistoricMode Then 'bbh 2022/06/23 added read of net international investment position
                        CXNIIP(key) = getClosestYrVal(XNIIPTbl, yrsXNIIPTbl, key, FirstYearHistory, HistDist) '182 of 186 countries 2022/06
                    Else
                        CXNIIP(key) = getYearOrMstRct(XNIIPTbl, yrsXNIIPTbl, key, BaseYear) '182 of 186 countries 2022/06
                    End If
                    If Not CXNIIP(key).HasValue Then CXNIIP(key) = 0
                    'bbh 2022/06/23 end First look at XAssets

                Next key


                '
                '   Augment External Debt Data with Current Account Accummulation and
                '       Compute Global Balance
                '   -------------------------------------------------------------------

                '    TotalDebt = 0
                '    TotalAssets = 0
                Dim IFIDebt As Single?, IFIDonations As Single?

                For Each key In cntx.Regionalization.Keys
                    'If CountryName$(key) = "Cuba" Then Stop
                    'bbh 2022/06/23 Remove If/End IF becuase NetForeignAssets%GDP can have either sign, includes creditors
                    '    plus further down removed Firm Debt/Assets from coverage need; is part of XNIIP, not XNFA and XDEBTRPA
                    '        If CXDEBTRPA(key) < 0.001 Then 'Creditor or very small debtor
                    '            CXDEBTRPA(key) = CXDEBTACC(key)
                    '        End If 'This handles:
                    '                    'Rich debtors like US, not in IMF debt data
                    '                    'Some poor debtors like Afghanistan, not in data
                    '                    'All creditors, like Saudi Arabia, not in data
                    If CXDEBTRPA(key) > 0 Then 'Debtor - must cover IFI debt; firm debt
                        IFIDebt = AMAX(0, CXIMFCREDIT(key) + CXWBLOANS(key)) 'all are in billion dollars
                        '            FirmDebtExt = AMAX(0, CXFIRMDEBT(key))

                        'If IFIDebt + FirmDebtExt > CXDEBTRPA(key) Then Stop
                        CXDEBTRPA(key) = AMAX(CXDEBTRPA(key), IFIDebt) '+ FirmDebtExt)
                    Else  'Creditor - must cover IFI donations, firm assets
                        IFIDonations = Amin(0, CXIMFCREDIT(key) + CXWBLOANS(key))
                        'XFirmAssets = Amin(0, CXFIRMDEBT(key))
                        'bbh 2022/06/23 removed CXDEBTRPA(key) from 2nd term in minimum; removed link to CXDEBTACC, done earlier
                        'If IFIDonations + XFirmAssets < CXDEBTRPA(key) Then Stop
                        '           CXDEBTRPA(key) = Amin(CXDEBTACC(key), _
                        'IFIDonations) ' + XFirmAssets)
                        CXDEBTRPA(key) = Amin(CXDEBTRPA(key),
                        IFIDonations) ' + XFirmAssets)
                    End If

                    'Sums of total debts and assets to prepare to normalize
                    '        If CXDEBTRPA(key) > 0 Then
                    '            TotalDebt = TotalDebt + CXDEBTRPA(key)
                    '        Else
                    '            TotalAssets = TotalAssets - CXDEBTRPA(key)
                    '        End If
                    'bbh 2022/06/23 end of Remove If/End plus change
                Next key

                'Normalize global assets to global debts 'bbh 2022/06/23
                '    For Each key In cntx.Regionalization.Keys
                '        'Assume debt data better than asset and impose on assets
                '        If CXDEBTRPA(key) < 0 Then
                '            'mti June 2013 -start
                '            'CXDEBTRPA(key) = CXDEBTRPA(key) * _
                '                TotalDebt / AMAX(0.001, TotalAssets)
                '            CXDEBTRPA(key) = CXDEBTRPA(key) * _
                '                (TotalDebt / AMAX(0.001, TotalAssets))
                '            'mti June 2013 -end
                '        End If
                '       'CXNFA(key) = -CXDEBTRPA(key) / CGDP(key) * 100 'Mostly XDEBTRPA here will equal Net Foreign Asset % as read earlier
                'If CountryName$(key) = "Cuba" Then Stop
                '    Next key
                'BBH 2022/06/23 END OF BIG INCLUSIVE BLOCK; Jose, I suggest you look for START of this and take all; great many changes
                '

                '   Compute governmental external debt and government domestic debt
                '   ---------------------------------------------------------------
                For Each key In cntx.Regionalization.Keys
                    CXGOVTDEBT.Add(key, CXDEBTRPA(key) - CXFIRMDEBT(key))
                    'Assume no household external debt
                Next

                '
                '   Compute "Basic" Government Debt to Other Countries and Directly to Foreign Firms (e.g. Banks)
                '   -------------------------------------------------------------------------------------------
                For Each key In cntx.Regionalization.Keys
                    CXGOVTDEBTB.Add(key, CXGOVTDEBT(key) - CXWBLOANS(key) - CXIMFCREDIT(key))
                Next

                'bbh 2022/06/04 Moved large block of code dealing with aid donations, aid receipts, and aid share to ReadAndProcessIntlFlows
                '
                '   Move to reading and balancing foreign aid flows
                '   Donations will be used to allocate IFI stocks back
                '   to donors
                '   --------------------------------------------------

                '    Set AidDonTbl = db2.OpenRecordset("SeriesAidDon%GNI")
                '    AidDonTbl.Index = "Country"
                '    AidDonTbl.MoveFirst
                '
                '    Set AidRecTbl = db2.OpenRecordset("SeriesAIDRec%GNI")
                '    AidRecTbl.Index = "Country"
                '    AidRecTbl.MoveFirst
                '
                '    'bbh 2020/08/18
                '    Set AidShareTbl = db2.OpenRecordset("SeriesAidRecGrant%TotRev")
                '    'Set AidShareTbl = db2.OpenRecordset("SeriesAidRecGrant%Total")
                '    AidShareTbl.Index = "Country"
                '    AidShareTbl.MoveFirst

                '
                '   Social Accounting Matrix Stock Additional Components
                '       - Sometimes Integration of Flows
                '   ----------------------------------------------------
                '
                Dim GloXGovtDebt As Single?, GloXPortfolio As Single?, GloWorkRemit As Single?
                Dim GloWorkRemitNoForWork As Single?, GloPopForeignNoRemit As Single?, AdvGDPXGovtDebt As Single?
                Dim AdvGDPXPortfolio As Single?, GloXWBLnFIn As Single?, GloXWBLnFOut As Single?
                Dim GloXIMFCrFIn As Single?, GloXIMFCrFOut As Single?, GloXPortFIn As Single?
                Dim WRemitPos As Single?, WRemitNeg As Single?
                Dim WRemitIn As Single?, WRemitOut As Single?
                GloXFirmDebt = 0
                GloXGovtDebt = 0
                GloXPortfolio = 0
                GloWorkRemit = 0
                GloWorkRemitNoForWork = 0
                GloPopForeignNoRemit = 0
                '    GloPopForeign = 0 'bbh 2014/07/02

                AdvGDPXGovtDebt = 0
                AdvGDPXPortfolio = 0

                GloXWBLnFIn = 0
                GloXWBLnFOut = 0
                GloXIMFCrFIn = 0
                GloXIMFCrFOut = 0
                GloXPortFIn = 0
                'bbh 2014/07/02 2 lines added
                WRemitPos = 0
                WRemitNeg = 0
                'bbh 2020/03/09 2 lines added
                WRemitIn = 0
                WRemitOut = 0

                'jrs 2014/06/17
                ' gvdb 2024/04/05
                ' unused variable
                'Dim LocalMax As Single
                '
                '   Social Accounting Matrix (Financial Stock) Variables
                '   ---------------------------------------------------
                '
                '   Read total govt debt (not just intl) and fill holes
                '   ---------------------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim Estimator As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP) Versus Govt Debt % GDP (1970)").ToEstimator(CGDPPCP)
                    'bbh 2020/08/19 start
                    Dim SeriesTable As String = "SeriesGovtDebtGenGDPIMF"
                    Dim SeriesTable2 As String = "SeriesGovtDebtGDPIMF"
                    Dim SeriesTable3 As String = "SeriesGovtDebtGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    Dim yrs2 As Short() = cntx.GetYears(SeriesTable2).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable2, yrs2)
                    Dim yrs3 As Short() = cntx.GetYears(SeriesTable3).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl3 As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable3, yrs3)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then ValHold = getClosestYrVal(DictTbl2, yrs2, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then ValHold = getClosestYrVal(DictTbl3, yrs3, key, cntx.FirstYear, HistDist)
                        'bbh 2020/08/19
                        If Not ValHold.HasValue Then
                            ValHold = Estimator(key)
                        End If
                        CGovDebt.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP) Versus Govt Debt % GDP (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Dim XYTABL As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    'bbh 2020/08/19
                    For Each item In (From s In cntx.GetSlice("SeriesGovtDebtGenGDPIMF", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGovtDebtGDPIMF", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesGovtDebtGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value)
                        CGovDebt.Add(item.Key, If(item.Value, If(item.Value2, If(item.Value3, XYTABL(item.Key)))))
                    Next
                End If

                '   Use external govt debt and total government debt to compute government domestic debt
                '   ------------------------------------------------------------------------------------
                Dim TotGovDebtVal As Single?
                For Each key In cntx.Regionalization.Keys
                    GDPANN = GDPANNs(key) * CGDPAdj(key)
                    If Not (GDPANN.HasValue) Then
                        TotGovDebtVal = 0
                    Else
                        CGovDebt(key) = AMAX(CGovDebt(key), CXGOVTDEBT(key) / AMAX(0.001F, GDPANN) * 100)
                        TotGovDebtVal = CGovDebt(key) / 100 * GDPANN
                    End If
                    TotGovDebtVal = AMAX(TotGovDebtVal, CXGOVTDEBT(key))
                    CGOVTDEBTD.Add(key, TotGovDebtVal - CXGOVTDEBT(key))
                Next

                '   Read reserves as % of GDP and fill holes
                '   ----------------------------------------
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesXReservesGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        CXRESERVES.Add(key, ValHold)
                        GDPANN = GDPANNs(key)
                        If Not (CXRESERVES(key).HasValue) OrElse Not (GDPANN.HasValue) Then
                            CXRESERVES(key) = 15 '0 15% is average in 2000
                        Else
                            GDPANN = GDPANN * CGDPAdj(key)
                            CXRESERVES(key) = CXRESERVES(key) '/ 100 * GDPANN
                        End If
                    Next
                    'mti 2019/04/29  Flex Hist Base End	
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesXReservesGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CXRESERVES.Add(item.Key, item.Value)
                        GDPANN = GDPANNs(item.Key)
                        If Not (CXRESERVES(item.Key).HasValue) Or Not (GDPANN.HasValue) Then
                            CXRESERVES(item.Key) = 15 '0
                        Else
                            GDPANN = GDPANN * CGDPAdj(item.Key)
                            CXRESERVES(item.Key) = CXRESERVES(item.Key) '/ 100 * GDPANN
                        End If
                    Next
                End If

                '   Read FDI and Integrate Stocks of Inflows Over Time
                '   --------------------------------------------------
                Dim yrsFDI As Short() = cntx.GetYears("SeriesXFDIInflowsGDP").OrderBy(Function(y) y).ToArray()
                Dim FDITbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXFDIInflowsGDP", yrsFDI)
                If cntx.BaseYear > yrsFDI(yrsFDI.Count - 1) Then
                    iBaseYear = yrsFDI(yrsFDI.Count - 1)
                Else
                    iBaseYear = cntx.BaseYear
                End If

                Dim FDIAnnPer As Single?, FDIAnn As Single?
                Dim yrIdx As Integer
                For Each key In cntx.Regionalization.Keys
                    CXFDISTOCK.Add(key, 0)
                    If Not cntx.HistoricMode Then
                        For YearCount% = iBaseYear - 30 To iBaseYear
                            'jrs 2007/07/25 testing 1990 as base year
                            If yrsFDI(0) <= YearCount Then
                                yrIdx = getYearIdx(yrsFDI, CShort(YearCount))
                                FDIAnnPer = FDITbl(key)(yrIdx)
                            End If
                            'jrs 2007/07/25 testing 1990 as base year
                            If yrsGDPTbl(0) <= YearCount Then
                                yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                                GDPANN = GDPTbl(key)(yrIdx)
                            End If
                            If Not (FDIAnnPer.HasValue) Or Not (GDPANN.HasValue) Then
                                FDIAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                FDIAnn = FDIAnnPer * GDPANN / 100
                            End If
                            CXFDISTOCK(key) = CXFDISTOCK(key) + FDIAnn
                        Next YearCount%
                        CXFDISTOCK(key) = AMAX(0, CXFDISTOCK(key))
                        CXFDISTOCK(key) = Amin(CXFDISTOCK(key), 2 * GDPANN)
                    End If
                Next

                '   Read FDI and Integrate Stocks of Outflows Over Time
                '   ---------------------------------------------------
                Dim yrsFDIOut As Short() = cntx.GetYears("SeriesXFDIOutflowsGDP").OrderBy(Function(y) y).ToArray()
                Dim FDIOutTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXFDIOutflowsGDP", yrsFDIOut)

                For Each key In cntx.Regionalization.Keys
                    CXFDISTOUT.Add(key, 0)
                    If Not cntx.HistoricMode Then
                        For YearCount% = 1970 To cntx.BaseYear
                            If yrsFDIOut.Contains(CShort(YearCount)) Then
                                yrIdx = getYearIdx(yrsFDIOut, CShort(YearCount))
                                FDIAnnPer = FDIOutTbl(key)(yrIdx)
                            Else
                                FDIAnnPer = Nothing
                            End If
                            If yrsGDPTbl.Contains(CShort(YearCount)) Then
                                yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                                GDPANN = GDPTbl(key)(yrIdx)
                            Else
                                GDPANN = Nothing
                            End If
                            If Not (FDIAnnPer.HasValue) Or Not (GDPANN.HasValue) Then
                                FDIAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                FDIAnn = FDIAnnPer * GDPANN / 100
                            End If
                            CXFDISTOUT(key) = CXFDISTOUT(key) + FDIAnn
                        Next YearCount%
                        CXFDISTOUT(key) = AMAX(0, CXFDISTOUT(key))
                        CXFDISTOUT(key) = Amin(CXFDISTOUT(key), 2 * GDPANN)
                    End If
                Next

                '   Read Portfolio Investment and Integrate Stocks Over Time
                '   --------------------------------------------------------
                'Need to fill in values for source countries - use XDEBT approach
                Dim yrsPortBonds As Short() = cntx.GetYears("SeriesXPortBondsGDP").OrderBy(Function(y) y).ToArray()
                Dim PortBondsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXPortBondsGDP", yrsPortBonds)
                Dim yrsPortEquity As Short() = cntx.GetYears("SeriesXPortEquityGDP").OrderBy(Function(y) y).ToArray()
                Dim PortEquityTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXPortEquityGDP", yrsPortEquity)
                Dim PortBondsAnnPer As Single?, PortEquityAnnPer As Single?, PortTotalAnn As Single?

                For Each key In cntx.Regionalization.Keys
                    CXPORTFOLIO.Add(key, 0)
                    CXPORTSTOUT.Add(key, 0)
                    If Not cntx.HistoricMode Then
                        For YearCount% = 1970 To cntx.BaseYear
                            If yrsPortBonds.Contains(CShort(YearCount)) Then
                                yrIdx = getYearIdx(yrsPortBonds, CShort(YearCount))
                                PortBondsAnnPer = PortBondsTbl(key)(yrIdx)
                            Else
                                PortBondsAnnPer = Nothing
                            End If
                            If yrsPortEquity.Contains(CShort(YearCount)) Then
                                yrIdx = getYearIdx(yrsPortEquity, CShort(YearCount))
                                PortEquityAnnPer = PortEquityTbl(key)(yrIdx)
                            Else
                                PortEquityAnnPer = Nothing
                            End If
                            If yrsGDPTbl.Contains(CShort(YearCount)) Then
                                yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                                GDPANN = GDPTbl(key)(yrIdx)
                            Else
                                GDPANN = Nothing
                            End If
                            If Not (GDPANN.HasValue) Then
                                PortTotalAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                If Not (PortBondsAnnPer.HasValue) Then
                                    PortBondsAnnPer = 0
                                End If
                                If Not (PortEquityAnnPer.HasValue) Then
                                    PortEquityAnnPer = 0
                                End If
                                PortTotalAnn = (PortBondsAnnPer + PortEquityAnnPer) * GDPANN / 100
                            End If
                            CXPORTFOLIO(key) = CXPORTFOLIO(key) + PortTotalAnn
                        Next YearCount%
                        'bbh 2011/11/12 start  'Used to have only inflow data only for developing countries;
                        'now have net inflows and outflows and US among others is inflow target
                        'CXPORTFOLIO(key) = AMAX(0#, CXPORTFOLIO(key))
                        If CXPORTFOLIO(key) < 0 Then ' designate net outflow countries and outflow only
                            CXPORTSTOUT(key) = 0 - CXPORTFOLIO(key)
                            CXPORTFOLIO(key) = 0
                        End If
                        'bbh 2011/06/15
                        If (GDPANN.HasValue) Then 'Luxembourg rule; stocks too big for model dynamics to be good
                            CXPORTFOLIO(key) = Amin(CXPORTFOLIO(key), CSng(0.5 * GDPANN))
                        End If
                        'bbh 2011/06/15              
                    End If
                    GloXPortfolio = GloXPortfolio + CXPORTFOLIO(key)
                    PerCap = CGDP(key) / CPOP(key)
                    'If PerCap > 10 And CXPORTFOLIO(key) <= 0.001 Then
                    If PerCap > 10 Then 'Even if have inflows, must make US and others eligible for outflows
                        AdvGDPXPortfolio = AdvGDPXPortfolio + CGDP(key)
                    End If
                    '        bbh 2011/11/12 end
                Next 'Country

                '   Social Accounting Matrix Financial Flows - Sometimes Need Stocks to Compute
                '   ---------------------------------------------------------------------------

                '   Read FDI and Calculate Annual Inflows
                '   -------------------------------------
                For Each key In cntx.Regionalization.Keys
                    CXFDIFIN.Add(key, 0)
                    If cntx.HistoricMode Then
                        For YearCount% = 1970 To 1979
                            yrIdx = getYearIdx(yrsFDI, CShort(YearCount))
                            FDIAnnPer = FDITbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (FDIAnnPer.HasValue) Or Not (GDPANN.HasValue) Then
                                FDIAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                FDIAnn = FDIAnnPer * GDPANN / 100
                            End If
                            CXFDIFIN(key) = CXFDIFIN(key) + FDIAnn
                        Next YearCount%
                        CXFDIFIN(key) = CXFDIFIN(key) / 10
                        CXFDISTOCK(key) = CXFDIFIN(key) * 15 '15 based on global ratio in 2005
                    Else
                        'jrs 2006/12/28 const to vars
                        If cntx.BaseYear > yrsFDI(yrsFDI.Count - 1) Then
                            iBaseYear = yrsFDI(yrsFDI.Count - 1)
                        Else
                            iBaseYear = cntx.BaseYear
                        End If

                        'jrs 2006/11/29 const to vars For YearCount% = 1996 To 2000
                        For YearCount% = iBaseYear - 4 To iBaseYear
                            yrIdx = getYearIdx(yrsFDI, CShort(YearCount))
                            FDIAnnPer = FDITbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (FDIAnnPer.HasValue) Or Not (GDPANN.HasValue) Then
                                FDIAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                FDIAnn = FDIAnnPer * GDPANN / 100
                            End If
                            CXFDIFIN(key) = CXFDIFIN(key) + FDIAnn
                        Next YearCount%
                        CXFDIFIN(key) = CXFDIFIN(key) / 5
                        'bbh 2011/06/15
                    End If
                    CXFDIFIN(key) = AMAX(0, CXFDIFIN(key))
                    If (GDPANN.HasValue) Then 'Luxembourg rule; flows far too big for addition to firm income
                        CXFDIFIN(key) = Amin(CXFDIFIN(key), CSng(0.1 * GDPANN))
                    End If
                    'bbh 2011/06/15 end
                Next

                '   Read FDI and Calculate Annual Outflows
                '   -------------------------------------
                For Each key In cntx.Regionalization.Keys
                    CXFDIFOUT.Add(key, 0)
                    If cntx.HistoricMode Then
                        For YearCount% = 1970 To 1979
                            yrIdx = getYearIdx(yrsFDIOut, CShort(YearCount))
                            FDIAnnPer = FDIOutTbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (FDIAnnPer.HasValue) Or Not (GDPANN.HasValue) Then
                                FDIAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                FDIAnn = FDIAnnPer * GDPANN / 100
                            End If
                            CXFDIFOUT(key) = CXFDIFOUT(key) + FDIAnn
                        Next YearCount%
                        CXFDIFOUT(key) = CXFDIFOUT(key) / 10
                        CXFDISTOUT(key) = CXFDIFOUT(key) * 15 '15 based on global ratio in 2005
                    Else
                        'last 5 years
                        If cntx.BaseYear > yrsFDIOut(yrsFDIOut.Count - 1) Then
                            iBaseYear = yrsFDIOut(yrsFDIOut.Count - 1)
                        Else
                            iBaseYear = cntx.BaseYear
                        End If
                        'jrs 2006/11/29 const to vars For YearCount% = 1996 To 2000
                        For YearCount% = iBaseYear - 4 To iBaseYear
                            yrIdx = getYearIdx(yrsFDIOut, CShort(YearCount))
                            FDIAnnPer = FDIOutTbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (FDIAnnPer.HasValue) Or Not (GDPANN.HasValue) Then
                                FDIAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                FDIAnn = FDIAnnPer * GDPANN / 100
                            End If
                            CXFDIFOUT(key) = CXFDIFOUT(key) + FDIAnn
                        Next YearCount%
                        CXFDIFOUT(key) = CXFDIFOUT(key) / 5
                    End If
                    'bbh 2011/06/15
                    If (GDPANN.HasValue) Then 'Luxembourg rule; flows far too big for addition to firm income
                        CXFDIFOUT(key) = AMAX(0, Amin(CXFDIFOUT(key), CSng(0.1 * GDPANN)))
                    End If
                    'bbh 2011/06/15 end
                Next

                '   Read Bonds and Equity and Calculate Annual Portfolio Inflows
                '   ------------------------------------------------------------
                For Each key In cntx.Regionalization.Keys
                    CXPORTFIN.Add(key, 0)
                    If cntx.HistoricMode Then
                        For YearCount% = 1970 To 1979
                            yrIdx = getYearIdx(yrsPortBonds, CShort(YearCount))
                            PortBondsAnnPer = PortBondsTbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsPortEquity, CShort(YearCount))
                            PortEquityAnnPer = PortEquityTbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (GDPANN.HasValue) Then
                                PortTotalAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                If Not (PortBondsAnnPer.HasValue) Then
                                    PortBondsAnnPer = 0
                                End If
                                If Not (PortEquityAnnPer.HasValue) Then
                                    PortEquityAnnPer = 0
                                End If
                                PortTotalAnn = (PortBondsAnnPer + PortEquityAnnPer) * GDPANN / 100
                            End If
                            CXPORTFIN(key) = CXPORTFIN(key) + PortTotalAnn
                        Next YearCount%
                        CXPORTFIN(key) = AMAX(0, CXPORTFIN(key) / 10)
                    Else
                        'last 5 years
                        If cntx.BaseYear > yrsPortBonds(yrsPortBonds.Count - 1) Then
                            iBaseYear = yrsPortBonds(yrsPortBonds.Count - 1)
                        Else
                            iBaseYear = cntx.BaseYear
                        End If
                        'jrs 2006/11/29 const to vars For YearCount% = 1996 To 2000
                        For YearCount% = iBaseYear - 4 To iBaseYear
                            yrIdx = getYearIdx(yrsPortBonds, CShort(YearCount))
                            PortBondsAnnPer = PortBondsTbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsPortEquity, CShort(YearCount))
                            PortEquityAnnPer = PortEquityTbl(key)(yrIdx)
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (GDPANN.HasValue) Then
                                PortTotalAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                If Not (PortBondsAnnPer.HasValue) Then
                                    PortBondsAnnPer = 0
                                End If
                                If Not (PortEquityAnnPer.HasValue) Then
                                    PortEquityAnnPer = 0
                                End If
                                PortTotalAnn = (PortBondsAnnPer + PortEquityAnnPer) * GDPANN / 100
                            End If
                            CXPORTFIN(key) = CXPORTFIN(key) + PortTotalAnn
                        Next YearCount%
                        'bbh 2011/11/12 begin
                        'CXPORTFIN(key) = AMAX(0, CXPORTFIN(key) / 5)
                        CXPORTFIN(key) = CXPORTFIN(key) / 5
                        If CXPORTFIN(key) < 0 Then
                            CXPORTFOUT.Add(key, 0 - CXPORTFIN(key))
                            CXPORTFIN(key) = 0
                        End If
                        'bbh 2011/06/15
                        If (GDPANN.HasValue) Then 'Luxembourg rule; flows far too big for addition to firm income
                            'This is probably too big a cut for Hong Kong; may need more sophisticated algorithm
                            'for entrepot economies
                            CXPORTFIN(key) = Amin(CXPORTFIN(key), CSng(0.05 * GDPANN))
                        End If
                        'bbh 2011/06/15 end
                    End If
                    GloXPortFIn = GloXPortFIn + CXPORTFIN(key)
                    'bbh 2011/11/12 end
                Next

                '   Read WB Net Flows and Estimate Outflows and Inflows
                '       Must do after stocks because need CXWBLOANS
                '   ----------------------------------------------------
                Dim yrsIDAFl As Short() = cntx.GetYears("SeriesXFlowsIDAGDP").OrderBy(Function(y) y).ToArray()
                Dim WBIDAFlowsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXFlowsIDAGDP", yrsIDAFl)
                Dim yrsIBRDFl As Short() = cntx.GetYears("SeriesXFlowsIBRDGDP").OrderBy(Function(y) y).ToArray()
                Dim WBIBRDFlowsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXFlowsIBRDGDP", yrsIBRDFl)
                Dim WBIDAAnnPer As Single?, WBIBRDAnnPer As Single?, WBAnn As Single?
                For Each key In cntx.Regionalization.Keys
                    CXWBLNFIN.Add(key, 0)
                    CXWBLNFOUT.Add(key, 0)

                    If Not cntx.HistoricMode Then
                        'last 5 years
                        If cntx.BaseYear > yrsIDAFl(yrsIDAFl.Count - 1) Then
                            iBaseYear = yrsIDAFl(yrsIDAFl.Count - 1)
                        Else
                            iBaseYear = cntx.BaseYear
                        End If
                        'jrs 2006/11/29 const to vars For YearCount% = 1996 To 2000
                        For YearCount% = iBaseYear - 4 To iBaseYear
                            yrIdx = getYearIdx(yrsIDAFl, CShort(YearCount))
                            WBIDAAnnPer = WBIDAFlowsTbl(key)(yrIdx)
                            If Not (WBIDAAnnPer.HasValue) Then WBIDAAnnPer = 0
                            yrIdx = getYearIdx(yrsIBRDFl, CShort(YearCount))
                            WBIBRDAnnPer = WBIBRDFlowsTbl(key)(yrIdx)
                            If Not (WBIBRDAnnPer.HasValue) Then WBIBRDAnnPer = 0
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (GDPANN.HasValue) Then
                                WBAnn = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                WBAnn = (WBIDAAnnPer + WBIBRDAnnPer) * GDPANN / 100
                            End If
                            CXWBLNFIN(key) = CXWBLNFIN(key) + WBAnn
                        Next YearCount%
                        CXWBLNFIN(key) = CXWBLNFIN(key) / 5 'At this point have net flows
                        'CXWBLNFOUT(key) = (CXWBLOANS(key) * 0.03 + CXWBLOANS(key) / 20)
                        'bbh 2020/08/15 start
                        If CXWBLOANS(key) > 0 Then 'Borrowers from WB
                            CXWBLNFOUT(key) = (CXWBLOANS(key) * sxwblnintr / 100 _
                + CXWBLOANS(key) / AMAX(1, sxwblnrepr))
                            CXWBLNFIN(key) = AMAX(0, CXWBLNFIN(key) + CXWBLNFOUT(key))
                        Else 'Suppliers of funds to WB have interactions only via subscriptions, see CXWBSUBF
                            CXWBLNFIN(key) = 0
                            CXWBLNFOUT(key) = 0
                        End If
                        'bbh 2020/08/15 end
                        'estimate inflows
                        'Can result in systemic flows in greater than flows out; must normalize flows
                    End If
                    GloXWBLnFIn = GloXWBLnFIn + CXWBLNFIN(key)
                    GloXWBLnFOut = GloXWBLnFOut + CXWBLNFOUT(key)
                Next

                '   Read IMF Net Flows and Estimate Outflows and Inflows
                '       Must do after stocks because need CXIMFCREDIT
                '   ----------------------------------------------------
                Dim yrsConFl As Short() = cntx.GetYears("SeriesXFlowsIMFConGDP").OrderBy(Function(y) y).ToArray()
                Dim IMFConFlowsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXFlowsIMFConGDP", yrsConFl)
                Dim yrsNonConFl As Short() = cntx.GetYears("SeriesXFlowsIMFNonConGDP").OrderBy(Function(y) y).ToArray()
                Dim IMFNonConFlowsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesXFlowsIMFNonConGDP", yrsNonConFl)
                Dim imfconannper As Single?, imfnonconannper As Single?, imfann As Single?
                For Each key In cntx.Regionalization.Keys
                    CXIMFCRFIN.Add(key, 0)
                    CXIMFCRFOUT.Add(key, 0)
                    If Not cntx.HistoricMode Then
                        'last 5 years
                        If cntx.BaseYear > yrsConFl(yrsConFl.Count - 1) Then
                            iBaseYear = yrsConFl(yrsConFl.Count - 1)
                        Else
                            iBaseYear = cntx.BaseYear
                        End If
                        'jrs 2006/11/29 const to vars For YearCount% = 1996 To 2000
                        For YearCount% = iBaseYear - 4 To iBaseYear
                            yrIdx = getYearIdx(yrsConFl, CShort(YearCount))
                            imfconannper = IMFConFlowsTbl(key)(yrIdx)
                            If Not (imfconannper.HasValue) Then imfconannper = 0

                            'mti July 05, 2011 - start
                            If yrsNonConFl.Contains(CShort(YearCount)) Then
                                yrIdx = getYearIdx(yrsNonConFl, CShort(YearCount))
                                imfnonconannper = IMFNonConFlowsTbl(key)(yrIdx)
                            End If
                            'mti July 05, 2011 - end

                            If Not (imfnonconannper.HasValue) Then imfnonconannper = 0
                            yrIdx = getYearIdx(yrsGDPTbl, CShort(YearCount))
                            GDPANN = GDPTbl(key)(yrIdx)
                            If Not (GDPANN.HasValue) Then
                                imfann = 0
                            Else
                                GDPANN = GDPANN * CGDPAdj(key)
                                imfann = (imfconannper + imfnonconannper) * GDPANN / 100
                            End If
                            CXIMFCRFIN(key) = CXIMFCRFIN(key) + imfann
                        Next YearCount%
                        'bbh 2020/08/15 start
                        If CXIMFCREDIT(key) > 0 Then 'Credit users from IMF
                            CXIMFCRFIN(key) = CXIMFCRFIN(key) / 5 'At this point have net flows
                            CXIMFCRFOUT(key) = (CXIMFCREDIT(key) * sximfcrintr / 100 _
                    + CXIMFCREDIT(key) / AMAX(1, sximfcrrepr))
                            CXIMFCRFIN(key) = AMAX(0, CXIMFCRFIN(key) + CXIMFCRFOUT(key))
                            'estimate inflows
                        Else 'Suppliers of funds to IMF have interactions only via subscriptions, see CXIMFSUBF
                            CXIMFCRFIN(key) = 0
                            CXIMFCRFOUT(key) = 0
                            'bbh 2020/08/15 end
                        End If
                    End If
                    GloXIMFCrFIn = GloXIMFCrFIn + CXIMFCRFIN(key)
                    GloXIMFCrFOut = GloXIMFCrFOut + CXIMFCRFOUT(key)
                Next

                '   Read Worker Remittances from Receiving States
