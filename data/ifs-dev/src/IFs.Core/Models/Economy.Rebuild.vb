                Me.processedGovConAdj = False
            End Sub

            Private Sub PreProcessGovConAdj(cntx As IRebuildFacade)
                If Me.processedGovConAdj Then
                    Return
                End If

                Using db As IFsContext = New IFsContext()
                    Dim gp As GlobalParameters
                    gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "INFRAFINON").Single()
                    infrafinon = CSng(gp.Value)
                    gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "INFRAPUBSPNDFLR").Single()
                    infrapubspndflr = CSng(gp.Value)
                    gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "INFRAPUBSPNDFLRSW").Single()
                    infrapubspndflrsw = CSng(gp.Value)
                    gp = db.GlobalParameters.Where(Function(g) g.ParameterName = "GDSNORMALIZE").Single()
                    gdsnormalize = CSng(gp.Value)

                    If cntx.HistoricMode Then
                        Dim gp2 As IEnumerable(Of GlobalParametersMultHist)

                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        gp2 = db.GlobalParametersMultHist.Where(Function(g) g.ParameterName = "INFRAINVMAINTPUBSHRM").AsEnumerable()
                        ReDim infrainvmaintpubshrm(1, gp2.Count)
                        For Each par As GlobalParametersMultHist In gp2
                            infrainvmaintpubshrm(1, par.Dimension2) = CSng(par.Value)
                        Next

                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        gp2 = db.GlobalParametersMultHist.Where(Function(g) g.ParameterName = "INFRAINVNEWPUBSHRM").AsEnumerable()
                        ReDim infrainvnewpubshrm(1, gp2.Count)
                        For Each par As GlobalParametersMultHist In gp2
                            infrainvnewpubshrm(1, par.Dimension2) = CSng(par.Value)
                        Next
                    Else
                        Dim gp2 As IEnumerable(Of GlobalParametersMult)

                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        gp2 = db.GlobalParametersMult.Where(Function(g) g.ParameterName = "INFRAINVMAINTPUBSHRM").AsEnumerable()
                        ReDim infrainvmaintpubshrm(1, gp2.Count)
                        For Each par As GlobalParametersMult In gp2
                            infrainvmaintpubshrm(1, par.Dimension2) = CSng(par.Value)
                        Next

                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        gp2 = db.GlobalParametersMult.Where(Function(g) g.ParameterName = "INFRAINVNEWPUBSHRM").AsEnumerable()
                        ReDim infrainvnewpubshrm(1, gp2.Count)
                        For Each par As GlobalParametersMult In gp2
                            infrainvnewpubshrm(1, par.Dimension2) = CSng(par.Value)
                        Next
                    End If
                End Using

                Dim CGConDollar As Single?, gtotal As Single?, gtotalNoDef As Single?, NormTotal As Single?
                Dim GDSInfraNew As Single?, GDSInfraMaint As Single?, GDSInfra As Single?
                Dim GDSInfraAdjusted As Single?, CostChangeRatio As Single?
                For Each key In cntx.Regionalization.Keys
                    '   Read Government Expenditures
                    '   ----------------------------
                    CGConDollar = CGCon(key) 'Comes from output file created in DataEcon

                    'convert from dollar to % of Total GovCon
                    GExpDef(key) = GExpDef(key) / CGConDollar * 100
                    GExpEd(key) = GExpEd(key) / CGConDollar * 100
                    GExpHl(key) = GExpHl(key) / CGConDollar * 100
                    GExpRandD(key) = GExpRandD(key) / CGConDollar * 100
                    GExpInfra(key) = GExpInfra(key) / CGConDollar * 100
                    GExpInfraOther(key) = GExpInfraOther(key) / CGConDollar * 100

                    If gdsnormalize = 1 Then 'base case

                        gtotal = GExpDef(key) + GExpHl(key) + GExpEd(key) + GExpRandD(key) + GExpInfra(key) + GExpInfraOther(key)

                        'Normalize but protect defense
                        If gtotal > 99 Then
                            gtotalNoDef = AMAX(1, gtotal - GExpDef(key))
                            NormTotal = AMAX(2, 99 - GExpDef(key))
                            GExpHl(key) = GExpHl(key) * NormTotal / gtotalNoDef
                            GExpEd(key) = GExpEd(key) * NormTotal / gtotalNoDef
                            GExpRandD(key) = GExpRandD(key) * NormTotal / gtotalNoDef
                            GExpInfra(key) = GExpInfra(key) * NormTotal / gtotalNoDef
                            GExpInfraOther(key) = GExpInfraOther(key) * NormTotal / gtotalNoDef
                        End If

                    End If 'gdsnormalize = 1 Then 'base case

                    '--mti 2013/08/05 - The following cannot be done at this point any longer;
                    '   as GExpTot is not read and GExpDef etc are as % of GDP not as % of GExpTot
                    GExpOt(key) = AMAX(0, 100 - GExpDef(key) - GExpHl(key) - GExpEd(key) _
                    - GExpRandD(key) - GExpInfra(key) - GExpInfraOther(key))


                    If infrafinon = 1 Then

                        GDSInfraNew = 0
                        GDSInfraMaint = 0

                        For InfCt% = 1 To cntx.NInfraType
                            GDSInfraNew = GDSInfraNew + infrainvnewpubshrm(1, InfCt%) * cINFRAINVESTNEW(key)(InfCt%)
                            GDSInfraMaint = GDSInfraMaint + infrainvmaintpubshrm(1, InfCt%) * cINFRAINVESTMAINT(key)(InfCt%)
                        Next


                        GDSInfra = GDSInfraNew + GDSInfraMaint 'billion dollars
                    Else 'infrastructure financing is not modeled at all
                        GDSInfra = 0
                    End If

                    'mti October 20, 2011 -start
                    'unit cost adjustment for infra
                    If infrafinon = 1 Then

                        'GDSInfraAdjusted = GExpInfra(key) * GExpTot(key) * CGDP(key) / 10000 'convert % of GExpTot (which is in % itself) to billions of $

                        'mti 2013/08/05 - adjustment still needed incase GDSInfra was capped at 10% of GDP (down from a larger share of GDP) : may be this needs to go in Dataecon(?)
                        'GDSInfraAdjusted = GExpInfra(key) * CGDP(key) / 100  'convert % of GDP to billions of $
                        'GDSInfraAdjusted = GExpInfra(key) * CGConPcnt * GDPOut / 10000
                        'convert FROM % of GovCon (CGConPcnt in % of GDP) to billions of $
                        'changed CGDP(key) to GDPOut

                        GDSInfraAdjusted = GExpInfra(key) / 100 * CGConDollar  ' CGCon(key)

                        CostChangeRatio = GDSInfraAdjusted / GDSInfra

                        ' If CountryName(key) = "Kyrgyz Republic" Then Stop

                        cINFRAROADPAVEDCOST(key) = cINFRAROADPAVEDCOST(key) * CostChangeRatio
                        cINFRAROADUNPAVEDCOST(key) = cINFRAROADUNPAVEDCOST(key) * CostChangeRatio
                        cINFRAELECGENCOST(key) = cINFRAELECGENCOST(key) * CostChangeRatio
                        cSANITATIONCOST(key) = cSANITATIONCOST(key) * CostChangeRatio
                        cWATSAFECOST(key) = cWATSAFECOST(key) * CostChangeRatio

                        cINFRATELECOST(key) = cINFRATELECOST(key) * CostChangeRatio
                        cICTMOBILCOST(key) = cICTMOBILCOST(key) * CostChangeRatio
                        cICTBROADCOST(key) = cICTBROADCOST(key) * CostChangeRatio
                        cICTBROADMOBILCOST(key) = cICTBROADMOBILCOST(key) * CostChangeRatio

                        'mti February 28, 2012 - start
                        'cLANDIRCOST(key) = landircostsingle * CostChangeRatio
                        'cWATWASTETREATCOST(key) = watwastetreatcostsingle * CostChangeRatio

                        cLANDIRCOST(key) = cLANDIRCOST(key) * CostChangeRatio
                        cWATWASTETREATCOST(key) = cWATWASTETREATCOST(key) * CostChangeRatio

                        cSANITATIONIMPCOST(key) = cSANITATIONIMPCOST(key) * CostChangeRatio
                        cWATSAFEIMPCOST(key) = cWATSAFEIMPCOST(key) * CostChangeRatio
                        cINFRAELECACCRURALCOST(key) = cINFRAELECACCRURALCOST(key) * CostChangeRatio
                        cINFRAELECACCURBANCOST(key) = cINFRAELECACCURBANCOST(key) * CostChangeRatio
                        For InfCt% = 1 To cntx.NInfraType
                            cINFRAINVESTNEW(key)(InfCt%) = cINFRAINVESTNEW(key)(InfCt%) * CostChangeRatio
                            cINFRAINVESTMAINT(key)(InfCt%) = cINFRAINVESTMAINT(key)(InfCt%) * CostChangeRatio
                        Next


                        CCostChangeRatio.Add(key, CostChangeRatio)

                    Else
                        CCostChangeRatio.Add(key, 0) 'jrs 2020/05/29
                    End If

                    '   Convert percentages (of GovCon) back to absolute government expenditures
                    '   ------------------------------------------------------------
                    GExpDef(key) = GExpDef(key) / 100 * CGConDollar ' CGCon(key)
                    GExpHl(key) = GExpHl(key) / 100 * CGConDollar 'CGCon(key)
                    GExpEd(key) = GExpEd(key) / 100 * CGConDollar 'CGCon(key)
                    GExpRandD(key) = GExpRandD(key) / 100 * CGConDollar 'CGCon(key)
                    GExpInfra(key) = GExpInfra(key) / 100 * CGConDollar ' CGCon(key)
                    GExpInfraOther(key) = GExpInfraOther(key) / 100 * CGConDollar ' CGCon(key)

                    GExpOt(key) = GExpOt(key) / 100 * CGConDollar ' CGCon(key)

                    '       GExpRandD is dollar amount; ExpRandTot is % of GDP
                    ExpRandDTot(key) = CSng(AMAX(GExpRandD(key) / CGDP(key) * 100 * 1.1, ExpRandDTot(key)))
                Next

                'jrs 2022/04/01 *** start ***
                'Initialize Arms Trade, needs GDS(Military) - GExpDef
                'Load data as % of GDP
                'clp 2022/06/12 Adding military expenditures stock
                If cntx.HistoricMode Then
                    For Each item In (From s In cntx.GetSlice("SeriesArmsExportsGDP", "Earliest")
                                      Join s2 In cntx.GetSlice("SeriesArmsImportsGDP", "Earliest") On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesMilExpendStock", "Earliest") On s.Key Equals s3.Key
                                      Select Key = s.Key, Value = If(s.Value, 0), Value2 = If(s2.Value, 0), Value3 = s3.Value)
                        CXARMS.Add(item.Key, item.Value)
                        CMARMS.Add(item.Key, item.Value2)
                        CMILEXPSTOCK.Add(item.Key, item.Value3)
                    Next
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesArmsExportsGDP", BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesArmsImportsGDP", BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesMilExpendStock", BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Select Key = s.Key, Value = If(s.Value, 0), Value2 = If(s2.Value, 0), Value3 = s3.Value)
                        CXARMS.Add(item.Key, item.Value)
                        CMARMS.Add(item.Key, item.Value2)
                        CMILEXPSTOCK.Add(item.Key, item.Value3)
                    Next
                End If

                Dim globalSumOfImports, globalSumOfExports As Single?
                globalSumOfImports = 0
                globalSumOfExports = 0

                For Each key In cntx.Regionalization.Keys
                    'convert to values (Billion $)
                    CXARMS(key) = CXARMS(key) * CGDP(key) / 100
                    CMARMS(key) = CMARMS(key) * CGDP(key) / 100
                    CMARMS(key) = CSng(Amin(CMARMS(key), GExpDef(key) * 0.5))
                    globalSumOfImports = globalSumOfImports + CMARMS(key)
                    globalSumOfExports = globalSumOfExports + CXARMS(key)
                    'jrs 2022/06/21
                    If Not CMILEXPSTOCK(key).HasValue Then
                        CMILEXPSTOCK(key) = CSng(GExpDef(key) * 6.1111)
                    End If
                    If CMILEXPSTOCK(key) = 0 Then
                        CMILEXPSTOCK(key) = CSng(GExpDef(key) * 6.1111)
                    End If
                Next

                If globalSumOfExports > 0 Then
                    For Each key In cntx.Regionalization.Keys
                        CXARMS(key) = CXARMS(key) * globalSumOfImports / globalSumOfExports
                    Next
                End If
                'jrs 2022/04/01 *** end ***

                ' mark pre-processedGovCon for all three series
                Me.processedGovConAdj = True
            End Sub

            Private Sub FillInitialGDPGRNIDM(cntx As IRebuildFacade, yrsGDP As Short(), GDPTbl As IDictionary(Of String, Single?()))
                'mti 2021/07/15 several places adding initialization of natonal poverty at/and national povertty line
                Using db As IFsContext = New IFsContext()
                    Dim gp As IEnumerable(Of Economic)
                    'gvdb 2024/04/05
                    ' update for EF new syntax
                    gp = db.Economic.AsEnumerable()
                    For Each ctry As Economic In gp
                        GDPGRBal.Add(ctry.Country, If(ctry.GDPGRBal, 1))
                    Next
                End Using

                'find last available year
                Dim iLastYrGDP As Integer
                iLastYrGDP = yrsGDP(yrsGDP.Count - 1)
                Dim iLastYrGDPnoLimit As Integer
                iLastYrGDPnoLimit = iLastYrGDP
                'Moved out of Resize procedure to have variable limit depending on GDP table
                bLoadGDPR = False
                If iLastYrGDPnoLimit > cntx.BaseYear Then
                    For Each key In cntx.Regionalization.Keys
                        Dim VarVals As Single?()
                        ReDim VarVals(iLastYrGDPnoLimit - cntx.BaseYear)
                        CGDPR.Add(key, VarVals)
                    Next
                    For R% = 1 To NR
                        Dim VarVals As Single?()
                        ReDim VarVals(iLastYrGDPnoLimit - cntx.BaseYear)
                        GDPRYEXT.Add(R%, VarVals)
                    Next
                    bLoadGDPR = True
                End If

                'Check that it doesn't go beyond 5 years after base
                If iLastYrGDP > cntx.BaseYear + 5 Then
                    iLastYrGDP = cntx.BaseYear + 5
                End If

                'Check for lower limit problems and warn user
                Dim iFstYrGDP As Integer
                iFstYrGDP = yrsGDP(0)
                If iLastYrGDP - 13 < iFstYrGDP Then
                    Debug.Print("The GDP growth calculation doesn't have enough previous years using a Base Year of " & CStr(cntx.BaseYear))
                    iLastYrGDP = iFstYrGDP + 13
                End If

                'jrs 2020/12/22 Covid Adjustment
                If iLastYrGDP = 2020 Or iLastYrGDP = 2021 Then
                    iLastYrGDP = 2019
                End If

                'jrs 2009/06/18 YearsHistGDP% = 5
                If iLastYrGDPnoLimit > cntx.BaseYear Then
                    YearsHistGDP% = iLastYrGDPnoLimit - cntx.BaseYear
                End If

                'Dim YearFirst As Short, YearsSecond As Short
                Dim ValueFirst As Single?, ValueSecond As Single?, ValHold As Single?, ValHold2 As Single?
                Dim ValHoldEarlyYears As Single?
                Dim yrFirstIdx As Integer, yrSecondIdx As Integer
                Dim yrFirstIdx2 As Integer, yrSecondIdx2 As Integer, yrIdx As Integer
                Dim XYTABL As SeriesEstimator, XYTABL2 As SeriesEstimator
                Dim Year2nd As Integer
                If cntx.HistoricMode Then
                    'zz??
                    'mti 2019/05/14 Start
                    Year2nd% = Amin(cntx.FirstYear + 20, cntx.LastYear)
                    yrSecondIdx = getYearIdx(yrsGDP, CShort(Year2nd))
                    yrFirstIdx = getYearIdx(yrsGDP, CShort(cntx.FirstYear))
                    'mti 2019/05/14 End
                    'yrFirstIdx = getYearIdx(yrsGDP, 1960)
                    'yrSecondIdx = getYearIdx(yrsGDP, 1980)
                    XYTABL = cntx.GetRegression("GDP/Capita (PPP) Versus Economic Growth Rate (1995)").ToEstimator(CGDPPCP)
                    XYTABL2 = cntx.GetRegression("GDP/Capita (PPP) Versus Income Share of Lowest 20% (1995)").ToEstimator(CGDPPCP)
                Else
                    yrFirstIdx = getYearIdx(yrsGDP, CShort(iLastYrGDP - 20))
                    yrSecondIdx = getYearIdx(yrsGDP, CShort(iLastYrGDP - 5))
                    yrFirstIdx2 = yrSecondIdx
                    yrSecondIdx2 = getYearIdx(yrsGDP, CShort(iLastYrGDP))
                    'jrs 2024/06/12
                    Dim TblName As String = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Economic Growth Rate (" & BaseYear & ")"
                    TblName = getFunctionNameYrOrMstRct(TblName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'XYTABL = cntx.GetRegression("GDP/Capita (PPP) Versus Economic Growth Rate (1995)").ToEstimator(CGDPPCP)
                    XYTABL = cntx.GetRegression(TblName).ToEstimator(CGDPPCP)
                    'jrs 2024/06/10
                    TblName = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Income Share of Lowest 20% (" & BaseYear & ")"
                    TblName = getFunctionNameYrOrMstRct(TblName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'XYTABL2 = cntx.GetRegression("GDP/Capita (PPP) Versus Income Share of Lowest 20% (1995)").ToEstimator(CGDPPCP)
                    XYTABL2 = cntx.GetRegression(TblName).ToEstimator(CGDPPCP)
                End If
                'jrs 2020/12/22
                If yrsGDP(yrFirstIdx) = 2020 Or yrsGDP(yrFirstIdx) = 2021 Then
                    yrFirstIdx = getYearIdx(yrsGDP, 2019)
                End If
                If yrsGDP(yrSecondIdx) = 2020 Or yrsGDP(yrSecondIdx) = 2021 Then
                    yrSecondIdx = getYearIdx(yrsGDP, 2019)
                End If
                If yrsGDP(yrFirstIdx2) = 2020 Or yrsGDP(yrFirstIdx2) = 2021 Then
                    yrFirstIdx2 = getYearIdx(yrsGDP, 2019)
                End If
                If yrsGDP(yrSecondIdx2) = 2020 Or yrsGDP(yrSecondIdx2) = 2021 Then
                    yrSecondIdx2 = getYearIdx(yrsGDP, 2019)
                End If

                Dim yrsIncShare As Short() = cntx.GetYears("SeriesIncShareL20").OrderBy(Function(y) y).ToArray()
                Dim IncShareLTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncShareL20", yrsIncShare)
                'gvdb 2024/04/05
                'unused variable
                'Dim PopGrow As Single?



                For Each key In cntx.Regionalization.Keys
                    ValueFirst = GDPTbl(key)(yrFirstIdx)
                    ValueSecond = GDPTbl(key)(yrSecondIdx)
                    If cntx.HistoricMode Then
                        If Not ValueFirst.HasValue Or Not ValueSecond.HasValue Then
                            ValHold = XYTABL(key)
                        Else
                            ValueFirst = ValueFirst * CGDPAdj(key)
                            ValueSecond = ValueSecond * CGDPAdj(key)
                            ValHold = CSng((ValueSecond / ValueFirst) ^ (1 / (Year2nd - cntx.FirstYear)) - 1)
                        End If
                        'jrs 2006/12/01 const to vars ValHold2 = IncShareLTbl(keyi)("MostRecent")
                        ValHold2 = getYearOrMstRct(IncShareLTbl, yrsIncShare, key, cntx.BaseYear)
                        If Not ValHold2.HasValue Then ValHold2 = XYTABL2(key)
                        '  BBH 7/9/04 Begin V5_01
                        For key2% = 1 To YearsHistGDP%
                            'jrs 2009/07/03 CGDPR(key2%, key) = -100
                            'the dimensions were changed to countries by # of years
                            CGDPR(key)(key2%) = -100
                            'CGDPR02(key) = -100
                        Next key2%
                    Else 'forecast
                        If Not ValueFirst.HasValue Or Not ValueSecond.HasValue Then
                            ValHold = XYTABL(key)
                        Else
                            ValueFirst = ValueFirst * CGDPAdj(key)
                            ValueSecond = ValueSecond * CGDPAdj(key)
                            'jrs 2020/12/22 ValHold = CSng((ValueSecond / ValueFirst) ^ (1 / 15) - 1)
                            ValHold = CSng((ValueSecond / ValueFirst) ^ (1 / (yrsGDP(yrSecondIdx) - yrsGDP(yrFirstIdx))) - 1)
                        End If
                        ValHoldEarlyYears = AMAX(0.01F, Amin(0.1F, ValHold)) 'First x years

                        'Find 7 newer years
                        ValueFirst = GDPTbl(key)(yrFirstIdx2)
                        ValueSecond = GDPTbl(key)(yrSecondIdx2)
                        If Not ValueFirst.HasValue Or Not ValueSecond.HasValue Then
                            ValHold = XYTABL(key)
                        Else
                            ValueFirst = ValueFirst * CGDPAdj(key)
                            ValueSecond = ValueSecond * CGDPAdj(key)
                            'bbh 2011/07/29
                            '                ValHold = (ValueSecond / ValueFirst) ^ (1 / 7) - 1
                            'jrs 2020/12/22 ValHold = CSng((ValueSecond / ValueFirst) ^ (1 / 5) - 1)
                            ValHold = CSng((ValueSecond / ValueFirst) ^ (1 / (yrsGDP(yrSecondIdx2) - yrsGDP(yrFirstIdx2))) - 1)
                        End If
                        ValHold = AMAX(0.01F, Amin(0.1F, ValHold)) 'Last y years
                        'ValHold = (ValHold * 2 + ValHoldEarlyYears) / 3 'Weight most recent years most heavily
                        '            ValHold = (ValHold + ValHoldEarlyYears) / 2  'Weight most recent years slightly more heavily
                        ValHold = (ValHold * GDPGRBal(key) + ValHoldEarlyYears) / AMAX(2, (1 + GDPGRBal(key)))


                        'bbh 2016/04/15 start
                        'Code to adjust Base Case for Low income countries downward for Intl Ed Commision Project; remove afterward
                        'LI is less than 1045, LMI < 4125

                        'bbh 2021/12/18 Commented out the 0.8 code (supposed to have been done long ago)
                        'If CGDPPC(key) < 4.125 And Not (cntx.HistoricMode = True) Then
                        '    ValHold = CSng(ValHold * 0.8)
                        'End If
                        'bbh 2016/04/15 end
                        ValHold = Amin(0.095F, ValHold)

                        '
                        '           Code for computing exogenous GDP growth rates that will be put into gdprext and used in the model to
                        '               override endogenous compuations in early forecast years.
                        '           Note that this will extend out to the last year in the GDP2011 or successor table
                        '
                        If iLastYrGDPnoLimit > cntx.BaseYear Then
                            Dim ValueBase() As Single?
                            ReDim ValueBase(iLastYrGDPnoLimit - cntx.BaseYear)
                            Dim iYr As Integer
                            For iYr = cntx.BaseYear To iLastYrGDPnoLimit
                                If yrsGDP.Contains(CShort(iYr)) Then
                                    yrIdx = getYearIdx(yrsGDP, CShort(iYr))
                                    ValueBase(iYr - cntx.BaseYear) = GDPTbl(key)(yrIdx)
                                Else
                                    ValueBase(iYr - cntx.BaseYear) = Nothing
                                End If
                            Next iYr

                            For iYr = 1 To iLastYrGDPnoLimit - cntx.BaseYear
                                If Not (ValueBase(iYr).HasValue) Or Not (ValueBase(iYr - 1).HasValue) Then
                                    CGDPR(key)(iYr) = -100
                                Else
                                    'If CountryName(key) = "Libya" And iYr = 2013 - BaseYear Then Stop
                                    CGDPR(key)(iYr) = ((ValueBase(iYr) / ValueBase(iYr - 1)) - 1) * 100
                                End If
                            Next iYr
                        End If

                        'jrs 2009/06/18 generalizing years in the future to read
                        '******** end ****************

                        'jrs 2006/12/01 const to vars ValHold2 = IncShareLTbl(keyi)("MostRecent")
                        ValHold2 = getYearOrMstRct(IncShareLTbl, yrsIncShare, key, cntx.BaseYear)
                        If Not ValHold2.HasValue Then ValHold2 = XYTABL2(key)

                    End If 'if history else forecast
                    'If key = "Comoros" Then
                    '    ValHold = CSng(ValHold - 0.00053)
                    'End If

                    'wv 2021/07/30 start test removal of popgrowth for economic growth
                    CIGDPR.Add(key, ValHold)
                    'PopGrow = (CCBR(key) - CCDR(key)) / 1000
                    'CIGDPR(key) = AMAX(CIGDPR(key), CSng(PopGrow + 0.005))
                    'wv 2021/07/30 end test removal of popgrowth for economic growth
                    'bbh 2011/09/24 'Aghan data during war are nonsense as guide to future
                    If key = "Afghanistan" Then CIGDPR(key) = Amin(CIGDPR(key), 0.05F)
                    'bbh 2012/12/19 'Liberia data during war recovery are nonsense as guide to future
                    If key = "Liberia" Then CIGDPR(key) = Amin(CIGDPR(key), 0.055F)
                    'jrs 2023/05/01
                    'If key = "Central African Republic" Then CIGDPR(key) = CSng(CIGDPR(key) + 0.01)
                    'CINCSHR(key) = ValHold2
                    '  BBH 7/9/04 End V5_01
                    CINTR.Add(key, AMAX(2, Amin(8, CIGDPR(key) * 100)))
                    'Set initial (real) interest rates at growth rate, but bound

                Next

                Dim TbName As String
                'jrs 2024/06/12 TbName$ = "GDP/Capita (PPP) Versus Gini Index (" & CStr(cntx.BaseYear) & ")"
                TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Gini Index (" & CStr(cntx.BaseYear) & ")"
                TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                XYTABL = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                Dim CWATSAFENoneA As Single?, CWATSAFENoneB As Single?, CWATSAFENone As Single?
                Dim CSANITATIONNoneA As Single?, CSANITATIONNoneB As Single?, CSANITATIONNone As Single?
                Dim AnalFunc As SeriesEstimator
                Dim CWATSAFENones As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim CSANITATIONNones As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    For Each item In (From s In cntx.GetSlice("SeriesGINIExtended", "Earliest")
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = If(item.Value, XYTABL(item.Key))
                        'mti 2022/01/06 CGINIDOM.Add(item.Key, ValHold / 100) 'Convert from Percent to Index form
                        CGINIDOM.Add(item.Key, CSng(AMAX(0.25, ValHold / 100))) 'Convert from Percent to Index form
                    Next
                Else 'forecast
                    For Each item In (From s In cntx.GetSlice("SeriesGINIExtended", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesWSSJMPWaterTotalOtherUnImproved", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesWSSJMPWaterTotalSurface", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Join s4 In cntx.GetSlice("SeriesWSSJMPSanitationTotalOpenDefecation", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s4.Key
                                      Join s5 In cntx.GetSlice("SeriesWSSJMPSanitationTotalOtherUnimproved", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s5.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value,
                                      Value4 = s4.Value, Value5 = s5.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            CWATSAFENoneA = item.Value2
                            CWATSAFENoneB = item.Value3
                            If CWATSAFENoneA.HasValue And CWATSAFENoneB.HasValue Then
                                CWATSAFENone = CWATSAFENoneA + CWATSAFENoneB
                            ElseIf CWATSAFENoneA.HasValue Then
                                CWATSAFENone = CWATSAFENoneA
                            ElseIf CWATSAFENoneB.HasValue Then
                                CWATSAFENone = CWATSAFENoneB
                            Else
                                CWATSAFENone = Nothing
                            End If

                            CSANITATIONNoneA = item.Value4
                            CSANITATIONNoneB = item.Value5
                            If CSANITATIONNoneA.HasValue And CSANITATIONNoneB.HasValue Then
                                CSANITATIONNone = CSANITATIONNoneA + CSANITATIONNoneB
                            ElseIf CSANITATIONNoneA.HasValue Then
                                CSANITATIONNone = CSANITATIONNoneA
                            ElseIf CSANITATIONNoneB.HasValue Then
                                CSANITATIONNone = CSANITATIONNoneB
                            Else
                                CSANITATIONNone = Nothing
                            End If

                            If CWATSAFENone.HasValue And CSANITATIONNone.HasValue Then
                                CWATSAFENone = CWATSAFENone + 1
                                CSANITATIONNone = CSANITATIONNone + 1

                                CWATSAFENones.Add(item.Key, CWATSAFENone)
                                CSANITATIONNones.Add(item.Key, CSANITATIONNone)
                                AnalFunc = cntx.GetRegression("Domestic Gini Index").Normalize("WaterNone", "SanitationNone", "GDPPCP").ToEstimator(CWATSAFENones, CSANITATIONNones, CGDPPCP)
                                ValHold = AnalFunc(item.Key)

                            Else
                                ValHold = XYTABL(item.Key)
                            End If
                            'jrs 2012/07/12 *** end ***
                        End If
                        'mti 2022/01/06 CGINIDOM.Add(item.Key, ValHold / 100) 'Convert from Percent to Index form
                        CGINIDOM.Add(item.Key, CSng(AMAX(0.25, ValHold / 100))) 'Convert from Percent to Index form
                    Next
                End If 'history else forecast

                'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2005) Versus Income Below One Dollar and 25 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Income Below One Dollar and 25 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                XYTABL = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                Dim FuncName As String
                Dim yrsIncLT1 As Short() = cntx.GetYears("SeriesIncBelow1D25cWDI2011").OrderBy(Function(y) y).ToArray()
                Dim incomelt1tbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow1D25cWDI2011", yrsIncLT1)
                Dim yrsGDP2005 As Short() = cntx.GetYears("SeriesGDP2005PCPPP").OrderBy(Function(y) y).ToArray()
                Dim GDP2005PCPPPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesGDP2005PCPPP", yrsGDP2005)

                Dim TbName2 As String
                TbName2$ = "GDP/Capita (PPP 2005) Versus Income Below Two Dollars per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName2$ = getFunctionNameYrOrMstRct(TbName2$, cntx.BaseYear, cntx)
                XYTABL2 = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP)
                Dim yrsIncLT2 As Short() = cntx.GetYears("SeriesIncBelow2DollarPovCal2015").OrderBy(Function(y) y).ToArray()
                Dim incomelt2tbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow2DollarPovCal2015", yrsIncLT2)
                Dim iYr1 As Integer, iYr2 As Integer
                Dim portionpoor As Single?, NInv As Single?, lnstddev As Single?, LNMean As Single?
                Dim AvgINCOMELT As Single?
                For Each key In cntx.Regionalization.Keys
                    If cntx.HistoricMode Then
                        ValHold = XYTABL(key)
                        ValHold = Amin(ValHold, 70)
                        ValHold = AMAX(ValHold, 0)
                    Else 'forecast
                        FuncName = TbName
                        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), cntx.FirstYear, incomelt1tbl, yrsIncLT1,
                        GDP2005PCPPPTbl, yrsGDP2005, key, FuncName, cntx, 100, 0, "Div", 1000)
                    End If 'if history else forecast
                    CINCOMELT1.Add(key, ValHold / 100 * CPOP(key)) 'Convert from Percent to Index form

                    If cntx.HistoricMode Then
                        ValHold = XYTABL2(key)
                        ValHold = Amin(ValHold, 90)
                        ValHold = AMAX(ValHold, 0)
                    Else 'forecast
                        FuncName = TbName2
                        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), cntx.FirstYear, incomelt2tbl, yrsIncLT2,
                        GDP2005PCPPPTbl, yrsGDP2005, key, FuncName, cntx, 100, 0, "Div", 1000)
                    End If 'if history else forecast
                    CINCOMELT2.Add(key, ValHold / 100 * CPOP(key)) 'Convert from Percent to Index form

                    'jrs 2008/07/21
                    '$2/day has to be higher or equal than $1/day
                    If CINCOMELT2(key) < CINCOMELT1(key) Then
                        '            If DevelopmentMode = "True" Then
                        '                MsgBox "Inconsistent Poverty Numbers for " & key & Chr(vbKeyReturn) & _
                        '                "Resetting Initialization Values using LogNormal formulation.", vbInformation, "Economic Preprocessor"
                        '            End If
                        'jrs 2008/08/08

                        'Look for Most Recent data
                        '<$1/day
                        iYr1 = getMstRctYr(incomelt1tbl, yrsIncLT1, key)
                        '<$2/day
                        iYr2 = getMstRctYr(incomelt2tbl, yrsIncLT2, key)
                        'Use the most recent data to find the other level with lognomral formulation
                        If iYr2 > iYr1 Then
                            'Keep $2/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT2(key) / AMAX(0.0001F, CPOP(key)))

                            'mti Oct 01, 2009 -start
                            NInv = CalcNormalInverse(CSng(portionpoor))
                            'NInv = NormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse(CSng((CGINIDOM(key) + 1) / 2)))
                            'lnstddev = Sqr(2) * NormalInverse((CGINIDOM(key) + 1) / 2)
                            LNMean = CSng(Log(730) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(456.25, LNMean, lnstddev)
                            'portionpoor = LogNormalCDF(365, LNMean, lnstddev)

                            CINCOMELT1(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        Else
                            'Keep $1/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT1(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(CSng(portionpoor))
                            'NInv = NormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                            'lnstddev = Sqr(2) * NormalInverse((CGINIDOM(key) + 1) / 2)

                            LNMean = CSng(Log(456.25) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(760, LNMean, lnstddev)
                            'portionpoor = LogNormalCDF(760, LNMean, lnstddev)
                            CINCOMELT2(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))

                        End If

                        'mti 02/22/10
                        '        If CINCOMELT2(key) < CINCOMELT1(key) Then
                        If CINCOMELT2(key) < CINCOMELT1(key) Or
                            ((CINCOMELT2(key) * 100 / CPOP(key)) > 5 And
                                (CINCOMELT2(key) * 100 / CPOP(key)) < (CINCOMELT1(key) * 100 / CPOP(key)) + 2) Then
                            'at least 5% point
                            If cntx.DevelopmentMode Then
                                Debug.Print("Inconsistent Poverty Numbers Persist for " & key & vbCr &
                                "Resetting Initialization Values using Average.") ', vbInformation, "Economic Preprocessor"
                            End If
                            AvgINCOMELT = (CINCOMELT1(key) + CINCOMELT2(key)) / 2
                            CINCOMELT1(key) = CSng(0.9 * AvgINCOMELT)
                            CINCOMELT2(key) = CSng(1.1 * AvgINCOMELT)
                        End If
                    End If 'end of If CINCOMELT2(key) < CINCOMELT1(key) Then

                    'We need some level of poverty at <$1/day, when <$2/day is non-zero
                    If CINCOMELT1(key) = 0 And CINCOMELT2(key) > 0 Then
                        'Compute NSNARAT2
                        '----------------
                        portionpoor = Amin(0.9F, CINCOMELT2(key) / AMAX(0.0001F, CPOP(key)))

                        NInv = CalcNormalInverse(portionpoor)
                        'NInv = NormalInverse(portionpoor)

                        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                        'lnstddev = Sqr(2) * NormalInverse((CGINIDOM(key) + 1) / 2)

                        LNMean = CSng(Log(730) - lnstddev * NInv)
                        'Not necessary
                        '            If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                        '                meanbackcalc = Exp(709)
                        '            Else
                        '                meanbackcalc = Exp(LNMean + 0.5 * (lnstddev ^ 2))
                        '            End If
                        '            'In dollars, not thousands
                        '            meanconsumption = CPCON(key) / AMAX(0.0001, CPop(key)) * CGDPPCP(key) / CGDPPC(key)
                        '            NSNARAT2 = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)

                        'Find portionpoor for <$1/day
                        '----------------------------
                        'LNMean = Log(meanconsumption * NSNARAT2 * 1000) - 0.5 * (lnstddev ^ 2)
                        portionpoor = CalcLogNormalCDF(456.25, LNMean, lnstddev)
                        'portionpoor = LogNormalCDF(365, LNMean, lnstddev)
                        'mti Oct 01, 2009 -end

                        CINCOMELT1(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))

                    End If
                Next

                'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2011) Versus Income Below One Dollar and 90 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Income Below One Dollar and 90 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                XYTABL = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                'mti 2020/09/01 start
                'Dim yrsIncLT190 As Short() = cntx.GetYears("SeriesIncBelow1D90cWDI").OrderBy(Function(y) y).ToArray()
                'Dim INCOMELT19TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow1D90cWDI", yrsIncLT190)
                Dim yrsIncLT190 As Short() = cntx.GetYears("SeriesIncBelow1D90cPovcal").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT19TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow1D90cPovcal", yrsIncLT190)
                'jrs 2024/02/26 changed to use PIP tables for poverty
                'jrs 2022/11/01 flex constant dollars
                Dim yrsIncLT215 As Short() = cntx.GetYears("SeriesIncBelow2D15cPIP").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT215TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow2D15cPIP", yrsIncLT215)
                Dim TbName215 = "GDP/Capita (PPP 2017) Versus Income Below Two Dollars and 15 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName215 = getFunctionNameYrOrMstRct(TbName215, cntx.BaseYear, cntx)
                Dim XYTABL215 = cntx.GetRegression(TbName215).ToEstimator(CGDPPCP)
                'jrs 2022/11/17 *** end ***
                'mti 2020/09/01 end
                Dim yrsGDP2011 As Short() = cntx.GetYears("GDPPCP" & ConstantDollarsYear.ToString).OrderBy(Function(y) y).ToArray()
                Dim GDP2011PCPPPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("GDPPCP" & ConstantDollarsYear.ToString, yrsGDP2011)
                'jrs 2022/11/17 *** start ***
                'jrs 2022/11/17 *** start ***
                Dim yrsGDP2017 As Short() = cntx.GetYears("GDPPCP2017").OrderBy(Function(y) y).ToArray()
                Dim GDP2017PCPPPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("GDPPCP2017", yrsGDP2017)
                'jrs 2022/11/17 *** end ***

                'jrs 2025/09/12 *** start ***
                Dim yrsIncLT300 As Short() = cntx.GetYears("SeriesIncBelow3D00cPIP").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT300TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow3D00cPIP", yrsIncLT300)
                Dim TbName300 = "GDP/Capita (PPP 2021) Versus Income Below Three Dollars per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName300 = getFunctionNameYrOrMstRct(TbName300, cntx.BaseYear, cntx)
                Dim XYTABL300 = cntx.GetRegression(TbName300).ToEstimator(CGDPPCP)

                Dim yrsIncLT420 As Short() = cntx.GetYears("SeriesIncBelow4D20cPIP").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT420TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow4D20cPIP", yrsIncLT420)
                Dim TbName420 = "GDP/Capita (PPP 2021) Versus Income Below Four Dollars and 20 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName420 = getFunctionNameYrOrMstRct(TbName420, cntx.BaseYear, cntx)
                Dim XYTABL420 = cntx.GetRegression(TbName420).ToEstimator(CGDPPCP)

                Dim yrsIncLT830 As Short() = cntx.GetYears("SeriesIncBelow8D30cPIP").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT830TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow8D30cPIP", yrsIncLT300)
                Dim TbName830 = "GDP/Capita (PPP 2021) Versus Income Below Eight Dollars and 30 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName830 = getFunctionNameYrOrMstRct(TbName830, cntx.BaseYear, cntx)
                Dim XYTABL830 = cntx.GetRegression(TbName830).ToEstimator(CGDPPCP)

                Dim yrsGDP2021 As Short() = cntx.GetYears("GDPPCP2021").OrderBy(Function(y) y).ToArray()
                Dim GDP2021PCPPPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("GDPPCP2021", yrsGDP2021)
                'jrs 2025/09/12 *** end ***

                'jrs 2024/06/28 TbName2$ = "GDP/Capita (PPP 2011) Versus Income Below Three Dollars and 10 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName2$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Income Below Three Dollars and 10 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName2$ = getFunctionNameYrOrMstRct(TbName2$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                XYTABL2 = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP)
                Dim yrsIncLT310 As Short() = cntx.GetYears("SeriesIncBelow3D10cWDI").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT31TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow3D10cWDI", yrsIncLT310)

                'mti 2021/01/29 Start
                Dim TbName3 As String
                Dim XYTABL3 As SeriesEstimator
                'jrs 2024/06/28 TbName3 = "GDP/Capita (PPP 2011) Versus Income Below Three Dollars and 20 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName3 = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Income Below Three Dollars and 20 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName3 = getFunctionNameYrOrMstRct(TbName3, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                XYTABL3 = cntx.GetRegression(TbName3).ToEstimator(CGDPPCP)
                Dim yrsIncLT320 As Short() = cntx.GetYears("SeriesIncBelow3D20cPovcal").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT32TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow3D20cPovcal", yrsIncLT320)

                Dim TbName4 As String
                Dim XYTABL4 As SeriesEstimator
                'jrs 2024/06/28 TbName4 = "GDP/Capita (PPP 2011) Versus Income Below Five Dollars and 50 Cents per Day (" & CStr(BaseYear) & ") Log"
                TbName4 = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Income Below Five Dollars and 50 Cents per Day (" & CStr(BaseYear) & ") Log"
                TbName4 = getFunctionNameYrOrMstRct(TbName4, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                XYTABL4 = cntx.GetRegression(TbName4).ToEstimator(CGDPPCP)
                Dim yrsIncLT550 As Short() = cntx.GetYears("SeriesIncBelow5D50cPovcal").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT55TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow5D50cPovcal", yrsIncLT550)
                'mti 2021/01/29 End

                'jrs 2024/02/26 changed to use PIP data source
                'jrs 2022/11/17 *** start ***
                Dim yrsIncLT365 As Short() = cntx.GetYears("SeriesIncBelow3D65cPIP").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT365TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow3D65cPIP", yrsIncLT365)
                Dim yrsIncLT685 As Short() = cntx.GetYears("SeriesIncBelow6D85cPIP").OrderBy(Function(y) y).ToArray()
                Dim INCOMELT685TBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelow6D85cPIP", yrsIncLT685)
                Dim TbName365 = "GDP/Capita (PPP 2017) Versus Income Below Three Dollars and 65 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName365 = getFunctionNameYrOrMstRct(TbName365, cntx.BaseYear, cntx)
                Dim XYTABL365 = cntx.GetRegression(TbName365).ToEstimator(CGDPPCP)
                Dim TbName685 = "GDP/Capita (PPP 2017) Versus Income Below Six Dollars and 85 Cents per Day (" & CStr(cntx.BaseYear) & ") Log"
                TbName685 = getFunctionNameYrOrMstRct(TbName685, cntx.BaseYear, cntx)
                Dim XYTABL685 = cntx.GetRegression(TbName685).ToEstimator(CGDPPCP)
                'jrs 2022/11/17 *** end ***

                'mti 2021/07/15 start
                Dim yrsINCOMELTNPL As Short() = cntx.GetYears("SeriesIncBelowNPLWDI").OrderBy(Function(y) y).ToArray()
                Dim INCOMELTNPLTBL As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesIncBelowNPLWDI", yrsINCOMELTNPL)
                'mti 2021/07/15 End

                'mti 2021/12/09 start   - National Poverty Threshold 'TblNatPovLine
                Dim yrsTblNatPovLine As Short()
                Dim TblNatPovLine As IDictionary(Of String, Single?())
                'jrs 2025/09/16
                'jrs 2023/04/12
                If ConstantDollarsYear = 2021 Then
                    yrsTblNatPovLine = cntx.GetYears("SeriesPovLineNationalWB2021").OrderBy(Function(y) y).ToArray()
                    TblNatPovLine = cntx.GetDice("SeriesPovLineNationalWB2021", yrsTblNatPovLine)
                ElseIf ConstantDollarsYear = 2017 Then
                    yrsTblNatPovLine = cntx.GetYears("SeriesPovLineNationalWB2017").OrderBy(Function(y) y).ToArray()
                    TblNatPovLine = cntx.GetDice("SeriesPovLineNationalWB2017", yrsTblNatPovLine)
                Else
                    yrsTblNatPovLine = cntx.GetYears("SeriesPovLineNationalWB").OrderBy(Function(y) y).ToArray()
                    TblNatPovLine = cntx.GetDice("SeriesPovLineNationalWB", yrsTblNatPovLine)
                End If


                'mti 2021/12/09 end

                For Each key In cntx.Regionalization.Keys
                    'JRS 2015/11/17 *** BEGIN ***
                    'jrs 2022/11/17 *** start ***
                    'If cntx.HistoricMode Then
                    '    ValHold = XYTABL(key)
                    '    ValHold = Amin(ValHold, 70)
                    '    ValHold = AMAX(ValHold, 0)
                    'Else
                    '    FuncName = TbName
                    '    ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), cntx.FirstYear, INCOMELT19TBL, yrsIncLT190,
                    '    GDP2011PCPPPTbl, yrsGDP2011, key, FuncName, cntx, 100, 0, "Div", 1000)
                    'End If
                    'CINCOMELT19.Add(key, ValHold / 100 * CPOP(key)) 'Convert from Percent to Index form
                    CINCOMELT19.Add(key, CalcCINCOMELTXXXLow(TbName, key, INCOMELT19TBL, yrsIncLT190,
                                                           GDP2011PCPPPTbl, yrsGDP2011, XYTABL, cntx))
                    CINCOMELT215.Add(key, CalcCINCOMELTXXXLow(TbName215, key, INCOMELT215TBL, yrsIncLT215,
                                                           GDP2017PCPPPTbl, yrsGDP2017, XYTABL215, cntx))
                    'jrs 2022/11/17 *** end ***
                    '
                    'jrs 2025/09/12
                    CINCOMELT300.Add(key, CalcCINCOMELTXXXLow(TbName300, key, INCOMELT300TBL, yrsIncLT300,
                                                           GDP2021PCPPPTbl, yrsGDP2021, XYTABL300, cntx))

                    If cntx.HistoricMode Then
                        ValHold = XYTABL2(key)
                        ValHold = Amin(ValHold, 90)
                        ValHold = AMAX(ValHold, 0)
                    Else
                        FuncName = TbName2
                        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), cntx.FirstYear, INCOMELT31TBL, yrsIncLT310,
                        GDP2011PCPPPTbl, yrsGDP2011, key, FuncName, cntx, 100, 0, "Div", 1000)
                    End If
                    CINCOMELT31.Add(key, ValHold / 100 * CPOP(key)) 'Convert from Percent to Index form

                    'mti 2021/08/30 Start
                    'Note - this is not new code, the 32 and 55 variables are just moved up

                    'mti 2021/01/29 Start
                    'jrs 2022/11/17 *** start ***
                    'If cntx.HistoricMode Then
                    '    ValHold = XYTABL3(key)
                    '    ValHold = Amin(ValHold, 90)
                    '    ValHold = AMAX(ValHold, 0)
                    'Else
                    '    FuncName = TbName3

                    '    'mti 2021/12/06 start
                    '    ValHold = Nothing

                    '    portionpoor = CSng(Amin(0.9, CINCOMELT19(key) / AMAX(0.0001, CPOP(key))))
                    '    If portionpoor < 0.0001 Then
                    '        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), cntx.FirstYear, INCOMELT32TBL, yrsIncLT320,
                    '        GDP2011PCPPPTbl, yrsGDP2011, key, FuncName, cntx, 100, 0, "Div", 1000, 10)      'use regression
                    '    Else
                    '        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), FirstYear, INCOMELT32TBL, yrsIncLT320,
                    '        GDP2011PCPPPTbl, yrsGDP2011, key, FuncName, cntx, 100, 0, "Div", 1000, 10, False)    'do not use regression
                    '    End If

                    '    If Not ValHold.HasValue Then

                    '        portionpoor = CSng(Amin(0.9, CINCOMELT19(key) / AMAX(0.0001, CPOP(key))))
                    '        NInv = CalcNormalInverse(portionpoor)

                    '        NInv = CSng(AMAX(-3.5, NInv))

                    '        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                    '        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                    '        LNMean = CSng(Log(365 * 1.9) - lnstddev * NInv)

                    '        'Find portionpoor for <$1/day
                    '        '----------------------------
                    '        portionpoor = CalcLogNormalCDF(365 * 3.2, LNMean, lnstddev)
                    '        ValHold = CSng(AMAX(0, Amin(100, 100 * Round(CSng(portionpoor), 7)))) 'jrs 2020/03/10 try it for Azerbaijan, not matching .NET

                    '    End If
                    '    'mti 2021/12/06 End

                    '    'mti 2021/09/08 End
                    'End If
                    'CINCOMELT32.Add(key, ValHold / 100 * CPOP(key)) 'Convert from Percent to Index form
                    CINCOMELT32.Add(key, CalcCINCOMELTXXXMidHigh(TbName3, key, INCOMELT32TBL, yrsIncLT320, GDP2011PCPPPTbl, yrsGDP2011,
                                                              XYTABL3, CINCOMELT19(key), 1.9, 3.2, cntx)) 'Convert from Percent to Index form

                    CINCOMELT365.Add(key, CalcCINCOMELTXXXMidHigh(TbName365, key, INCOMELT365TBL, yrsIncLT365, GDP2017PCPPPTbl, yrsGDP2017,
                                                              XYTABL365, CINCOMELT215(key), 2.15, 3.65, cntx)) 'Convert from Percent to Index form
                    'jrs 2022/11/17 *** end ***

                    'jrs 2025/09/12
                    CINCOMELT420.Add(key, CalcCINCOMELTXXXMidHigh(TbName420, key, INCOMELT420TBL, yrsIncLT420, GDP2021PCPPPTbl, yrsGDP2021,
                                                              XYTABL420, CINCOMELT300(key), 3.0, 4.2, cntx)) 'Convert from Percent to Index form


                    'jrs 2022/11/17 *** start ***
                    'If cntx.HistoricMode Then
                    '    ValHold = XYTABL4(key)
                    '    ValHold = Amin(ValHold, 90)
                    '    ValHold = AMAX(ValHold, 0)
                    'Else
                    '    FuncName = TbName4
                    '    mti 2021 / 12 / 6 start
                    '    ValHold = Nothing

                    '    portionpoor = CSng(Amin(0.9, CINCOMELT32(key) / AMAX(0.0001, CPOP(key))))
                    '    If portionpoor < 0.0001 Then
                    '        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), FirstYear, INCOMELT55TBL, yrsIncLT550,
                    '        GDP2011PCPPPTbl, yrsGDP2011, key, FuncName, cntx, 100, 0, "Div", 1000, 10)      'use regression
                    '    Else
                    '        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(key), FirstYear, INCOMELT55TBL, yrsIncLT550,
                    '        GDP2011PCPPPTbl, yrsGDP2011, key, FuncName, cntx, 100, 0, "Div", 1000, 10, False)    'do not use regression
                    '    End If

                    '    If Not ValHold.HasValue Then

                    '        portionpoor = CSng(Amin(0.9, CINCOMELT32(key) / AMAX(0.0001, CPOP(key))))
                    '        NInv = CalcNormalInverse(portionpoor)
                    '        NInv = AMAX(-3, NInv)       'for 5.5 poverty - 3; for 3.2 poverty 3.5, for 1.9 poverty 4

                    '        percentage value, put in 0 to 1 scale; do Not put in 0 to 100 scale
                    '        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                    '        LNMean = CSng(Log(365 * 3.2) - lnstddev * NInv)

                    '        Find portionpoor for <$5.5/day
                    '        ----------------------------
                    '        portionpoor = CalcLogNormalCDF(365 * 5.5, LNMean, lnstddev)
                    '        ValHold = CSng(AMAX(0, Amin(100, 100 * Round(CSng(portionpoor), 7)))) 'jrs 2020/03/10 try it for Azerbaijan, not matching .NET

                    '    End If
                    '    mti 2021 / 12 / 6 End
                    'End If
                    'CINCOMELT55.Add(key, ValHold / 100 * CPOP(key)) 'Convert from Percent to Index form
                    CINCOMELT55.Add(key, CalcCINCOMELTXXXMidHigh(TbName4, key, INCOMELT55TBL, yrsIncLT550, GDP2011PCPPPTbl, yrsGDP2011,
                                                              XYTABL4, CINCOMELT32(key), 3.2, 5.5, cntx)) 'Convert from Percent to Ind

                    CINCOMELT685.Add(key, CalcCINCOMELTXXXMidHigh(TbName685, key, INCOMELT685TBL, yrsIncLT685, GDP2017PCPPPTbl, yrsGDP2017,
                                                              XYTABL685, CINCOMELT365(key), 3.65, 6.85, cntx)) 'Convert from Percent to Index form
                    'jrs 2022/11/17 *** end ***

                    'jrs 2025/09/12
                    CINCOMELT830.Add(key, CalcCINCOMELTXXXMidHigh(TbName830, key, INCOMELT830TBL, yrsIncLT830, GDP2021PCPPPTbl, yrsGDP2021,
                                                              XYTABL830, CINCOMELT420(key), 4.2, 8.3, cntx)) 'Convert from Percent to Index form

                    'We need some level of poverty at <$1/day, when <$2/day is non-zero
                    If CINCOMELT19(key) = 0 And CINCOMELT31(key) > 0 Then
                        'Compute NSNARAT2
                        '----------------
                        portionpoor = Amin(0.9F, CINCOMELT31(key) / AMAX(0.0001F, CPOP(key)))

                        NInv = CalcNormalInverse(portionpoor)

                        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))

                        LNMean = CSng(Log(365 * 3.1) - lnstddev * NInv)

                        'Find portionpoor for <$1/day
                        '----------------------------
                        portionpoor = CalcLogNormalCDF(365 * 1.9, LNMean, lnstddev)
                        portionpoor = CSng(Round(CDbl(portionpoor), 7)) 'jrs 2020/03/10 try it for Azerbaijan, not matching vb6
                        CINCOMELT19(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                    End If

                    'mti 2021/08/30 End

                    'jrs 2022/11/17 *** start ***
                    'We need some level of poverty at <$1/day, when <$2/day is non-zero
                    If CINCOMELT215(key) = 0 And CINCOMELT365(key) > 0 Then
                        'Compute NSNARAT2
                        '----------------
                        portionpoor = Amin(0.9F, CINCOMELT365(key) / AMAX(0.0001F, CPOP(key)))

                        NInv = CalcNormalInverse(portionpoor)

                        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))

                        LNMean = CSng(Log(365 * 3.65) - lnstddev * NInv)

                        'Find portionpoor for <$1/day
                        '----------------------------
                        portionpoor = CalcLogNormalCDF(365 * 2.15, LNMean, lnstddev)
                        portionpoor = CSng(Round(CDbl(portionpoor), 7)) 'jrs 2020/03/10 try it for Azerbaijan, not matching vb6
                        CINCOMELT215(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                    End If
                    'jrs 2022/11/17 *** end ***

                    'jrs 2025/09/12 *** start ***
                    'We need some level of poverty at <$1/day, when <$2/day is non-zero
                    If CINCOMELT300(key) = 0 And CINCOMELT420(key) > 0 Then
                        'Compute NSNARAT2
                        '----------------
                        portionpoor = Amin(0.9F, CINCOMELT420(key) / AMAX(0.0001F, CPOP(key)))

                        NInv = CalcNormalInverse(portionpoor)

                        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))

                        LNMean = CSng(Log(365 * 4.2) - lnstddev * NInv)

                        'Find portionpoor for <$1/day
                        '----------------------------
                        portionpoor = CalcLogNormalCDF(365 * 3, LNMean, lnstddev)
                        portionpoor = CSng(Round(CDbl(portionpoor), 7))
                        CINCOMELT300(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                    End If
                    'jrs 2025/09/12 *** end ***

                    '$3.1/day has to be higher or equal than $1.9/day
                    If CINCOMELT31(key) < CINCOMELT19(key) Then
                        'Look for Most Recent data
                        '<$1/day
                        iYr1 = getMstRctYr(INCOMELT19TBL, yrsIncLT190, key)
                        '<$2/day
                        iYr2 = getMstRctYr(INCOMELT31TBL, yrsIncLT310, key)
                        'Use the most recent data to find the other level with lognomral formulation
                        'mti 2021/09/08 Start
                        'If iYr2 > iYr1 Then
                        If iYr2 > iYr1 And iYr1 > 0 Then  'both have data, 3.1 data is more recent
                            'mti 2021/09/08 End
                            'Keep $3.1/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT31(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                            LNMean = CSng(Log(365 * 3.1) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(365 * 1.9, LNMean, lnstddev)

                            CINCOMELT19(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        Else
                            'Keep $1.9/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT19(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))

                            LNMean = CSng(Log(365 * 1.9) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(365 * 3.1, LNMean, lnstddev)
                            CINCOMELT31(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        End If

                        If CINCOMELT31(key) < CINCOMELT19(key) Or
                ((CINCOMELT31(key) * 100 / CPOP(key)) > 5 And
                    (CINCOMELT31(key) * 100 / CPOP(key)) < (CINCOMELT19(key) * 100 / CPOP(key)) + 2) Then
                            'at least 5% point
                            If cntx.DevelopmentMode Then
                                Debug.Print("Inconsistent Poverty Numbers ($2011) Persist for " & key & vbCr &
                                "Resetting Initialization Values using Average.") ', vbInformation, "Economic Preprocessor"
                            End If
                            AvgINCOMELT = (CINCOMELT19(key) + CINCOMELT31(key)) / 2
                            CINCOMELT19(key) = CSng(0.9 * AvgINCOMELT)
                            CINCOMELT31(key) = CSng(1.1 * AvgINCOMELT)
                        End If
                    End If 'end of If CINCOMELT2(key) < CINCOMELT1(key) Then

                    'JRS 2015/11/17 *** END ***

                    'jrs 2022/11/17 *** start ***
                    '$3.65/day has to be higher or equal than $2.15/day
                    If CINCOMELT365(key) < CINCOMELT215(key) Then
                        'Look for Most Recent data
                        '<$2.15/day
                        iYr1 = getMstRctYr(INCOMELT215TBL, yrsIncLT215, key)
                        '<$3.65/day
                        iYr2 = getMstRctYr(INCOMELT365TBL, yrsIncLT365, key)
                        'Use the most recent data to find the other level with lognomral formulation
                        If iYr2 > iYr1 And iYr1 > 0 Then  'both have data, 3.65 data is more recent
                            'Keep $3.65/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT365(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                            LNMean = CSng(Log(365 * 3.65) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(365 * 2.15, LNMean, lnstddev)

                            CINCOMELT215(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        Else
                            'Keep $2.15/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT215(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))

                            LNMean = CSng(Log(365 * 2.15) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(365 * 3.65, LNMean, lnstddev)
                            CINCOMELT365(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        End If

                        If CINCOMELT365(key) < CINCOMELT215(key) Or
                        ((CINCOMELT365(key) * 100 / CPOP(key)) > 5 And
                        (CINCOMELT365(key) * 100 / CPOP(key)) < (CINCOMELT215(key) * 100 / CPOP(key)) + 2) Then
                            'at least 5% point
                            If cntx.DevelopmentMode Then
                                Debug.Print("Inconsistent Poverty Numbers ($2017) Persist for " & key & vbCr &
                                "Resetting Initialization Values using Average.") ', vbInformation, "Economic Preprocessor"
                            End If
                            AvgINCOMELT = (CINCOMELT215(key) + CINCOMELT365(key)) / 2
                            CINCOMELT215(key) = CSng(0.9 * AvgINCOMELT)
                            CINCOMELT365(key) = CSng(1.1 * AvgINCOMELT)
                        End If
                    End If 'end of If CINCOMELT2(key) < CINCOMELT1(key) Then
                    'jrs 2022/11/17 *** end ****

                    'jrs 2025/09/12 *** start ***
                    '$3.65/day has to be higher or equal than $2.15/day
                    If CINCOMELT420(key) < CINCOMELT300(key) Then
                        'Look for Most Recent data
                        '<$2.15/day
                        iYr1 = getMstRctYr(INCOMELT300TBL, yrsIncLT300, key)
                        '<$3.65/day
                        iYr2 = getMstRctYr(INCOMELT420TBL, yrsIncLT420, key)
                        'Use the most recent data to find the other level with lognomral formulation
                        If iYr2 > iYr1 And iYr1 > 0 Then  'both have data, 3.65 data is more recent
                            'Keep $3.65/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT420(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                            LNMean = CSng(Log(365 * 4.2) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(365 * 3, LNMean, lnstddev)

                            CINCOMELT300(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        Else
                            'Keep $2.15/day numbers
                            'Lognormal Formulation
                            portionpoor = Amin(0.9F, CINCOMELT300(key) / AMAX(0.0001F, CPOP(key)))

                            NInv = CalcNormalInverse(portionpoor)

                            'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                            lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))

                            LNMean = CSng(Log(365 * 3) - lnstddev * NInv)

                            'Find portionpoor
                            '----------------------------
                            portionpoor = CalcLogNormalCDF(365 * 4.2, LNMean, lnstddev)
                            CINCOMELT420(key) = Amin(CSng(0.9 * CPOP(key)), portionpoor * CPOP(key))
                        End If

                        If CINCOMELT420(key) < CINCOMELT300(key) Or
                        ((CINCOMELT420(key) * 100 / CPOP(key)) > 5 And
                        (CINCOMELT420(key) * 100 / CPOP(key)) < (CINCOMELT300(key) * 100 / CPOP(key)) + 2) Then
                            'at least 5% point
                            If cntx.DevelopmentMode Then
                                Debug.Print("Inconsistent Poverty Numbers ($2021) Persist for " & key & vbCr &
                                "Resetting Initialization Values using Average.") ', vbInformation, "Economic Preprocessor"
                            End If
                            AvgINCOMELT = (CINCOMELT300(key) + CINCOMELT420(key)) / 2
                            CINCOMELT300(key) = CSng(0.9 * AvgINCOMELT)
                            CINCOMELT420(key) = CSng(1.1 * AvgINCOMELT)
                        End If
                    End If 'end of If CINCOMELT2(key) < CINCOMELT1(key) Then
                    'jrs 2025/09/12 *** end ****

                    'mti 2020/03/11 Start
                    If CINCOMELT19(key) < CSng(0.000002) Then CINCOMELT19(key) = 0  'less than 2 poor in total, make it 0
                    CINCOMELT19(key) = CSng(Round(CDbl(CINCOMELT19(key)), 6))  'rounding for better poverty accounting across age-sex
                    'mti 2020/03/11 End

                    '$3.2/day has to be higher or equal than $1.9/day
                    If CINCOMELT32(key) < CINCOMELT19(key) Then
