                        CMIDBINYrs.Add(sActor, New Dictionary(Of String, Single?()))
                    End If
                    sPartner = item.Key.Split(";".ToCharArray)(1)

                    'Weighted Average 19 previous years + current year
                    PastVal = 0

                    For k = 1950 To yrsBW(yrsBW.Count - 1)
                        If k = 1950 Then
                            For M = 1931 To 1950
                                If BandWidthTbl(item.Key)(yrBW50Idx + M - 1950).HasValue Then
                                    PastVal = PastVal + BandWidthTbl(item.Key)(yrBW50Idx + M - 1950)
                                End If
                            Next
                            'jrs 2019/02/28 DependenceTbl.Fields("Earliest") = CDbl(Format(Round(PastVal * 5, 5), ".00000"))
                        Else
                            'jrs 2020/10/08
                            If k > BaseYear Then Exit For

                            If BandWidthTbl(item.Key)(yrBW50Idx + k - 1950).HasValue Then
                                PastVal = PastVal + BandWidthTbl(item.Key)(yrBW50Idx + k - 1950)
                            End If
                            If BandWidthTbl(item.Key)(yrBW50Idx + k - 1950 - 20).HasValue Then
                                PastVal = PastVal - BandWidthTbl(item.Key)(yrBW50Idx + k - 1950 - 20)
                            End If
                            If k = yrsBW(yrsBW.Count - 1) Then
                                'jrs 2019/02/28 DependenceTbl.Fields("MostRecent") = CDbl(Format(Round(PastVal * 5, 5), ".00000"))
                            End If
