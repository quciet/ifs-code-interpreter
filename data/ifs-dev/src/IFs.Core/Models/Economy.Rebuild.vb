                WorldOutFlows = 0

                For Each key In cntx.Regionalization.Keys
                    WorldInFlows = WorldInFlows + CXFDIFIN(key)
                    WorldOutFlows = WorldOutFlows + CXFDIFOUT(key)
                Next
                WorldOutFlows = AMAX(0.001F, WorldOutFlows)
                For Each key In cntx.Regionalization.Keys
                    CXFDIFOUT(key) = CXFDIFOUT(key) * WorldInFlows / WorldOutFlows
                Next

                '   Allocate Worker Remittances to Source Country by Foreign Worker Numbers
