                           Function(grp) grp.RegionId,
                           Function(grp) grp.TotalVal)
                    POP.Add(item.Key, CSng(item.Value))
                Next

                For i = 1 To NR
                    MIGRATEOUT(i) = MIGRANTSOUT(i) / POP(i) * 100 'jrs 2020/06/12
                    MIGRATEIN(i) = MIGRANTSIN(i) / POP(i) * 100 'jrs 2020/06/12
