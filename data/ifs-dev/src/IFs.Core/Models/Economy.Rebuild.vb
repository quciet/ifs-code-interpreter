            Private Sub FillHoles4ComplementarityIndex(cntx As IRebuildFacade)
                Dim iHoles As Integer
                Dim TCIavg As Single?
                For Each keyi In cntx.Regionalization.Keys
                    If Not CDYADTRADECOMPLEMENTAGR.ContainsKey(keyi) Then
                        CDYADTRADECOMPLEMENTAGR.Add(keyi, New Dictionary(Of String, Single?))
                    End If
                    If Not CDYADTRADECOMPLEMENTENE.ContainsKey(keyi) Then
                        CDYADTRADECOMPLEMENTENE.Add(keyi, New Dictionary(Of String, Single?))
                    End If
                    If Not CDYADTRADECOMPLEMENTMAT.ContainsKey(keyi) Then
                        CDYADTRADECOMPLEMENTMAT.Add(keyi, New Dictionary(Of String, Single?))
                    End If
                    If Not CDYADTRADECOMPLEMENTMAN.ContainsKey(keyi) Then
                        CDYADTRADECOMPLEMENTMAN.Add(keyi, New Dictionary(Of String, Single?))
                    End If
                    If Not CDYADTRADECOMPLEMENTSER.ContainsKey(keyi) Then
                        CDYADTRADECOMPLEMENTSER.Add(keyi, New Dictionary(Of String, Single?))
                    End If
                    If Not CDYADTRADECOMPLEMENTICT.ContainsKey(keyi) Then
                        CDYADTRADECOMPLEMENTICT.Add(keyi, New Dictionary(Of String, Single?))
                    End If

                    For Each keyj In cntx.Regionalization.Keys
                        iHoles = 0
                        TCIavg = 0
                        If keyi <> keyj Then
                            If Not CDYADTRADECOMPLEMENTAGR(keyi).ContainsKey(keyj) OrElse Not CDYADTRADECOMPLEMENTAGR(keyi)(keyj).HasValue Then
                                iHoles = iHoles + 1
                            Else
                                TCIavg = TCIavg + CDYADTRADECOMPLEMENTAGR(keyi)(keyj)
                            End If
                            If Not CDYADTRADECOMPLEMENTENE(keyi).ContainsKey(keyj) OrElse Not CDYADTRADECOMPLEMENTENE(keyi)(keyj).HasValue Then
                                iHoles = iHoles + 1
                            Else
                                TCIavg = TCIavg + CDYADTRADECOMPLEMENTENE(keyi)(keyj)
                            End If
                            If Not CDYADTRADECOMPLEMENTMAT(keyi).ContainsKey(keyj) OrElse Not CDYADTRADECOMPLEMENTMAT(keyi)(keyj).HasValue Then
                                iHoles = iHoles + 1
                            Else
                                TCIavg = TCIavg + CDYADTRADECOMPLEMENTMAT(keyi)(keyj)
                            End If
                            If Not CDYADTRADECOMPLEMENTMAN(keyi).ContainsKey(keyj) OrElse Not CDYADTRADECOMPLEMENTMAN(keyi)(keyj).HasValue Then
                                iHoles = iHoles + 1
                            Else
                                TCIavg = TCIavg + CDYADTRADECOMPLEMENTMAN(keyi)(keyj)
                            End If
                            If Not CDYADTRADECOMPLEMENTICT(keyi).ContainsKey(keyj) OrElse Not CDYADTRADECOMPLEMENTICT(keyi)(keyj).HasValue Then
                                iHoles = iHoles + 1
                            Else
                                TCIavg = TCIavg + CDYADTRADECOMPLEMENTICT(keyi)(keyj)
                            End If
                            'If Not CDYADTRADECOMPLEMENTSER(keyi).ContainsKey(keyj) OrElse Not CDYADTRADECOMPLEMENTSER(keyi)(keyj).HasValue Then
                            iHoles = iHoles + 1
                            'Else
                            '    TCIavg = TCIavg + CDYADTRADECOMPLEMENTSER(keyi)(keyj)
                            'End If

                            If iHoles = 6 Then
                                CDYADTRADECOMPLEMENTAGR(keyi)(keyj) = 0.02
                                CDYADTRADECOMPLEMENTENE(keyi)(keyj) = 0.02
                                CDYADTRADECOMPLEMENTMAT(keyi)(keyj) = 0.02
                                CDYADTRADECOMPLEMENTMAN(keyi)(keyj) = 0.02
                                CDYADTRADECOMPLEMENTICT(keyi)(keyj) = 0.02
                                CDYADTRADECOMPLEMENTSER(keyi)(keyj) = 0.02
                            Else
                                If Not CDYADTRADECOMPLEMENTAGR(keyi).ContainsKey(keyj) Then
                                    CDYADTRADECOMPLEMENTAGR(keyi).Add(keyj, TCIavg / iHoles)
                                ElseIf Not CDYADTRADECOMPLEMENTAGR(keyi)(keyj).HasValue Then
                                    CDYADTRADECOMPLEMENTAGR(keyi)(keyj) = TCIavg / iHoles
                                End If
                                If Not CDYADTRADECOMPLEMENTENE(keyi).ContainsKey(keyj) Then
                                    CDYADTRADECOMPLEMENTENE(keyi).Add(keyj, TCIavg / iHoles)
                                ElseIf Not CDYADTRADECOMPLEMENTene(keyi)(keyj).HasValue Then
                                    CDYADTRADECOMPLEMENTENE(keyi)(keyj) = TCIavg / iHoles
                                End If
                                If Not CDYADTRADECOMPLEMENTMAT(keyi).ContainsKey(keyj) Then
                                    CDYADTRADECOMPLEMENTMAT(keyi).Add(keyj, TCIavg / iHoles)
                                ElseIf Not CDYADTRADECOMPLEMENTmat(keyi)(keyj).HasValue Then
                                    CDYADTRADECOMPLEMENTMAT(keyi)(keyj) = TCIavg / iHoles
                                End If
                                If Not CDYADTRADECOMPLEMENTMAN(keyi).ContainsKey(keyj) Then
                                    CDYADTRADECOMPLEMENTMAN(keyi).Add(keyj, TCIavg / iHoles)
                                ElseIf Not CDYADTRADECOMPLEMENTman(keyi)(keyj).HasValue Then
                                    CDYADTRADECOMPLEMENTMAN(keyi)(keyj) = TCIavg / iHoles
                                End If
                                If Not CDYADTRADECOMPLEMENTICT(keyi).ContainsKey(keyj) Then
                                    CDYADTRADECOMPLEMENTICT(keyi).Add(keyj, TCIavg / iHoles)
                                ElseIf Not CDYADTRADECOMPLEMENTict(keyi)(keyj).HasValue Then
                                    CDYADTRADECOMPLEMENTICT(keyi)(keyj) = TCIavg / iHoles
                                End If
                                If Not CDYADTRADECOMPLEMENTSER(keyi).ContainsKey(keyj) Then
                                    CDYADTRADECOMPLEMENTSER(keyi).Add(keyj, TCIavg / iHoles)
                                ElseIf Not CDYADTRADECOMPLEMENTser(keyi)(keyj).HasValue Then
                                    CDYADTRADECOMPLEMENTSER(keyi)(keyj) = TCIavg / iHoles
                                End If
                            End If 'if iholes=6 else
                        End If
                    Next
                Next
            End Sub

