                '    PovertyNormalizeAgeGroupFromPopNRate key, CPOVRATEBOTHSEXES(), CPopPovAGBothSexes(), CINCOMELT19(key)
                '    'mti 2021/07/15 end

                For Each key In cntx.Regionalization.Keys
                    CPOVGNDRATIO.Add(key, New Dictionary(Of Integer, Single?))
                    For AGCount = 1 To TotPovAGCount
                        CPOVGNDRATIO(key).Add(AGCount, 0)
                        If CPOVRATEFEMALE(key)(AGCount).HasValue And CPOVRATEMALE(key)(AGCount).HasValue And povagesexgeneric = 0 Then
                            If CPOVRATEMALE(key)(AGCount) = 0 Then
                                If CPOVRATEFEMALE(key)(AGCount) = 0 Then
                                    CPOVGNDRATIO(key)(AGCount) = 1
                                Else
                                    CPOVRATEMALE(key)(AGCount) = CPOVRATEFEMALE(key)(AGCount) / 2 'set male pov arbitrarily to half of female value, when female pov positive, male pov zero
                                    CPOVGNDRATIO(key)(AGCount) = CPOVRATEFEMALE(key)(AGCount) / CPOVRATEMALE(key)(AGCount)
                                End If
                            Else
                                CPOVGNDRATIO(key)(AGCount) = CPOVRATEFEMALE(key)(AGCount) / CPOVRATEMALE(key)(AGCount)
                                'jrs 2024/01/29
                                'Need limits to avoid going above 90%
                                If CPOVRATEBOTHSEXES(key)(AGCount) <> 0 Then
                                    'TotPov = PovBothSex*(Males + Females)
                                    '90 = TotPov/(Males+Ratio*Females)
                                    'Males + ratio*Females = TotPov/90
                                    'Ratio = (TotPov/90 - Males)/Females
                                    CPOVGNDRATIO(key)(AGCount) = AMAX(CPOVGNDRATIO(key)(AGCount), (CPOVRATEBOTHSEXES(key)(AGCount) * (CPopPovAGMale(key)(AGCount) + CPopPovAGFemale(key)(AGCount)) / 90 - CPopPovAGMale(key)(AGCount)) / CPopPovAGFemale(key)(AGCount))
                                    '90 = RatMale*Ratio
                                    'Ratio=90/(Tot Pov/(Males+Ratio*Females))
                                    'Ratio=90*(Males+Ratio*Females)/tot pov
                                    'Ratio-90*Ratio*Females/TotPov=90*Males/tot pov
                                    'Ratio=90*Males/(Tot Pov*(1-90*Females/Tot Pov))
                                    'Ratio = 90*Males/(TotPov-90*Females)
                                    If (CPOVRATEBOTHSEXES(key)(AGCount) * (CPopPovAGMale(key)(AGCount) + CPopPovAGFemale(key)(AGCount)) > 90 * CPopPovAGFemale(key)(AGCount)) Then
                                        CPOVGNDRATIO(key)(AGCount) = Amin(CPOVGNDRATIO(key)(AGCount), 90 * CPopPovAGMale(key)(AGCount) / (CPOVRATEBOTHSEXES(key)(AGCount) * (CPopPovAGMale(key)(AGCount) + CPopPovAGFemale(key)(AGCount)) - 90 * CPopPovAGFemale(key)(AGCount)))
                                    End If
                                End If
                            End If
                        Else
                            CPOVGNDRATIO(key)(AGCount) = PovRatioSex(AGCount) 'get gender ratio from poverty profile
                        End If  'Else

                        'Even when female and male age-sex poverty rates are from data, that data will be used for gender ratio only;
                        'the female and male rates will be determined from both sexes rate, gender ratio and population
                        If CPOVRATEBOTHSEXES(key)(AGCount) <> 0 Then
                            'using povratemale * males + povratefemale * females = POVRATEBOTHSEXES * bothsexespop; and sexratio = povratefemale/povratemale
                            'jrs 2028/01/29 added formula algebra
                            'povratemale  = (POVRATEBOTHSEXES * bothsexespop - povratefemale  females)/ males 

                            'sexratio = POVRATEFEMALE / POVRATEMALE

                            'POVRATEMALE = (POVRATEBOTHSEXES * bothsexespop - sexratio * POVRATEMALE  females)/ males 
                            'POVRATEMALE +sexratio * POVRATEMALE  females/ males  = POVRATEBOTHSEXES * bothsexespop / males 
                            'POVRATEMALE = (POVRATEBOTHSEXES * bothsexespop / males) / (1 + sexratio * females / males)
                            'POVRATEMALE = (POVRATEBOTHSEXES * bothsexespop) / (males + sexratio * females)
                            CPOVRATEMALE(key)(AGCount) = CPOVRATEBOTHSEXES(key)(AGCount) * (CPopPovAGMale(key)(AGCount) + CPopPovAGFemale(key)(AGCount)) / (CPopPovAGMale(key)(AGCount) + CPOVGNDRATIO(key)(AGCount) * CPopPovAGFemale(key)(AGCount))
                            CPOVRATEFEMALE(key)(AGCount) = CPOVGNDRATIO(key)(AGCount) * CPOVRATEMALE(key)(AGCount)
                        Else
                            CPOVGNDRATIO(key)(AGCount) = 1
                            CPOVRATEMALE(key)(AGCount) = 0
                            CPOVRATEFEMALE(key)(AGCount) = 0
                        End If

                        'End If
                    Next
                Next

                Call RegAvgCohortWeight(CPOVRATEBOTHSEXES, POVRATEBOTHSEXES, CPopPovAGBothSexes, "POVERTYRATEAGEGROUPBOTHSEXES", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEFEMALE, POVRATEFEMALE, CPopPovAGFemale, "POVERTYRATEAGEGROUPFEMALE", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEMALE, POVRATEMALE, CPopPovAGMale, "POVERTYRATEAGEGROUPMALE", False, cntx, 1, TotPovAGCount)

                'mti 2021/01/29 start
                Call RegAvgCohortWeight(CPOVRATEBOTHSEXES32, POVRATEBOTHSEXES32, CPopPovAGBothSexes, "POVERTYRATEAGEGROUPBOTHSEXES32", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEFEMALE32, POVRATEFEMALE32, CPopPovAGFemale, "POVERTYRATEAGEGROUPFEMALE32", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEMALE32, POVRATEMALE32, CPopPovAGMale, "POVERTYRATEAGEGROUPMALE32", False, cntx, 1, TotPovAGCount)

                Call RegAvgCohortWeight(CPOVGNDRATIO32, POVGNDRATIO32, CPopPovAGBothSexes, "POVERTYAGEGROUPGENDERRATIO32", False, cntx, 1, TotPovAGCount)

                Call RegAvgCohortWeight(CPOVRATEBOTHSEXES55, POVRATEBOTHSEXES55, CPopPovAGBothSexes, "POVERTYRATEAGEGROUPBOTHSEXES55", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEFEMALE55, POVRATEFEMALE55, CPopPovAGFemale, "POVERTYRATEAGEGROUPFEMALE55", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEMALE55, POVRATEMALE55, CPopPovAGMale, "POVERTYRATEAGEGROUPMALE55", False, cntx, 1, TotPovAGCount)

                'mti 2021/07/15
                Call RegAvgCohortWeight(CPOVRATEBOTHSEXESNPL, POVRATEBOTHSEXESNPL, CPopPovAGBothSexes, "POVERTYRATEAGEGROUPBOTHSEXESNPL", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEFEMALENPL, POVRATEFEMALENPL, CPopPovAGFemale, "POVERTYRATEAGEGROUPFEMALENPL", False, cntx, 1, TotPovAGCount)
                Call RegAvgCohortWeight(CPOVRATEMALENPL, POVRATEMALENPL, CPopPovAGMale, "POVERTYRATEAGEGROUPMALENPL", False, cntx, 1, TotPovAGCount)

                Call RegAvgCohortWeight(CPOVGNDRATIO55, POVGNDRATIO55, CPopPovAGBothSexes, "POVERTYAGEGROUPGENDERRATIO55", False, cntx, 1, TotPovAGCount)

                Call RegAvgCohortWeight(CPOVGNDRATIONPL, POVGNDRATIONPL, CPopPovAGBothSexes, "POVERTYAGEGROUPGENDERRATIONPL", False, cntx, 1, TotPovAGCount)
                'mti 2021/01/29 end

                Call RegAvgCohortWeight(CPOVGNDRATIO, POVGNDRATIO, CPopPovAGBothSexes, "POVERTYAGEGROUPGENDERRATIOB", False, cntx, 1, TotPovAGCount)


                For AGCount = 1 To TotPovAGCount
                    Call RegSumTwoDimInMem(CPopPovAGMale, PopPovAGMale, AGCount, "PopMaleByPovertyAgeGroup", cntx)
                    Call RegSumTwoDimInMem(CPopPovAGFemale, PopPovAGFemale, AGCount, "PopFemaleByPovertyAgeGroup", cntx)
                Next
            End Sub

            Private Sub PovertyNormalizeAgeGroupFromPopNRate(sCountry As String, PovRateVec As Dictionary(Of String, Dictionary(Of Integer, Single?)), PopCountVec As Dictionary(Of String, Dictionary(Of Integer, Single?)), povnational_hc As Single?, Optional MaxAGRate% = 90)
                '---------------------------------------------------------------------
                'mti 2021/12/09 Take proc
                'mti 2021/07/15 Take procedure
                'mti 2021/01/29 - new procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)

				'gvdb 2024/04/05
                'unused variable
                Dim j As Integer, NormFac As Single, NonNormTot As Single ' gndr As Integer, 
                Dim PovCountVec(TotPovAGCount) As Single

                If povnational_hc < 0.000002 Then    'no poor or less than 2 poor in total, make it 0
                    PovCountVec(TotPovAGCount) = 0
                    PovRateVec(sCountry)(TotPovAGCount) = 0
                    For j% = 1 To TotPovAGCount
                        PovRateVec(sCountry)(j%) = 0
                        PovCountVec(j%) = 0
                    Next
                    Exit Sub
                End If

                Dim NatRate = Amin(100, 100 * povnational_hc / PopCountVec(sCountry)(TotPovAGCount))

                NormFac = 2
                Dim LCount = 0
                Do While Abs(NormFac - 1) > 0.0001 And LCount < 10

                    LCount = LCount + 1
                    NonNormTot = 0
                    For j% = 1 To TotPovAGCount - 1 'Last elenment is all ages
                        'jrs 2022/01/06 PovCountVec(j%) = CSng(AMAX(0, PovRateVec(sCountry)(j%) * PopCountVec(sCountry)(j%) / 100))
                        PovCountVec(j%) = CSng(AMAX(0, If(PovRateVec(sCountry)(j%), 0) * PopCountVec(sCountry)(j%) / 100))
                        NonNormTot = NonNormTot + PovCountVec(j%)  'PovRateVec(sCountry, j%) * PopCountVec(sCountry, j%) / 100
                    Next

                    If NonNormTot = 0 Then
                        PovCountVec(TotPovAGCount) = 0
                        PovRateVec(sCountry)(TotPovAGCount) = 0
                        For j% = 1 To TotPovAGCount
                            PovRateVec(sCountry)(j%) = 0
                            PovCountVec(j%) = 0
                        Next
                        Exit Sub
                    End If

                    NormFac = CSng(povnational_hc / NonNormTot)

                    PovCountVec(TotPovAGCount) = CSng(povnational_hc) '0  'povnational_hc

                    'mti 2021/12/09 start
                    Dim AllAgeGroupTot As Single = 0

                    'For j% = 2 To TotPovAGCount - 1
                    For j% = 1 To TotPovAGCount - 1
                        'mti 2021/12/09 End
                        'age groups other than All Ages
                        'If L = 1 Then
                        PovCountVec(j%) = CSng(Round(PovCountVec(j%) * NormFac, 6))
                        '            Else
                        '                PovCountVec(j%) = Round(PovCountVec(j%) + 2, 6)
                        '            End If


                        If PovCountVec(j%) < 0.000002 Then  'less than 2 poor person, make it 0
                            PovCountVec(j%) = 0
                        End If
                        'mti 2020/04/29 start
                        'PovRateVec(sCountry, j%) = 100 * PovCountVec( j%) / PopCountVec(sCountry, j%)
                        PovRateVec(sCountry)(j%) = CSng(Amin(AMAX(MaxAGRate, NatRate), 100 * PovCountVec(j%) / AMAX(0.000001, PopCountVec(sCountry)(j%))))
                        'mti 2020/04/29 End

                        'mti 2021/12/09 start
                        'AllAgeGroupButChild = AllAgeGroupButChild + PovCountVec(j%)
                        AllAgeGroupTot = CSng(AllAgeGroupTot + PovCountVec(j%))
                        'mti 2021/12/09 End

                    Next

                    'Mismatch = AMAX(0, Round(PovCountVec(TotPovAGCount) - AllAgeGroupTot, 6))


                    '        'give the remaining, if any to 0-14 group
                    '        PovCountVec(1) = AMAX(0, Round(PovCountVec(TotPovAGCount) - AllAgeGroupButChild, 6))
                    '        'mti 2020/04/29 start
                    '        'PovRateVec(sCountry, 1) = 100 * PovCountVec( 1) / POPPOVAG(sCountry, 1)
                    '        PovRateVec(sCountry, 1) = Amin(AMAX(MaxAGRate, NatRate), 100 * PovCountVec(1) / AMAX(0.000001, PopCountVec(sCountry, 1)))

                Loop

                '        For j% = 1 To TotPovAGCount - 1
                '
                '        Next


                'PovRateVec(sCountry, TotPovAGCount) = 100 * PovCountVec( TotPovAGCount) / POPPOVAG(sCountry, TotPovAGCount)
                PovRateVec(sCountry)(TotPovAGCount) = CSng(100 * PovCountVec(TotPovAGCount) / AMAX(0.000001, PopCountVec(sCountry)(TotPovAGCount)))
                'mti 2020/04/29 End
            End Sub

            'mti 2021/07/15
            Private Sub PovComputeAGPovFromAnother(sCountry As String, PopByAge As Dictionary(Of String, Dictionary(Of Integer, Single?)), PovRateCompute As Dictionary(Of String, Dictionary(Of Integer, Single?)), povnational_hcCompute As Single?, PovRateUse As Dictionary(Of String, Dictionary(Of Integer, Single?)), povnational_hcUse As Single?, PovLineCompute As Single?, Optional PovlineUse As Single? = 1.9)
                '-----------------------------------------------------------------------------------------------------------------------------
                'mti 2021/12/09 Take entire procedure
                'mti 2021/01/29 - new procedure
                'mti 2020/03/11 - Take entire procedure (mti took off detail marking (that is required for ppc modules only per JRS, I have saved copy anyway, just in case)

				'gvdb 2024/04/05
                ' unused variable
                Dim j As Integer ', gndr As Integer, NormFac As Single, NonNormTot As Single
                Dim NPCountCompute(TotPovAGCount), NPCountUse(TotPovAGCount) As Single

                If povnational_hcCompute < 0.000002 Then    'no poor or less than 2 poor in total, make it 0
                    'PovCountCompute(TotPovAGCount) = 0
                    PovRateCompute(sCountry)(TotPovAGCount) = 0
                    For j% = 1 To TotPovAGCount
                        PovRateCompute(sCountry)(j%) = 0
                        'PovCountCompute(j%) = 0
                    Next
                    Exit Sub
                End If

                'mti 2021/12/09 start
                Dim FromLogNormal = 1 'mti 2022/01/06 - reverted - changes 1 to 0 to go back to scaleup per DB;

                If FromLogNormal = 1 Then

                    For j% = 1 To TotPovAGCount - 1
                        'Both Sexeds ---------------
                        portionpoor = CSng(Amin(0.9, PovRateUse(sCountry)(j%) / 100))

                        Dim NInv = CalcNormalInverse(portionpoor)
                        NInv = AMAX(-3, NInv)       'for 5.5 poverty - 3; for 3.2 poverty 3.5, for 1.9 poverty 4
                        '
                        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                        Dim lnstddev = Sqrt(2) * CalcNormalInverse((CGINIDOM(sCountry) + 1) / 2)
                        Dim LNMean = Log(CSng(365 * PovlineUse)) - lnstddev * NInv

                        portionpoor = CSng(CalcLogNormalCDF(CSng(365 * PovLineCompute), CSng(LNMean), CSng(lnstddev)))
                        Dim ValHold = AMAX(0, Amin(99, 100 * Round(portionpoor, 7))) 'jrs 2020/03/10 try it for Azerbaijan, not matching .NET
                        PovRateCompute(sCountry)(j%) = 100 * portionpoor

                    Next

                Else

                    Dim NPTotRat = (PopByAge(sCountry)(TotPovAGCount) - povnational_hcCompute) / (PopByAge(sCountry)(TotPovAGCount) - povnational_hcUse)
                    For j% = 1 To TotPovAGCount - 1 'Last elenment is all ages
                        NPCountUse(j%) = CSng(AMAX(0, (100 - PovRateUse(sCountry)(j%)) * PopByAge(sCountry)(j%) / 100))
                        NPCountCompute(j%) = CSng(NPCountUse(j%) * NPTotRat)
                        PovRateCompute(sCountry)(j%) = 100 * (PopByAge(sCountry)(j%) - NPCountCompute(j%)) / PopByAge(sCountry)(j%)
                    Next

                End If
                'mti 2021/12/09 End


            End Sub

            Private Sub ReadPovertyAgeGroup(dbPov As IFsContext, PovTbl1$, PovTbl2$, PovTbl3$,
                                            PovRateArr As Dictionary(Of String, Dictionary(Of Integer, Single?)),
                                            PopArr As Dictionary(Of String, Dictionary(Of Integer, Single?)),
                                            agStart As Integer(), agEnd As Integer(), PovRateAgeMult As Single?(),
                                            Threshold$, cntx As IRebuildFacade)
                'mti 2021/10/15 - new procedure

                Dim ValTbl1 As IEnumerable(Of PovAgeSexCtry)
                Dim ValTbl2 As IEnumerable(Of PovAgeSexCtry)
                Dim ValTbl3 As IEnumerable(Of PovAgeSexCtry60EU)

                'UseAgeGroupData = True 'False      'mti 2021/10/15

                'If UseAgeGroupData Then

                If PovTbl1 <> "" Then Call TblOpen(dbPov, ValTbl1, PovTbl1)        'PovRateAgeBothSexes32LIS"
                If PovTbl2 <> "" Then Call TblOpen(dbPov, ValTbl2, PovTbl2)        'PovRateAgeBothSexes32LISInc"
                If PovTbl3 <> "" Then Call TblOpenEU(dbPov, ValTbl3, PovTbl3)        'PovRateAgeBothSexes32"

                Dim NatPovPcnt As Single?, NatPovHC As Single?
                Dim PovLineCompute As Single
                For Each key In cntx.Regionalization.Keys

                    'mti 2021/12/09 start
                    If Threshold$ = "32" Then
                        NatPovPcnt = CSng(100 * CINCOMELT32(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT32(key)
                        PovLineCompute = 3.2
                    ElseIf Threshold$ = "365" Then 'jrs 2023/04/19
                        NatPovPcnt = CSng(100 * CINCOMELT365(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT365(key)
                        PovLineCompute = 3.65
                    ElseIf Threshold$ = "420" Then 'jrs 2025/09/12
                        NatPovPcnt = CSng(100 * CINCOMELT420(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT420(key)
                        PovLineCompute = 4.2
                    ElseIf Threshold$ = "55" Then
                        NatPovPcnt = CSng(100 * CINCOMELT55(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT55(key)
                        PovLineCompute = 5.5
                    ElseIf Threshold$ = "685" Then 'jrs 2023/04/19
                        NatPovPcnt = CSng(100 * CINCOMELT685(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT685(key)
                        PovLineCompute = 6.85
                    ElseIf Threshold$ = "830" Then 'jrs 2025/09/12
                        NatPovPcnt = CSng(100 * CINCOMELT830(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT830(key)
                        PovLineCompute = 8.3
                    ElseIf Threshold$ = "NPL" Then
                        NatPovPcnt = CSng(100 * CINCOMELTNPL(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELTNPL(key)
                        PovLineCompute = CSng(Cpovnational(key))
                    End If
                    'mti 2021/12/09 end


                    If PovTbl1 <> "" Then
                        ReadPovRateAG(key, ValTbl1, PovTbl1, PovRateArr, PopArr, agStart, agEnd, PovRateAgeMult, NatPovPcnt)
                    End If

                    If PovTbl2 <> "" Then
                        If Not PovRateArr(key)(1).HasValue Then ReadPovRateAG(key, ValTbl2, PovTbl2, PovRateArr, PopArr, agStart, agEnd, PovRateAgeMult, NatPovPcnt)
                    End If

                    If PovTbl3 <> "" Then
                        If Not PovRateArr(key)(1).HasValue Then ReadPovRateAGEU(key, ValTbl3, PovTbl3, PovRateArr, PopArr, agStart, agEnd, PovRateAgeMult, NatPovPcnt, False)
                    End If

                    'mti 2021/12/09 start
                    'If CountryName(ICount) = "Bangladesh" Then Stop
                    'If CountryName(ICount) = "Rwanda" Then Stop
                    'If IsNull(PovRateArr(ICount, 1)) Then PovComputeAGPovFromAnother ICount, PopArr(), PovRateArr(), NatPovHC, CPOVRATEBOTHSEXES(), CINCOMELT19(ICount)
                    If Not PovRateArr(key)(1).HasValue Then PovComputeAGPovFromAnother(key, PopArr, PovRateArr, NatPovHC, CPOVRATEBOTHSEXES, CINCOMELT19(key), PovLineCompute)
                    'mti 2021/12/09 End

                    PovertyNormalizeAgeGroupFromPopNRate(key, PovRateArr, PopArr, NatPovHC)
                Next

                'End If



            End Sub
            Private Sub ReadPovertyAgeSex(dbPov As IFsContext, PovTbl1$, PovTbl2$, PovTbl3$,
                                          PovRateArr As Dictionary(Of String, Dictionary(Of Integer, Single?)),
                                          PopArr As Dictionary(Of String, Dictionary(Of Integer, Single?)),
                                          agStart As Integer(), agEnd As Integer(), PovRateAgeMult As Single?(),
                                          Threshold$, gndr%, cntx As IRebuildFacade)
                'mti 2021/10/15 - new procedure

                Dim ValTbl1 As IEnumerable(Of PovAgeSexCtry)
                Dim ValTbl2 As IEnumerable(Of PovAgeSexCtry)
                Dim ValTbl3 As IEnumerable(Of PovAgeSexCtry60EU)


                If PovTbl1 <> "" Then Call TblOpen(dbPov, ValTbl1, PovTbl1)        'PovRateAgeBothSexes32LIS"
                If PovTbl2 <> "" Then Call TblOpen(dbPov, ValTbl2, PovTbl2)        'PovRateAgeBothSexes32LISInc"
                If PovTbl3 <> "" Then Call TblOpenEU(dbPov, ValTbl3, PovTbl3)        'PovRateAgeBothSexes32"

                Dim NatPovPcnt As Single?, NatPovHC As Single?
                For Each key In cntx.Regionalization.Keys
                    If Threshold$ = "32" Then
                        NatPovPcnt = CSng(100 * CINCOMELT32(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT32(key)
                    ElseIf Threshold$ = "365" Then 'jrs 2023/04/19
                        NatPovPcnt = CSng(100 * CINCOMELT365(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT365(key)
                    ElseIf Threshold$ = "420" Then 'jrs 2025/09/12
                        NatPovPcnt = CSng(100 * CINCOMELT420(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT420(key)
                    ElseIf Threshold$ = "55" Then
                        NatPovPcnt = CSng(100 * CINCOMELT55(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT55(key)
                    ElseIf Threshold$ = "685" Then 'jrs 2023/04/19
                        NatPovPcnt = CSng(100 * CINCOMELT685(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT685(key)
                    ElseIf Threshold$ = "830" Then 'jrs 2025/09/12
                        NatPovPcnt = CSng(100 * CINCOMELT830(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELT830(key)
                    ElseIf Threshold$ = "NPL" Then
                        NatPovPcnt = CSng(100 * CINCOMELTNPL(key) / AMAX(0.000001, CPOP(key)))
                        NatPovHC = CINCOMELTNPL(key)
                    End If

                    '  If CountryName(key%) = "Belgium" Then Stop

                    If PovTbl1 <> "" Then
                        ReadPovRateAgeSex(key, ValTbl1, PovTbl1, PovRateArr, PopArr, agStart, agEnd, PovRateAgeMult, NatPovPcnt, gndr%)
                    End If

                    If PovTbl2 <> "" Then
                        If Not PovRateArr(key)(1).HasValue Then ReadPovRateAgeSex(key, ValTbl2, PovTbl2, PovRateArr, PopArr, agStart, agEnd, PovRateAgeMult, NatPovPcnt, gndr%)
                    End If

                    If PovTbl3 <> "" Then
                        If Not PovRateArr(key)(1).HasValue Then ReadPovRateAgeSexEU(key, ValTbl3, PovTbl3, PovRateArr, PopArr, agStart, agEnd, PovRateAgeMult, NatPovPcnt, gndr%, False)
                    End If

                    '            If IsNull(PovRateArr(key)(1)) Then PovComputeAGPovFromAnother key, PopArr(), PovRateArr(), NatPovHC, CPOVRATEBOTHSEXES(), CINCOMELT19(key)
                    '
                    '            PovertyNormalizeAgeGroupFromPopNRate key, PovRateArr(), PopArr(), NatPovHC
                Next

                'End If

                'mti 2022/01/06 start
                'For data files with no "All Ages" column, e.g., EU
                Dim AGCnt%
                For Each key In cntx.Regionalization.Keys
                    If Not PovRateArr(key)(TotPovAGCount).HasValue And PovRateArr(key)(1).HasValue Then
                        PovRateArr(key)(TotPovAGCount) = 0
                        For AGCnt% = 1 To TotPovAGCount - 1
                            PovRateArr(key)(TotPovAGCount) = PovRateArr(key)(TotPovAGCount) + PovRateArr(key)(AGCnt%) * PopArr(key)(AGCnt%)
                        Next
                        PovRateArr(key)(TotPovAGCount) = PovRateArr(key)(TotPovAGCount) / PopArr(key)(TotPovAGCount)
                    End If
                Next
                'mti 2022/01/06 start

            End Sub


