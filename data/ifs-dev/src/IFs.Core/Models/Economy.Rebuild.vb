                            '                        For AGCount = 1 To TotPovAGCount
                            '                            CPOVGNDRATIONPL(key)(AGCount) = PovRatioSex(AGCount) 'get gender ratio from poverty profile
                            '                            CPOVRATEMALENPL(key)(AGCount) = CPOVRATEBOTHSEXESNPL(key)(AGCount) * (CPopPovAGMale(key)(AGCount) + CPopPovAGFemale(key)(AGCount)) / (CPopPovAGMale(key)(AGCount) + CPOVGNDRATIONPL(key)(AGCount) * CPopPovAGFemale(key)(AGCount))
                            '                            CPOVRATEFEMALENPL(key)(AGCount) = CPOVGNDRATIONPL(key)(AGCount) * CPOVRATEMALENPL(key)(AGCount)
