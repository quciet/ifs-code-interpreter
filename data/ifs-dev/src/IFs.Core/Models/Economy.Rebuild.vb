                    'Using the exact same data series and generic values as used for $1.9

                    'mti 2021/10/15 start
                    For Each key In cntx.Regionalization.Keys
                        CPOVRATEBOTHSEXES32.Add(key, New Dictionary(Of Integer, Single?))
                        CPOVRATEMALE32.Add(key, New Dictionary(Of Integer, Single?))
                        CPOVRATEFEMALE32.Add(key, New Dictionary(Of Integer, Single?))
                        CPOVGNDRATIO32.Add(key, New Dictionary(Of Integer, Single?))
                        For AGCount = 1 To TotPovAGCount%
                            CPOVRATEBOTHSEXES32(key).Add(AGCount, Nothing)
                            CPOVRATEMALE32(key).Add(AGCount, Nothing)
                            CPOVRATEFEMALE32(key).Add(AGCount, Nothing)
                            CPOVGNDRATIO32(key).Add(AGCount, Nothing)
                        Next
                    Next

                    'jrs 2023/04/19
                    Dim sThreshold As String
                    Dim Threshold, Threshold1 As Single
                    If ConstantDollarsYear = 2011 Then
                        sThreshold = "32"
                        Threshold = 3.2
                        Threshold1 = 1.9
                    ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                        sThreshold = "365"
                        Threshold = 3.65
                        Threshold1 = 2.15
                    Else 'jrs 2025/09/12
                        sThreshold = "420"
                        Threshold = 4.2
                        Threshold1 = 3
                    End If

                    If cntx.HistoricMode Then
                        'Hist files not yet cretaed
