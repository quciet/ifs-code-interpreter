                                sActor = item.Key.Split(";".ToCharArray)(0)
                                sPartner = key0
                                If cntx.HistoricMode Then
                                    CXDYADMIGRANT(sActor)(sPartner) = getYearOrEarliestWithinRange(migTbl, YrList, item.Key, cntx.FirstYear, 20) / 5 'jrs 2021/08/03 added /5
                                Else
                                    CXDYADMIGRANT(sActor)(sPartner) = getYearOrMstRct(migTbl, YrList, item.Key, yr) / 5 'jrs 2021/08/03 added /5
                                End If
                                CMDYADMIGRANT(sPartner)(sActor) = CXDYADMIGRANT(sActor)(sPartner)
                            End If
                        Next
                    End If
