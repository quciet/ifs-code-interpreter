            Private Sub BalanceMigrationFlowsInAndOut(cntx As IRebuildFacade, ByRef AbelGrossIn As Dictionary(Of String, Single?), ByRef AbelGrossOut As Dictionary(Of String, Single?), ByVal xmDiff As Single)
                Dim XAdjAvg As Single?, XCount As Integer
                Dim MAdjAvg As Single?, MCount As Integer
                'Match emigrants first
                '---------------------
                Dim XTOT As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                XAdjAvg = 0
                XCount = 0
                For Each keyi In cntx.Regionalization.Keys
                    XTOT.Add(keyi, 0)
                    If CXDYADMIGRANT.ContainsKey(keyi) Then
                        For Each keyj In CXDYADMIGRANT(keyi).Keys
                            If CXDYADMIGRANT(keyi)(keyj).HasValue Then 'jrs 2021/08/27
                                XTOT(keyi) = XTOT(keyi) + CXDYADMIGRANT(keyi)(keyj)
                            End If
                        Next
                    End If
                Next

                For Each keyi In cntx.Regionalization.Keys
                    If XTOT(keyi) > 0 Then
                        XAdjAvg = XAdjAvg + AbelGrossOut(keyi) / XTOT(keyi)
                        XCount = XCount + 1
                    End If
                    If CXDYADMIGRANT.ContainsKey(keyi) Then
                        Dim KeyJs As List(Of String) = CXDYADMIGRANT(keyi).Keys.ToList
                        For Each keyj In KeyJs
                            'If i = 178 And j = 70 Then Stop
                            'Shift to match total X
                            If XTOT(keyi) > 0 Then
                                'jrs 2018/03/02 added limits
                                CXDYADMIGRANT(keyi)(keyj) = CXDYADMIGRANT(keyi)(keyj) * Amin(AMAX(AbelGrossOut(keyi) / XTOT(keyi), 0.9F), 1.1F)
                            End If
                        Next
                    End If
                Next
                XAdjAvg = XAdjAvg / XCount

                'Adjust immigrants second
                '--------------------
                Dim MTot As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                MAdjAvg = 0
                MCount = 0

                For Each keyi In cntx.Regionalization.Keys
                    If CXDYADMIGRANT.ContainsKey(keyi) Then
                        For Each keyj In cntx.Regionalization.Keys
                            If CXDYADMIGRANT(keyi).ContainsKey(keyj) Then
                                If Not MTot.ContainsKey(keyj) Then
                                    MTot.Add(keyj, 0)
                                End If
                                If CXDYADMIGRANT(keyi)(keyj).HasValue Then 'jrs 2021/08/27
                                    MTot(keyj) = MTot(keyj) + CXDYADMIGRANT(keyi)(keyj)
                                End If
                            End If
                        Next
                    End If
                Next

                For Each keyi In cntx.Regionalization.Keys
                    If MTot.ContainsKey(keyi) Then
                        If MTot(keyi) > 0 Then
                            MAdjAvg = MAdjAvg + AbelGrossIn(keyi) / MTot(keyi)
                            MCount = MCount + 1
                        End If
                    End If
                    If CXDYADMIGRANT.ContainsKey(keyi) Then
                        Dim KeyJs As List(Of String) = CXDYADMIGRANT(keyi).Keys.ToList
                        For Each keyj In KeyJs
                            'If i = 178 And j = 70 Then Stop
                            'Shift to match total M
                            If MTot(keyj) > 0 Then
                                'jrs 2018/03/02 added limits
                                CXDYADMIGRANT(keyi)(keyj) = CXDYADMIGRANT(keyi)(keyj) * Amin(AMAX(AbelGrossIn(keyj) / MTot(keyj), 0.9F), 1.1F)
                            End If
                        Next
                    End If
                Next
                MAdjAvg = MAdjAvg / MCount

                If (XAdjAvg > 0.999 And XAdjAvg < 1.001 And MAdjAvg > 0.999 And MAdjAvg < 1.001) Or Abs(CSng(XAdjAvg - MAdjAvg)) >= xmDiff Or xmDiff - Abs(CSng(XAdjAvg - MAdjAvg)) < 0.01 Then
                    Exit Sub
                Else
                    BalanceMigrationFlowsInAndOut(cntx, AbelGrossIn, AbelGrossOut, Abs(CSng(XAdjAvg - MAdjAvg)))
                End If

            End Sub

