            'jrs 2016/12/19
            'Procedure to fill holes in secotrial matrix
            Private Sub AdjustXSecHoles(cntx As IRebuildFacade)
                'gvdb 2024/04/05
                'unused variable
                'Dim k As Integer
                Dim iHole As Integer, XTOT As Single?
                'For each Actor
                For Each keyi In cntx.Regionalization.Keys
                    For Each keyj In cntx.Regionalization.Keys
                        If keyi <> keyj Then
                            iHole = 0
                            XTOT = 0
                            'Agriculture
                            If Not CXDYADAGR.ContainsKey(keyi) Then
                                iHole = iHole + 1
                            Else
                                If Not CXDYADAGR(keyi).ContainsKey(keyj) Then
                                    iHole = iHole + 1
                                Else
                                    XTOT = XTOT + If(CXDYADAGR(keyi)(keyj), 0)
                                End If
                            End If
                            'Energy
                            If Not CXDYADENE.ContainsKey(keyi) Then
                                iHole = iHole + 1
                            Else
                                If Not CXDYADENE(keyi).ContainsKey(keyj) Then
                                    iHole = iHole + 1
                                Else
                                    XTOT = XTOT + If(CXDYADENE(keyi)(keyj), 0)
                                End If
                            End If
                            'Manufacture
                            If Not CXDYADMAN.ContainsKey(keyi) Then
                                iHole = iHole + 1
                            Else
                                If Not CXDYADMAN(keyi).ContainsKey(keyj) Then
                                    iHole = iHole + 1
                                Else
                                    XTOT = XTOT + If(CXDYADMAN(keyi)(keyj), 0)
                                End If
                            End If
                            'Materials
                            If Not CXDYADMAT.ContainsKey(keyi) Then
                                iHole = iHole + 1
                            Else
                                If Not CXDYADMAT(keyi).ContainsKey(keyj) Then
                                    iHole = iHole + 1
                                Else
                                    XTOT = XTOT + If(CXDYADMAT(keyi)(keyj), 0)
                                End If
                            End If
                            'Services
                            If Not CXDYADSER.ContainsKey(keyi) Then
                                iHole = iHole + 1
                            Else
                                If Not CXDYADSER(keyi).ContainsKey(keyj) Then
                                    iHole = iHole + 1
                                Else
                                    XTOT = XTOT + If(CXDYADSER(keyi)(keyj), 0)
                                End If
                            End If
                            'ICT
                            If Not CXDYADICT.ContainsKey(keyi) Then
                                iHole = iHole + 1
                            Else
                                If Not CXDYADICT(keyi).ContainsKey(keyj) Then
                                    iHole = iHole + 1
                                Else
                                    XTOT = XTOT + If(CXDYADICT(keyi)(keyj), 0)
                                End If
                            End If

                            'jrs 2019/08/28
                            'Not fill holes anymore, only for total
                            iHole = 0
                            If XTOT > 0 Then
                                If Not CXDYAD.ContainsKey(keyi) Then
                                    CXDYAD.Add(keyi, New Dictionary(Of String, Single?))
                                End If
                                If Not CXDYAD(keyi).ContainsKey(keyj) Then
                                    CXDYAD(keyi).Add(keyj, 0)
                                    'Fill holes
                                    CXDYAD(keyi)(keyj) = XTOT * 6 / (6 - iHole)
                                ElseIf CXDYAD(keyi)(keyj) = 0 Then
                                    'Fill holes
                                    CXDYAD(keyi)(keyj) = XTOT * 6 / (6 - iHole)
                                End If
                            End If

                            If iHole > 0 Then
                                'General
                                If CXDYAD.ContainsKey(keyi) Then
                                    If CXDYAD(keyi).ContainsKey(keyj) Then
                                        'Agriculture
                                        If Not CXDYADAGR.ContainsKey(keyi) Then
                                            CXDYADAGR.Add(keyi, New Dictionary(Of String, Single?))
                                        End If
                                        If Not CXDYADAGR(keyi).ContainsKey(keyj) Then
                                            CXDYADAGR(keyi).Add(keyj, 0)
                                            If CXDYAD(keyi)(keyj) > XTOT Then
                                                CXDYADAGR(keyi)(keyj) = (CXDYAD(keyi)(keyj) - XTOT) / iHole
                                            Else
                                                CXDYADAGR(keyi)(keyj) = CSng(0.01 * CXDYAD(keyi)(keyj))
                                            End If
                                        End If
                                        'Energy
                                        If Not CXDYADENE.ContainsKey(keyi) Then
                                            CXDYADENE.Add(keyi, New Dictionary(Of String, Single?))
                                        End If
                                        If Not CXDYADENE(keyi).ContainsKey(keyj) Then
                                            CXDYADENE(keyi).Add(keyj, 0)
                                            If CXDYAD(keyi)(keyj) > XTOT Then
                                                CXDYADENE(keyi)(keyj) = (CXDYAD(keyi)(keyj) - XTOT) / iHole
                                            Else
                                                CXDYADENE(keyi)(keyj) = CSng(0.01 * CXDYAD(keyi)(keyj))
                                            End If
                                        End If
                                        'Materials
                                        If Not CXDYADMAT.ContainsKey(keyi) Then
                                            CXDYADMAT.Add(keyi, New Dictionary(Of String, Single?))
                                        End If
                                        If Not CXDYADMAT(keyi).ContainsKey(keyj) Then
                                            CXDYADMAT(keyi).Add(keyj, 0)
                                            If CXDYAD(keyi)(keyj) > XTOT Then
                                                CXDYADMAT(keyi)(keyj) = (CXDYAD(keyi)(keyj) - XTOT) / iHole
                                            Else
                                                CXDYADMAT(keyi)(keyj) = CSng(0.01 * CXDYAD(keyi)(keyj))
                                            End If
                                        End If
                                        'Manufacture
                                        If Not CXDYADMAN.ContainsKey(keyi) Then
                                            CXDYADMAN.Add(keyi, New Dictionary(Of String, Single?))
                                        End If
                                        If Not CXDYADMAN(keyi).ContainsKey(keyj) Then
                                            CXDYADMAN(keyi).Add(keyj, 0)
                                            If CXDYAD(keyi)(keyj) > XTOT Then
                                                CXDYADMAN(keyi)(keyj) = (CXDYAD(keyi)(keyj) - XTOT) / iHole
                                            Else
                                                CXDYADMAN(keyi)(keyj) = CSng(0.01 * CXDYAD(keyi)(keyj))
                                            End If
                                        End If
                                        'Services
                                        If Not CXDYADSER.ContainsKey(keyi) Then
                                            CXDYADSER.Add(keyi, New Dictionary(Of String, Single?))
                                        End If
                                        If Not CXDYADSER(keyi).ContainsKey(keyj) Then
                                            CXDYADSER(keyi).Add(keyj, 0)
                                            If CXDYAD(keyi)(keyj) > XTOT Then
                                                CXDYADSER(keyi)(keyj) = (CXDYAD(keyi)(keyj) - XTOT) / iHole
                                            Else
                                                CXDYADSER(keyi)(keyj) = CSng(0.01 * CXDYAD(keyi)(keyj))
                                            End If
                                        End If
                                        'ICT
                                        If Not CXDYADICT.ContainsKey(keyi) Then
                                            CXDYADICT.Add(keyi, New Dictionary(Of String, Single?))
                                        End If
                                        If Not CXDYADICT(keyi).ContainsKey(keyj) Then
                                            CXDYADICT(keyi).Add(keyj, 0)
                                            If CXDYAD(keyi)(keyj) > XTOT Then
                                                CXDYADICT(keyi)(keyj) = (CXDYAD(keyi)(keyj) - XTOT) / iHole
                                            Else
                                                CXDYADICT(keyi)(keyj) = CSng(0.01 * CXDYAD(keyi)(keyj))
                                            End If
                                        End If
                                    End If 'If CXDYAD(keyi).ContainsKey(keyj) Then
                                End If 'If CXDYAD.ContainsKey(keyi) Then
                            End If 'if IHole > 0
                        End If
                    Next keyj
                Next keyi
