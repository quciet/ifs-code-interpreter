                '            CPOPFOREIGN(key) = -GloPopForeign * CXWORKREMIT(key) / AMAX(0.001, GloWorkRemitNoForWork)
                '        End If
                '    Next key
                'Using Integrated Migrants; may re-activate someday

                '
                '   SAM: Computing Discrepancies in Domestic Accounts
                '   --------------------------------------------
                WRemitPos = 0
                WRemitNeg = 0

                Dim DebtGro As Single?, ReservesGro As Single?
                Dim PPGDEBT97 As Single?, PPGDEBT98 As Single?, PPGDEBT99 As Single?, PPGDEBT00 As Single?
                Dim Reserves97 As Single?, Reserves98 As Single?, Reserves99 As Single?, Reserves00 As Single?
                Dim NetFDIFrAbroad As Single?, NetPortfolioFrAbroad As Single?, NetFirmDebtAbroad As Single?
                Dim NetGovtDebtAbroad As Single?, lintr As Single?
                Dim IntlPositionChange, CURACTHIs, CAPACTHis As Dictionary(Of String, Single?)
                Dim CompIntlPositionChange As Single?
                Dim Interest As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                IntlPositionChange = New Dictionary(Of String, Single?)
                CURACTHIs = New Dictionary(Of String, Single?)
