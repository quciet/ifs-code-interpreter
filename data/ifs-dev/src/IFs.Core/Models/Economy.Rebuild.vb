            Private Sub AdjustXSecDyadicOrig(cntx As IRebuildFacade, iSector As Integer, xmDiff As Single, myDYAD As Dictionary(Of String, Dictionary(Of String, Single?)))
                Dim XAdjAvg As Single?, XCount As Integer
                Dim MAdjAvg As Single?, MCount As Integer

                'Adjust Exports first
                '--------------------
                Dim XTOT As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                XAdjAvg = 0
                XCount = 0
                For Each keyi In cntx.Regionalization.Keys
                    XTOT.Add(keyi, 0)
                    If myDYAD.ContainsKey(keyi) Then
                        For Each keyj In myDYAD(keyi).Keys
                            XTOT(keyi) = XTOT(keyi) + If(myDYAD(keyi)(keyj), 0)
                        Next keyj
                    End If
                    'Debug.Print(keyi + "," + XTOT(keyi).ToString)
                Next keyi

                For Each keyi In cntx.Regionalization.Keys
                    If XTOT.ContainsKey(keyi) Then
                        If XTOT(keyi) > 0 Then
                            XAdjAvg = XAdjAvg + CXS(keyi)(iSector) * 1000000000 / XTOT(keyi)
                            XCount = XCount + 1
                        End If
                    End If
                    If myDYAD.ContainsKey(keyi) Then
                        Dim KeyJs As List(Of String) = myDYAD(keyi).Keys.ToList
                        For Each keyj In KeyJs
                            'Shift to match total X
                            If XTOT(keyi) > 0 Then
                                myDYAD(keyi)(keyj) = If(myDYAD(keyi)(keyj), 0) * CXS(keyi)(iSector) * 1000000000 / XTOT(keyi)
                            End If
                        Next keyj
                    End If
                Next keyi
                XAdjAvg = XAdjAvg / XCount

                'Adjust Imports second
                '--------------------
                Dim MTOT As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                MAdjAvg = 0
                MCount = 0
                For Each keyi In cntx.Regionalization.Keys
                    If myDYAD.ContainsKey(keyi) Then
                        For Each keyj In myDYAD(keyi).Keys
                            If Not MTOT.ContainsKey(keyj) Then
                                MTOT.Add(keyj, 0)
                            End If
                            MTOT(keyj) = MTOT(keyj) + If(myDYAD(keyi)(keyj), 0)
                        Next keyj
                    End If
                Next keyi

                For Each keyi In cntx.Regionalization.Keys
                    If MTOT.ContainsKey(keyi) Then
                        If MTOT(keyi) > 0 Then
                            MAdjAvg = MAdjAvg + CMS(keyi)(iSector) * 1000000000 / MTOT(keyi)
                            MCount = MCount + 1
                        End If
                    End If
                    If myDYAD.ContainsKey(keyi) Then
                        Dim KeyJs As List(Of String) = myDYAD(keyi).Keys.ToList
                        For Each keyj In KeyJs
                            'Shift to match total M
                            If MTOT(keyj) > 0 Then
                                myDYAD(keyi)(keyj) = If(myDYAD(keyi)(keyj), 0) * CMS(keyj)(iSector) * 1000000000 / MTOT(keyj)
                            End If
                        Next keyj
                    End If
                Next keyi
                MAdjAvg = MAdjAvg / MCount

                If (XAdjAvg > 0.99 And XAdjAvg < 1.01 And MAdjAvg > 0.99 And MAdjAvg < 1.01) Or Abs(CSng(XAdjAvg - MAdjAvg)) >= xmDiff Then
                    Exit Sub
                Else
                    AdjustXSecDyadic(cntx, iSector, Abs(CSng(XAdjAvg - MAdjAvg)), myDYAD)
                End If
            End Sub
