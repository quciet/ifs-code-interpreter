                                                    GTAPSkilled(LCount%) = Tech_aspros(LCount%) + Off_mgr_pros(LCount%)
                                                    GTAPUnskilled(LCount%) = Clerks(LCount%) + Service_Shop(LCount%) + ag_othlowsk(LCount%)
                                                Next LCount%
                                                '   bbh 2015/08/17 end

                                                Dummy$ = reader2.ReadLine() 'Ignore column 1 (number and factor name)
                                                sVals2 = Dummy.Split(",".ToCharArray)
                                                'jrs 2021/09/07
                                                If bCommISDecSep Then
                                                    For LCount% = 1 To NumbSectors
                                                        GTAPCapital(LCount%) = CSng(sVals2(LCount).Replace(".", ","))
                                                    Next LCount%
                                                Else
                                                    For LCount% = 1 To NumbSectors
                                                        GTAPCapital(LCount%) = CSng(sVals2(LCount))
                                                    Next LCount%
                                                End If


                                                ReDim Tech_aspros(100)
                                                ReDim Clerks(100)
                                                ReDim Service_Shop(100)
                                                ReDim Off_mgr_pros(100)
                                                ReDim ag_othlowsk(100)

                                                Dummy$ = reader4.ReadLine() 'Ignore column 1 (number and factor name)
                                                sVals4 = Dummy.Split(",".ToCharArray)
                                                'jrs 2021/09/07
                                                If bCommISDecSep Then
                                                    For LCount% = 1 To NumbSectors
                                                        Tech_aspros(LCount%) = CSng(sVals4(LCount).Replace(".", ","))
                                                    Next LCount%
