                    Else
                        ReadPovertyAgeGroup(db, "PovRateAgeBothSexes32IncLIS", "PovRateAgeBothSexes32LIS", "", CPOVRATEBOTHSEXES32, CPopPovAGBothSexes, agStart, agEnd, PovRateAgeMult32, sThreshold, cntx) ' "PovRateAgeBothSexes32"
                        'mti 2022/01/06 start
                        'uncomment this to avoid reading LIS data
                        'ReadPovertyAgeGroup db2, "", "", "", CPOVRATEBOTHSEXES32(), CPopPovAGBothSexes(), agStart(), agEnd(), PovRateAgeMult32(), "32" ' "PovRateAgeBothSexes32"
                        'mti 2022/01/06 end
                    End If

                    If cntx.HistoricMode Then
                        'Hist files not yet cretaed
