                            vPOPPOVAG.Add(key, PopPovAGFemale(key, 9))
                        Next key
                        Return vPOPPOVAG
                    Case "POPPOVAG_Age60andOver_Female"
                        Dim vPOPPOVAG As Dictionary(Of Integer, Single?) = New Dictionary(Of Integer, Single?)
                        For key = 1 To NR
                            vPOPPOVAG.Add(key, PopPovAGFemale(key, 10))
                        Next key
                        Return vPOPPOVAG
                    Case "POPPOVAG_Total_Female"
                        Dim vPOPPOVAG As Dictionary(Of Integer, Single?) = New Dictionary(Of Integer, Single?)
                        For key = 1 To NR
                            vPOPPOVAG.Add(key, PopPovAGFemale(key, 11))
                        Next key
                        Return vPOPPOVAG
                    Case "POPFOREIGN"
                        series = CPOPFOREIGN
                        bAggSUM = True
                        bApplyLimits = True
                        MinLimit = -100000
                        MaxLimit = 100000
                    Case "POPFOREIGNIN" 'jrs 2020/03/19
                        series = CPOPFOREIGNIN
                        bAggSUM = True
                        bApplyLimits = True
                        MinLimit = 0
                        MaxLimit = 100000
                    Case "POPFOREIGNOUT"
                        series = CPOPFOREIGNOUT
                        bAggSUM = True
                        bApplyLimits = True
                        MinLimit = 0
                        MaxLimit = 100000
                    Case "MIGRANTSIN"
                        If bDyadic Then
                            Return ConvertArrayToDict(MIGRANTSIN, NR)
                        Else
                            series = CMIGRANTSIN
                            bAggSUM = True
                            bApplyLimits = True
                            MinLimit = 0
                            MaxLimit = 100000
                        End If
                    Case "MIGRANTSOUT"
                        If bDyadic Then
                            Return ConvertArrayToDict(MIGRANTSOUT, NR)
                        Else
                            series = CMIGRANTSOUT
                            bAggSUM = True
                            bApplyLimits = True
                            MinLimit = 0
                            MaxLimit = 100000
                        End If
                    Case "MIGRANTSFORCEDOUT"
                        If bDyadic Then
                            Return ConvertArrayToDict(MIGRANTSFORCEDOUT, NR)
                        Else
                            series = New Dictionary(Of String, Single?)
                            For Each key In cntx.Regionalization.Keys
                                series.Add(key, 0)
                            Next
                        End If
                    Case "MIGRANTSFORCEDRETURN"
                        If bDyadic Then
                            Return ConvertArrayToDict(MIGRANTSFORCEDRETURN, NR)
                        Else
                            series = New Dictionary(Of String, Single?)
                            For Each key In cntx.Regionalization.Keys
                                series.Add(key, 0)
                            Next
                        End If
                    Case "MIGRATEIN"
                        If bDyadic Then
                            Return ConvertArrayToDict(MIGRATEIN, NR)
                        Else
                            Return MIGRATEIN2
                        End If
                    Case "MIGRATEOUT"
                        If bDyadic Then
                            Return ConvertArrayToDict(MIGRATEOUT, NR)
                        Else
                            Return MIGRATEOUT2
                        End If
                    Case Else
                        'Throw New ArgumentException($"Aggregator cannot be applied On series {seriesName}.")
                        series = New Dictionary(Of String, Single?)
                        For Each key In cntx.Regionalization.Keys
                            series.Add(key, Nothing)
                        Next
                End Select

                If bApplyLimits Then
                    If bAggSUM Then
                        Return (From s In series
                                Join r In cntx.Regionalization On s.Key Equals r.Key
                                Group Value = s.Value By RegionId = r.Value Into Data = Group, TotalVal = Sum(Value)
                        ).ToDictionary(
                           Function(grp) grp.RegionId,
                           Function(grp) ApplyLimits(grp.TotalVal, MinLimit, MaxLimit)
                           )
                    Else
                        Return (From s In series
                                Join r In cntx.Regionalization On s.Key Equals r.Key
                                Join w In weightSeries On s.Key Equals w.Key
                                Group Value = s.Value, Weight = w.Value By RegionId = r.Value Into Data = Group, TotalWeight = Sum(Weight)
                        ).ToDictionary(
                           Function(grp) grp.RegionId,
                           Function(grp) ApplyLimits(grp.Data.Sum(Function(v) v.Value * v.Weight) / grp.TotalWeight, MinLimit, MaxLimit)
                           )
                    End If
                Else
                    If bAggSUM Then
                        Return (From s In series
                                Join r In cntx.Regionalization On s.Key Equals r.Key
                                Group Value = s.Value By RegionId = r.Value Into Data = Group, TotalVal = Sum(Value)
                        ).ToDictionary(
                           Function(grp) grp.RegionId,
                           Function(grp) grp.TotalVal
                           )
                    Else
                        Return (From s In series
                                Join r In cntx.Regionalization On s.Key Equals r.Key
                                Join w In weightSeries On s.Key Equals w.Key
                                Group Value = s.Value, Weight = w.Value By RegionId = r.Value Into Data = Group, TotalWeight = Sum(Weight)
                        ).ToDictionary(
                           Function(grp) grp.RegionId,
                           Function(grp) grp.Data.Sum(Function(v) v.Value * v.Weight) / grp.TotalWeight
                           )
                    End If
                End If
            End Function

            'bbh 2022/06/04 Entire routine; I removed remittance, aid, total trade, and current account logic and put into ReadAndProcessIntlFlowData
            'jrs 2016/04/06
            Private Sub ReadAndNormalizeTradeData(cntx As IRebuildFacade)

                Dim XAGCR As Single?, XAGMT As Single?, XAGFS As Single?, MAGCR As Single?, MAGMT As Single?, MAGFS As Single?
                Dim exmul As Single?, immul As Single?
                Dim ExportTot As Single?, ImportTot As Single?
                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    XAGCR = AGXCropValueTrade(key)
                    XAGMT = AGXMeatValueTrade(key)
                    XAGFS = AGXFishValueTrade(key)
                    MAGCR = AGMCropValueTrade(key)
                    MAGMT = AGMMeatValueTrade(key)
                    MAGFS = AGMFishValueTrade(key)

                    If Not XAGCR.HasValue Then XAGCR = 0.001 'Be sure to set these minimums at same
                    If Not XAGMT.HasValue Then XAGMT = 0.001 'Level they are set in agriculture submodel, trade
                    If Not XAGFS.HasValue Then XAGFS = 0.001
                    If Not MAGCR.HasValue Then MAGCR = 0.001
                    If Not MAGMT.HasValue Then MAGMT = 0.001
                    If Not MAGFS.HasValue Then MAGFS = 0.001
                    XAG.Add(key, XAGCR + XAGMT + XAGFS)
                    MAG.Add(key, MAGCR + MAGMT + MAGFS)
                    XEN.Add(key, CENX(key) * WorldEP) 'Convert Billion Barrels to Billion Dollars
                    'jrs 2020/03/24 If key = "Serbia" Then Stop
                    MEN.Add(key, CENM(key) * WorldEP)
                    If Not XEN(key).HasValue Then XEN(key) = CSng(0.001 * WorldEP)
                    If Not MEN(key).HasValue Then MEN(key) = CSng(0.001 * WorldEP)

                    'mti 2024/07/23 start
                    'Dim CENPVals(6) As Single?
                    Dim CENPVals(9) As Single?
                    'mti 2024/07/23 end
                    CENP.Add(key, CENPVals)

                    'For IO matrix adjustment with energy
                    CENP(key)(1) = ENPOIL(key)
                    CENP(key)(2) = ENPGAS(key)
                    CENP(key)(3) = ENPCOAL(key)
                    CENP(key)(4) = ENPHyd(key)
                    CENP(key)(5) = ENPNUC(key)

                    'mti 2024/07/23 start
                    CENP(key)(6) = ENPSOLAR(key)
                    CENP(key)(7) = ENPWIND(key)
                    CENP(key)(8) = ENPGEOTHERMAL(key)
                    CENP(key)(9) = ENPOthRen(key)
                    'mti 2024/07/23 End

                    'mti 2024/07/23 end
                    'If exports(key) - cimports(key) > 80 Then 'Must be "Room" for Other Expends
                    '    exports(key) = 80 + cimports(key)
                    'End If
                    If exports(key) - cimports(key) > 30 Then 'bbh 2024/06/26 Reduced Room for expends based on Luxembourg as global max
                        exports(key) = 30 + cimports(key)
                    End If
                    exports(key) = exports(key) / 100 * CGDP(key) 'Convert to Bil Dollars
                    cimports(key) = cimports(key) / 100 * CGDP(key)

                    '       Make sure imports and exports at least cover food and energy
                    '       ------------------------------------------------------------
                    'bbh 2022/10/27 start fixes of export and import variable usage
                    exmul = CSng(0.2 - ((0.2 - 0.02) / 0.8) * Amin(0.8, (XAG(key) + XEN(key)) / exports(key)))
                    'immul = 0.2 - ((0.2 - 0.02) / 0.8) * Amin(0.8, (MAG(KEY) + MEN(KEY)) / exports(KEY))
                    immul = CSng(0.2 - ((0.2 - 0.02) / 0.8) * Amin(0.8, (MAG(key) + MEN(key)) / cimports(key)))
                    'Debug.Print CountryName$(KEY), exmul
                    'If CountryName$(KEY) = "Timor-Leste" Then Stop
                    'imports(KEY) = AMAX(imports(KEY), 1.2 * (MAG(KEY) + MEN(KEY)))
                    'imports(KEY) = AMAX(imports(KEY), (1 + exmul) * (MAG(KEY) + MEN(KEY)))
                    cimports(key) = AMAX(cimports(key), (1 + immul) * (MAG(key) + MEN(key)))

                    'jrs 2018/12/15 check why export much higher than imports
                    'exports(KEY) = AMAX(exports(KEY), 1.2 * (XAG(KEY) + XEN(KEY)))
                    'jrs 2020/03/24 If CountryName(KEY) = "Cuba" Then Stop
                    'exports(KEY) = AMAX(exports(KEY), (1 + immul) * (XAG(KEY) + XEN(KEY)))
                    exports(key) = AMAX(exports(key), (1 + exmul) * (XAG(key) + XEN(key)))
                    'bbh 2022/10/27 end fixes of export and import variable usage

                    If exports(key) - cimports(key) > 0.5 * CGDP(key) Then
                        exports(key) = Amin(CSng(exports(key)), CSng(0.7 * CGDP(key) + cimports(key)))
                        cimports(key) = AMAX(0, CSng(exports(key) - 0.5 * CGDP(key)))

                        'Turkmenistan apparent energy exports much higher than GDP;
                        '   mismatch to resolve
                    End If

                    ExportTot = ExportTot + exports(key)
                    ImportTot = ImportTot + cimports(key)
                Next

                Dim TradeTot As Single?
                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    'If CountryName(key) = "Luxembourg" Then Stop
                    exports(key) = exports(key) * TradeTot / ExportTot
                    cimports(key) = cimports(key) * TradeTot / ImportTot
                Next

                '
                '   Read Merchandise and Service Trade and Normalize to Total Country Trade
                '   -----------------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                Dim yearNo As Short, yearNoIdx As Short, yearNoGDPIdx As Short

                Dim ServiceImRead As Single?
                'jrs 2021/10/14 changed to start using % of GDP
                Dim yrsSerImp As Short() = cntx.GetYears("SeriesImportServicesGDP").OrderBy(Function(y) y).ToArray()
                Dim ServiceImTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesImportServicesGDP", yrsSerImp)

                Dim ServiceExRead As Single?
                'jrs 2021/10/14 changed to start using % of GDP
                Dim yrsSerExp As Short() = cntx.GetYears("SeriesExportServicesGDP").OrderBy(Function(y) y).ToArray()
                Dim ServiceExTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesExportServicesGDP", yrsSerExp)

                Dim MerchImRead As Single?
                'jrs 2021/10/14 changed to start using % of GDP
                Dim yrsMerImp As Short() = cntx.GetYears("SeriesImportsMerchandiseGDP").OrderBy(Function(y) y).ToArray()
                Dim MerchImTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesImportsMerchandiseGDP", yrsMerImp)

                Dim MerchExRead As Single?
                'jrs 2021/10/14 changed to start using % of GDP
                Dim yrsMerExp As Short() = cntx.GetYears("SeriesExportsMerchandiseGDP").OrderBy(Function(y) y).ToArray()
                Dim MerchExTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesExportsMerchandiseGDP", yrsMerExp)

                'jrs 2022/11/01 flex constant dollars
                'jrs 2021/10/14
                Dim yrsGDP As Short() = cntx.GetYears("GDP" & ConstantDollarsYear.ToString).OrderBy(Function(y) y).ToArray()
                Dim GDPTbl As IDictionary(Of String, Single?()) = cntx.GetDice("GDP" & ConstantDollarsYear.ToString, yrsGDP)

                Dim yrsArmImp As Short() = cntx.GetYears("SeriesArmsImpTotImp").OrderBy(Function(y) y).ToArray()
                Dim ArmsImTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesArmsImpTotImp", yrsArmImp)

                Dim cond As Boolean, CompTotal As Single?

                For Each key In cntx.Regionalization.Keys
                    MerchEx.Add(key, Nothing)
                    XSR.Add(key, Nothing)
                    MerchIm.Add(key, Nothing)
                    MSR.Add(key, Nothing)
                    ServiceEx.Add(key, Nothing)
                    ServiceIm.Add(key, Nothing)
                    ArmsIm.Add(key, Nothing)

                    If cntx.HistoricMode Then
                        For key2% = 1 To 30
                            yearNo = CShort(1969 + key2%)
                            yearNoIdx = getYearIdx(yrsSerImp, yearNo)
                            'jrs 2021/10/14 start: adding * GDPTbl(key)(yearNoGDPIdx) / 100
                            yearNoGDPIdx = getYearIdx(yrsGDP, yearNo)
                            ServiceImRead = ServiceImTbl(key)(yearNoIdx) * GDPTbl(key)(yearNoGDPIdx) / 100
                            yearNoIdx = getYearIdx(yrsSerExp, yearNo)
                            ServiceExRead = ServiceExTbl(key)(yearNoIdx) * GDPTbl(key)(yearNoGDPIdx) / 100
                            yearNoIdx = getYearIdx(yrsMerImp, yearNo)
                            MerchImRead = MerchImTbl(key)(yearNoIdx) * GDPTbl(key)(yearNoGDPIdx) / 100
                            yearNoIdx = getYearIdx(yrsMerExp, yearNo)
                            MerchExRead = MerchExTbl(key)(yearNoIdx) * GDPTbl(key)(yearNoGDPIdx) / 100
                            'jrs 2021/10/14 end

                            cond = ServiceImRead.HasValue And ServiceExRead.HasValue _
                    And MerchImRead.HasValue And MerchExRead.HasValue

                            If cond Then
                                MerchEx(key) = MerchExRead / (ServiceExRead + MerchExRead) * exports(key)
                                XSR(key) = exports(key) - MerchEx(key)
                                MerchIm(key) = MerchImRead / (ServiceImRead + MerchImRead) * cimports(key)
                                MSR(key) = cimports(key) - MerchIm(key)

                                Exit For
                            End If

                            MerchEx(key) = CSng(0.8 * exports(key))
                            MerchIm(key) = CSng(0.8 * cimports(key))
                            ServiceEx(key) = CSng(0.2 * exports(key))
                            ServiceIm(key) = CSng(0.2 * cimports(key))
                            XSR(key) = exports(key) - MerchEx(key)
                            MSR(key) = cimports(key) - MerchIm(key)
                            ArmsIm(key) = 0

                        Next
                    Else 'forecast
                        'jrs 2021/10/14 start now reading %of GDP
                        MerchEx(key) = getYearOrMstRct(MerchExTbl, yrsMerExp, key, cntx.BaseYear) * CGDP(key) / 100 'Read in Billion $
                        MerchIm(key) = getYearOrMstRct(MerchImTbl, yrsMerImp, key, cntx.BaseYear) * CGDP(key) / 100
                        ServiceEx(key) = getYearOrMstRct(ServiceExTbl, yrsSerExp, key, cntx.BaseYear) * CGDP(key) / 100  'Read in Billion $
                        ServiceIm(key) = getYearOrMstRct(ServiceImTbl, yrsSerImp, key, cntx.BaseYear) * CGDP(key) / 100
                        'jrs 2021/10/14 end
                        'jrs 2006/12/11 ArmsIm(key) = ArmsImTbl(keyi)("MostRecent") 'Table only to 1999
                        ArmsIm(key) = getYearOrMstRct(ArmsImTbl, yrsArmImp, key, cntx.BaseYear)

                        'MerchEx(key) = MerchExTbl(keyi)("MostRecent") 'Read in Billion $
                        'MerchIm(key) = MerchImTbl(keyi)("MostRecent")
                        'ServiceEx(key) = ServiceExTbl(keyi)("MostRecent") 'Read in Billion $
                        'ServiceIm(key) = ServiceImTbl(keyi)("MostRecent")
                        If Not (MerchEx(key).HasValue) Then MerchEx(key) = CSng(0.8 * exports(key))
                        If Not (MerchIm(key).HasValue) Then MerchIm(key) = CSng(0.8 * cimports(key))
                        If Not (ServiceEx(key).HasValue) Then ServiceEx(key) = CSng(0.2 * exports(key))
                        If Not (ServiceIm(key).HasValue) Then ServiceIm(key) = CSng(0.2 * cimports(key))
                        If Not (ArmsIm(key).HasValue) Then ArmsIm(key) = 0

                        CompTotal = MerchEx(key) + ServiceEx(key)
                        'Normalize merchandise and service exports to total exports for each country
                        MerchEx(key) = exports(key) * MerchEx(key) / CompTotal
                        XSR(key) = exports(key) - MerchEx(key)

                        CompTotal = MerchIm(key) + ServiceIm(key)
                        'Normalize merchandise and service imports to total imports for each country
                        MerchIm(key) = cimports(key) * MerchIm(key) / CompTotal
                        MSR(key) = cimports(key) - MerchIm(key)
                        ArmsIm(key) = ArmsIm(key) / 100 * cimports(key)

                    End If 'if history else forecast

                    ExportTot = ExportTot + XSR(key)
                    ImportTot = ImportTot + MSR(key)

                Next

                '   Normalize service trade to assure global equality of exports and imports
                '       Recompute merchandise trade which should also therefore be globally balanced
                '   --------------------------------------------------------------------------------

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization, global services
                For Each key In cntx.Regionalization.Keys
                    XSR(key) = XSR(key) * TradeTot / ExportTot
                    MSR(key) = MSR(key) * TradeTot / ImportTot
                    MerchEx(key) = exports(key) - XSR(key) 'recompute merchandise trade
                    MerchIm(key) = cimports(key) - MSR(key)
                Next

                '
                '   Renormalize Service Trade in case Merchandise trade has been overadjusted
                '   ------------------------------------------------------------------------

                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    If MerchEx(key) >= 0.95 * exports(key) Then
                        MerchEx(key) = CSng(0.95 * exports(key))
                    End If
                    If MerchIm(key) >= 0.95 * cimports(key) Then
                        MerchIm(key) = CSng(0.95 * cimports(key))
                    End If
                    If MerchEx(key) <= 0.2 * exports(key) Then
                        MerchEx(key) = CSng(0.2 * exports(key))
                    End If
                    If MerchIm(key) <= 0.2 * cimports(key) Then
                        MerchIm(key) = CSng(0.2 * cimports(key))
                    End If
                    XSR(key) = exports(key) - MerchEx(key)
                    MSR(key) = cimports(key) - MerchIm(key)
                    ExportTot = ExportTot + XSR(key)
                    ImportTot = ImportTot + MSR(key)
                Next key

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XSR(key) = XSR(key) * TradeTot / ExportTot
                    MSR(key) = MSR(key) * TradeTot / ImportTot
                Next key

                '   Compute and Normalize ICT Trade as Portion of Total Trade
                '   --------------------------------------------------------
                ExportTot = 0
                ImportTot = 0

                If cntx.HistoricMode Then
                    For Each key In cntx.Regionalization.Keys
                        XIC.Add(key, 0.001)
                        MIC.Add(key, 0.001)
                    Next
                Else 'forecast 'clp 2024/04/25 switching to services and goods broken out ICT initalization ***GENERAL START***
                    For Each item In (From s In cntx.GetSlice("SeriesICTSerExportExpSer", cntx.BaseYear, CoalescePolicy.MostRecent)  'clp 240425 replaced with services
                                      Join s2 In cntx.GetSlice("SeriesICTSerImportImpSer", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key 'clp 240425 replaced with services
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        XIC.Add(item.Key, item.Value)
                        MIC.Add(item.Key, item.Value2)
                    Next
                End If 'if history else forecast

                'clp 2024/04/25 adding code to allow goods to enter ***START***
                'Dim goodsXIC As IDictionary(Of String, Single?)
                'Dim goodsMIC As IDictionary(Of String, Single?)
                'ReDim goodsXIC(NR%)
                'ReDim goodsMIC(NR%)

                If cntx.HistoricMode Then
                    For Each key In cntx.Regionalization.Keys
                        goodsXIC.Add(key, 0.001)
                        goodsMIC.Add(key, 0.001)
                    Next
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesICTGoodsExportExpGoods", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesICTGoodsImportImpGoods", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        goodsXIC.Add(item.Key, item.Value)
                        goodsMIC.Add(item.Key, item.Value2)
                    Next
                End If 'if history else forecast
                'clp 2024/04/25 adding code to allow goods to enter ***END***

                'gvdb 2024/04/05
                ' unused variable
                Dim XYTABL As SeriesEstimator ' , XYTABL2 As SeriesEstimator
                'jrs 2024/06/11
                Dim TbName As String = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus ICT Expend % of GDP (" & BaseYear & ") Exp"
                TbName = getFunctionNameYrOrMstRct(TbName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                'XYTABL = cntx.GetRegression("GDP/Capita (PPP 2000) Versus ICT Expend % Of GDP (2001) Exp").ToEstimator(CGDPPCP)
                XYTABL = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                For Each key In cntx.Regionalization.Keys
                    ICTShare.Add(key, XYTABL(key))
                    If Not (XIC(key).HasValue) Then XIC(key) = ICTShare(key)
                    If Not (MIC(key).HasValue) Then MIC(key) = ICTShare(key)
                    If key = "Ireland" Then XIC(key) = ICTShare(key) ' clp 2024/05/03 REVIST AFTER REBASE LATER THAN 2019
                    If key = "Ireland" Then MIC(key) = ICTShare(key) ' clp 2024/05/03 REVIST AFTER REBASE LATER THAN 2019
                    ' The above line sets Ireland to the estimated value for ICT services exports and imports. This was due to problematic behavior in GDP growth rates.
                    ' This issue seems to relate to the unqiue circumstances of Ireland in 2019.
                    ' See:https://www.thejournal.ie/microsoft-tax-study-ireland-5892089-Oct2022/
                    ' Or the archival link at: https://web.archive.org/web/20240503205152/https://www.thejournal.ie/microsoft-tax-study-ireland-5892089-Oct2022/
                    ' See also the WDI data
                    XIC(key) = XIC(key) / 100 * XSR(key) ' clp 2024/04/25 changed to reflect services
                    MIC(key) = MIC(key) / 100 * MSR(key) ' clp 2024/04/25 changed to reflect services
                    ExportTot = ExportTot + XIC(key)
                    ImportTot = ImportTot + MIC(key)
                    ' clp 2024/04/25 ***START*** Adding process for handling goods
                    If Not (goodsXIC(key).HasValue) Then goodsXIC(key) = ICTShare(key)
                    If Not (goodsMIC(key).HasValue) Then goodsMIC(key) = ICTShare(key)
                    goodsXIC(key) = goodsXIC(key) / 100 * MerchEx(key)
                    goodsMIC(key) = goodsMIC(key) / 100 * MerchIm(key)
                    ExportTot = ExportTot + goodsXIC(key)
                    ImportTot = ImportTot + goodsMIC(key)
                    ' clp 2024/04/25 ***END*** Adding process for handling goods
                Next

                TradeTot = (ExportTot + ImportTot) / 2
                For Each key In cntx.Regionalization.Keys
                    XIC(key) = XIC(key) * TradeTot / AMAX(0.001F, ExportTot)
                    MIC(key) = MIC(key) * TradeTot / AMAX(0.001F, ImportTot)
                    ' clp 2024/04/25 ***START*** Adding process for handling goods
                    goodsXIC(key) = goodsXIC(key) * TradeTot / AMAX(0.001F, ExportTot)
                    goodsMIC(key) = goodsMIC(key) * TradeTot / AMAX(0.001F, ImportTot)
                    ' clp 2024/04/25 ***END*** Adding process for handling goods
                Next key

                '   Remove Share of ICT Trade from Services and Renormalize Them
                '       Compute Merchandise Trade as a Residual
                '   ------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                'jrs 2018/09/20 to key? changed to CCount

                'clp 2024/04/25 loop here for adding goods in XIC and MIC
                'For Each key In cntx.Regionalization.Keys
                '    For Each item In (From s In cntx.GetSlice("SeriesICTGoodsExportExpGoods", cntx.BaseYear, CoalescePolicy.MostRecent)
                '                      Join s2 In cntx.GetSlice("SeriesICTGodsImportImpGoods", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                '                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value) 'clp 240425 replaced with services
                '        'XIC.Add(item.Key, item.Value)
                '        'MIC.Add(item.Key, item.Value2)
                '        ExportTot = ExportTot + XIC(key)
                '        ImportTot = ImportTot + MIC(key)
                '    Next
                'Next


                For Each key In cntx.Regionalization.Keys
                    XSR(key) = AMAX(CSng(0.05 * XSR(key)), CSng(XSR(key) - XIC(key))) 'clp 2024/04/25 remove half prev used to account for mixed (Goods and Services) data
                    MSR(key) = AMAX(CSng(0.05 * MSR(key)), CSng(MSR(key) - MIC(key))) 'clp 2024/04/25 remove half prev used to account for mixed (Goods and Services) data
                    ExportTot = ExportTot + XSR(key)
                    ImportTot = ImportTot + MSR(key)
                    XIC(key) = XIC(key) + goodsXIC(key) 'clp 2024/04/25 Add goods back in
                    MIC(key) = MIC(key) + goodsMIC(key) 'clp 2024/04/25 Add goods back in
                Next key



                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                'jrs 2018/09/20 to key? changed to CCount
                Dim msg As String
                For Each key In cntx.Regionalization.Keys
                    XSR(key) = XSR(key) * TradeTot / ExportTot
                    MSR(key) = MSR(key) * TradeTot / ImportTot
                    MerchEx(key) = exports(key) - XSR(key) - XIC(key)
                    MerchIm(key) = cimports(key) - MSR(key) - MIC(key)
                    'If key = "Sao Tome And Principe" Then Stop

                    If MerchEx(key) < 0 Or MerchIm(key) < 0 Then
                        msg$ = "Fatal Error:  Service Trade Normalization for " + key
                        msg$ = msg$ + " has forced merchandise trade negative"
                        Debug.Print(msg$)
                        Stop
                    End If
                    RemEx.Add(key, MerchEx(key))
                    RemIm.Add(key, MerchIm(key))
                Next key
                'clp 2024/04/25 switching to services and goods broken out ICT initalization ***GENERAL END***

                '   Compute Agricultural Trade, Check for Size VS Merch Trade, Normalize
                '   --------------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    XAGCR = AGXCropValueTrade(key)
                    XAGMT = AGXMeatValueTrade(key)
                    XAGFS = AGXFishValueTrade(key)
                    MAGCR = AGMCropValueTrade(key)
                    MAGMT = AGMMeatValueTrade(key)
                    MAGFS = AGMFishValueTrade(key)
                    If Not (XAGCR.HasValue) Then XAGCR = 0.01 'Be sure to set these minimums at same
                    If Not (XAGMT.HasValue) Then XAGMT = 0.01 'Level they are set in agriculture submodel
                    If Not (XAGFS.HasValue) Then XAGFS = 0.01
                    If Not (MAGCR.HasValue) Then MAGCR = 0.01
                    If Not (MAGMT.HasValue) Then MAGMT = 0.01
                    If Not (MAGFS.HasValue) Then MAGFS = 0.01
                    XAG(key) = XAGCR + XAGMT + XAGFS
                    MAG(key) = MAGCR + MAGMT + MAGFS
                    'sgh 2015/05/29 - END
                    'jrs 2020/03/24 If key = "Cuba" Then Stop
                    If XAG(key) >= 0.9 * RemEx(key) Then XAG(key) = CSng(0.9 * RemEx(key))
                    If MAG(key) >= 0.9 * RemIm(key) Then MAG(key) = CSng(0.9 * RemIm(key))
                    ExportTot = ExportTot + XAG(key)
                    ImportTot = ImportTot + MAG(key)

                Next

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XAG(key) = XAG(key) * TradeTot / ExportTot
                    MAG(key) = MAG(key) * TradeTot / ImportTot
                Next key

                '   Renormalize Agricultural Trade in case it exceeds Merchandise Trade
                '   -------------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys

                    If XAG(key) >= 0.9 * RemEx(key) Then XAG(key) = CSng(0.9 * RemEx(key))
                    If MAG(key) >= 0.9 * RemIm(key) Then MAG(key) = CSng(0.9 * RemIm(key))
                    ExportTot = ExportTot + XAG(key)
                    ImportTot = ImportTot + MAG(key)

                Next key

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XAG(key) = XAG(key) * TradeTot / ExportTot
                    MAG(key) = MAG(key) * TradeTot / ImportTot
                    RemEx(key) = RemEx(key) - XAG(key)
                    RemIm(key) = RemIm(key) - MAG(key)
                    'If key = "Afghanistan" Then Stop

                    If RemEx(key) < 0 Or RemIm(key) < 0 Then
                        msg$ = "Fatal Error:  Agriculture Normalization for " + key
                        msg$ = msg$ + " has forced trade above merchandise limits"
                        Debug.Print(msg$)
                        Stop
                    End If
                Next key

                '   IMPORTANT NOTE:  Because of this normalization at the trade level, physical trade times
                '   price will not be exactly equal to financial trade.

                'jrs 2015/11/16 *** begin ***
                RecomputeAgriOutput(cntx)
                'jrs 2015/11/16 *** end ***

                '   Compute Energy Trade, Check for Size VS Merch Trade, Normalize
                '   --------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0

                For Each key In cntx.Regionalization.Keys
                    XEN(key) = CENX(key) * WorldEP  'Convert Billion Barrels to Billion Dollars
                    MEN(key) = CENM(key) * WorldEP
                    If Not (XEN(key).HasValue) Then XEN(key) = CSng(0.001 * WorldEP)
                    If Not (MEN(key).HasValue) Then MEN(key) = CSng(0.001 * WorldEP)
                    If XEN(key) >= 0.9 * RemEx(key) Then XEN(key) = CSng(0.9 * RemEx(key))
                    If MEN(key) >= 0.9 * RemIm(key) Then MEN(key) = CSng(0.9 * RemIm(key))
                    'If key = "Afghanistan" Then Stop

                    ExportTot = ExportTot + XEN(key)
                    ImportTot = ImportTot + MEN(key)
                Next

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization

                For Each key In cntx.Regionalization.Keys
                    XEN(key) = XEN(key) * TradeTot / ExportTot
                    MEN(key) = MEN(key) * TradeTot / ImportTot
                Next

                '   Renormalization in case any energy trade forced above merchandise limits
                '   ------------------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    If XEN(key) >= 0.9 * RemEx(key) Then XEN(key) = CSng(0.9 * RemEx(key))
                    If MEN(key) >= 0.9 * RemIm(key) Then MEN(key) = CSng(0.9 * RemIm(key))
                    ExportTot = ExportTot + XEN(key)
                    ImportTot = ImportTot + MEN(key)
                Next

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XEN(key) = XEN(key) * TradeTot / ExportTot
                    MEN(key) = MEN(key) * TradeTot / ImportTot
                Next

                '   Second Renormalization in case any energy trade forced above merchandise limits
                '   -------------------------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    If XEN(key) >= 0.9 * RemEx(key) Then XEN(key) = CSng(0.9 * RemEx(key))
                    If MEN(key) >= 0.9 * RemIm(key) Then MEN(key) = CSng(0.9 * RemIm(key))
                    ExportTot = ExportTot + XEN(key)
                    ImportTot = ImportTot + MEN(key)
                Next

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XEN(key) = XEN(key) * TradeTot / ExportTot
                    MEN(key) = MEN(key) * TradeTot / ImportTot
                    'If key = "Afghanistan" Then Stop

                    RemEx(key) = RemEx(key) - XEN(key)
                    RemIm(key) = RemIm(key) - MEN(key)
                    If RemEx(key) < 0 Or RemIm(key) < 0 Then
                        msg$ = "Fatal Error:  Energy Normalization for " + key
                        msg$ = msg$ + " has forced trade above merchandise limits"
                        Debug.Print(msg$)
                        Stop
                    End If

                    '   IMPORTANT NOTE:  Because of this normalization at the trade level, physical trade times
                    '   price will not be exactly equal to financial trade.  Could compute backwards to
                    '   physical trade and put that into EnergyOut.  Would then also need to redetermine energy
                    '   base which uses EnergyOut to compute regional data.

                Next

                '   Compute Materials Trade, Check for Size VS Merch Trade, Normalize
                '   -----------------------------------------------------------------
                If cntx.HistoricMode Then
                    For Each item In (From s In cntx.GetSlice("SeriesOresMetsExMerchEx", "Earliest")
                                      Join s2 In cntx.GetSlice("SeriesOresMetsImMerchIm", "Earliest") On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        XMA.Add(item.Key, item.Value)
                        MMA.Add(item.Key, item.Value2)
                    Next
                Else 'forecast
                    For Each item In (From s In cntx.GetSlice("SeriesOresMetsExMerchEx", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesOresMetsImMerchIm", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        XMA.Add(item.Key, item.Value)
                        MMA.Add(item.Key, item.Value2)
                    Next
                End If 'if history else forecast

                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    If Not (XMA(key).HasValue) Then XMA(key) = 0
                    XMA(key) = MerchEx(key) * XMA(key) / 100
                    If Not (MMA(key).HasValue) Then MMA(key) = 0.5 'was 1 - minimal imports
                    MMA(key) = MerchIm(key) * MMA(key) / 100

                    If XMA(key) >= 0.9 * RemEx(key) Then XMA(key) = CSng(0.9 * RemEx(key))
                    If MMA(key) >= 0.9 * RemIm(key) Then MMA(key) = CSng(0.9 * RemIm(key))
                    'bbh 2019/05/22 Start; Bound imports at 5% of GDP; Macedonia only country above that at 8.7% and imports
                    ' so much that totally disrupts sectoral equilibrium relative to demand
                    If MMA(key) / CGDP(key) > 0.05 Then
                        MMA(key) = CSng(CGDP(key) * 0.05)
                    End If
                    If XMA(key) <= 0.01 * RemEx(key) Then XMA(key) = CSng(0.01 * RemEx(key))
                    If MMA(key) <= 0.01 * RemIm(key) Then MMA(key) = CSng(0.01 * RemIm(key))
                    ExportTot = ExportTot + XMA(key)
                    ImportTot = ImportTot + MMA(key)
                Next

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XMA(key) = XMA(key) * TradeTot / ExportTot
                    MMA(key) = MMA(key) * TradeTot / ImportTot
                Next

                '   Renormalize Materials Trade in case it exceeds Merchandise Trade or is less than zero
                '   -------------------------------------------------------------------------------------
                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    If XMA(key) >= 0.9 * RemEx(key) Then XMA(key) = CSng(0.9 * RemEx(key))
                    If MMA(key) >= 0.9 * RemIm(key) Then MMA(key) = CSng(0.9 * RemIm(key))
                    If XMA(key) <= 0.01 * RemEx(key) Then XMA(key) = CSng(0.01 * RemEx(key))
                    If MMA(key) <= 0.01 * RemIm(key) Then MMA(key) = CSng(0.01 * RemIm(key))
                    ExportTot = ExportTot + XMA(key)
                    ImportTot = ImportTot + MMA(key)
                Next

                TradeTot = (ExportTot + ImportTot) / 2   'Actual Normalization
                For Each key In cntx.Regionalization.Keys
                    XMA(key) = XMA(key) * TradeTot / ExportTot
                    MMA(key) = MMA(key) * TradeTot / ImportTot
                    RemEx(key) = RemEx(key) - XMA(key)
                    RemIm(key) = RemIm(key) - MMA(key)
                    If RemEx(key) < 0 Or RemIm(key) < 0 Then
                        msg$ = "Fatal Error:  Materials Trade Normalization for " + key
                        msg$ = msg$ + " has forced trade above remaining trade limits"
                        Debug.Print(msg$)
                        Stop
                    End If
                Next

                '   Computation of Trade in Manufactures as Residual -
                '       Check to see that global exports = imports
                '   --------------------------------------------------

                ExportTot = 0
                ImportTot = 0
                For Each key In cntx.Regionalization.Keys
                    XMN.Add(key, RemEx(key))
                    MMN.Add(key, RemIm(key))
                    ExportTot = ExportTot + XMN(key)
                    ImportTot = ImportTot + MMN(key)
                Next

                If ExportTot > ImportTot * 1.02 Or ExportTot < ImportTot * 0.98 Then
                    msg$ = "Fatal Error:  Residuals calculated for manufactures imports and exports do "
                    msg$ = msg$ + "not sum to the same value globally"
                    Debug.Print(msg$)
                    Stop
                End If

            End Sub

            'bbh 2022/06/04 Entire routine; built from old top section of ReadAndNormalizeTradeData
            Private Sub ReadAndProcessIntlFlowData(cntx As IRebuildFacade)

                'bbh 2022/12/20 Begin rework of remittance handling to provide estimates for UAE and others with POPFOREIGNIN but no data on WORKREMITOUT - Suggest taking entire block
                '   Read and Globally Balance Remittance Data
                '   -----------------------------------------
                'bbh 2022/04/22 balance by moving high income countries up in payments; those are much smaller in GDP than LDC receipts (June 2022)
                Dim RemitInTot, RemitOutTot, RemitOutTotHighInc As Single?
                Dim iBaseYear As Integer

                'Basic read of remitance and foreign population data
                RemitInTot = 0
                RemitOutTot = 0
                RemitOutTotHighInc = 0

                Dim ValHold1 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim ValHold2 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "SeriesXWorkerRemitReceivedGDP"
                    Dim SeriesTable2 As String = "SeriesXWorkerRemitPaidGDP"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim yrs2 As Short() = cntx.GetYears(SeriesTable2).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    Dim DictTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable2, yrs2)
                    For Each key In cntx.Regionalization.Keys
                        ValHold1.Add(key, getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist) * CGDP(key) / 100) 'jrs 2020/08/13 20 instead of HistDist
                        ValHold2.Add(key, getClosestYrVal(DictTbl2, yrs2, key, cntx.FirstYear, HistDist) * CGDP(key) / 100) 'jrs 2020/08/13 20 instead of HistDist
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesXWorkerRemitReceivedGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesXWorkerRemitPaidGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        ValHold1.Add(item.Key, item.Value * CGDP(item.Key) / 100)
                        ValHold2.Add(item.Key, item.Value2 * CGDP(item.Key) / 100)
                    Next
                End If

                For Each key In cntx.Regionalization.Keys
                    If Not (ValHold2(key).HasValue) Then ValHold2(key) = 0
                    '        CPOPFOREIGN(key) = ValHold2 / 100 * CPop(key)
                    'Using integrated migrants - may reactivate someday
                    If Not (ValHold1(key).HasValue) Then ValHold1(key) = 0
                    CXWORKREMITIN.Add(key, AMAX(ValHold1(key), 0)) 'bbh 2020/03/09
                    CXWORKREMITOUT.Add(key, AMAX(ValHold2(key), 0)) 'bbh 2020/03/09

                    RemitInTot = RemitInTot + CXWORKREMITIN(key) 'bbh 2020/03/09
                    RemitOutTot = RemitOutTot + CXWORKREMITOUT(key) 'bbh 2020/03/09
                    If CGDPPC(key) > 13 Then
                        RemitOutTotHighInc = RemitOutTotHighInc + CXWORKREMITOUT(key)
                    End If
                Next

                'Compute global average remittance flow per worker 'With switch to functions to fill holes, no need for this variable anymore
                'gvdb 2024/04/05
                ' unused variable
                'Dim GloSumWorkIn As Single, GloSumRemitIn As Single, GloSumGDP As Single, GloAvgRemitPerWorker As Single
                'Dim GloSumPop As Single, GloGDPPC As Single, GloSumRemitOut As Single, GloSumRemit As Single
                Dim RemitSentPerWorker As Single?, RemitReceivedPerWorker As Single?

                '    Set poptbl = db.OpenRecordset("PopOutput")
                '    poptbl.Index = "Country"
                '    poptbl.MoveFirst
                '    GloSumGDP = 0
                '    GloSumPop = 0
                '    GloSumWorkIn = 0
                '    GloSumRemitIn = 0
                '    For ICount% = 1 To CCount
                '        GloSumGDP = GloSumGDP + CGDP(ICount%)
                '        GloSumPop = GloSumPop + CPop(ICount%)
                '        GloSumWorkIn = GloSumWorkIn + poptbl.Fields("POPFOREIGNIN")
                '        GloSumRemitIn = GloSumRemitIn + CXWORKREMITIN(ICount%)
                '        poptbl.MoveFirst
                '    Next ICount%
                '    poptbl.Close
                '    GloGDPPC = GloSumGDP / GloSumPop
                'GloAvgRemitPerWorker = (GloSumRemitIn / GloSumWorkIn) / GloGDPPC 'With switch to functions to fill holes, no need for this variable anymore

                'Use functions on average remittance per worker to fill in remittance data for countries with foreign pop and no remittance data
                RemitInTot = 0
                RemitOutTot = 0
                Dim XYTABLOUT = cntx.GetRegression("GDP/Capita Versus Remittances Sent Out per Foreign Worker (2017)").ToEstimator(CGDPPC)
                Dim XYTABLIN = cntx.GetRegression("GDP/Capita Versus Remittances Received per Worker Abroad (2017)").ToEstimator(CGDPPC)
                For Each key In cntx.Regionalization.Keys
                    'bbh 2023/02/13 added 2 zeros to < comparison in line below and in the following if-then block
                    If CPOPFOREIGNIN(key) > 0 And CXWORKREMITOUT(key) < 0.000001 Then 'RemitPerWorker is ratio of remittance per worker relative to GDPPC
                        RemitSentPerWorker = XYTABLOUT(key)
                        CXWORKREMITOUT(key) = CPOPFOREIGNIN(key) * RemitSentPerWorker
                    End If
                    If CPOPFOREIGNOUT(key) > 0 And CXWORKREMITIN(key) < 0.000001 Then 'RemitPerWorkerIn(R%) is ratio of remittance per worker relative to GDPPC
                        RemitReceivedPerWorker = XYTABLIN(key)
                        CXWORKREMITIN(key) = CPOPFOREIGNOUT(key) * RemitReceivedPerWorker
                    End If
                    RemitInTot = RemitInTot + CXWORKREMITIN(key)
                    RemitOutTot = RemitOutTot + CXWORKREMITOUT(key)
                    'If CountryName(ICount%) = "United Arab Emirates" Then Stop
                Next

                'Balance global remittance inflows and outflows with allocation of additional remittance outflows to high-incomecountries
                For Each key In cntx.Regionalization.Keys
                    If CGDPPC(key) > 13 Then
                        RemitOutTotHighInc = RemitOutTotHighInc + CXWORKREMITOUT(key)
                    End If
                Next

                Dim RemitInSurplus = RemitInTot - RemitOutTot
                RemitNormPaid = (RemitOutTotHighInc + RemitInSurplus) / RemitOutTotHighInc
                RemitNormReceived = 1

                For Each key In cntx.Regionalization.Keys
                    'bbh 2022/04/22 start: rebalance payments only for high-income countries
                    CXWORKREMITIN(key) = CXWORKREMITIN(key) * RemitNormReceived
                    If CGDPPC(key) > 13 Then
                        CXWORKREMITOUT(key) = CXWORKREMITOUT(key) * RemitNormPaid
                    End If
                    CXWORKREMIT.Add(key, (CXWORKREMITIN(key) - CXWORKREMITOUT(key)))
                Next
                'bbh 2022/04/22 end balancing remittances
                'bbh 2022/12/20 end rework of remittance handling to provide estimates for UAE and others with POPFOREIGNIN but no data on WORKREMITOUT



                '   Read Foreign Aid Data and Balance Global Flows
                '   ---------------------------------------------
                'bbh 2022/06/04 Balance by changing high income countries donations; much smaller share of GDP than in low-income
                Dim GloAidRec, GloAidDon, AidDonTotHighInc, AidNormDon, AidNormReceived As Single?

                GloAidDon = 0
                GloAidRec = 0
                Dim AidDonTotHighIn = 0
                AidDonTotHighInc = 0

                'Below is preliminary aid and work remit reads for current account;
                'final and balancing is much later
                Dim TotYears As Integer, TotAid As Single?
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim ValH As Single?
                    Dim SeriesTable As String = "SeriesAIDRecGNIOECD"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValH = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValH.HasValue Then ValH = 0  'No Data Check
                        CAIDREC.Add(key, Amin(ValH, 50))
                    Next
                    'mti 2019/04/29  Flex Hist Base End	
                Else
                    Dim yrsAID As Short() = cntx.GetYears("SeriesAIDRecGNIOECD").OrderBy(Function(y) y).ToArray()
                    Dim AidRecTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesAIDRecGNIOECD", yrsAID)
                    Dim YearNow As Short, YearNowIdx As Short, AidVal As Single?
                    'jrs 2006/12/27 const to vars
                    'if 3 years after base are not available, use the last 4 available
                    If cntx.BaseYear > yrsAID(yrsAID.Count - 4) Then
                        iBaseYear = yrsAID(yrsAID.Count - 4)
                    Else
                        iBaseYear = cntx.BaseYear
                    End If

                    For Each key In cntx.Regionalization.Keys
                        TotYears = 0
                        TotAid = 0

                        'jrs 2026/05/07 increased the number of years to consider, from 4 to 10
                        For YCount% = 1 To 10 'Average data years since 2000
                            'jrs 2006/11/29 const to vars YearNow = 2000 + YCount% - 1
                            YearNow = CShort(iBaseYear + YCount% - 1)
                            YearNowIdx = getYearIdx(yrsAID, YearNow)
                            'jrs 2023/07/12
                            If YearNowIdx >= 0 Then
                                AidVal = AidRecTbl(key)(YearNowIdx)
                                If AidVal.HasValue Then
                                    TotYears = TotYears + 1
                                    TotAid = TotAid + AidVal
                                End If
                            End If
                        Next YCount%
                        If TotYears >= 1 Then
                            CAIDREC.Add(key, TotAid / TotYears)
                        Else
                            CAIDREC.Add(key, 0)
                        End If
                        CAIDREC(key) = Amin(CAIDREC(key), 50)
                        'Higher would be extraordinary, temporary and creating Dutch Disease quickly in model
                        'CAIDREC(key) = AidRecTbl.Fields("MostRecent")

                        'bbh 2022/06/04 Currently Data series is net of aid loan payments so can go negative, e.g. Belarus
                        '    If get data series on loan repayments made recode to handle
                    Next
                End If


                '
                '   Move to reading and balancing foreign aid flows
                '   Donations will be used to allocate IFI stocks back
                '   to donors
                '   --------------------------------------------------
                GloAidDon = 0
                GloAidRec = 0

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim SeriesTable As String = "aiddon"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        CAIDDON.Add(key, getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist))
                    Next
                    'Earliest is problematic; have 1995 only
                    'mti 2019/04/29  Flex Hist Base End	
                Else
                    'jrs 2026/05/07 using 10 year average now
                    For y = cntx.BaseYear To cntx.BaseYear - 9 Step -1
                        For Each item In (From s In cntx.GetSlice("aiddon", y.ToString)
                                          Select Key = s.Key, Value = s.Value)
                            If item.Value.HasValue Then
                                If Not CAIDDON.ContainsKey(item.Key) Then
                                    CAIDDON.Add(item.Key, item.Value)
                                    CAIDDONCount.Add(item.Key, 1)
                                Else
                                    CAIDDON(item.Key) = CAIDDON(item.Key) + item.Value
                                    CAIDDONCount(item.Key) = CAIDDONCount(item.Key) + 1
                                End If
                            ElseIf y = cntx.BaseYear - 9 AndAlso Not CAIDDON.ContainsKey(item.Key) Then
                                CAIDDON.Add(item.Key, Nothing)
                            End If
                        Next
                    Next
                    For Each key In CAIDDONCount.Keys
                        CAIDDON(key) = CAIDDON(key) / CAIDDONCount(key)
                    Next
                    'For Each item In (From s In cntx.GetSlice("aiddon", cntx.BaseYear, CoalescePolicy.MostRecent)
                    '                  Select Key = s.Key, Value = s.Value)
                    '    CAIDDON.Add(item.Key, item.Value)
                    'Next
                End If

                For Each key In cntx.Regionalization.Keys
                    If Not (CAIDDON(key).HasValue) Then CAIDDON(key) = 0
                    If CAIDREC(key) < 0 Then 'bbh 2022/06/04 Address issue for China, Malaysia, Thailand of negative receipts, move to net donors
                        CAIDDON(key) = CAIDDON(key) - CAIDREC(key) 'Both still in % terms
                        CAIDREC(key) = 0
                    End If
                    'jrs 2022/06/06
                    CAIDDON(key) = AMAX(CAIDDON(key), 0)
                    CAIDDON(key) = CAIDDON(key) * CGDP(key) / 100
                    CAIDREC(key) = CAIDREC(key) * CGDP(key) / 100
                    GloAidDon = GloAidDon + CAIDDON(key)
                    GloAidRec = GloAidRec + CAIDREC(key)
                    If CGDPPC(key) > 13 Then
                        AidDonTotHighInc = AidDonTotHighInc + CAIDDON(key)
                    End If
                Next

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    'bbh 2020/08/18 Dim SeriesTable As String = "SeriesAidRecGrantTotal"
                    Dim SeriesTable As String = "SeriesAidRecGrantTotRev"
                    Dim yrs As Short() = cntx.GetYears(SeriesTable).OrderBy(Function(y) y).ToArray()
                    Dim DictTbl As IDictionary(Of String, Single?()) = cntx.GetDice(SeriesTable, yrs)
                    For Each key In cntx.Regionalization.Keys
                        Dim ValHold = getClosestYrVal(DictTbl, yrs, key, cntx.FirstYear, HistDist)
                        CAIDSHARE.Add(key, ValHold)
                    Next
                    'mti 2019/04/29  Flex Hist Base End	
                Else
                    'bbh 2020/08/18 For Each item In (From s In cntx.GetSlice("SeriesAidRecGrantTotal", cntx.BaseYear, CoalescePolicy.MostRecent)
                    For Each item In (From s In cntx.GetSlice("SeriesAidRecGrantTotRev", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        CAIDSHARE.Add(item.Key, item.Value)
                    Next
                End If

                For Each key In cntx.Regionalization.Keys
                    If Not (CAIDSHARE(key).HasValue) Then CAIDSHARE(key) = 100  'No Data Check
                    CAIDSHARE(key) = (100 - CAIDSHARE(key)) / 100
                    'Make loan share for now; should be aid share when rework book
                Next

                '   Normalize Aid Receipts and Donations so Global Sums Match
                '   ---------------------------------------------------------
                Dim GloAidSurplus = GloAidRec - GloAidDon  'As of June 2022 data show global deficit of remittance sendings and surplus of aid donations
                AidNormDon = (AidDonTotHighInc + GloAidSurplus) / AidDonTotHighInc
                AidNormReceived = 1
                For Each key In cntx.Regionalization.Keys
                    CAIDREC(key) = CAIDREC(key) * AidNormReceived
                    If CGDPPC(key) > 13 Then 'bbh 2022/04/22 rebalance payments upward only for high-income countries
                        CAIDDON(key) = CAIDDON(key) * AidNormDon
                    End If
                Next key

                '   Read and Normalize Total Trade Data
                '   -----------------------------------
                Dim ExportTot As Single?, ImportTot As Single?

                ExportTot = 0
                ImportTot = 0

                Dim XYTABL As SeriesEstimator, XYTABL2 As SeriesEstimator

                Dim TotYearsX As Dictionary(Of String, Integer), TotExports As Single?
                Dim TotYearsM As Dictionary(Of String, Integer), TotImports As Single?
                TotYearsX = New Dictionary(Of String, Integer)
                TotYearsM = New Dictionary(Of String, Integer)

                If cntx.HistoricMode Then
                    XYTABL = cntx.GetRegression("GDP/Capita (PPP) Versus Exports (1960)").ToEstimator(CGDPPCP)
                    XYTABL2 = cntx.GetRegression("GDP/Capita (PPP) Versus Imports (1960)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("ExportGoodSer", "Earliest")
                                      Join s2 In cntx.GetSlice("ImportGoodSer", "Earliest") On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        exports.Add(item.Key, item.Value)
                        cimports.Add(item.Key, item.Value2)
                        If Not exports(item.Key).HasValue Or exports(item.Key) < 1 Then
                            exports(item.Key) = XYTABL(item.Key)
                        End If
                        If Not cimports(item.Key).HasValue Or cimports(item.Key) < 1 Then
                            cimports(item.Key) = XYTABL2(item.Key)
                        End If
                        CCURACTDATATOP.Add(item.Key, 0) 'bbh 2022/04/22
                    Next
                Else
                    Dim yrsExp As Short() = cntx.GetYears("ExportGoodSer").OrderBy(Function(y) y).ToArray()
                    Dim ExportsTbl As IDictionary(Of String, Single?()) = cntx.GetDice("ExportGoodSer", yrsExp)

                    Dim yrsImp As Short() = cntx.GetYears("ImportGoodSer").OrderBy(Function(y) y).ToArray()
                    Dim importstbl As IDictionary(Of String, Single?()) = cntx.GetDice("ImportGoodSer", yrsImp)

                    'if 2 years after base are not available, use the last 3 available
                    Dim iBaseYear2 As Integer
                    If cntx.BaseYear > yrsExp(yrsExp.Count - 3) Then
                        iBaseYear = yrsExp(yrsExp.Count - 3)
                    Else
                        iBaseYear = cntx.BaseYear
                    End If

                    If cntx.BaseYear > yrsImp(yrsImp.Count - 4) Then
                        iBaseYear2 = yrsImp(yrsImp.Count - 4)
                    Else
                        iBaseYear2 = cntx.BaseYear
                    End If

                    Dim YearNow As Short, YearNowIdx As Integer
                    Dim ExportsVal As Single?, ImportsVal As Single?

                    'jrs 2024/06/12
                    Dim TblName As String = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Exports (" & BaseYear & ")"
                    TblName = getFunctionNameYrOrMstRct(TblName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'XYTABL = cntx.GetRegression("GDP/Capita (PPP) Versus Exports (1995)").ToEstimator(CGDPPCP)
                    XYTABL = cntx.GetRegression(TblName).ToEstimator(CGDPPCP)
                    'jrs 2024/06/10
                    TblName = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Imports (" & BaseYear & ")"
                    TblName = getFunctionNameYrOrMstRct(TblName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'jrs 2024/06/10 XYTABL2 = cntx.GetRegression("GDP/Capita (PPP) Versus Imports (1995)").ToEstimator(CGDPPCP)
                    XYTABL2 = cntx.GetRegression(TblName).ToEstimator(CGDPPCP)

                    For Each key In cntx.Regionalization.Keys
                        TotYearsX.Add(key, 0)
                        TotExports = 0

                        For YCount% = 1 To 3 'Average data years 2000-2002
                            'jrs 2006/11/29 const to vars YearNow = 2000 + YCount% - 1
                            YearNow = CShort(iBaseYear + YCount% - 1)
                            YearNowIdx = getYearIdx(yrsExp, YearNow)
                            ExportsVal = ExportsTbl(key)(YearNowIdx)
                            If ExportsVal.HasValue Then
                                TotYearsX(key) = TotYearsX(key) + 1
                                TotExports = TotExports + ExportsVal
                            End If
                        Next YCount%


                        TotYearsM.Add(key, 0)
                        TotImports = 0

                        For YCount% = 1 To 4 'Average data years 2000-2009
                            'jrs 2006/11/29 const to vars YearNow = 2000 + YCount% - 1
                            YearNow = CShort(iBaseYear2 + YCount% - 1)
                            YearNowIdx = getYearIdx(yrsExp, YearNow)
                            ImportsVal = importstbl(key)(YearNowIdx)
                            If ImportsVal.HasValue Then
                                TotYearsM(key) = TotYearsM(key) + 1
                                TotImports = TotImports + ImportsVal
                            End If
                        Next YCount%

                        If TotYearsX(key) >= 1 Then
                            exports.Add(key, TotExports / TotYearsX(key))
                        Else
                            exports.Add(key, XYTABL(key))
                        End If
                        If TotYearsM(key) >= 1 Then
                            cimports.Add(key, TotImports / TotYearsM(key))
                        Else
                            cimports.Add(key, XYTABL2(key))
                        End If
                    Next

                End If

                '   Read Current Account Data
                '   -------------------------
                If cntx.HistoricMode Then
                    For Each key In cntx.Regionalization.Keys
                        CCurAct.Add(key, 0)
                        CCURACTDATATOP(key) = CCurAct(key) 'bbh 2022/04/22
                    Next
                Else
                    For Each item In (From s In cntx.GetSlice("XCurActBalGDP", cntx.BaseYear, CoalescePolicy.MostRecent) Select Key = s.Key, Value = s.Value)
                        CCurAct.Add(item.Key, item.Value)
                        CCURACTDATATOP.Add(item.Key, If(CCurAct(item.Key), 0)) 'bbh 2022/04/22
                    Next
                End If

                '       Read and store primary and secondary income within balance of payments
                '       May help review and improve treatmente of remittances, foreign aid, trade
                '           For instance, Lesotho has workers in South Africa that do not show as migrants
                '           Nicaragua has huge external debt that is working down with help from
                '               Heavily Indebted Poor Countries Initiative (funds not in IFs?)
                '       ---------------------------------------------------------------------------------

                Dim FinPayments As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim FinReceipts As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim SecFinPayments As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim SecFinReceipts As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                If cntx.HistoricMode Then
                    For Each key In cntx.Regionalization.Keys
                        FinPayments.Add(key, 0)
                        FinReceipts.Add(key, 0)
                        SecFinPayments.Add(key, 0)
                        SecFinReceipts.Add(key, 0)
                    Next
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesXIncPaymentsGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesXIncReceiptsGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Join s3 In cntx.GetSlice("SeriesXIncSecPaymentsGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                      Join s4 In cntx.GetSlice("SeriesXIncSecReceiptsGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s4.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value, Value4 = s4.Value)
                        FinPayments.Add(item.Key, item.Value)
                        FinReceipts.Add(item.Key, item.Value2)
                        SecFinPayments.Add(item.Key, item.Value3)
                        SecFinReceipts.Add(item.Key, item.Value4)
                    Next
                End If

                ' gvdb 2024/04/05
                ' unused variable
                'Dim NetIncome As Single?, CompNetIncome As Single?, PossibleRemitDif As Single?
                'Dim SWorkRemit As Single?, AdditionalRemit As Single?
                For Each key In cntx.Regionalization.Keys
                    If Not (FinReceipts(key).HasValue) Then
                        FinReceipts(key) = 0
                    End If
                    If Not (FinPayments(key).HasValue) Then
                        FinPayments(key) = 0
                    End If
                    If Not (SecFinReceipts(key).HasValue) Then
                        SecFinReceipts(key) = 0
                    End If
                    If Not (SecFinPayments(key).HasValue) Then
                        SecFinPayments(key) = 0
                    End If
                    CCURACTNETPRI.Add(key, FinReceipts(key) - FinPayments(key)) 'bbh 2022/04/22
                    CCURACTNETSEC.Add(key, SecFinReceipts(key) - SecFinPayments(key))

                    '       Move to Checking Bottom-up Current Account with Top-Down Data and Adjusting Trade when Far Out
                    '       ---------------------------------------------------------------------------------------------
                    'Basic calcluation of current account balance using components of current account from data, remittances and aid globally balanced
                    Dim Credits = exports(key) + (CAIDREC(key) + CXWORKREMITIN(key) - CXWORKREMITOUT(key)) / CGDP(key) * 100
                    Dim Debits = cimports(key) + CAIDDON(key) / CGDP(key) * 100
                    Dim AccBalance = Credits - Debits
                    CCURACTDATABOTTOM.Add(key, AccBalance)

                    If Not cntx.HistoricMode Then
                        If CCurAct(key).HasValue And TotYearsX(key) = 0 And TotYearsM(key) = 0 Then
                            'Use CurAct data to improve function-based estimates of Exports and Imports
                            Dim diff = CCurAct(key) - AccBalance 'if positive should improve balance
                            cimports(key) = AMAX(CSng(0.2 * cimports(key)), CSng(cimports(key) - 0.5 * diff))
                            exports(key) = AMAX(CSng(0.2 * exports(key)), CSng(exports(key) + 0.5 * diff))
                        End If
                    End If

                    Credits = exports(key) + (CAIDREC(key) + CXWORKREMITIN(key) - CXWORKREMITOUT(key)) / CGDP(key) * 100
                    Debits = cimports(key) + CAIDDON(key) / CGDP(key) * 100
                    AccBalance = Credits - Debits

                    If Abs(CSng(AccBalance)) > 20 And (exports(key) > 100 Or cimports(key) > 100) Then
                        'Adjust downward bigger value
                        If AccBalance > 0 Then
                            exports(key) =
                            AMAX(CSng(exports(key) * 0.2), exports(key) - (AccBalance - 20))
                        Else
                            cimports(key) = cimports(key) + (AccBalance + 20)
                        End If
                    End If

                    'jrs 2014/11/19 Credits = exports(key) + CAIDREC(key) + ValHold
                    Credits = exports(key) + (CAIDREC(key) + CXWORKREMITIN(key) - CXWORKREMITOUT(key)) / CGDP(key) * 100
                    Debits = cimports(key) + CAIDDON(key) / CGDP(key) * 100
                    AccBalance = Credits - Debits

                    If AccBalance > 20 Then
                        Dim AccAdj = AccBalance - 20
                        exports(key) = AMAX(CSng(exports(key) * 0.2), exports(key) - AccAdj / 2)
                        cimports(key) = cimports(key) + AccAdj / 2
                    End If

                    If AccBalance < -20 Then
                        Dim AccAdj = AccBalance + 20
                        exports(key) = exports(key) - AccAdj / 2
                        cimports(key) = AMAX(CSng(cimports(key) * 0.2), cimports(key) + AccAdj / 2)
                    End If

                    Credits = exports(key) + (CAIDREC(key) + CXWORKREMITIN(key) - CXWORKREMITOUT(key)) / CGDP(key) * 100
                    Debits = cimports(key) + CAIDDON(key) / CGDP(key) * 100
                    AccBalance = Credits - Debits 'Not used for further adjustments, for debugging analysis as desired

                    'Note:  Exports and Imports not normalized here for global totals.  Logic flows to ReadAndNormalizeTradeData where national totals are
                    '   checked against sectoral values and after normalization globally is done iteratively.

                Next key


            End Sub

            Private Sub RecomputeAgriOutput(cntx As IRebuildFacade)
                'Because of the different normalizations XAG has suffered, it no longer matches the SUM of AgXValues
                'XAG(key) = XAGCR + XAGMT + XAGFS
                'Test is working with 8 iterations to make
                'All Global X-M < 0.001

                Dim bContinue As Boolean
                bContinue = True

                'Dim DiffCrop As Single = 1000000000000.0
                'Dim DiffMeat As Single = 1000000000000.0
                'Dim DiffFish As Single = 1000000000000.0

                'jrs 2026/03/04 set a maximum a number of iterations
                Dim MaxIterations As Integer = 20
                Dim Iteration As Integer = 0
                Do While bContinue
                    RecomputeOutputAgriNormalization(bContinue, cntx)
                    Iteration = Iteration + 1
                    If Iteration >= MaxIterations Then
                        bContinue = False
                    End If
                Loop
            End Sub

            Private Sub RecomputeOutputAgriNormalization(ByRef bContinue As Boolean, cntx As IRebuildFacade)
                Dim XTOT As Single, MTot As Single
                Dim XTotCrop As Single, MTotCrop As Single
                XTotCrop = 0
                MTotCrop = 0
                Dim XTotMeat As Single, MTotMeat As Single
                XTotMeat = 0
                MTotMeat = 0
                Dim XTotFish As Single, MTotFish As Single
                XTotFish = 0
                MTotFish = 0

                Dim XAGCR As Single?, XAGMT As Single?, XAGFS As Single?
                Dim MAGCR As Single?, MAGMT As Single?, MAGFS As Single?
                For Each key In cntx.Regionalization.Keys
                    XAGCR = If(AGXCropValueTrade(key), 0)
                    XAGMT = If(AGXMeatValueTrade(key), 0)
                    XAGFS = If(AGXFishValueTrade(key), 0)
                    MAGCR = If(AGMCropValueTrade(key), 0)
                    MAGMT = If(AGMMeatValueTrade(key), 0)
                    MAGFS = If(AGMFishValueTrade(key), 0)

                    XTOT = CSng(XAGCR + XAGMT + XAGFS)
                    MTot = CSng(MAGCR + MAGMT + MAGFS)

                    'jrs 2018/12/18
                    If XTOT > 0 Then
                        'jrs 2020/03/24 If key = "Cuba" Then Stop
                        AGXCropValueTrade(key) = AGXCropValueTrade(key) * XAG(key) / XTOT
                        AGXMeatValueTrade(key) = AGXMeatValueTrade(key) * XAG(key) / XTOT
                        AGXFishValueTrade(key) = AGXFishValueTrade(key) * XAG(key) / XTOT
                    End If
                    'jrs 2018/12/18
                    If MTot > 0 Then
                        AGMCropValueTrade(key) = AGMCropValueTrade(key) * MAG(key) / MTot
                        AGMMeatValueTrade(key) = AGMMeatValueTrade(key) * MAG(key) / MTot
                        AGMFishValueTrade(key) = AGMFishValueTrade(key) * MAG(key) / MTot
                    End If

                    XTotCrop = CSng(XTotCrop + If(AGXCropValueTrade(key), 0))
                    MTotCrop = CSng(MTotCrop + If(AGMCropValueTrade(key), 0))
                    XTotMeat = CSng(XTotMeat + If(AGXMeatValueTrade(key), 0))
                    MTotMeat = CSng(MTotMeat + If(AGMMeatValueTrade(key), 0))
                    XTotFish = CSng(XTotFish + If(AGXFishValueTrade(key), 0))
                    MTotFish = CSng(MTotFish + If(AGMFishValueTrade(key), 0))
                Next

                'Now we have changed AGXvalues and AGMvalues so they might not match globally anymore
                'SUM(AGXVALUES(type)) = SUM(AGMVALUES(type))
                'Average factor
                Dim cropFact As Single
                cropFact = (XTotCrop + MTotCrop) / 2
                Dim meatFact As Single
                meatFact = (XTotMeat + MTotMeat) / 2
                Dim fishFact As Single
                fishFact = (XTotFish + MTotFish) / 2

                'Check if the Averages are close enough to stop
                'Or Abs(XTotCrop - MTotCrop) > Abs(DiffCrop) Or Abs(XTotMeat - MTotMeat) > Abs(DiffMeat) Or Abs(XTotFish - MTotFish) > Abs(DiffFish) 
                If (Abs(XTotCrop - MTotCrop) < 0.001 And Abs(XTotMeat - MTotMeat) < 0.001 And Abs(XTotFish - MTotFish) < 0.001) Then
                    bContinue = False
                End If

                'DiffCrop = XTotCrop - MTotCrop
                'DiffMeat = XTotMeat - MTotMeat
                'DiffFish = XTotFish - MTotFish

                For Each key In cntx.Regionalization.Keys
                    'Crop
                    AGXCropValueTrade(key) = AGXCropValueTrade(key) * cropFact / XTotCrop
                    AGMCropValueTrade(key) = AGMCropValueTrade(key) * cropFact / MTotCrop
                    'Meat
                    AGXMeatValueTrade(key) = AGXMeatValueTrade(key) * meatFact / XTotMeat
                    AGMMeatValueTrade(key) = AGMMeatValueTrade(key) * meatFact / MTotMeat
                    'Fish
                    AGXFishValueTrade(key) = AGXFishValueTrade(key) * fishFact / XTotFish
                    AGMFishValueTrade(key) = AGMFishValueTrade(key) * fishFact / MTotFish
                Next
            End Sub

            Private Sub ReadInformalEconomy(cntx As IRebuildFacade)
                '   Read from Informal Economy  Data Table
                '   ------------------------------------------
                Dim CGDPInformSHRFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim XYTABL As SeriesEstimator
                If cntx.HistoricMode Then
                    XYTABL = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Shadow Economy Share Of Total(Earliest) Log").ToEstimator(CGDPPCP)
                    Dim XYTABL2 As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Informal Economy Share Of Total(1960) Log").ToEstimator(CGDPPCP)

                    Dim yrs As Short() = cntx.GetYears("SeriesGDPInformalElgin").OrderBy(Function(y) y).ToArray()
                    Dim gdpshadowtbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesGDPInformalElgin", yrs)

                    For Each key In cntx.Regionalization.Keys  'Back to 1965
                        CGDPInformSHRFromData.Add(key, False)
                        CGDPSHADOWSHR.Add(key, getClosestYrVal(gdpshadowtbl, yrs, key, cntx.FirstYear, HistDist))
                        If Not CGDPSHADOWSHR(key).HasValue Then
                            CGDPSHADOWSHR(key) = XYTABL(key)
                        Else
                            CGDPInformSHRFromData(key) = True
                        End If
                    Next

                    Dim yrs2 As Short() = cntx.GetYears("SeriesGDPInformalBlended").OrderBy(Function(y) y).ToArray()
                    Dim gdpinformtbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesGDPInformalBlended", yrs2)

                    For Each key In cntx.Regionalization.Keys  'Back to 1965
                        CGDPInformSHRFromData(key) = False
                        CGDPINFORMSHR.Add(key, getClosestYrVal(gdpinformtbl, yrs2, key, cntx.FirstYear, HistDist))
                        If Not CGDPINFORMSHR(key).HasValue Then
                            CGDPINFORMSHR(key) = XYTABL2(key)
                        Else
                            CGDPInformSHRFromData(key) = True
                        End If
                    Next
                Else
                    'jrs 2024/06/28
                    Dim TFNameShadowEconomyShare As String
                    TFNameShadowEconomyShare = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Shadow Economy Share of Total(" & BaseYear & ") Log"
                    TFNameShadowEconomyShare = getFunctionNameYrOrMstRct(TFNameShadowEconomyShare, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'jrs 2024/06/28 XYTABL = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Shadow Economy Share Of Total(MOSTRECENT) Log").ToEstimator(CGDPPCP)
                    XYTABL = cntx.GetRegression(TFNameShadowEconomyShare).ToEstimator(CGDPPCP)
                    'jrs 2024/06/28
                    Dim TFNameInformalEconomyShare As String
                    TFNameInformalEconomyShare = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Informal Economy Share of Total(" & BaseYear & ") Log"
                    TFNameInformalEconomyShare = getFunctionNameYrOrMstRct(TFNameInformalEconomyShare, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    'jrs 2024/06/28 Dim XYTABL2 As SeriesEstimator = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Informal Economy Share Of Total(MOSTRECENT) Log").ToEstimator(CGDPPCP)
                    Dim XYTABL2 As SeriesEstimator = cntx.GetRegression(TFNameInformalEconomyShare).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesGDPInformalElgin", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join s2 In cntx.GetSlice("SeriesGDPInformalBlended", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                        CGDPInformSHRFromData.Add(item.Key, False)
                        CGDPSHADOWSHR.Add(item.Key, item.Value)
                        If Not (CGDPSHADOWSHR(item.Key).HasValue) Then
                            CGDPSHADOWSHR(item.Key) = XYTABL(item.Key)
                        Else
                            CGDPInformSHRFromData(item.Key) = True
                        End If

                        CGDPInformSHRFromData(item.Key) = False
                        CGDPINFORMSHR.Add(item.Key, item.Value2)
                        If Not (CGDPINFORMSHR(item.Key).HasValue) Then
                            CGDPINFORMSHR(item.Key) = XYTABL2(item.Key)
                        Else
                            CGDPInformSHRFromData(item.Key) = True
                        End If
                    Next
                End If

                Dim TbName As String
                'jrs 2024/06/13 TbName$ = "GDP/Capita (PPP 2011) Versus LabInformal/GDPInformal (" & CStr(cntx.BaseYear) & ") Log"
                TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus LabInformal/GDPInformal (" & CStr(cntx.BaseYear) & ") Log"
                TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                'Function is in dollars npw, not in thousand dollars
                Dim XYTABL3 As SeriesEstimator = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                Dim informallabgdprat As Single?
                Dim CLABINFORMSHRFromData As IDictionary(Of String, Boolean)
                CLABINFORMSHRFromData = cntx.Fetch(Of IDictionary(Of String, Boolean))("CLABINFORMSHRFromData")
                CLABINFORMSHR = cntx.Fetch(Of IDictionary(Of String, Single?))("LABINFORMSHR")
                For Each key In cntx.Regionalization.Keys
                    informallabgdprat = XYTABL3(key)
                    informallabgdprat = Amin(3, AMAX(1, informallabgdprat))

                    'CLABINFORMSHR.Add(key, Nothing)
                    'reconcile data and estimation of informal shares of gdp and labor
                    If CGDPInformSHRFromData(key) = True Then

                        If CLABINFORMSHRFromData(key) = True Then
                            'both labor and GDP shares are from data : keep both
                        Else
                            'only GDP share from data : Keep that data; adjust labor share using (labor share gdp share ratio) function
                            CLABINFORMSHR(key) = CGDPINFORMSHR(key) * informallabgdprat
                        End If

                    Else
                        If CLABINFORMSHRFromData(key) = True Then
                            'only labor share from data : Keep that data; adjust GDP share using (labor share gdp share ratio) function
                            CGDPINFORMSHR(key) = CLABINFORMSHR(key) / informallabgdprat
                        Else
                            'both labor and GDP shares are estimated : prioritize GDP share estimate
                            CLABINFORMSHR(key) = CGDPINFORMSHR(key) * informallabgdprat
                        End If
                    End If

                    '''''''JAM 2019-08-05 Filling gaps
                    If cntx.HistoricMode Then
                        If Not CLABINFORMSHR(key).HasValue Then

                            CLABINFORMSHR(key) = CLABINFORMSHREXT(key)
                        End If
                    End If
                    ''''''''''''''''''''''''''''''

                    CGDPINFORMSHR(key) = AMAX(1, Amin(85, CGDPINFORMSHR(key)))
                    CLABINFORMSHR(key) = AMAX(1, Amin(85, CLABINFORMSHR(key)))  '3

                    'bbh 2015/03/25  Turkey, Vietnam clear out of line; India's ratio about 8, highest other
                    CGDPINFORMSHR(key) = AMAX(CLABINFORMSHR(key) / 8, CGDPINFORMSHR(key))

                Next

                XYTABL = cntx.GetRegression("Informal Employment Versus Share of Inf Emp Working at Inf Enterprises(MOSTRECENT) Linear").ToEstimator(CLABINFORMSHR)
                Dim TotBoth As Single?, CLABINFORMSECOTHTHANINFHHMALE As Single?, CLABINFORMSECOTHTHANINFFORMMALE As Single?
                Dim CLABINFORMSECOTHTHANINFHHFEMALE As Single?, CLABINFORMSECOTHTHANINFFORMFEMALE As Single?
                Dim CLABINFORMSECOTHTHANINFHHTOT As Single?, CLABINFORMSECOTHTHANINFFORMTOT As Single?
                For Each item In (From s In cntx.GetSlice("SeriesLaborInformalInfSecTotalInformal", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Join s2 In cntx.GetSlice("SeriesLaborInformalFemaleInformalSec", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                  Join s3 In cntx.GetSlice("SeriesLaborInformalMaleInformalSec", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                  Join s4 In cntx.GetSlice("SeriesLaborInformalMaleHHInformal", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s4.Key
                                  Join s5 In cntx.GetSlice("SeriesLaborInformalMaleFormalSec", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s5.Key
                                  Join s6 In cntx.GetSlice("SeriesLaborInformalFemaleHHInformal", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s6.Key
                                  Join s7 In cntx.GetSlice("SeriesLaborInformalFemaleFormalSec", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s7.Key
                                  Join s8 In cntx.GetSlice("SeriesLaborInformalHHTotalInformal", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s8.Key
                                  Join s9 In cntx.GetSlice("SeriesLaborInformalFormSecTotalInformal", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s9.Key
                                  Select Key = s.Key, Value = s.Value, Value2 = s2.Value, Value3 = s3.Value, Value4 = s4.Value, Value5 = s5.Value,
                              Value6 = s6.Value, Value7 = s7.Value, Value8 = s8.Value, Value9 = s9.Value)
                    CLABINFORMSECINFTOTAL.Add(item.Key, item.Value)
                    If Not (CLABINFORMSECINFTOTAL(item.Key).HasValue) Then
                        CLABINFORMSECINFTOTAL(item.Key) = XYTABL(item.Key)
                    End If

                    CLABINFORMSECINFTOTAL(item.Key) = AMAX(1, Amin(95, CLABINFORMSECINFTOTAL(item.Key)))

                    'Male/female Share of Informal Employment Working in Informal Enterprises
                    'Male female data as % of both sexes; need to convert to % of labinformal
                    CLABINFORMSECINFFEMALE.Add(item.Key, item.Value2)
                    If Not (CLABINFORMSECINFFEMALE(item.Key).HasValue) Then
                        If CGDPPCP(item.Key) < 10 Then
                            CLABINFORMSECINFFEMALE(item.Key) = 50
                        Else
                            CLABINFORMSECINFFEMALE(item.Key) = 30  'middle to higher income countries; mostly males are in (non hh) informal enterprises
                        End If
                    End If

                    CLABINFORMSECINFMALE.Add(item.Key, item.Value3)
                    If Not (CLABINFORMSECINFMALE(item.Key).HasValue) Then
                        If CGDPPCP(item.Key) < 10 Then
                            CLABINFORMSECINFMALE(item.Key) = 50
                        Else
                            CLABINFORMSECINFMALE(item.Key) = 70  'middle to higher income countries; mostly males are in (non hh) informal enterprises
                        End If
                    End If

                    'Turn the male and female into proportion of total informal employment
                    TotBoth = CLABINFORMSECINFMALE(item.Key) + CLABINFORMSECINFFEMALE(item.Key)
                    CLABINFORMSECINFMALE(item.Key) = CLABINFORMSECINFTOTAL(item.Key) * CLABINFORMSECINFMALE(item.Key) / TotBoth
                    CLABINFORMSECINFFEMALE(item.Key) = CLABINFORMSECINFTOTAL(item.Key) * CLABINFORMSECINFFEMALE(item.Key) / TotBoth

                    '---------------------------------------------------------------
                    'Share of Informal Employment Working in Non-Informal Enterprises
                    CLABINFORMSECOTHTHANINFTOTAL.Add(item.Key, 100 - CLABINFORMSECINFTOTAL(item.Key))

                    CLABINFORMSECOTHTHANINFHHMALE = Nothing
                    CLABINFORMSECOTHTHANINFFORMMALE = Nothing

                    CLABINFORMSECOTHTHANINFHHMALE = item.Value4 'Household : male % % Household Informal
                    CLABINFORMSECOTHTHANINFFORMMALE = item.Value5 'Formal : male % Formal Informal

                    CLABINFORMSECOTHTHANINFHHFEMALE = Nothing
                    CLABINFORMSECOTHTHANINFFORMFEMALE = Nothing

                    CLABINFORMSECOTHTHANINFHHFEMALE = item.Value6     'Household : Female % Household Informal
                    CLABINFORMSECOTHTHANINFFORMFEMALE = item.Value7 'Formal : Female % Formal Informal

                    CLABINFORMSECOTHTHANINFHHTOT = Nothing
                    CLABINFORMSECOTHTHANINFFORMTOT = Nothing
                    CLABINFORMSECOTHTHANINFHHTOT = item.Value8    'Household : Total % Total Informal
                    CLABINFORMSECOTHTHANINFFORMTOT = item.Value9 'Formal : Total % Total Informal

                    'Male/female Share of Informal Employment Working in non-Informal Enterprises
                    'Male female data as % of both sexes; need to convert to % of later labinformal
                    If (CLABINFORMSECOTHTHANINFHHMALE.HasValue) And (CLABINFORMSECOTHTHANINFFORMMALE.HasValue) _
                 And (CLABINFORMSECOTHTHANINFHHTOT.HasValue) And (CLABINFORMSECOTHTHANINFFORMTOT.HasValue) Then

                        CLABINFORMSECOTHTHANINFMALE.Add(item.Key, (CLABINFORMSECOTHTHANINFHHMALE + CLABINFORMSECOTHTHANINFFORMMALE) /
                                                        (CLABINFORMSECOTHTHANINFHHTOT + CLABINFORMSECOTHTHANINFFORMTOT))

                    Else

                        CLABINFORMSECOTHTHANINFMALE.Add(item.Key, 30)  '?? it's not just household; also has formal

                    End If

                    'female
                    If (CLABINFORMSECOTHTHANINFHHFEMALE.HasValue) And (CLABINFORMSECOTHTHANINFFORMFEMALE.HasValue) _
                     And (CLABINFORMSECOTHTHANINFHHTOT.HasValue) And (CLABINFORMSECOTHTHANINFFORMTOT.HasValue) Then

                        CLABINFORMSECOTHTHANINFFEMALE.Add(item.Key, (CLABINFORMSECOTHTHANINFHHFEMALE + CLABINFORMSECOTHTHANINFFORMFEMALE) /
                                                            (CLABINFORMSECOTHTHANINFHHTOT + CLABINFORMSECOTHTHANINFFORMTOT))

                    Else

                        CLABINFORMSECOTHTHANINFFEMALE.Add(item.Key, 70)  '?? it's not just household; also has formal

                    End If

                    'Turn the male and female (non-informal) into proportion of total informal employment
                    TotBoth = CLABINFORMSECOTHTHANINFMALE(item.Key) + CLABINFORMSECOTHTHANINFFEMALE(item.Key)
                    CLABINFORMSECOTHTHANINFMALE(item.Key) = CLABINFORMSECOTHTHANINFTOTAL(item.Key) * CLABINFORMSECOTHTHANINFMALE(item.Key) / TotBoth
                    CLABINFORMSECOTHTHANINFFEMALE(item.Key) = CLABINFORMSECOTHTHANINFTOTAL(item.Key) * CLABINFORMSECOTHTHANINFFEMALE(item.Key) / TotBoth
                Next

            End Sub

            Private Sub InputOutputData(cntx As IRebuildFacade)
                Dim SectConv(100) As Integer, GTAPMatrix(100, 100) As Single?, GTAPImptMatrix(100, 100) As Single?, IFsMatrix(10, 10) As Single?
