                'ReDim GLABEMPS(CCount, cntx.NSec, cntx.NSkill)
                'ReDim GVADD(CCount, cntx.NSec)
                'ReDim GGDPPCP(CCount)
                'mti 2018/05/13 End

                'jrs 2019/01/31 
                'ReDim GCountryNo(cntx.Regionalization.Keys.Count)
                'mti 2018/05/16 End

                '    Dim IOCountryMatrix(200, 10, 10)
                'Assumes max of 100 GTAP sectors, 10 IFs sectors, 20 IFs generic matrices

                '   Set generic IO matrices, labor vectors, and counter to 0
                '   --------------------------------------------------------

                For MCount% = 1 To 20
                    For LCount% = 1 To cntx.NSec
                        For SCount% = 1 To cntx.NSec
                            IFsIOMatrices(LCount%, SCount%, MCount%) = 0
                        Next SCount%
                        IFsCoefUnskilled(LCount%, MCount%) = 0
                        IFsCoefSkilled(LCount%, MCount%) = 0



                    Next LCount%
                    IFsIOCount(MCount%) = 0
                Next MCount%

                '   Read IFs sectors corresponding to GTAP and count GTAP sectors
                '   -------------------------------------------------------------
                Using db As IFsContext = New IFsContext()
                    Using db2 As IFs2Context = New IFs2Context()
                        Dim NumbSectors As Short = 0
                        Dim SectorVal As Integer
                        Dim sc As IEnumerable(Of GTAPSectorConversion)
                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        sc = db.GTAPSectorConversion.AsEnumerable()
                        For Each sec As GTAPSectorConversion In sc
                            Select Case sec.IFsSector
                                Case "Agri"
                                    SectorVal = Agri
                                Case "Ener"
                                    SectorVal = Ener
                                Case "Mate"
                                    SectorVal = Mate
                                Case "Manu"
                                    SectorVal = Manu
                                Case "Serv"
                                    SectorVal = Serv
                                Case "ICT"
                                    SectorVal = ICT
                            End Select
                            SectConv(sec.SectorNumber) = SectorVal
                            NumbSectors = NumbSectors + 1S
                        Next

                        '   Read generic IO matrix thresholds
                        '   ---------------------------------
                        Dim th As IEnumerable(Of IOThresholds)
                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        th = db.IOThresholds.AsEnumerable()
                        Dim NumbMatrices As Short = 0
                        For Each thr As IOThresholds In th
                            NumbMatrices = NumbMatrices + 1S
                            IOThresholds(NumbMatrices) = thr.Threshold
                        Next

                        '   Identify and process appropriate .csv file of intersectoral flows
                        '   -----------------------------------------------------------------
                        Dim yrsLabAgri As Short() = cntx.GetYears("SeriesLaborAgriSector").OrderBy(Function(y) y).ToArray()
                        Dim LabAgriTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesLaborAgriSector", yrsLabAgri)

                        If cntx.HistoricMode Then
                            db2.Clear(GetType(GTAPIOAggregationCountryHist))
                            db2.Clear(GetType(GTAPValueAddedCountryHist))
