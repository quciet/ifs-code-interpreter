                            For AGCount = 1 To TotPovAGCount%
                                If CPOVRATEBOTHSEXESNPL(key)(AGCount) > 0 Then
                                    Dim PovCountMale = CPOVRATEMALENPL(key)(AGCount) * CPopPovAGMale(key)(AGCount) / 100
                                    Dim PovCountFemale = CPOVRATEFEMALENPL(key)(AGCount) * CPopPovAGFemale(key)(AGCount) / 100
                                    Dim PovCountTotalBottomUp = PovCountMale + PovCountFemale
                                    Dim PovCountTotal = CPOVRATEBOTHSEXESNPL(key)(AGCount) * (CPopPovAGMale(key)(AGCount) + CPopPovAGFemale(key)(AGCount)) / 100

