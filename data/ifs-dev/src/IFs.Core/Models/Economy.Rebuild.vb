                                    AMAX(0.0001F, IFsColSums(SCount%)) 'row,column divided by column sum
                                    Next SCount%
                                Next LCount%
                                For LCount% = 1 To cntx.NSec 'Make sure row sums do not take more than 95% of output
                                    RowSum = 0
                                    For SCount% = 1 To cntx.NSec
                                        RowSum = RowSum + IFsCoefMatrix(LCount%, SCount%)
                                    Next SCount%
