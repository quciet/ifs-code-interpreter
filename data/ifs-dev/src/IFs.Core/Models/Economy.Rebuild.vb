                'Next
                'bbh 2022/04/22 end: Better net data on foreign pop and remittances mean no longer need sign and magnitude adjustments

                '   Social Accounting Matrix Calculations to Fill Holes, Mostly Source Countries
                '   ----------------------------------------------------------------------------

                '   Normalize World Bank Flows in and out
                '   -----------------------------------------------
                Dim TotalWBFlows As Single?
                TotalWBFlows = GloXWBLnFOut + GloXWBDebt * sxwbloanr / 100    '* (1 + sxwbloanr / 100)

                For Each key In cntx.Regionalization.Keys
                    CXWBLNFIN(key) = CXWBLNFIN(key) * TotalWBFlows / AMAX(0.001F, GloXWBLnFIn)
                Next

                '   Normalize IMF Flows in and out
                '   -----------------------------------------------
                Dim TotalIMFFlows As Single?
                'TotalIMFFlows = GloXIMFCrFOut * (1 + sximfcreditr / 100)
                TotalIMFFlows = GloXIMFCrFOut + GloXIMFDebt * sximfcreditr / 100

                For Each key In cntx.Regionalization.Keys
                    CXIMFCRFIN(key) = CXIMFCRFIN(key) * TotalIMFFlows / AMAX(0.001F, GloXIMFCrFIn)
                Next

                'bbh 2011/11/12  Adjusted this allocation because above now have new outflow countries also
                '   Allocate Portfolio Investment to Advanced Countries by Economic Size
                '   ---------------------------------------------------------------------
                For Each key In cntx.Regionalization.Keys
                    PerCap = CGDP(key) / CPOP(key)
                    'If PerCap > 10 And CXPORTFOLIO(key) <= 0.001 Then
                    If PerCap > 10 Then
                        CXPORTSTOUT(key) = CGDP(key) / AdvGDPXPortfolio * GloXPortfolio
                        '        Else
                        '            CXPORTSTOUT(key) = 0
                    End If
                Next

                '   Balance Portfolio Stocks in and Out; Adjust Stocks Out
                '   ------------------------------------------------------
                Dim WorldInStocks As Single?, WorldOutStocks As Single?

                WorldInStocks = 0
                WorldOutStocks = 0

                For Each key In cntx.Regionalization.Keys
                    WorldInStocks = WorldInStocks + CXPORTFOLIO(key)
                    WorldOutStocks = WorldOutStocks + CXPORTSTOUT(key)
                Next
                WorldOutStocks = AMAX(0.001F, WorldOutStocks)
                For Each key In cntx.Regionalization.Keys 'Normalize to WorldInStocks
                    CXPORTSTOUT(key) = CXPORTSTOUT(key) * WorldInStocks / WorldOutStocks
                Next

                ' Compute Porfolio Flows Out
                '--------------------------
                For Each key In cntx.Regionalization.Keys 'Assume country flows out are same share of global
                    'inflows that country stocks are of global stocks
                    If cntx.HistoricMode Then
                        CXPORTFOUT(key) = 0
                    Else
                        CXPORTFOUT(key) = GloXPortFIn * CXPORTSTOUT(key) / WorldInStocks 'WorldOutStocks
                    End If
                Next

                '   Balance FDI Stocks with Adjustments to Advanced Countries
                '   ---------------------------------------------------------

                WorldInStocks = 0
                WorldOutStocks = 0

                For Each key In cntx.Regionalization.Keys
                    WorldInStocks = WorldInStocks + CXFDISTOCK(key)
                    WorldOutStocks = WorldOutStocks + CXFDISTOUT(key)
                Next
                WorldOutStocks = AMAX(0.001F, WorldOutStocks)
                For Each key In cntx.Regionalization.Keys
                    CXFDISTOUT(key) = CXFDISTOUT(key) * WorldInStocks / WorldOutStocks
                Next

