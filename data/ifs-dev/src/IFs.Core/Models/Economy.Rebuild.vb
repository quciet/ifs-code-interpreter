                                    PovCountMale = CSng(PovCountMale * NormFac)
                                    PovCountFemale = CSng(PovCountTotal - PovCountMale)
                                    CPOVRATEMALENPL(key)(AGCount) = CSng(100 * PovCountMale / AMAX(0.00001, CPopPovAGMale(key)(AGCount)))
                                    CPOVRATEFEMALENPL(key)(AGCount) = CSng(100 * PovCountFemale / AMAX(0.00001, CPopPovAGFemale(key)(AGCount)))
