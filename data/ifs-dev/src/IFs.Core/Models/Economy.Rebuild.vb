                                    GTAPCnt% = GTAPCnt% + 1
                                End If
                                'mti 2018/05/13 End

                                'jrs 2021/09/07 identify Decimal Separator and transform . to , when necessary
                                Dim culture1 As System.Globalization.CultureInfo = System.Globalization.CultureInfo.CurrentCulture
                                Dim nfi As System.Globalization.NumberFormatInfo = culture1.NumberFormat
                                Dim bCommISDecSep As Boolean = (nfi.NumberDecimalSeparator = ",")

                                Dim Dummy As String, sVals1() As String, sVals2() As String, sVals3() As String, sVals4() As String
                                ' Create new StreamReader instance with Using block.
                                Using reader1 As StreamReader = New StreamReader(cntx.DataFileDir + "GTAP Data\" + Gtapname$ + "Flows.csv")
                                    Using reader2 As StreamReader = New StreamReader(cntx.DataFileDir + "GTAP Data\" + Gtapname$ + "Factors.csv")
                                        Using reader3 As StreamReader = New StreamReader(cntx.DataFileDir + "GTAP Data\" + Gtapname$ + "ImptFlows.csv")
