                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints24)
                                        Case "Ints25"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints25)
                                        Case "Ints26"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints26)
                                        Case "Ints31"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints31)
                                        Case "Ints32"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints32)
                                        Case "Ints33"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints33)
                                        Case "Ints34"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints34)
                                        Case "Ints35"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints35)
                                        Case "Ints36"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints36)
                                        Case "Ints41"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints41)
                                        Case "Ints42"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints42)
                                        Case "Ints43"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints43)
                                        Case "Ints44"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints44)
                                        Case "Ints45"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints45)
                                        Case "Ints46"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints46)
                                        Case "Ints51"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints51)
                                        Case "Ints52"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints52)
                                        Case "Ints53"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints53)
                                        Case "Ints54"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints54)
                                        Case "Ints55"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints55)
                                        Case "Ints56"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints56)
                                        Case "Ints61"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints61)
                                        Case "Ints62"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints62)
                                        Case "Ints63"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints63)
                                        Case "Ints64"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints64)
                                        Case "Ints65"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints65)
                                        Case "Ints66"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints66)
                                    End Select

                                Next SCount%
                            Next LCount%
                        Next
                    End Using
                End Using

                '   This block reconciles production for final demand and value added
                '       It computes ZS from both and, assuming that value added and the IO
                '           matrix are reasonably good, recomputes PFD components and totals
                '   Compute Production for Final Demand and Invert to get Gross Production
                '   ----------------------------------------------------------------------
                Dim ZSManSerfromPFD As Single?
                Dim ZSManShrFromPFD As Single?
                Dim intsp As Single?
                Dim ZSManSerfromVADD As Single?, ZSManShrFromVADD As Single?, PFDVADDGap As Single?, SPFDVADDGap As Single?
                Dim MulSign As Integer, TransMax As Single?
                Dim msg As String
                For Each key In cntx.Regionalization.Keys
                    CCGDP.Add(key, 0)
                    'If key = "Singapore" Then Stop
                    For S% = 1 To cntx.NSec
                        CPFD(key)(S%) = CCS(key)(S%) + CGS(key)(S%) + CINVS(key)(S%) + CXS(key)(S%) - CMS(key)(S%)
                        'If key = "India" And S% = Manu Then Stop
                        CCGDP(key) = CCGDP(key) + CPFD(key)(S%)
                        'If CPFD(key)(S%) < 0 Then Stop
                        If S% = 6 And CPFD(key)(S%) < 0 Then CPFD(key)(S%) = CSng(CGDP(key) * 0.02) 'bbh 2021/08/04 Djibouti ICT sector messed up
                        'jrs 2026/08/28 PFD can be negative if Imports are greater than domestic demand
                        If CPFD(key)(S%) < 0 Then CPFD(key)(S%) = CSng(CGDP(key) * 0.005) 'bbh 2024/05/24 India materials was <0, probably also others
                    Next S%
                    If key = "Afghanistan" Then Stop
                    EnMul(key) = 1
                    For LCount% = 1 To cntx.NSec
                        IOMatMul(key)(LCount%) = 1
                    Next LCount%
                    'If key = "Afghanistan" Then Stop
                    EInvert(key, cntx) 'Input is CPFD; Output is CZS
                    'If key = "Ukraine" Then Stop
                    'The above is done using unadjusted IO country coefficients
                    'If key = "Oman" Then Stop

                    For S% = 1 To cntx.NSec
                        ZSfromPFD(S%) = CZS(key)(S%)
                    Next S%
                    ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                    If ZSManSerfromPFD <= 0 Then
                        If cntx.DevelopmentMode Then
                            msg$ = "The Manuf And Service Data For " + key +
                                " are very faulty.  ZSManSerfromPFD " + "="
                            msg$ = msg$ + ZSManSerfromPFD.ToString +
                                "  See DataEcon To correct."
                            Debug.Print(msg$)
                        End If
                    End If
                    ZSManShrFromPFD = ZSfromPFD(Manu) / AMAX(0.0001F, ZSManSerfromPFD)

                    For column% = 1 To cntx.NSec
                        'jrs 2019/02/14 ints(key, column%) = 0!
                        intsp = 0!
                        For row = 1 To cntx.NSec
                            '               AMat(key)( row, column%) = EIOMat(key)( row, column%)
                            intsp = intsp + AMatCountry(key)(row, column%)
                        Next row
                        intsp = Amin(0.95F, intsp)
                        zsfromvadd(column%) = ValAdd(key)(column%) / (1 - intsp)
                    Next column%
                    'If key = "Comoros" Then Stop
                    ZSManSerfromVADD = zsfromvadd(Manu) + zsfromvadd(Serv)
                    ZSManShrFromVADD = zsfromvadd(Manu) / ZSManSerfromVADD 'Target ratio

                    PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                    SPFDVADDGap = PFDVADDGap

                    'If key = "Ethiopia" Then Stop
                    For NCOUNT% = 1 To 1000
                        If Abs(CSng(PFDVADDGap)) < 0.02 Then Exit For
                        MulSign = 1
                        If PFDVADDGap < 0 Then MulSign = -1
                        TransMax = Amin(CCS(key)(Manu), CCS(key)(Serv))
                        CCS(key)(Manu) = AMAX(CSng(0.99 * CCS(key)(Manu)),
                            CSng(CCS(key)(Manu) + 0.01 * MulSign * TransMax))
                        CCS(key)(Serv) = AMAX(CSng(0.99 * CCS(key)(Serv)),
                            CSng(CCS(key)(Serv) - 0.01 * MulSign * TransMax))
                        TransMax = Amin(CGS(key)(Manu), CGS(key)(Serv))
                        CGS(key)(Manu) = AMAX(CSng(0.99 * CGS(key)(Manu)),
                            CSng(CGS(key)(Manu) + 0.005 * MulSign * TransMax))
                        CGS(key)(Serv) = AMAX(0.99F * CGS(key)(Serv),
                            CGS(key)(Serv) - 0.005F * MulSign * TransMax)
                        TransMax = Amin(CINVS(key)(Manu), CINVS(key)(Serv))
                        CINVS(key)(Manu) = AMAX(0.99F * CINVS(key)(Manu),
                            CINVS(key)(Manu) + 0.005F * MulSign * TransMax)
                        CINVS(key)(Serv) = AMAX(0.99F * CINVS(key)(Serv),
                            CINVS(key)(Serv) - 0.005F * MulSign * TransMax)
                        CPFD(key)(Manu) = CCS(key)(Manu) + CGS(key)(Manu) _
                            + CINVS(key)(Manu) + CXS(key)(Manu) - CMS(key)(Manu)
                        CPFD(key)(Serv) = CCS(key)(Serv) + CGS(key)(Serv) _
                            + CINVS(key)(Serv) + CXS(key)(Serv) - CMS(key)(Serv)

                        EInvert(key, cntx) 'Input is CPFD; Output is CZS
                        For S% = 1 To cntx.NSec
                            ZSfromPFD(S%) = CZS(key)(S%)
                        Next S%
                        ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                        ZSManShrFromPFD = ZSfromPFD(Manu) / ZSManSerfromPFD

                        PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                        If Abs(CSng(PFDVADDGap)) - Abs(CSng(SPFDVADDGap)) < 0.0005 And
                            Abs(CSng(SPFDVADDGap)) - Abs(CSng(PFDVADDGap)) < 0.0005 Then Exit For
                        SPFDVADDGap = PFDVADDGap

                    Next NCOUNT%


                    'If key = "Singapore" Then Stop

                    '      Check on Consistency of Raw Energy Data
                    '       with IO Matrix - adjust coefficients
                    '   -----------------------------------------
                    Dim totenprod As Single?, E As Integer
                    totenprod = 0
                    For E = 1 To Renew  'Oil, gas, coal, hydro, nuclear, renewable
                        totenprod = totenprod + CENP(key)(E) * WorldEP
                        'when switched to 100 index, must keep this in dollars per barrel
                        'totenprod = totenprod + CENP(key)(E%) * ENPRI(key)
                    Next E
                    Dim AppDemand As Single?
                    'AppDemand = totenprod + CMS(key)(Ener) - CXS(key)(Ener)
                    AppDemand = totenprod + CMS(key)(Ener) - CXS(key)(Ener) + CCS(key)(Ener) 'bbh 2024/06/21 replaced above after adding energy to HH Consumpption
                    'If key = "Afghanistan" Then Stop
                    '   Do not use (ENM(key) - ENX(key)) * ENPRI(key) because enm and enx computed
                    '       from MS, XS in energy submodel
                    'Process below works by comparing computed CZS, gross production,
                    '     (from EINVERT above, driven by CPFD),
                    '     with total physical production times price.  When there is a descrepancy,
                    '     a multiplier on intersectoral flows is computed iteratively and used
                    '     to change the intersectoral flows in EIOMAT, passing those to EINVERT
                    '     so as to get a CZS that is close to the computation from the physical model.
                    'The rationales for such adjustment include:  different efficiency levels is
                    '     various economies, often not captured by generic matrices (e.g. Japan);
                    '     complete absence of energy data in some cases (e.g. Lesotho), so that
                    '     all values were ultimately calculated.
                    Dim enecoconsistency As Double?, Multerm As Double?
                    For NCOUNT% = 1 To 2000 ' Determine multiplier to reconcile CPFD and CZS
                        'If key = "Philippines" And NCOUNT = 306 Then Stop
                        'Notes: Luxembourg IO coefs for energy very low; need many iterations
                        '       Iteration steps must be small to avoid oscillation
                        'jrs 2025/04/11 using totenprod/ZS again, instead of AppDemand/CZS
                        'jrs 2022/04/06
                        enecoconsistency = totenprod / AMAX(0.0001F, CZS(key)(Ener))
                        'enecoconsistency = AppDemand / AMAX(0.0001F, CZS(key)(Ener)) 'bbh 2024/06/21 replaced above to compare total demand and supply
                        'enecoconsistency = totenprod / AMAX(0.00000001F, CZS(key)(Ener))
                        If enecoconsistency < 1.01 And enecoconsistency > 0.99 Then Exit For
                        Multerm = AMAX(0.995F, Amin(1.005F, enecoconsistency ^ 0.5F))
                        EnMul(key) = CSng(EnMul(key) * Multerm)
                        'If key = "Afghanistan" And Abs(CSng(EnMul(key) - 2.33469462)) < 0.000001 Then Stop
                        EInvert(key, cntx) 'Input is PFD; output is zs
                    Next NCOUNT%
                    'If key = "Ukraine" Then Stop
                    'EnMul(key) = 1 'bbh 2024/05/24 Tested this addition but did not help Vadd of Manu; so have commented out
                    'If key = "Philippines" Then Stop

                    'bbh 2014/11/12 start
                    'Countries with very minimal energy production and fairly high GDP/GDPPC are on knife's edge with
                    '   respect to balance; need to give more cushion, e.g. Luxembourg
                    'jrs 2022/04/06
                    enecoconsistency = totenprod / AMAX(0.0001F, CZS(key)(Ener))
                    'enecoconsistency = totenprod / AMAX(0.00000001F, CZS(key)(Ener))
                    Dim LowerLimit As Single?
                    'jrs 2022/04/06 changed to 0.1, since the seeds and limits are now much smaller for energy production
                    LowerLimit = 0.25
                    'If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.15
                    'bbh 2014/11/20

                    'jrs 2022/04/06 not needed anymore
                    'sgh 2016/09/04 - START
                    'Lower the lower limit for Panama so it doesn't give a message every time the base is rebuilt
                    If key = "Panama" Then
                        LowerLimit = 0.1
                    End If
                    ''sgh 2016/09/04 - END

                    'jrs 2022/04/11
                    'jrs 2022/05/02 If key = "Guinea Bissau" Then
                    If key = sEnergyNoProductionCountry Then
                        LowerLimit = 0
                    End If

                    'mti 2015/09/08 - start
                    'If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.05
                    'jrs 2022/04/06
                    If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.03
                    'If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.005
                    'mti 2015/09/08 - end

                    'If cntx.DevelopmentMode And (enecoconsistency > 5 Or _
                    'enecoconsistency <0.25) Then
                    If cntx.DevelopmentMode And (enecoconsistency > 5 Or
                    enecoconsistency < LowerLimit) Then
                        'bbh 2014/11/12 end
                        msg$ = "The Economic And energy data For " + key +
                                " are Not very consistent:" + enecoconsistency.ToString
                        msg$ = msg$ +
                                "  Model performance may be poor."
                        Debug.Print(msg$)
                    End If


                    '   Used Multipliers to Readjust AMatCountry and put into AMat
                    '   --------------------------------------------------------------

                    'If key = "Oman" Then Stop
                    For LCount% = 1 To cntx.NSec
                        For SCount% = 1 To cntx.NSec
                            '                AMat(key)(LCount%, SCount%) = _
                            '                    AMat(key)(LCount%, SCount%) * IOMatMul(key)(SCount%)
                            'jrs 2025/04/11
                            'if SCount% = Ener Then
                            If LCount% = Ener Then
                                AMat(key)(LCount%, SCount%) =
                                    AMatCountry(key)(LCount%, SCount%) * EnMul(key)
                            Else
                                AMat(key)(LCount%, SCount%) =
                                        AMatCountry(key)(LCount%, SCount%)
                            End If
                            AMat(key)(LCount%, SCount%) =
                                Amin(0.5F, AMat(key)(LCount%, SCount%))
                        Next SCount%
                    Next LCount%

                    'jrs 2025/04/11 to avoid double applying multiplier
                    EnMul(key) = 1

                    'If key = "Taiwan" Then Stop


                    '   Make sure rises in AMAT with EnMul haven't led to negative value added or PFD
                    '   -----------------------------------------------------------------------------

                    Dim RowSum As Single?
                    'jrs 2025/04/11
                    'RowSum = 0
                    For S% = 1 To cntx.NSec
                        'jrs 2025/04/11
                        RowSum = 0
                        For row = 1 To cntx.NSec
                            RowSum = RowSum + AMat(key)(row, S%)
                        Next row
                        If RowSum > 0.95 Then
                            For row = 1 To cntx.NSec
                                AMat(key)(row, S%) = CSng(AMat(key)(row, S%) * 0.95 / RowSum)
                            Next row
                        End If
                    Next S%
                    Dim ColSum As Single?
                    'jrs 2025/04/11
                    'ColSum = 0
                    For row = 1 To cntx.NSec
                        'jrs 2025/04/01
                        ColSum = 0
                        For col = 1 To cntx.NSec
                            ColSum = ColSum + AMat(key)(row, col)
                        Next col
                        If ColSum > 0.95 Then
                            For col = 1 To cntx.NSec
                                AMat(key)(row, col) = CSng(AMat(key)(row, col) * 0.95 / ColSum)
                            Next col
                        End If
                    Next row
                    '  If key = "Armenia" Then Stop


                    '        For S% = 1 To cntx.NSec
                    '            CVADD(key)(S%) = CZS(key)(S%)
                    '            For row = 1 To cntx.NSec
                    ''                AMat(key)(row, S%) = EIOMat(key)(row, S%)
                    '                ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                    '                CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                    '            Next row
                    '
                    '            If CVADD(key)(S%) <= 0.0001 Then
                    '                For NCount% = 1 To 100 ' Determine multiplier for IO matrices
                    '                    CVADD(key)(S%) = CZS(key)(S%)
                    '                    IOMatMul(key)(S%) = IOMatMul(key)(S%) * 0.99
                    '                    For row = 1 To cntx.NSec
                    ''                        AMat(key)(row, S%) = EIOMat(key)(row, S%)
                    '                        AMat(key)(row, S%) = AMat(key)(row, S%) * 0.99
                    '                        ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                    ''                        gSAM(IY - (BeginRun - frm_MainMenu.IFsGUIctrl1.cFirstYear), key, row, S%) = _
                    '                            ints(row, S%)
                    '                        CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                    '                    Next row
                    '                    If CVADD(key)(S%) > 0.0001 Then Exit For
                    '                Next NCount%
                    '            End If
                    '
                    '            If CVADD(key)(S%) <= 0 Then
                    '                If DevelopmentMode$ = True Then
                    '                    msg$ = "The Economic data load for " + key + _
                    '                        " is very faulty.  CVADD(" + Str$(key) + "," + Str$(S%) + ")="
                    '                    msg$ = msg$ + Str$(CVADD(key)(S%)) + _
                    '                        "  We will reset CVADD, but the model performance may be poor."
                    '                    debug.print(msg$)
                    '                End If
                    '                CVADD(key)(S%) = 0.01 * CCGDP(key) ' 'Was setting to .01, but that does not scale
                    '            End If
                    '        Next S%



                    '   Compute intersectoral energy requirements and compare with apparent demand
                    '       If intersectoral alone are substantially greater than apparent total, is problem
                    '   ------------------------------------------------------------------------------------
                    'If key = "Philippines" Then Stop
                    endeminr(key) = 0
                    For S% = 1 To cntx.NSec
                        For row = 1 To cntx.NSec
                            If row = 2 Then
                                ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                                endeminr(key) = endeminr(key) + ints(row, S%)
                            End If
                        Next row
                    Next S%
                    endeminr(key) = endeminr(key) / AppDemand
                    'If key = "Puerto Rico" Then Stop
                    'bbh 2017/10/21 changed limit of 5 below to 6 because Puerto Rico exceeded,
                    '      after allowed greater possible error in apparent energy consumption in
                    '       DataEner because was getting too much gas production in Bangladesh relative
                    '       to IEA data
                    If cntx.DevelopmentMode And endeminr(key) > 6 Then
                        msg$ = "The energy data load for " + key +
                            " is faulty. EnDemInrR = " + endeminr(key).ToString
                        msg$ = msg$ + "  -- the model performance may be poor."

                        If cntx.HistoricMode And endeminr(key) > 20 Then
                            Debug.Print(msg$)
                        ElseIf cntx.HistoricMode Then
                            Debug.Print(msg$)
                        End If
                    End If
                Next

                '   Put energy adjusted IO matrix into IFs.mdb
                '   ------------------------------------------
                Using db2 As IFs2Context = New IFs2Context()
                    If cntx.HistoricMode Then
                        db2.Clear(GetType(IFsIOCoefCalcCountryEnAdjHist))
                        For Each key In cntx.Regionalization.Keys
                            SaveIntsCtryValsToIFsDb(key, FIPSCodes(key), cntx, db2.IFsIOCoefCalcCountryEnAdjHist, AMat)
                        Next
                        db2.Flush()
                    Else
                        db2.Clear(GetType(IFsIOCoefCalcCountryEnAdj))
                        For Each key In cntx.Regionalization.Keys
                            SaveIntsCtryValsToIFsDb(key, FIPSCodes(key), cntx, db2.IFsIOCoefCalcCountryEnAdj, AMat)
                        Next
                        db2.Flush()
                    End If
                End Using
                For Each key In cntx.Regionalization.Keys
                    For LCount% = 1 To cntx.NSec
                        For SCount% = 1 To cntx.NSec
                            AMatCountry(key)(LCount%, SCount%) = AMat(key)(LCount%, SCount%)
                        Next SCount%
                    Next LCount%
                Next

                Dim GDPCalc As Single?, CSum As Single?, SumCS As Single?, RowSumINTS As Single?
                For Each key In cntx.Regionalization.Keys
                    '   At this point have shifted PFD as necessary and recomputed AMAT as necessary
                    '       But VADD is unchanged; could have major descrepancies of energy and/or ag
                    '       ZS/AMAT linkage in those sectors; recompute VADD from ZS/AMAT to avoid
                    '       Recompute Vadd and normalize to GDP
                    '   ------------------------------------
                    'bbh 2024/05/24 Start elimination of block below that was changing CVADD/ValAdd from ZS and new AMAT; need to protect VADD
                    'GDPCalc = 0
                    'If key = "India" Then Stop
                    'For S% = 1 To cntx.NSec
                    '    CVADD(key)(S%) = CZS(key)(S%)
                    '    If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    '    For row = 1 To cntx.NSec
                    '        ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                    '        CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                    '    Next row
                    '    If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    '    GDPCalc = GDPCalc + CVADD(key)(S%)
                    'Next S%
                    'For S% = 1 To cntx.NSec
                    '    CVADD(key)(S%) = CVADD(key)(S%) * CCGDP(key) / AMAX(0.001F, GDPCalc)
                    '    If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    '    ValAdd(key)(S%) = CVADD(key)(S%)
                    'Next S%
                    'bbh 2024/05/24 End elimination of block above that was changing CVADD/ValAdd from ZS and new AMAT; need to protect VADD

                    ' If key = "Iraq" Then Stop

                    '      Use Vadd information on Manuf and Service and PFD info to adjust
                    '       splits of CS, GS, CINVS with respect to manufacturing and services
                    '      Assumption is that VADD data for Manu, Serv so adjust CS,GS,INVS
                    '       splits towards them; but in other sectors, PFD might be better
                    '   ----------------------------------------------------------------------
                    'The above should be done using adjusted IO country coefficients
                    ' If key = "Ukraine" Then Stop
                    'For S% = 1 To cntx.NSec
                    '            CZS(key)(S%) = AMAX(CZS(key)(S%), 0.001 * CCGDP(key))
                    'Next S%
                    'If key = "Afghanistan" Then Stop

                    EInvert(key, cntx) 'Input is CPFD; Output is CZS 'bbh 2024/05/24 add to make all below start with CZS based on starting PFD and new AMAT
                    'If key = "India" Then Stop

                    For S% = 1 To cntx.NSec
                        ZSfromPFD(S%) = CZS(key)(S%)
                    Next S%
                    ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                    If ZSManSerfromPFD <= 0 Then
                        If cntx.DevelopmentMode Then
                            msg$ = "The Manuf and Service Data for " + key +
                            " are very faulty.  ZSManSerfromPFD " + "="
                            msg$ = msg$ + ZSManSerfromPFD.ToString +
                            "  See DataEcon to correct."
                            Debug.Print(msg$)
                        End If
                    End If
                    ZSManShrFromPFD = ZSfromPFD(Manu) / AMAX(0.0001F, ZSManSerfromPFD)

                    For column% = 1 To cntx.NSec
                        'jrs 2019/02/15 ints(key)(column%) = 0!
                        intsp = 0!
                        For row = 1 To cntx.NSec
                            '               AMat(key)(row, column%) = EIOMat(key)(row, column%)
                            intsp = intsp + AMat(key)(row, column%)
                        Next row
                        intsp = Amin(0.95F, intsp)
                        zsfromvadd(column%) = ValAdd(key)(column%) / (1 - intsp)
                    Next column%
                    ZSManSerfromVADD = zsfromvadd(Manu) + zsfromvadd(Serv)
                    ZSManShrFromVADD = zsfromvadd(Manu) / ZSManSerfromVADD 'Target ratio

                    PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                    SPFDVADDGap = PFDVADDGap

                    For NCOUNT% = 1 To 1000
                        If Abs(CSng(PFDVADDGap)) < 0.002 Then Exit For
                        MulSign = 1
                        If PFDVADDGap < 0 Then MulSign = -1
                        TransMax = Amin(CCS(key)(Manu), CCS(key)(Serv))
                        CCS(key)(Manu) = AMAX(0.99F * CCS(key)(Manu),
                CCS(key)(Manu) + 0.01F * MulSign * TransMax)
                        CCS(key)(Serv) = AMAX(0.99F * CCS(key)(Serv),
                CCS(key)(Serv) - 0.01F * MulSign * TransMax)
                        TransMax = Amin(CGS(key)(Manu), CGS(key)(Serv))
                        CGS(key)(Manu) = AMAX(0.99F * CGS(key)(Manu),
                CGS(key)(Manu) + 0.005F * MulSign * TransMax)
                        CGS(key)(Serv) = AMAX(0.99F * CGS(key)(Serv),
                CGS(key)(Serv) - 0.005F * MulSign * TransMax)
                        TransMax = Amin(CINVS(key)(Manu), CINVS(key)(Serv))
                        CINVS(key)(Manu) = AMAX(0.99F * CINVS(key)(Manu),
                CINVS(key)(Manu) + 0.005F * MulSign * TransMax)
                        CINVS(key)(Serv) = AMAX(0.99F * CINVS(key)(Serv),
                CINVS(key)(Serv) - 0.005F * MulSign * TransMax)
                        CPFD(key)(Manu) = CCS(key)(Manu) + CGS(key)(Manu) _
                + CINVS(key)(Manu) + CXS(key)(Manu) - CMS(key)(Manu)
                        CPFD(key)(Serv) = CCS(key)(Serv) + CGS(key)(Serv) _
                + CINVS(key)(Serv) + CXS(key)(Serv) - CMS(key)(Serv)

                        'If key = "Afghanistan" And Abs(CSng(PFDVADDGap)) < 0.004 Then Stop

                        EInvert(key, cntx) 'Input is CPFD; Output is CZS

                        For S% = 1 To cntx.NSec
                            ZSfromPFD(S%) = CZS(key)(S%)
                        Next S%
                        ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                        ZSManShrFromPFD = ZSfromPFD(Manu) / ZSManSerfromPFD

                        PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                        If Abs(CSng(PFDVADDGap)) - Abs(CSng(SPFDVADDGap)) < 0.0001 And
                        Abs(CSng(SPFDVADDGap)) - Abs(CSng(PFDVADDGap)) < 0.0001 Then Exit For
                        SPFDVADDGap = PFDVADDGap

                    Next NCOUNT%

                    'If key = "Iraq" Then Stop
                    'If key = "Oman" Then Stop

                    '   Readjust ZS to be positive and consistent with physical energy information
                    '       This can cause VADDs computed from ZS to be different from known GDP
                    '   --------------------------------------------------------------------------
                    For S% = 1 To cntx.NSec
                        'jrs 2022/04/06 Energy now has lower seeds and limits
                        'If S% = 2 Then
                        'CZS(key)(S%) = AMAX(CZS(key)(S%), 0.001F * CCGDP(key) * 0.0001F)
                        'Else
                        CZS(key)(S%) = AMAX(CZS(key)(S%), 0.001F * CCGDP(key))
                        'End If
                    Next S%
                    '        totenprod = 0
                    '        For e% = 1 To Renew  'Oil, gas, coal, hydro, nuclear, renewable
                    '            totenprod = totenprod + CENP(key)(e%) * WorldEP
                    '            'when switched to 100 index, must keep this in dollars per barrel
                    '        Next e%
                    '        CZS(key)(Ener) = AMAX(CZS(key)(Ener), totenprod)
                    'If key = "Iraq" Then Stop


                    '   Recompute Vadd, normalize to GDP and once again recompute ZS
                    '   ------------------------------------------------------------

                    Dim SumCVADDAdjustment As Single? 'bbh 2024/05/24
                    GDPCalc = 0
                    For S% = 1 To cntx.NSec
                        CVADD(key)(S%) = CZS(key)(S%)  'bbh 2024/05/24 tried deleting this recalc of VADD to protect early calcuations of it
                        'for the Manu and Serv sectors.  But not good idea; must reconcile ZS row and column values, not have VADD dominate
                        For row = 1 To cntx.NSec
                            ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                            CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                        Next row
                        'CVADD(key)(S%) = ValAdd(key)(S%) 'bbh 2024/05/24 added this line to make CVADD = to ValAdd computed very early and balanced
                        'But removed line because very bad early calc for some sectors, e.g. huge Vadd share in materials for Guyana;
                        ' PFD and IO better basis for ZS and VaddCalc than earlier data and estimates in most cases, although relative data VADD values for Manu and Serv
                        'cause shifts in PFD that should bring final values closer to data
                        GDPCalc = GDPCalc + CVADD(key)(S%)
                    Next S%
                    'If key = "Singapore" Then Stop
                    For S% = 1 To cntx.NSec
                        CVADD(key)(S%) = CVADD(key)(S%) * CCGDP(key) / AMAX(0.001F, GDPCalc)
                    Next S%

                    'bbh 2024/05/24 Begin protection of Manu and Serv data values; use of Agri VADD for adjustment
                    'SumCVADDAdjustment = CVADD(key)(4) + CVADD(key)(5) - ValAdd(key)(4) - ValAdd(key)(5)
                    'If CVADD(key)(1) + SumCVADDAdjustment < 0.1 * CVADD(key)(1) Then
                    '    CVADD(key)(1) = CSng(0.1) * CVADD(key)(1)
                    'Else
                    '    CVADD(key)(1) = CVADD(key)(1) + SumCVADDAdjustment
                    'End If
                    'CVADD(key)(4) = ValAdd(key)(4)
                    'CVADD(key)(5) = ValAdd(key)(5)
                    ''If key = "India" Then Stop
                    'GDPCalc = 0
                    'For S% = 1 To cntx.NSec
                    '    GDPCalc = GDPCalc + CVADD(key)(S%)
                    'Next S%
                    'For S% = 1 To cntx.NSec
                    '    CVADD(key)(S%) = CVADD(key)(S%) * CCGDP(key) / AMAX(0.001F, GDPCalc)
                    '    'If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    'Next S%
                    ''If key = "India" Then Stop
                    'bbh 2024/05/24 End protection of Manu and Serv data values

                    For S% = 1 To cntx.NSec
                        For column% = 1 To cntx.NSec
                            intsp = 0!
                            For row = 1 To cntx.NSec
                                intsp = intsp + AMat(key)(row, column%)
                            Next row
                            intsp = Amin(0.95F, intsp)
                            'If key = "Philippines" And column = 2 Then Stop
                            CZS(key)(column%) = CVADD(key)(column%) / (1 - intsp)
                        Next column%
                    Next S%
                    ' If key = "Bangladesh" Then Stop

                    'save VADD here


                    'Recompute CS so as to balance intersectoral flows
                    '   ----------------------------------------------

                    For S% = 1 To cntx.NSec
                        For row = 1 To cntx.NSec
                            ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                        Next row
                    Next S%

                    CSum = 0
                    For S% = 1 To cntx.NSec
                        CZSTotC(S%) = 0
                        CZSTotR(S%) = 0
                        CSum = CSum + CCS(key)(S%)
                    Next S%

                    For S% = 1 To cntx.NSec
                        RowSumINTS = 0
                        For column = 1 To cntx.NSec
                            RowSumINTS = RowSumINTS + ints(S%, column)
                        Next column

                        CZSTotC(S%) = CZSTotC(S%) + CZS(key)(S%) + CMS(key)(S%)
                        CZSTotR(S%) = CZSTotR(S%) + RowSumINTS + CCS(key)(S%) + CGS(key)(S%) +
                CINVS(key)(S%) + CXS(key)(S%)
                    Next S%
                    SumCS = 0
                    For S% = 1 To cntx.NSec
                        CCS(key)(S%) = AMAX(0.1F * CCS(key)(S%), CCS(key)(S%) +
                CZSTotC(S%) - CZSTotR(S%))
                        SumCS = SumCS + CCS(key)(S%)
                    Next S%
                    For S% = 1 To cntx.NSec
                        CCS(key)(S%) = CCS(key)(S%) / SumCS * CSum
                    Next S%
                Next
                'jrs 2025/06/17
                'UpdateLabAfterChangesInVADD(cntx)
                'jrs 2025/07/18
                'UpdateLabWithILO(cntx)
            End Sub

            'jrs 2025/07/31 Try to preserve VADD data when there is available, and only recompute CS, GS, and INVS
            Private Sub InputOutputDataAdjusterNew(cntx As IRebuildFacade)
                'jrs 2007/01/24 changed NR to CCount
                Dim AMat As Dictionary(Of String, Single?(,)) = New Dictionary(Of String, Single?(,))
                AMatCountry = New Dictionary(Of String, Single?(,))
                Dim endeminr As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                For Each key In cntx.Regionalization.Keys
                    Dim VarVals(cntx.NSec, cntx.NSec) As Single?
                    Dim VarVals2(cntx.NSec, cntx.NSec) As Single?
                    Dim Vars(cntx.NSec) As Single?

                    AMat.Add(key, VarVals)
                    AMatCountry.Add(key, VarVals2)
                    EnMul.Add(key, Nothing)
                    endeminr.Add(key, Nothing)
                    IOMatMul.Add(key, Vars)
                Next
                Dim ZSfromPFD() As Single?, zsfromvadd() As Single?, ints(,) As Single?
                ReDim iotab(cntx.NSec, cntx.NSec, cntx.NIOMatrices)
                ReDim ZSfromPFD(cntx.NSec), zsfromvadd(cntx.NSec)
                ReDim ints(cntx.NSec, cntx.NSec)
                'ReDim CZSTotC(200), CZSTotR(200)
                Dim CZSTotC() As Single?, CZSTotR() As Single?
                ReDim CZSTotC(NR), CZSTotR(NR) 'bbh province project change

                '   Read Sectoral Parameters
                '
                '   Read IO Matrices - Generic
                '   --------------------------
                Dim IOMatTbl As IEnumerable(Of IOMatCalc)
                Dim IOMatRow As IOMatCalc
                Dim ThresholdsTbl As IEnumerable(Of IOThrhld)
                Using db2 As IFs2Context = New IFs2Context()
                    Using db As IFsContext = New IFsContext()
                        If cntx.HistoricMode Then
                            IOMatTbl = db2.IOMatricesCalcHist
                            ThresholdsTbl = db.IOThresholdsHist
                        Else
                            IOMatTbl = db2.IOMatricesCalc
                            ThresholdsTbl = db.IOThresholds
                        End If

                        Dim SerRow As Integer, MatrixId As Integer
                        For matrix% = 1 To cntx.NIOMatrices  'Get IO Coeficients
                            MatrixId = matrix
                            For row = 1 To cntx.NSec
                                SerRow = row
                                IOMatRow = IOMatTbl.Where(Function(g) g.Matrix = MatrixId And g.RowSector = SerRow).Single()
                                iotab(row, Agri, matrix%) = CSng(IOMatRow.AGSector)
                                iotab(row, Ener, matrix%) = CSng(IOMatRow.PESector)
                                iotab(row, Mate, matrix%) = CSng(IOMatRow.RMSector)
                                iotab(row, Manu, matrix%) = CSng(IOMatRow.MNSector)
                                iotab(row, Serv, matrix%) = CSng(IOMatRow.SRSector)
                                iotab(row, ICT, matrix%) = CSng(IOMatRow.ICSector)
                            Next row
                        Next matrix%

                        'jrs 2025/03/26
                        'PrintIOTab()

                        '   Read IO Table Thresholds
                        '    -----------------------
                        Dim Mat As Integer = 1
                        For Each xx In ThresholdsTbl
                            iothresh(Mat) = xx.Threshold
                            Mat = Mat + 1
                        Next

                        '   Open IO Matrices - Country
                        '   ---------------------------------------
                        Dim IOCountryTbl As IEnumerable(Of GTAPIOAgg)
                        If cntx.HistoricMode Then
                            IOCountryTbl = db2.IFsIOCoefCalcCountryHist
                        Else
                            IOCountryTbl = db2.IFsIOCoefCalcCountry
                        End If
                        Dim ColumnName As String
                        For Each cntry In IOCountryTbl
                            For LCount% = 1 To cntx.NSec
                                For SCount% = 1 To cntx.NSec
                                    '                If IsNull(AMatCountry(R%, LCount%, SCount%)) Then Stop
                                    ColumnName$ = "Ints" & LCount.ToString.Trim & SCount%.ToString.Trim
                                    Select Case ColumnName$
                                        Case "Ints11"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints11)
                                        Case "Ints12"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints12)
                                        Case "Ints13"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints13)
                                        Case "Ints14"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints14)
                                        Case "Ints15"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints15)
                                        Case "Ints16"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints16)
                                        Case "Ints21"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints21)
                                        Case "Ints22"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints22)
                                        Case "Ints23"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints23)
                                        Case "Ints24"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints24)
                                        Case "Ints25"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints25)
                                        Case "Ints26"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints26)
                                        Case "Ints31"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints31)
                                        Case "Ints32"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints32)
                                        Case "Ints33"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints33)
                                        Case "Ints34"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints34)
                                        Case "Ints35"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints35)
                                        Case "Ints36"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints36)
                                        Case "Ints41"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints41)
                                        Case "Ints42"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints42)
                                        Case "Ints43"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints43)
                                        Case "Ints44"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints44)
                                        Case "Ints45"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints45)
                                        Case "Ints46"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints46)
                                        Case "Ints51"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints51)
                                        Case "Ints52"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints52)
                                        Case "Ints53"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints53)
                                        Case "Ints54"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints54)
                                        Case "Ints55"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints55)
                                        Case "Ints56"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints56)
                                        Case "Ints61"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints61)
                                        Case "Ints62"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints62)
                                        Case "Ints63"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints63)
                                        Case "Ints64"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints64)
                                        Case "Ints65"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints65)
                                        Case "Ints66"
                                            AMatCountry(cntry.Country)(LCount%, SCount%) = CSng(cntry.Ints66)
                                    End Select

                                Next SCount%
                            Next LCount%
                        Next
                    End Using
                End Using

                '   This block reconciles production for final demand and value added
                '       It computes ZS from both and, assuming that value added and the IO
                '           matrix are reasonably good, recomputes PFD components and totals
                '   Compute Production for Final Demand and Invert to get Gross Production
                '   ----------------------------------------------------------------------
                Dim ZSManSerfromPFD As Single?
                Dim ZSManShrFromPFD As Single?
                Dim intsp As Single?
                Dim ZSManSerfromVADD As Single?, ZSManShrFromVADD As Single?, PFDVADDGap As Single?, SPFDVADDGap As Single?
                Dim MulSign As Integer, TransMax As Single?
                Dim msg As String
                For Each key In cntx.Regionalization.Keys
                    'If key = "Taiwan" Then Stop
                    CCGDP.Add(key, 0)
                    For S% = 1 To cntx.NSec
                        CPFD(key)(S%) = CCS(key)(S%) + CGS(key)(S%) + CINVS(key)(S%) + CXS(key)(S%) - CMS(key)(S%)
                        'If key = "India" And S% = Manu Then Stop
                        CCGDP(key) = CCGDP(key) + CPFD(key)(S%)
                        If S% = 6 And CPFD(key)(S%) < 0 Then CPFD(key)(S%) = CSng(CGDP(key) * 0.02) 'bbh 2021/08/04 Djibouti ICT sector messed up
                        If CPFD(key)(S%) < 0 Then CPFD(key)(S%) = CSng(CGDP(key) * 0.005) 'bbh 2024/05/24 India materials was <0, probably also others
                    Next S%
                    'If key = "Ukraine" Then Stop
                    EnMul(key) = 1
                    For LCount% = 1 To cntx.NSec
                        IOMatMul(key)(LCount%) = 1
                    Next LCount%
                    'If key = "Afghanistan" Then Stop
                    EInvert(key, cntx) 'Input is CPFD; Output is CZS
                    'If key = "Ukraine" Then Stop
                    'The above is done using unadjusted IO country coefficients
                    'If key = "Oman" Then Stop

                    For S% = 1 To cntx.NSec
                        ZSfromPFD(S%) = CZS(key)(S%)
                    Next S%
                    ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                    If ZSManSerfromPFD <= 0 Then
                        If cntx.DevelopmentMode Then
                            msg$ = "The Manuf and Service Data for " + key +
                                " are very faulty.  ZSManSerfromPFD " + "="
                            msg$ = msg$ + ZSManSerfromPFD.ToString +
                                "  See DataEcon to correct."
                            Debug.Print(msg$)
                        End If
                    End If
                    ZSManShrFromPFD = ZSfromPFD(Manu) / AMAX(0.0001F, ZSManSerfromPFD)

                    For column% = 1 To cntx.NSec
                        'jrs 2019/02/14 ints(key, column%) = 0!
                        intsp = 0!
                        For row = 1 To cntx.NSec
                            '               AMat(key)( row, column%) = EIOMat(key)( row, column%)
                            intsp = intsp + AMatCountry(key)(row, column%)
                        Next row
                        intsp = Amin(0.95F, intsp)
                        zsfromvadd(column%) = ValAdd(key)(column%) / (1 - intsp)
                    Next column%
                    ZSManSerfromVADD = zsfromvadd(Manu) + zsfromvadd(Serv)
                    ZSManShrFromVADD = zsfromvadd(Manu) / ZSManSerfromVADD 'Target ratio

                    PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                    SPFDVADDGap = PFDVADDGap

                    'jrs 2025/08/04
                    Dim bSkipMatchingProcess As Boolean = False
                    'If key = "China" Then Stop
                    ''jrs 2025/07/31 
                    ''if there's data for VADD Manu and Serv we can avoid this iteration of 1000 steps and prioritize ZS from VADD
                    'If bVaddData(key)(Manu) And bVaddData(key)(Serv) Then
                    '    CZS(key)(Manu) = zsfromvadd(Manu)
                    '    CZS(key)(Serv) = zsfromvadd(Serv)
                    '    'Now from ZS find PFD
                    '    'ZS(S%) = PFD(S%) + ints across row S% in the SAM
                    '    For S% = 1 To cntx.NSec
                    '        'for the Manu and Serv sectors.  But not good idea; must reconcile ZS row and column values, not have VADD dominate
                    '        For row = 1 To cntx.NSec
                    '            'jrs 2025/08/01
                    '            'AMat is not ready at this point, explore -EIOMat(key, row, column%, cntx) which goes to aneg
                    '            'better use AMatCountry(key)(LCount%, SCount%)
                    '            ints(row, S%) = CZS(key)(S%) * AMatCountry(key)(row, S%)
                    '        Next row
                    '    Next S%
                    '    'Manufactures
                    '    Dim NewPFDM As Single?
                    '    NewPFDM = CZS(key)(Manu)
                    '    For S% = 1 To cntx.NSec
                    '        NewPFDM = NewPFDM - ints(Manu, S%)
                    '    Next
                    '    Dim AdjFactM As Single?
                    '    AdjFactM = (NewPFDM - (CXS(key)(Manu) - CMS(key)(Manu))) / (CPFD(key)(Manu) - (CXS(key)(Manu) - CMS(key)(Manu)))

                    '    'Services
                    '    Dim NewPFDS As Single?
                    '    NewPFDS = CZS(key)(Serv)
                    '    For S% = 1 To cntx.NSec
                    '        NewPFDS = NewPFDS - ints(Serv, S%)
                    '    Next
                    '    Dim AdjFactS As Single? = (NewPFDS - (CXS(key)(Serv) - CMS(key)(Serv))) / (CPFD(key)(Serv) - (CXS(key)(Serv) - CMS(key)(Serv)))

                    '    If NewPFDM > 0 And NewPFDS > 0 And AdjFactM > 0 And adjfacts > 0 Then
                    '        CCS(key)(Manu) = CCS(key)(Manu) * AdjFactM
                    '        CGS(key)(Manu) = CGS(key)(Manu) * AdjFactM
                    '        CINVS(key)(Manu) = CINVS(key)(Manu) * AdjFactM
                    '        CPFD(key)(Manu) = CCS(key)(Manu) + CGS(key)(Manu) + CINVS(key)(Manu) + CXS(key)(Manu) - CMS(key)(Manu)

                    '        CCS(key)(Serv) = CCS(key)(Serv) * AdjFactS
                    '        CGS(key)(Serv) = CGS(key)(Serv) * AdjFactS
                    '        CINVS(key)(Serv) = CINVS(key)(Serv) * AdjFactS
                    '        CPFD(key)(Serv) = CCS(key)(Serv) + CGS(key)(Serv) + CINVS(key)(Serv) + CXS(key)(Serv) - CMS(key)(Serv)
                    '        bSkipMatchingProcess = True
                    '    End If
                    'End If

                    'jrs 2025/08/04
                    If Not bSkipMatchingProcess Then
                        For NCOUNT% = 1 To 1000
                            If Abs(CSng(PFDVADDGap)) < 0.02 Then Exit For
                            MulSign = 1
                            If PFDVADDGap < 0 Then MulSign = -1
                            TransMax = Amin(CCS(key)(Manu), CCS(key)(Serv))
                            CCS(key)(Manu) = AMAX(CSng(0.99 * CCS(key)(Manu)),
                            CSng(CCS(key)(Manu) + 0.01 * MulSign * TransMax))
                            CCS(key)(Serv) = AMAX(CSng(0.99 * CCS(key)(Serv)),
                            CSng(CCS(key)(Serv) - 0.01 * MulSign * TransMax))
                            TransMax = Amin(CGS(key)(Manu), CGS(key)(Serv))
                            CGS(key)(Manu) = AMAX(CSng(0.99 * CGS(key)(Manu)),
                            CSng(CGS(key)(Manu) + 0.005 * MulSign * TransMax))
                            CGS(key)(Serv) = AMAX(0.99F * CGS(key)(Serv),
                            CGS(key)(Serv) - 0.005F * MulSign * TransMax)
                            TransMax = Amin(CINVS(key)(Manu), CINVS(key)(Serv))
                            CINVS(key)(Manu) = AMAX(0.99F * CINVS(key)(Manu),
                            CINVS(key)(Manu) + 0.005F * MulSign * TransMax)
                            CINVS(key)(Serv) = AMAX(0.99F * CINVS(key)(Serv),
                            CINVS(key)(Serv) - 0.005F * MulSign * TransMax)
                            CPFD(key)(Manu) = CCS(key)(Manu) + CGS(key)(Manu) _
                            + CINVS(key)(Manu) + CXS(key)(Manu) - CMS(key)(Manu)
                            CPFD(key)(Serv) = CCS(key)(Serv) + CGS(key)(Serv) _
                            + CINVS(key)(Serv) + CXS(key)(Serv) - CMS(key)(Serv)

                            EInvert(key, cntx) 'Input is CPFD; Output is CZS
                            For S% = 1 To cntx.NSec
                                ZSfromPFD(S%) = CZS(key)(S%)
                            Next S%
                            ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                            ZSManShrFromPFD = ZSfromPFD(Manu) / ZSManSerfromPFD

                            PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                            If Abs(CSng(PFDVADDGap)) - Abs(CSng(SPFDVADDGap)) < 0.0005 And
                            Abs(CSng(SPFDVADDGap)) - Abs(CSng(PFDVADDGap)) < 0.0005 Then Exit For
                            SPFDVADDGap = PFDVADDGap

                        Next NCOUNT%

                    End If

                    If key = "Singapore" Then Stop

                    '      Check on Consistency of Raw Energy Data
                    '       with IO Matrix - adjust coefficients
                    '   -----------------------------------------
                    Dim totenprod As Single?, E As Integer
                    totenprod = 0
                    For E = 1 To Renew  'Oil, gas, coal, hydro, nuclear, renewable
                        totenprod = totenprod + CENP(key)(E) * WorldEP
                        'when switched to 100 index, must keep this in dollars per barrel
                        'totenprod = totenprod + CENP(key)(E%) * ENPRI(key)
                    Next E
                    Dim AppDemand As Single?
                    'AppDemand = totenprod + CMS(key)(Ener) - CXS(key)(Ener)
                    AppDemand = totenprod + CMS(key)(Ener) - CXS(key)(Ener) + CCS(key)(Ener) 'bbh 2024/06/21 replaced above after adding energy to HH Consumpption
                    'If key = "Afghanistan" Then Stop
                    '   Do not use (ENM(key) - ENX(key)) * ENPRI(key) because enm and enx computed
                    '       from MS, XS in energy submodel
                    'Process below works by comparing computed CZS, gross production,
                    '     (from EINVERT above, driven by CPFD),
                    '     with total physical production times price.  When there is a descrepancy,
                    '     a multiplier on intersectoral flows is computed iteratively and used
                    '     to change the intersectoral flows in EIOMAT, passing those to EINVERT
                    '     so as to get a CZS that is close to the computation from the physical model.
                    'The rationales for such adjustment include:  different efficiency levels is
                    '     various economies, often not captured by generic matrices (e.g. Japan);
                    '     complete absence of energy data in some cases (e.g. Lesotho), so that
                    '     all values were ultimately calculated.
                    Dim enecoconsistency As Double?, Multerm As Double?
                    For NCOUNT% = 1 To 2000 ' Determine multiplier to reconcile CPFD and CZS
                        'If key = "Philippines" And NCOUNT = 306 Then Stop
                        'Notes: Luxembourg IO coefs for energy very low; need many iterations
                        '       Iteration steps must be small to avoid oscillation
                        'jrs 2025/04/11 using totenprod/ZS again, instead of AppDemand/CZS
                        'jrs 2022/04/06
                        enecoconsistency = totenprod / AMAX(0.0001F, CZS(key)(Ener))
                        'enecoconsistency = AppDemand / AMAX(0.0001F, CZS(key)(Ener)) 'bbh 2024/06/21 replaced above to compare total demand and supply
                        'enecoconsistency = totenprod / AMAX(0.00000001F, CZS(key)(Ener))
                        If enecoconsistency < 1.01 And enecoconsistency > 0.99 Then Exit For
                        Multerm = AMAX(0.995F, Amin(1.005F, enecoconsistency ^ 0.5F))
                        EnMul(key) = CSng(EnMul(key) * Multerm)
                        'If key = "Afghanistan" And Abs(CSng(EnMul(key) - 2.33469462)) < 0.000001 Then Stop
                        EInvert(key, cntx) 'Input is PFD; output is zs
                    Next NCOUNT%
                    'If key = "Ukraine" Then Stop
                    'EnMul(key) = 1 'bbh 2024/05/24 Tested this addition but did not help Vadd of Manu; so have commented out
                    'If key = "Philippines" Then Stop

                    'bbh 2014/11/12 start
                    'Countries with very minimal energy production and fairly high GDP/GDPPC are on knife's edge with
                    '   respect to balance; need to give more cushion, e.g. Luxembourg
                    'jrs 2022/04/06
                    enecoconsistency = totenprod / AMAX(0.0001F, CZS(key)(Ener))
                    'enecoconsistency = totenprod / AMAX(0.00000001F, CZS(key)(Ener))
                    Dim LowerLimit As Single?
                    'jrs 2022/04/06 changed to 0.1, since the seeds and limits are now much smaller for energy production
                    LowerLimit = 0.25
                    'If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.15
                    'bbh 2014/11/20

                    'jrs 2022/04/06 not needed anymore
                    'sgh 2016/09/04 - START
                    'Lower the lower limit for Panama so it doesn't give a message every time the base is rebuilt
                    If key = "Panama" Then
                        LowerLimit = 0.1
                    End If
                    ''sgh 2016/09/04 - END

                    'jrs 2022/04/11
                    'jrs 2022/05/02 If key = "Guinea Bissau" Then
                    If key = sEnergyNoProductionCountry Then
                        LowerLimit = 0
                    End If

                    'mti 2015/09/08 - start
                    'If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.05
                    'jrs 2022/04/06
                    If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.03
                    'If totenprod / WorldEP < 0.001 And CGDPPCP(key) > 30 Then LowerLimit = 0.005
                    'mti 2015/09/08 - end

                    'If cntx.DevelopmentMode And (enecoconsistency > 5 Or _
                    'enecoconsistency <0.25) Then
                    If cntx.DevelopmentMode And (enecoconsistency > 5 Or
                    enecoconsistency < LowerLimit) Then
                        'bbh 2014/11/12 end
                        msg$ = "The Economic and energy data for " + key +
                                " are not very consistent:" + enecoconsistency.ToString
                        msg$ = msg$ +
                                "  Model performance may be poor."
                        Debug.Print(msg$)
                    End If


                    '   Used Multipliers to Readjust AMatCountry and put into AMat
                    '   --------------------------------------------------------------

                    'If key = "Oman" Then Stop
                    For LCount% = 1 To cntx.NSec
                        For SCount% = 1 To cntx.NSec
                            '                AMat(key)(LCount%, SCount%) = _
                            '                    AMat(key)(LCount%, SCount%) * IOMatMul(key)(SCount%)
                            'jrs 2025/04/11
                            'if SCount% = Ener Then
                            If LCount% = Ener Then
                                AMat(key)(LCount%, SCount%) =
                                    AMatCountry(key)(LCount%, SCount%) * EnMul(key)
                            Else
                                AMat(key)(LCount%, SCount%) =
                                        AMatCountry(key)(LCount%, SCount%)
                            End If
                            AMat(key)(LCount%, SCount%) =
                                Amin(0.5F, AMat(key)(LCount%, SCount%))
                        Next SCount%
                    Next LCount%

                    'jrs 2025/04/11 to avoid double applying multiplier
                    EnMul(key) = 1

                    'If key = "Taiwan" Then Stop


                    '   Make sure rises in AMAT with EnMul haven't led to negative value added or PFD
                    '   -----------------------------------------------------------------------------

                    Dim RowSum As Single?
                    'jrs 2025/04/11
                    'RowSum = 0
                    For S% = 1 To cntx.NSec
                        'jrs 2025/04/11
                        RowSum = 0
                        For row = 1 To cntx.NSec
                            RowSum = RowSum + AMat(key)(row, S%)
                        Next row
                        If RowSum > 0.95 Then
                            For row = 1 To cntx.NSec
                                AMat(key)(row, S%) = CSng(AMat(key)(row, S%) * 0.95 / RowSum)
                            Next row
                        End If
                    Next S%
                    Dim ColSum As Single?
                    'jrs 2025/04/11
                    'ColSum = 0
                    For row = 1 To cntx.NSec
                        'jrs 2025/04/01
                        ColSum = 0
                        For col = 1 To cntx.NSec
                            ColSum = ColSum + AMat(key)(row, col)
                        Next col
                        If ColSum > 0.95 Then
                            For col = 1 To cntx.NSec
                                AMat(key)(row, col) = CSng(AMat(key)(row, col) * 0.95 / ColSum)
                            Next col
                        End If
                    Next row
                    '  If key = "Armenia" Then Stop


                    '        For S% = 1 To cntx.NSec
                    '            CVADD(key)(S%) = CZS(key)(S%)
                    '            For row = 1 To cntx.NSec
                    ''                AMat(key)(row, S%) = EIOMat(key)(row, S%)
                    '                ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                    '                CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                    '            Next row
                    '
                    '            If CVADD(key)(S%) <= 0.0001 Then
                    '                For NCount% = 1 To 100 ' Determine multiplier for IO matrices
                    '                    CVADD(key)(S%) = CZS(key)(S%)
                    '                    IOMatMul(key)(S%) = IOMatMul(key)(S%) * 0.99
                    '                    For row = 1 To cntx.NSec
                    ''                        AMat(key)(row, S%) = EIOMat(key)(row, S%)
                    '                        AMat(key)(row, S%) = AMat(key)(row, S%) * 0.99
                    '                        ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                    ''                        gSAM(IY - (BeginRun - frm_MainMenu.IFsGUIctrl1.cFirstYear), key, row, S%) = _
                    '                            ints(row, S%)
                    '                        CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                    '                    Next row
                    '                    If CVADD(key)(S%) > 0.0001 Then Exit For
                    '                Next NCount%
                    '            End If
                    '
                    '            If CVADD(key)(S%) <= 0 Then
                    '                If DevelopmentMode$ = True Then
                    '                    msg$ = "The Economic data load for " + key + _
                    '                        " is very faulty.  CVADD(" + Str$(key) + "," + Str$(S%) + ")="
                    '                    msg$ = msg$ + Str$(CVADD(key)(S%)) + _
                    '                        "  We will reset CVADD, but the model performance may be poor."
                    '                    debug.print(msg$)
                    '                End If
                    '                CVADD(key)(S%) = 0.01 * CCGDP(key) ' 'Was setting to .01, but that does not scale
                    '            End If
                    '        Next S%



                    '   Compute intersectoral energy requirements and compare with apparent demand
                    '       If intersectoral alone are substantially greater than apparent total, is problem
                    '   ------------------------------------------------------------------------------------
                    'If key = "Philippines" Then Stop
                    endeminr(key) = 0
                    For S% = 1 To cntx.NSec
                        For row = 1 To cntx.NSec
                            If row = 2 Then
                                ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                                endeminr(key) = endeminr(key) + ints(row, S%)
                            End If
                        Next row
                    Next S%
                    endeminr(key) = endeminr(key) / AppDemand
                    'If key = "Puerto Rico" Then Stop
                    'bbh 2017/10/21 changed limit of 5 below to 6 because Puerto Rico exceeded,
                    '      after allowed greater possible error in apparent energy consumption in
                    '       DataEner because was getting too much gas production in Bangladesh relative
                    '       to IEA data
                    If cntx.DevelopmentMode And endeminr(key) > 6 Then
                        msg$ = "The energy data load for " + key +
                            " is faulty. EnDemInrR = " + endeminr(key).ToString
                        msg$ = msg$ + "  -- the model performance may be poor."

                        If cntx.HistoricMode And endeminr(key) > 20 Then
                            Debug.Print(msg$)
                        ElseIf cntx.HistoricMode Then
                            Debug.Print(msg$)
                        End If
                    End If
                Next

                '   Put energy adjusted IO matrix into IFs.mdb
                '   ------------------------------------------
                Using db2 As IFs2Context = New IFs2Context()
                    If cntx.HistoricMode Then
                        db2.Clear(GetType(IFsIOCoefCalcCountryEnAdjHist))
                        For Each key In cntx.Regionalization.Keys
                            SaveIntsCtryValsToIFsDb(key, FIPSCodes(key), cntx, db2.IFsIOCoefCalcCountryEnAdjHist, AMat)
                        Next
                        db2.Flush()
                    Else
                        db2.Clear(GetType(IFsIOCoefCalcCountryEnAdj))
                        For Each key In cntx.Regionalization.Keys
                            SaveIntsCtryValsToIFsDb(key, FIPSCodes(key), cntx, db2.IFsIOCoefCalcCountryEnAdj, AMat)
                        Next
                        db2.Flush()
                    End If
                End Using
                For Each key In cntx.Regionalization.Keys
                    For LCount% = 1 To cntx.NSec
                        For SCount% = 1 To cntx.NSec
                            AMatCountry(key)(LCount%, SCount%) = AMat(key)(LCount%, SCount%)
                        Next SCount%
                    Next LCount%
                Next

                Dim GDPCalc As Single?, CSum As Single?, SumCS As Single?, RowSumINTS As Single?
                For Each key In cntx.Regionalization.Keys
                    '   At this point have shifted PFD as necessary and recomputed AMAT as necessary
                    '       But VADD is unchanged; could have major descrepancies of energy and/or ag
                    '       ZS/AMAT linkage in those sectors; recompute VADD from ZS/AMAT to avoid
                    '       Recompute Vadd and normalize to GDP
                    '   ------------------------------------
                    'bbh 2024/05/24 Start elimination of block below that was changing CVADD/ValAdd from ZS and new AMAT; need to protect VADD
                    'GDPCalc = 0
                    'If key = "India" Then Stop
                    'For S% = 1 To cntx.NSec
                    '    CVADD(key)(S%) = CZS(key)(S%)
                    '    If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    '    For row = 1 To cntx.NSec
                    '        ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                    '        CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                    '    Next row
                    '    If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    '    GDPCalc = GDPCalc + CVADD(key)(S%)
                    'Next S%
                    'For S% = 1 To cntx.NSec
                    '    CVADD(key)(S%) = CVADD(key)(S%) * CCGDP(key) / AMAX(0.001F, GDPCalc)
                    '    If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    '    ValAdd(key)(S%) = CVADD(key)(S%)
                    'Next S%
                    'bbh 2024/05/24 End elimination of block above that was changing CVADD/ValAdd from ZS and new AMAT; need to protect VADD

                    ' If key = "Iraq" Then Stop

                    '      Use Vadd information on Manuf and Service and PFD info to adjust
                    '       splits of CS, GS, CINVS with respect to manufacturing and services
                    '      Assumption is that VADD data for Manu, Serv so adjust CS,GS,INVS
                    '       splits towards them; but in other sectors, PFD might be better
                    '   ----------------------------------------------------------------------
                    'The above should be done using adjusted IO country coefficients
                    ' If key = "Ukraine" Then Stop
                    'For S% = 1 To cntx.NSec
                    '            CZS(key)(S%) = AMAX(CZS(key)(S%), 0.001 * CCGDP(key))
                    'Next S%
                    'If key = "Afghanistan" Then Stop

                    EInvert(key, cntx) 'Input is CPFD; Output is CZS 'bbh 2024/05/24 add to make all below start with CZS based on starting PFD and new AMAT
                    'If key = "India" Then Stop

                    For S% = 1 To cntx.NSec
                        ZSfromPFD(S%) = CZS(key)(S%)
                    Next S%
                    ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                    If ZSManSerfromPFD <= 0 Then
                        If cntx.DevelopmentMode Then
                            msg$ = "The Manuf and Service Data for " + key +
                            " are very faulty.  ZSManSerfromPFD " + "="
                            msg$ = msg$ + ZSManSerfromPFD.ToString +
                            "  See DataEcon to correct."
                            Debug.Print(msg$)
                        End If
                    End If
                    ZSManShrFromPFD = ZSfromPFD(Manu) / AMAX(0.0001F, ZSManSerfromPFD)

                    For column% = 1 To cntx.NSec
                        'jrs 2019/02/15 ints(key)(column%) = 0!
                        intsp = 0!
                        For row = 1 To cntx.NSec
                            '               AMat(key)(row, column%) = EIOMat(key)(row, column%)
                            intsp = intsp + AMat(key)(row, column%)
                        Next row
                        intsp = Amin(0.95F, intsp)
                        zsfromvadd(column%) = ValAdd(key)(column%) / (1 - intsp)
                    Next column%
                    ZSManSerfromVADD = zsfromvadd(Manu) + zsfromvadd(Serv)
                    ZSManShrFromVADD = zsfromvadd(Manu) / ZSManSerfromVADD 'Target ratio

                    PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                    SPFDVADDGap = PFDVADDGap

                    'jrs 2025/08/04
                    Dim bSkipMatchingProcess As Boolean = False
                    'If key = "China" Then Stop
                    'jrs 2025/07/31 
                    'if there's data for VADD Manu and Serv we can avoid this iteration of 1000 steps and prioritize ZS from VADD
                    If bVaddData(key)(Manu) And bVaddData(key)(Serv) Then
                        For S% = 1 To cntx.NSec
                            CZS(key)(S%) = zsfromvadd(S%)
                        Next
                        'Now from ZS find PFD
                        'ZS(S%) = PFD(S%) + ints across row S% in the SAM
                        For S% = 1 To cntx.NSec
                            'for the Manu and Serv sectors.  But not good idea; must reconcile ZS row and column values, not have VADD dominate
                            For row = 1 To cntx.NSec
                                ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                            Next row
                        Next S%

                        Dim NewPFD(cntx.NSec) As Single?
                        Dim bNewPFD As Boolean = True
                        For row = 1 To cntx.NSec
                            NewPFD(row) = CZS(key)(row)
                            ints(row, 0) = 0
                            For S% = 1 To cntx.NSec
                                NewPFD(row) = NewPFD(row) - ints(row, S%)
                                ints(row, 0) = ints(row, 0) + ints(row, S%)
                            Next
                            'jrs 2025/08/14
                            'Final Demand Can be Negative if Imports are much higher than exports
                            'example of China in Energy
                            'If NewPFD(row) < 0 Then
                            '    bNewPFD = False
                            '    Exit For
                            'End If
                        Next

                        Dim AdjFact(cntx.NSec) As Single?
                        Dim bAdjFact As Boolean = True
                        If bNewPFD Then
                            For S% = 1 To cntx.NSec
                                AdjFact(S%) = (NewPFD(S%) - (CXS(key)(S%) - CMS(key)(S%))) / (CPFD(key)(S%) - (CXS(key)(S%) - CMS(key)(S%)))
                                If AdjFact(S%) < 0 Then
                                    'Adding more imports would be too complicated because there needs to be global normalization between imports and exports
                                    'So the other thing to change is the intersectoral flows
                                    Dim NewInts As Single?
                                    'PFD = CZS - INTS
                                    'INTS = CZS - PFD
                                    NewInts = CZS(key)(S%) - CPFD(key)(S%)
                                    For col = 1 To cntx.NSec
                                        AMat(key)(S%, col) = AMat(key)(S%, col) * NewInts / ints(S%, 0)
                                        ints(S%, col) = CZS(key)(col) * AMat(key)(S%, col)
                                    Next col
                                    'Also take into account the PFD has a lower limit of -1000 which impact China Materials
                                    AdjFact(S%) = 1
                                    'bAdjFact = False
                                    'Exit For
                                End If
                            Next
                        End If

                        If bNewPFD And bAdjFact Then
                            For S% = 1 To cntx.NSec
                                CCS(key)(S%) = CCS(key)(S%) * AdjFact(S%)
                                CGS(key)(S%) = CGS(key)(S%) * AdjFact(S%)
                                CINVS(key)(S%) = CINVS(key)(S%) * AdjFact(S%)
                                CPFD(key)(S%) = CCS(key)(S%) + CGS(key)(S%) + CINVS(key)(S%) + CXS(key)(S%) - CMS(key)(S%)
                            Next

                            'this is not necessary everything matches
                            'EInvert(key, cntx)

                            bSkipMatchingProcess = True
                        End If
                    End If

                    'jrs 2025/08/04
                    If Not bSkipMatchingProcess Then
                        For NCOUNT% = 1 To 1000
                            If Abs(CSng(PFDVADDGap)) < 0.002 Then Exit For
                            MulSign = 1
                            If PFDVADDGap < 0 Then MulSign = -1
                            TransMax = Amin(CCS(key)(Manu), CCS(key)(Serv))
                            CCS(key)(Manu) = AMAX(0.99F * CCS(key)(Manu),
                            CCS(key)(Manu) + 0.01F * MulSign * TransMax)
                            CCS(key)(Serv) = AMAX(0.99F * CCS(key)(Serv),
                            CCS(key)(Serv) - 0.01F * MulSign * TransMax)
                            TransMax = Amin(CGS(key)(Manu), CGS(key)(Serv))
                            CGS(key)(Manu) = AMAX(0.99F * CGS(key)(Manu),
                            CGS(key)(Manu) + 0.005F * MulSign * TransMax)
                            CGS(key)(Serv) = AMAX(0.99F * CGS(key)(Serv),
                            CGS(key)(Serv) - 0.005F * MulSign * TransMax)
                            TransMax = Amin(CINVS(key)(Manu), CINVS(key)(Serv))
                            CINVS(key)(Manu) = AMAX(0.99F * CINVS(key)(Manu),
                            CINVS(key)(Manu) + 0.005F * MulSign * TransMax)
                            CINVS(key)(Serv) = AMAX(0.99F * CINVS(key)(Serv),
                            CINVS(key)(Serv) - 0.005F * MulSign * TransMax)
                            CPFD(key)(Manu) = CCS(key)(Manu) + CGS(key)(Manu) _
                            + CINVS(key)(Manu) + CXS(key)(Manu) - CMS(key)(Manu)
                            CPFD(key)(Serv) = CCS(key)(Serv) + CGS(key)(Serv) _
                            + CINVS(key)(Serv) + CXS(key)(Serv) - CMS(key)(Serv)

                            'If key = "Afghanistan" And Abs(CSng(PFDVADDGap)) < 0.004 Then Stop

                            EInvert(key, cntx) 'Input is CPFD; Output is CZS

                            For S% = 1 To cntx.NSec
                                ZSfromPFD(S%) = CZS(key)(S%)
                            Next S%
                            ZSManSerfromPFD = ZSfromPFD(Manu) + ZSfromPFD(Serv)
                            ZSManShrFromPFD = ZSfromPFD(Manu) / ZSManSerfromPFD

                            PFDVADDGap = ZSManShrFromVADD - ZSManShrFromPFD 'Gap to correct
                            If Abs(CSng(PFDVADDGap)) - Abs(CSng(SPFDVADDGap)) < 0.0001 And
                            Abs(CSng(SPFDVADDGap)) - Abs(CSng(PFDVADDGap)) < 0.0001 Then Exit For
                            SPFDVADDGap = PFDVADDGap

                        Next NCOUNT%

                    End If

                    'If key = "Iraq" Then Stop
                    'If key = "Oman" Then Stop

                    '   Readjust ZS to be positive and consistent with physical energy information
                    '       This can cause VADDs computed from ZS to be different from known GDP
                    '   --------------------------------------------------------------------------
                    For S% = 1 To cntx.NSec
                        'jrs 2022/04/06 Energy now has lower seeds and limits
                        'If S% = 2 Then
                        'CZS(key)(S%) = AMAX(CZS(key)(S%), 0.001F * CCGDP(key) * 0.0001F)
                        'Else
                        CZS(key)(S%) = AMAX(CZS(key)(S%), 0.001F * CCGDP(key))
                        'End If
                    Next S%
                    '        totenprod = 0
                    '        For e% = 1 To Renew  'Oil, gas, coal, hydro, nuclear, renewable
                    '            totenprod = totenprod + CENP(key)(e%) * WorldEP
                    '            'when switched to 100 index, must keep this in dollars per barrel
                    '        Next e%
                    '        CZS(key)(Ener) = AMAX(CZS(key)(Ener), totenprod)
                    'If key = "Iraq" Then Stop


                    '   Recompute Vadd, normalize to GDP and once again recompute ZS
                    '   ------------------------------------------------------------

                    Dim SumCVADDAdjustment As Single? 'bbh 2024/05/24
                    GDPCalc = 0
                    For S% = 1 To cntx.NSec
                        CVADD(key)(S%) = CZS(key)(S%)  'bbh 2024/05/24 tried deleting this recalc of VADD to protect early calcuations of it
                        'for the Manu and Serv sectors.  But not good idea; must reconcile ZS row and column values, not have VADD dominate
                        For row = 1 To cntx.NSec
                            ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                            CVADD(key)(S%) = CVADD(key)(S%) - ints(row, S%)
                        Next row
                        'CVADD(key)(S%) = ValAdd(key)(S%) 'bbh 2024/05/24 added this line to make CVADD = to ValAdd computed very early and balanced
                        'But removed line because very bad early calc for some sectors, e.g. huge Vadd share in materials for Guyana;
                        ' PFD and IO better basis for ZS and VaddCalc than earlier data and estimates in most cases, although relative data VADD values for Manu and Serv
                        'cause shifts in PFD that should bring final values closer to data
                        GDPCalc = GDPCalc + CVADD(key)(S%)
                    Next S%
                    'If key = "Afghanistan" Then Stop
                    For S% = 1 To cntx.NSec
                        CVADD(key)(S%) = CVADD(key)(S%) * CCGDP(key) / AMAX(0.001F, GDPCalc)
                    Next S%

                    'bbh 2024/05/24 Begin protection of Manu and Serv data values; use of Agri VADD for adjustment
                    'SumCVADDAdjustment = CVADD(key)(4) + CVADD(key)(5) - ValAdd(key)(4) - ValAdd(key)(5)
                    'If CVADD(key)(1) + SumCVADDAdjustment < 0.1 * CVADD(key)(1) Then
                    '    CVADD(key)(1) = CSng(0.1) * CVADD(key)(1)
                    'Else
                    '    CVADD(key)(1) = CVADD(key)(1) + SumCVADDAdjustment
                    'End If
                    'CVADD(key)(4) = ValAdd(key)(4)
                    'CVADD(key)(5) = ValAdd(key)(5)
                    ''If key = "India" Then Stop
                    'GDPCalc = 0
                    'For S% = 1 To cntx.NSec
                    '    GDPCalc = GDPCalc + CVADD(key)(S%)
                    'Next S%
                    'For S% = 1 To cntx.NSec
                    '    CVADD(key)(S%) = CVADD(key)(S%) * CCGDP(key) / AMAX(0.001F, GDPCalc)
                    '    'If key = "India" And (S% = 4 Or S% = 5) Then Stop
                    'Next S%
                    ''If key = "India" Then Stop
                    'bbh 2024/05/24 End protection of Manu and Serv data values

                    For S% = 1 To cntx.NSec
                        For column% = 1 To cntx.NSec
                            intsp = 0!
                            For row = 1 To cntx.NSec
                                intsp = intsp + AMat(key)(row, column%)
                            Next row
                            intsp = Amin(0.95F, intsp)
                            'If key = "Philippines" And column = 2 Then Stop
                            CZS(key)(column%) = CVADD(key)(column%) / (1 - intsp)
                        Next column%
                    Next S%
                    ' If key = "Bangladesh" Then Stop

                    'save VADD here


                    'Recompute CS so as to balance intersectoral flows
                    '   ----------------------------------------------

                    For S% = 1 To cntx.NSec
                        For row = 1 To cntx.NSec
                            ints(row, S%) = CZS(key)(S%) * AMat(key)(row, S%)
                        Next row
                    Next S%

                    CSum = 0
                    For S% = 1 To cntx.NSec
                        CZSTotC(S%) = 0
                        CZSTotR(S%) = 0
                        CSum = CSum + CCS(key)(S%)
                    Next S%

                    For S% = 1 To cntx.NSec
                        RowSumINTS = 0
                        For column = 1 To cntx.NSec
                            RowSumINTS = RowSumINTS + ints(S%, column)
                        Next column

                        CZSTotC(S%) = CZSTotC(S%) + CZS(key)(S%) + CMS(key)(S%)
                        CZSTotR(S%) = CZSTotR(S%) + RowSumINTS + CCS(key)(S%) + CGS(key)(S%) +
                CINVS(key)(S%) + CXS(key)(S%)
                    Next S%
                    SumCS = 0
                    For S% = 1 To cntx.NSec
                        CCS(key)(S%) = AMAX(0.1F * CCS(key)(S%), CCS(key)(S%) +
                CZSTotC(S%) - CZSTotR(S%))
                        SumCS = SumCS + CCS(key)(S%)
                    Next S%
                    For S% = 1 To cntx.NSec
                        CCS(key)(S%) = CCS(key)(S%) / SumCS * CSum
                    Next S%
                Next
                'jrs 2025/06/17
                'UpdateLabAfterChangesInVADD(cntx)
                'jrs 2025/07/18
                'UpdateLabWithILO(cntx)
            End Sub


            'jrs 2025/07/24 added sCtry parameter
            'Consider adding Unemployment so that the original values are preserved, but maybe not necessary.
            'jrs 2025/07/18
            Private Sub UpdateLabWithILO(cntx As IRebuildFacade, sCtry As String)
                'Want to update CLABEMPS to match ILO data for 3 sectors, the other 3 should be adjusted accordingly
                Dim Diff As Single?, LabsTot As Single?
                'For each country
                'For Each sCtry In cntx.Regionalization.sCtrys
                'If sCtry = "Japan" Then Stop
                Diff = 0
                'Try Agriculture
                If ILOLabAg(sCtry).HasValue Then
                    LabsTot = CLABEMPS(sCtry)(Agri, Unskilled) + CLABEMPS(sCtry)(Agri, Skilled)
                    Diff = ILOLabAg(sCtry) - LabsTot
                    If LabsTot > 0 Then
                        CLABEMPS(sCtry)(Agri, Unskilled) = ILOLabAg(sCtry) * CLABEMPS(sCtry)(Agri, Unskilled) / LabsTot
                        CLABEMPS(sCtry)(Agri, Skilled) = ILOLabAg(sCtry) * CLABEMPS(sCtry)(Agri, Skilled) / LabsTot
                    End If
                End If
                'Try Manufactures
                If ILOLabManu(sCtry).HasValue Then
                    LabsTot = CLABEMPS(sCtry)(Manu, Unskilled) + CLABEMPS(sCtry)(Manu, Skilled)
                    Diff = Diff + ILOLabManu(sCtry) - LabsTot
                    If LabsTot > 0 Then
                        CLABEMPS(sCtry)(Manu, Unskilled) = ILOLabManu(sCtry) * CLABEMPS(sCtry)(Manu, Unskilled) / LabsTot
                        CLABEMPS(sCtry)(Manu, Skilled) = ILOLabManu(sCtry) * CLABEMPS(sCtry)(Manu, Skilled) / LabsTot
                    End If
                End If
                'Try Services
                If ILOLabSer(sCtry).HasValue Then
                    LabsTot = CLABEMPS(sCtry)(Serv, Unskilled) + CLABEMPS(sCtry)(Serv, Skilled)
                    Diff = Diff + ILOLabSer(sCtry) - LabsTot
                    If LabsTot > 0 Then
                        CLABEMPS(sCtry)(Manu, Unskilled) = ILOLabManu(sCtry) * CLABEMPS(sCtry)(Manu, Unskilled) / LabsTot
                        CLABEMPS(sCtry)(Manu, Skilled) = ILOLabManu(sCtry) * CLABEMPS(sCtry)(Manu, Skilled) / LabsTot
                    End If
                End If
                'if have changed, need to adjust other sectors
                If Diff <> 0 Then
                    LabsTot = CLABEMPS(sCtry)(Ener, Unskilled) + CLABEMPS(sCtry)(Ener, Skilled)
                    LabsTot = LabsTot + CLABEMPS(sCtry)(Mate, Unskilled) + CLABEMPS(sCtry)(Mate, Skilled)
                    LabsTot = LabsTot + CLABEMPS(sCtry)(ICT, Unskilled) + CLABEMPS(sCtry)(ICT, Skilled)

                    If LabsTot > 0 Then
                        CLABEMPS(sCtry)(Ener, Unskilled) = CSng(AMAX(CLABEMPS(sCtry)(Ener, Unskilled) - Diff * CLABEMPS(sCtry)(Ener, Unskilled) / LabsTot, 0.000001))
                        CLABEMPS(sCtry)(Ener, Skilled) = CSng(AMAX(CLABEMPS(sCtry)(Ener, Skilled) - Diff * CLABEMPS(sCtry)(Ener, Skilled) / LabsTot, 0.000001))
                        CLABEMPS(sCtry)(Mate, Unskilled) = CSng(AMAX(CLABEMPS(sCtry)(Mate, Unskilled) - Diff * CLABEMPS(sCtry)(Mate, Unskilled) / LabsTot, 0.000001))
                        CLABEMPS(sCtry)(Mate, Skilled) = CSng(AMAX(CLABEMPS(sCtry)(Mate, Skilled) - Diff * CLABEMPS(sCtry)(Mate, Skilled) / LabsTot, 0.000001))
                        CLABEMPS(sCtry)(ICT, Unskilled) = CSng(AMAX(CLABEMPS(sCtry)(ICT, Unskilled) - Diff * CLABEMPS(sCtry)(ICT, Unskilled) / LabsTot, 0.000001))
                        CLABEMPS(sCtry)(ICT, Skilled) = CSng(AMAX(CLABEMPS(sCtry)(ICT, Skilled) - Diff * CLABEMPS(sCtry)(ICT, Skilled) / LabsTot, 0.000001))
                    End If
                End If
                'Next
            End Sub


            'Trying to protect GTAP productivity by changing labor in Manufactures and Services, after having changed VADD
            Private Sub UpdateLabAfterChangesInVADD(cntx As IRebuildFacade)
                'Want to preserve number of people, just want to switch from one sector to the other
                'For each country
                For Each key In cntx.Regionalization.Keys
                    'If key = "Japan" Then Stop
                    'CVADD(Manu)/CLABEMPS(Manu)/CVADD(Ser)/CLABEMPS(Ser) < CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)
                    'Only when Productivity Manu/Ser is lower than stated in GTAP
                    CLABEMPS(key)(Manu, NSkill) = CLABEMPS(key)(Manu, Unskilled) + CLABEMPS(key)(Manu, Skilled)
                    CLABEMPS(key)(Serv, NSkill) = CLABEMPS(key)(Serv, Unskilled) + CLABEMPS(key)(Serv, Skilled)
                    If CVADD(key)(Manu) / CLABEMPS(key)(Manu, NSkill) / CVADD(key)(Serv) / CLABEMPS(key)(Serv, NSkill) < CGTAPLabProductivity(key)(Manu) / CGTAPLabProductivity(key)(Serv) Then
                        'Need to move people from CLABEMPS(Manu) to CLABEMPS(Ser)
                        'CVADD(Manu)/(CLABEMPS(Manu)-X)/CVADD(Ser)/(CLABEMPS(Ser)+X) = CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)
                        '1/(CLABEMPS(Manu)-X)/1/(CLABEMPS(Ser)+X) = CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu)
                        '(CLABEMPS(Ser)+X)/(CLABEMPS(Manu)-X) = CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu)
                        '(CLABEMPS(Ser)+X) = CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu) * (CLABEMPS(Manu)-X)
                        'X = CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu) * (CLABEMPS(Manu)-X) - CLABEMPS(Ser)
                        'X (1+CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu)) = CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu) * CLABEMPS(Manu) - CLABEMPS(Ser)
                        'X  = (CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu) * CLABEMPS(Manu) - CLABEMPS(Ser)) / (1+CGTAPLabProductivity(Manu)/CGTAPLabProductivity(Serv)*CVADD(Ser)/CVADD(Manu))
                        Dim X As Single?
                        X = (CGTAPLabProductivity(key)(Manu) / CGTAPLabProductivity(key)(Serv) * CVADD(key)(Serv) / CVADD(key)(Manu) *
                        CLABEMPS(key)(Manu, NSkill) - CLABEMPS(key)(Serv, NSkill)) / (1 + CGTAPLabProductivity(key)(Manu) / CGTAPLabProductivity(key)(Serv) * CVADD(key)(Serv) / CVADD(key)(Manu))

                        If X < 0.9 * CLABEMPS(key)(Manu, NSkill) Then
                            CLABEMPS(key)(Manu, Unskilled) = CLABEMPS(key)(Manu, Unskilled) - X * CLABEMPS(key)(Manu, Unskilled) / CLABEMPS(key)(Manu, NSkill)
                            CLABEMPS(key)(Manu, Skilled) = CLABEMPS(key)(Manu, Skilled) - X * CLABEMPS(key)(Manu, Skilled) / CLABEMPS(key)(Manu, NSkill)
                            CLABEMPS(key)(Manu, NSkill) = CLABEMPS(key)(Manu, Unskilled) + CLABEMPS(key)(Manu, Skilled)

                            CLABEMPS(key)(Serv, Unskilled) = CLABEMPS(key)(Serv, Unskilled) + X * CLABEMPS(key)(Serv, Unskilled) / CLABEMPS(key)(Serv, NSkill)
                            CLABEMPS(key)(Serv, Skilled) = CLABEMPS(key)(Serv, Skilled) + X * CLABEMPS(key)(Serv, Skilled) / CLABEMPS(key)(Serv, NSkill)
                            CLABEMPS(key)(Serv, NSkill) = CLABEMPS(key)(Serv, Unskilled) + CLABEMPS(key)(Serv, Skilled)
                        End If
                    End If
                Next
            End Sub

            Private Sub CLABEMPSandCVADDReconciliation(cntx As IRebuildFacade) 'bbh 2024/02/29 full routine
                Dim LabSum As Single?, VaddSum As Single?, LabProductivity As Single?, LabProductivitySec As Single?, LabProductivityMax As Single?, LabProductivityMin As Single?, LabSecTotal As Single?, NewLabSum As Single?

                For Each key In cntx.Regionalization.Keys
                    LabSum = 0
                    VaddSum = 0
                    For SCount% = 2 To cntx.NSec
                        LabSum = LabSum + CLABEMPS(key)(SCount%, Unskilled) + CLABEMPS(key)(SCount%, Skilled)
                        VaddSum = VaddSum + CVADD(key)(SCount%)
                    Next SCount%
                    LabSum = AMAX(0.0001F, LabSum)
                    LabProductivity = VaddSum / LabSum
                    LabProductivityMax = AMAX(0.0001F, LabProductivity * 10)
                    LabProductivityMin = AMAX(0.0001F, LabProductivity / 10)

                    NewLabSum = 0
                    For SCount% = 2 To cntx.NSec
                        LabSecTotal = AMAX(0.00005F, CLABEMPS(key)(SCount%, Unskilled) + CLABEMPS(key)(SCount%, Skilled))
                        LabProductivitySec = AMAX(0.00005F, CVADD(key)(SCount%) / LabSecTotal)

                        'If (key = "Palestine" And SCount% = 2) Then Stop
                        'If (key = "Eritrea" And SCount% = 2) Then Stop

                        If LabProductivitySec > LabProductivityMax Then 'e.g. if 100 > 5
                            CLABEMPS(key)(SCount%, Unskilled) = CLABEMPS(key)(SCount%, Unskilled) * LabProductivitySec / LabProductivityMax
                            CLABEMPS(key)(SCount%, Skilled) = CLABEMPS(key)(SCount%, Skilled) * LabProductivitySec / LabProductivityMax
                        End If

                        If LabProductivitySec < LabProductivityMin Then 'e.g. if 5 < 100
                            CLABEMPS(key)(SCount%, Unskilled) = CLABEMPS(key)(SCount%, Unskilled) * LabProductivitySec / LabProductivityMin

                            CLABEMPS(key)(SCount%, Skilled) = CLABEMPS(key)(SCount%, Skilled) * LabProductivitySec / LabProductivityMin
                        End If
                        NewLabSum = NewLabSum + CLABEMPS(key)(SCount%, Unskilled) + CLABEMPS(key)(SCount%, Skilled)
                    Next SCount%

                    NewLabSum = AMAX(0.0001F, NewLabSum)
                    For SCount% = 2 To cntx.NSec
                        CLABEMPS(key)(SCount%, Unskilled) = CLABEMPS(key)(SCount%, Unskilled) * LabSum / NewLabSum
                        CLABEMPS(key)(SCount%, Skilled) = CLABEMPS(key)(SCount%, Skilled) * LabSum / NewLabSum
                    Next SCount%
                Next
            End Sub 'bbh 2024/02/29 end new routine

            Sub EInvert(key As String, cntx As IRebuildFacade)
                '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
                '   Last Changed by BBH: September 8, 2003

                '     The original version of the code in this routine was written by Peter Rindfuss
                '       of the GLOBUS project
                '     This subroutine solves the linear system  A x  =  b
                '     ( line pivot search only )
                '     NS%  -  dimension of system
                '     A  -  (NxN) system matrix  (overridden on exit)
                '     b  -  (Nx1) rhs of system on entry, solution on exit
                '     The input for IFs is CPFD and the output is CZS
                '     ----------------------------------------------------
                'jrs 2025/04/11
                'ZS(S%) = PFD(S%) + ints across row S% in the SAM
                'and we know ints = ZS(S%) * AmatCountry across row S%
                'so we have ZS(S%) = PFD(S%) + ZS(S%) * AmatCountry across row S%
                'ZS(S%) - ZS(S%)*Amatcountry across row S% = PFD(S%)
                'ZS(S%) * (1 - AMatCountry across row S%) = PFD(S%)
                'This is why we add 1 (to the main diagonal) and multiply -1 to get the aneg matrix

                Dim NS As Integer = cntx.NSec
                Dim aneg(,) As Single?, B() As Single?
                ReDim aneg(NS%, NS%)
                ReDim B(NS%)

                '   Error check needed ***************
                '   Save a matrix before inversion, multiply by inverted matrix before exit
                '   and check to see if result is an identity matrix.
                '   ---------------------------------------------------------------------------
                Dim row As Integer

                For row = 1 To NS%
                    For column% = 1 To NS%
                        aneg(row, column%) = -EIOMat(key, row, column%, cntx)
                        If (row = column%) Then aneg(row, column%) = 1 + aneg(row, column%)
                        If Not (aneg(row, column%).HasValue) Then
                            Dim msg As String
                            msg$ = "There is a null coeficient for country " + key
                            msg$ = msg$ + "," + row.ToString + "," + column%.ToString
                            Debug.Print(msg$)
                            Stop
                        End If
                    Next column%
                Next row


                '     Compute inverse of matrix and gross production
                '     ----------------------------------------------
                For row = 1 To NS%
                    B(row) = CPFD(key)(row)
                Next row

                Dim StartHere As Boolean, aux As Single?
                StartHere = True

                For KCount% = 1 To NS%

                    aux = 0#

                    '        Find maximal element of column k
                    '        --------------------------------

                    For jCount% = KCount% To NS%
                        If (aux < Abs(CSng(aneg(jCount%, KCount%)))) Then
                            aux = Abs(CSng(aneg(jCount%, KCount%)))
                            row = jCount%
                        End If
                    Next jCount%

                    If (aux <= 0.0000000001) Then
                        Debug.Print("Fatal error in EInvert")
                        Stop
                    End If

                    '        Pivot element is not too small
                    '        ------------------------------

                    If (KCount% <> row) Then

                        '           Swap rows
                        '           ---------

                        For MCount% = KCount% To NS%
                            aux = aneg(KCount%, MCount%)
                            aneg(KCount%, MCount%) = aneg(row, MCount%)
                            aneg(row, MCount%) = aux

                            If Not (aneg(row, MCount%).HasValue) Then
                                Dim msg As String
                                msg$ = "There is a null coeficient for country " + key
                                msg$ = msg$ + "," + row.ToString + "," + MCount%.ToString
                                Debug.Print(msg$)
                                Stop
                            End If

                        Next MCount%
                        aux = B(KCount%)
                        B(KCount%) = B(row)
                        B(row) = aux

                    End If

                    '       Compute
                    '       -------

                    row = KCount% + 1

                    If (row <= NS%) Then
                        For MCount% = row To NS%
                            If Not (aneg(KCount%, MCount%).HasValue) Then
                                Dim msg As String
                                msg$ = "There is a null coeficient for country " + key
                                msg$ = msg$ + "," + KCount%.ToString + "," + MCount%.ToString
                                Debug.Print(msg$)
                                Stop
                            End If
                            aneg(KCount%, MCount%) = aneg(KCount%, MCount%) / aneg(KCount%, KCount%)
                        Next MCount%
                    End If

                    B(KCount%) = B(KCount%) / aneg(KCount%, KCount%)

                    If (KCount% > 1) Then
                        If (row <= NS%) Then
                            For MCount% = 1 To KCount% - 1
                                For jCount% = row To NS%
                                    aneg(MCount%, jCount%) = aneg(MCount%, jCount%) -
                                    aneg(KCount%, jCount%) * aneg(MCount%, KCount%)
                                    If Not (aneg(MCount%, jCount%).HasValue) Then
                                        Dim msg As String
                                        msg$ = "There is a null coeficient for country " + key
                                        msg$ = msg$ + "," + MCount%.ToString + "," + jCount%.ToString
                                        Debug.Print(msg$)
                                        Stop
                                    End If
                                Next jCount%
                            Next MCount%
                        End If

                        For MCount% = 1 To KCount% - 1
                            B(MCount%) = B(MCount%) - B(KCount%) * aneg(MCount%, KCount%)
                        Next MCount%
                    End If

                    If (KCount% <> NS%) Then
                        For MCount% = row To NS%
                            For jCount% = row To NS%
                                If Not (aneg(MCount%, jCount%).HasValue) Then
                                    Dim msg As String
                                    msg$ = "There is a null coeficient for country " + key
                                    msg$ = msg$ + "," + MCount%.ToString + "," + jCount%.ToString
                                    Debug.Print(msg$)
                                    Stop
                                End If
                                aneg(MCount%, jCount%) = aneg(MCount%, jCount%) -
                                aneg(KCount%, jCount%) * aneg(MCount%, KCount%)
                            Next jCount%
                            B(MCount%) = B(MCount%) - B(KCount%) * aneg(MCount%, KCount%)
                        Next MCount%
                    End If

                Next KCount%
                For KCount% = 1 To NS% : CZS(key)(KCount%) = B(KCount%) : Next KCount%

                '+ + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
            End Sub


            Function EIOMat(key As String, s1 As Integer, s2 As Integer, cntx As IRebuildFacade) As Single?
                '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
                '   Last Changed by BBH: September 8, 2003

                '   This routine returns an individual IO (technical) matrix coefficient
                '       upon each call; used to calculate country-specific coefficients based
                '       on CCGDP/capita level matrices
                Dim EIOMatComp As Single?
                If CGDPPC(key) * 1000 >= iothresh(cntx.NIOMatrices) Then

                    '        CCGDP per capita ge maximum - no interpolation
                    '        --------------------------------------------

                    EIOMatComp = iotab(s1, s2, cntx.NIOMatrices)
                    Return TimeEnergyAdjust(key, s1, s2, cntx, EIOMatComp)
                End If

                If CGDPPC(key) * 1000 <= iothresh(1) Then

                    '        CCGDP per capita le minimum - no interpolation
                    '        --------------------------------------------

                    EIOMatComp = iotab(s1, s2, 1)
                    Return TimeEnergyAdjust(key, s1, s2, cntx, EIOMatComp)
                End If


                '        CCGDP per capita lt maximum - interpolate
                '        ---------------------------------------

                For Thr = 1 To cntx.NIOMatrices - 1
                    If CGDPPC(key) * 1000 > iothresh(Thr) And CGDPPC(key) * 1000 <= iothresh(Thr + 1) Then
                        Dim fac As Single?
                        fac = (CGDPPC(key) * 1000 - iothresh(Thr)) / (iothresh(Thr + 1) - iothresh(Thr))
                        EIOMatComp = fac * iotab(s1, s2, Thr + 1) + (1 - fac) * iotab(s1, s2, Thr)
                        Return TimeEnergyAdjust(key, s1, s2, cntx, EIOMatComp)
                    End If
                Next Thr

                '+ + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + + +
            End Function

            Function TimeEnergyAdjust(key As String, s1 As Integer, s2 As Integer, cntx As IRebuildFacade, ByRef EIOMatComp As Single?) As Single?
                Dim IOConv As Integer, IY As Integer, TimeFac As Integer
                IOConv = 100
                IY% = 1
                TimeFac = Amin(IY% - 1, IOConv)
                EIOMatComp = CSng((AMatCountry(key)(s1, s2) * (IOConv - TimeFac) +
                EIOMatComp * TimeFac) / IOConv)

                If Not (EIOMatComp.HasValue) Then
                    Dim msg As String
                    msg$ = "There is a null coeficient for country " + key
                    msg$ = msg$ + "," + s1.ToString + "," + s2.ToString
                    Debug.Print(msg$)
                    Stop
                End If
                Dim enmulconv As Integer, EnMulF As Single?
                If s1 = Ener Then
                    enmulconv = 50
                    TimeFac = Amin(IY% - 1, enmulconv)
                    EnMulF = (EnMul(key) * (enmulconv - TimeFac) + 1 * TimeFac) / enmulconv
                    If Not (EIOMatComp.HasValue) Then EIOMatComp = 0
                    TimeEnergyAdjust = Amin(0.5F, EIOMatComp * EnMulF) 'EnMul(key)
                Else
                    TimeEnergyAdjust = Amin(0.5F, EIOMatComp * IOMatMul(key)(s1))
                End If

            End Function

