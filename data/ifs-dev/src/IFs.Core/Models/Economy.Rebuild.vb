            'jrs 2024/11/20 Computing Factors and applying the best between the 2
            Private Sub AdjustXSecDyadic(cntx As IRebuildFacade, iSector As Integer, xmDiff As Single, myDYAD As Dictionary(Of String, Dictionary(Of String, Single?)))
                Dim XAdjAvg As Single?, XCount As Integer
                Dim MAdjAvg As Single?, MCount As Integer
                Dim FactorsX As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim FactorsM As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim FactorsAvg As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                'Adjust Exports first
                '--------------------
                Dim XTOT As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                XAdjAvg = 0
                XCount = 0
                For Each keyi In cntx.Regionalization.Keys
                    XTOT.Add(keyi, 0)
                    If myDYAD.ContainsKey(keyi) Then
                        For Each keyj In myDYAD(keyi).Keys
                            XTOT(keyi) = XTOT(keyi) + If(myDYAD(keyi)(keyj), 0)
                        Next keyj
                    End If
                    'Debug.Print(keyi + "," + XTOT(keyi).ToString)
                Next keyi

                For Each keyi In cntx.Regionalization.Keys
                    If XTOT.ContainsKey(keyi) Then
                        If XTOT(keyi) > 0 Then
                            XAdjAvg = XAdjAvg + CXS(keyi)(iSector) * 1000000000 / XTOT(keyi)
                            XCount = XCount + 1
                        End If
                    End If
                    If myDYAD.ContainsKey(keyi) Then
                        If XTOT(keyi) > 0 Then
                            FactorsX.Add(keyi, CXS(keyi)(iSector) * 1000000000 / XTOT(keyi))
                        End If
                    End If
                Next keyi
                XAdjAvg = XAdjAvg / XCount

                'Adjust Imports second
                '--------------------
                Dim MTOT As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                MAdjAvg = 0
                MCount = 0
                For Each keyi In cntx.Regionalization.Keys
                    If myDYAD.ContainsKey(keyi) Then
                        For Each keyj In myDYAD(keyi).Keys
                            If Not MTOT.ContainsKey(keyj) Then
                                MTOT.Add(keyj, 0)
                            End If
                            MTOT(keyj) = MTOT(keyj) + If(myDYAD(keyi)(keyj), 0)
                        Next keyj
                    End If
                Next keyi

                For Each keyi In cntx.Regionalization.Keys
                    If MTOT.ContainsKey(keyi) Then
                        If MTOT(keyi) > 0 Then
                            MAdjAvg = MAdjAvg + CMS(keyi)(iSector) * 1000000000 / MTOT(keyi)
                            MCount = MCount + 1
                        End If
                    End If
                    If myDYAD.ContainsKey(keyi) Then
                        If MTOT(keyi) > 0 Then
                            FactorsM.Add(keyi, CMS(keyi)(iSector) * 1000000000 / MTOT(keyi))
                            For Each keyj In myDYAD(keyi).Keys
                                If keyi <> keyj And FactorsX.ContainsKey(keyj) Then
                                    FactorsAvg.Add(keyj & keyi, (FactorsX(keyj) + FactorsM(keyi)) / 2)
                                End If
                            Next
                        End If
                    End If
                Next keyi
                MAdjAvg = MAdjAvg / MCount

                Dim diff1 As Single?, diff2 As Single?, diff3 As Single?, diffMax As Single?, diffMin As Single?
                'Apply the Average
                For Each keyi In cntx.Regionalization.Keys
                    If myDYAD.ContainsKey(keyi) Then
                        For Each keyj In myDYAD(keyi).Keys
                            If keyi <> keyj Then
                                If FactorsX.ContainsKey(keyi) Then
                                    diff1 = myDYAD(keyi)(keyj) * (FactorsX(keyi) - 1)
                                Else
                                    diff1 = 0
                                End If
                                If FactorsM.ContainsKey(keyj) Then
                                    diff2 = myDYAD(keyi)(keyj) * (FactorsM(keyj) - 1)
                                Else
                                    diff2 = 0
                                End If
                                If FactorsAvg.ContainsKey(keyi & keyj) Then
                                    diff3 = myDYAD(keyi)(keyj) * (FactorsAvg(keyi & keyj) - 1)
                                Else
                                    diff3 = 0
                                End If
                                If diff2 > diff1 Then
                                    diffMax = diff2
                                    diffMin = diff1
                                Else
                                    diffMax = diff1
                                    diffMin = diff2
                                End If
                                'Check if Origin Country i can keep sending more and Destination Country j can keep receiving
                                If CXS(keyi)(iSector) - XTOT(keyi) >= diffMax And
                                    CMS(keyj)(iSector) - MTOT(keyj) >= diffMax Then
                                    myDYAD(keyi)(keyj) = CSng(myDYAD(keyi)(keyj) + diffMax)
                                    XTOT(keyi) = XTOT(keyi) + diffMax
                                    MTOT(keyj) = MTOT(keyj) + diffMax
                                    'Check if Origin Country i needs less and Destination Country j needs less, unless j is a big country
                                ElseIf CXS(keyi)(iSector) - XTOT(keyi) <= diffMin And
                                    CMS(keyj)(iSector) - MTOT(keyj) <= diffMin Then
                                    myDYAD(keyi)(keyj) = CSng(myDYAD(keyi)(keyj) + diffMin)
                                    XTOT(keyi) = XTOT(keyi) + diffMin
                                    MTOT(keyj) = MTOT(keyj) + diffMin
                                Else 'Use the average
                                    myDYAD(keyi)(keyj) = CSng(myDYAD(keyi)(keyj) + diff3)
                                    XTOT(keyi) = XTOT(keyi) + diff3
                                    MTOT(keyj) = MTOT(keyj) + diff3
                                End If
                            End If
                        Next
                    End If
                Next

                'Use just 20 iterations
                If xmDiff > 20 Then
                    xmDiff = 20
                End If
                'If (XAdjAvg > 0.99 And XAdjAvg < 1.01 And MAdjAvg > 0.99 And MAdjAvg < 1.01) Or Abs(CSng(XAdjAvg - MAdjAvg)) >= xmDiff Then
                If xmDiff = 0 Then
                    Exit Sub
                Else
                    'AdjustXSecDyadic(cntx, iSector, Abs(CSng(XAdjAvg - MAdjAvg)), myDYAD)
                    AdjustXSecDyadic(cntx, iSector, xmDiff - 1, myDYAD)
                End If
            End Sub

