                    'mti 2021/12/06 start
                    If Not Cpovnational(key).HasValue Then
                        lnstddev = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2))
                        'jrs 2022/11/21
                        If ConstantDollarsYear = 2011 Then
                            portionpoor = CSng(Amin(0.999, CINCOMELT19(key) / AMAX(0.0001, CPOP(key))))
                        ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                            portionpoor = CSng(Amin(0.999, CINCOMELT215(key) / AMAX(0.0001, CPOP(key))))
                        Else 'jrs 2025/09/12
                            portionpoor = CSng(Amin(0.999, CINCOMELT300(key) / AMAX(0.0001, CPOP(key))))
                        End If
                        If portionpoor > 0.02 Then
                            NInv = CalcNormalInverse(portionpoor)
                            NInv = AMAX(-4, NInv)
                            'jrs 2022/11/21
                            If ConstantDollarsYear = 2011 Then
                                LNMean = CSng(Log(365 * 1.9) - lnstddev * NInv)
                            ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                                LNMean = CSng(Log(365 * 2.15) - lnstddev * NInv)
                            Else 'jrs 2025/09/12
                                LNMean = CSng(Log(365 * 3) - lnstddev * NInv)
                            End If
                        Else    'use 32 in 2011$/365 in 2017$
                            'jrs 2022/11/21
                            If ConstantDollarsYear = 2011 Then
                                portionpoor = CSng(Amin(0.999, CINCOMELT32(key) / AMAX(0.0001, CPOP(key))))
                            ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                                portionpoor = CSng(Amin(0.999, CINCOMELT365(key) / AMAX(0.0001, CPOP(key))))
                            Else 'jrs 2025/09/12
                                portionpoor = CSng(Amin(0.999, CINCOMELT420(key) / AMAX(0.0001, CPOP(key))))
                            End If
                            If portionpoor > 0.02 Then
                                NInv = CalcNormalInverse(portionpoor)
                                NInv = CSng(AMAX(-3.5, NInv))
                                'jrs 2022/11/21
                                If ConstantDollarsYear = 2011 Then
                                    LNMean = CSng(Log(365 * 3.2) - lnstddev * NInv)
                                ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                                    LNMean = CSng(Log(365 * 3.65) - lnstddev * NInv)
                                Else 'jrs 2025/09/12
                                    LNMean = CSng(Log(365 * 4.2) - lnstddev * NInv)
                                End If
                            Else
                                'jrs 2022/11/21
                                If ConstantDollarsYear = 2011 Then
                                    portionpoor = CSng(AMAX(0.00001, Amin(0.999, CINCOMELT55(key) / AMAX(0.0001, CPOP(key)))))
                                ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                                    portionpoor = CSng(AMAX(0.00001, Amin(0.999, CINCOMELT685(key) / AMAX(0.0001, CPOP(key)))))
                                Else 'jrs 2025/09/12
                                    portionpoor = CSng(AMAX(0.00001, Amin(0.999, CINCOMELT830(key) / AMAX(0.0001, CPOP(key)))))
                                End If
                                NInv = CalcNormalInverse(portionpoor)
                                NInv = AMAX(-3, NInv)
                                'jrs 2022/11/21
                                If ConstantDollarsYear = 2011 Then
                                    LNMean = CSng(Log(365 * 5.5) - lnstddev * NInv)
                                ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                                    LNMean = CSng(Log(365 * 6.85) - lnstddev * NInv)
                                Else 'jrs 2025/09/12
                                    LNMean = CSng(Log(365 * 8.3) - lnstddev * NInv)
                                End If
                            End If
                        End If


                        'Portionpoor = StdNormal(Povline), where, Povline is the z-score of logged threshold
                        'so, Invverse of portionpoor = (Log(PovLine) - LogNormal_Mean) / LogNormal_StdDev

                        'Find lognormal NPL from national poverty rate and the distribution parameters determined with $1.9
                        '--------------------------------------------------------------------------------------------------------
                        portionpoor = CSng(Amin(0.999, CINCOMELTNPL(key) / AMAX(0.0001, CPOP(key))))
                        Dim LNpovnational = CalcNormalInverse(portionpoor)       'income threshold for standardized normal distribution of log of income/consumption
                        LNpovnational = AMAX(-3, LNpovnational)
                        Cpovnational(key) = CSng(Exp(CSng(LNpovnational * lnstddev + LNMean)) / 365)      'converting from standardized, LnThreshold_Standard = (Log(Threshold) - LNMean) / lnstddev; divide by 365

                    End If
                    'mti 2021/12/06 End

                    If CINCOMELTNPL(key) < 0.000002 Then CINCOMELTNPL(key) = 0  'less than 2 poor in total, make it 0
                    CINCOMELTNPL(key) = CSng(Round(CSng(CINCOMELTNPL(key)), 6))  'rounding for better poverty accounting across age-sex

                    'mti 2021/07/15 end -- national poverty line ------------------------

                Next
                'mti 2021/06/30 end
            End Sub

            'jrs 2022/11/18
            Private Function CalcCINCOMELTXXXLow(ByVal sTbName As String, ByVal sCountry As String,
                                              ByRef INCOMELTTBL As IDictionary(Of String, Single?()), ByRef yrsIncLT() As Short,
                                              ByRef GDPPCPPPTbl As IDictionary(Of String, Single?()), ByRef yrsGDP() As Short,
                                              XYTABL As SeriesEstimator, cntx As IRebuildFacade) As Single?
                Dim TbName, FuncName As String
                TbName = sTbName
                Dim ValHold As Single?
                If cntx.HistoricMode Then
                    ValHold = XYTABL(sCountry)
                    ValHold = Amin(ValHold, 70)
                    ValHold = AMAX(ValHold, 0)
                Else
                    FuncName = TbName
                    ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(sCountry), cntx.FirstYear, INCOMELTTBL, yrsIncLT,
                        GDPPCPPPTbl, yrsGDP, sCountry, FuncName, cntx, 100, 0, "Div", 1000)
                End If

                CalcCINCOMELTXXXLow = ValHold / 100 * CPOP(sCountry) 'Convert from Percent to Index form
            End Function

            'jrs 2022/11/18
            Private Function CalcCINCOMELTXXXMidHigh(ByVal sTbName As String, ByVal sCountry As String,
                                              ByRef INCOMELTTBL As IDictionary(Of String, Single?()), ByRef yrsIncLT() As Short,
                                              ByRef GDPPCPPPTbl As IDictionary(Of String, Single?()), ByRef yrsGDP() As Short,
                                              XYTABL As SeriesEstimator, CINCOMELTLower As Single?,
                                              LowerLevel As Single, CurrentLevel As Single, cntx As IRebuildFacade) As Single?
                Dim TbName, FuncName As String
                TbName = sTbName
                Dim ValHold As Single?
                If cntx.HistoricMode Then
                    ValHold = XYTABL(sCountry)
                    ValHold = Amin(ValHold, 70)
                    ValHold = AMAX(ValHold, 0)
                Else
                    FuncName = TbName
                    ValHold = Nothing

                    Dim portionpoor As Single? = CSng(Amin(0.9, CINCOMELTLower / AMAX(0.0001, CPOP(sCountry))))
                    If portionpoor < 0.0001 Then
                        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(sCountry), cntx.FirstYear, INCOMELTTBL, yrsIncLT,
                        GDPPCPPPTbl, yrsGDP, sCountry, FuncName, cntx, 100, 0, "Div", 1000, 10)      'use regression
                    Else
                        ValHold = EstimateFromMostRecentRevBBH(CGDPPCP(sCountry), FirstYear, INCOMELTTBL, yrsIncLT,
                        GDPPCPPPTbl, yrsGDP, sCountry, FuncName, cntx, 100, 0, "Div", 1000, 10, False)    'do not use regression
                    End If

                    If Not ValHold.HasValue Then

                        Dim NInv = CalcNormalInverse(portionpoor)

                        NInv = CSng(AMAX(-3.5, NInv))

                        'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                        Dim lnstddev As Single? = CSng(Sqrt(2) * CalcNormalInverse((CGINIDOM(sCountry) + 1) / 2))
                        Dim LNMean As Single? = CSng(Log(365 * LowerLevel) - lnstddev * NInv)

                        'Find portionpoor for <$1/day
                        '----------------------------
                        portionpoor = CalcLogNormalCDF(365 * CurrentLevel, LNMean, lnstddev)
                        ValHold = CSng(AMAX(0, Amin(100, 100 * Round(CSng(portionpoor), 7)))) 'jrs 2020/03/10 try it for Azerbaijan, not matching .NET

                    End If
                End If

                CalcCINCOMELTXXXMidHigh = ValHold / 100 * CPOP(sCountry) 'Convert from Percent to Index form
            End Function

