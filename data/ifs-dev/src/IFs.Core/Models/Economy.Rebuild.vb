                                        IFsIOMatrices(LCount%, SCount%, matval) =
                                        IFsIOMatrices(LCount%, SCount%, matval) + IFsCoefMatrix(LCount%, SCount%)
                                        '                IOCountryMatrix(ctry.Country, LCount%, SCount%) = IFsCoefMatrix(LCount%, SCount%)
                                    Next SCount%

