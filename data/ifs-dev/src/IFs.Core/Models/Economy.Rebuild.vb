                        Else
                            DebtGro = ((PPGDEBT99 + PPGDEBT00) - (PPGDEBT97 + PPGDEBT98)) / 2
                        End If
                        'Ratio to GDP
                        If Reserves97 < 0.001 Or Reserves98 < 0.001 _
                        Or Reserves99 < 0.001 Or Reserves00 < 0.001 Then
                            ReservesGro = 0
                        Else
                            ReservesGro = ((Reserves99 + Reserves00) - (Reserves97 + Reserves97)) / 2
                        End If
                        'Percentage of GDP
                        IntlPositionChange(key) = ReservesGro / 100 - DebtGro 'Ratio to GDP


                        '            GDPANN = GDPTbl(keyi)("MostRecent")
                    End If

                    '       Compute unreconciled discrepancy between capital and current account
                    '           Reasons could be flight capital, unreported worker remittances, other data errors
                    '       -------------------------------------------------------------------------------------

                    IFIDebt = CXIMFCREDIT(key) + CXWBLOANS(key)
                    'Borrowers positive; subscribers negative
                    NetFDIFrAbroad = CXFDISTOCK(key) - CXFDISTOUT(key)
                    NetPortfolioFrAbroad = CXPORTFOLIO(key) - CXPORTSTOUT(key)
                    NetFirmDebtAbroad = CXFIRMDEBT(key) 'Need to subtract firm assets abroad term
                    NetGovtDebtAbroad = CXGOVTDEBT(key) 'Need to subtract govt assets abroad term
                    lintr = 0.03
                    Interest.Add(key, IFIDebt * lintr + NetFDIFrAbroad * lintr + NetFirmDebtAbroad * lintr + NetGovtDebtAbroad * lintr + NetPortfolioFrAbroad * lintr)

                    CURACTHIs.Add(key, 0)
                    CURACTHIs(key) = exports(key) - cimports(key) + CAIDREC(key) +
                        CXWORKREMIT(key) - CAIDDON(key) - Interest(key)   'trade converted from % of GDP to dollars earlier
                    CAPACTHis.Add(key, 0)
                    CAPACTHis(key) = CXFDIFIN(key) - CXFDIFOUT(key) + CXPORTFIN(key) - CXPORTFOUT(key) _
                        + CXIMFCRFIN(key) - CXIMFCRFOUT(key) + CXWBLNFIN(key) - CXWBLNFOUT(key)
                    'all in dollars above
                    'CompIntlPositionChange = (-CURACTHIs - CAPACTHis) / CGDP(key)
                    CompIntlPositionChange = (CURACTHIs(key) + CAPACTHis(key)) / CGDP(key)
                    'CXFinUnexp(key) = (CompIntlPositionChange - IntlPositionChange) * 100 'Percent
                    CXFinUnexp.Add(key, (IntlPositionChange(key) - CompIntlPositionChange) * 100) 'Percent

                Next

                'bbh 2022/06/04 Start: Moved code for CCURACTNETPRI to ReadAndProcessIntlFlows
                '       Look for and address likely worker remittance isues
                '           For instance, Lesotho has workers in South Africa that do not show as migrants
                '           Nicaragua has huge external debt that is working down with help from
                '               Heavily Indebted Poor Countries Initiative (funds not in IFs?)
                '       ---------------------------------------------------------------------------------
                'Dim FinPayments As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                'Dim FinReceipts As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                'If cntx.HistoricMode Then
                '    For Each key In cntx.Regionalization.Keys
                '        FinPayments.Add(key, 0)
                '        FinReceipts.Add(key, 0)
                '    Next
                'Else
                '    For Each item In (From s In cntx.GetSlice("SeriesXIncPaymentsGDP", cntx.BaseYear, CoalescePolicy.MostRecent)
                '                      Join s2 In cntx.GetSlice("SeriesXIncReceiptsGDP", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                '                      Select Key = s.Key, Value = s.Value, Value2 = s2.Value)
                '        FinPayments.Add(item.Key, item.Value)
                '        FinReceipts.Add(item.Key, item.Value2)
                'If Not (FinReceipts(key).HasValue) Then
                '    FinReceipts(key) = 0
                'End If
                'If Not (FinPayments(key).HasValue) Then
                '    FinPayments(key) = 0
                'End If
                '    Next
                'End If

                '   bbh 2022/04/22 start: Was adjusting remittances for consistency with net primary income data (now CCURACTNETPRI)
                '       Unless found to be needed and appropriate, leave commented code in, but leave commented and no need to readjust global totals
                'Dim NetIncome As Single?, CompNetIncome As Single?, PossibleRemitDif As Single?
                'Dim SWorkRemit As Single?, AdditionalRemit As Single?
                'For Each key In cntx.Regionalization.Keys
                '    '   BBH 1/29/04 as identified by JRS End V5_0
                '    '    If CountryName(key) = "Timor-Leste" Then Stop
                '    NetIncome = (FinReceipts(key) - FinPayments(key))  'Income on investment abroad, plus worker remittances
                '    '% of GDP
                '    If CGDPPCP(key) < 5 And CXFinUnexp(key) > 5 Then 'LDC with at least 5% descrepancy
                '        CompNetIncome = (Interest(key) + CXWORKREMIT(key))  ' in Dollars
                '        PossibleRemitDif = NetIncome / 100 * CGDP(key) - CompNetIncome
                '        If CPOPFOREIGN(key) < 0 And PossibleRemitDif > 0 Then
                '            SWorkRemit = CXWORKREMIT(key)
                '            CXWORKREMIT(key) = CXWORKREMIT(key) + PossibleRemitDif
                '            If CXWORKREMIT(key) > 5 * Abs(CSng(CPOPFOREIGN(key))) Then
                '                CXWORKREMIT(key) = 5 * Abs(CSng(CPOPFOREIGN(key)))
                '                'bound remittances at $5,000 per capita
                '            End If
                '            AdditionalRemit = CXWORKREMIT(key) - SWorkRemit
                '            GloWorkRemit = GloWorkRemit + AdditionalRemit
                '            CAPACTHis(key) = CAPACTHis(key) + AdditionalRemit
                '            CompIntlPositionChange = (-CURACTHIs(key) - CAPACTHis(key)) / CGDP(key)
                '            CXFinUnexp(key) = (CompIntlPositionChange - IntlPositionChange(key)) * 100 'Percent
                '        End If
                '    End If

                '    'bbh 2014/07/02 begin
                '    If CXWORKREMIT(key) > 0 Then
                '        WRemitPos = WRemitPos + CXWORKREMIT(key)
                '    Else
                '        WRemitNeg = WRemitNeg + CXWORKREMIT(key)
                '    End If
                '    'bbh 2014/07/02 end

                'Next

                '   bbh 2022/04/22 end: Was adjusting remittances for consistency with net primary income data (now CCURACTNETPRI)
                '       If need to reactivate for net primary or secondary adjustment, also reactivate renormalization further down

                '       Convert foreign aid back to percentages (from $) for saving
                '       -----------------------------------------------------------

                For Each key In cntx.Regionalization.Keys
                    CAIDREC(key) = CAIDREC(key) / CGDP(key) * 100
                    CAIDDON(key) = CAIDDON(key) / CGDP(key) * 100
                Next

                'bbh 2022/04/22 start: rebalancing no longer needed
                ''   ReBalance Global Remittances Still Again
                ''   ----------------------------------------
                'WRemit = (WRemitPos + Abs(CSng(WRemitNeg))) / 2
                'For Each key In cntx.Regionalization.Keys
                '    If CXWORKREMIT(key) > 0 Then
                '        CXWORKREMIT(key) = CXWORKREMIT(key) / WRemitPos * WRemit
                '    End If
                '    If CXWORKREMIT(key) < 0 Then
                '        CXWORKREMIT(key) = CXWORKREMIT(key) / Abs(CSng(WRemitNeg)) * WRemit
                '    End If
                'Next

                ''bbh 2020/03/09 start
                ''   Recalculate Global Remittances Gross so the Net is as Above
                ''   -----------------------------------------------------------
                'Dim AvgRemit As Single?
                'For Each key In cntx.Regionalization.Keys
                '    AvgRemit = (CXWORKREMITIN(key) + CXWORKREMITOUT(key)) / 2
                '    CXWORKREMITIN(key) = AvgRemit + CXWORKREMIT(key) / 2
                '    CXWORKREMITOUT(key) = AvgRemit - CXWORKREMIT(key) / 2
                '    If CXWORKREMITIN(key) < 0 Then 'shift both up so as to maintain difference
                '        CXWORKREMITOUT(key) = CXWORKREMITOUT(key) - CXWORKREMITIN(key)
                '        CXWORKREMITIN(key) = 0
                '    End If
                '    If CXWORKREMITOUT(key) < 0 Then
                '        CXWORKREMITIN(key) = CXWORKREMITIN(key) - CXWORKREMITOUT(key)
                '        CXWORKREMITOUT(key) = 0
                '    End If
                'Next
                ''bbh 2020/03/09 end
                'bbh 2022/04/22 end: rebalancing no longer needed

                '
                '   Done with Social Accounting Matrix
                '   ----------------------------------

                '   Now that have tax rates as % of govt revenue
                '       and have intl financial flows that affect firm income in forecasts,
                '       can compute household and firm income, adjust firm by intl flows and
                '       can compute tax rates as % of that income for use in forecasts
                '   -------------------------------------------------------------------------------
                TbName2$ = "GDP/Capita (PPP) Versus Cobb-Douglas Alpha (GTAP 5)"
                XYTBL2 = cntx.GetRegression(TbName2).ToEstimator(CGDPPCP)
                Dim alphacd As Double?, FirmIncome As Double?, HouseHoldInc As Double?
                Dim ActualFirmTaxes As Single?, ActualSSTaxes As Single?, ActualIndirectTaxes As Single?
                Dim ActualHHTaxes As Single?, ActualTariffs As Single?
                For Each key In cntx.Regionalization.Keys
                    alphacd = XYTBL2(key)
                    'Could use empirical capital share value from GTAP and shift with function
                    'alphacd = AMAX(0.05, Amin(alphacd / 100, 1))
                    alphacd = AMAX(0.2, Amin(alphacd / 100, 1))

                    '       Convert tax rates (shares) to rates based on income
                    FirmIncome = CGDP(key) * alphacd + CXPORTFIN(key) + CXFDIFIN(key)
                    HouseHoldInc = CGDP(key) * (1 - alphacd)

                    'bbh 2017/05/21 added backing out of aid
                    '   bbh 2019/09/13 this drives GovRevPerSave negative for Afghanistan and all tax rates negative
                    '   bound to small positive when saved; problematic for long-term fiscal behavior
                    'bbh 2019/10/25 Make sure GovRev will be positive beyond just aid; change of next line to add floor, % of GDP
                    GovRevPerSave(key) = AMAX(5, GovRevPerSave(key) - CAIDREC(key))
                    ActualFirmTaxes = CGDP(key) * GovRevPerSave(key) / 100 * CFirmTaxR(key) / 100

                    CFirmTaxR(key) = CSng(ActualFirmTaxes / FirmIncome * 100)

                    'If key = "Micronesia, Fed. Sts." Then Stop

                    ActualSSTaxes = CGDP(key) * GovRevPerSave(key) / 100 * CSSWelTaxR(key) / 100
                    CSSWelTaxR(key) = CSng(ActualSSTaxes / (FirmIncome + HouseHoldInc) * 100)

                    ActualIndirectTaxes = CGDP(key) * GovRevPerSave(key) / 100 * CIndirectTaxR(key) / 100

                    'mti 2016/09/09 Start
                    'CIndirectTaxR(key) = ActualIndirectTaxes / FirmIncome * 100
                    CIndirectTaxR(key) = CSng(ActualIndirectTaxes / (FirmIncome + HouseHoldInc) * 100)
                    'mti 2016/09/09 End
                    'Cannot compute import duties/taxes here yet, need to read bilateral data and collect global sums for hole filling
                    ActualHHTaxes = CGDP(key) * GovRevPerSave(key) / 100 * CHHTaxR(key) / 100
                    CHHTaxRUnskilled.Add(key, CSng(ActualHHTaxes / HouseHoldInc * 100))
                    CHHTaxRSkilled.Add(key, CHHTaxRUnskilled(key))

                Next

                'bbh 2019/10/12 *** begin ***
                For i% = 1 To 6
                    SecTarRateSum(i%) = 0
                    SecTarRateCount(i%) = 0
                Next i%

                Using db As IFsContext = New IFsContext()
                    Dim rsD As IEnumerable(Of TariffRatePerSectorCountry)
                    'gvdb 2024/04/05
                    ' update for EF new syntax
                    rsD = db.TariffRatePerSectorCountry.AsEnumerable()
                    For Each item In rsD
                        'read dyadic analysis based import tariff rates by sector
                        'if null set to 0; and many bilateral countries do not have data
                        Dim VarVals(6) As Single?
                        CTariffTaxRSec.Add(item.Country, VarVals)
                        If item.Agriculture.HasValue Then
                            CTariffTaxRSec(item.Country)(1) = item.Agriculture
                            SecTarRateSum(1) = SecTarRateSum(1) + CTariffTaxRSec(item.Country)(1) 'if non-null compute basis for global average rage
                            SecTarRateCount(1) = SecTarRateCount(1) + 1
                        Else
                            CTariffTaxRSec(item.Country)(1) = 0
                        End If
                        If item.Energy.HasValue Then
                            CTariffTaxRSec(item.Country)(2) = item.Energy
                            SecTarRateSum(2) = SecTarRateSum(2) + CTariffTaxRSec(item.Country)(2) 'if non-null compute basis for global average rage
                            SecTarRateCount(2) = SecTarRateCount(2) + 1
                        Else
                            CTariffTaxRSec(item.Country)(2) = 0
                        End If
                        If item.Materials.HasValue Then
                            CTariffTaxRSec(item.Country)(3) = item.Materials
                            SecTarRateSum(3) = SecTarRateSum(3) + CTariffTaxRSec(item.Country)(3) 'if non-null compute basis for global average rage
                            SecTarRateCount(3) = SecTarRateCount(3) + 1
                        Else
                            CTariffTaxRSec(item.Country)(3) = 0
                        End If
                        If item.Manufactures.HasValue Then
                            CTariffTaxRSec(item.Country)(4) = item.Manufactures
                            SecTarRateSum(4) = SecTarRateSum(4) + CTariffTaxRSec(item.Country)(4) 'if non-null compute basis for global average rage
                            SecTarRateCount(4) = SecTarRateCount(4) + 1
                        Else
                            CTariffTaxRSec(item.Country)(4) = 0
                        End If
                        If item.Services.HasValue Then
                            CTariffTaxRSec(item.Country)(5) = item.Services
                            SecTarRateSum(5) = SecTarRateSum(5) + CTariffTaxRSec(item.Country)(5) 'if non-null compute basis for global average rage
                            SecTarRateCount(5) = SecTarRateCount(5) + 1
                        Else
                            CTariffTaxRSec(item.Country)(5) = 0
                        End If
                        If item.ICT.HasValue Then
                            CTariffTaxRSec(item.Country)(6) = item.ICT
                            SecTarRateSum(6) = SecTarRateSum(6) + CTariffTaxRSec(item.Country)(6) 'if non-null compute basis for global average rage
                            SecTarRateCount(6) = SecTarRateCount(6) + 1
                        Else
                            CTariffTaxRSec(item.Country)(6) = 0
                        End If
                    Next
                End Using

                'Now move to comoputing import duties by sector. Combine information from total import tariff rate computed earlier
                '   with information from bilateral countries where it exists
                'Rules are to use data from WDI for total revenues, to normalize bilateral sector rates to that total when bilateral data exist,
                '   and to fill sectoral import tax rate values with global averages when bilateral data do not exist (agaain normalized to
                '   national total
                Dim ActualTariffs2, CountrySum As Single?
                For Each key In cntx.Regionalization.Keys
                    ActualTariffs = CGDP(key) * GovRevPerSave(key) / 100 * CTariffTaxR(key) / 100
                    'In above, at this point GovRevPerSave is % of GDP but CGovRevLocal is billion $); analysis of tariff rev calc
                    '    versus OECD data for US, Australia suggest that the WDI series used earlier for CTariffTaxR is central govt rev share
                    CTariffTaxR(key) = ActualTariffs / cimports(key) * 100
                    'If key = "Lesotho" Then Stop
                    ActualTariffs2 = 0
                    'If key = "Iran, Islamic Republic Of" Then Stop
                    For i% = 1 To 6
                        If i% = 1 Then ActualTariffs2 = ActualTariffs2 + CTariffTaxRSec(key)(i%) / 100 * MAG(key)
                        If i% = 2 Then ActualTariffs2 = ActualTariffs2 + CTariffTaxRSec(key)(i%) / 100 * MEN(key)
                        If i% = 3 Then ActualTariffs2 = ActualTariffs2 + CTariffTaxRSec(key)(i%) / 100 * MMA(key)
                        If i% = 4 Then ActualTariffs2 = ActualTariffs2 + CTariffTaxRSec(key)(i%) / 100 * MMN(key)
                        If i% = 5 Then ActualTariffs2 = ActualTariffs2 + CTariffTaxRSec(key)(i%) / 100 * MSR(key)
                        If i% = 6 Then ActualTariffs2 = ActualTariffs2 + CTariffTaxRSec(key)(i%) / 100 * MIC(key)
                    Next i%
                    If ActualTariffs2 = 0 Then 'entire dyadic representation is null, normalize to global rates
                        CountrySum = 0
                        For i% = 1 To 6
                            If i% = 1 Then CountrySum = CountrySum + SecTarRateSum(i%) / SecTarRateCount(i%) / 100 * MAG(key)
                            If i% = 2 Then CountrySum = CountrySum + SecTarRateSum(i%) / SecTarRateCount(i%) / 100 * MEN(key)
                            If i% = 3 Then CountrySum = CountrySum + SecTarRateSum(i%) / SecTarRateCount(i%) / 100 * MMA(key)
                            If i% = 4 Then CountrySum = CountrySum + SecTarRateSum(i%) / SecTarRateCount(i%) / 100 * MMN(key)
                            'If i% = 5 Then CountrySum = CountrySum + SecTarRateSum(i%) / SecTarRateCount(i%) / 100 * MSR(key) only nulls
                            If i% = 6 Then CountrySum = CountrySum + SecTarRateSum(i%) / SecTarRateCount(i%) / 100 * MIC(key)
                        Next i%
                        For i% = 1 To 6 'have WDI but not dyadic; need to normalize average dyadic pattern to WDI/monadic values
                            If i% <> 5 Then
                                CTariffTaxRSec(key)(i%) = SecTarRateSum(i%) / SecTarRateCount(i%) * ActualTariffs / CountrySum
                            Else
                                CTariffTaxRSec(key)(i%) = 0
                            End If
                        Next i%

                    Else 'have monadic WDI and Dyadic; normalize dyadic rates to WDI/monadic values
                        For i% = 1 To 6
                            CTariffTaxRSec(key)(i%) = CTariffTaxRSec(key)(i%) * ActualTariffs / ActualTariffs2
                        Next i%
                    End If
                Next
                'Notes relevant to relationship of total WDI data and bilateral data (added bbh 2019/10/12):
                'For US tariff revenue data see source below indicating about $40 billion in 2015; OECD database says $38:
                'https://qz.com/1614032/us-tariff-revenues-are-skyrocketing/#targetText=US%20tariff%20revenues%20are%20way,isn't%20paying%20for%20them&targetText=The%20US%20government's%20revenue%20from,%2430%2D40%20billion%20per%20year.
                '   Calculation based on import duties as % of general revenue was generating about $61; dyadic about $27

                'For UK tariff revenue data see source below indicating about 3 billion pounds in 2015; OECD says 142 million pounds, but series messed up:
                'https://www.statista.com/statistics/284363/customs-duty-united-kingdom-hmrc-tax-receipts/
                '   Calculation based on import duties as % of revenue was generating about $15.3; dyadic produced null; no data

                'For Australia tariff revenue data see OECD source saying about 14 billion australian dollars in 2015; 1 AD = 0.68 USD, so $US 9.5:
                'OECD has dtails of tax revnue page by country, line 5123 is customs and import duties
                'https://stats.oecd.org/Index.aspx?DataSetCode=REVAUS
                '   Calculation based on import duties as % of revenue was generating about $11.5 USD; dyadic produced 4.1 USD

                'For Iceland tariff revenue data see OECD source saying about 4.989 billion iceland krona in 2015; 1 IK is 0.008 USD so 0.04 Bil USD:
                'OECD has dtails of tax revnue page by country, line 5123 is customs and import duties
                'https://stats.oecd.org/   Look for Public sector, Taxatin and Market Regulation/Taxation/Revenue Statistics/line 5123
                '   Calculation based on import duties as % of revenue was generating about $.06; dyadic produced .067
                'bbb 2019/10/12 *** end *** 

                FillInitialGDPGRNIDM(cntx, yrsGDPTbl, GDPTbl)
                'CreateLDRTRIPMAInital(cntx, yrsGDPTbl, GDPTbl)

                For Each key In cntx.Regionalization.Keys
                    Dim Vals(6) As Single?
                    CCS.Add(key, Vals)
                    Dim Vals2(6) As Single?
                    CPFD.Add(key, Vals2)
                    Dim Vals3(6) As Single?
                    CZS.Add(key, Vals3)
                    Dim Vals4(6) As Single?
                    CVADD.Add(key, Vals4)
                    'If key = "Singapore" Then Stop
                    'jrs 2026/08/27 changing the limit from 10k to 100k to avoid truncating consumption for the US, 10566.8711
                    CCS(key)(1) = AMAX(0, Amin(pcons(key)(Agri), 100000))
                    CCS(key)(2) = AMAX(0, Amin(pcons(key)(Ener), 100000))
                    'CCS(key)(3) = 0 'bbh 2024/06/21 replace this with line below to pass materials to CS
                    CCS(key)(3) = AMAX(0, Amin(pcons(key)(Mate), 100000))
                    CCS(key)(4) = AMAX(0, Amin(pcons(key)(Manu), 100000))
                    CCS(key)(5) = AMAX(0, Amin(pcons(key)(Serv), 100000)) 'jrs 2026/08/27 This line was truncating consumption for the US, 10566.8711 
                    CCS(key)(6) = AMAX(0, Amin(pcons(key)(ICT), 100000))

                    Dim Vals5(6) As Single?
                    CGS.Add(key, Vals5)

                    CGS(key)(4) = AMAX(0, Amin(GMN(key), 10000))
                    CGS(key)(5) = AMAX(0, Amin(GSR(key), 10000))
                    CGS(key)(1) = 0
                    CGS(key)(2) = 0
                    CGS(key)(3) = 0
                    CGS(key)(6) = 0

                    Dim Vals6(6) As Single?
                    CINVS.Add(key, Vals6)

                    CINVS(key)(4) = AMAX(0, Amin(IMN(key), 10000))
                    CINVS(key)(1) = 0
                    CINVS(key)(2) = 0
                    CINVS(key)(3) = 0
                    CINVS(key)(5) = AMAX(0, Amin(ISR(key), 10000))
                    CINVS(key)(6) = 0

                    Dim Vals7(6) As Single?
                    CMS.Add(key, Vals7)

                    CMS(key)(1) = AMAX(0, Amin(MAG(key), 10000))
                    CMS(key)(2) = AMAX(0, Amin(MEN(key), 10000))
                    CMS(key)(3) = AMAX(0, Amin(MMA(key), 10000))
                    CMS(key)(4) = AMAX(0, Amin(MMN(key), 10000))
                    CMS(key)(5) = AMAX(0, Amin(MSR(key), 10000))
                    CMS(key)(6) = AMAX(0, Amin(MIC(key), 10000))

                    Dim Vals8(6) As Single?
                    CXS.Add(key, Vals8)

                    CXS(key)(1) = AMAX(0, Amin(XAG(key), 10000))
                    CXS(key)(2) = AMAX(0, Amin(XEN(key), 10000))
                    CXS(key)(3) = AMAX(0, Amin(XMA(key), 10000))
                    CXS(key)(4) = AMAX(0, Amin(XMN(key), 10000))
                    CXS(key)(5) = AMAX(0, Amin(XSR(key), 10000))
                    CXS(key)(6) = AMAX(0, Amin(XIC(key), 10000))
                Next

                '   Go to specialized routines to process input-output data for IFs
                '   -------------------------------------------------------------
                Call InputOutputDataAdjuster(cntx)
                Call CLABEMPSandCVADDReconciliation(cntx)  'bbh 2024/02/29
                Call RegionalInputOutputData(cntx)


                'mti 2018/05/16 Start
                'mti 2018/05/22 Start
                'ComputeLaborFunctionsPP
                'jrs 2025/09/17 why not in historic mode, we need those new functions
                ''jrs 2023/06/07
                'If Not cntx.HistoricMode Then
                'jrs 2019/02/15 this saves to TablFunc.mdb, so we're not doing it in translated code: ComputeLaborFunctionsCountry(cntx)
                ComputeLaborFunctionsCountry(cntx)
                'End If
                'mti 2018/05/22 End
                'mti 2018/05/16 End

                'Never call if historic data, only forecast - otherwise
                'will reset generic matrices with different GDP/Pop and
                'create different numbers than in forecast base.

                'if DevelopmentMode is true, then have full GTAP data and can
                '   create/update all individual country matrices; then create regional data
                'if DevelopmentMode is false, do not have GTAP country data, only
                '   IFs collapsed sectors for IFs database countries; so use
                '   country data to create regional data

                'jrs 2022/11/21
                If ConstantDollarsYear = 2011 Then
                    cntx.Store("CINCOMELTMID", CINCOMELT31)
                ElseIf ConstantDollarsYear = 2017 Then 'jrs 2025/09/12
                    cntx.Store("CINCOMELTMID", CINCOMELT365)
                Else 'jrs 2025/09/12
                    cntx.Store("CINCOMELTMID", CINCOMELT420)
                End If
                cntx.Store("CGINIDOM", CGINIDOM)

                RecomputePovertyOutput(cntx)

                NewGovConAdjAggregator(cntx)
                PreProcessGovConAdj(cntx)

                'Dyadic Forecast Initialization
                '-------------------------------
                'jrs 2019/05/03 removed frm_MainMenu.IFsGUIctrl1.cHistoricBase = False And
                If bDyadic Then
                    RecomputeEcDyadicOutput(cntx)

                    RedetermineEcDyadicBase(cntx)
                End If

                'jrs 2019/03/26
                Dim ValAddManu As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                For Each key In cntx.Regionalization.Keys
                    ValAddManu.Add(key, ValAdd(key)(Manu))
                Next
                cntx.Store("ValAddManu", ValAddManu)
                cntx.Store("CGCon", CGCon)
                cntx.Store("GExpDef", GExpDef)

                ' mark pre-processed for all three series
                Me.processed = True
            End Sub


            Public Overrides Function Regionalize(seriesName As String, cntx As IRebuildFacade) As IEnumerable(Of KeyValuePair(Of Integer, Single?))
                Me.PreProcess(cntx)

                Dim series As IDictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim weightSeries As IDictionary(Of String, Single?)
                weightSeries = CPOP
                Dim bAggSUM As Boolean = False
                Dim bApplyLimits As Boolean = False
                Dim MinLimit As Single, MaxLimit As Single

                'gvdb 2024/04/05
                ' unused variable
                'Dim Vals As IDictionary(Of Integer, Single?)

                Select Case seriesName
                    Case "AGMVALUE_Crop"
                        series = AGMCropValueTrade
                        bAggSUM = True
                        bApplyLimits = True
                        MinLimit = 0 '0.000001
                        MaxLimit = 10000
                    Case "AGMVALUE_Meat"
                        series = AGMMeatValueTrade
