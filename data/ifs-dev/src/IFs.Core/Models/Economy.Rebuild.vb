                            For LCount% = 1 To cntx.NSec
                                For SCount% = 1 To cntx.NSec
                                    '                If IsNull(AMatCountry(R%, LCount%, SCount%)) Then Stop
                                    ColumnName$ = "Ints" & LCount.ToString.Trim & SCount%.ToString.Trim
