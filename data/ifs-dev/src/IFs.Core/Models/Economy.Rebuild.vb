                                        CLABEMPS(ctry.Country)(SCount%, cntx.NSkill) = CLABEMPS(ctry.Country)(SCount%, cntx.NSkill) + CLABEMPS(ctry.Country)(SCount%, sk%)
                                    Next sk%
