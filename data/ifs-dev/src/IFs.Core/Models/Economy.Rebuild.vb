                    End If

                    'mti 2021/12/09 start
                    Dim FromLogNormal = 1       '1 - male female determmined using lognormal; 0 -> male female determined using sex diff versus total rate (total only) relationship
                    Dim SexDiff32(20) As Single?
                    'mti 2021/12/09 End

                    For Each key In cntx.Regionalization.Keys

                        If Not CPOVRATEMALE32(key)(1).HasValue Then  'scale from 19

                            'mti 2021/12/09 start
                            If FromLogNormal = 1 Then


                                For AGCount = 1 To TotPovAGCount
                                    SexDiff32(AGCount) = 0

                                    'female---------------
                                    portionpoor = CSng(Amin(0.9, CPOVRATEFEMALE(key)(AGCount) / 100))

                                    Dim NInv = CalcNormalInverse(portionpoor)
                                    NInv = AMAX(-3, NInv)       'for 5.5 poverty - 3; for 3.2 poverty 3.5, for 1.9 poverty 4
                                    '
                                    'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                                    Dim lnstddev = Sqrt(2) * CalcNormalInverse((CGINIDOM(key) + 1) / 2)
                                    Dim LNMean = Log(365 * Threshold1) - lnstddev * NInv

                                    portionpoor = CSng(CalcLogNormalCDF(365 * Threshold, CSng(LNMean), CSng(lnstddev)))
                                    Dim ValHold = AMAX(0, Amin(100, 100 * Round(portionpoor, 7))) 'jrs 2020/03/10 try it for Azerbaijan, not matching .NET
                                    CPOVRATEFEMALE32(key)(AGCount) = 100 * portionpoor

                                    'Male---------------
                                    portionpoor = CSng(Amin(0.9, CPOVRATEMALE(key)(AGCount) / 100))

