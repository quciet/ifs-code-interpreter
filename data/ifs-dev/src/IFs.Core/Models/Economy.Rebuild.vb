                                        If CPOPURBAN(ctry.Country) < 0.9 * CPOP(ctry.Country) Then                    'do it only for countries with significant amount of rural population
                                            If LabAgriShr / 100 > 1.05 * (CPOP(ctry.Country) - CPOPURBAN(ctry.Country)) / CPOP(ctry.Country) Then LabAgriShr = CSng(100 * 1.05 * (CPOP(ctry.Country) - CPOPURBAN(ctry.Country)) / CPOP(ctry.Country)) 'bbh 2021/09/30
                                        End If
                                        'If CountryName(ctry.Country) = "Chad" Then Stop
                                        LabAgriTot = CLAB(ctry.Country) * (1 - CLABUNEMPR(ctry.Country) / 100) * LabAgriShr / 100
                                        CLABEMPS(ctry.Country)(Agri, NSkill%) = CLABEMPS(ctry.Country)(Agri, Unskilled) + CLABEMPS(ctry.Country)(Agri, Skilled)
                                        For sk% = 1 To 2
