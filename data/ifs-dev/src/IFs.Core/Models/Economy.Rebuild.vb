                        Else
                            db2.Clear(GetType(GTAPIOAggregationCountry))
                            db2.Clear(GetType(GTAPValueAddedCountry))
                            db2.Clear(GetType(IFsIOCoefCalcCountry))
                        End If


                        Dim ConcTbl As IEnumerable(Of CountryTranslation)
                        'gvdb 2024/04/05
                        ' update for EF new syntax
                        ConcTbl = db.CountryTranslation.AsEnumerable()

                        'mti 2018/05/13 Start
                        Dim GTAPCnt As Integer
                        GTAPCnt% = 0
                        Dim GTAPNameAll As String
                        GTAPNameAll$ = ""
                        'mti 2018/05/13 End

                        'jrs 2019/01/31
                        ''mti 2018/05/16 start
                        'For ctry.Country = 1 To cntx.Regionalization.Keys.Count
                        '    GCountryNo(ctry.Country) = 0
                        'Next ctry.Country
                        ''mti 2018/05/16 End

                        'jrs 2025/07/18
                        'Load Labor Data from ILO (Agri, Manu and Serv) in Thousands
                        '===========================================================
                        ILOLabAg = New Dictionary(Of String, Single?)
                        ILOLabSer = New Dictionary(Of String, Single?)
                        ILOLabManu = New Dictionary(Of String, Single?)
                        Dim ILOTot As Single?
                        For Each item In (From s In cntx.GetSlice("SeriesLaborEmploymentAgILO", cntx.BaseYear, CoalescePolicy.MostRecent)
                                          Join s2 In cntx.GetSlice("SeriesLaborEmploymentSerILO", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                          Join s3 In cntx.GetSlice("SeriesLaborEmploymentManuILO", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s3.Key
                                          Select Key = s.Key, Ag = s.Value, Ser = s2.Value, Manu = s3.Value)
                            'Dividing by 1000 to convert to millions
                            ILOLabAg.Add(item.Key, item.Ag / 1000)
                            ILOLabSer.Add(item.Key, item.Ser / 1000)
                            ILOLabManu.Add(item.Key, item.Manu / 1000)
                            'jrs 2025/07/23
                            ILOTot = ILOLabAg(item.Key) + ILOLabManu(item.Key) + ILOLabSer(item.Key)
                            If ILOTot > 0.99 * CLAB(item.Key) Then
                                'Reduce them to match 99% of total Labor, Sahrawi is the only one where we need reduction
                                ILOLabAg(item.Key) = CSng(ILOLabAg(item.Key) * 0.99 * CLAB(item.Key) / ILOTot)
                                ILOLabSer(item.Key) = CSng(ILOLabSer(item.Key) * 0.99 * CLAB(item.Key) / ILOTot)
                                ILOLabManu(item.Key) = CSng(ILOLabManu(item.Key) * 0.99 * CLAB(item.Key) / ILOTot)
                            End If
                        Next


                        Dim ValHold As String, Gtapname As String
                        Dim GTAPDuplicate As Boolean
                        Dim IFsTotLab As Single?, TotPayments As Single?, NRatio As Double?, RowSum As Single?
                        Dim pcap As Single?, matval As Integer, g_pcap As Single?
                        For Each ctry As CountryTranslation In ConcTbl
