                                    '            IFsCoefUnskilled(LCount%, matval) = IFsCoefUnskilled(LCount%, matval) + _
                                    '                IFsUnskilled(LCount%) / (pcap * 1000) / AMAX(0.001, IFsColSums(LCount%))
                                    '            IFsCoefSkilled(LCount%, matval) = IFsCoefSkilled(LCount%, matval) + _
                                    '                IFsSkilled(LCount%) / (pcap * 1000) / AMAX(0.001, IFsColSums(LCount%))


                                    'Original BBH
