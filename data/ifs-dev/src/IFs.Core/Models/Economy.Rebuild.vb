                                'checkGTAPCoversTradeDefficit(IFsVADD, IFsMatrix, ctry.Country, cntx)


                                '       Compute coefficient matrices, factor vectors for IFs sectors by country
                                '       -----------------------------------------------------------------------
                                For SCount% = 1 To cntx.NSec 'Sum down columns
                                    IFsColSums(SCount%) = 0
                                    For LCount% = 1 To cntx.NSec 'rows vary
                                        IFsColSums(SCount%) = IFsColSums(SCount%) + IFsMatrix(LCount%, SCount%)
