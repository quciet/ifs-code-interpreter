            Private Sub MigrantFlowInitialization(cntx As IRebuildFacade)
                'Load Total Migration
                '---------------------
                Dim yrs As Short() = cntx.GetYearsDyad("SeriesMigrationFlowOutDL").OrderBy(Function(y) y).ToArray()
                Dim migTbl As IDictionary(Of String, Single?()) = cntx.GetDiceDyad("SeriesMigrationFlowOutDL", yrs)
                Dim YrIdx As Short, sYr As Short
                Dim YrsCount As Integer
                YrIdx = getYearIdx(yrs, yrs(yrs.Count - 1))
                YrsCount = yrs.Count
                Do While yrs(YrIdx) > cntx.BaseYear
                    YrIdx = YrIdx - 1S
                    'jrs 2020/10/08
                    YrsCount = YrsCount - 1
                    If YrIdx = 0 Then Exit Do
                Loop
                sYr = yrs(YrIdx)
                Dim sYrsMig0 As Short
                sYrsMig0 = yrs(0)
                CXDYADMIGRANTYRS = New Dictionary(Of String, Dictionary(Of String, Single?()))
                CXDYADMIGRANT = New Dictionary(Of String, Dictionary(Of String, Single?))
                CMDYADMIGRANT = New Dictionary(Of String, Dictionary(Of String, Single?))
                CXDYADMIGRANTMAVG = New Dictionary(Of String, Dictionary(Of String, Single?))

                Dim k As Integer
                Dim AbelGrossInYrs As Dictionary(Of String, Single()) = New Dictionary(Of String, Single())
                Dim AbelGrossOutYrs As Dictionary(Of String, Single()) = New Dictionary(Of String, Single())

                Dim sActor As String, sPartner As String

                For Each item In migTbl
                    sActor = item.Key.Split(";".ToCharArray)(0)
                    If Not CXDYADMIGRANT.ContainsKey(sActor) Then
                        CXDYADMIGRANT.Add(sActor, New Dictionary(Of String, Single?))
                    End If
                    If Not CXDYADMIGRANTYRS.ContainsKey(sActor) Then
                        CXDYADMIGRANTYRS.Add(sActor, New Dictionary(Of String, Single?()))
                    End If
                    If Not CMDYADMIGRANT.ContainsKey(sActor) Then
                        CMDYADMIGRANT.Add(sActor, New Dictionary(Of String, Single?))
                    End If
                    sPartner = item.Key.Split(";".ToCharArray)(1)
                    'CXDYADMIGRANT(sActor).Add(sPartner, migTbl(item.Key)(YrIdx) / 5) 'dsb 2025/10/17 
                    'Annualized data in DataMigrationFlowOutDL, no need to divide by 5
                    CXDYADMIGRANT(sActor).Add(sPartner, migTbl(item.Key)(YrIdx))
                    CMDYADMIGRANT(sActor).Add(sPartner, 0)
                    Dim VarVals(YrsCount) As Single?
                    If Not CXDYADMIGRANTYRS(sActor).ContainsKey(sPartner) Then
                        CXDYADMIGRANTYRS(sActor).Add(sPartner, VarVals)
                    End If
                    For k = YrIdx - 1 To 0 Step -1
                        'jrs 2018/03/23 if it's NULL and a year not multiple of 5 then look for the value of the last year that IS multiple of 5
                        'YrsFrom5 = yrs(k) Mod 5
                        'If Not (migTbl(item.Key)(k).HasValue) And YrsFrom5 <> 0 Then
                        '    CXDYADMIGRANTYRS(sActor)(sPartner)(k + 1) = migTbl(item.Key)(k + 5 - YrsFrom5) / 5
                        'Else
                        '    CXDYADMIGRANTYRS(sActor)(sPartner)(k + 1) = migTbl(item.Key)(k) / 5
                        'End If
                        'dsb 2025/10/17 Annualized data in DataMigrationFlowOutDL, no need to divide by 5
                        If migTbl(item.Key)(k).HasValue Then
                            CXDYADMIGRANTYRS(sActor)(sPartner)(k + 1) = migTbl(item.Key)(k)
                        Else
                            CXDYADMIGRANTYRS(sActor)(sPartner)(k + 1) = 0
                        End If
                    Next
                    'Initialize moving average 
                    If Not CXDYADMIGRANTMAVG.ContainsKey(sActor) Then
                        CXDYADMIGRANTMAVG.Add(sActor, New Dictionary(Of String, Single?))
                    End If
                    'Dim sumVals As Single = 0
                    'Dim countVals As Integer = 0
                    'For k = 0 To YrIdx
                    '    If migTbl(item.Key)(k).HasValue Then
                    '        sumVals = sumVals + migTbl(item.Key)(k).Value
                    '        countVals = countVals + 1
                    '    End If
                    'Next
                    'If countVals > 0 Then
                    '    CXDYADMIGRANTMAVG(sActor).Add(sPartner, sumVals / countVals)
                    'Else
                    '    CXDYADMIGRANTMAVG(sActor).Add(sPartner, 0)
                    'End If
                    'dsb 2026/07/07 Instead of moving average, use the median of the available years
                    Dim valuesList As New List(Of Single)
                    For k = 0 To YrIdx
                        If migTbl(item.Key)(k).HasValue Then
                            valuesList.Add(migTbl(item.Key)(k).Value)
                        End If
                    Next
                    If valuesList.Count > 0 Then
                        valuesList.Sort()
                        Dim median As Single
                        Dim midIndex As Integer = valuesList.Count \ 2
                        If valuesList.Count Mod 2 = 0 Then
                            ' Even number of elements, take the average of the two middle values
                            median = (valuesList(midIndex - 1) + valuesList(midIndex)) / 2.0F
                        Else
                            ' Odd number of elements, take the middle value
                            median = valuesList(midIndex)
                        End If
                        CXDYADMIGRANTMAVG(sActor).Add(sPartner, median)
                    Else
                        CXDYADMIGRANTMAVG(sActor).Add(sPartner, 0)
                    End If
                Next


            End Sub

