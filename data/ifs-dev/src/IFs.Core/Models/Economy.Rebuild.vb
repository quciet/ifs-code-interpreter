                        yrIdx = getYearIdx(yrsGovDebtPPGTbl, 1997)
                        PPGDEBT97 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (PPGDEBT97.HasValue) Then PPGDEBT97 = 0
                        yrIdx = yrIdx + 1S
                        PPGDEBT98 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (PPGDEBT98.HasValue) Then PPGDEBT98 = 0
                        yrIdx = yrIdx + 1S
                        PPGDEBT99 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (PPGDEBT99.HasValue) Then PPGDEBT99 = 0
                        yrIdx = yrIdx + 1S
                        PPGDEBT00 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (PPGDEBT00.HasValue) Then PPGDEBT00 = 0

                        '            Reserves95 = GovDebtPPGTbl(keyi)("1995")
                        '            If IsNull(Reserves95) Then Reserves95 = 0
                        '            Reserves96 = GovDebtPPGTbl(keyi)("1996")
                        '            If IsNull(Reserves96) Then Reserves96 = 0
                        yrIdx = getYearIdx(yrsGovDebtPPGTbl, 1997)
                        Reserves97 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (Reserves97.HasValue) Then Reserves97 = 0
                        yrIdx = yrIdx + 1S
                        Reserves98 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (Reserves98.HasValue) Then Reserves98 = 0
                        yrIdx = yrIdx + 1S
                        Reserves99 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (Reserves99.HasValue) Then Reserves99 = 0
                        yrIdx = yrIdx + 1S
                        Reserves00 = GovDebtPPGTbl(key)(yrIdx)
                        If Not (Reserves00.HasValue) Then Reserves00 = 0

                        '           Compute Apparent Reconciliaton of Capital and Current Account in Recent Years
                        '               using accumulation of government debt and change in reserves
                        '           -----------------------------------------------------------------------------

                        If PPGDEBT97 < 0.001 Or PPGDEBT98 < 0.001 _
                        Or PPGDEBT99 < 0.001 Or PPGDEBT00 < 0.001 Then
