                    For grd% = 1 To 7
                        If gndr% = 1 Then TbName$ = "SeriesEdPriEnrGr" + grd%.ToString.Trim + "MaleNo"
                        If gndr% = 2 Then TbName$ = "SeriesEdPriEnrGr" + grd%.ToString.Trim + "FemaleNo"
                        Dim yrs = cntx.GetYears(TbName$).OrderBy(Function(y) y).ToArray()
                        'jrs 2023/10/03 replaced nothing with New Dictionary(Of Integer, Short())
                        If gndr% = 1 Then yrsEdPriEnrGrTbl.Add(grd%, New Dictionary(Of Integer, Short()))
                        yrsEdPriEnrGrTbl(grd%).Add(gndr%, yrs)
                        EdPriEnrGrTbl(grd%, gndr%) = cntx.GetDice(TbName$, yrs)
                    Next
                Next

                '-------Dropout rates --------

                For gndr% = 1 To 3
                    For grd% = 1 To 6
                        If gndr% = 1 Then TbName$ = "SeriesEdPriDrpGr" + grd%.ToString.Trim + "Male"
                        If gndr% = 2 Then TbName$ = "SeriesEdPriDrpGr" + grd%.ToString.Trim + "Female"
