            Sub FillInEdPriGross(ByRef Intake As Single?, ByRef Enrol As Single?, ByRef Survival As Single?, lencycle As Single?, sCountryName As String, gndrInd%, MaxIntk As Single?, MinIntk As Single?, MaxEnrl As Single?, MinEnrl As Single?, MaxSurv As Single?, MinSurv As Single?, ByRef Intake_Imputed As Boolean, ByRef Enroll_Imputed As Boolean, ByRef Surv_Imputed As Boolean, cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2020/09/01 whole Procedure
                Try
                    Dim NoOfMissing As Integer
                    'mti 2020/09/01 start
                    If Not Intake.HasValue Then
                        NoOfMissing = NoOfMissing + 1

                        Intake_Imputed = True
                    Else
                        Intake_Imputed = False
                    End If

                    If Not Enrol.HasValue Then
                        NoOfMissing = NoOfMissing + 1
                        Enroll_Imputed = True
                    Else
                        Enroll_Imputed = False
                    End If

                    If Not Survival.HasValue Then
                        NoOfMissing = NoOfMissing + 1
                        Surv_Imputed = True
                    Else
                        Surv_Imputed = False
                    End If
                    'mti 2020/09/01 End
                    '  If gndrInd% = 1 Then
                    '  If CountryName(sCountryName) = "Somalia" Then Stop
                    '  If CountryName(sCountryName) = "Libya" Then Stop
                    '  If CountryName(sCountryName) = "Haiti" Then Stop
                    '  If CountryName(sCountryName) = "Taiwan China" Then Stop
                    '  If CountryName(sCountryName) = "Taiwan" Then Stop
                    '  If CountryName(sCountryName) = "Iraq" Then Stop
                    '
                    '  If CountryName(sCountryName) = "Zimbabwe" Then Stop
                    '  End If

                    Select Case NoOfMissing
                        Case 1
                            FillIn_One_Missing_Pri(Intake, Enrol, Survival, lencycle, sCountryName, gndrInd%, MaxIntk, MinIntk, MaxEnrl, MinEnrl, MaxSurv, MinSurv, cntx)
                        Case 2
                            If Not Intake.HasValue And Not Survival.HasValue Then   'have only enrol data
                                ImputePriSurvival(sCountryName, gndrInd%, Survival, MaxSurv, MinSurv, cntx) ''Survival is a better imputation
                                Adjust_Intake(lencycle, Survival, Enrol, Intake, MaxIntk, MinIntk)    ' Enrol, Survival

                            Else    'enrol is one of the missing; very unlikely
                                ImputePriEnrol(sCountryName, gndrInd%, Enrol, MaxEnrl, MinEnrl, cntx)
                                FillIn_One_Missing_Pri(Intake, Enrol, Survival, lencycle, sCountryName, gndrInd%, MaxIntk, MinIntk, MaxEnrl, MinEnrl, MaxSurv, MinSurv, cntx)
                            End If
                        Case 3
                            ImputePriEnrol(sCountryName, gndrInd%, Enrol, MaxEnrl, MinEnrl, cntx)
                            ImputePriSurvival(sCountryName, gndrInd%, Survival, MaxSurv, MinSurv, cntx)
                            Adjust_Intake(lencycle, Survival, Enrol, Intake, MaxIntk, MinIntk)
                        Case Else 'none missing; i.e., all recorded
                            '                If Is_Consistent(Intake, Enrol) Then
                            '                    'sSurvival = Survival
                            '                    Adjust_Survival lencycle, Intake, Enrol, Survival, MaxSurv, MinSurv
                            '                    'If Survival - sSurvival > 15 Then  'too large
                            '                    '    Survival = sSurvival + 15
                            '                    '    Adjust_Intake lencycle, Survival, Enrol, Intake, MaxIntk, MinIntk
                            '                    'End If
                            '                Else
                            '                    Adjust_Intake lencycle, Survival, Enrol, Intake, MaxIntk, MinIntk
                            '                End If

                    End Select
                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: FillInEdPriGross - " & sCountryName & " " & ex.Message)
                    '& Chr(13) & CStr(err.number) & " " & err.Description
                End Try
            End Sub

            Private Sub ImputePriSurvival(ByVal sCountryName As String, ByVal gndr%, ByRef Survival As Single?, ByVal MaxSurv As Single?, ByVal MinSurv As Single?, ByRef cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2020/09/01 Whole Proc
                'mti 2020/06/16 New Procedure
                Try
                    Dim Func As String
                    Dim Surv As Single

                    If cntx.HistoricMode Then

                        If gndr% = Male Then

                            Call XYTABL("GDP/Capita (PPP) Versus Primary Survival Rate Male(1970)",
                        CSng(CGDPPCP(sCountryName)), Surv, cntx)

                        ElseIf gndr% = Female Then

                            Call XYTABL("GDP/Capita (PPP) Versus Primary Survival Rate Female(1970)",
                        CSng(CGDPPCP(sCountryName)), Surv, cntx)

                        ElseIf gndr% = NGender Then

                            Call XYTABL("GDP/Capita (PPP) Versus Primary Survival Rate Total(1970)",
                        CSng(CGDPPCP(sCountryName)), Surv, cntx)

                        End If
                        Survival = Surv
                    Else

                        If gndr% = Male Then
                            Func = "GDP/Capita (PPP 2011) Versus Primary Survival Rate Male (" & CStr(BaseYear) & ") Log"
                        ElseIf gndr% = Female Then
                            Func = "GDP/Capita (PPP 2011) Versus Primary Survival Rate Female (" & CStr(BaseYear) & ") Log"
                        ElseIf gndr% = NGender Then
                            Func$ = "GDP/Capita (PPP 2011) Versus Primary Survival Rate Total (" & CStr(BaseYear) & ") Log"
                        End If

                        Func = getFunctionNameYrOrMstRct(Func$, BaseYear, cntx)

                        Call XYTABL(Func$, CSng(CGDPPCP(sCountryName)), Surv, cntx)
                        Survival = Surv
                    End If

                    Survival = Amin(MaxSurv, AMAX(MinSurv, Survival))


                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: ImputePriSurvival " & ex.Message) ' & Chr(13) & CStr(err.number) & " " & err.Description

                End Try

            End Sub

            Sub FillIn_One_Missing_Pri(ByRef Intake As Single?, ByRef Enrol As Single?, ByRef Survival As Single?, lencycle As Single?, sCountryName As String, gndrInd%, MaxIntk As Single?, MinIntk As Single?, MaxEnrl As Single?, MinEnrl As Single?, MaxSurv As Single?, MinSurv As Single?, cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2023/10/15 

                'mti 2020/06/16 New Procedure

                If Not Intake.HasValue Then
                    Adjust_Intake(lencycle, Survival, Enrol, Intake, MaxIntk, MinIntk)
                ElseIf Not Survival.HasValue Then

                    'mti 2021/03/31 Start
                    'ImputePriSurvival sCountryName, gndrInd%, Survival, MaxSurv, MinSurv
                    'If CGDPPCP(sCountryName) > 5 Then    'UMIC
                    If CGDPPCP(sCountryName) > 5 And Enrol <= Intake Then    'UMIC
                        Adjust_Survival(lencycle, Intake, Enrol, Survival, MaxSurv, MinSurv)
                        'Debug.Print CountryName(sCountryName); Intake; Enrol; Survival; "Survival used constant flow"
                    Else
                        ImputePriSurvival(sCountryName, gndrInd%, Survival, MaxSurv, MinSurv, cntx)
                    End If
                    'mti 2021/03/31 End

                Else  'IsNull(Enrollment) ; very unlikely
                    Adjust_Enrol(lencycle, Survival, Intake, Enrol, MaxEnrl, MinEnrl)
                    'ImputePriEnrol sCountryName, gndrInd%, Enrol, MaxEnrl, MinEnrl   'this imputed data stays in first year then and survival changes
                End If

            End Sub

            Sub Adjust_Intake(lencycle As Single?, Survival As Single?, Enrol As Single?, ByRef Intake As Single?, MaxIntk As Single?, MinIntk As Single?)
                '---------------------------------------------------------------------
                'mti 2020/06/16 New Procedure
                Try
                    Intake = CSng(Amin(MaxIntk, CalcIntakeFromSurvEnr(lencycle, Survival, Enrol)))
                    Intake = AMAX(MinIntk, Amin(MaxIntk, Intake))
                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: Adjust_Intake " & ex.Message) ' & Chr(13) & CStr(err.number) & " " & err.Description
                End Try

            End Sub

            Sub Adjust_Survival(lencycle As Single?, Intake As Single?, Enrol As Single?, ByRef Survival As Single?, MaxSurv As Single?, MinSurv As Single?)
                '---------------------------------------------------------------------
                'mti 2020/06/16 New Procedure
                Try
                    Dim Dropout As Single

                    Dropout = CSng(AMAX(0, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrol)))
                    Survival = CSng(Amin(MaxSurv, 100 * ((1 - Dropout) ^ (lencycle - 1))))
                    Survival = AMAX(MinSurv, Amin(MaxSurv, Survival))


                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: Adjust_Survival ") ' & Chr(13) & CStr(err.number) & " " & err.Description

                End Try
            End Sub

            Sub Adjust_Enrol(lencycle As Single?, Survival As Single?, Intake As Single?, ByRef Enrol As Single?, MaxEnrl As Single?, MinEnrl As Single?)
                '---------------------------------------------------------------------
                'mti 2020/06/16 New Procedure
                Try
                    Enrol = CSng(CalcEnrfromIntakeNSurv(lencycle, Intake, Survival))
                    Enrol = AMAX(MinEnrl, Amin(MaxEnrl, Enrol))

                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: Adjust_Enrol ") ' & Chr(13) & CStr(err.number) & " " & err.Description
                End Try

            End Sub

