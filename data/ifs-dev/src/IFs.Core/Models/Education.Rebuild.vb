                End If
                'mti 2017/01/24 end

                'Intake rate using transition rate and previous data
                Dim Intk As Single?
                'mti 2021/08/13 Intk = PrevCompletionRate * TransitionRate / 100
                Intk = AMAX(2, PrevCompletionRate * TransitionRate / 100)

                'Dropout = 1 - (GradRate / EnrGrossRate) ^ (1 / (lencycle - 1)) ' CalcDropoutFromEnrNGrad(lencycle, EnrGrossRate, GradRate)

                'mti 2017/01/24 start
                'mti 2019/11/22 start
                'GradRate = Amin(Intk, GradRate)
                GradRate = Amin(Intk - 1, GradRate)
                'mti 2021/08/13
                EnrGrossRate = CSng(AMAX(1.5, EnrGrossRate))
                GradRate = Amin(EnrGrossRate - 1, GradRate)
                'mti 2019/11/22 End
                'mti 2017/01/24 end

                Dim Dropoutrate As Single?, Survival As Single?, ReqdIntk As Double?
                Dropoutrate = CSng(1 - (GradRate / Intk) ^ (1 / lencycle))

                Survival = CSng(100 * ((1 - Dropoutrate) ^ (lencycle - 1)))

                'Intake Rate required for the consistent flow in lower secondary
                ReqdIntk = CalcIntakeFromSurvEnr(lencycle, Survival, EnrGrossRate, 2)

                'ReqdIntk = EnrGrossRate + (EnrGrossRate - GradRate) / 2

                'Intake gap in lower secondary
                Dim IntkGap As Single
                IntkGap = CSng(ReqdIntk - Intk)

                If Math.Abs(IntkGap) > 10 Then
                    'mti 2019/11/22 start
                    If Not EnrGrossRateFromData Then ' And GradRateFromData And TransitionRateFromData Then
                        'mti 2019/12/09 start
                        EnrGrossRate = CSng(AMAX(5, Amin(150, CalcEnrfromIntakeNSurv(lencycle, Intk, Survival))))
                        'mti 2019/12/09 End
                    Else
                        'mti 2019/11/22 End
                        'mti 2019/10/25 start
                        If Not GradRateFromData Then
                            If IntkGap > 0 Then
                                GradRate = AMAX(Intk - 5, GradRate)
                            Else
                                GradRate = AMAX(5, GradRate - 5)
                            End If
                            Dropoutrate = CSng(1 - (GradRate / Intk) ^ (1 / lencycle))
                            Survival = CSng(100 * ((1 - Dropoutrate) ^ (lencycle - 1)))
                            ReqdIntk = CalcIntakeFromSurvEnr(lencycle, Survival, EnrGrossRate, 2)
                        End If
                        'mti 2019/10/25 End

                        'boost transition rate to boost intake
                        'mti 2019/11/12 start
                        If TransitionRateFromData Then
                            TransitionRate = CSng(Amin(99, (ReqdIntk + Intk) / 2 / (PrevCompletionRate) * 100))  '100 ''mti 2019/11/12 End
                            'TransitionRate = Amin(99, AMAX(GradRate + 2, (ReqdIntk + Intk) / 2) / (PrevCompletionRate) * 100) '100 ''mti 2019/11/12 End
                        Else
                            TransitionRate = CSng(Amin(99, ReqdIntk / (PrevCompletionRate) * 100))   '100 ''mti 2019/11/12 End
                        End If
                        'mti 2019/11/12 End

                        'mti 2019/11/01 start
                        Intk = PrevCompletionRate * TransitionRate / 100

                        'mti 2019/0/28 new  Intk -> 93; Enrg - 95??
                        Dropoutrate = CSng(1 - (GradRate / Intk) ^ (1 / lencycle))
                        Survival = CSng(100 * ((1 - Dropoutrate) ^ (lencycle - 1)))
                        'mti 2019/0/28 new

                    End If


                End If

                '            If lencycle > 2 Then
                '                GRateCalc = CalcGRateFromSurvNIntkNEnr(lencycle, Survival, Intk, EnrGrossRate)
                '            Else
                'mti 2019/11/22 Start
                'GRateCalc = Intk * Survival / 100 - 100 * Dropoutrate
                Dim GRateCalc = Intk * Survival / 100 * (1 - Dropoutrate)
                'mti 2019/11/22 End
                ''            End If
                GRateCalc = AMAX(5, Amin(150, GRateCalc))
                GradRate = (GradRate + GRateCalc) / 2
                'mti 2019/11/01 End


            End Sub

