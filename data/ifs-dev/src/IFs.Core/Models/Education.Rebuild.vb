                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    Dim years As Short() = cntx.GetYears("SeriesEdTerEnrollGrossMale").OrderBy(Function(y) y).ToArray()
                    Dim EDTerEnrgTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdTerEnrollGrossMale", years)

