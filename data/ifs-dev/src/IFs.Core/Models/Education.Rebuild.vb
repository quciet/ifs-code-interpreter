                    Next
                End If

                Dim secgradratet As Single?
                For Each key In cntx.Regionalization.Keys
                    If CEDTERGRATET(key) < 1.5 * CEDTERPERT(key) Then 'Boost graduate rate above average population percentage

                        CEDTERGRATET(key) = CSng(1.5 * CEDTERPERT(key))


                        CEDTERINTT(key) = AMAX(CEDTERINTT(key), CSng(CEDTERGRATET(key) / 0.9)) 'recompute intake to assure above graudation
                    End If

                    'make sure tertiary intake rate is less than secondary graduation rate
                    secgradratet = CEDSECENRNT(key) 'enrn as proxy
                    If CEDTERINTT(key) > 0.85 * secgradratet Then  '.8
                        CEDTERINTT(key) = CSng(0.85 * secgradratet)
                    End If

                    'Graduate rate relative to intake rate and population percentage
                    CEDTERGRATET(key) = AMAX(CSng(0.3 * CEDTERINTT(key)), Amin(CSng(0.9 * CEDTERINTT(key)), CEDTERGRATET(key)))


                    CEDTERGRATET(key) = Amin(CEDTERENRGT(key) - 2, CEDTERGRATET(key))

                    'mti January 17, 2012 - start
                    'CEDTERGRATET(key) = AMAX(0.1, Amin(120, CEDTERGRATET(key)))
