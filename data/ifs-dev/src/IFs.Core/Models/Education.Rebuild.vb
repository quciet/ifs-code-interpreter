                    'NetEnrollment = CalcEnrfromIntakeNSurv(lencycle, NetIntake, NSurvival)
                    'NetIntake = AMAX(5, CalcIntakeFromSurvEnr(lencycle, NSurvival, NetEnrollment, 2, CSng(Intake), CSng(Survival)))
                    'mti 2019/11/01 start
                    If NetEnrollFromData Then
