            Sub ReadEdData(DataTbl As IDictionary(Of String, Single?()), years() As Short, DataTblName As String,
                           sCountryName As String, DataTbl1 As IDictionary(Of String, Single?()), years1() As Short,
                           DataTbl1Name As String, ByRef VarData As Single?, cntx As IRebuildFacade, Optional MaxVal As Single = 100, Optional MinVal As Single = 0, Optional HistMaxval As Single = 100, Optional HistMinval As Single = 0, Optional Proximity As Integer = 7, Optional HistProximity As Integer = 100, Optional UYr% = 0)
                'mti 2023/11/24 changed the default value of proximity to 7, because the base year is advanced by two years to 2019; while data is still not updated 
                '---------------------------------------------------------------------
                'mti 2020/09/01 New Procedure
                'mti 2020/06/16 New Procedure
                Try
                    'Read data from tables
                    If cntx.HistoricMode Then
                        VarData = getClosestYrVal(DataTbl, years, sCountryName, cntx.FirstYear, CShort(HistProximity))

                        If Not VarData.HasValue And DataTblName <> DataTbl1Name Then
                            VarData = getClosestYrVal(DataTbl1, years1, sCountryName, cntx.FirstYear, CShort(HistProximity))
                        End If

                        If VarData < HistMinval Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too Low; " + CStr(VarData))
                        ElseIf VarData > HistMaxval Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too high; " + CStr(VarData))
                        End If

                    Else
                        Dim MRval = getMR(DataTbl, years, sCountryName)
                        VarData = getYearAroundOrRecent(DataTbl, years, sCountryName, MRval, BaseYear, False, Proximity, UYr%)
                        If Not VarData.HasValue And DataTblName <> DataTbl1Name Then
                            MRval = getMR(DataTbl1, years1, sCountryName)
                            VarData = getYearAroundOrRecent(DataTbl1, years1, sCountryName, MRval, BaseYear, False, Proximity, UYr%)
                        End If

                        If VarData < MinVal Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too Low; " + CStr(VarData))
                        ElseIf VarData > MaxVal Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too high; " + CStr(VarData))
                        End If


                    End If


                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: ReadEdData " & ex.Message)
                    'Debug.Print(Error.Description)
                End Try

            End Sub

            Sub ReadEdDataExt(DataTbl As IDictionary(Of String, Single?()), years() As Short, sCountryName As String, DataTblName As String, DataTbl1 As IDictionary(Of String, Single?()), years1() As Short, DataTbl2 As IDictionary(Of String, Single?()), years2() As Short, ByRef VarData As Single?, cntx As IRebuildFacade, Optional MaxVal As Single? = 100, Optional MinVal As Single? = 0, Optional HistMaxval As Single? = 100, Optional HistMinval As Single? = 0, Optional Proximity As Integer = 5, Optional HistProximity As Integer = 100, Optional UYr% = 0)
                'mti 2024/05/07 byref added to return value 
                '---------------------------------------------------------------------
                'mti 2020/09/01 New Procedure ', Optional UsedYear% = 0
                'mti 2020/06/16 New Procedure

                Try
                    'Read data from tables
                    Dim VarData1, VarData2 As Single?
                    Dim UYr1, UYr2 As Integer

                    If cntx.HistoricMode Then
                        UYr = 0
                        VarData = getClosestYrVal(DataTbl, years, sCountryName, cntx.FirstYear, CShort(HistProximity), UYr)
                        VarData1 = getClosestYrVal(DataTbl1, years, sCountryName, cntx.FirstYear, CShort(HistProximity), UYr1%)
                        VarData2 = getClosestYrVal(DataTbl2, years, sCountryName, cntx.FirstYear, CShort(HistProximity), UYr2%)
                        VarData = VarData + VarData1 + VarData2
                        If (UYr + UYr1 + UYr2) / 3 > UYr + 3 Or (UYr + UYr1 + UYr2) / 3 < UYr - 3 Then  'not enough close points
                            VarData = Nothing
                        End If

                        If VarData < HistMinval Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too Low; " + CStr(VarData))
                        ElseIf VarData > HistMaxval Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too high; " + CStr(VarData))
                        End If

                    Else
                        UYr = 0
                        Dim yr% = BaseYear
                        Dim MRval As Single?
                        Do While True
                            MRval = getMR(DataTbl, years, sCountryName)
                            VarData = getYearAroundOrRecent(DataTbl, years, sCountryName, MRval, yr, False, 2, UYr%)  'mti 2024/05/07 changed 0 to 2
                            MRval = getMR(DataTbl1, years1, sCountryName)
                            VarData1 = getYearAroundOrRecent(DataTbl1, years1, sCountryName, MRval, yr, False, 2, UYr%) 'mti 2024/05/07 'changed 0 to 2
                            MRval = getMR(DataTbl2, years2, sCountryName)
                            VarData2 = getYearAroundOrRecent(DataTbl2, years2, sCountryName, MRval, yr, False, 2, UYr%) 'mti 2024/05/07 changed 0 to 2
                            VarData = VarData + VarData1 + VarData2
                            If VarData.HasValue Then
                                UYr = yr
                                Exit Do
                            Else
                                If yr < BaseYear - Proximity Then  '4 '3
                                    yr = BaseYear + 1
                                ElseIf yr > BaseYear + Proximity Then  '3
                                    Exit Do
                                ElseIf yr <= BaseYear Then
                                    yr = yr - 1
                                Else
                                    yr = yr + 1
                                End If
                            End If
                        Loop


                        If VarData < MinVal Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too Low; " + CStr(VarData))
                        ElseIf VarData > MaxVal Then
                            Debug.Print("Education Pre-Processor Warning: Value for " + sCountryName + " in Table " + DataTblName + " is too high; " + CStr(VarData))
                        End If


                    End If

                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: ReadEdData " & ex.Message) ' & Chr(13) & CStr(err.number) & " " & err.Description
                End Try

            End Sub

            Private Sub GradEnrFromLineFit(GradeEnr As Dictionary(Of String, Single?(,)), sCountryName As String, gndr%)
                'mti 2021/03/29

                'On Error GoTo lab_coeff_err

                Dim reg As New RegressionObject
                Dim Survival, GradRate As Single?
                If gndr% = 1 Then
                    Survival = CEDPRISURM(sCountryName)
                    GradRate = CEdPriCRM(sCountryName)
                ElseIf gndr% = 2 Then
                    Survival = CEDPRISURF(sCountryName)
                    GradRate = CEdPriCRF(sCountryName)
                Else
                    Survival = CEDPRISURT(sCountryName)
                    GradRate = CEdPriCRT(sCountryName)
                End If

                If Not GradeEnr(sCountryName)(CInt(CEdprilen(sCountryName)), gndr%).HasValue Then    'fill in last grade using completion rate and survival
                    'mti 2023/10/09
                    Dropoutrate = CSng(AMAX(0.005, 1 - (If(Survival.HasValue, Survival, 0) / 100) ^ (1 / (CEdprilen(sCountryName) - 1))))   'aaverage dropout rate - do not have grade-wise dropout rate yet
                    GradeEnr(sCountryName)(CInt(CEdprilen(sCountryName)), gndr%) = GradRate / (1 - Dropoutrate)

                    'can use other grades at this point
                End If

                With reg
                    .Init()
                    .Degree = 1 'Degree
                    Dim pt = 0
                    For grdNo% = 1 To CInt(CEdprilen(sCountryName))
                        If GradeEnr(sCountryName)(grdNo%, gndr%).HasValue Then
                            .XYAdd(grdNo%, CDbl(GradeEnr(sCountryName)(grdNo%, gndr%)))
                            pt = pt + 1
                        End If
                    Next grdNo%

                    Dim A = reg.Coeff(0)
                    Dim B = reg.Coeff(1)

                    For grdNo% = 1 To CInt(CEdprilen(sCountryName))
                        If Not GradeEnr(sCountryName)(grdNo%, gndr%).HasValue Then
                            GradeEnr(sCountryName)(grdNo%, gndr%) = CSng(A + B * grdNo%)
                        End If
                    Next grdNo%


                End With

            End Sub

            Private Sub GradEnrFromLineFitSecLowr(GradeEnr As Dictionary(Of String, Single?(,)), sCountryName As String, gndr%)
                'mti 2021/03/29

                'On Error GoTo lab_coeff_err

                Dim reg As New RegressionObject
                Dim Survival, GradRate, GenShare As Single?
                Dim pt As Integer

                If gndr% = 1 Then
                    Survival = Amin(100, 100 * CEDSECLowrGRateM(sCountryName) / CEdPriEnrGGrd(sCountryName)(CInt(CEdprilen(sCountryName)), gndr%) * CEDSECLowrTRANM(sCountryName))
                    GradRate = CEDSECLowrGRateM(sCountryName)
                    GenShare = (100 - CEdSecLowrVocM(sCountryName)) / 100
                ElseIf gndr% = 2 Then
                    Survival = Amin(100, 100 * CEDSECLowrGRateF(sCountryName) / CEdPriEnrGGrd(sCountryName)(CInt(CEdprilen(sCountryName)), gndr%) * CEDSECLowrTRANF(sCountryName))
                    GradRate = CEDSECLowrGRateF(sCountryName)
                    GenShare = (100 - CEdSecLowrVocF(sCountryName)) / 100
                Else
                    Survival = Amin(100, 100 * CEDSECLowrGRateT(sCountryName) / CEdPriEnrGGrd(sCountryName)(CInt(CEdprilen(sCountryName)), gndr%) * CEDSECLowrTRANT(sCountryName))
                    GradRate = CEDSECLowrGRateT(sCountryName)
                    GenShare = AMAX(1, Amin(100, (100 - CEdSecLowrVocF(sCountryName)) / 100))
                End If

                If Not GradeEnr(sCountryName)(CInt(CEdseclowrlen(sCountryName)), gndr%).HasValue Then    'fill in last grade using completion rate and survival
                    Dropoutrate = CSng(AMAX(0.005, 1 - (Survival / 100) ^ (1 / CEdseclowrlen(sCountryName))))    'average dropout rate - do not have grade-wise dropout rate yet; added one more grade, as it is going to graduation
                    GradeEnr(sCountryName)(CInt(CEdseclowrlen(sCountryName)), gndr%) = GradRate * GenShare / (1 - Dropoutrate)

                    'can use other grades at this point
                End If

                With reg
                    .Init()
                    .Degree = 1 'Degree
                    pt = 0
                    For grdNo% = 1 To CInt(CEdseclowrlen(sCountryName))
                        If GradeEnr(sCountryName)(grdNo%, gndr%).HasValue Then
                            .XYAdd(grdNo%, CDbl(GradeEnr(sCountryName)(grdNo%, gndr%)))
                            pt = pt + 1
                        End If
                    Next grdNo%

                    Dim A = reg.Coeff(0)
                    Dim B = reg.Coeff(1)

                    For grdNo% = 1 To CInt(CEdseclowrlen(sCountryName))
                        If Not GradeEnr(sCountryName)(grdNo%, gndr%).HasValue Then
                            GradeEnr(sCountryName)(grdNo%, gndr%) = CSng(A + B * grdNo%)
                        End If
                    Next grdNo%


                End With

            End Sub

            Sub FillInEdSecLowrGross(ByRef Transition As Single?, ByRef Enrol As Single?, ByRef GradRate As Single?, lencycle As Single?, sCountryName As String, gndrInd%, MaxTran As Single?, MinTran As Single?, MaxEnrl As Single?, MinEnrl As Single?, MaxGrad As Single?, MinGrad As Single?, Transition_Imputed As Boolean?, Enroll_Imputed As Boolean?, GradRate_Imputed As Boolean?, cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2020/09/01 whole Procedure

                Try
                    Dim NoOfMissing As Integer
                    'mti 2020/09/01 start
                    If Not Transition.HasValue Then
                        NoOfMissing = NoOfMissing + 1

                        Transition_Imputed = True
                    Else
                        Transition_Imputed = False
                    End If

                    If Not Enrol.HasValue Then
                        NoOfMissing = NoOfMissing + 1
                        Enroll_Imputed = True
                    Else
                        Enroll_Imputed = False
                    End If

                    If Not GradRate.HasValue Then
                        NoOfMissing = NoOfMissing + 1
                        GradRate_Imputed = True
                    Else
                        GradRate_Imputed = False
                    End If

                    '  If CountryName(sCountryName) = "Iraq" Then Stop
                    '


                    Select Case NoOfMissing
                        Case 1
                            FillIn_One_Missing_SecLowr(Transition, Enrol, GradRate, lencycle, sCountryName, gndrInd%, MaxTran, MinTran, MaxEnrl, MinEnrl, MaxGrad, MinGrad, cntx)
                        Case 2
                            If Not Transition.HasValue And Not GradRate.HasValue Then   'have only enrol data

                                ImputeSecLowrTransition(sCountryName, gndrInd%, Transition, MaxTran, MinTran, cntx)

                                'adjustment? Adjust_Intake lencycle, GradRate, Enrol, Intake, MaxIntk, MinIntk
                                'mti 2023/04/10 start
                                MaxGrad = Amin(AMAX(1, Enrol - 1), MaxGrad)
                                'mti 2023/04/10 end

                                ImputeSecLowrGradRate(sCountryName, gndrInd%, GradRate, MaxGrad, MinGrad, cntx)


                            Else    'enrol is one of the missing; very unlikely

                                ImputeSecLowrEnrol(sCountryName, gndrInd%, Enrol, MaxEnrl, MinEnrl, cntx)
                                FillIn_One_Missing_SecLowr(Transition, Enrol, GradRate, lencycle, sCountryName, gndrInd%, MaxTran, MinTran, MaxEnrl, MinEnrl, MaxGrad, MinGrad, cntx)

                            End If

                        Case 3
                            ImputeSecLowrEnrol(sCountryName, gndrInd%, Enrol, MaxEnrl, MinEnrl, cntx)

                            ImputeSecLowrTransition(sCountryName, gndrInd%, Transition, MaxTran, MinTran, cntx)

                            'adjsut? Adjust_Intake lencycle, GradRate, Enrol, Intake, MaxIntk, MinIntk

                            ImputeSecLowrGradRate(sCountryName, gndrInd%, GradRate, MaxGrad, MinGrad, cntx)

                        Case Else 'none missing; i.e., all recorded


                    End Select

                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: FillInEdSecLowrGross - " & sCountryName & " " & ex.Message) '& Chr(13) & CStr(err.number) & " " & err.Description
                End Try

            End Sub

            Sub FillInEdPriNet(ByRef IntakeNet As Single?, ByRef IntakeGross As Single?, ByRef EnrolNet As Single?, EnrolGross As Single?, Survival As Single?, lencycle As Single?, sCountryName As String, gndrInd%, IntakeNet_Imputed As Boolean, EnrolNet_Imputed As Boolean, cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2020/09/01 whole Procedure

                Try
                    If Not EnrolNet.HasValue Then
                        '        If Not IsNull(IntakeNet) Then
                        '            Adjust_Enrol lencycle, Survival, IntakeNet, EnrolNet, 100, 5
                        '        Else
                        ImputePriEnrollNet(sCountryName, gndrInd%, EnrolNet, 100, 5, cntx)
                        '        End If
                        EnrolNet_Imputed = True
                    Else
                        EnrolNet_Imputed = False
                    End If

                    'adjust net enrollment with gross here
                    If EnrolNet > EnrolGross Then
                        EnrolNet = CSng(EnrolGross - 0.5 * (100 - Survival))
                        EnrolNet_Imputed = True
                    End If

                    If Not IntakeNet.HasValue Then

                        'Adjust_Intake lencycle, Survival, EnrolNet, IntakeNet, 100, 5

                        ImputePriIntakeNet(sCountryName, gndrInd%, IntakeNet, 100, 5, cntx)

                        IntakeNet_Imputed = True
                    Else
                        IntakeNet_Imputed = False
                    End If

                    'net intake cannot go above gross intake
                    If IntakeNet > IntakeGross Then
                        If IntakeNet_Imputed Then
                            IntakeNet = CSng(IntakeGross - 0.75 * (100 - Survival))
                        Else
                            Debug.Print("Education Pre-Processor Warning: Value for Net Intake (Ext) rate is greater than Gross Intake Rate. Setting net intake to the same value as gross. Country " + sCountryName)
                            IntakeNet = IntakeGross
                        End If
                    End If

                    'adjust net intake with gross intake

                Catch ex As Exception
                    Debug.Print("Error in Educ PPc: FillInEdPriNet - " & sCountryName & " " & ex.Message)
                End Try

            End Sub

            Sub FillIn_One_Missing_SecLowr(ByRef Transition As Single?, ByRef Enrol As Single?, ByRef GradRate As Single?, lencycle As Single?, sCountryName As String, gndrInd%, MaxTran As Single?, MinTran As Single?, MaxEnrl As Single?, MinEnrl As Single?, MaxGrad As Single?, MinGrad As Single?, cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2020/06/16 New Procedure

                If Not Transition.HasValue Then
                    ImputeSecLowrTransition(sCountryName, gndrInd%, Transition, MaxTran, MinTran, cntx)
                    'bring in line with primary completion?
                ElseIf Not GradRate.HasValue Then
                    ImputeSecLowrGradRate(sCountryName, gndrInd%, GradRate, MaxGrad, MinGrad, cntx)
                    'adjust with other?
                Else  'IsNull(Enrollment) ; very unlikely
                    ImputeSecLowrEnrol(sCountryName, gndrInd%, Enrol, MaxEnrl, MinEnrl, cntx)   'this imputed data stays in first year then and GradRate changes
                End If

            End Sub

