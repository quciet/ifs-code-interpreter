                    End If

                    If CEDTERENRGF(key) < CEDTERGRATEF(key) Then 'Stop
                        '    Debug.Print CountryName$(key); CEDTERINTF(key); CEDTERENRGF(key); CEDTERGRATEF(key);
                        dout = CalcDropoutFromEnrNIntk(5, CEDTERINTF(key), CEDTERENRGF(key))
                        If dout < 0.7 And dout >= 0 Then
                            'mti January 17, 2012 - start
                            CEDTERGRATEF(key) = AMAX(0.1, Amin(60, CSng(CEDTERINTF(key) * (1 - dout) ^ 5))) '120
                            'mti January 17, 2012 - end
                            '        Debug.Print "female grate changed"; CEDTERGRATEF(key)
                        Else
                            dout = Amin(0.5, 5 / CEDTERENRGF(key))
                            Surv = CSng(100 * ((1 - dout) ^ (5 - 1))) 'ter len =5
                            'mti January 17, 2012 - start
                            CEDTERINTF(key) = CSng(AMAX(0.5F, Amin(100.0F, CalcIntakeFromSurvEnr(5, Surv, CEDTERENRGF(key))))) '120
                            CEDTERGRATEF(key) = AMAX(0.1, Amin(60, CSng(CEDTERINTF(key) * (1 - dout) ^ 5))) '120
                            'mti January 17, 2012 - end
                            '        Debug.Print "female grate and intake changed"; CEDTERGRATEF(key)
                        End If
                    End If

                    RecomputeEducateGRateHist(cntx, key, GDPPCPPPTblCur, yrsGDPPCP, EDPriCRMaleTbl, yrsEDPriCRMale,
                                                   EDPriIntMaleTbl, yrsEDPriIntMale, EDPriEnrGMaleTbl, yrsEDPriEnrGMale,
                                                   EDPriSurMaleTbl, yrsEDPriSurMale, EDPriEnrNMaleTbl, yrsEDPriEnrNMale,
                                                   EDPriIntNMaleTbl, yrsEDPriIntNMale, EDPriCRFemTbl, yrsEDPriCRFem,
                                                   EDPriIntFemTbl, yrsEDPriIntFem, EDPriEnrGFemTbl, yrsEDPriEnrGFem,
                                                   EDPriSurFemTbl, yrsEDPriSurFem, EDPriEnrNFemTbl, yrsEDPriEnrNFem,
                                                   EDPriIntNFemTbl, yrsEDPriIntNFem, EDPriCRTotTbl, yrsEDPriCRTot,
                                                   EDPriIntTotTbl, yrsEDPriIntTot, EDPriEnrGTotTbl, yrsEDPriEnrGTot,
                                                   EDPriSurTotTbl, yrsEDPriSurTot, EDPriEnrNTotTbl, yrsEDPriEnrNTot,
                                                   EDPriIntNTotTbl, yrsEDPriIntNTot, EDSecLowrGRateMaleTbl, yrsEDSecLowrGRateMale,
                                                   EDPriTranSecMaleTbl, yrsEDPriTranSecMale, EDSecLowrEnrGMaleTbl, yrsEDSecLowrEnrGMale,
                                                   EDSecLowrGRateFemTbl, yrsEDSecLowrGRateFem, EDSecLowrGRateTotTbl, yrsEDSecLowrGRateTot,
                                                   EDPriTranSecFemTbl, yrsEDPriTranSecFem, EDSecLowrEnrGFemTbl, yrsEDSecLowrEnrGFem,
                                                   EDPriTranSecTotTbl, yrsEDPriTranSecTot, EDSecLowrEnrGTotTbl, yrsEDSecLowrEnrGTot,
                                                   EDSecUpprGRateMaleTbl, yrsEDSecUpprGRateMale, EDSecLowr2UpprMaleTbl, yrsEDSecLowr2UpprMale,
                                                   EDSecUpprEnrGMaleTbl, yrsEDSecUpprEnrGMale, EDSecUpprGRateFemTbl, yrsEDSecUpprGRateFem,
                                                   EDSecLowr2UpprFemTbl, yrsEDSecLowr2UpprFem, EDSecUpprEnrGFemTbl, yrsEDSecUpprEnrGFem,
                                                   EDSecUpprGRateTotTbl, yrsEDSecUpprGRateTot, EDSecLowr2UpprTotTbl, yrsEDSecLowr2UpprTot,
                                                   EDSecUpprEnrGTotTbl, yrsEDSecUpprEnrGTot, EDTerGRateMaleTbl, yrsEDTerGRateMale,
                                                   EDTerGRateFemTbl, yrsEDTerGRateFem, EDTerGRateTotTbl, yrsEDTerGRateTot,
                                                   EDTerEnrgFemTbl, yrsEDTerEnrgFem, EDTerEnrgMaleTbl, yrsEDTerEnrgMale, EDTerEnrgTotTbl, yrsEDTerEnrgTot)

                Next


                '   Educational Expenditures
                '   ------------------------
                If cntx.HistoricMode Then
                    TbName$ = "GDP/Capita (PPP) Versus Primary Expenditures Per Student as % of GDPPC (1970)"
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    'For Each item In (From s In cntx.GetSlice("SeriesEdExpPriGDPPC", "Earliest")
                    '                  Select Key = s.Key, Value = s.Value)
                    '    ValHold = If(item.Value, Estimate(item.Key))

                    '    CEDEXPPSTUDPRI.Add(item.Key, ValHold)
                    'Next

                    Dim yrs As Short() = cntx.GetYears("SeriesEdExpPriGDPPC").OrderBy(Function(yy) yy).ToArray()
                    Dim Tbl = cntx.GetDice("SeriesEdExpPriGDPPC", yrs)
                    Dim ValFunc As Single?

                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(Tbl, yrs, key, cntx.FirstYear, HistDist)
                        ValFunc = Estimate(key)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If
                        CEDEXPPSTUDPRI.Add(key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next

                Else
                    'jrs 2024/06/24 TbName$ = "GDP/Capita (PPP) Versus Primary Expenditures Per Student as % of GDPPC (" & CStr(cntx.BaseYear) & ")"
                    'jrs 2024/07/23 added Log to the name
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Expenditures Per Student as % of GDPPC (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Dim CGDPPCPLT30 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                    For Each KEY In cntx.Regionalization.Keys
                        CGDPPCPLT30.Add(KEY, Amin(CGDPPCP(KEY), 30))
                    Next
                    Dim ValFunc As Single?

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCPLT30)

                    For Each item In (From s In cntx.GetSlice("SeriesEdExpPriGDPPC", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        ValFunc = Estimate(item.Key)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If

                        CEDEXPPSTUDPRI.Add(item.Key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next
                End If

                'Secondary education expenditures start in 1960
                Dim SecExpPSFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                Dim yrsEDExpPStudSec As Short() = cntx.GetYears("SeriesEdExpSecGDPPC").OrderBy(Function(yy) yy).ToArray()
                Dim EDExpPStudSecTbl = cntx.GetDice("SeriesEdExpSecGDPPC", yrsEDExpPStudSec)

                If cntx.HistoricMode Then
                    TbName$ = "GDP/Capita (PPP) Versus Secondary Expenditures Per Student as % of GDPPC (1970)"
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    'Dim ValFunc As Single?
                    'For Each item In (From s In cntx.GetSlice("SeriesEdExpSecGDPPC", "Earliest")
                    '                  Select Key = s.Key, Value = s.Value)

                    '    SecExpPSFromData.Add(item.Key, item.Value.HasValue)
                    '    ValFunc = Estimate(item.Key)
                    '    ValHold = If(item.Value, ValFunc)

                    '    CEDEXPPSTUDSEC.Add(item.Key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    'Next

                    Dim ValFunc As Single?

                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDExpPStudSecTbl, yrsEDExpPStudSec, key, cntx.FirstYear, HistDist)
                        SecExpPSFromData.Add(key, ValHold.HasValue)
                        ValFunc = Estimate(key)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If
                        CEDEXPPSTUDSEC.Add(key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next

                Else
                    'jrs 2024/06/24 TbName$ = "GDP/Capita (PPP) Versus Secondary Expenditures Per Student as % of GDPPC (" & CStr(cntx.BaseYear) & ")"
                    'jrs 2024/07/23 added log to the name
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Expenditures Per Student as % of GDPPC (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Dim ValFunc As Single?

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdExpSecGDPPC", "MostRecent")
                                      Select Key = s.Key, Value = s.Value)
                        'mti 2021/08/10 
                        ValHold = getYearAroundOrRecent(EDExpPStudSecTbl, yrsEDExpPStudSec, item.Key, item.Value, cntx.BaseYear, False)

                        ValFunc = Estimate(item.Key)
                        SecExpPSFromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If


                        CEDEXPPSTUDSEC.Add(item.Key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next
                End If

                'Lower Secondary education expenditures
                Dim SecLowrExpPSFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim valfuncsecLowr As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    TbName$ = "GDP/Capita (PPP) Versus Secondary Lower Exp Per Student as % of GDPPC (M Recent)"
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each key In cntx.Regionalization.Keys
                        SecLowrExpPSFromData.Add(key, False)

                        ValHold = Estimate(key)

                        CEDEXPPSTUDSECLOWR.Add(key, ValHold)
                    Next
                Else
                    'jrs 2024/06/24 TbName$ = "GDP/Capita (PPP) Versus Secondary Lower Exp Per Student as % of GDPPC (MostRecent)"
                    'jrs 2024/07/23 added log name
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Lower Exp Per Student as % of GDPPC (" & BaseYear & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Dim CGDPPCPLT30 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                    For Each KEY In cntx.Regionalization.Keys
                        CGDPPCPLT30.Add(KEY, Amin(CGDPPCP(KEY), 30))
                    Next
                    Dim ValFunc As Single?

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCPLT30)

                    Dim yrsEDExpPStudSecLowr As Short() = cntx.GetYears("SeriesEdExpSecLowrGDPPC").OrderBy(Function(yy) yy).ToArray()
                    Dim EDExpPStudSecLowrTbl = cntx.GetDice("SeriesEdExpSecLowrGDPPC", yrsEDExpPStudSecLowr)

                    For Each item In (From s In cntx.GetSlice("SeriesEdExpSecLowrGDPPC", "MostRecent")
                                      Select Key = s.Key, Value = s.Value)
                        'mti 2021/08/10
                        ValHold = getYearAroundOrRecent(EDExpPStudSecLowrTbl, yrsEDExpPStudSecLowr, item.Key, item.Value, cntx.BaseYear, False)
                        ValFunc = Estimate(item.Key)
                        valfuncsecLowr.Add(item.Key, ValFunc)
                        SecLowrExpPSFromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If

                        CEDEXPPSTUDSECLOWR.Add(item.Key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next
                End If

                'Upper Secondary education expenditures
                Dim SecUpprExpPSFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim valfuncsecUppr As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    TbName$ = "GDP/Capita (PPP) Versus Secondary Upper Exp Per Student as % of GDPPC (M Recent)"
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each key In cntx.Regionalization.Keys

                        SecUpprExpPSFromData.Add(key, False)

                        ValHold = Estimate(key)

                        CEDEXPPSTUDSECUPPR.Add(key, ValHold)
                    Next
                Else
                    'jrs 2024/06/24 TbName$ = "GDP/Capita (PPP) Versus Secondary Upper Exp Per Student as % of GDPPC (MostRecent)"
                    'jrs 2024/07/23 added log to the name
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Upper Exp Per Student as % of GDPPC (" & BaseYear & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Dim CGDPPCPLT30 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                    For Each KEY In cntx.Regionalization.Keys
                        CGDPPCPLT30.Add(KEY, Amin(CGDPPCP(KEY), 30))
                    Next
                    Dim ValFunc As Single?

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCPLT30)

                    Dim yrsEDExpPStudSecUppr As Short() = cntx.GetYears("SeriesEdExpSecUpprGDPPC").OrderBy(Function(yy) yy).ToArray()
                    Dim EDExpPStudSecUpprTbl = cntx.GetDice("SeriesEdExpSecUpprGDPPC", yrsEDExpPStudSecUppr)

                    For Each item In (From s In cntx.GetSlice("SeriesEdExpSecUpprGDPPC", "MostRecent")
                                      Select Key = s.Key, Value = s.Value)
                        'mti 2021/08/10
                        ValHold = getYearAroundOrRecent(EDExpPStudSecUpprTbl, yrsEDExpPStudSecUppr, item.Key, item.Value, cntx.BaseYear, False)
                        ValFunc = Estimate(item.Key)
                        'mti 2021/08/10 start
                        'ValFunc = AMAX(ValFunc, valfuncsecLowr(item.Key) + 2)
                        'If SecLowrExpPSFromData(item.Key) Then ValFunc = AMAX(ValFunc, CEDEXPPSTUDSECLOWR(item.Key) + 2)
                        'mti 2021/08/10 end
                        valfuncsecUppr.Add(item.Key, ValFunc)

                        SecUpprExpPSFromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If


                        CEDEXPPSTUDSECUPPR.Add(item.Key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next
                End If

                Dim seclowrwt As Single?, secupprwt As Single?, secwt As Single?
                Dim lowrupprdiff As Single?
                For Each key In cntx.Regionalization.Keys
                    'reconcile secondary per student expenditures: Lower, upper and all
                    If SecExpPSFromData(key) Then
                        seclowrwt = CEdseclowrlen(key) * CEDSECLowrENRGT(key)
                        secupprwt = CEdsecupprlen(key) * CEDSECUpprENRGT(key)
                        secwt = seclowrwt + secupprwt

                        If Not SecLowrExpPSFromData(key) And Not SecUpprExpPSFromData(key) Then
                            'none of lower and upper have data
                            lowrupprdiff = Amin(CEDEXPPSTUDSEC(key) * 0.4F, 20.0F)
                            CEDEXPPSTUDSECLOWR(key) = CEDEXPPSTUDSEC(key) - lowrupprdiff * secupprwt / secwt
                            'lower should be close to primary; but not much higher than all secondary
                            'CEDEXPPSTUDSECLOWR(key) = Amin(CEDEXPPSTUDPRI(key) + 2, CEDEXPPSTUDSEC(key) * 0.9) '1.5

                            'upper calculated as residual
                            CEDEXPPSTUDSECUPPR(key) = AMAX(1, (CEDEXPPSTUDSEC(key) * secwt - CEDEXPPSTUDSECLOWR(key) * seclowrwt) / secupprwt)
                        Else 'at least one is from data
                            'mti 2021/08/10 start
                            If Not SecUpprExpPSFromData(key) And CEDEXPPSTUDSEC(key) * secwt > CEDEXPPSTUDSECLOWR(key) * seclowrwt Then 'lower data; upper estimated; adjust upper
                                'mti 2021/08/10 end
                                CEDEXPPSTUDSECUPPR(key) = AMAX(1, (CEDEXPPSTUDSEC(key) * secwt - CEDEXPPSTUDSECLOWR(key) * seclowrwt) / secupprwt)
                            Else 'upper data; lower estimated: adjust lower

                                'mti 2018/04/06 Start
                                If Not SecLowrExpPSFromData(key) Then
                                    CEDEXPPSTUDSECLOWR(key) = AMAX(1, (CEDEXPPSTUDSEC(key) * secwt - CEDEXPPSTUDSECUPPR(key) * secupprwt) / seclowrwt)
                                    CEDEXPPSTUDSECLOWR(key) = AMAX(CEDEXPPSTUDSEC(key) - 5, CEDEXPPSTUDSECLOWR(key))
                                End If
                                'mti 2018/04/06 End
                            End If
                        End If
                    End If
                Next

                'Tertiary education expenditures start in 1960
                If cntx.HistoricMode Then
                    TbName$ = "GDP/Capita (PPP) Versus Tertiary Expenditures Per Student as % of GDPPC (1970)"
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    Dim yrsEDExpPStudTerTbl As Short() = cntx.GetYears("SeriesEdExpTerGDPPC").OrderBy(Function(yy) yy).ToArray()
                    Dim EDExpPStudTerTbl = cntx.GetDice("SeriesEdExpTerGDPPC", yrsEDExpPStudTerTbl)

                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDExpPStudTerTbl, yrsEDExpPStudTerTbl, key, cntx.FirstYear, HistDist)
                        Dim ValFunc As Single?
                        ValFunc = Estimate(key)
                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If
                        CEDEXPPSTUDTER.Add(key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next

                    'For Each item In (From s In cntx.GetSlice("SeriesEdExpTerGDPPC", "Earliest")
                    '                  Select Key = s.Key, Value = s.Value)
                    '    ValHold = If(item.Value, Estimate(item.Key))

                    '    CEDEXPPSTUDTER.Add(item.Key, ValHold)
                    'Next
                Else
                    'jrs 2024/06/24 TbName$ = "GDP/Capita (PPP) Versus Tertiary Expenditures Per Student EP as % of GDPPC (" & CStr(cntx.BaseYear) & ")"
                    'jrs 2024/07/23 added log to the name
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Tertiary Expenditures Per Student EP as % of GDPPC (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Dim CGDPPCPLT50 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                    For Each KEY In cntx.Regionalization.Keys
                        CGDPPCPLT50.Add(KEY, Amin(CGDPPCP(KEY), 50))
                    Next
                    Dim ValFunc As Single?

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCPLT50)

                    For Each item In (From s In cntx.GetSlice("SeriesEdExpTerGDPPC", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)

                        ValHold = item.Value
                        ValFunc = Estimate(item.Key)
                        ValFunc = AMAX(ValFunc, valfuncsecUppr(item.Key) + 2)
                        If SecUpprExpPSFromData(item.Key) Then ValFunc = AMAX(ValFunc, CEDEXPPSTUDSECUPPR(item.Key) + 2)

                        If Not ValHold.HasValue Then
                            ValHold = ValFunc
                        End If
                        ValHold = Amin(400, ValHold) 'function or data ceiling at 400%

                        CEDEXPPSTUDTER.Add(item.Key, ApplyLimits(ValHold, CSng(ValFunc / 5), CSng(ValFunc * 5)))
                    Next
                End If

                'mti 2019/11/01 Start  - Take to a separate procedure to avoid procedure too large

                RecomputeEducateOutputAttainment(cntx, GDPPCPPPTblCur, yrsGDPPCP)
                'mti 2019/11/01 End  - Take to a separate procedure to avoid procedure too large


                For Each key In cntx.Regionalization.Keys
                    CEDSECENRNM(key) = Amin(CEDSECENRGM(key), CEDSECENRNM(key))
                    CEDSECENRNF(key) = Amin(CEDSECENRGF(key), CEDSECENRNF(key))
                    CEDSECENRNT(key) = Amin(CEDSECENRGT(key), CEDSECENRNT(key))
                Next

                'New Proc Education Quality Output
                RecomputeEdQualOutput(cntx, yrsGDPPCP, GDPPCPPPTblCur)

                'mti 2019/11/01 start
                CEDPRIPERTOTT("Kosovo") = CEDPRIPERTOTT("Serbia")
                CEDSECLOWRPERTOTT("Kosovo") = CEDSECLOWRPERTOTT("Serbia")
                CEDSECUPPRPERTOTT("Kosovo") = CEDSECUPPRPERTOTT("Serbia")
                CEDTERPERTOTT("Kosovo") = CEDTERPERTOTT("Serbia")

                CEDPRIPERTOTM("Kosovo") = CEDPRIPERTOTM("Serbia")
                CEDSECLOWRPERTOTM("Kosovo") = CEDSECLOWRPERTOTM("Serbia")
                CEDSECUPPRPERTOTM("Kosovo") = CEDSECUPPRPERTOTM("Serbia")
                CEDTERPERTOTM("Kosovo") = CEDTERPERTOTM("Serbia")

                CEDPRIPERTOTF("Kosovo") = CEDPRIPERTOTF("Serbia")
                CEDSECLOWRPERTOTF("Kosovo") = CEDSECLOWRPERTOTF("Serbia")
                CEDSECUPPRPERTOTF("Kosovo") = CEDSECUPPRPERTOTF("Serbia")
                CEDTERPERTOTF("Kosovo") = CEDTERPERTOTF("Serbia")
                'mti 2019/11/01

                cntx.Store("CEDSECENRGT", CEDSECENRGT)
                cntx.Store("CEDTERENRGT", CEDTERENRGT)
                cntx.Store("CEDYRSAGE25T", CEDYRSAGE25T)
                cntx.Store("CEDYRSAGE25TGR", CEDYRSAGE25TGR)
                cntx.Store("CEDSECPERF", CEDSECPERF)

                ' mark pre-processed for all three series
                Me.processed = True
            End Sub

            'jrs 2024/06/21
            Public TFNamePriCompTotal As String, TFNamePriGradTotal15to24 As String
            'jrs 2024/06/24
            Public TFNamePriExpend As String, TFNameSecExpend As String, TFNameSecUppExpend As String, TFNameSecLowExpend As String, TFNameTerExpend As String

            'mti 2020/09/01
            Private Sub RecomputeEducateOutput_New_Init(cntx As IRebuildFacade)
                'jrs 2023/10/03
                CEdSecLowrTRANMImp = New Dictionary(Of String, Boolean?)
                CEdSecLowrENRGMImp = New Dictionary(Of String, Boolean?)
                CEdSecLowrGRateMImp = New Dictionary(Of String, Boolean?)

                CEdSecLowrTRANFImp = New Dictionary(Of String, Boolean?)
                CEdSecLowrENRGFImp = New Dictionary(Of String, Boolean?)
                CEdSecLowrGRateFImp = New Dictionary(Of String, Boolean?)

                CEdSecLowrTRANTImp = New Dictionary(Of String, Boolean?)
                CEdSecLowrENRGTImp = New Dictionary(Of String, Boolean?)
                CEdSecLowrGRateTImp = New Dictionary(Of String, Boolean?)

                yrsGDPPCP = cntx.GetYears("GDPPCP" & ConstantDollarsYear.ToString).OrderBy(Function(y) y).ToArray()
                GDPPCPPPTbl = cntx.GetDice("GDPPCP" & ConstantDollarsYear.ToString, yrsGDPPCP)

                yrsEDPriLen = cntx.GetYears("SeriesEdPriDuration").OrderBy(Function(y) y).ToArray()

                EDPriLenTbl = cntx.GetDice("SeriesEdPriDuration", yrsEDPriLen)

                yrsEDPriStart = cntx.GetYears("SeriesEdPriEntranceAge").OrderBy(Function(y) y).ToArray()
                EDPriStartTbl = cntx.GetDice("SeriesEdPriEntranceAge", yrsEDPriStart)

                yrsEDPriPTRT = cntx.GetYears("SeriesEdPriPTR").OrderBy(Function(y) y).ToArray()
                EDPriPTRTbl = cntx.GetDice("SeriesEdPriPTR", yrsEDPriPTRT)

                yrsEDPriCRTot = cntx.GetYears("SeriesEdPriCompletionTotal").OrderBy(Function(y) y).ToArray()
                EDPriCRTotTbl = cntx.GetDice("SeriesEdPriCompletionTotal", yrsEDPriCRTot)

                yrsEDPriPerTot = cntx.GetYears("SeriesEdPriAdultGrads15Total").OrderBy(Function(y) y).ToArray()
