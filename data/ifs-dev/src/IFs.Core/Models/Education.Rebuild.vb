                        ValHold_Current = Nothing
                        ValHold_Prior = Nothing
                        Year_Prior(item.Key) = 0
                        ValHold = getYearAroundOrRecent(diceEdQualSecAllTotTbl, EdQualSecAllTotTbl, item.Key, item.MR, EdQualSecAll_Prior_Yr, False)
                        CEDQUALAG15SECT.Add(item.Key, ValHold)
                    Next
                Else
                    For Each key In cntx.Regionalization.Keys
                        CEDQUALAG15SECT.Add(key, Nothing)
                        Year_Prior(key) = 0
                    Next
                End If

                FuncBoth$ = "Educ Qual Sec All, Total, WBGA 2010 (Lin) vs GDPPCPLN and Edyear25"
                FuncEdYear$ = "Educational Years (15+) Versus Education Quality Scores, Secondary, All, Both Sexes (Log)"
                'jrs 2024/06/11 FuncGDPPCP$ = "GDP/Capita (PPP 2011) Versus Education Quality Scores, Secondary, All, Both Sexes (Log)"
                FuncGDPPCP$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Education Quality Scores, Secondary, All, Both Sexes (Log)"
                FuncGDPPCP$ = getFunctionNameYrOrMstRct(FuncGDPPCP$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                Estimate = cntx.GetRegression(FuncBoth$).Normalize("EdYearsAge25 (Linear)", "GDPPCP (Log)").ToEstimator(CEDYRSAGE25T, CGDPPCP)
                EstimateEd = cntx.GetRegression(FuncEdYear$).ToEstimator(CEDYRSAGE25T)
                ValEdYearsAge25Tot2 = New Dictionary(Of String, Single?)
                EstimateGDP = cntx.GetRegression(FuncGDPPCP$).ToEstimator(CGDPPCP)
                ValGDPPCP2 = New Dictionary(Of String, Single?)

                For Each key In cntx.Regionalization.Keys
                    If Not CEDQUALAG15SECT(key).HasValue Then
                        'No data; Try to use the multvariate function driven by income and education
                        ValHold_Current = Estimate(key)
                        'Year column in GDPPC table is given priority for prior data
                        If EdYearsAge25Tot_Prior_Yr <> 0 Then
                            MRval = getMR(diceEdYearsAge25TotTbl, EdYearsAge25TotTbl, key)
                            ValEdYearsAge25Tot = getYearAroundOrRecent(diceEdYearsAge25TotTbl, EdYearsAge25TotTbl, key, MRval, EdYearsAge25Tot_Prior_Yr, False)
                            ValEdYearsAge25Tot2.Add(key, ValEdYearsAge25Tot)
                            ValGDPPCP = getYearAroundOrRecent(diceGDPPCPPPTbl, GDPPCPPPTbl, key, MRval, EdYearsAge25Tot_Prior_Yr, False)
                            If ValEdYearsAge25Tot.HasValue Then
                                If ValGDPPCP.HasValue Then
                                    Call AnalFunc(FuncBoth$, New Single() {CSng(ValEdYearsAge25Tot), CSng(ValGDPPCP)}, ValHold_Prior,
                                    New String() {"EdYearsAge25 (Linear)", "GDPPCP (Log)"}, cntx)

                                    Year_Prior(key) = EdYearsAge25Tot_Prior_Yr
                                Else
                                    EstimateEd2 = cntx.GetRegression(FuncEdYear$).ToEstimator(ValEdYearsAge25Tot2)
                                    ValHold_Prior = CSng(EstimateEd2(key))
                                    ValHold_Current = EstimateEd(key)
                                    Year_Prior(key) = EdYearsAge25Tot_Prior_Yr
                                End If
                            End If
                        End If

                        If Year_Prior(key) = 0 Then
                            ValGDPPCP = getYearAroundOrRecent(diceGDPPCPPPTbl, GDPPCPPPTbl, key, MRval, GDPPCP_Prior_Yr, False)
                            ValGDPPCP2.Add(key, ValGDPPCP)
                            If ValGDPPCP.HasValue Then
                                EstimateGDP2 = cntx.GetRegression(FuncGDPPCP).ToEstimator(ValGDPPCP2)
                                ValHold_Prior = CSng(EstimateGDP2(key))
                                ValHold_Current = EstimateGDP(key)
                                Year_Prior(key) = GDPPCP_Prior_Yr
                            End If
                        End If

                        If Year_Prior(key) > 0 Then
                            diff = ValHold_Current - ValHold_Prior
                            If diff > 0 Then
                                CEDQUALAG15SECT(key) = CEDQUALSECALLT(key) - diff
                            End If
                        Else
                            CEDQUALAG15SECT(key) = CEDQUALSECALLT(key) - 10  'put min
                        End If
                    End If
                    CEDQUALAG15SECT(key) = AMAX(1, Amin(CEDQUALSECALLT(key) - 5, CEDQUALAG15SECT(key)))
                Next

                'Male and female--- 
                Dim EdQualSecAllGRTbl As Short() = cntx.GetYears("SeriesEdQualSecTotalRatioNAEK").OrderBy(Function(yy) yy).ToArray()
                Dim diceEdQualSecAllGRTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdQualSecTotalRatioNAEK", EdQualSecAllGRTbl)
                For Each key In cntx.Regionalization.Keys
                    ValHold = Nothing
                    If EdQualSecAll_Prior_Yr > 0 Then
                        MRval = getMR(diceEdQualSecAllGRTbl, EdQualSecAllGRTbl, key)
                        ValHold = getYearAroundOrRecent(diceEdQualSecAllGRTbl, EdQualSecAllGRTbl, key, MRval, EdQualSecAll_Prior_Yr, False, 10)
                    End If

                    If Not ValHold.HasValue Then
                        If CGDPPCP(key) > 3 Then
                            ValHold = 1.01 'average is .998 for 1995; function doesn't makre sense
                        Else
                            ValHold = 0.95
                        End If
                    End If

                    ValHold = ApplyLimits(ValHold, 0.5, 1.5)

                    CEDQUALAG15SECM.Add(key, 2 * CEDQUALAG15SECT(key) / (1 + ValHold))
                    CEDQUALAG15SECF.Add(key, ValHold * CEDQUALAG15SECM(key))

                    CEDQUALAG15T.Add(key, (CEDQUALAG15PRIT(key) + CEDQUALAG15SECT(key)) / 2)
                    CEDQUALAG15M.Add(key, (CEDQUALAG15PRIM(key) + CEDQUALAG15SECM(key)) / 2)
                    CEDQUALAG15F.Add(key, (CEDQUALAG15PRIF(key) + CEDQUALAG15SECF(key)) / 2)
                Next
            End Sub

            Private Function CalcGRateFromSurvNIntkNEnr(lencycle As Single?, Surv As Single?, Intk As Single?, Enrlmnt As Single?) As Single?
                'mti 2019/11/01 new proc

                '    Dim Dropout
                '    Dim gcnt%
                '    ReDim Arr_Dropout(10)
                '
                '    gcnt% = 1
                '    GrEnr = Intk
                '    DiffMid = AMAX(0, Intk - Enrlmnt)
                '    Intrvl = lencycle \ 2
                '    For gcnt% = 2 To lencycle \ 2
                '        GrEnr = Intk - (gcnt - 1) * DiffMid / Intrval
                '    Next gcnt%
                '    gcnt = gcnt + 1 'lencycle\2 + 1
                '    GrEnr = Enrlmnt
                '    DiffMid = AMAX(0, Enrlmnt - Intk * Surv / 100)
                '    Intrvl = lencycle - lencycle \ 2 - 1
                '    For gcnt% = lencycle \ 2 + 2 To lencycle - 1
                '        GrEnr = Enrlmnt - (gcnt - 1) * DiffMid / Intrval
                '    Next gcnt%
                '    LastGrEnr = Intk * Surv / 100

                'from here
                Dim MidPoint = CInt(lencycle) \ 2 + 1  '3 for 5 grades; 4 for 6 grades
                Dim LastBut1Point = lencycle - 1

                Dim MidPoint_Enr = Enrlmnt
                Dim Last_GrEnr = Intk * Surv / 100

                Dim EnrDiff_Mid2Last = AMAX(0, MidPoint_Enr - Last_GrEnr)

                Dim len_Mid2Last = lencycle - MidPoint
                Dim len_Mid2LastBut1 = LastBut1Point - MidPoint

                Dim LastBut1_GrEnr = Enrlmnt - len_Mid2LastBut1 * EnrDiff_Mid2Last / len_Mid2Last


                CalcGRateFromSurvNIntkNEnr = Last_GrEnr * Amin(1, Last_GrEnr / LastBut1_GrEnr)

            End Function
            '=============================DataEducate.BAS  =======================
            Private Sub CalcSurvFromIntkNEnrDist2(lencycle As Single?, ByRef Intk As Single?, ByRef Enrlmnt As Single?, ByRef Surv As Single?)
                'mti 2019/11/01 new proc

                'mti 2019/12/22 - added comment
                'linear spread of grade enrollment is actually resulting in larger percentage dropout in latter grades; is that right? Check

                '    Dim Dropout
                '    Dim gcnt%
                '    ReDim Arr_Dropout(10)
                '
                Dim ssurv As Single? = Surv
                Dim LoopCounter = 0
                Dim StopAdjustingSurv As Boolean = False
                Do While Not StopAdjustingSurv
                    Dim MidPoint = CInt(lencycle) \ 2 + 1  '3 for 5 grades; 4 for 6 grades
                    Dim EnrDiff_1st2Mid = AMAX(0, Intk - Enrlmnt)
                    Dim len_1st2Mid = MidPoint - 1

                    Dim TotEnr = Intk
                    For gcnt% = 2 To MidPoint - 1
                        Dim GrEnr = AMAX(1, Intk - (gcnt - 1) * EnrDiff_1st2Mid / len_1st2Mid)
                        TotEnr = TotEnr + GrEnr
                    Next gcnt%

                    TotEnr = TotEnr + Enrlmnt  'MidPoint1st = enrollment


                    'LastBut1Point = lencycle - 1
                    Dim LastGradeEnr = Intk * Surv / 100
                    Dim EnrDiff_Mid2Last = AMAX(0, Enrlmnt - LastGradeEnr)
                    Dim len_Mid2Last = lencycle - MidPoint
                    'len_Mid2LastBut1 = LastBut1Point - MidPoint

                    For gcnt% = MidPoint + 1 To CInt(lencycle) - 1
                        Dim GrEnr = AMAX(1, Enrlmnt - (gcnt - MidPoint) * EnrDiff_Mid2Last / len_Mid2Last)
                        TotEnr = TotEnr + GrEnr
                    Next gcnt%

                    TotEnr = TotEnr + LastGradeEnr
                    TotEnr = TotEnr / lencycle

                    If TotEnr > Enrlmnt + 2 Then
                        Surv = Surv - 2
                        If Math.Round(CSng(ssurv - Surv), 5) > 10 Then 'too much surv decrease already; adjust intake also
                            Intk = AMAX(Enrlmnt + 2, Intk - 3)
                        End If
                    ElseIf TotEnr < Enrlmnt - 2 Then
                        Surv = Surv + 2
                        If Math.Round(CSng(Surv - ssurv), 5) > 10 Then 'too much surv increase already; adjust intake also
                            Intk = Amin(170, Intk + 3)
                        End If
                    Else
                        StopAdjustingSurv = True
                    End If
                    'mti 2020/03/11 start
                    'If Math.Abs(CSng(ssurv - Surv)) > 15 Then StopAdjustingSurv = True
                    If Math.Abs(CSng(ssurv - Surv)) > 15 Or Surv < 10 Then StopAdjustingSurv = True
                    'mti 2020/03/11 End

                    LoopCounter% = LoopCounter% + 1
                    If LoopCounter% > 15 Then StopAdjustingSurv = True
                Loop



            End Sub

