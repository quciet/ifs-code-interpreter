                'Header$ = "Level_Var,Sex,Grd_Data_yr,Country,Level_Var_Name,Level_Var_Val,Pri_length, gr1,gr2,gr3,gr4,gr5,gr6,gr7"
                '            Print #grfno, Header$



                '   Primary Education Initial Conditions
                '   ------------------------------------

                For Each key In cntx.Regionalization.Keys



                    'Population by educational level

                    Dim pristart = CEdpristart(key)
                    Dim seclowrStart = CEdpristart(key) + CEdprilen(key)
                    Dim secupprStart = CEdpristart(key) + CEdprilen(key) + CEdseclowrlen(key)
                    Dim terstart = CEdpristart(key) + CEdprilen(key) + CEdseclowrlen(key) + CEdsecupprlen(key)
