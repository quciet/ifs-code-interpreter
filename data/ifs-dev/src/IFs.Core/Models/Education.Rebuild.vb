                        If Not IntakeGMfromData(key) And IntakeGTfromData(key) Then
                            ValHold = CEDPRIINTT(key)
                            IntakeGMfromData(key) = True
                        End If

                        CEDPRIINTM.Add(key, ApplyLimits(ValHold, 5, 170))
                    Next
