                    'mti 2019/11/01 start  'start at (baseyear - (cohortstart - graduationage))
                    CEDSECUPPRPER20TO24T.Add(item.Key, getHistAverage(EDSecUpprGRateTotTbl, yrsEDSecUpprGRateTot, item.Key, CInt(BaseYear - (20 - CEdpristart(item.Key) - CEdprilen(item.Key) - CEdseclowrlen(item.Key) - CEdsecupprlen(item.Key))), 5))
                    'Keep Nulls for now 'use reconciled rate later
                    'If IsNull(CEDSECUPPRPER20TO24T(key)) Then CEDSECUPPRPER20TO24T(key) = CEDSECUpprGRateT(key) 'use reconciled rate
                    'mti 2019/11/01 End

                    'Basic Education enrollment Rate Total - Crude initialization, using length weighted enrollment rates
                    CEdBasEnrGT.Add(item.Key, (CEDPRIENRGT(item.Key) * CEdprilen(item.Key) + CEDSECLowrENRGT(item.Key) * CEdseclowrlen(item.Key)) / (CEdprilen(item.Key) + CEdseclowrlen(item.Key)))
