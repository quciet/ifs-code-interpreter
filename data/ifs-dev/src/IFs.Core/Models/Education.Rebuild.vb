                        CPopEdSecLowr(key)(gndr) = 0
                        CPopEdSecLowrGrad(key)(gndr) = 0
                        CPopEdSecUppr(key)(gndr) = 0
                        CPopEdSecUpprGrad(key)(gndr) = 0
                        CPopEdTer(key)(gndr) = 0
                        CPopEdTerGrad(key)(gndr) = 0
                        'mti 2023/10/15 end

                        For CohNo = 1 To 100 'NCohorts 'edpristart(key) To edpristart(key) + edprilen(key) - 1

                            Select Case CohNo
                                Case pristart
                                    CPopEdPriInt(key)(gndr) = CPopEdPriInt(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                    CPopEdPri(key)(gndr) = CPopEdPri(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case pristart To seclowrStart - 1
                                    CPopEdPri(key)(gndr) = CPopEdPri(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case seclowrStart
                                    CPopEdPriGrad(key)(gndr) = CPopEdPriGrad(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                    CPopEdSecLowr(key)(gndr) = CPopEdSecLowr(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case seclowrStart To secupprStart - 1
                                    CPopEdSecLowr(key)(gndr) = CPopEdSecLowr(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case secupprStart
                                    CPopEdSecLowrGrad(key)(gndr) = CPopEdSecLowrGrad(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                    CPopEdSecUppr(key)(gndr) = CPopEdSecUppr(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case secupprStart To terstart - 1
                                    CPopEdSecUppr(key)(gndr) = CPopEdSecUppr(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case terstart
                                    CPopEdSecUpprGrad(key)(gndr) = CPopEdSecUpprGrad(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                    CPopEdTer(key)(gndr) = CPopEdTer(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case terstart To terstart + terlen - 1
                                    CPopEdTer(key)(gndr) = CPopEdTer(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case terstart + terlen
                                    CPopEdTerGrad(key)(gndr) = CPopEdTerGrad(key)(gndr) + If(gndr% = Male, cfagedstM(key)("Age" & CohNo.ToString), cfagedstF(key)("Age" & CohNo.ToString))
                                Case Else
                            End Select

                        Next CohNo

                        'If CountryName(key) = "Bangladesh" And gndr% = 1 Then Stop

                    Next gndr%

                    'If key = "Bangladesh" Then Stop

                    CPopEdPri(key)(Total) = CPopEdPri(key)(Male) + CPopEdPri(key)(Female)
