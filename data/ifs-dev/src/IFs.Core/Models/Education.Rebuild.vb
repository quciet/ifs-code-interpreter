            Dim edsecupprlenDFBY As IDataframe
            edsecupprlenDFBY = context.Query("edsecupprlen").Filter(BaseYearOnly).Execute()
            Dim edsecupprlenDF As Dataframe = Dataframe.Create("edsecupprlen", context, context.FirstYear, context.LastYear, Nothing)
            For Each regionA As Short In context.Dimensions(1).Buckets.Keys
                For yr = context.FirstYear To context.LastYear
                    edsecupprlenDF(yr, regionA) = edsecupprlenDFBY(context.FirstYear, regionA)
                Next
            Next
            Yield edsecupprlenDF
            'Yield context.Query("edsecupprlen").Filter(BaseYearOnly).Execute()

