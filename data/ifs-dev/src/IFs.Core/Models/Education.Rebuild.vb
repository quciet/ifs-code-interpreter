            Private Function CalcSurvfromIntkNEnr(lencycle As Single?, Intk As Single?, Enr As Single?) As Single?
                'mti April, 2007 take whole proc
                Dim Dropout As Single?

                'estimate dropout and survival, with total enrolment as middle grade enrolment
                Dropout = AMAX(0, CSng((1 - (Enr / Intk) ^ (1 / (AMAX(1, Math.Floor(CSng(0.5 * (lencycle - 1)))))))))
                CalcSurvfromIntkNEnr = CSng(100 * ((1 - Dropout) ^ (lencycle - 1)))

            End Function

            Private Function CalcGRateFromSurvNIntk(lencycle As Single?, Surv As Single?, Intk As Single?, Optional GradeDiff% = 0) As Single?
                'mti April, 2007 take whole proc

                Dim Dropout As Single?
                Dim gcnt%
                Dim Arr_Dropout() As Single?
                ReDim Arr_Dropout(10)
                Dim G2Enr As Single?, GrEnr As Single?

                If GradeDiff% > 0 Then
                    Dropout = AMAX(0, CSng(1 - (Surv / 100) ^ (1 / (lencycle - 1))))

                    Arr_Dropout(1) = Dropout
                    'If dropoutrate < 0.4 And GDPPCP(R%) < 4 Then
                    Arr_Dropout(1) = Amin(0.5F, Dropout * 2.0F)
                    G2Enr = 1 - Arr_Dropout(1)
                    Dropout = AMAX(0, CSng(1 - ((Surv / G2Enr / 100) ^ (1 / (lencycle - 2))))) 'dropout rate for gender
                    'End If
                    gcnt% = 1
                    GrEnr = Intk
                    For gcnt% = 2 To CInt(lencycle)
                        Arr_Dropout(gcnt%) = Dropout
                        GrEnr = GrEnr * (1 - Arr_Dropout(gcnt% - 1))
                    Next gcnt%
                    CalcGRateFromSurvNIntk = GrEnr * (1 - Arr_Dropout(CInt(lencycle)))
                Else
                    Dropout = AMAX(0, CSng(1 - (Surv / 100) ^ (1 / (lencycle - 1))))
                    CalcGRateFromSurvNIntk = CSng(Intk * (1 - Dropout) ^ lencycle)
                End If

            End Function

            Private Sub ReconcileSec_New(sCtry As String, lencycle As Integer, EnrGrossRateFromData As Boolean, TransitionRateFromData As Boolean, GradRateFromData As Boolean,
