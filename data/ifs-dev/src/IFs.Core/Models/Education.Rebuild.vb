            Private Sub GradeSpread(sCtry As String, gndr%, startcycle As Single, lencycle As Integer, Intake As Single?, Survival As Single?, Enrollment As Single?, ByRef GradeStudents As Dictionary(Of String, Single?(,)), ByRef GradeDropout As Dictionary(Of String, Single?(,)), Optional GradRate As Single = 999)

                '-------------------------------------------------------------
                'mti 2024/06/05 start
                'mti 2022/04/12 take whole proc



                'If RegName(R%) = "Burundi" Then Stop

                '    SpreadStudents = True

                Dim pGradeStudents(10) As Single?

                '    'DeltaEnr = 5
                '    DeltaEnr = (100 - Survival) / (lencycle - 1)
                '    RptrPcntPop = DeltaEnr  'delta for grade spread

                pGradeStudents(1) = Intake  '+ RptrPcntPop    'first grade can also have repeaters, more so for low survival countries

                If lencycle = 2 Then
                    'Somalia ; Lower Sec
                    pGradeStudents(lencycle) = AMAX(1, 2 * Enrollment - pGradeStudents(1))

                Else

                    pGradeStudents(lencycle) = Intake * Survival / 100
                    Dim MidEnrAvg = (Enrollment * lencycle - pGradeStudents(1) - pGradeStudents(lencycle)) / (lencycle - 2)

                    'mti 2023/10/15 start
                    If lencycle = 3 Then
                        If (MidEnrAvg / Intake) < Survival And (Enrollment - MidEnrAvg) > 0 Then
                            pGradeStudents(1) = pGradeStudents(1) - CSng(0.5 * (Enrollment - MidEnrAvg))
                            pGradeStudents(lencycle) = pGradeStudents(lencycle) - CSng(0.5 * (Enrollment - MidEnrAvg))
                            MidEnrAvg = Enrollment
                        End If
                        'mti 2023/12/01 start
                        If MidEnrAvg > pGradeStudents(lencycle) + 30 Then
                            'now that we have repeaters, lower sec can have more than graduates in the last grades
                            pGradeStudents(lencycle) = (MidEnrAvg + pGradeStudents(lencycle)) / 2 - 10
                            MidEnrAvg = (Enrollment * lencycle - pGradeStudents(1) - pGradeStudents(lencycle)) / (lencycle - 2)
                        End If
                        'mti 2023/12/01 end

                    End If
                    'mti 2023/10/15 End 

                    Dim MidGrade1% = lencycle \ 2 + 1
                    Dim MidGrade2% = MidGrade1
                    If lencycle Mod 2 = 0 Then  'even number of grades
                        MidGrade1 = lencycle \ 2
                        MidGrade2 = lencycle \ 2 + 1
                    End If

                    Dim DeltaEnr = 5

                    Do While True
                        If MidGrade1 <> MidGrade2 Then
                            pGradeStudents(MidGrade1) = MidEnrAvg + DeltaEnr
                            pGradeStudents(MidGrade2) = MidEnrAvg - DeltaEnr
                        Else
                            pGradeStudents(MidGrade1) = MidEnrAvg
                            pGradeStudents(MidGrade2) = pGradeStudents(MidGrade1)
                        End If

                        For GCount% = MidGrade1 - 1 To 2 Step -1
                            pGradeStudents(GCount%) = pGradeStudents(GCount% + 1) + DeltaEnr
                        Next

                        For GCount% = MidGrade2 + 1 To lencycle - 1
                            pGradeStudents(GCount%) = CSng(AMAX(0.5, pGradeStudents(GCount% - 1) - DeltaEnr))  'negatives not allowed
                        Next
                        Dim TotEnr As Single? = 0
                        For GCount% = 1 To lencycle
                            TotEnr = TotEnr + pGradeStudents(GCount%)
                        Next

                        'this should not be necessary
                        If TotEnr / lencycle > Enrollment + 1 Then
                            DeltaEnr = DeltaEnr - 1
                        ElseIf TotEnr / lencycle < Enrollment - 1 Then
                            DeltaEnr = DeltaEnr + 1
                        Else
                            Exit Do
                        End If
                    Loop


                End If

                For GCount% = 1 To lencycle - 1
                    'mti 2023/12/01 start
                    'GradeDropout(sCtry)(GCount%, gndr%) = CSng(AMAX(-0.5, 1 - pGradeStudents(GCount% + 1) / pGradeStudents(GCount%))) 'allow more than 1?
                    GradeDropout(sCtry)(GCount%, gndr%) = CSng(AMAX(0.01, 1 - pGradeStudents(GCount% + 1) / pGradeStudents(GCount%))) 'allow more than 1?
                    'mti 2023/12/01 end
                Next

                'mti 2024/06/05 start 'Fixing Nigeria's graduation rate (lower sec) going over last grade enrollment rate; it should not when estimating
                If GradRate < 999 Then
                    Dim GRateExcess As Single
                    GRateExcess = AMAX(0, CSng(GradRate + 1 - pGradeStudents(lencycle)))
                    For GCount% = 1 To lencycle
                        pGradeStudents(GCount%) = pGradeStudents(GCount%) - GRateExcess / (lencycle - 1)
                    Next
                    pGradeStudents(lencycle) = GradRate + 1
                End If
                'mti 2024/06/05 End
                '
                For GCount% = 1 To lencycle
                    GradeStudents(sCtry)(GCount%, gndr%) = pGradeStudents(GCount%)
                Next


            End Sub
        End Class


    End Module
End Namespace
