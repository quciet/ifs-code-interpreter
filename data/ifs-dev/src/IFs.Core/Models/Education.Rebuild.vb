                        'mti 2019/11/01 End
                        PRIENRNMfromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not PRIENRNMfromData(item.Key) And PRIENRNTfromData(item.Key) Then
                            ValHold = CEDPRIENRNT(item.Key)
                            PRIENRNMfromData(item.Key) = True
                        End If

                        'force net enrolment to be less than or equal to gross enrolment
                        If ValHold > CEDPRIENRGM(item.Key) Then
                            'check how many countries are like this?

                            If EnrollMalefromdata(item.Key) Then 'gross enr from data
                                ValHold = CEDPRIENRGM(item.Key)
                                PRIENRNMfromData(item.Key) = False
                            Else
                                If PRIENRNMfromData(item.Key) Then 'net enr from data
                                    CEDPRIENRGM(item.Key) = ValHold
                                Else 'both from function
                                    ValHold = CEDPRIENRGM(item.Key)
                                    PRIENRNMfromData(item.Key) = False
                                End If
                                EnrollMalefromdata(item.Key) = True 'pretend as if gross enr from data, so that it doesn't change in reconcile
                            End If
                        End If

                        CEDPRIENRNM.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'primary net intake rate male
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim years As Short() = cntx.GetYears("SeriesEdPriNIRMale").OrderBy(Function(y) y).ToArray()
                    Dim EDPriIntNMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriNIRMale", years)
                    'combined 3 age data starts at 1999 now? change this function to 2000?
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Net Intake Rate Male(1995)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriIntNMaleTbl, years, key, cntx.FirstYear, HistDist)
                        IntakeNMfromData.Add(key, ValHold.HasValue)
                        ValHold = If(ValHold, Estimate(key))

                        'if total is available, use it as both male and female, instead of estimate
                        If Not IntakeNMfromData(key) And IntakeNTfromData(key) Then
                            ValHold = CEDPRIINTNT(key)
                            IntakeNMfromData(key) = True
                        End If

                        CEDPRIINTNM.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    TbName$ = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriNIRMale")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriIntNMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriNIRMale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriNIRMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriNIRMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriIntNMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)  'mti 2019/11/01
                        End If
                        IntakeNMfromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not IntakeNMfromData(item.Key) And IntakeNTfromData(item.Key) Then
                            ValHold = CEDPRIINTNT(item.Key)
                            IntakeNMfromData(item.Key) = True
                        End If

                        CEDPRIINTNM.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If
                '---------end net enrol and intake

                'initialize primary survival rate to last grade, male
                Dim SurvEstXY As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                If cntx.HistoricMode Then
                    'combined 3 age data starts at 1999 now? change this function to 2000?
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Survival Rate Male(1970)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriSurvivalMale", "Earliest")
                                      Select Key = s.Key, Value = s.Value)
                        SurvMaleFromData.Add(item.Key, item.Value.HasValue)
                        ValHold = If(item.Value, Estimate(item.Key))

                        'if total is available, use it as both male and female, instead of estimate
                        If Not SurvMaleFromData(item.Key) And SurvTotFromData(item.Key) Then
                            ValHold = CEDPRISURT(item.Key)
                            SurvMaleFromData(item.Key) = True
                        End If

                        CEDPRISURM.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    TbName$ = "GDP/Capita (PPP 2011) Versus Primary Survival Rate Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriSurvivalMale")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriSurvivalMale", years)
                    Dim MRYr As Integer, SurvEst As Single?
                    Dim years2 As Short() = cntx.GetYears("SeriesEdPriSurvivalMale").OrderBy(Function(y) y).ToArray()
                    Dim EDPriSurMaleTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriSurvivalMale", years2)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriSurvivalMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriSurvivalMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        MRYr% = getMstRctYr(EDPriSurMaleTbl, years, item.Key)
                        SurvEst = EstimateFromMostRecentRevBBH(CGDPPCP(item.Key), cntx.BaseYear, EDPriSurMaleTbl2, years2,
                    GDPPCPPPTblCur, yrsGDPPCP, item.Key, TbName, cntx, 100, 0, "Div", 1000, 10)
                        SurvEstXY.Add(item.Key, Estimate(item.Key))
                        If Not SurvEst.HasValue Then
                            SurvEst = SurvEstXY(item.Key)
                        End If

                        SurvMaleFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = SurvEst
                        ElseIf cntx.BaseYear - MRYr% > 5 Then
                            ValHold = SurvEst
                        End If


                        'if total is available, use it as both male and female, instead of estimate
                        If Not SurvMaleFromData(item.Key) And SurvTotFromData(item.Key) Then
                            ValHold = CEDPRISURT(item.Key)
                            SurvMaleFromData(item.Key) = True
                        End If

                        CEDPRISURM.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'initialize gross primary completion (graduation) rate
                'mti 2019/11/01 start
                Dim GrEst As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim GrRaw As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim GrRawYr As Dictionary(Of String, Integer) = New Dictionary(Of String, Integer)

                Dim CREst As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Completion Male (2000)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        PriCRMFromData.Add(key, False)
                        ValHold = Estimate(key)

                        GrEst.Add(key, ValHold)

                        'if total is available, use it as both male and female, instead of estimate
                        If Not PriCRMFromData(key) And PriCRTFromData(key) Then
                            ValHold = CEdPriCRT(key)
                            PriCRMFromData(key) = True
                        End If

                        CEdPriCRM.Add(key, ApplyLimits(ValHold, 5, 120))
                        GrRaw.Add(key, Nothing)
                        GrRawYr.Add(key, 0)
                    Next
                Else
                    'jrs 2025/03/05 TbName$ = "GDP/Capita (PPP) Versus Primary Completion Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Completion Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    'Dim years As Short()
                    'years = (From y In cntx.GetYears("SeriesEdPriCompletionMale")
                    '         Where FirstYear - 20S < y
                    '         Order By y Descending
                    ').Take(10).ToArray
                    'Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriCompletionMale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriCompletionMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriCompletionMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        GrEst.Add(item.Key, Nothing)
                        GrRaw.Add(item.Key, Nothing)
                        GrRawYr.Add(item.Key, 0)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                            GrRawYr(item.Key) = cntx.BaseYear
                        Else
                            ValHold = getYearAroundOrRecent(EDPriCRMaleTbl, yrsEDPriCRMale, item.Key, item.MR, cntx.BaseYear, False, , GrRawYr(item.Key)) ', False 'mti 2019/11/01
                        End If
                        GrRaw(item.Key) = ValHold

                        PriCRMFromData.Add(item.Key, ValHold.HasValue)

                        CREst.Add(item.Key, Estimate(item.Key))
                        If Not ValHold.HasValue Then
                            ValHold = CREst(item.Key)
                            GrEst(item.Key) = ValHold
                        End If
                        'mti 2019/11/01 End

                        'if total is available, use it as both male and female, instead of estimate
                        If Not PriCRMFromData(item.Key) And PriCRTFromData(item.Key) Then
                            ValHold = CEdPriCRT(item.Key)
                            PriCRMFromData(item.Key) = True
                        End If

                        CEdPriCRM.Add(item.Key, ApplyLimits(ValHold, 5, 120))
                    Next
                End If

                'initialize percentage of adult (15+) with at least primary education, male
                Dim Low_Limit As Single
                If cntx.HistoricMode Then
                    Low_Limit = 0.5
                    Dim years As Short() = cntx.GetYears("SeriesEdPriAdultGrads15Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15Male", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Graduates Male (1960)").ToEstimator(CGDPPCP)
                    'For Each item In (From s In cntx.GetSlice("SeriesEdPriAdultGrads15Male", "Earliest")
                    '                  Select Key = s.Key, Value = s.Value)

                    '    ValHold = item.Value
                    '    If Not ValHold.HasValue Then
                    '        ValHold = LReg(EDPriPerMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                    '    End If
                    '    If Not ValHold.HasValue Then
                    '        ValHold = Estimate(item.Key)
                    '    End If

                    '    CEDPRIPERM.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    'Next

                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriPerMaleTbl, years, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(key)
                        End If
                        CEDPRIPERM.Add(key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                Else
                    Low_Limit = 4
                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2000) Versus Primary Graduates 15+ Male (Log) (MostRecent)"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Graduates 15+ Male (Log) (" & BaseYear & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriAdultGrads15Male")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15Male", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAdultGrads15Male", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriAdultGrads15Male", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 start
                            'ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDPRIPERM.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                End If

                'initialize percentages of adults(15 to 24) with at least primary education, male
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdPriAdultGrads15to24Male").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15to24Male", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Primary Graduates 15 to 24 Male (1960) Log").ToEstimator(CGDPPCP)
                    'For Each item In (From s In cntx.GetSlice("SeriesEdPriAdultGrads15to24Male", "Earliest")
                    '                  Select Key = s.Key, Value = s.Value)
                    '    ValHold = item.Value
                    '    If Not ValHold.HasValue Then
                    '        ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP", item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                    '    End If
                    '    If Not ValHold.HasValue Then
                    '        ValHold = Estimate(item.Key)
                    '    End If

                    '    CEDPRIPER15TO24M.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    '    CEDPRIPER15TO24M(item.Key) = AMAX(CEDPRIPERM(item.Key) + 2, CEDPRIPER15TO24M(item.Key))
                    'Next

                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriPerMaleTbl, years, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(key)
                        End If
                        CEDPRIPER15TO24M.Add(key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDPRIPER15TO24M(key) = AMAX(CEDPRIPERM(key) + 2, CEDPRIPER15TO24M(key))
                    Next
                Else
                    Low_Limit = 3
                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2000) Versus Primary Graduates 15+ Male (Log) (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Graduates 15+ Male (Log) (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriAdultGrads15to24Male")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15to24Male", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAdultGrads15to24Male", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriAdultGrads15to24Male", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 Start
                            'ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End                            
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDPRIPER15TO24M.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDPRIPER15TO24M(item.Key) = AMAX(CEDPRIPERM(item.Key) + 2, CEDPRIPER15TO24M(item.Key))
                    Next
                End If

                For Each item In (From s In cntx.GetSlice("SeriesEdPriAIRMale", "MostRecent")
                                  Select Key = s.Key, Value = s.Value)

                    ValHold = getYearAroundOrRecent(EDPriIntMaleTbl, yrsEDPriIntMale, item.Key, item.Value, CInt(cntx.BaseYear - CEdprilen(item.Key) + 1), False)

                    GrossIntEarlier.Add(item.Key, If(ValHold, 0))
                Next

                ReconcileFlowRates(cntx, CEdprilen, IntakeGMfromData, SurvMaleFromData, EnrollMalefromdata, PriCRMFromData, IntakeNMfromData,
                               PRIENRNMfromData, 170, 100, 145, 120, SurvEstXY, CREst, CEDPRIINTM, CEDPRISURM, CEDPRIENRGM,
                               CEdPriCRM, CEDPRIINTNM, CEDPRIENRNM, GrossIntEarlier)

                'For Each key In cntx.Regionalization.Keys
                'mti 2019/11/01 start
                'WriteGradtoCSV(CInt(primalefile), GrEst(key), GrRaw(key), GrRawYr(key), CEdPriCRM(key))
                'mti 2019/11/01 End
                'Next

                'female primary ------------
                Dim IntakeGFfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrollFemfromdata As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim PRIENRNFfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim IntakeNFfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim SurvFemFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim PriCRFFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                'initialize primary gross intake rate, female
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Apparent (Gross) Intake Rate Female(1970)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAIRFemale", "Earliest")
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        IntakeGFfromData.Add(item.Key, item.Value.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not IntakeGFfromData(item.Key) And IntakeGTfromData(item.Key) Then
                            ValHold = CEDPRIINTT(item.Key)
                            IntakeGFfromData(item.Key) = True
                        End If

                        CEDPRIINTF.Add(item.Key, AMAX(5, Amin(170, ValHold)))
                    Next
                Else
                    'jrs 2025/03/05 TbName$ = "GDP/Capita (PPP) Versus Primary Apparent (Gross) Intake Rate Female(1990)"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Apparent (Gross) Intake Rate Female(" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCPL20)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriAIRFemale")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDPriIntFemTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAIRFemale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAIRFemale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriAIRFemale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added false parameter
                            ValHold = getYearAroundOrRecent(EDPriIntFemTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        IntakeGFfromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not IntakeGFfromData(item.Key) And IntakeGTfromData(item.Key) Then
                            ValHold = CEDPRIINTT(item.Key)
                            IntakeGFfromData(item.Key) = True
                        End If

                        CEDPRIINTF.Add(item.Key, AMAX(5, Amin(170, ValHold)))
                    Next
                End If

                'initialize primary gross enrolment rate, female
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Gross Enrollment Female (1970)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriEnrollGrossFemalePcnt", "Earliest")
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        EnrollFemfromdata.Add(item.Key, item.Value.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not EnrollFemfromdata(item.Key) And EnrollTotfromdata(item.Key) Then
                            ValHold = CEDPRIENRGT(item.Key)
                            EnrollFemfromdata(item.Key) = True
                        End If

                        CEDPRIENRGF.Add(item.Key, AMAX(5, Amin(145, ValHold)))
                    Next
                Else
                    TbName$ = "GDP/Capita (PPP) Versus Primary Gross Enrollment Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriEnrollGrossFemalePcnt")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDPriIntFemTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriEnrollGrossFemalePcnt", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriEnrollGrossFemalePcnt", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriEnrollGrossFemalePcnt", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22  added false parameter
                            ValHold = getYearAroundOrRecent(EDPriIntFemTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        EnrollFemfromdata.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not EnrollFemfromdata(item.Key) And EnrollTotfromdata(item.Key) Then
                            ValHold = CEDPRIENRGT(item.Key)
                            EnrollFemfromdata(item.Key) = True
                        End If

                        CEDPRIENRGF.Add(item.Key, AMAX(5, Amin(145, ValHold)))
                    Next
                End If

                'initialize primary net enrolment rate, female
