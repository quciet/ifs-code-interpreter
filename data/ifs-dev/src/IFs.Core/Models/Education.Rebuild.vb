                    For Each item In (From s In cntx.GetSlice("SeriesEdTerAdultGrads15Total", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdTerAdultGrads15Total", "MostRecent") On s.Key Equals m.Key
