            Private Function CalcIntakeFromSurvEnr(lencycle As Single?, Surv As Single?, Enr As Single?, Optional level% = 1,
                                               Optional GrossIntk As Single = 0, Optional GrossSurv As Single = 0) As Double?
                'mti April, 2007 take whole proc
                Dim Dropout As Double?
                Dim gcnt%
                Dim Arr_Dropout() As Double?
                ReDim Arr_Dropout(CInt(lencycle))
                Dim G2Enr As Double?, denom As Double?, AdjIntk As Double?, AdjDropout As Double?, ExtraEnr As Double?, AdjEnr As Double?

                If level% = 1 Then
                    'spread dropout - it is done for primary only in run
                    Dropout = AMAX(0, 1 - ((Surv / 100) ^ (1 / (lencycle - 1))))
                    Arr_Dropout(1) = Amin(0.5, Dropout * 2)
                    G2Enr = 1 - Arr_Dropout(1)
                    Dropout = AMAX(0, 1 - ((Surv / G2Enr / 100) ^ (1 / (lencycle - 2))))
                    'Dropout = AMAX(0, G2Enr - ((Surv / 100) ^ (1 / (lencycle - 2))))
                    'End If
                    '        For gcnt% = 2 To lencycle
                    '            Arr_Dropout(GCount%) = Dropout
                    '        Next gcnt%
                    Arr_Dropout(2) = Dropout
                    'spread end

                    denom = 1
                    For gcnt% = 2 To CInt(lencycle)
                        '            denom = denom + (1 - Arr_Dropout(gcnt% - 1)) ^ (gcnt% - 1)
                        denom = denom + (1 - Arr_Dropout(1)) * (1 - Arr_Dropout(2)) ^ (gcnt% - 2)
                    Next gcnt
                    CalcIntakeFromSurvEnr = (Enr * lencycle) / denom 'taking int up, much more compared to enr
                Else
                    'original without spread
                    'estimate intake from enrolment and survival
                    '[i+i(1-d)+i(1-d)(1-d)+....]/lencycle = enr
                    If lencycle = 1 Then
                        Dropout = 0
                    Else
                        Dropout = AMAX(0, 1 - (CDbl(Surv.ToString) / 100) ^ (1 / (lencycle - 1)))
                    End If
                    denom = 1
                    For gcnt = 2 To CInt(lencycle)
                        denom = denom + (1 - Dropout) ^ (gcnt - 1)
                    Next gcnt

                    CalcIntakeFromSurvEnr = (CDbl(Enr.ToString) * lencycle) / denom 'taking int up, much more compared to enr

                    If CalcIntakeFromSurvEnr - Enr > 30 Then
                        If GrossIntk > 0 Then 'calculating net intake; adjust net enrollment from gross intake (who are in net enr)
                            AdjIntk = Amin(40, (GrossIntk - CalcIntakeFromSurvEnr) * (lencycle - 1) / lencycle)
                            If lencycle = 1 Then
                                AdjDropout = 0
                            Else
                                AdjDropout = AMAX(0, CSng(1 - (GrossSurv / 100) ^ (1 / (lencycle - 1))))
                            End If
                            ExtraEnr = (AdjIntk + AdjIntk * (1 - AdjDropout)) / lencycle 'gross in first two grades calculated in net enr
                            AdjEnr = Enr - ExtraEnr
                            CalcIntakeFromSurvEnr = (AdjEnr * lencycle) / denom

                        End If
                    End If
                End If

            End Function

