                    For Each item In (From s In cntx.GetSlice("SeriesEdTerEnrollGrossMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdTerEnrollGrossMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
