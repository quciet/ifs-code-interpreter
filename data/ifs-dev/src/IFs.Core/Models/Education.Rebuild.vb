                'mti 2019/11/01 start
                'GRateCalc = CalcGRateFromSurvNIntk(lencycle, Survival, Intake, 1)
                GRateCalc = CalcGRateFromSurvNIntkNEnr(lencycle, Survival, Intake, Enrollment)

