                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Net Enrollment Male (1970)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriEnrNMaleTbl, years, key, cntx.FirstYear, HistDist)
                        PRIENRNMfromData.Add(key, ValHold.HasValue)
                        ValHold = If(ValHold, Estimate(key))

                        'if total is available, use it as both male and female, instead of estimate
                        If Not PRIENRNMfromData(key) And PRIENRNTfromData(key) Then
                            ValHold = CEDPRIENRNT(key)
                            PRIENRNMfromData(key) = True
                        End If

                        'force net enrolment to be less than or equal to gross enrolment
                        If ValHold > CEDPRIENRGM(key) Then
                            'check how many countries are like this?

                            If EnrollMalefromdata(key) Then 'gross enr from data
                                ValHold = CEDPRIENRGM(key)
                                PRIENRNMfromData(key) = False
                            Else
                                If PRIENRNMfromData(key) Then 'net enr from data
                                    CEDPRIENRGM(key) = ValHold
                                Else 'both from function
                                    ValHold = CEDPRIENRGM(key)
                                    PRIENRNMfromData(key) = False
                                End If
                                EnrollMalefromdata(key) = True 'pretend as if gross enr from data, so that it doesn't change in reconcile
