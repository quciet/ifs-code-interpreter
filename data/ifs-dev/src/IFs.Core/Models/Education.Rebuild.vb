                    ElseIf Survival > 90 Then
                        NetIntake = Amin(NetIntake, Intake - 1)
                        NetEnrollment = Amin(NetEnrollment, NetIntake - 1)
                    Else
                        NetIntake = Amin(NetIntake, Intake - 2)
                        NetEnrollment = Amin(NetEnrollment, NetIntake - 2)
                    End If
                End If


                If NetEnrollment > Enrollment Then
                    'Stop
                    If Survival > 95 Then
