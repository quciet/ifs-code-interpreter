                    Return (From s In series
                            Join r In cntx.Regionalization On s.Key Equals r.Key
                            Join w In Me.CPOP On s.Key Equals w.Key
                            Group Value = s.Value, Weight = w.Value By RegionId = r.Value Into Data = Group, TotalWeight = Sum(Weight)
                        ).ToDictionary(
                           Function(grp) grp.RegionId,
                           Function(grp) ApplyLimits(grp.Data.Sum(Function(v) v.Value * v.Weight) / grp.TotalWeight, MinVal, MaxVal)
                           )
                Else
                    Return (From s In series
                            Join r In cntx.Regionalization On s.Key Equals r.Key
                            Join w In Me.CPOP On s.Key Equals w.Key
                            Group Value = s.Value, Weight = w.Value By RegionId = r.Value Into Data = Group, TotalWeight = Sum(Weight)
                        ).ToDictionary(
                           Function(grp) grp.RegionId,
                           Function(grp) grp.Data.Sum(Function(v) v.Value * v.Weight) / grp.TotalWeight
                           )
                End If
            End Function

            Private Sub RecomputePrimaryTot(ByRef cntx As IRebuildFacade, ByRef EnrollTotfromdata As Dictionary(Of String, Boolean), ByRef PRIENRNTfromData As Dictionary(Of String, Boolean),
                                        ByRef IntakeGTfromData As Dictionary(Of String, Boolean), ByRef IntakeNTfromData As Dictionary(Of String, Boolean), ByRef SurvTotFromData As Dictionary(Of String, Boolean),
                                        ByRef PriCRTFromData As Dictionary(Of String, Boolean), ByRef GDPPCPPPTblCur As IDictionary(Of String, Single?()), ByRef yrsGDPPCP As Short())

                '   Primary Education Initial Conditions
                '   --------------------------------- 
                Dim ValHold As Single?
                For Each item In (From s In cntx.GetSlice("SeriesEdPriDuration", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Join s2 In cntx.GetSlice("SeriesEdPriEntranceAge", cntx.BaseYear, CoalescePolicy.MostRecent) On s.Key Equals s2.Key
                                  Select Key = s.Key, Value = If(s.Value, 5), Value2 = If(s2.Value, 6))
                    'Primary education intake rate file starts in 1989; need better approach to historic run

                    'common to both genders
                    CEdprilen.Add(item.Key, item.Value)
                    CEdpristart.Add(item.Key, item.Value2)
                Next

                'Primary Pupil Teacher Ratio
                Dim Estimate As SeriesEstimator
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdPriPTR").OrderBy(Function(y) y).ToArray()
                    Dim EDPriPTRTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriPTR", yrs)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Pupil Teacher Ratio (1970)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriPTRTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(key)
                        End If
                        CEdPriPTR.Add(key, ApplyLimits(ValHold, 10, 90))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Pupil Teacher Ratio (2000)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriPTR", cntx.BaseYear, MyBase.Policy)
                                      Select Key = s.Key, Value = If(s.Value, Estimate(s.Key)))
                        CEdPriPTR.Add(item.Key, ApplyLimits(item.Value, 10, 90))
                    Next
                End If

                'Total (both genders together) Primary------------

                'UseFunction4IntakeNEnroll = False

                'initialize primary gross intake rate, total
                Dim FirstYear As Integer = cntx.FirstYear
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdPriAIRTotal").OrderBy(Function(y) y).ToArray()
                    Dim EDPriIntTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAIRTotal", yrs)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Apparent (Gross) Intake Rate (1970)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriIntTotTbl, yrs, key, cntx.FirstYear, HistDist)
                        IntakeGTfromData.Add(key, ValHold.HasValue)
                        CEDPRIINTT.Add(key, ApplyLimits(If(ValHold, Estimate(key)), 5, 170))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    'mti 2020/02/15 Start
                    'used 1990 (cubic) function with cut off GDPPC
                    'Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Apparent (Gross) Intake Rate (1990)").ToEstimator(CGDPPCPL20)
                    'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2011) Versus Primary Apparent (Gross) Intake Rate Total (" & CStr(BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Apparent (Gross) Intake Rate Total (" & CStr(BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Estimate = cntx.GetRegression(TbName$).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriAIRTotal")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriIntTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAIRTotal", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAIRTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriAIRTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriIntTotTbl, years, item.Key, item.MR, cntx.BaseYear, False) 'mti 2019/11/01
                        End If
                        IntakeGTfromData.Add(item.Key, ValHold.HasValue)
                        CEDPRIINTT.Add(item.Key, ApplyLimits(If(ValHold, Estimate(item.Key)), 5, 170))

                        CEDPRIINTIYR.Add(item.Key, Nothing)
                        CEDPRIINTFYR.Add(item.Key, Nothing)
                        CEDPRIINTIVAL.Add(item.Key, Nothing)
                        CEDPRIINTGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriIntTotTbl, years, item.Key, cntx.BaseYear,
                                                CEDPRIINTIYR(item.Key), CEDPRIINTFYR(item.Key), CEDPRIINTIVAL(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))
                    Next
                End If

                'initialize primary gross enrolment rate, total
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdPriEnrollGrossTotalPcnt").OrderBy(Function(y) y).ToArray()
                    Dim EDPriEnrGTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriEnrollGrossTotalPcnt", yrs)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Gross Enrollment Total (1970)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriEnrGTotTbl, yrs, key, cntx.FirstYear, HistDist)
                        EnrollTotfromdata.Add(key, ValHold.HasValue)
                        CEDPRIENRGT.Add(key, ApplyLimits(If(ValHold, Estimate(key)), 5, 145))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP) Versus Primary Gross Enrollment Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriEnrollGrossTotalPcnt")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriEnrGTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriEnrollGrossTotalPcnt", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriEnrollGrossTotalPcnt", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriEnrollGrossTotalPcnt", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriEnrGTotTbl, years, item.Key, item.MR, cntx.BaseYear, False) 'mti 2019/11/01
                        End If
                        EnrollTotfromdata.Add(item.Key, ValHold.HasValue)
                        CEDPRIENRGT.Add(item.Key, ApplyLimits(If(ValHold, Estimate(item.Key)), 5, 145))

                        CEDPRIENRGIYR.Add(item.Key, Nothing)
                        CEDPRIENRGFYR.Add(item.Key, Nothing)
                        CEDPRIENRGIVal.Add(item.Key, Nothing)
                        CEDPRIENRGGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriEnrGTotTbl, years, item.Key, cntx.BaseYear,
                                                CEDPRIENRGIYR(item.Key), CEDPRIENRGFYR(item.Key), CEDPRIENRGIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))
                    Next

                End If

                'initialize primary net enrolment rate, total
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdPriEnrollNetTotalPcnt").OrderBy(Function(y) y).ToArray()
                    Dim EDPriEnrNTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriEnrollNetTotalPcnt", yrs)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Net Enrollment Total (1970)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriEnrNTotTbl, yrs, key, cntx.FirstYear, HistDist)
                        PRIENRNTfromData.Add(key, ValHold.HasValue)
                        CEDPRIENRNT.Add(key, If(ValHold, Estimate(key)))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP) Versus Primary Net Enrollment Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriEnrollNetTotalPcnt")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriEnrNTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriEnrollNetTotalPcnt", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriEnrollNetTotalPcnt", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriEnrollNetTotalPcnt", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriEnrNTotTbl, years, item.Key, item.MR, cntx.BaseYear, False) 'mti 2019/11/01
                        End If
                        PRIENRNTfromData.Add(item.Key, ValHold.HasValue)
                        CEDPRIENRNT.Add(item.Key, If(ValHold, Estimate(item.Key)))

                        CEDPRIENRNIYR.Add(item.Key, Nothing)
                        CEDPRIENRNFYR.Add(item.Key, Nothing)
                        CEDPRIENRNIVal.Add(item.Key, Nothing)
                        CEDPRIENRNGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriEnrNTotTbl, years, item.Key, cntx.BaseYear,
                                                CEDPRIENRNIYR(item.Key), CEDPRIENRNFYR(item.Key), CEDPRIENRNIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))
                    Next
                End If

                For Each key In cntx.Regionalization.Keys
                    'force net enrolment to be less than or equal to gross enrolment
                    If CEDPRIENRNT(key) > CEDPRIENRGT(key) Then
                        If EnrollTotfromdata(key) Then 'gross enr from data
                            CEDPRIENRNT(key) = CEDPRIENRGT(key)
                            PRIENRNTfromData(key) = False
                        Else
                            If PRIENRNTfromData(key) Then 'net enr from data
                                CEDPRIENRGT(key) = CEDPRIENRNT(key)
                            Else 'both from function
                                CEDPRIENRNT(key) = CEDPRIENRGT(key)
                                PRIENRNTfromData(key) = False
                            End If
                            'pretend as if gross enr from data, so that it doesn't change in reconcile
                            EnrollTotfromdata(key) = True
                        End If
                    End If

                    CEDPRIENRNT(key) = ApplyLimits(CEDPRIENRNT(key), 5, 100)
                Next

                'initialize primary net intake rate total
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdPriNIRTotal").OrderBy(Function(y) y).ToArray()
                    Dim EDPriIntNTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriNIRTotal", yrs)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Net Intake Rate Total(1995)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriIntNTotTbl, yrs, key, cntx.FirstYear, HistDist)
                        IntakeNTfromData.Add(key, ValHold.HasValue)
                        CEDPRIINTNT.Add(key, If(ValHold, Estimate(key)))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriNIRTotal")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriIntNTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriNIRTotal", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriNIRTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriNIRTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriIntNTotTbl, years, item.Key, item.MR, cntx.BaseYear, False) 'mti 2019/11/01
                        End If
                        IntakeNTfromData.Add(item.Key, ValHold.HasValue)
                        CEDPRIINTNT.Add(item.Key, If(ValHold, Estimate(item.Key)))

                        CEDPRIINTNIYR.Add(item.Key, Nothing)
                        CEDPRIINTNFYR.Add(item.Key, Nothing)
                        CEDPRIINTNIVAL.Add(item.Key, Nothing)
                        CEDPRIINTNGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriIntNTotTbl, years, item.Key, cntx.BaseYear,
                                                CEDPRIINTNIYR(item.Key), CEDPRIINTNFYR(item.Key), CEDPRIINTNIVAL(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))
                    Next
                End If

                Dim TAvg As Single?
                For Each key In cntx.Regionalization.Keys
                    'net enrolment should be less than net intake for the flow structure to work
                    If CEDPRIENRNT(key) > CEDPRIINTNT(key) Then
                        If CEDPRIENRNT(key) - CEDPRIINTNT(key) < 5 Then
                            'mti October 31, 2007
                            If PRIENRNTfromData(key) And Not IntakeNTfromData(key) Then
                                CEDPRIINTNT(key) = CEDPRIENRNT(key) + 4
                            Else
                                TAvg = (CEDPRIENRNT(key) + CEDPRIINTNT(key)) / 2
                                CEDPRIENRNT(key) = TAvg
                                CEDPRIINTNT(key) = TAvg
                                IntakeNTfromData(key) = False
                                PRIENRNTfromData(key) = False
                            End If
                        Else  'big diff, take net enrolment(data or est), and use estimate for intake
                            CEDPRIINTNT(key) = Estimate(key)
                            IntakeNTfromData(key) = False
                            If CEDPRIENRNT(key) > CEDPRIINTNT(key) Then
                                'look at survival?
                                '                    Stop
                                If CEDPRIENRNT(key) - CEDPRIINTNT(key) < 5 Then
                                    TAvg = (CEDPRIENRNT(key) + CEDPRIINTNT(key)) / 2
                                    CEDPRIENRNT(key) = TAvg
                                    PRIENRNTfromData(key) = False
                                    CEDPRIINTNT(key) = TAvg
                                Else  'big diff, take net enrolment(data or est), and use estimate for intake
                                    CEDPRIINTNT(key) = CEDPRIENRNT(key) + 1
                                End If
                            End If
                        End If
                    End If 'Stop

                    CEDPRIINTNT(key) = AMAX(5, Amin(100, CEDPRIINTNT(key)))

                    'mti 2016/11/02 End
                Next

                'initialize primary survival rate total

                'Primary ed survival rates start in 1970; barely acceptable to use for 1960
                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdPriSurvivalTotal").OrderBy(Function(y) y).ToArray()
                    Dim EDPriSurTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriSurvivalTotal", yrs)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Survival Rate Total(1970)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriSurTotTbl, yrs, key, cntx.FirstYear, HistDist)
                        SurvTotFromData.Add(key, ValHold.HasValue)
                        CEDPRISURT.Add(key, If(ValHold, Estimate(key)))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP 2011) Versus Primary Survival Rate Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim SurvEst As Single?
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriSurvivalTotal")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriSurTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriSurvivalTotal", years)
                    Dim years2 As Short() = cntx.GetYears("SeriesEdPriSurvivalTotal").OrderBy(Function(y) y).ToArray()
                    Dim EDPriSurTotTbl2 As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriSurvivalTotal", years2)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriSurvivalTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriSurvivalTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriSurTotTbl, years, item.Key, item.MR, cntx.BaseYear, False) ' , False'mti 2019/11/01   , 10)
                        End If
                        SurvTotFromData.Add(item.Key, True)
                        SurvEst = EstimateFromMostRecentRevBBH(CGDPPCP(item.Key), cntx.BaseYear, EDPriSurTotTbl2, years2,
                    GDPPCPPPTblCur, yrsGDPPCP, item.Key, TbName$, cntx, 100, 0, "Div", 1000, 10) '15
                        If Not SurvEst.HasValue Then
                            SurvEst = Estimate(item.Key)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = SurvEst
                            SurvTotFromData(item.Key) = False
                        End If
                        CEDPRISURT.Add(item.Key, ApplyLimits(ValHold, 5, 100))

                        CEDPRISURIYR.Add(item.Key, Nothing)
                        CEDPRISURFYR.Add(item.Key, Nothing)
                        CEDPRISURIVal.Add(item.Key, Nothing)
                        CEDPRISURGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriSurTotTbl, years, item.Key, cntx.BaseYear,
                                                CEDPRISURIYR(item.Key), CEDPRISURFYR(item.Key), CEDPRISURIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))
                    Next
                End If


                'initialize gross primary completion (graduation) rate   
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Completion Total (2000)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = Estimate(key)
                        CEdPriCRT.Add(key, ApplyLimits(ValHold, 5, 120))
                        PriCRTFromData.Add(key, True)
                    Next
                Else
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP) Versus Primary Completion Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdPriCompletionTotal")
                             Where FirstYear - 20S < y
                             Order By y Descending
                    ).Take(10).ToArray
                    Dim EDPriCRTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriCompletionTotal", years)

                    Dim CREst As Single?

                    For Each item In (From s In cntx.GetSlice("SeriesEdPriCompletionTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriCompletionTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        ValHold = getYearAroundOrRecent(EDPriCRTotTbl, years, item.Key, item.MR, cntx.BaseYear, False) 'mti 2019/11/01
                        CREst = Estimate(item.Key)
                        PriCRTFromData.Add(item.Key, True)
                        If Not ValHold.HasValue Then
                            PriCRTFromData(item.Key) = False
                            ValHold = CREst
                        End If
                        CEdPriCRT.Add(item.Key, ApplyLimits(ValHold, 5, 120))

                        CEDPRICRIYR.Add(item.Key, Nothing)
                        CEDPRICRFYR.Add(item.Key, Nothing)
                        CEDPRICRIVal.Add(item.Key, Nothing)
                        CEDPRICRGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriCRTotTbl, years, item.Key, cntx.BaseYear,
                                                CEDPRICRIYR(item.Key), CEDPRICRFYR(item.Key), CEDPRICRIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))
                    Next
                End If

                'total data, if any, is used for male/female;
                'so do not reconcile total; else it might change total data values
                ' totals will be adjusted anyway by averaging with pop at the first year

                'reconcile gross intake, gross enrolment, survival, gross completion (graduation)
                'ReconcileFlowRates sCtry, CEdprilen(sCtry), IntakeGTfromData, SurvTotFromData, EnrollTotfromdata, PriCRTFromData, IntakeNTfromData, PRIENRNTfromData, 160, 100, 145, 120, SurvEst, CREst, CEDPRIINTT(sCtry), CEDPRISURT(sCtry), CEDPRIENRGT(sCtry), CEdPriCRT(sCtry), CEDPRIINTNT(sCtry), CEDPRIENRNT(sCtry)


                'initialize percentages of adults(15+) with at least primary education, total
                Dim Low_Limit As Single
                If cntx.HistoricMode Then
                    Dim years As Short() = cntx.GetYears("SeriesEdPriAdultGrads15Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15Total", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Graduates Total (1960)").ToEstimator(CGDPPCP)

                    Low_Limit = 0.2

                    'mti 2019/04/29  Flex Hist Base Start - replaced hardcoded year
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EDPriPerTotTbl, years, key, cntx.FirstYear, HistDist)

                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerTotTbl, years, "SeriesGDP2000PCPPP", key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(key)
                        End If

                        CEDPRIPERT.Add(key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Low_Limit = 3
                    Dim years As Short() = cntx.GetYears("SeriesEdPriAdultGrads15Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15Total", years)
                    Dim TbName As String
                    'jrs 2024/06/28 TbName$ = "GDP/Capita (PPP 2000) Versus Primary Graduates 15+ Total (Log) (MostRecent)"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Primary Graduates 15+ Total (Log) (" & BaseYear & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAdultGrads15Total", "MostRecent")
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = getYearOrEstimation(EDPriPerTotTbl, years, item.Key, item.Value, cntx.BaseYear, 5, 15)
                        If Not ValHold.HasValue Then
                            'TbName$ = "GDP/Capita (PPP) Versus Primary Graduates Total (" & CStr(BaseYear) & ")"
                            'TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear)

                            ValHold = Estimate(item.Key)
                        End If
                        'mti February 08, 2012 - end
                        CEDPRIPERT.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                End If

                'mti January 17, 2012 - start
                '        'percentage of adult with primary education should be less than net primary graduation rate
                '        netgrate = Amin(100, CEdPriCRT(sCtry) * (Round(CEDPRIENRNT(sCtry)) / Int(CEDPRIENRGT(sCtry))))
                '        If ValHold > netgrate Then
                '
                ''            Debug.Print CountryName(sCtry)
                '
                '            'mti November 20, 2011 - start
                '            ValHold = netgrate - 1
                ''            ValHold = (netgrate + ValHold) / 2
                '            'mti November 20, 2011 - end
                '
                '        End If

                'initialize percentages of adults(15 to 24) with at least primary education, total
                If cntx.HistoricMode Then
                    Low_Limit = 0.2

                    Dim years As Short() = cntx.GetYears("SeriesEdPriAdultGrads15to24Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EdPriPerTot15to24Tbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15to24Total", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Primary Graduates 15 to 24 Total (1960) Log").ToEstimator(CGDPPCP)
                    'mti 2019/04/29  Flex Hist Base Start - replaced hardcoded year
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EdPriPerTot15to24Tbl, years, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EdPriPerTot15to24Tbl, years, "GDPPCP" & ConstantDollarsYear.ToString, key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(key)
                        End If
                        CEDPRIPER15TO24T.Add(key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDPRIPER15TO24T(key) = AMAX(CEDPRIPERT(key) + 2, CEDPRIPER15TO24T(key))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    Low_Limit = 3

                    Dim years As Short() = cntx.GetYears("SeriesEdPriAdultGrads15to24Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EdPriPerTot15to24Tbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriAdultGrads15to24Total", years)
                    Dim TbName As String
                    TbName$ = "GDP/Capita (PPP 2000) Versus Primary Graduates 15+ Total (Log) (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdPriAdultGrads15to24Total", "MostRecent")
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = getYearOrEstimation(EdPriPerTot15to24Tbl, years, item.Key, item.Value, cntx.BaseYear, 5, 15)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If
                        CEDPRIPER15TO24T.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDPRIPER15TO24T(item.Key) = AMAX(CEDPRIPERT(item.Key) + 2, CEDPRIPER15TO24T(item.Key))
                        'mti 2019/11/01 CEdPriCRT(item.Key) = AMAX(CEDPRIPER15TO24T(item.Key), CEdPriCRT(item.Key))
                    Next
                End If

            End Sub

            Private Sub ReconcileFlowRates(ByRef cntx As IRebuildFacade, ByRef lencycle As IDictionary(Of String, Single?), ByRef IntakefromData As Dictionary(Of String, Boolean),
            ByRef SurvFromData As Dictionary(Of String, Boolean), ByRef EnrollFromData As Dictionary(Of String, Boolean),
            ByRef GRateFromData As Dictionary(Of String, Boolean), ByRef NetIntakefromData As Dictionary(Of String, Boolean), ByRef NetEnrollFromData As Dictionary(Of String, Boolean),
            ByVal MaxIntake As Single, ByVal MaxSurv As Single, ByVal MaxEnroll As Single, ByVal MaxGRate As Single,
            ByRef SurvEst As Dictionary(Of String, Single?), ByRef CREst As Dictionary(Of String, Single?), ByRef Intake As IDictionary(Of String, Single?),
            ByRef Survival As IDictionary(Of String, Single?), ByRef Enrollment As IDictionary(Of String, Single?), ByRef Grate As IDictionary(Of String, Single?),
            ByRef NetIntake As IDictionary(Of String, Single?), ByRef NetEnrollment As IDictionary(Of String, Single?), ByRef GrossIntEarlier As Dictionary(Of String, Single?))

                Dim NDropout As Double?, GDropout As Double?, NSurvival As Single?, sNetIntake As Single?
                'gvdb 2024/04/05
                'unused variable
                Dim Dropout As Double? ', ssurv As Single?, sEnrollment As Single?, UInt As Single?, LInt As Single?
                Dim sIntake As Single?, sSurvival As Single?, GRateCalc As Single?

                For Each key In cntx.Regionalization.Keys
                    'mti April 05, 2012 - start
                    'this is needed to raise US girls's Survival(key)
                    If Intake(key) > Enrollment(key) Then
                        'mti 2019/11/01 Start
                        If IntakefromData(key) Then
                            CalcSurvFromIntkNEnrDist2(lencycle(key), Intake(key), Enrollment(key), Survival(key))
                        Else
                            Intake(key) = CSng(Amin(170.0F, CalcIntakeFromSurvEnr(lencycle(key), Survival(key), Enrollment(key))))
                        End If


                    Else

                        sIntake = Intake(key)

                        If SurvFromData(key) Then
                            Intake(key) = CSng(Amin(MaxIntake, CalcIntakeFromSurvEnr(lencycle(key), Survival(key), Enrollment(key), 2)))

                            'mti 2016/12/09 start
                            Intake(key) = (Intake(key) + sIntake) / 2


                            If Intake(key) - Enrollment(key) > 10 Then

                                'To fix malawi and Burundi
                                Intake(key) = Enrollment(key) + 8
                                Enrollment(key) = Enrollment(key) - 8

                                'Intake = Enrollment + 10
                                'mti 2016/12/09 End

                                Dropout = AMAX(0F, CalcDropoutFromEnrNIntk(lencycle(key), Intake(key), Enrollment(key)))
                                Survival(key) = Amin(100, CSng(100 * ((1 - Dropout) ^ (lencycle(key) - 1))))

                                'mti 2017/05/21 start
                            Else
                                'intake has changed, so Survival(key) estimate is needed
                                sSurvival = Survival(key)

                                Dropout = AMAX(0F, CalcDropoutFromEnrNIntk(lencycle(key), Intake(key), Enrollment(key)))
                                Survival(key) = Amin(100, CSng(100 * ((1 - Dropout) ^ (lencycle(key) - 1))))

                                Survival(key) = (Survival(key) + sSurvival) / 2

                                'mti 2017/05/21 End

                            End If
                        Else  'Intake <= enrollment and survival estimated

                            '                    'mti 2019/11/01 start
                            '
                            '                    If Not EnrollFromData Then
                            '                        'Somalia: all three from estimates; survival estimation function is the best
                            '                        'Both gross intake and gross enrollment are worse functions
                            '                        'Low income countries are generally the one with missing data:
                            '                        'For very low income countries, enrollment estimates go over intake estimates with current functions
                            '                        'So keeping intake estimate/data and then computing enrollment from survival estimate and intake
                            '
                            '                        'use intake and survival to get enrollment
                            '
                            '                        'Debug.Print CountryName(key), Enrollment;
                            '                        Enrollment = AMAX(5, Amin(130, CalcEnrfromIntakeNSurv(lencycle, Intake, Survival)))
                            '                        'Debug.Print Enrollment, Intake, Survival
                            '
                            '
                            '                    Else
                            '
                            '                        Intake = Enrollment + 5
                            '
                            '                        Dropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrollment))
                            '                        Survival = Amin(100, 100 * ((1 - Dropout) ^ (lencycle - 1)))
                            '
                            '                    End If
                            '                    'mti 2019/11/01 End

                            'mti 2019/10/28 Start Fix Egypt : Intake 103; Enrollment 104 both from data; survival estiamted 83
                            If GRateFromData(key) Then

                                Dropoutrate = CSng(AMAX(0, 1 - (Grate(key) / Intake(key)) ^ (1 / lencycle(key))))
                                Survival(key) = CSng(100 * ((1 - Dropoutrate) ^ (lencycle(key) - 1)))
                                If EnrollFromData(key) Or Not IntakefromData(key) Then
                                    Intake(key) = CSng(Amin(MaxIntake, CalcIntakeFromSurvEnr(lencycle(key), Survival(key), Enrollment(key), 2)))
                                Else
                                    Enrollment(key) = CSng(AMAX(5, Amin(130, CalcEnrfromIntakeNSurv(lencycle(key), Intake(key), Survival(key)))))
                                End If


                            Else
                                'mti 2019/12/22 Start
                                'If EnrollFromData(key) And Not IntakefromData(key) Then 'mti 2019/12/22 - needs to change AND to OR; to If IntakefromData and Not Enrollfromdata (for the latter code)
                                If EnrollFromData(key) Or Not IntakefromData(key) Then 'mti 2019/12/22 - needs to change AND to OR; to If IntakefromData and Not Enrollfromdata (for the latter code)
                                    'mti 2019/12/22 End
                                    Intake(key) = Enrollment(key) + 5
                                    Dropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle(key), Intake(key), Enrollment(key)))
                                    Survival(key) = CSng(Amin(100, 100 * ((1 - Dropout) ^ (lencycle(key) - 1))))
                                Else
                                    Enrollment(key) = Intake(key) - 5  'data poor countries?
                                    Dropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle(key), Intake(key), Enrollment(key)))
                                    Survival(key) = CSng(Amin(100, 100 * ((1 - Dropout) ^ (lencycle(key) - 1))))
                                End If
                            End If
                            'mti 2019/10/28 End
                        End If

                        'mti 2016/04/05 - end

                    End If
                    'mti April 05, 2012 - end

                    'after reconciling all gross; check net intake versus gross again
                    If NetIntake(key) > Intake(key) Then
                        'Stop
                        If Survival(key) > 95 Then
                            NetIntake(key) = Amin(NetIntake(key), Intake(key))
                            NetEnrollment(key) = Amin(NetEnrollment(key), NetIntake(key))
                        ElseIf Survival(key) > 90 Then
                            NetIntake(key) = Amin(NetIntake(key), Intake(key) - 1)
                            NetEnrollment(key) = Amin(NetEnrollment(key), NetIntake(key) - 1)
                        Else
                            NetIntake(key) = Amin(NetIntake(key), Intake(key) - 2)
                            NetEnrollment(key) = Amin(NetEnrollment(key), NetIntake(key) - 2)
                        End If
                    End If


                    If NetEnrollment(key) > Enrollment(key) Then
                        'Stop
                        If Survival(key) > 95 Then
                            NetEnrollment(key) = Amin(NetEnrollment(key), Enrollment(key))
                            NetIntake(key) = AMAX(NetEnrollment(key), NetIntake(key))
                        ElseIf Survival(key) > 90 Then
                            NetEnrollment(key) = Amin(NetEnrollment(key), Enrollment(key) - 1)
                            NetIntake(key) = Amin(100, AMAX(NetEnrollment(key) + 1, NetIntake(key)))
                        Else
                            NetEnrollment(key) = Amin(NetEnrollment(key), Enrollment(key) - 2)
                            NetIntake(key) = Amin(100, AMAX(NetEnrollment(key) + 2, NetIntake(key)))
                        End If
                    End If

                    'net dropout should be less than but not very far from gross survival

                    'mti 2013/10/07 - Education for WC - start

                    'doing net intake and net enr. reconcile up here might drive net intake crazy (as the survival is not yet reconciled)
                    'this was the case for WC

                    'first commented it out - and checked if it messes up other things
                    'when checked found that it messed up Albania, Phillipines, Parguay where NetInt is much higher than net enr.
                    'so instead of commebting it altogether set a threshold (so that WC does not enter the branch; while Alb, Phil etc do

                    If NetEnrollment(key) = 100 Then NetIntake(key) = 100 'this is added for Argentina

                    Dim InFirstCondition As Boolean = False  '2019/11/22
                    Dim InSecondCondition As Boolean = False

                    'jrs 2020/04/10 I'm using a Double to avoid loosing all decimals I need to compute NDropout
                    'Laos was problematic, values of NDropout and GDropout really close, vb6 using Doubles
                    Dim NetInt As Double? = CSng(NetIntake(key))
                    If NetIntake(key) + 3 < NetEnrollment(key) Then
                        NetInt = Amin(100.0F, CalcIntakeFromSurvEnr(lencycle(key), Survival(key), NetEnrollment(key), 2))
                        NetIntake(key) = CSng(NetInt)
                        InFirstCondition = True
                    End If

                    NDropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle(key), NetInt, CDbl(NetEnrollment(key).ToString)))
                    GDropout = AMAX(0, 1 - (CDbl(Survival(key).ToString) / 100) ^ (1 / (lencycle(key) - 1)))
                    'net dropout should not exceed gross dropout
                    If NDropout > GDropout Then

                        'mti 2019/12/09 Start
                        'If InFirstCondition Then Debug.Print "FirstandSecond", CountryName(key), NetIntakefromData, NetEnrollFromData, SurvivalFromData, NetIntake, NetEnrollment, Survival
                        'mti 2019/12/09 End

                        InSecondCondition = True

                        NDropout = GDropout
                        NSurvival = CSng(100 * ((1 - NDropout) ^ (lencycle(key) - 1)))
                        'NetEnrollment = CalcEnrfromIntakeNSurv(lencycle, NetIntake, NSurvival)
                        'NetIntake(key) = AMAX(5, CalcIntakeFromSurvEnr(lencycle(key), NSurvival, NetEnrollment(key), 2, CSng(Intake(key)), CSng(Survival(key))))
                        'mti 2019/11/01 start
                        If NetEnrollFromData(key) Then
                            NetIntake(key) = CSng(AMAX(5.0F, CalcIntakeFromSurvEnr(lencycle(key), NSurvival, NetEnrollment(key), 2, CSng(Intake(key)), CSng(Survival(key)))))
                        ElseIf NetIntakefromData(key) Then
                            NetEnrollment(key) = CSng(Amin(100.0F, CalcEnrfromIntakeNSurv(lencycle(key), NetIntake(key), NSurvival)))
                        Else
                            NetIntake(key) = CSng(AMAX(5.0F, CalcIntakeFromSurvEnr(lencycle(key), NSurvival, NetEnrollment(key), 2, CSng(Intake(key)), CSng(Survival(key)))))
                        End If
                        'mti 2019/11/01 End

                    End If
                    NSurvival = CSng(100 * ((1 - NDropout) ^ (lencycle(key) - 1)))

                    'net dropout within twenty(?) percent of gross dropout
                    If NSurvival - Survival(key) > 15 Then 'prevent net survival from being unreasonably different from gross
                        '            Stop
                        '            Debug.Print CountryName$(key); NDropout * 100; GDropout * 100; NetIntake; NetEnrollment
                        'If NetIntakefromData And SurvFromData Then
                        'NDropout = GDropout - GDropout * 0.2  '0.02  'increasing net dropout, reducing survival
                        NSurvival = Survival(key) + 15

                        'If Not NetIntakefromData Then
                        If NetEnrollFromData(key) Or Not NetIntakefromData(key) Then
                            'If NetIntake < 95 Then

                            'mti 2013/10/07 - Education for WC -start
                            sNetIntake = NetIntake(key)
                            'mti 2013/10/07 - Education for WC -end

                            'increase net intake to reach same net enrolment with a bigger dropout
                            NetIntake(key) = CSng(AMAX(5, CalcIntakeFromSurvEnr(lencycle(key), NSurvival, NetEnrollment(key), 2, CSng(Intake(key)), CSng(Survival(key)))))
                            'correct dropout
                            'NDropout = CalcDropoutFromEnrNIntk(lencycle, NetIntake, NetEnrollment)



                            If NetIntake(key) > 100 Then
                                'recalc survival in case the limit has reached
                                'mti 2016/12/09 start
                                NetIntake(key) = 99 '100
                                'mti 2016/12/09 End
                                NSurvival = Amin(100, CalcSurvfromIntkNEnr(lencycle(key), NetIntake(key), NetEnrollment(key)))
                                NetEnrollment(key) = CSng(Amin(100, CalcEnrfromIntakeNSurv(lencycle(key), NetIntake(key), NSurvival)))
                            Else
                                'mti 2013/10/07 - Education for WC -start
                                'avoid too large a fix; take some of the intake fixes to enrollment
                                If NetIntake(key) > sNetIntake + 5 Then 'mti 2019/12/23 - allow 10% here; as intake is one year only; Example : Somalia
                                    NetIntake(key) = sNetIntake + 5
                                    NetEnrollment(key) = CSng(Amin(100, CalcEnrfromIntakeNSurv(lencycle(key), NetIntake(key), NSurvival)))
                                ElseIf NetIntake(key) < sNetIntake - 5 Then
                                    NetIntake(key) = sNetIntake - 5
                                    NetEnrollment(key) = CSng(Amin(100, CalcEnrfromIntakeNSurv(lencycle(key), NetIntake(key), NSurvival)))
                                End If
                                'mti 2013/10/07 - Education for WC - end
                            End If

                            'IncNeeded = Amin(100, TNetIntake) - NetIntake
                            'NetIntake = NetIntake + IncNeeded / 2 'divide by lencycle? as 1% in enr = lencycle%in intake
                            'End If
                        Else
                            NetEnrollment(key) = CSng(Amin(100, CalcEnrfromIntakeNSurv(lencycle(key), NetIntake(key), NSurvival)))
                        End If
                        '            Debug.Print CountryName$(key); NDropout * 100; GDropout * 100; NetIntake; NetEnrollment

                    End If


                    'mti 2019/11/01 start
                    'GRateCalc = CalcGRateFromSurvNIntk(lencycle(key), Survival(key), Intake(key), 1)
                    GRateCalc = CalcGRateFromSurvNIntkNEnr(lencycle(key), Survival(key), Intake(key), Enrollment(key))

                    Grate(key) = (GRateCalc + Grate(key)) / 2
                Next

            End Sub

            Private Sub ReconcileFlowRates(ByRef cntx As IRebuildFacade, ByRef lencycle As Single?, ByRef IntakefromData As Boolean,
            ByRef SurvFromData As Boolean, ByRef EnrollFromData As Boolean,
            ByRef GRateFromData As Boolean, ByRef NetIntakefromData As Boolean, ByRef NetEnrollFromData As Boolean,
            ByVal MaxIntake As Single, ByVal MaxSurv As Single, ByVal MaxEnroll As Single, ByVal MaxGRate As Single,
            ByRef SurvEst As Single?, ByRef CREst As Single?, ByRef Intake As Single?,
            ByRef Survival As Single?, ByRef Enrollment As Single?, ByRef Grate As Single?,
            ByRef NetIntake As Single?, ByRef NetEnrollment As Single?, ByRef GrossIntEarlier As Single?)

                Dim NDropout As Double?, GDropout As Single?, NSurvival As Single?, sNetIntake As Single?
                'gvdb 2024/04/05
                'unused variable
                Dim Dropout As Double? ', ssurv As Single?, sEnrollment As Single?, UInt As Single?, LInt As Single?
                Dim sIntake As Double?, sSurvival As Single?, GRateCalc As Single?

                'mti April 05, 2012 - start
                'this is needed to raise US girls's Survival
                If Intake > Enrollment Then
                    'mti 2019/11/01 Start
                    If IntakefromData Then
                        CalcSurvFromIntkNEnrDist2(lencycle, Intake, Enrollment, Survival)
                    Else
                        Intake = CSng(Amin(170.0F, CalcIntakeFromSurvEnr(lencycle, Survival, Enrollment)))
                    End If
                Else

                    sIntake = Intake

                    If SurvFromData Then
                        Intake = CSng(Amin(MaxIntake, CalcIntakeFromSurvEnr(lencycle, Survival, Enrollment, 2)))

                        'mti 2016/12/09 start
                        Intake = CSng((Intake + sIntake) / 2)


                        If Intake - Enrollment > 10 Then

                            'To fix malawi and Burundi
                            Intake = Enrollment + 8
                            Enrollment = Enrollment - 8

                            'Intake = Enrollment + 10
                            'mti 2016/12/09 End

                            Dropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrollment))
                            Survival = Amin(100, CSng(100 * ((1 - Dropout) ^ (lencycle - 1))))

                            'mti 2017/05/21 start
                        Else
                            'intake has changed, so Survival estimate is needed
                            sSurvival = Survival

                            Dropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrollment))
                            Survival = Amin(100, CSng(100 * ((1 - Dropout) ^ (lencycle - 1))))

                            Survival = (Survival + sSurvival) / 2

                            'mti 2017/05/21 End

                        End If
                    Else  'Intake <= enrollment and survival estimated

                        '                    'mti 2019/11/01 start
                        '
                        '                    If Not EnrollFromData Then
                        '                        'Somalia: all three from estimates; survival estimation function is the best
                        '                        'Both gross intake and gross enrollment are worse functions
                        '                        'Low income countries are generally the one with missing data:
                        '                        'For very low income countries, enrollment estimates go over intake estimates with current functions
                        '                        'So keeping intake estimate/data and then computing enrollment from survival estimate and intake
                        '
                        '                        'use intake and survival to get enrollment
                        '
                        '                        'Debug.Print CountryName(key), Enrollment;
                        '                        Enrollment = AMAX(5, Amin(130, CalcEnrfromIntakeNSurv(lencycle, Intake, Survival)))
                        '                        'Debug.Print Enrollment, Intake, Survival
                        '
                        '
                        '                    Else
                        '
                        '                        Intake = Enrollment + 5
                        '
                        '                        Dropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrollment))
                        '                        Survival = Amin(100, 100 * ((1 - Dropout) ^ (lencycle - 1)))
                        '
                        '                    End If
                        '                    'mti 2019/11/01 End

                        'mti 2019/10/28 Start Fix Egypt : Intake 103; Enrollment 104 both from data; survival estiamted 83
                        If GRateFromData Then

                            Dropoutrate = CSng(AMAX(0, 1 - (Grate / Intake) ^ (1 / lencycle)))
                            Survival = CSng(100 * ((1 - Dropoutrate) ^ (lencycle - 1)))
                            If EnrollFromData Or Not IntakefromData Then
                                Intake = CSng(Amin(MaxIntake, CalcIntakeFromSurvEnr(lencycle, Survival, Enrollment, 2)))
                            Else
                                Enrollment = CSng(AMAX(5, Amin(130, CalcEnrfromIntakeNSurv(lencycle, Intake, Survival))))
                            End If


                        Else
                            'mti 2019/12/22 Start
                            'If EnrollFromData And Not IntakefromData Then  'mti 2019/12/22 - needs to change AND to OR; to If IntakefromData and Not Enrollfromdata (for the latter code)
                            If EnrollFromData Or Not IntakefromData Then  'mti 2019/12/22 - needs to change AND to OR; to If IntakefromData and Not Enrollfromdata (for the latter code)
                                'mti 2019/12/22 End
                                Intake = Enrollment + 5
                                Dropout = AMAX(0F, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrollment))
                                Survival = CSng(Amin(100, 100 * ((1 - Dropout) ^ (lencycle - 1))))
                            Else
                                Enrollment = Intake - 5  'data poor countries?
                                Dropout = AMAX(0F, CalcDropoutFromEnrNIntk(lencycle, Intake, Enrollment))
                                Survival = CSng(Amin(100, 100 * ((1 - Dropout) ^ (lencycle - 1))))
