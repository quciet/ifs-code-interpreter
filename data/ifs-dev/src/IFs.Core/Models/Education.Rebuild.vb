                        ValHold = getYearMaxAmongRecent(EDPriIntFemTbl, years, item.Key, item.Value, cntx.BaseYear, False, 15, 10)
                        'mti 2019/11/01 End
                        PRIENRNFfromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'if total is available, use it as both male and female, instead of estimate
                        If Not PRIENRNFfromData(item.Key) And PRIENRNTfromData(item.Key) Then
                            ValHold = CEDPRIENRNT(item.Key)
                            PRIENRNFfromData(item.Key) = True
                        End If

                        'force net enrolment to be less than or equal to gross enrolment
                        If ValHold > CEDPRIENRGF(item.Key) Then
                            'check how many countries are like this?

                            If EnrollFemfromdata(item.Key) Then 'gross enr from data
                                ValHold = CEDPRIENRGF(item.Key)
                                PRIENRNFfromData(item.Key) = False
                            Else
                                If PRIENRNFfromData(item.Key) Then 'net enr from data
                                    CEDPRIENRGF(item.Key) = ValHold
                                Else 'both estimated
                                    ValHold = CEDPRIENRGF(item.Key)
                                    PRIENRNFfromData(item.Key) = False
                                End If
                                'pretend as if gross enr from data, so that it doesn't change in reconcile
                                EnrollFemfromdata(item.Key) = True
                            End If
                        End If

                        CEDPRIENRNF.Add(item.Key, AMAX(5, Amin(100, ValHold)))
                    Next
                End If

                'initialize primary net intake rate, female
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Primary Net Intake Rate Female(1995)").ToEstimator(CGDPPCP)
