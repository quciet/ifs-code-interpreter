                                'CEdPriDrpGrd(key)(grd%, Male) = CSng(1 - (1 - CEdPriDrpGrd(key)(grd%, Male)) * CumDrpFac)
                                CEdPriDrpGrd(key)(grd%, Male) = CSng(1 - (1 - CEdPriDrpGrd(key)(grd%, Male)) * If(CumDrpFac.HasValue, CSng(CumDrpFac), 0))
                                'mti 2023/10/09 End
                            End If
                            'CumDrp = CumDrp * (1 - CEdPriDrpGrd(key)(grd%, Male))

                        Next

                        'If key = "Bangladesh" And gndr = 1 Then Stop

                        '            For grd% = 1 To CEdprilen(key) - 1 'grd% - 1 'make everything null and exit loop
                        '                If CEdPriDrpEst(grd%) = True Then
                        '                    'CEdPriDrpGrd(key)(grd%, gndr%) = CEdPriDrpGrd(key)(grd%, gndr%) * (CumDrpEst / CumDrpRem) ^ (1 / TotEst)
                        '                    CEdPriDrpGrd(key)(grd%, gndr%) = 1 - (CumDrpEst / CumDrpRem) ^ (1 / TotEst) + CEdPriDrpGrd(key)(grd%, gndr%) * (CumDrpEst / CumDrpRem) ^ (1 / TotEst)
                        '                End If
                        '            Next

                        '--- End reconcile --

                        'for countries with all but one use cumulative dropout (or, survivla) with intk * (1- dout) ^ gradee -1
                        'for countries with regression use cumulative dropout (or, survivla) with intk * (1- dout) ^ gradee -1 to adjust regressions (all?)

                        '            If Not HasAllGrades Then
                        '                If gndr% = 1 Then Print #grfno, "Pri_Drop, Male, " & DrpStr$ & ","; Replace(CountryName(key), ",", " "); ", Survival, "; Trim(Str(Round(CEDPRISURM(key), 2))); ","; Trim(Str(CEdprilen(key))); ",";
                        '    If gndr% = 2 Then Print #grfno, "Pri_Drop, Female, " & DrpStr$ & ","; Replace(CountryName(key), ",", " "); ", Survival, "; Trim(Str(Round(CEDPRISURF(key), 2))); ","; Trim(Str(CEdprilen(key))); ",";
                        'End If


                        '            For grd% = 1 To 6 'CEDPRIENRGGRDM(key, grd%)
                        '                Print #grfno, Trim(Str(Round(CEdPriDrpGrd(key)(grd%, gndr%), 2))); ",";
                        'Next grd%

                        '            Print #grfno, Trim(Str(Round(CEdPriDrpGrd(key, 7, gndr%), 2)))

                        If CEdprilen(key) > 7 Then
                            For grd1% = 8 To NPriGr      'Ireland has 8 grades
                                CEdPriDrpGrd(key)(grd1% - 1, gndr%) = CEdPriDrpGrd(key)(grd1% - 2, gndr%)
                            Next grd1%
                        End If


                    Next gndr%

                    'If InStr(CountryName(key), "Korea") > 0 Then Stop

                    If CEdPriEnrGGrd(key)(1, Male) = 999 Then
                        GradeSpread(key, Male, CInt(CEdpristart(key)), CInt(CEdprilen(key)), CEDPRIINTM(key), CEDPRISURM(key), CEDPRIENRGM(key), CEdPriEnrGGrd, CEdPriDrpGrd)
                        GradeSpread(key, Female, CInt(CEdpristart(key)), CInt(CEdprilen(key)), CEDPRIINTF(key), CEDPRISURF(key), CEDPRIENRGF(key), CEdPriEnrGGrd, CEdPriDrpGrd)
                        For grd% = 1 To NPriGr
                            CEdPriEnrGGrd(key)(grd%, NGender) =
                                CSng((CEdPriEnrGGrd(key)(grd%, Male) * cfagedstM(key)("Age" & (pristart + grd% - 1).ToString) +
                                        CEdPriEnrGGrd(key)(grd%, Female) * cfagedstF(key)("Age" & (pristart + grd% - 1).ToString)) /
                                          AMAX(0.0000001, (cfagedstM(key)("Age" & (pristart + grd% - 1).ToString) + cfagedstF(key)("Age" & (pristart + grd% - 1).ToString))))
                        Next

                        If CEDPRICRMImp(key) = True Then
                            'primary completion imputed; adjust with last grade enrillment rate
                            Dropoutrate = CSng(AMAX(0.005, 1 - (CEDPRISURM(key) / 100) ^ (1 / (CEdprilen(key) - 1))))  'aaverage dropout rate - do not have grade-wise dropout rate yet
                            CEdPriCRM(key) = CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), Male) * (1 - Dropoutrate)
                        Else
                            CEdPriCRM(key) = CSng(Amin(CEdPriCRM(key), CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), Male) - 0.5))
                        End If

                        If CEDPRICRFImp(key) = True Then
                            'primary completion imputed; adjust with last grade enrillment rate
                            Dropoutrate = CSng(AMAX(0.005, 1 - (CEDPRISURF(key) / 100) ^ (1 / (CEdprilen(key) - 1))))  'aaverage dropout rate - do not have grade-wise dropout rate yet
                            CEdPriCRF(key) = CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), Female) * (1 - Dropoutrate)
                        Else
                            CEdPriCRF(key) = CSng(Amin(CEdPriCRF(key), CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), Female) - 0.5))
                        End If

                    End If


                    'If InStr(CountryName(key), "Korea") > 0 Then Stop

                    'Total Grade Dropout Rate
                    Dim CumdrpMale As Single = 100
                    Dim CumdrpFemale As Single = 100

                    'If key = "Bangladesh" Then Stop

                    For grd% = 1 To NPriGr '6


                        If Not CEdPriDrpGrd(key)(grd%, Male).HasValue Or Not CEdPriDrpGrd(key)(grd%, Female).HasValue Then

                            CEdPriDrpGrd(key)(grd%, Male) = 999
                            CEdPriDrpGrd(key)(grd%, Female) = 999
                            CEdPriDrpGrd(key)(grd%, NGender) = 999

                            If grd% < CEdprilen(key) Then
                                CumdrpMale = CumdrpMale * 0
                                CumdrpFemale = CumdrpFemale * 0
                            End If
                        Else
                            'get rid of negative dropouts, now that we have repeaters
                            CEdPriDrpGrd(key)(grd%, Male) = AMAX(0, CEdPriDrpGrd(key)(grd%, Male))
                            CEdPriDrpGrd(key)(grd%, Female) = AMAX(0, CEdPriDrpGrd(key)(grd%, Female))

                            If CEdPriEnrGGrd(key)(grd%, NGender) < 999 Then
                                'use grade enrollment headcount for weighting
                                CEdPriDrpGrd(key)(grd%, NGender) =
                                CSng((CEdPriDrpGrd(key)(grd%, Male) * CEdPriEnrGGrd(key)(grd%, Male) * cfagedstM(key)("Age" & (pristart + grd% - 1).ToString) +
                                        CEdPriDrpGrd(key)(grd%, Female) * CEdPriEnrGGrd(key)(grd%, Female) * cfagedstF(key)("Age" & (pristart + grd% - 1).ToString)) /
                                          AMAX(0.0000001, (CEdPriEnrGGrd(key)(grd%, Male) * cfagedstM(key)("Age" & (pristart + grd% - 1).ToString) + CEdPriEnrGGrd(key)(grd%, Female) * cfagedstF(key)("Age" & (pristart + grd% - 1).ToString))))

                            Else
                                'use population for base
                                CEdPriDrpGrd(key)(grd%, NGender) =
                                CSng((CEdPriDrpGrd(key)(grd%, Male) * cfagedstM(key)("Age" & (pristart + grd% - 1).ToString) +
                                        CEdPriDrpGrd(key)(grd%, Female) * cfagedstF(key)("Age" & (pristart + grd% - 1).ToString)) /
                                          AMAX(0.0000001, (cfagedstM(key)("Age" & (pristart + grd% - 1).ToString) + cfagedstF(key)("Age" & (pristart + grd% - 1).ToString))))


                            End If

                            CEdPriDrpGrd(key)(grd%, NGender) = CSng(Amin(0.95, AMAX(0, CEdPriDrpGrd(key)(grd%, NGender))))

                            'mti 2020/12/01 start
                            If grd% < CEdprilen(key) Then 'up to CEdprilen(key) -1
                                CumdrpMale = CSng(CumdrpMale * (1 - CEdPriDrpGrd(key)(grd%, Male)))
                                CumdrpFemale = CSng(CumdrpFemale * (1 - CEdPriDrpGrd(key)(grd%, Female)))
                            End If



                            'mti 2020/12/01 start


                        End If

                    Next grd%

                    'mti 2020/12/01 start
                    If CEDPRISURMImp(key) = True And CumdrpMale > 0 Then
                        'Debug.Print CountryName(key); ",Male_Sur,"; CEDPRISURM(key); ","; CumdrpMale
                        CEDPRISURM(key) = CumdrpMale  'still 3%
                    End If

                    If CEDPRISURFImp(key) = True And CumdrpFemale > 0 Then
                        'Debug.Print CountryName(key); ",Female_Sur,"; CEDPRISURF(key); ","; CumdrpFemale
                        CEDPRISURF(key) = CumdrpFemale
                    End If
                    'mti 2020/12/01 End

                    'mti 2022/04/12 - start
                    For gndr% = 1 To 2
                        If gndr% = Male Then
                            CEdPriDrpGrd(key)(CInt(CEdprilen(key)), gndr%) = CSng(Amin(0.9, AMAX(0.005, (CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), gndr%) - CEdPriCRM(key)) / CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), gndr%))))
                        ElseIf gndr% = Female Then
                            CEdPriDrpGrd(key)(CInt(CEdprilen(key)), gndr%) = CSng(Amin(0.9, AMAX(0.005, (CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), gndr%) - CEdPriCRF(key)) / CEdPriEnrGGrd(key)(CInt(CEdprilen(key)), gndr%))))
                        End If


                    Next
                    'mti 2022/04/12 - End


                    '        '-----------------------------------------------------

                    For gndr% = 1 To 2
                        'if no grade data
                        'GradeSpread(R%, gndr%, startcycle, lencycle, Intake, Survival, Enrollment, GradeStudents(), GradeDropout())
                    Next

                    'If key = "Bangladesh" Then Stop
                Next key



            End Sub

            'jrs 2023/10/11
            Dim CEdSecLowrEnrGGrd As Dictionary(Of String, Single?(,))
            Dim CEdSecLowrDrpGrd As Dictionary(Of String, Single?(,))

            Sub RecomputeEdByGradeSecLowr(cntx As IRebuildFacade)
                '---------------------------------------------------------------------
                'mti 2020/09/01 Take whole Procedure


                '       Grade-specific enrollment and dropout rates
                '   ------------------------------------------------

                'mti 2021/03/17 start
                Dim Gr_Yr(3) As Integer
                'Dim CEdSecLowrDrpEst(10) As Boolean
                Dim gndr As Integer

                For gndr% = 1 To NGender
                    Gr_Yr(gndr) = BaseYear
                Next
                'mti 2021/03/17 End

                '   Open files with Education data
                '   -------------------------------

                'mti 2018/01/07 start
                'mti 2019/11/01

                'declaration taken to form declaration
                'Dim GDPPCPPPTbl As Recordset

                Dim EdSecLowrEnrGrTbl(7, NGender - 1) As IDictionary(Of String, Single?())
                Dim yrsEdSecLowrEnrGrTbl As Dictionary(Of Integer, Dictionary(Of Integer, Short()))
                yrsEdSecLowrEnrGrTbl = New Dictionary(Of Integer, Dictionary(Of Integer, Short()))
                Dim EdSecLowrDrpGrTbl(7, NGender) As IDictionary(Of String, Single?())
                Dim yrsEdSecLowrDrpGrTbl As Dictionary(Of Integer, Dictionary(Of Integer, Short()))
                yrsEdSecLowrDrpGrTbl = New Dictionary(Of Integer, Dictionary(Of Integer, Short()))

                'jrs 2023/10/11 Dim CEdSecLowrEnrGGrd As Dictionary(Of String, Single?(,))
                CEdSecLowrEnrGGrd = New Dictionary(Of String, Single?(,))
                'jrs 2023/10/11 Dim CEdSecLowrDrpGrd As Dictionary(Of String, Single?(,))
                CEdSecLowrDrpGrd = New Dictionary(Of String, Single?(,))

                For gndr% = 1 To 2
                    For grd% = 1 To 6
                        If gndr% = 1 Then TbName$ = "SeriesEdSecLowrEnrGr" & grd%.ToString.Trim & "MaleNo"
                        If gndr% = 2 Then TbName$ = "SeriesEdSecLowrEnrGr" & grd%.ToString.Trim & "FemaleNo"
                        Dim yrs = cntx.GetYears(TbName$).OrderBy(Function(y) y).ToArray()
                        If gndr% = 1 Then yrsEdSecLowrEnrGrTbl.Add(grd%, New Dictionary(Of Integer, Short())) 'mti 2023/10/09 - JRS
                        yrsEdSecLowrEnrGrTbl(grd%).Add(gndr%, yrs)
                        EdSecLowrEnrGrTbl(grd%, gndr%) = cntx.GetDice(TbName$, yrs)
                    Next
                Next

                '-------Dropout rates --------

                For gndr% = 1 To 3
                    For grd% = 1 To 5
                        If gndr% = 1 Then TbName$ = "SeriesEdSecLowrDrpGr" + grd%.ToString.Trim + "Male"
                        If gndr% = 2 Then TbName$ = "SeriesEdSecLowrDrpGr" + grd%.ToString.Trim + "Female"
                        If gndr% = 3 Then TbName$ = "SeriesEdSecLowrDrpGr" + grd%.ToString.Trim + "BothSexes"
                        Dim yrs = cntx.GetYears(TbName$).OrderBy(Function(y) y).ToArray()
                        If gndr% = 1 Then yrsEdSecLowrDrpGrTbl.Add(grd%, New Dictionary(Of Integer, Short())) 'mti 2023/10/09 jrs
                        yrsEdSecLowrDrpGrTbl(grd%).Add(gndr%, yrs)
                        EdSecLowrDrpGrTbl(grd%, gndr%) = cntx.GetDice(TbName$, yrs)
                    Next
                Next


                'write output to .csv
                '            grfno% = FreeFile()
                '            Open PutFdrv$ + "Runfiles\" + "SecLowrbyGradeAvlbty.csv" For Output As #grfno
                'Header$ = "Level_Var,Sex,Grd_Data_yr,Country,Level_Var_Name,Level_Var_Val,SecLowr_length, gr1,gr2,gr3,gr4,gr5,gr6,gr7"
                '            Print #grfno, Header$



                '   SecLowr Education Initial Conditions
                '   ------------------------------------
                Dim yr As Short
                Dim ValHold, MRVal, LevelTotal, SurvComputed As Single?
                Dim HasAllGrades As Boolean
                Dim ValH As Single

                For Each key In cntx.Regionalization.Keys

                    'Population by educational level

                    Dim pristart = CEdpristart(key)
                    Dim seclowrStart As Integer = CInt(CEdpristart(key) + CEdprilen(key))
                    Dim secupprStart As Integer = CInt(CEdpristart(key) + CEdprilen(key) + CEdseclowrlen(key))
                    Dim terstart As Integer = CInt(CEdpristart(key) + CEdprilen(key) + CEdseclowrlen(key) + CEdsecupprlen(key))
                    Dim terlen = 5



                    'enrollment by grade

                    'jrs 2023/10/11 increasing size of the array from 7 to 8
                    'mti 2023/10/09 start
                    Dim Vals(8, 3) As Single?
                    CEdSecLowrEnrGGrd.Add(key, Vals)
                    'mti 2023/10/09 end

                    For gndr% = 1 To 2

                        'If CountryName(key) = "Azerbaijan" And gndr = 1 Then Stop
                        'If CountryName(key) = "Angola" And gndr = 1 Then Stop
                        'If CountryName(key) = "Cambodia" And gndr = 1 Then Stop

                        'If key = "Angola" Then Stop
                        'If key = "Papua New Guinea" Then Stop

                        yr = BaseYear
                        Do While True


                            HasAllGrades = True
                            Dim GradeWithNoData = 0
                            Dim GradeMissing = 0
                            Dim gradesum As Single = 0

                            'mti 2023/10/09 start
                            'Dim Vals(7, 3) As Single?
                            'CEdSecLowrEnrGGrd.Add(key, Vals)
                            'mti 2023/10/09 end

                            For grd% = 1 To 7 'UIS data is only up to 7 grades

                                If grd% <= CEdseclowrlen(key) Then

                                    'grade enrollment in headcount
                                    MRVal = getMR(EdSecLowrEnrGrTbl(grd%, gndr%), yrsEdSecLowrEnrGrTbl(grd%)(gndr%), key)
                                    ValHold = getYearAroundOrRecent(EdSecLowrEnrGrTbl(grd%, gndr%), yrsEdSecLowrEnrGrTbl(grd%)(gndr%), key, MRVal, yr, False, 0)

                                    If ValHold.HasValue Then
                                        CEdSecLowrEnrGGrd(key)(grd%, gndr%) = CSng(0.0001 * ValHold / If(gndr% = Male, cfagedstM(key)("Age" & (seclowrStart + grd% - 1).ToString), cfagedstF(key)("Age" & (seclowrStart + grd% - 1).ToString)))
                                        gradesum = CSng(gradesum + 0.000001 * ValHold)
                                    Else
                                        HasAllGrades = False
                                        GradeWithNoData = grd%
                                        GradeMissing = GradeMissing + 1
                                        If GradeMissing > 2 Then    'if as many as 3 grades found others will be taken from a fitted line
                                            '                                    For grd1% = 1 To 7 'make everything Nothing and exit loop
                                            '                                        CEdPriEnrGGrd(key, grd1%, gndr%) = Nothing
                                            '                                    Next

                                            Exit For
                                        End If
                                    End If

                                End If

                            Next

                            If HasAllGrades Then

                                '        If gndr% = 1 Then Print #grfno, "SecLowr_EnrG, Male, "; Trim(Str(yr)); ","; Replace(CountryName(key), ",", " "); ", EnrGross, "; Trim(Str(Round(CEDSECLowrENRGM(key), 2))); ","; Trim(Str(CEdseclowrlen(key))); " ,";
                                'If gndr% = 2 Then Print #grfno, "SecLowr_EnrG, Female, "; Trim(Str(yr)); ","; Replace(CountryName(key), ",", " "); ", EnrGross, "; Trim(Str(Round(CEDSECLowrENRGF(key), 2))); ","; Trim(Str(CEdseclowrlen(key))); " ,";

                                'For grd1% = 1 To 6 'CEDPRIENRGGRDM(key, grd%)
                                '            Print #grfno, Trim(Str(Round(CEdSecLowrEnrGGrd(key, grd1%, gndr%), 2))); ",";
                                'Next grd1%
                                '        Print #grfno, Trim(Str(Round(CEdSecLowrEnrGGrd(key, 7, gndr%), 2)))

                                'mti 2021/03/17 start
                                Gr_Yr(gndr) = yr
                                'mti 2021/03/17 End

                                'If gndr% = 2 Then Debug.Print "Has FeMale Data,"; CEdprilen(key), ","; Replace(CountryName(key), ",", " ")
                                Exit Do

                            ElseIf GradeMissing = 1 Then



                                'only 1 grade missing use tot enrollment (grade unspecified)
                                If gndr = 1 Then MRVal = getMR(EDSecLowrEnrGMaleTbl, yrsEDSecLowrEnrGMale, key)
                                If gndr = 1 Then LevelTotal = getYearAroundOrRecent(EDSecLowrEnrGMaleTbl, yrsEDSecLowrEnrGMale, key, MRVal, yr, False, 0) * (100 - CEdSecLowrVocM(key)) / 100
                                'mti 2021/07/19
                                If gndr = 2 Then MRVal = getMR(EDSecLowrEnrGFemTbl, yrsEDSecLowrEnrGFem, key)
                                If gndr = 2 Then LevelTotal = getYearAroundOrRecent(EDSecLowrEnrGFemTbl, yrsEDSecLowrEnrGFem, key, MRVal, yr, False, 0) * (100 - CEdSecLowrVocF(key)) / 100

                                If LevelTotal.HasValue Then
                                    LevelTotal = CPopEdSecLowr(key)(gndr%) * LevelTotal / 100
                                    For grd1% = 1 To CInt(CEdseclowrlen(key)) 'make everything Nothing and exit loop
                                        If Not CEdSecLowrEnrGGrd(key)(grd1%, gndr%).HasValue Then
                                            CEdSecLowrEnrGGrd(key)(grd1%, gndr%) = 100 * (LevelTotal - gradesum) / If(gndr% = Male, cfagedstM(key)("Age" & (seclowrStart + grd1% - 1).ToString), cfagedstF(key)("Age" & (seclowrStart + grd1% - 1).ToString))
                                        End If
                                    Next
                                Else
                                    GradEnrFromLineFitSecLowr(CEdSecLowrEnrGGrd, key, gndr%)      'level enrollment and grade enrollment from disfferen years; estimate
                                End If


                                'CEdPriEnrGGrd(key, GradeWithNoData, gndr%) = 100 * (LevelTotal - gradesum) / cfagedst(pristart + GradeWithNoData - 1, ICount, gndr%)



                                '        For grd1% = 1 To 6 'CEDPRIENRGGRDM(key, grd%)
                                '            Print #grfno, Trim(Str(Round(CEdSecLowrEnrGGrd(key, grd1%, gndr%), 2))); ",";
                                'Next grd1%
                                '        Print #grfno, Trim(Str(Round(CEdSecLowrEnrGGrd(key, 7, gndr%), 2)))

                                'mti 2021/03/17 start
                                Gr_Yr(gndr) = yr
                                'mti 2021/03/17 End

                                'If gndr% = 2 Then Debug.Print "Has FeMale Data,"; CEdprilen(key), ","; Replace(CountryName(key), ",", " ")
                                Exit Do

                            ElseIf GradeMissing = 2 And CEdseclowrlen(key) > 4 Then
                                'only 1 grade missing use tot enrollment (grade unspecified)



                                GradEnrFromLineFitSecLowr(CEdSecLowrEnrGGrd, key, gndr%)

                                '                        If gndr = 1 Then LevelTotal = CPopEdPri(key, gndr%) * CEDPRIENRGM(key) / 100
                                '                        If gndr = 2 Then LevelTotal = CPopEdPri(key, gndr%) * CEDPRIENRGF(key) / 100
                                '                        CEdPriEnrGGrd(key, GradeWithNoData, gndr%) = 100 * (LevelTotal - gradesum) / cfagedst(pristart + GradeWithNoData - 1, ICount, gndr%)


                                '        For grd1% = 1 To 6 'CEDPRIENRGGRDM(key, grd%)
                                '            Print #grfno, Trim(Str(Round(CEdSecLowrEnrGGrd(key, grd1%, gndr%), 2))); ",";
                                'Next grd1%
                                '        Print #grfno, Trim(Str(Round(CEdSecLowrEnrGGrd(key, 7, gndr%), 2)))

                                'mti 2021/03/17 start
                                Gr_Yr(gndr) = yr
                                'mti 2021/03/17 End

                                'If gndr% = 2 Then Debug.Print "Has FeMale Data,"; CEdprilen(key), ","; Replace(CountryName(key), ",", " ")
                                Exit Do
                                '
                                '
                                ''If CEdprilen(key) - GradeMissing < 3 Then 'fit line
                            Else

                                '                        If yr < BaseYear - 4 Then '6 '4 '3  'limit this to 3 years at most
                                '                            yr = BaseYear + 1
                                '                        Else
                                'mti 2023/04/10 start
                                If yr = BaseYear + 7 Then ''mti 2023/10/15 was 7' base 2019 now; ' start 'was 5;  base is 2017 now; need to go back till 2010; 7 year each way; 'was 3
                                    'mti 2023/04/10 start

                                    '        If gndr% = 1 Then Print #grfno, "SecLowr_EnrG, Male, No Grade Data,"; Replace(CountryName(key), ",", " "); ", EnrGross, "; Trim(Str(Round(CEDSECLowrENRGM(key), 2))); ","; Trim(Str(CEdseclowrlen(key)))
                                    'If gndr% = 2 Then Print #grfno, "SecLowr_EnrG, Female, No Grade Data,"; Replace(CountryName(key), ",", " "); ", EnrGross, "; Trim(Str(Round(CEDSECLowrENRGF(key), 2))); ","; Trim(Str(CEdseclowrlen(key)))

                                    For grd1% = 1 To 7
                                        CEdSecLowrEnrGGrd(key)(grd1%, gndr%) = Nothing
                                    Next grd1%



                                    Exit Do

                                ElseIf yr = BaseYear Then
                                    yr = CShort(yr - 1)
                                ElseIf yr < BaseYear Then
                                    yr = BaseYear + (BaseYear - yr)
                                Else    'yr>Baseyear
                                    yr = CShort(BaseYear - (yr - BaseYear) - 1)
                                End If

                                'If key = "Netherlands" Then Stop
                            End If
                        Loop
                        'If gndr% = 1 Then Debug.Print "Total Male "

                        If CEdseclowrlen(key) > 6 Then
                            For grd% = 7 To NPriGr      'Ireland has 8 grades
                                CEdSecLowrEnrGGrd(key)(grd%, gndr%) = CEdSecLowrEnrGGrd(key)(grd% - 1, gndr%) * (CEdSecLowrEnrGGrd(key)(grd% - 1, gndr%) / CEdSecLowrEnrGGrd(key)(grd% - 2, gndr%))
                            Next grd%
                        End If

                        'If key = "Netherlands" Then Stop

                        'mti 2022/04/12 - start
                        Dim EdSecLowrTot_From_GradeEnr As Single = 0
                        Dim PopTot As Single = 0
                        For grd% = 1 To CInt(CEdseclowrlen(key))
                            Dim Gr_Students = If(gndr% = 1, cfagedstM(key)("Age" + (seclowrStart + grd% - 1).ToString), cfagedstF(key)("Age" + (seclowrStart + grd% - 1).ToString)) * CEdSecLowrEnrGGrd(key)(grd%, gndr%) / 100
