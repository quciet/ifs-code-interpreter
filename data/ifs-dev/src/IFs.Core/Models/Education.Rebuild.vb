                End If

                NDropout = AMAX(0, CalcDropoutFromEnrNIntk(lencycle, NetIntake, NetEnrollment))
                GDropout = AMAX(0, CSng(1 - (Survival / 100) ^ (1 / (lencycle - 1))))

