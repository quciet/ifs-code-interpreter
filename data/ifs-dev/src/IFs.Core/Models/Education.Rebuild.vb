                        Dim yrs = cntx.GetYears(TbName$).OrderBy(Function(y) y).ToArray()
                        'jrs 2023/10/03 replaced nothing with New Dictionary(Of Integer, Short())
                        If gndr% = 1 Then yrsEdPriDrpGrTbl.Add(grd%, New Dictionary(Of Integer, Short()))
                        yrsEdPriDrpGrTbl(grd%).Add(gndr%, yrs)
