                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollGrossTotal").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollGrossTotal", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollGrossTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollGrossTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        FuncName = TbName
                        EnrGFromData.Add(item.Key, True)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriSurMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, FuncName, cntx.FirstYear, cntx, 140, 0, "Div", 1000, 20)
                            If FuncName = "Estimate" Then EnrGFromData(item.Key) = False
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                            EnrGFromData(item.Key) = False
                        End If

                        'intake: 150; enroll: 140; grate: 130
                        CEDSECENRGT.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                For Each key In cntx.Regionalization.Keys
                    EnrGSecTotFromData.Add(key, EnrGFromData(key))
                Next

                'Secondary net enrollment rates:  total
                Dim Low_Enrn As Single
                If cntx.HistoricMode Then
                    Low_Enrn = 0.4
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollNetOlder").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollNetOlder", years)
                    Estimate = cntx.GetRegression("Secondary Gross Enrollment Versus Secondary Net Enrollment Total (1970)").ToEstimator(CEDSECENRGT)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollNetOlder", "Earliest")
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollNet", "Earliest") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = If(s.Value, m.Value))

                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "SeriesEdSecEnrollGrossTotal", item.Key, "", cntx.FirstYear, cntx, 100, 0)
                        End If
                        EnrNFromData.Add(item.Key, ValHold.HasValue)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        'for history, lowest data value  is 1.44; for 2000 base 3.69 chad
                        CEDSECENRNT.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 100))
                        EnrnSave.Add(item.Key, CEDSECENRNT(item.Key))
                        EnrNSecTotFromData.Add(item.Key, EnrNFromData(item.Key))
                    Next
                Else
                    Low_Enrn = 4
                    TbName$ = "Secondary Gross Enrollment Versus Secondary Net Enrollment Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Dim FuncName As String
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CEDSECENRGT)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollNet").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollNet", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollNet", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollNet", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        FuncName = TbName
                        EnrNFromData.Add(item.Key, True)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriSurMaleTbl, years, "SeriesEdSecEnrollGrossTotal", item.Key, FuncName, cntx.FirstYear, cntx, 100, 0)
                            If FuncName = "Estimate" Then EnrNFromData(item.Key) = False
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                            EnrNFromData(item.Key) = False
                        End If

                        'for history, lowest data value  is 1.44; for 2000 base 3.69 chad
                        CEDSECENRNT.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 100))
                        EnrnSave.Add(item.Key, CEDSECENRNT(item.Key))
                        EnrNSecTotFromData.Add(item.Key, EnrNFromData(item.Key))
                    Next
                End If

                '---------------------------------------------------------------------------------------------------------------
                '------------- reconcile sec net and gross enrollment,  total (boys and girls together), lower and upper combined
                '----------------------------------------------------------------------------------------------------------------
                If cntx.HistoricMode = True Then
                    Estimate = cntx.GetRegression("Secondary Net Enrollment Versus Secondary Gross Enrollment Total  (1970)").ToEstimator(CEDSECENRNT)
                Else
                    TbName$ = "Secondary Net Enrollment Versus Secondary Gross Enrollment Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName$).ToEstimator(CEDSECENRNT)
                End If

                For Each key In cntx.Regionalization.Keys
                    If CEDSECENRGT(key) < CEDSECENRNT(key) Then
                        ValHold = Estimate(key)
                        CEDSECENRGT(key) = AMAX(Low_Enrg, Amin(140, ValHold))
                    Else
                        If EnrnSave(key) <> CEDSECENRNT(key) Then
                            'net enrollment changed by conditions after initial calculation, e.g. Bhutan
                            'adjust estimated gross enrolment, so that the difference is not too high
                            If Not EnrGFromData(key) Then
                                ValHold = Estimate(key)
                                CEDSECENRGT(key) = AMAX(Low_Enrg, Amin(140, ValHold))
                            End If
                        End If
                    End If

                    CEDSECENRNT(key) = AMAX(Low_Enrn, Amin(100, CEDSECENRNT(key)))
                    CEDSECENRGT(key) = AMAX(Low_Enrg, Amin(140, CEDSECENRGT(key)))
                Next

                '----------------------------------------------------------------------------------------------------------------------
                '-------------------- percentage of adult population (15+) with secondary education, total, male and female combined
                '-----------Will be bound by net secondary enrollment rate, (why not by uppser secondary graduation rate?)------
                '------------------------------------------------------------------------------------------------------------
                If cntx.HistoricMode Then
                    Low_Limit = 0.05
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15Total", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Graduates Total (1960)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15Total", 1960)
                                      Select Key = s.Key, Value = s.Value)

                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPERT.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                Else
                    Low_Limit = 0.5
                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2000) Versus Secondary Graduates 15+ Total (Log) (MostRecent)"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 15+ Total (Log) (" & BaseYear & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15Total", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15Total", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads15Total", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 start
                            ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15) '5, 15
                            'mti 2019/11/01 end
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPERT.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                End If

                'initialize percentages of adults(15 to 24) with at least secondary education, total
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15to24Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15to24Total", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Graduates 15 to 24 Total (1960) Log").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15to24Total", 1960)
                                      Select Key = s.Key, Value = s.Value)

                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER15TO24T.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER15TO24T(item.Key) = AMAX(CEDSECPERT(item.Key) + 2, CEDSECPER15TO24T(item.Key))
                        CEDSECPER15TO24T(item.Key) = Amin(CEDSECENRNT(item.Key), CEDSECPER15TO24T(item.Key))
                    Next
                Else
                    Low_Limit = 3
                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Graduates 15 to 24 Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 15 to 24 Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15to24Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15to24Total", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15to24Total", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads15to24Total", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 Start
                            'ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER15TO24T.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER15TO24T(item.Key) = AMAX(CEDSECPERT(item.Key) + 2, CEDSECPER15TO24T(item.Key))
                        CEDSECPER15TO24T(item.Key) = Amin(CEDSECENRNT(item.Key), CEDSECPER15TO24T(item.Key))
                    Next
                End If

                'initialize percentages of adults(15 to 24) with at least secondary education, total
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads20to24Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads20to24Total", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Graduates 20 to 24 Total (1960) Log").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads20to24Total", 1960)
                                      Select Key = s.Key, Value = s.Value)

                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER20TO24T.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER20TO24T(item.Key) = AMAX(CEDSECPERT(item.Key) + 2, CEDSECPER20TO24T(item.Key))
                        CEDSECPER20TO24T(item.Key) = Amin(CEDSECENRNT(item.Key), CEDSECPER20TO24T(item.Key))
                    Next
                Else
                    Low_Limit = 3
                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Graduates 20 to 24 Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 20 to 24 Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads20to24Total").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads20to24Total", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads20to24Total", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads20to24Total", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 Start
                            'ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER20TO24T.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER20TO24T(item.Key) = AMAX(CEDSECPERT(item.Key) + 2, CEDSECPER20TO24T(item.Key))
                        CEDSECPER20TO24T(item.Key) = Amin(CEDSECENRNT(item.Key), CEDSECPER20TO24T(item.Key))
                    Next
                End If

                '------------------------------------
                'secondary lower male
                '----------------------------------------------------------------


                'transition from primary to (lower) secondary general (% of pri last grade enrollees going to 1st grade of sec; general)
                Dim TranSLMfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrGSLMFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim GradSLMfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                'Transition Secondary Lower Male From Data?
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Transition From Primary to Lower Sec Male (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        TranSLMfromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECLowrTRANM.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP 2011) Versus Transition From Primary to Lower Sec Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Transition From Primary to Lower Sec Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriTransition2SecMale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        TranSLMfromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECLowrTRANM.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'Enrollment Gross Secondary Lower Male from data?
                If cntx.HistoricMode Then
                    Low_Enrg = 3
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Lower Gross Enrollment Rate Male (2000)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = Estimate(key)
                        EnrGSLMFromData.Add(key, False)
                        CEDSECLowrENRGM.Add(key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 5
                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP) Versus Secondary Lower Gross Enrollment Rate Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Lower Gross Enrollment Rate Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecLowerEnrollGrossMale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLowerEnrollGrossMale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerEnrollGrossMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLowerEnrollGrossMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added False parameter
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If

                        EnrGSLMFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECLowrENRGM.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                'secondary lower (General) survival male
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Male (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = Estimate(key)
                        GradSLMfromData.Add(key, False)
                        CEDSECLowrGRateM.Add(key, ApplyLimits(ValHold, 5, 150))
                        GrEst(key) = ValHold
                        GrRaw(key) = Nothing
                        GrRawYr(key) = 0
                    Next
                Else
                    TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecLowerGradRateAllMal").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLowerGradRateAllMal", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerGradRateAllMal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLowerGradRateAllMal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        GrEst(item.Key) = Nothing
                        GrRaw(item.Key) = Nothing
                        GrRawYr(item.Key) = 0
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False, , GrRawYr(item.Key))
                        End If
                        GrRaw(item.Key) = ValHold

                        GradSLMfromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                            GrEst(item.Key) = ValHold
                        End If

                        CEDSECLowrGRateM.Add(item.Key, ApplyLimits(ValHold, 5, 150))
                    Next
                End If

                'vocational share, as a % of total
                For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerVocAllMale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Select Key = s.Key, Value = If(s.Value, 0))
                    CEdSecLowrVocM.Add(item.Key, item.Value)
                    CEdSecLowrVocM(item.Key) = Amin(70, CEdSecLowrVocM(item.Key))
                Next

                'Adjust General transition with vocational share (not voc enr)
                For Each key In cntx.Regionalization.Keys
                    If CEDSECLowrTRANM(key) + CEdSecLowrVocM(key) < 100 And CEDSECLowrTRANM(key) < 90 Then
                        CEDSECLowrTRANM(key) = CEDSECLowrTRANM(key) + CEdSecLowrVocM(key)
                    End If
                Next

                For Each key In cntx.Regionalization.Keys
                    'mti 2019/11/22 added CEDPRIENRGM
                    ReconcileSec_New(key, CInt(CEdseclowrlen(key)), EnrGSLMFromData(key), TranSLMfromData(key), GradSLMfromData(key),
                    CEdPriCRM(key), CEDSECLowrENRGM(key), CEDSECLowrTRANM(key), CEDSECLowrGRateM(key), CEDPRIENRGM(key))
                Next

                'Secondary male
                '---------------
                'Secondary gross enrollment rates male
                If cntx.HistoricMode Then
                    Low_Enrg = 3
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollGrossMale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollGrossMale", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Gross Enrollment Rate Male (1970)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollGrossMale", "Earliest")
                                      Select Key = s.Key, Value = s.Value)
                        EnrGFromData(item.Key) = True
                        ValHold = item.Value
                        If Not ValHold.HasValue And EnrGSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRGT(item.Key)
                        End If
                        If Not ValHold.HasValue Then 'use regression
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, "", cntx.FirstYear, cntx, 140, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            EnrGFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'intake: 150; enroll: 140; grate: 130
                        CEDSECENRGM.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 5
                    'jrs 2024/06/24
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Gross Enrollment Rate Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim FuncName As String
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollGrossMale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollGrossMale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollGrossMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollGrossMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        EnrGFromData(item.Key) = True

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDSecEnrGMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If

                        If Not ValHold.HasValue Then
                            FuncName = TbName
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, FuncName, cntx.FirstYear, cntx, 140, 0, "Div", 1000, 20)
                            If FuncName = "Estimate" Then EnrGFromData(item.Key) = False 'used function
                        End If

                        If Not ValHold.HasValue And EnrGSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRGT(item.Key)
                        End If

                        If Not ValHold.HasValue Then
                            EnrGFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'intake: 150; enroll: 140; grate: 130
                        CEDSECENRGM.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                'Secondary net enrollment rates:  male
                If cntx.HistoricMode Then
                    Low_Enrn = 1
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollNetMaleOlder").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollNetMaleOlder", years)
                    Estimate = cntx.GetRegression("Secondary Gross Enrollment Versus Secondary Net Enrollment Male (1970)").ToEstimator(CEDSECENRGM)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollNetMaleOlder", "Earliest")
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollNetMale", "Earliest") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = If(s.Value, m.Value))
                        EnrNFromData(item.Key) = True
                        ValHold = item.Value
                        If Not ValHold.HasValue And EnrNSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRNT(item.Key)
                        End If
                        If Not ValHold.HasValue Then 'use regression
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesEdSecEnrollGrossMale", item.Key, "", cntx.FirstYear, cntx, 100, 0)
                        End If
                        If Not ValHold.HasValue Then
                            EnrNFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'for history, lowest data value  is 1.44; for 2000 base 3.69 chad
                        CEDSECENRNM.Add(item.Key, ApplyLimits(ValHold, Low_Enrn, 100))
                        EnrnSave(item.Key) = CEDSECENRNM(item.Key)
                    Next
                Else
                    Low_Enrn = 4
                    TbName$ = "Secondary Gross Enrollment Versus Secondary Net Enrollment Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CEDSECENRGM)
                    Dim FuncName As String
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollNetMale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollNetMale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollNetMale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollNetMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        EnrNFromData(item.Key) = True

                        ValHold = item.Value

                        If Not ValHold.HasValue And EnrNSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRNT(item.Key)
                        End If

                        If Not ValHold.HasValue Then
                            FuncName = TbName
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesEdSecEnrollGrossMale", item.Key, FuncName, cntx.FirstYear, cntx, 100, 0)
                            If FuncName = "Estimate" Then EnrNFromData(item.Key) = False 'used function
                        End If

                        If Not ValHold.HasValue Then
                            EnrNFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'for history, lowest data value  is 1.44; for 2000 base 3.69 chad
                        CEDSECENRNM.Add(item.Key, ApplyLimits(ValHold, Low_Enrn, 100))
                        EnrnSave(item.Key) = CEDSECENRNM(item.Key)
                    Next
                End If

                'reconcile sec net and gross - enrollment male
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("Secondary Net Enrollment Versus Secondary Gross Enrollment Male (1970)").ToEstimator(CEDSECENRNM)
                Else
                    TbName$ = "Secondary Net Enrollment Versus Secondary Gross Enrollment Male (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CEDSECENRNM)
                End If

                For Each key In cntx.Regionalization.Keys
                    If CEDSECENRGM(key) < CEDSECENRNM(key) Then
                        ValHold = Estimate(key)
                        CEDSECENRGM(key) = ApplyLimits(ValHold, Low_Enrg, 140)
                    Else
                        If EnrnSave(key) <> CEDSECENRNM(key) Then
                            'net enrollment changed by conditions after initial calculation, e.g. Bhutan
                            'adjust estimated gross enrolment, so that the difference is not too high
                            If Not EnrGFromData(key) Then
                                ValHold = Estimate(key)
                                CEDSECENRGM(key) = ApplyLimits(ValHold, Low_Enrg, 140)
                            End If
                        End If
                    End If
                    'check mti
                    CEDSECENRNM(key) = ApplyLimits(CEDSECENRNM(key), Low_Enrn, 100)
                    CEDSECENRGM(key) = ApplyLimits(CEDSECENRGM(key), Low_Enrg, 140)
                Next

                '--------------------------------------------------------
                'secondary upper male
                Dim TranSUMFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrGSUMFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim GradSUMFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                'transition from lower sec to upper secondary general (% of pri last grade enrollees going to 1st grade of sec; general)
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Transition From Lower to Upper Sec Male (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        TranSUMFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprTRANM.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecLower2UpperMale")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLower2UpperMale", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Transition From Lower to Upper Sec Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Transition From Lower to Upper Sec Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLower2UpperMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLower2UpperMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added False
                            ValHold = getYearAroundOrRecent(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        TranSUMFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECUpprTRANM.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'upper Secondary gross enrollment rates male
                If cntx.HistoricMode Then
                    Low_Enrg = 3
                    'jrs 2025/05/08 added Log to the name
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Upper Gross Enrollment Rate Male (2000) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        EnrGSUMFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprENRGM.Add(key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 5

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecUpperEnrollGrossMale")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecUpperEnrollGrossMale", years)

                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP) Versus Secondary Upper Gross Enrollment Rate Male (" & CStr(cntx.BaseYear) & ")"
                    'jrs 2025/05/08 added Log to the name
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Upper Gross Enrollment Rate Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    'gvdb 2024/04/05
                    'unused variable
                    'Dim seclen As Single?

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecUpperEnrollGrossMale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecUpperEnrollGrossMale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added False
                            ValHold = getYearAroundOrRecent(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        EnrGSUMFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            'mti 2019/11/22 removed if
                            'If EnrGSLMFromData(item.Key) And EnrGFromData(item.Key) Then
                            '    'estimate upper from lower and total secondary
                            '    seclen = CEdseclowrlen(item.Key) + CEdsecupprlen(item.Key)
                            '    ValHold = (CEDSECENRGM(item.Key) * seclen - CEdseclowrlen(item.Key) * CEDSECLowrENRGM(item.Key)) / CEdsecupprlen(item.Key)
                            'Else
                            ValHold = Estimate(item.Key)
                            'End If
                        End If

                        CEDSECUpprENRGM.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                '------------ Gross enrollment ratio, upper secondary, all programs (vocational plus general) --
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Upper Graduation Rate, All, Male (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        GradSUMFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprGRateM.Add(key, ApplyLimits(ValHold, 5, 150))
                        GrEst(key) = ValHold
                        GrRaw(key) = Nothing
                        GrRawYr(key) = 0
                    Next
                Else
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecUpperGradRateAllMal")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecUpperGradRateAllMal", years)

                    TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Upper Graduation Rate, All, Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    'gvdb 2024/04/05
                    'unused variable
                    'Dim seclen As Single?

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecUpperGradRateAllMal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecUpperGradRateAllMal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        GrEst(item.Key) = Nothing
                        GrRawYr(item.Key) = 0

                        If item.Value.HasValue Then
                            ValHold = item.Value
                            GrRawYr(item.Key) = cntx.BaseYear
                        Else
                            ValHold = getYearAroundOrRecent(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False, , GrRawYr(item.Key))
                        End If
                        GrRaw(item.Key) = ValHold
                        GradSUMFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                            GrEst(item.Key) = ValHold
                        End If

                        CEDSECUpprGRateM.Add(item.Key, ApplyLimits(ValHold, 5, 150))
                    Next
                End If

                'vocational as a % of total
                For Each item In (From s In cntx.GetSlice("SeriesEdSecUpperVocAllMale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Select Key = s.Key, Value = If(s.Value, 0))
                    CEdSecUpprVocM.Add(item.Key, item.Value)
                    CEdSecUpprVocM(item.Key) = Amin(70, CEdSecUpprVocM(item.Key))
                Next

                '------------Adult with secondary education---------------------
                If cntx.HistoricMode Then
                    Low_Limit = 0.05
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15Male").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15Male", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Graduates Male (1960)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15Male", cntx.FirstYear)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If
                        CEDSECPERM.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                Else
                    Low_Limit = 0.5

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecAdultGrads15Male")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15Male", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2000) Versus Secondary Graduates 15+ Male (Log) (MostRecent)"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 15+ Male (Log) (" & BaseYear & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15Male", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads15Male", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 start
                            ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15) '5
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPERM.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                End If

                'initialize percentages of adults(15 to 24) with at least secondary education, male
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15to24Male").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15to24Male", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Graduates 15 to 24 Male (1960) Log").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15to24Male", cntx.FirstYear)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER15TO24M.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER15TO24M(item.Key) = AMAX(CEDSECPERM(item.Key) + 2, CEDSECPER15TO24M(item.Key))
                        CEDSECPER15TO24M(item.Key) = Amin(CEDSECENRNM(item.Key), CEDSECPER15TO24M(item.Key))
                    Next
                Else
                    Low_Limit = 3

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecAdultGrads15to24Male")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15to24Male", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Graduates 15 to 24 Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 15 to 24 Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15to24Male", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads15to24Male", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 Start
                            'ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER15TO24M.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER15TO24M(item.Key) = AMAX(CEDSECPERM(item.Key) + 2, CEDSECPER15TO24M(item.Key))
                        CEDSECPER15TO24M(item.Key) = Amin(CEDSECENRNM(item.Key), CEDSECPER15TO24M(item.Key))
                    Next
                End If

                'initialize percentages of adults(20 to 24) with at least secondary education, male
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads20to24Male").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads20to24Male", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Graduates 20 to 24 Male (1960) Log").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads20to24Male", cntx.FirstYear)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER20TO24M.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER20TO24M(item.Key) = AMAX(CEDSECPERM(item.Key) + 2, CEDSECPER20TO24M(item.Key))
                        CEDSECPER20TO24M(item.Key) = Amin(CEDSECENRNM(item.Key), CEDSECPER20TO24M(item.Key))
                    Next
                Else
                    Low_Limit = 3

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecAdultGrads20to24Male")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads20to24Male", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Graduates 20 to 24 Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 20 to 24 Male (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads20to24Male", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads20to24Male", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 start
                            'ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER20TO24M.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER20TO24M(item.Key) = AMAX(CEDSECPERM(item.Key) + 2, CEDSECPER20TO24M(item.Key))
                        CEDSECPER20TO24M(item.Key) = Amin(CEDSECENRNM(item.Key), CEDSECPER20TO24M(item.Key))
                    Next
                End If

                For Each Key In cntx.Regionalization.Keys
                    'Transition database says all transition; for some countries data seem to be general only; Adjust General transition with vocational share (not voc enr)
                    If CEDSECUpprTRANM(Key) + CEdSecUpprVocM(Key) < 100 And CEDSECUpprTRANM(Key) < 80 Then
                        CEDSECUpprTRANM(Key) = CEDSECUpprTRANM(Key) + CEdSecUpprVocM(Key)
                    End If
                    ReconcileSec_New(Key, CInt(CEdsecupprlen(Key)), EnrGSUMFromData(Key), TranSUMFromData(Key), GradSUMFromData(Key),
                    CEDSECLowrGRateM(Key), CEDSECUpprENRGM(Key), CEDSECUpprTRANM(Key), CEDSECUpprGRateM(Key), CEDSECLowrENRGM(Key))
                    'Basic Education enrollment Rate - Crude initialization, using length weighted enrollment rates
                    CEdBasEnrGM.Add(Key, (CEDPRIENRGM(Key) * CEdprilen(Key) + CEDSECLowrENRGM(Key) * CEdseclowrlen(Key)) / (CEdprilen(Key) + CEdseclowrlen(Key)))
                Next

                '==========================================
                'secondary female
                '------------------------------------
                'secondary lower female
                Dim TranSLFfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrGSLFFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim GradSLFfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                'transition from primary to (lower) secondary general (% of pri last grade enrollees going to 1st grade of sec; general)

                'Transition Secondary Lower Female From Data?
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Transition From Primary to Lower Sec Female (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        TranSLFfromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECLowrTRANF.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP 2011) Versus Transition From Primary to Lower Sec Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Transition From Primary to Lower Sec Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriTransition2SecFemale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If PriCRFFromData(item.Key) = False Then
                            TranSLFfromData.Add(item.Key, False)
                        Else
                            TranSLFfromData.Add(item.Key, ValHold.HasValue)
                        End If


                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECLowrTRANF.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'Enrollment Gross Secondary Lower Female from data?
                If cntx.HistoricMode Then
                    Low_Enrg = 3
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Lower Gross Enrollment Rate Female (2000)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = Estimate(key)
                        EnrGSLFFromData.Add(key, False)
                        CEDSECLowrENRGF.Add(key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 5
                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP) Versus Secondary Lower Gross Enrollment Rate Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Lower Gross Enrollment Rate Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecLowerEnrollGrossFemale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLowerEnrollGrossFemale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerEnrollGrossFemale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLowerEnrollGrossFemale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added False
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If

                        EnrGSLFFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECLowrENRGF.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                'secondary lower (General) survival Female
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Female (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = Estimate(key)
                        GradSLFfromData.Add(key, False)
                        CEDSECLowrGRateF.Add(key, ApplyLimits(ValHold, 5, 150))
                    Next
                Else
                    TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim years As Short() = cntx.GetYears("SeriesEdSecLowerGradRateAllFem").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriSurMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLowerGradRateAllFem", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerGradRateAllFem", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLowerGradRateAllFem", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriSurMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If

                        GradSLFfromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECLowrGRateF.Add(item.Key, ApplyLimits(ValHold, 5, 150))
                    Next
                End If

                'vocational share, as a % of total
                For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerVocAllFemale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Select Key = s.Key, Value = If(s.Value, 0))
                    CEdSecLowrVocF.Add(item.Key, item.Value)
                    CEdSecLowrVocF(item.Key) = Amin(70, CEdSecLowrVocF(item.Key))
                Next

                'Adjust General transition with vocational share (not voc enr)
                For Each key In cntx.Regionalization.Keys
                    If CEDSECLowrTRANF(key) + CEdSecLowrVocF(key) < 100 And CEDSECLowrTRANF(key) < 90 Then
                        CEDSECLowrTRANF(key) = CEDSECLowrTRANF(key) + CEdSecLowrVocF(key)
                    End If
                Next

                Dim TranLowrMax As Single, SurvLowrMax As Single
                TranLowrMax = 100
                SurvLowrMax = 100

                For Each key In cntx.Regionalization.Keys
                    'mti 2019/11/22 added CEDPRIENRGF
                    ReconcileSec_New(key, CInt(CEdseclowrlen(key)), EnrGSLFFromData(key), TranSLFfromData(key), GradSLFfromData(key),
                    CEdPriCRF(key), CEDSECLowrENRGF(key), CEDSECLowrTRANF(key), CEDSECLowrGRateF(key), CEDPRIENRGF(key))
                Next

                '----------female secondary----------
                '---------------
                'Secondary gross enrollment rates female
                If cntx.HistoricMode Then
                    Low_Enrg = 0.3
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollGrossFemale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollGrossFemale", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Gross Enrollment Rate Female (1970)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollGrossFemale", "Earliest")
                                      Select Key = s.Key, Value = s.Value)
                        EnrGFromData(item.Key) = True
                        ValHold = item.Value
                        If Not ValHold.HasValue And EnrGSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRGT(item.Key)
                        End If
                        If Not ValHold.HasValue Then 'use regression
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, "", cntx.FirstYear, cntx, 140, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            EnrGFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'intake: 150; enroll: 140; grate: 130
                        CEDSECENRGF.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 3
                    'jrs 2024/06/24 TbName$ = "GDP/Capita (PPP) Versus Secondary Gross Enrollment Rate Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Gross Enrollment Rate Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    Dim FuncName As String
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollGrossFemale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollGrossFemale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollGrossFemale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollGrossFemale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        EnrGFromData(item.Key) = True

                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDSecEnrGMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If

                        If Not ValHold.HasValue Then
                            FuncName = TbName
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, FuncName, cntx.FirstYear, cntx, 140, 0, "Div", 1000, 20)
                            If FuncName = "Estimate" Then EnrGFromData(item.Key) = False 'used function
                        End If

                        If Not ValHold.HasValue And EnrGSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRGT(item.Key)
                        End If

                        If Not ValHold.HasValue Then
                            EnrGFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'intake: 150; enroll: 140; grate: 130
                        CEDSECENRGF.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                'Secondary net enrollment rates:  female
                If cntx.HistoricMode Then
                    Low_Enrn = 0.2
                    Estimate = cntx.GetRegression("Secondary Gross Enrollment Versus Secondary Net Enrollment Female (1970)").ToEstimator(CEDSECENRGF)

                    Dim yrs As Short() = cntx.GetYears("SeriesEdSecEnrollNetFemaleOlder").OrderBy(Function(yy) yy).ToArray()
                    Dim Tbl = cntx.GetDice("SeriesEdSecEnrollNetFemaleOlder", yrs)

                    Dim yrs2 As Short() = cntx.GetYears("SeriesEdSecEnrollNetFemale").OrderBy(Function(yy) yy).ToArray()
                    Dim Tbl2 = cntx.GetDice("SeriesEdSecEnrollNetFemale", yrs2)

                    For Each key In cntx.Regionalization.Keys
                        EnrNFromData(key) = True
                        ValHold = getClosestYrVal(Tbl, yrs, key, cntx.FirstYear, HistDist)

                        If Not ValHold.HasValue Then
                            ValHold = getClosestYrVal(Tbl2, yrs2, key, cntx.FirstYear, HistDist)
                        End If

                        'if data on total is available (and male has no data), use total; make sure male and total are not same as total for many countries
                        If Not ValHold.HasValue And EnrNSecTotFromData(key) Then
                            ValHold = CEDSECENRNT(key)
                        End If
                        'mti November 20, 2011 - end

                        If Not ValHold.HasValue Then
                            EnrNFromData(key) = False
                            ValHold = Estimate(key)
                        End If

                        'for history, lowest data value  is 1.44; for 2000 base 3.69 chad
                        CEDSECENRNF.Add(key, ApplyLimits(ValHold, Low_Enrn, 100))
                        EnrnSave(key) = CEDSECENRNF(key)
                    Next

                Else
                    Low_Enrn = 2
                    TbName$ = "Secondary Gross Enrollment Versus Secondary Net Enrollment Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CEDSECENRGF)
                    Dim FuncName As String
                    Dim years As Short() = cntx.GetYears("SeriesEdSecEnrollNetFemale").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecEnrGMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecEnrollNetFemale", years)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecEnrollNetFemale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Join m In cntx.GetSlice("SeriesEdSecEnrollNetFemale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)

                        EnrNFromData(item.Key) = True

                        ValHold = item.Value

                        If Not ValHold.HasValue And EnrNSecTotFromData(item.Key) Then
                            ValHold = CEDSECENRNT(item.Key)
                        End If

                        If Not ValHold.HasValue Then
                            FuncName = TbName
                            ValHold = LReg(EDSecEnrGMaleTbl, years, "SeriesEdSecEnrollGrossFemale", item.Key, FuncName, cntx.FirstYear, cntx, 100, 0)
                            If FuncName = "Estimate" Then EnrNFromData(item.Key) = False 'used function
                        End If

                        If Not ValHold.HasValue Then
                            EnrNFromData(item.Key) = False
                            ValHold = Estimate(item.Key)
                        End If

                        'for history, lowest data value  is 1.44; for 2000 base 3.69 chad
                        CEDSECENRNF.Add(item.Key, ApplyLimits(ValHold, Low_Enrn, 100))
                        EnrnSave(item.Key) = CEDSECENRNF(item.Key)
                    Next
                End If

                'reconcile sec net and gross - enrollment female
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("Secondary Net Enrollment Versus Secondary Gross Enrollment Female (1970)").ToEstimator(CEDSECENRNF)
                Else
                    TbName$ = "Secondary Net Enrollment Versus Secondary Gross Enrollment Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CEDSECENRNF)
                End If

                For Each key In cntx.Regionalization.Keys
                    If CEDSECENRGF(key) < CEDSECENRNF(key) Then
                        ValHold = Estimate(key)
                        CEDSECENRGF(key) = ApplyLimits(ValHold, Low_Enrg, 140)
                    Else
                        If EnrnSave(key) <> CEDSECENRNF(key) Then
                            'net enrollment changed by conditions after initial calculation, e.g. Bhutan
                            'adjust estimated gross enrolment, so that the difference is not too high
                            If Not EnrGFromData(key) Then
                                ValHold = Estimate(key)
                                CEDSECENRGF(key) = ApplyLimits(ValHold, Low_Enrg, 140)
                            End If
                        End If
                    End If
                    'check mti
                    CEDSECENRNF(key) = ApplyLimits(CEDSECENRNF(key), Low_Enrn, 100)
                    CEDSECENRGF(key) = ApplyLimits(CEDSECENRGF(key), Low_Enrg, 140)
                Next

                '--------------------------------------------------------
                'secondary upper Female
                Dim TranSUFFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrGSUFFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim GradSUFFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                'transition from lower sec to upper secondary general (% of pri last grade enrollees going to 1st grade of sec; general)
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Transition From Lower to Upper Sec Female (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        TranSUFFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprTRANF.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecLower2UpperFemale")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLower2UpperFemale", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Transition From Lower to Upper Sec Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Transition From Lower to Upper Sec Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLower2UpperFemale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLower2UpperFemale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added False
                            ValHold = getYearAroundOrRecent(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        TranSUFFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECUpprTRANF.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'upper Secondary gross enrollment rates Female
                If cntx.HistoricMode Then
                    Low_Enrg = 3
                    'jrs 2025/05/08 added Log to the name
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Upper Gross Enrollment Rate Female (2000) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        EnrGSUFFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprENRGF.Add(key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 5

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecUpperEnrollGrossFemale")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecUpperEnrollGrossFemale", years)

                    'jrs 2025/05/08 added Log to the name
                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP) Versus Secondary Upper Gross Enrollment Rate Female (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Upper Gross Enrollment Rate Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    'gvdb 2024/04/05
                    'unused variable
                    'Dim seclen As Single?

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecUpperEnrollGrossFemale", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecUpperEnrollGrossFemale", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added false
                            ValHold = getYearAroundOrRecent(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        EnrGSUFFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            'mti 2019/11/22 removed if
                            'If EnrGSLFFromData(item.Key) And EnrGFromData(item.Key) Then
                            '    'estimate upper from lower and total secondary
                            '    seclen = CEdseclowrlen(item.Key) + CEdsecupprlen(item.Key)
                            '    ValHold = (CEDSECENRGF(item.Key) * seclen - CEdseclowrlen(item.Key) * CEDSECLowrENRGF(item.Key)) / CEdsecupprlen(item.Key)
                            'Else
                            ValHold = Estimate(item.Key)
                            'End If
                        End If

                        CEDSECUpprENRGF.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                '------------ Gross enrollment ratio, upper secondary, all programs (vocational plus general) --
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Upper Graduation Rate, All, Female (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        GradSUFFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprGRateF.Add(key, ApplyLimits(ValHold, 5, 150))
                    Next
                Else
                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecUpperGradRateAllFem")
                             Where FirstYear - 20S < y
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecUpperGradRateAllFem", years)

                    TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Upper Graduation Rate, All, Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    'gvdb 2024/04/05
                    'unused variable
                    'Dim seclen As Single?

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecUpperGradRateAllFem", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecUpperGradRateAllFem", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        GradSUFFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECUpprGRateF.Add(item.Key, ApplyLimits(ValHold, 5, 150))
                    Next
                End If

                'vocational as a % of total
                For Each item In (From s In cntx.GetSlice("SeriesEdSecUpperVocAllFemale", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Select Key = s.Key, Value = If(s.Value, 0))
                    CEdSecUpprVocF.Add(item.Key, item.Value)
                    CEdSecUpprVocF(item.Key) = Amin(70, CEdSecUpprVocF(item.Key))
                Next

                '-----------'percentage of adult population (15+) with secondary education---------------
                If cntx.HistoricMode Then
                    Low_Limit = 0.05
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15Female").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15Female", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Graduates Female (1960)").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15Female", cntx.FirstYear)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "SeriesGDP2000PCPPP", item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If
                        CEDSECPERF.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                Else
                    Low_Limit = 0.5

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecAdultGrads15Female")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15Female", years)

                    'jrs 2024/06/06 TbName$ = "GDP/Capita (PPP 2000) Versus Secondary Graduates 15+ Female (Log) (MostRecent)"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 15+ Female (" & BaseYear & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15Female", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads15Female", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 start
                            ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15) '5
                            'mti 2019/11/01 End                            
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPERF.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                    Next
                End If

                'initialize percentages of adults(15 to 24) with at least secondary education, female
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads15to24Female").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15to24Female", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Graduates 15 to 24 Female (1960) Log").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15to24Female", cntx.FirstYear)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = getClosestYrVal(EDPriPerMaleTbl, years, item.Key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER15TO24F.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER15TO24F(item.Key) = AMAX(CEDSECPERF(item.Key) + 2, CEDSECPER15TO24F(item.Key))
                        CEDSECPER15TO24F(item.Key) = Amin(CEDSECENRNF(item.Key), CEDSECPER15TO24F(item.Key))
                    Next
                Else
                    Low_Limit = 3

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecAdultGrads15to24Female")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads15to24Female", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Graduates 15 to 24 Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 15 to 24 Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads15to24Female", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads15to24Female", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 Start
                            'ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER15TO24F.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER15TO24F(item.Key) = AMAX(CEDSECPERF(item.Key) + 2, CEDSECPER15TO24F(item.Key))
                        CEDSECPER15TO24F(item.Key) = Amin(CEDSECENRNF(item.Key), CEDSECPER15TO24F(item.Key))
                    Next
                End If

                'initialize percentages of adults(20 to 24) with at least secondary education, female
                If cntx.HistoricMode Then
                    Low_Limit = 0.2
                    Dim years As Short() = cntx.GetYears("SeriesEdSecAdultGrads20to24Female").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriPerMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads20to24Female", years)
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Graduates 20 to 24 Female (1960) Log").ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads20to24Female", cntx.FirstYear)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = getClosestYrVal(EDPriPerMaleTbl, years, item.Key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = LReg(EDPriPerMaleTbl, years, "GDPPCP" & ConstantDollarsYear.ToString, item.Key, "", cntx.FirstYear, cntx, 100, 0, "Div", 1000)
                        End If
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER20TO24F.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER20TO24F(item.Key) = AMAX(CEDSECPERF(item.Key) + 2, CEDSECPER20TO24F(item.Key))
                        CEDSECPER20TO24F(item.Key) = Amin(CEDSECENRNF(item.Key), CEDSECPER20TO24F(item.Key))
                    Next

                Else
                    Low_Limit = 3

                    Dim years As Short()
                    years = (From y In cntx.GetYears("SeriesEdSecAdultGrads20to24Female")
                             Order By y Ascending
                    ).Take(25).ToArray
                    Dim EDSecLowr2UpprMaleTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecAdultGrads20to24Female", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Graduates 20 to 24 Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Secondary Graduates 20 to 24 Female (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecAdultGrads20to24Female", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecAdultGrads20to24Female", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/01 Start
                            'ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 5, 15)
                            ValHold = getYearOrEstimation(EDSecLowr2UpprMaleTbl, years, item.Key, item.MR, cntx.BaseYear, 15, 15)
                            'mti 2019/11/01 End
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEDSECPER20TO24F.Add(item.Key, ApplyLimits(ValHold, Low_Limit, 100))
                        CEDSECPER20TO24F(item.Key) = AMAX(CEDSECPERF(item.Key) + 2, CEDSECPER20TO24F(item.Key))
                        CEDSECPER20TO24F(item.Key) = Amin(CEDSECENRNF(item.Key), CEDSECPER20TO24F(item.Key))
                    Next
                End If

                For Each Key In cntx.Regionalization.Keys
                    'Transition database says all transition; for some countries data seem to be general only; Adjust General transition with vocational share (not voc enr)
                    If CEDSECUpprTRANF(Key) + CEdSecUpprVocF(Key) < 100 And CEDSECUpprTRANF(Key) < 80 Then
                        CEDSECUpprTRANF(Key) = CEDSECUpprTRANF(Key) + CEdSecUpprVocF(Key)
                    End If
                    'mti 2019/11/22 CEDSECLowrENRGF
                    ReconcileSec_New(Key, CInt(CEdsecupprlen(Key)), EnrGSUFFromData(Key), TranSUFFromData(Key), GradSUFFromData(Key),
                    CEDSECLowrGRateF(Key), CEDSECUpprENRGF(Key), CEDSECUpprTRANF(Key), CEDSECUpprGRateF(Key), CEDSECLowrENRGF(Key))
                    'Basic Education enrollment Rate - Crude initialization, using length weighted enrollment rates
                    CEdBasEnrGF.Add(Key, (CEDPRIENRGF(Key) * CEdprilen(Key) + CEDSECLowrENRGF(Key) * CEdseclowrlen(Key)) / (CEdprilen(Key) + CEdseclowrlen(Key)))
                Next

                '==============================
                'Secondary Total
                '------------------------------------
                'secondary lower total
                Dim TranSLTfromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrGSLTFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim GradSLTFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                Dim CEdSecLowrTranIYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecLowrTranFYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecLowrTranIVal As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                'transition from lower sec to upper secondary general (% of pri last grade enrollees going to 1st grade of sec; general)
                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Transition From Primary to Lower Sec Total (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        TranSLTfromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECLowrTRANT.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    Dim years As Short()
                    years = cntx.GetYears("SeriesEdPriTransition2SecTotal").OrderBy(Function(yy) yy).ToArray()
                    Dim EDPriTranSecTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdPriTransition2SecTotal", years)

                    'jrs 2024/07/04 TbName$ = "GDP/Capita (PPP 2011) Versus Transition From Primary to Lower Sec Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Transition From Primary to Lower Sec Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)
                    For Each item In (From s In cntx.GetSlice("SeriesEdPriTransition2SecTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdPriTransition2SecTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            ValHold = getYearAroundOrRecent(EDPriTranSecTotTbl, years, item.Key, item.MR, cntx.BaseYear)
                        End If
                        TranSLTfromData.Add(item.Key, ValHold.HasValue)
                        If PriCRTFromData(item.Key) = False Then 'completion estimated already
                            TranSLTfromData(item.Key) = False
                        End If

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEdSecLowrTranIYR.Add(item.Key, Nothing)
                        CEdSecLowrTranFYR.Add(item.Key, Nothing)
                        CEdSecLowrTranIVal.Add(item.Key, Nothing)

                        CEdSecLowrTranGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDPriTranSecTotTbl, years, item.Key, cntx.BaseYear,
                                                CEdSecLowrTranIYR(item.Key), CEdSecLowrTranFYR(item.Key), CEdSecLowrTranIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))

                        CEDSECLowrTRANT.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

                'lower Secondary gross enrollment rates Total
                Dim CEdSecLowrEnrgIYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecLowrEnrgFYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecLowrEnrgIVal As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    Low_Enrg = 3
                    Estimate = cntx.GetRegression("GDP/Capita (PPP) Versus Secondary Lower Gross Enrollment Rate Total (2000)").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        EnrGSLTFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECLowrENRGT.Add(key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                Else
                    Low_Enrg = 5

                    Dim years As Short()
                    years = cntx.GetYears("SeriesEdSecLowerEnrollGrossTotal").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecLowrEnrGTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLowerEnrollGrossTotal", years)

                    TbName$ = "GDP/Capita (PPP) Versus Secondary Lower Gross Enrollment Rate Total (" & CStr(cntx.BaseYear) & ")"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerEnrollGrossTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLowerEnrollGrossTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added false
                            ValHold = getYearAroundOrRecent(EDSecLowrEnrGTotTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        EnrGSLTFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEdSecLowrEnrgIYR.Add(item.Key, Nothing)
                        CEdSecLowrEnrgFYR.Add(item.Key, Nothing)
                        CEdSecLowrEnrgIVal.Add(item.Key, Nothing)

                        CEdSecLowrEnrgGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDSecLowrEnrGTotTbl, years, item.Key, cntx.BaseYear,
                                                CEdSecLowrEnrgIYR(item.Key), CEdSecLowrEnrgFYR(item.Key), CEdSecLowrEnrgIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))

                        CEDSECLowrENRGT.Add(item.Key, ApplyLimits(ValHold, Low_Enrg, 140))
                    Next
                End If

                '-----------------------------
                'secondary lower (General) survival Total
                Dim CEdSecLowrGradIYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecLowrGradFYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecLowrGradIVal As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Total (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        GradSLTFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECLowrGRateT.Add(key, ApplyLimits(ValHold, 5, 150))
                    Next
                Else

                    TbName$ = "GDP/Capita (PPP 2011) Versus Secondary Lower Graduation Rate, All, Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx)
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerGradRateAllTot", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLowerGradRateAllTot", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added false
                            ValHold = getYearAroundOrRecent(EDSecLowrGRateTotTbl, yrsEDSecLowrGRateTot, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        GradSLTFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEdSecLowrGradIYR.Add(item.Key, Nothing)
                        CEdSecLowrGradFYR.Add(item.Key, Nothing)
                        CEdSecLowrGradIVal.Add(item.Key, Nothing)

                        CEdSecLowrGradGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDSecLowrGRateTotTbl, yrsEDSecLowrGRateTot, item.Key, cntx.BaseYear,
                                                CEdSecLowrGradIYR(item.Key), CEdSecLowrGradFYR(item.Key), CEdSecLowrGradIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))

                        CEDSECLowrGRateT.Add(item.Key, ApplyLimits(ValHold, 5, 150))
                    Next
                End If

                For Each item In (From s In cntx.GetSlice("SeriesEdSecLowerVocAllTotal", cntx.BaseYear, CoalescePolicy.MostRecent)
                                  Select Key = s.Key, Value = If(s.Value, 0))
                    'vocational share, as a % of total students
                    CEdSecLowrVocT.Add(item.Key, item.Value)

                    'mti 2015/11/15 - start
                    CEdSecLowrVocT(item.Key) = Amin(70, CEdSecLowrVocT(item.Key))
                    'mti 2015/11/15 - end

                    'mti 2016/12/09 Start
                    'Adjust General transition with vocational share (not voc enr)
                    If CEDSECLowrTRANT(item.Key) + CEdSecLowrVocT(item.Key) < 100 And CEDSECLowrTRANT(item.Key) < 90 Then
                        CEDSECLowrTRANT(item.Key) = CEDSECLowrTRANT(item.Key) + CEdSecLowrVocT(item.Key)
                    End If

                    'mti 2019/11/01 start 'Baseyear - (ag_start - gradage)
                    CEDSECLOWRPER20TO24T.Add(item.Key, getHistAverage(EDSecLowrGRateTotTbl, yrsEDSecLowrGRateTot, item.Key, CInt(BaseYear - (20 - CEdpristart(item.Key) - CEdprilen(item.Key) - CEdseclowrlen(item.Key))), 5))
                    'Keep Nulls for now 'use reconciled rate later
                    'If IsNull(CEDSECLOWRPER20TO24T(key)) Then CEDSECLOWRPER20TO24T(key) = CEDSECLowrGRateT(key) 'use reconciled rate
                    'mti 2019/11/01 End

                Next

                '------------------------------------------------

                'secondary upper Total
                Dim TranSUTFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim EnrGSUTFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)
                Dim GradSUTFromData As Dictionary(Of String, Boolean) = New Dictionary(Of String, Boolean)

                Dim CEdSecUpprTranIYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecUpprTranFYR As Dictionary(Of String, Short?) = New Dictionary(Of String, Short?)
                Dim CEdSecUpprTranIVal As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                If cntx.HistoricMode Then
                    Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Transition From Lower to Upper Sec Total (MostRecent) Log").ToEstimator(CGDPPCP)
                    For Each key In cntx.Regionalization.Keys
                        TranSUTFromData.Add(key, False)
                        ValHold = Estimate(key)
                        CEDSECUpprTRANT.Add(key, ApplyLimits(ValHold, 5, 100))
                    Next
                Else
                    Dim years As Short()
                    years = cntx.GetYears("SeriesEdSecLower2UpperTotal").OrderBy(Function(yy) yy).ToArray()
                    Dim EDSecLowrEnrGTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdSecLower2UpperTotal", years)

                    'jrs 2024/06/21 TbName$ = "GDP/Capita (PPP 2011) Versus Transition From Lower to Upper Sec Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Transition From Lower to Upper Sec Total (" & CStr(cntx.BaseYear) & ") Log"
                    TbName$ = getFunctionNameYrOrMstRct(TbName$, cntx.BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                    Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                    For Each item In (From s In cntx.GetSlice("SeriesEdSecLower2UpperTotal", cntx.BaseYear)
                                      Join m In cntx.GetSlice("SeriesEdSecLower2UpperTotal", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        If item.Value.HasValue Then
                            ValHold = item.Value
                        Else
                            'mti 2019/11/22 added false
                            ValHold = getYearAroundOrRecent(EDSecLowrEnrGTotTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                        End If
                        TranSUTFromData.Add(item.Key, ValHold.HasValue)

                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If

                        CEdSecUpprTranIYR.Add(item.Key, Nothing)
                        CEdSecUpprTranFYR.Add(item.Key, Nothing)
                        CEdSecUpprTranIVal.Add(item.Key, Nothing)

                        CEdSecUpprTranGR.Add(item.Key, getAnnualGrowthRatePeriodAvgExtended(EDSecLowrEnrGTotTbl, years, item.Key, cntx.BaseYear,
                                                CEdSecUpprTranIYR(item.Key), CEdSecUpprTranFYR(item.Key), CEdSecUpprTranIVal(item.Key),
                                                , , 5, 20, 16, , True, True, 2000, 4, 2, 2, 2))

                        CEDSECUpprTRANT.Add(item.Key, ApplyLimits(ValHold, 5, 100))
                    Next
                End If

