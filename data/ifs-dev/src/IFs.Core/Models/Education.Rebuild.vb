                    CPopEdSecLowrGrad(key)(Total) = CPopEdSecLowrGrad(key)(Male) + CPopEdSecLowrGrad(key)(Female)
                    CPopEdSecUppr(key)(Total) = CPopEdSecUppr(key)(Male) + CPopEdSecUppr(key)(Female)
                    CPopEdSecUpprGrad(key)(Total) = CPopEdSecUpprGrad(key)(Male) + CPopEdSecUpprGrad(key)(Female)
                    CPopEdTer(key)(Total) = CPopEdTer(key)(Male) + CPopEdTer(key)(Female)
                    CPopEdTerGrad(key)(Total) = CPopEdTerGrad(key)(Male) + CPopEdTerGrad(key)(Female)


