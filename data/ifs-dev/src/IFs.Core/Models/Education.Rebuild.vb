                    Else
                        NetIntake = CSng(AMAX(5, CalcIntakeFromSurvEnr(lencycle, NSurvival, NetEnrollment, 2, CSng(Intake), CSng(Survival))))
                    End If
                    'mti 2019/11/01 End

                End If
                NSurvival = CSng(100 * ((1 - NDropout) ^ (lencycle - 1)))

                'net dropout within twenty(?) percent of gross dropout
                If NSurvival - Survival > 15 Then 'prevent net survival from being unreasonably different from gross

                    'mti 2019/12/09 Start
                    'If InFirstCondition Then Debug.Print "FirstandThird", CountryName(key), NetIntakefromData, NetEnrollFromData, SurvivalFromData, NetIntake, NetEnrollment, Survival
