                            ''jrs 2023/10/03 CEdPriEnrGGrd.Add(key, ValPEs)
                            'CEdPriEnrGGrd(key) = ValPEs
                            ''mti 2023/10/15 End

                            For grd% = 1 To 7 'UIS data is only up to 7 grades

                                If grd% <= CEdprilen(key) Then

                                    'grade enrollment in headcount
                                    Dim yrs As Short()
                                    yrs = yrsEdPriEnrGrTbl(grd%)(gndr%)
                                    MRval = getMR(EdPriEnrGrTbl(grd%, gndr%), yrs, key)
                                    ValHold = getYearAroundOrRecent(EdPriEnrGrTbl(grd%, gndr%), yrs, key, MRval, yr, False, 0)

                                    If ValHold.HasValue Then
                                        CEdPriEnrGGrd(key)(grd%, gndr%) = CSng(0.0001 * ValHold / If(gndr% = Male, cfagedstM(key)("Age" & (pristart + grd% - 1).ToString), cfagedstF(key)("Age" & CInt(pristart + grd% - 1).ToString)))
                                        gradesum = CSng(gradesum + 0.000001 * ValHold)

                                    Else
                                        HasAllGrades = False
                                        GradeWithNoData = grd%
                                        GradeMissing = GradeMissing + 1
                                        If GradeMissing > 2 Then    'if as many as 3 grades found others will be taken from a fitted line
                                            '                                    For grd1% = 1 To 7 'make everything null and exit loop
                                            '                                        CEdPriEnrGGrd(key)(grd1%, gndr%) = Null
                                            '                                    Next

                                            Exit For
                                        End If
                                    End If

                                End If

                            Next

                            If HasAllGrades Then

                                '        If gndr% = 1 Then Print #grfno, "Pri_EnrG, Male, "; Trim(Str(yr)); ","; Replace(CountryName(key), ",", " "); ", EnrGross, "; Trim(Str(Round(CEDPRIENRGM(key), 2))); ","; Trim(Str(CEdprilen(key))); " ,";
