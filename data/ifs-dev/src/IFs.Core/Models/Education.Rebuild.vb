                        CEDQUALSECSCIF.Add(key, ValHold * CEDQUALSECSCIM(key))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesEdQualSecSciRatioNAEK", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If
                        ValHold = ApplyLimits(ValHold, 1, 1.5)
                        CEDQUALSECSCIM.Add(item.Key, 2 * CEDQUALSECSCIT(item.Key) / (1 + ValHold))
                        CEDQUALSECSCIF.Add(item.Key, ValHold * CEDQUALSECSCIM(item.Key))
                    Next
                End If

                Func$ = "Educational Years (25+) Versus Education Quality Scores, Secondary, Math (" & CStr(yno) & ") Lin"
                Func$ = getFunctionNameYrOrMstRct(Func$, yno, cntx)
                years = cntx.GetYears("SeriesEdQualSecMathAvgScrWBGA").OrderBy(Function(y) y).ToArray()
                EdQualPriReadTotTbl = cntx.GetDice("SeriesEdQualSecMathAvgScrWBGA", years)
                For Each key In cntx.Regionalization.Keys
                    ValHold = EstimateFromMostRecentRevMTI(CEDYRSAGE25T(key), yno, EdQualPriReadTotTbl, years,
                        diceEdYearsAge25TotTbl, EdYearsAge25TotTbl, key, Func, cntx, 100, 1, "", 0, Proximity, , False)
                    CEDQUALSECMATHT.Add(key, ApplyLimits(ValHold, 1, 100))
                Next

                'jrs 2024/07/04
                TbName = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Gender Ratio in Secondary Math Scores (" & BaseYear & ") Log"
                TbName = getFunctionNameYrOrMstRct(TbName, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")
                'Estimate = cntx.GetRegression("GDP/Capita (PPP 2011) Versus Gender Ratio in Secondary Math Scores (Log)").ToEstimator(CGDPPCP)
                Estimate = cntx.GetRegression(TbName).ToEstimator(CGDPPCP)

                If cntx.HistoricMode Then
                    'mti 2019/04/29  Flex Hist Base Start
                    Dim yrs As Short() = cntx.GetYears("SeriesEdQualSecMathRatioNAEK").OrderBy(Function(y) y).ToArray()
                    Dim EdQualSecMathGRTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdQualSecMathRatioNAEK", yrs)
                    For Each key In cntx.Regionalization.Keys
                        ValHold = getClosestYrVal(EdQualSecMathGRTbl, yrs, key, cntx.FirstYear, HistDist)
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(key)
                        End If
                        ValHold = ApplyLimits(ValHold, 0.5, 1.5)
                        CEDQUALSECMATHM.Add(key, 2 * CEDQUALSECMATHT(key) / (1 + ValHold))
                        CEDQUALSECMATHF.Add(key, ValHold * CEDQUALSECMATHM(key))
                    Next
                    'mti 2019/04/29  Flex Hist Base End
                Else
                    For Each item In (From s In cntx.GetSlice("SeriesEdQualSecMathRatioNAEK", cntx.BaseYear, CoalescePolicy.MostRecent)
                                      Select Key = s.Key, Value = s.Value)
                        ValHold = item.Value
                        If Not ValHold.HasValue Then
                            ValHold = Estimate(item.Key)
                        End If
                        ValHold = ApplyLimits(ValHold, 0.5, 1.5)
                        CEDQUALSECMATHM.Add(item.Key, 2 * CEDQUALSECMATHT(item.Key) / (1 + ValHold))
                        CEDQUALSECMATHF.Add(item.Key, ValHold * CEDQUALSECMATHM(item.Key))
                    Next
                End If

                For Each key In cntx.Regionalization.Keys
                    CEDQUALPRIALLM.Add(key, (CEDQUALPRIMATHM(key) + CEDQUALPRIREADM(key) + CEDQUALPRISCIM(key)) / 3)
                    CEDQUALPRIALLF.Add(key, (CEDQUALPRIMATHF(key) + CEDQUALPRIREADF(key) + CEDQUALPRISCIF(key)) / 3)
                    CEDQUALPRIALLT.Add(key, (CEDQUALPRIMATHT(key) + CEDQUALPRIREADT(key) + CEDQUALPRISCIT(key)) / 3)

                    CEDQUALSECALLM.Add(key, (CEDQUALSECMATHM(key) + CEDQUALSECREADM(key) + CEDQUALSECSCIM(key)) / 3)
                    CEDQUALSECALLF.Add(key, (CEDQUALSECMATHF(key) + CEDQUALSECREADF(key) + CEDQUALSECSCIF(key)) / 3)
                    CEDQUALSECALLT.Add(key, (CEDQUALSECMATHT(key) + CEDQUALSECREADT(key) + CEDQUALSECSCIT(key)) / 3)
                Next

                '-------------- Score for adults Primary---------------------
                Dim CEDQUALAG15_Pri As Single?, ValHold_Current As Single?, ValHold_Prior As Single, Year_Prior As Dictionary(Of String, Short) = New Dictionary(Of String, Short)

                Dim diceEdQualPriAllTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdQualPriAllAvgScrWBGA", EdQualPriAllTotTbl)

                If EdQualPriAll_Prior_Yr > 0 Then
                    For Each item In (From s In cntx.GetSlice("SeriesEdQualPriAllAvgScrWBGA", EdQualPriAll_Prior_Yr)
                                      Join m In cntx.GetSlice("SeriesEdQualPriAllAvgScrWBGA", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
                        CEDQUALAG15_Pri = Nothing
                        ValHold_Current = Nothing
                        ValHold_Prior = Nothing
                        Year_Prior.Add(item.Key, 0)
                        ValHold = getYearAroundOrRecent(diceEdQualPriAllTotTbl, EdQualPriAllTotTbl, item.Key, item.MR, EdQualPriAll_Prior_Yr, False)
                        CEDQUALAG15PRIT.Add(item.Key, ValHold)
                    Next
                Else
                    For Each key In cntx.Regionalization.Keys
                        CEDQUALAG15PRIT.Add(key, Nothing)
                        Year_Prior.Add(key, 0)
                    Next
                End If

                Dim FuncBoth As String, FuncEdYear As String, FuncGDPPCP As String
                FuncBoth$ = "Educ Qual Pri All, Total, WBGA 2010 (Lin) vs GDPPCPLN and Edyear25"
                FuncEdYear$ = "Educational Years (15+) Versus Education Quality Scores, Primary, All, Both Sexes (Log)"
                'jrs 2024/06/11 FuncGDPPCP$ = "GDP/Capita (PPP 2011) Versus Education Quality Scores, Primary, All, Both Sexes (Log)"
                FuncGDPPCP$ = "GDP/Capita (PPP " & ConstantDollarsYear & ") Versus Education Quality Scores, Primary, All, Both Sexes (Log)"
                FuncGDPPCP$ = getFunctionNameYrOrMstRct(FuncGDPPCP$, BaseYear, cntx, "(PPP " & ConstantDollarsYear & ")")

                Estimate = cntx.GetRegression(FuncBoth$).Normalize("EdYearsAge25 (Linear)", "GDPPCP (Log)").ToEstimator(CEDYRSAGE25T, CGDPPCP)
                Dim MRval As Single?, ValEdYearsAge25Tot As Single?, ValGDPPCP As Single?
                Dim EstimateEd As SeriesEstimator, EstimateEd2 As SeriesEstimator
                EstimateEd = cntx.GetRegression(FuncEdYear$).ToEstimator(CEDYRSAGE25T)
                Dim ValEdYearsAge25Tot2 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)
                Dim EstimateGDP As SeriesEstimator, EstimateGDP2 As SeriesEstimator
                EstimateGDP = cntx.GetRegression(FuncGDPPCP$).ToEstimator(CGDPPCP)
                Dim ValGDPPCP2 As Dictionary(Of String, Single?) = New Dictionary(Of String, Single?)

                Dim diff As Single?

                For Each key In cntx.Regionalization.Keys
                    If Not CEDQUALAG15PRIT(key).HasValue Then
                        'No data; Try to use the multvariate function driven by income and education
                        ValHold_Current = Estimate(key)
                        'Year column in GDPPC table is given priority for prior data
                        If EdYearsAge25Tot_Prior_Yr <> 0 Then
                            MRval = getMR(diceEdYearsAge25TotTbl, EdYearsAge25TotTbl, key)
                            ValEdYearsAge25Tot = getYearAroundOrRecent(diceEdYearsAge25TotTbl, EdYearsAge25TotTbl, key, MRval, EdYearsAge25Tot_Prior_Yr, False)
                            ValEdYearsAge25Tot2.Add(key, ValEdYearsAge25Tot)
                            ValGDPPCP = getYearAroundOrRecent(diceGDPPCPPPTbl, GDPPCPPPTbl, key, MRval, EdYearsAge25Tot_Prior_Yr, False)
                            If ValEdYearsAge25Tot.HasValue Then
                                If ValGDPPCP.HasValue Then
                                    Call AnalFunc(FuncBoth$, New Single() {CSng(ValEdYearsAge25Tot), CSng(ValGDPPCP)}, ValHold_Prior,
                                    New String() {"EdYearsAge25 (Linear)", "GDPPCP (Log)"}, cntx)
                                    Year_Prior(key) = EdYearsAge25Tot_Prior_Yr
                                Else
                                    EstimateEd2 = cntx.GetRegression(FuncEdYear$).ToEstimator(ValEdYearsAge25Tot2)
                                    ValHold_Prior = CSng(EstimateEd2(key))
                                    ValHold_Current = EstimateEd(key)
                                    Year_Prior(key) = EdYearsAge25Tot_Prior_Yr
                                End If
                            End If
                        End If

                        If Year_Prior(key) = 0 Then
                            ValGDPPCP = getYearAroundOrRecent(diceGDPPCPPPTbl, GDPPCPPPTbl, key, MRval, GDPPCP_Prior_Yr, False)
                            ValGDPPCP2.Add(key, ValGDPPCP)
                            If ValGDPPCP.HasValue Then
                                EstimateGDP2 = cntx.GetRegression(FuncGDPPCP).ToEstimator(ValGDPPCP2)
                                ValHold_Prior = CSng(EstimateGDP2(key))
                                ValHold_Current = EstimateGDP(key)
                                Year_Prior(key) = GDPPCP_Prior_Yr
                            End If
                        End If

                        If Year_Prior(key) > 0 Then
                            diff = ValHold_Current - ValHold_Prior
                            If diff > 0 Then
                                CEDQUALAG15PRIT(key) = CEDQUALPRIALLT(key) - diff
                            End If
                        Else
                            CEDQUALAG15PRIT(key) = CEDQUALPRIALLT(key) - 10  'put min
                        End If
                    End If
                    CEDQUALAG15PRIT(key) = AMAX(1, Amin(CEDQUALPRIALLT(key) - 5, CEDQUALAG15PRIT(key)))
                Next

                'Male and female--- 
                Dim EdQualPriAllGRTbl As Short() = cntx.GetYears("SeriesEdQualPriTotalRatioNAEK").OrderBy(Function(yy) yy).ToArray()
                Dim diceEdQualPriAllGRTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdQualPriTotalRatioNAEK", EdQualPriAllGRTbl)
                For Each key In cntx.Regionalization.Keys
                    ValHold = Nothing
                    If EdQualPriAll_Prior_Yr > 0 Then
                        MRval = getMR(diceEdQualPriAllGRTbl, EdQualPriAllGRTbl, key)
                        ValHold = getYearAroundOrRecent(diceEdQualPriAllGRTbl, EdQualPriAllGRTbl, key, MRval, EdQualPriAll_Prior_Yr, False, 10)
                    End If

                    If Not ValHold.HasValue Then
                        If CGDPPCP(key) > 3 Then
                            ValHold = 1.01 'average is .998 for 1995; function doesn't makre sense
                        Else
                            ValHold = 0.95
                        End If
                    End If

                    ValHold = ApplyLimits(ValHold, 0.5, 1.5)

                    CEDQUALAG15PRIM.Add(key, 2 * CEDQUALAG15PRIT(key) / (1 + ValHold))
                    CEDQUALAG15PRIF.Add(key, ValHold * CEDQUALAG15PRIM(key))
                Next

                '-------------- Score for adults Seconary---------------------
                Dim CEDQUALAG15_Sec As Single?

                Dim diceEdQualSecAllTotTbl As IDictionary(Of String, Single?()) = cntx.GetDice("SeriesEdQualSecAllAvgScrWBGA", EdQualSecAllTotTbl)

                If EdQualSecAll_Prior_Yr > 0 Then
                    For Each item In (From s In cntx.GetSlice("SeriesEdQualSecAllAvgScrWBGA", EdQualSecAll_Prior_Yr)
                                      Join m In cntx.GetSlice("SeriesEdQualSecAllAvgScrWBGA", "MostRecent") On s.Key Equals m.Key
                                      Select Key = s.Key, Value = s.Value, MR = m.Value)
