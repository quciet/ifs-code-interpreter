                            'ValHold = getYearAroundOrRecent(EDTerEnrgTotTbl, years, item.Key, item.MR, cntx.BaseYear)
                            ValHold = getYearAroundOrRecent(EDTerEnrgTotTbl, years, item.Key, item.MR, cntx.BaseYear, False)
                            'mti 2025/06/23 end
