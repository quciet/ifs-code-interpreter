            Public Function Root_NR(Coef() As Double, N As Integer, Optional TestRoot As Double = 1, Optional Precision As Double = 0.00001, Optional MIter As Integer = 100) As Double?
                'mti Sept 04, 2009 - new procedure-  take in full
                ' Newton - Raphson Method to find the root of a polynomial
                ' A brief description of the method can be found at http://en.wikipedia.org/wiki/Newton's_method

                ' Coef() is the array of the coefficient of the polynomial equation
                'n is the order of the polynomial
                'Root is the test root to start with
                'MIter is the maximum iterations to try

                ' Polynomial Equation: F(x) = 0, or
                ' Coef(1) + Coef(2) * x ^ 1  + Coef(3) * x ^ 2+...+ Coef(n+1) * x ^ (n) = 0

                Dim ItrCnt%, cnt%

                ItrCnt% = 1

                Dim Fx As Double, dFx As Double, NewRoot As Double

                Do

                    Fx = 0  'function value
                    dFx = 0 'first derivative value
                    For cnt% = 1 To N + 1 ' - 1
                        Fx = Fx + Coef(cnt%) * (TestRoot ^ (cnt% - 1)) 'function at test root
                        dFx = dFx + (cnt% - 1) * Coef(cnt%) * (TestRoot ^ (cnt% - 2)) 'first derivative at test root
                    Next cnt%


                    NewRoot = TestRoot - (Fx / dFx)

                    If Math.Abs(NewRoot - TestRoot) <= Precision Then
                        Root_NR = NewRoot
                        Exit Do
                    End If

                    TestRoot = NewRoot

                    ItrCnt% = ItrCnt% + 1
                    If ItrCnt% = MIter Then
                        Root_NR = 9999
                        Exit Do
                    End If

                Loop

            End Function

