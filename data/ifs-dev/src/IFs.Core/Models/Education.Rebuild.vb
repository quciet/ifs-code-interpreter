                'mti 2018/01/07 start
                'mti 2019/11/01

                'declaration taken to form declaration
                'Dim GDPPCPPPTbl As Recordset

                Dim EdPriEnrGrTbl(7, NGender - 1) As IDictionary(Of String, Single?())
                Dim yrsEdPriEnrGrTbl As Dictionary(Of Integer, Dictionary(Of Integer, Short()))
                yrsEdPriEnrGrTbl = New Dictionary(Of Integer, Dictionary(Of Integer, Short()))
                Dim EdPriDrpGrTbl(7, NGender) As IDictionary(Of String, Single?())
                Dim yrsEdPriDrpGrTbl As Dictionary(Of Integer, Dictionary(Of Integer, Short()))
                yrsEdPriDrpGrTbl = New Dictionary(Of Integer, Dictionary(Of Integer, Short()))

