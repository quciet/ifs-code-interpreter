<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
    <system.webServer>
	    <security>
		    <requestFiltering allowDoubleEscaping="true" />
	    </security>
    </system.webServer>
	
 <!-- jam 2026/05/15 Per-IP concurrency throttle for IFsWeb + memory circuit breaker  -->
  <appSettings>
    <!-- jam 2026/06/21 Avoiding Max connection per IP bug  -->
    <!--<add key="MaxConnectionsPerIP" value="999999" />-->
    <!--<add key="MaxConnectionsPerIP" value="10" />
    <add key="IpAcquireTimeoutMs" value="30000" />
    <add key="IpCleanupIntervalMin" value="60" />
	<add key="MemoryCircuitBreakerPct" value="90" />-->

    <!-- jam 2026/06/22 Per-IP throttle (self-healing version) -->
    <add key="MaxConnectionsPerIP" value="30" />
    <add key="IpAcquireTimeoutMs" value="5000" />
    <add key="IpSlotStaleSeconds" value="60" />
    <add key="IpCleanupIntervalMin" value="60" />

    <add key="MemoryCircuitBreakerPct" value="90" />
    
  </appSettings>


		<system.web>
			<!-- jrs 2026/05/25 -->
			<sessionState timeout="85" />

			<compilation debug="true" strict="false" explicit="true" targetFramework="4.8.1" />
    <!-- default value: &lt;,&gt;,*,%,&amp;,:,\,?-->
	  <!--// jrs 2024/08/10 added maxRequestLength to allow loading ifsDataImport.db files that are bigger than the 4MB default -->
   	<httpRuntime targetFramework="4.8.1" requestPathInvalidCharacters="" maxRequestLength="20480" />
    <globalization culture="en-US" uiCulture="en-US" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
    <controls>
      <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
    </controls></pages>
  </system.web>
  <system.webServer>
	  <!--jam 2026/04/23 changing it to false for Chatbot-->
    <modules runAllManagedModulesForAllRequests="true">
      <add name="NLog" type="NLog.Web.NLogHttpModule, NLog.Web" />
		<!--jam 2026/04/21 For blue color in form Title-->
		<!-- jrs 2026/04/27 add name="PageBarColorModule" type="IFsWeb.PageBarColorModule, IFsWeb"/>-->
	</modules>
    <handlers>
      <add name="RunHttpHandler" verb="*" path="run.ws" type="IFsWeb.RunHttpHandler, IFsWeb" resourceType="Unspecified" />
    </handlers>
  </system.webServer>
