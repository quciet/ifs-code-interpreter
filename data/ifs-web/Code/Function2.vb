        End If

        '   Copy IFSBASE.RUN to working.run
        '   -----------------------------
        If UseSQLite Then
            InFile = PutFdrvRun & Basefile & ".RUN.DB"
            OutFile = PutFdrvRun & "working.run.db"
            'jrs 2006/07/20 FARM
            FarmFileAllocator("BASE", OutFile, SQLite)
            FileCopyCheck(InFile, OutFile)
            WorkingFile = PutFdrvRun & "IFSBASE.RUN.DB"
        Else
            InFile = PutFdrvRun & Basefile & ".RUN"
            OutFile = PutFdrvRun & "working.run"
            'jrs 2006/07/20 FARM
            FarmFileAllocator("BASE", OutFile, SQLite)
            FileCopyCheck(InFile, OutFile)
            WorkingFile = PutFdrvRun & "IFSBASE.RUN"
        End If
        'JRS 10/16/02 SAM COPY
        '   Copy SAMBASE.MDB to SAMWORKING.MDB
        '   -----------------------------
        If UseSQLite Then
            InFile = PutDataFileDir & "SAMBase.db"
            OutFile = PutFdrvRun & "SAMWorking.db"
            'jrs 2006/07/20 FARM
            FarmFileAllocator("SAM", OutFile, SQLite)
            FileCopyCheck(InFile, OutFile)
        Else
            InFile = PutDataFileDir & "SAMBase.mdb"
            OutFile = PutFdrvRun & "SAMWorking.mdb"
            'jrs 2006/07/20 FARM
            FarmFileAllocator("SAM", OutFile, SQLite)
            FileCopyCheck(InFile, OutFile)
        End If
        '   Establish Files Selected
        '   ------------------------
        FilesSelected = 1
        ReDim RunFiles(10)
        If StandAloneMode Or UseSQLite Then
            RunFiles(1) = PutFdrvRun & "IFSBASE.RUN.DB"
        Else
            RunFiles(1) = PutFdrvRun & "IFSBASE.RUN"
        End If

        Exit Sub



InitFileReadError:

        msg = "There is an error in init, probably a missing file."
        'jrs 2005/02/12
        msg = msg & "<br><br><br><b>Error Description:</b> " & Err.Description
        sError = msg
        _logger.Error(Err.GetException, $"LoadSessionFiles - InitFileReadError {msg}")
