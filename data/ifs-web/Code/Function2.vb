    'jrs 2011/07/06
    Private Function bIncludedByOthrFilterScatvars(ByVal sPreprocessor As String, ByVal sYears As String, ByVal vScatVarFiltName As String, ByVal viFilterDataPoints As String, ByVal viFilterYear As String) As Boolean
        Dim bInclude As Boolean, iCountYears As Integer
        Dim xYears As Object, pos As Integer
        Dim yr1 As Integer, yr2 As Integer, i As Integer
        'jrs 2011/07/06
        'Other filters
        bInclude = False
        If vScatVarFiltName = "ALL" Then
            bInclude = True
            'jrs 2023/05/24  added or sPreprocessor = 1 SQlite uses 0 and 1s
        ElseIf (vScatVarFiltName = "Used for Initialization" And (sPreprocessor = "True" Or sPreprocessor = "1")) Then
            bInclude = True
        ElseIf (vScatVarFiltName = "At least " & CStr(viFilterDataPoints) & " Data Points") Then
            'Count years
            xYears = Split(sYears, ",")
            iCountYears = UBound(xYears) + 1
            If iCountYears >= viFilterDataPoints Then
                bInclude = True
            Else
                For i = 0 To UBound(xYears)
                    'JAM 2013-11-20
                    If IsNumeric(xYears(i)) Then
                        pos = InStr(xYears(i), "-")
                    End If
                    If pos > 0 Then
                        'JAM 2013-11-20
                        If IsNumeric(xYears(i)) Then
                            yr1 = CInt(Mid(xYears(i), 1, pos - 1))
                            yr2 = CInt(Mid(xYears(i), pos + 1))
                        End If
                        iCountYears = iCountYears + yr2 - yr1
                        If iCountYears >= viFilterDataPoints Then
                            bInclude = True
                            Exit For
                        End If
                    End If
                Next i
            End If
        ElseIf (vScatVarFiltName = "At least through year " & viFilterYear) Then
            'Find last year
            xYears = Split(sYears, ",")
            i = UBound(xYears)
            If i > -1 Then
                'JAM 2013-11-20
                If IsNumeric(xYears(i)) Then
                    pos = InStr(xYears(i), "-")
                End If
                If pos > 0 Then
                    'JAM 2013-11-20
                    If IsNumeric(xYears(i)) Then
                        yr2 = CInt(Mid(xYears(i), pos + 1))
                    End If
                Else
                    If IsNumeric(xYears(i)) Then
                        yr2 = CInt(xYears(i))
                    End If
                End If
                If yr2 >= viFilterYear Then
                    bInclude = True
                End If
            End If
        End If 'Other Filters

        bIncludedByOthrFilterScatvars = bInclude
    End Function

