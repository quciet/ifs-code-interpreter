            Dim vSQLiteCommand As SQLiteCommand
            vSQLiteCommand = dbInit.CreateCommand()
            vSQLiteCommand.CommandText = "DELETE FROM ProjectDataCountryLoad"
            vSQLiteCommand.ExecuteNonQuery()

            For i = 1 To CountryTot
                vSQLiteCommand.CommandText = "INSERT INTO [ProjectDataCountryLoad] VALUES(""" & CountryList(i) & """)"
                vSQLiteCommand.ExecuteNonQuery()
                msg = msg & "<br/>" & CountryList(i)
            Next i
            dbInit.Close()
            'Screen.MousePointer = vbNormal
