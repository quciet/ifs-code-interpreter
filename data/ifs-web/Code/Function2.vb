    'jrs 2005/04/12
    Public Function FindFile(ByVal sDir As String, ByVal sFile As String, ByVal sType As String) As String
        If Right(sDir, 1) = "\" Then
            sDir = Mid(sDir, 1, Len(sDir) - 1)
        End If

        Dim sRunFile As String
        ' Returns filename with specified extension. If more than one *.ini
        ' file exists, the first file found is returned.
        sRunFile = Dir(sDir + "\*." & sType)

        Do While (sRunFile <> "")
            If UCase(sRunFile) = UCase(sFile) Then
                FindFile = sDir + "\" + sRunFile
                Exit Function
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop
        'Look for all folders within
        Dim counter As Integer
        counter = -1
        Dim DirList() As String

        sRunFile = Dir(sDir + "\*", vbDirectory)

        Do While (sRunFile <> "")
            If Mid(sRunFile, 1, 7) <> "Session" And sRunFile <> "." And sRunFile <> ".." Then
                If (GetAttr(sDir & "\" & sRunFile) And vbDirectory) = vbDirectory Then
                    counter = counter + 1
                    ReDim Preserve DirList(counter)
                    DirList(counter) = sRunFile
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop

        Dim i As Integer
        For i = 0 To counter
            FindFile = FindFile(sDir + "\" + DirList(i), sFile, sType)
            If FindFile > "" Then
                Exit Function
            End If
        Next i
    End Function

