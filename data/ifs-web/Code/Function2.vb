            SyncLock SessionList
                For i = 0 To MaxFullSessions - 1
                    If Not SessionList(i) Then
                        SessionList(i) = True
                        SessionIdx = i
                        Exit For
                    End If
                Next
            End SyncLock
            If SessionIdx >= 0 Then
                LoadSessionFiles(SessionIdx, ResFileSubDir, ScenarioFileSubDir, SensitivityFileSubDir, FdrvRun,
                PutFdrvRun, PutFdrvRun2, valtblInit, IFs_MDB2, IFsHist_MDB2, IFsCoVaTrA_MDB2, ScenarioFileDir,
                SensitivityFileDir, sError, myForm, sMapPathSecure, IFsRunFiles, IFsHistSeries_MDB, IFsCoVaTrASeries_MDB,
                IFsWVSCohort_MDB, IFsStat_MDB, WorkingFile, FilesSelected, RunFiles, Server, HistoricBase, ActiveBase,
                IFs_MDB2Active, SQLite)
            Else
                Dim Message As String
                Message = "Full Session is not available, this action can't be completed."
                Dim frm_msg As New frm_Message
                frm_msg.LoadMessage(Message)
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If
    End Sub


    'jrs 2004/11/23 
    Private Sub LoadSessionFiles(ByVal SessionIdx As Integer, ByRef ResFileSubDir As String,
    ByRef ScenarioFileSubDir As String, ByRef SensitivityFileSubDir As String, ByRef FdrvRun As String, ByRef PutFdrvRun As String,
    ByRef PutFdrvRun2 As String, ByRef valtblInit As Object, ByRef IFs_MDB2 As String, ByRef IFsHist_MDB2 As String,
    ByRef IFsCoVaTrA_MDB2 As String, ByRef ScenarioFileDir As String, ByRef SensitivityFileDir As String, ByRef sError As String,
    ByRef myPage As Page, ByVal sMapPathSecure As String, ByRef IFsRunFiles As Object, ByRef IFsHistSeries_MDB As String,
    ByRef IFsCoVaTrASeries_MDB As String, ByRef IFsWVSCohort_MDB As String, ByRef IFsStat_MDB As String, ByRef WorkingFile As String,
    ByRef FilesSelected As Integer, ByRef RunFiles As Object, ByRef Server As Object, ByRef HistoricBase As Object,
    ByRef ActiveBase As String, ByRef IFs_MDB2Active As String, ByRef SQLite As String)
        'jrs 2011/05/16
        'cdv 2021/03/24 Rewrites so it correctly calls SQLite Files
        Dim UseSQLite As Boolean

        If SQLite = "True" Then
            UseSQLite = True
        Else
            UseSQLite = False
        End If

        If InStr(ResFileSubDir, "Session") > 0 Then
            'Error handler can reset the session Id to 1, but doesn't reset the folders
            'This was producing nested Session folders
            Exit Sub
        End If
        'jrs 2006/10/26 ASP20
        'Dim ifs As New frm_IFS
        'ifs.SessionLoad(SessionIdx)

        Dim directory As String

        Dim msg As String
        'jrs 2007/11/29
        Dim frm_msg As New frm_Message

        '--------------------------------------------------------------

        '   Set basic Default File Names/Locations/Time Horizons
        '   ----------------------------------------------------


        'JRS MULTISESSION 06/02/04 ***
        If SessionIdx <> -1 Then
            ResFileSubDir = ResFileSubDir & "Session"
            ScenarioFileSubDir = ScenarioFileSubDir & "Session"
            SensitivityFileSubDir = SensitivityFileSubDir & "Session"
            If SessionIdx < 10 Then
                ResFileSubDir = ResFileSubDir & "0"
                ScenarioFileSubDir = ScenarioFileSubDir & "0"
                SensitivityFileSubDir = SensitivityFileSubDir & "0"
            End If
            ResFileSubDir = ResFileSubDir & Trim(SessionIdx) & "\"
            ScenarioFileSubDir = ScenarioFileSubDir & Trim(SessionIdx) & "\"
            SensitivityFileSubDir = SensitivityFileSubDir & Trim(SessionIdx) & "\"
        End If
        '*****************************

        '   Check for all Subdirectories on Target Directory
        '   ------------------------------------------------

        On Error GoTo ResDirNotExist 'Make Sure Local Result Subdirectory Exists
        ChDir(PutFdrv & ResFileSubDir)
        On Error GoTo ScenarioDirNotExist 'Make Sure Local Scenario Subdirectory Exists
        ChDir(PutFdrv & ScenarioFileSubDir)
        On Error GoTo SensitivityDirNotExist 'Make Sure Local Sensitivity Subdirectory Exists
        ChDir(PutFdrv & SensitivityFileSubDir)


        '   Establish run files directory paths
        '   -----------------------------------

        FdrvRun = FDRV & ResFileSubDir
        PutFdrvRun = PutFdrv & ResFileSubDir
        PutFdrvRun2 = PutFdrvRun 'Used for file management with dialog box
        If VB.Right(PutFdrvRun2, 1) = "\" Then
            PutFdrvRun2 = VB.Left(PutFdrvRun2, Len(PutFdrvRun2) - 1)
        End If

        Dim DataHistFile As String
        Dim DataFile As String
        Dim NL As String
        '--------------------------------------------------------------

        NL = "<br>" & Chr(10)

        On Error GoTo StartWriteProblem 'Add Extra Line to Date.Dat to Check Write

        '   Data file locations
        '   --------------------
        valtblInit = valtblInit
        DataFile = SeekValue(valtblInit, "DataFile$", "Value")
        DataHistFile = SeekValue(valtblInit, "DataHistFile$", "Value")

        IFs_MDB2 = PutFdrvRun & DataFile
        IFsHist_MDB2 = PutFdrvRun & DataHistFile
        IFsCoVaTrA_MDB2 = PutFdrvRun + SeekValue(valtblInit, "IFsCoVaTrA_MDB2", "Value")

        '   Change to Start Directory
        '   -------------------------

        DefaultDrive = VB.Left(FDRV, 2)
        ChDrive(DefaultDrive)
        directory = FDRV
        If VB.Right(directory, 1) = "\" Then
            directory = VB.Left(directory, Len(directory) - 1)
        End If
        ChDir(directory)

        '   Delete Working Scenario at the load of Model
        '   --------------------------------------------

        'establish scenario directory
        ScenarioFileDir = PutFdrv & ScenarioFileSubDir
        SensitivityFileDir = PutFdrv & SensitivityFileSubDir
        'Delete Working Scenario at the load of Model
        If Dir(ScenarioFileDir & "Working.Sce") <> "" Then
            Kill(ScenarioFileDir & "Working.Sce")
        End If
        'JRS 07/15/03 BEGIN
        If Dir(ScenarioFileDir & "WorkingGroup.Sce") <> "" Then
            Kill(ScenarioFileDir & "WorkingGroup.Sce")
        End If
        'JRS 07/15/03 END
        If Dir(ScenarioFileDir & "Working.Txt") <> "" Then
            Kill(ScenarioFileDir & "Working.Txt")
        End If
        'jrs 2005/02/12
        Dim fNum As Integer
        fNum = FreeFile()

        'write a blank file
        FileOpen(fNum, ScenarioFileDir & "Working.Txt", OpenMode.Output)
        FileClose(fNum)

        Static Basefile As String
        Static InFile As String
        Static OutFile As String
        Static ErrMsg As String
        '--------------------------------------------------------------

        On Error GoTo InitFileReadError

        '   Identify Start Files
        '   --------------------
        Basefile = SeekValue(valtblInit, "Basefile$", "Value")

        '   check if filename.RUN exists
        '   ----------------------------

        'JRS MULTISESSION 06/02/04
        'IF .RUN FILE IS NOT THERE TRY TO COPY FROM RUNFILES
        Dim sRunDir As String
        If InStr(FdrvRun, "Session") > 0 Then
            sRunDir = Mid(FdrvRun, 1, InStr(FdrvRun, "Session") - 1)
        Else
            sRunDir = FdrvRun
        End If
        If UseSQLite Then
            ErrMsg = "The file IFSBASE.RUN.DB must exist on the RUNFILES subdirectory"
            ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
            ErrMsg = ErrMsg & "You may need to re-install IFs."
            Call FileCheck(sRunDir & Basefile & ".run.db", ErrMsg, sError, myPage)
            ErrMsg = ""

            FileCopyCheck(sRunDir & Basefile & ".run.db", FdrvRun & Basefile & ".run.db")
        Else
            ErrMsg = "The file IFSBASE.RUN must exist on the RUNFILES subdirectory"
            ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
            ErrMsg = ErrMsg & "You may need to re-install IFs."
            Call FileCheck(sRunDir & Basefile & ".run", ErrMsg, sError, myPage)
            ErrMsg = ""

            FileCopyCheck(sRunDir & Basefile & ".run", FdrvRun & Basefile & ".run")
        End If
        '   check if filenameHIST.RUN exists
        '   ----------------------------
        If UseSQLite Then
            ErrMsg = "The file IFSBASEHIST.RUN.DB must exist on the RUNFILES subdirectory"
            ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
            ErrMsg = ErrMsg & "You may need to re-install IFs."
            If ModelLoad <> "LoadStudent" And CBool(DevelopmentMode) = False Then 'Not used for students
                Call FileCheck(sRunDir & Basefile & "HIST.run.db", ErrMsg, sError, myPage)
            End If
            ErrMsg = ""
            FileCopyCheck(sRunDir & Basefile & "HIST.run.db", FdrvRun & Basefile & "HIST.run.db")
        Else
            ErrMsg = "The file IFSBASEHIST.RUN must exist on the RUNFILES subdirectory"
            ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
            ErrMsg = ErrMsg & "You may need to re-install IFs."
            If ModelLoad <> "LoadStudent" And CBool(DevelopmentMode) = False Then 'Not used for students
                Call FileCheck(sRunDir & Basefile & "HIST.run", ErrMsg, sError, myPage)
            End If
            ErrMsg = ""
            FileCopyCheck(sRunDir & Basefile & "HIST.run", FdrvRun & Basefile & "HIST.run")
        End If


        '   check if filename.RUN exists
        '   ----------------------------
        If UseSQLite Then
            InFile = PutDataFileDir & "SAMBase.db"
            OutFile = sRunDir & "SAMBase.db"
            FileCopyCheck(InFile, OutFile)

            FileCopyCheck(sRunDir & "SAMBase.db", FdrvRun & "SAMBase.db")
        Else
            InFile = PutDataFileDir & "SAMBase.mdb"
            OutFile = sRunDir & "SAMBase.mdb"
            FileCopyCheck(InFile, OutFile)

            FileCopyCheck(sRunDir & "SAMBase.mdb", FdrvRun & "SAMBase.mdb")
        End If

        'jrs 10/31/04
        ' check if run files for the web exist
        ' ------------------------------------
        Dim sIP As String
        Dim Files As DataTable
        Dim DInf As New DirectoryInfo(sMapPathSecure)
        sIP = DInf.Parent.FullName & "\IFsInit.db"
        'jrs 2005/04/18
        'jrs 2005/06/27
        'If IsNothing(Session("VersionName")) Then
        '    SetDataTablefromAccess(sIP, "SELECT * FROM RunFileLoad as r, IFsInit as i WHERE r.VersionName = i.Value AND i.Variable = 'VersionName' ORDER BY FileName", "", Files)
        'Else
        '    SetDataTablefromAccess(sIP, "SELECT * FROM RunFileLoad as r WHERE r.VersionName = '" & Session("VersionName") & "' ORDER BY FileName", "", Files)
        'End If

        Dim j As Integer
        Dim s As String
        'jrs 2005/06/27
        Dim f As MyFile
        For Each f In IFsRunFiles.colMyFiles
            If f.Visible Then
                If UseSQLite Then
                    s = Mid(f.Name, 1, Len(f.Name) - 7)
                Else
                    'cdv 2021/03/23 If the extension is only .RUN then we need to reduce how much we cut off
                    s = Mid(f.Name, 1, Len(f.Name) - 4)
                End If
                If UseSQLite Then
                    ErrMsg = "The file " & UCase(s) & ".RUN.DB must exist on the RUNFILES subdirectory"
                    ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
                    ErrMsg = ErrMsg & "You may need to re-install IFs."
                    Call FileCheck(sRunDir & s & ".run.db", ErrMsg, sError, myPage)
                    ErrMsg = ""

                    FileCopyCheck(sRunDir & s & ".run.db", FdrvRun & s & ".run.db")

                    ErrMsg = "The file SAM" & UCase(s) & ".DB must exist on the RUNFILES subdirectory"
                    ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
                    ErrMsg = ErrMsg & "You may need to re-install IFs."
                    Call FileCheck(sRunDir & "SAM" & s & ".db", ErrMsg, sError, myPage)
                    ErrMsg = ""

                    FileCopyCheck(sRunDir & "SAM" & s & ".db", FdrvRun & "SAM" & s & ".db")

                    'jrs 2008/06/18
                    'Copy Cohort Files if they exist
                    If Dir(sRunDir & "IFsPop" & s & ".db") > "" Then
                        FileCopyCheck(sRunDir & "IFsPop" & s & ".db", FdrvRun & "IFsPop" & s & ".db")
                    End If
                Else
                    ErrMsg = "The file " & UCase(s) & ".RUN must exist on the RUNFILES subdirectory"
                    ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
                    ErrMsg = ErrMsg & "You may need to re-install IFs."
                    Call FileCheck(sRunDir & s & ".run", ErrMsg, sError, myPage)
                    ErrMsg = ""

                    FileCopyCheck(sRunDir & s & ".run", FdrvRun & s & ".run")

                    ErrMsg = "The file SAM" & UCase(s) & ".MDB must exist on the RUNFILES subdirectory"
                    ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
                    ErrMsg = ErrMsg & "You may need to re-install IFs."
                    Call FileCheck(sRunDir & "SAM" & s & ".mdb", ErrMsg, sError, myPage)
                    ErrMsg = ""

                    FileCopyCheck(sRunDir & "SAM" & s & ".mdb", FdrvRun & "SAM" & s & ".mdb")

                    'jrs 2008/06/18
                    'Copy Cohort Files if they exist
                    If Dir(sRunDir & "IFsPop" & s & ".db") > "" Then
                        FileCopyCheck(sRunDir & "IFsPop" & s & ".mdb", FdrvRun & "IFsPop" & s & ".mdb")
                    End If
                End If
            End If
        Next
        'For j = 0 To Files.Rows.Count - 1
        '    s = Files.Rows(j).Item("FileName")
        '    ErrMsg = "The file " & UCase(s) & ".RUN must exist on the RUNFILES subdirectory"
        '    ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
        '    ErrMsg = ErrMsg & "You may need to re-install IFs."
        '    Call FileCheck(sRunDir & s & ".run", ErrMsg, sError, myPage)
        '    ErrMsg = ""

        '    FileCopyCheck(sRunDir & s & ".run", FdrvRun & s & ".run")

        '    ErrMsg = "The file SAM" & UCase(s) & ".MDB must exist on the RUNFILES subdirectory"
        '    ErrMsg = ErrMsg & " of the directory from which you attempt to run IFS.  "
        '    ErrMsg = ErrMsg & "You may need to re-install IFs."
        '    Call FileCheck(sRunDir & "SAM" & s & ".mdb", ErrMsg, sError, myPage)
        '    ErrMsg = ""

        '    FileCopyCheck(sRunDir & "SAM" & s & ".mdb", FdrvRun & "SAM" & s & ".mdb")

        'Next

        '   Copy TablFunc.MDB, IFs.MDB, IFsVar.MDB, DataDict.MDB, IFsPop.MDB
