    Sub FillRegionMap2(ByRef PLOT As Object, ByRef PYear As Integer, ByRef GeoRegion As Object, ByRef GR1N As Object,
    ByRef GeoValue As Object, ByRef IFs_MDB2Active As String, ByRef MaxValue As Object, ByRef rsMap As DataTable, ByRef MyPage As Page)
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

        'Dim SavePlot(20), SavePlot2(20), RegOrder(20), RegValueMap$(20)
        'Dim SaveOrder(20)
        Dim SavePlot(NR), SavePlot2(NR), RegOrder(NR), regvaluemap(NR)
        Dim SaveOrder(NR)
        Dim SaveVals(250), SaveRegion(250)
        Dim BinVal, PlotVal As Single
        Dim SaveReg As Integer

        Dim regcount As Integer
        Dim RegCount2 As Integer
        '   a. Save specific year of data so that need not search all years repeatedly
        '   --------------------------------------------------------------------------
        For regcount = 1 To NR
            SavePlot(regcount) = PLOT(PYear, regcount)
            SavePlot2(regcount) = SavePlot(regcount)
        Next regcount

        '   b. Determine rank order of regional values and save alphabetically in RegValueMap$
        '   -------------------------------------------------------------------------------

        For regcount = 1 To NR
            MaxValue = -1000000
            For RegCount2 = 1 To NR
                'JRS 10/30/04
                If Not IsDBNull(SavePlot2(RegCount2)) And IsNumeric(SavePlot2(RegCount2)) Then
                    If SavePlot2(RegCount2) > MaxValue Then
                        MaxValue = SavePlot2(RegCount2)
                        SaveReg = RegCount2
                        GeoRegion(regcount) = GR1N(RegCount2)
                        GeoValue(regcount) = SavePlot(RegCount2%)
                    End If
                End If
            Next RegCount2
            RegOrder(SaveReg) = regcount
            SavePlot2(SaveReg) = -1000000
            regvaluemap(SaveReg) = ""
        Next regcount

        For regcount = 1 To NR
            For RegCount2 = 1 To RegOrder(regcount)
                regvaluemap(regcount) = regvaluemap(regcount) + "a"
            Next RegCount2
        Next regcount

        '   c. Identify region into which each country falls; must close this operation
        '       before filling data because both may access same data file and trip over
        '       each other if open simultaneously
        '   ---------------------------------------------------------------------------

        SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " & Regionalization & " ORDER BY Country", "Country", valtbl)
        Dim i As Integer
        Dim scount As Integer
        Dim RegNumb As Integer
        i = 0

        scount = 1
        RegNumb = valtbl.Rows(i).Item("NewRegion")
        SaveVals(scount) = SavePlot(RegNumb)
        SaveRegion(scount) = RegNumb
        Do
            scount = scount + 1
            i += 1
            If i = valtbl.Rows.Count Then Exit Do
            RegNumb = valtbl.Rows(i).Item("NewRegion")
            SaveVals(scount) = SavePlot(RegNumb)
            SaveRegion(scount) = RegNumb
        Loop


        '   d. Transfer data from buffer (SaveVals) to data table "Map"
        '   ----------------------------------------------------------

        'jrs 2004/11/27 SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM Map ORDER BY Country", "Country", valtbl)

        i = 0

        Dim sUpd As String
        Dim connMap As OleDb.OleDbConnection
        Dim CoCount As Integer

        'jrs 2004/11/27 connMap = CreateConnection(IFs_MDB2Active)
        'jrs 2004/11/27 connMap.Open()
        'JRS 10/30/04
        Dim sStoreRank As String
        If regvaluemap(SaveRegion(1)) = "" Then
            sStoreRank = "NULL"
        Else
            sStoreRank = "'" & regvaluemap(SaveRegion(1)) & "'"
        End If
        Dim sStoreData As String
        If IsDBNull(SaveVals(1)) Or Not IsNumeric(SaveVals(1)) Then
            sStoreData = "NULL"
        Else
            sStoreData = CStr(SaveVals(1))
        End If
        'jrs 2004/11/27 sUpd = "UPDATE [Map] SET StoreData = " & sStoreData & ", StoreRank = " & sStoreRank
        'jrs 2004/11/27 sUpd = sUpd & " WHERE [FIPS_Code] = '" & valtbl.Rows(i).Item("FIPS_Code") & "'"
        'jrs 2004/11/27 ExecuteSql(connMap, sUpd)
        'jrs 2004/11/27
        With rsMap
            If scount - 1 <> .Rows.Count Then
                'Error in data
                Dim Message As String
                Message = "Map Table doesn't have all regions, please check Ifs.mdb."
                Dim frm_msg As New frm_Message
                frm_msg.LoadMessage(Message)
                Support.FormManager.StateStore(MyPage)
                Support.FormManager.Show(MyPage, "frm_Message.aspx")
            End If
            'jrs 2006/08/23 it was giving an error when SaveVals(1) = Nothing
            'jrs 2008/05/08 error when SaveVals(1) = ""
            'If SaveVals(1) Is Nothing Then
            '    .Rows(0).Item("StoreData") = DBNull.Value
            'Else
            '    .Rows(0).Item("StoreData") = SaveVals(1)
            'End If
            If Not IsNumeric(SaveVals(1)) Or SaveVals(1) Is Nothing Then
                .Rows(0).Item("StoreData") = DBNull.Value
            Else
                .Rows(0).Item("StoreData") = SaveVals(1)
            End If

        End With

        For CoCount = 2 To scount - 1
            i += 1
            'JRS 10/30/04
            If regvaluemap(SaveRegion(CoCount)) = "" Then
                sStoreRank = "NULL"
            Else
                sStoreRank = "'" & regvaluemap(SaveRegion(CoCount)) & "'"
            End If
            If IsDBNull(SaveVals(CoCount)) Or Not IsNumeric(SaveVals(CoCount)) Then
                sStoreData = "NULL"
            Else
                sStoreData = CStr(SaveVals(CoCount))
            End If
            'jrs 2004/11/27 sUpd = "UPDATE [Map] SET StoreData = " & sStoreData & ", StoreRank = " & sStoreRank
            'jrs 2004/11/27 sUpd = sUpd & " WHERE [FIPS_Code] = '" & valtbl.Rows(i).Item("FIPS_Code") & "'"
            'jrs 2004/11/27 ExecuteSql(connMap, sUpd)
            With rsMap
                'jrs 2006/08/23 it was giving an error when SaveVals(1) = Nothing
                If SaveVals(CoCount) Is Nothing Then
                    .Rows(CoCount - 1).Item("StoreData") = DBNull.Value
                Else
                    .Rows(CoCount - 1).Item("StoreData") = SaveVals(CoCount)
                End If
            End With
        Next CoCount

        'jrs 2004/11/27 connMap.Close()


