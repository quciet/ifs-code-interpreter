        End If




        If SecInType = "O" Then


            For VarCount = 1 To vCCount
                If IsDependent = False Then 'Working on independent
                    'JAM 2008-08-05 Fixing rewriting first Ind. Variable, adding Conditional
                    If indexVar <> 1 Then
