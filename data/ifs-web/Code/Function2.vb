            If MyDF Is Nothing Then
                Continue For
            End If
            _logger.Debug("gLoadForDisplayNET LoadDataFrame end")

            'Not considering if variable has the dimension fixed
            If VarIdx > 0 Then
                If VDim3(VarIdx) > 0 Then
                    DimNum = 3
                ElseIf VDim2(VarIdx) > 0 Then
                    DimNum = 2
                ElseIf VDim1(VarIdx) > 0 Then
                    DimNum = 1
                Else
                    DimNum = 0
