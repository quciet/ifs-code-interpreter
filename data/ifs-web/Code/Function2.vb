                End If
                gLoadForDisplayNET("PPPCONV", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, PPPCONV, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFPPP)

                'jrs 2021/05/05
                If Not (FilesCol Is Nothing) AndAlso Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
                    FilesCol.Add(MyFileforDisplay, "FileForDisplay" + fileIdx.ToString)
                End If
                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPPPCONV" + fileIdx.ToString) AndAlso Not (MyDFPPP Is Nothing) Then
                    dfCol.Add(MyDFPPP, "dfPPPCONV" + fileIdx.ToString)
                End If
                gLoadForDisplayNET("GINIDOM", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, GINIDOM, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFG)

                'jrs 2021/05/05
                If Not (FilesCol Is Nothing) AndAlso Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
                    FilesCol.Add(MyFileforDisplay, "FileForDisplay" + fileIdx.ToString)
                End If
                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfGINIDOM" + fileIdx.ToString) AndAlso Not (MyDFG Is Nothing) Then
                    dfCol.Add(MyDFG, "dfGINIDOM" + fileIdx.ToString)
                End If
                'jrs 2026/01/22
                If FirstYear < FirstYearForecast Then
                    i = FirstYearForecast - FirstYear + 1
                Else
                    i = 1
                End If
                'In dollars, not thousands
                meanconsumption = C(i) / AMAX(0.0001, POP(i)) * PPPCONV(i)


                'Need to compute NSNARAT
                portionpoor = Amin(0.99, INCOMELT1LN(i) / AMAX(0.0001, POP(i)))
                NInv = NormalInverse(portionpoor)
                lnstddev = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)
                LNMean = Log(365 * PovLevels("EXTREME")) - lnstddev * NInv
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = Exp(709)
                Else
                    meanbackcalc = Exp(LNMean + 0.5 * (lnstddev ^ 2))
                End If

                If portionpoor > 0 Then
                    NSNARAT(1) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
                Else
                    NSNARAT(1) = 1
                End If

                'jrs 2021/05/05
                If dfCol Is Nothing OrElse Not dfCol.Contains("dfPOVMIDLOW" + fileIdx.ToString) Then
                    MyDFI = Nothing
                Else
                    MyDFI = dfCol("dfPOVMIDLOW" + fileIdx.ToString)
                End If

                gLoadForDisplayNET("POVMIDLOW", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, INCOMELT2LN, 1,
                            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFI)

                'jrs 2021/05/05
                If Not (FilesCol Is Nothing) AndAlso Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
                    FilesCol.Add(MyFileforDisplay, "FileForDisplay" + fileIdx.ToString)
                End If
                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPOVMIDLOW" + fileIdx.ToString) AndAlso Not (MyDFI Is Nothing) Then
                    dfCol.Add(MyDFI, "dfPOVMIDLOW" + fileIdx.ToString)
                End If
                gLoadForDisplayNET("nsnaratm", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, nsnaratm, 1,
                            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFnn)

                'jrs 2021/05/05
                If Not (FilesCol Is Nothing) AndAlso Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
                    FilesCol.Add(MyFileforDisplay, "FileForDisplay" + fileIdx.ToString)
                End If
                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfnsnaratm" + fileIdx.ToString) AndAlso Not (MyDFnn Is Nothing) Then
                    dfCol.Add(MyDFnn, "dfnsnaratm" + fileIdx.ToString)
                End If

                'gLoadForDisplay("INCOMELT2CS", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, grpIdx = gCountGroupMembers, False, 1, INCOMELT2CS, 1, _
                '1, FirstYear, FirstYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce, _
                'FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)

                'jrs 2014/10/21 changed to LN, because they're identical in year 1
                'portionpoor = Amin(0.99, INCOMELT2CS(i) / AMAX(0.0001, POP(i)))
                portionpoor = Amin(0.99, INCOMELT2LN(i) / AMAX(0.0001, POP(i)))
                'jrs 2008/07/17
                'If portionpoor < 0.001 Then
                '    NSNARAT2 = 1
                'Else
                NInv = NormalInverse(portionpoor)
                'percentage value, put in 0 to 1 scale; do not put in 0 to 100 scale
                lnstddev = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)
                LNMean = Log(365 * PovLevels("MIDLOW")) - lnstddev * NInv
                'jrs 2008/07/17
                If LNMean + 0.5 * (lnstddev ^ 2) > 709 Then
                    meanbackcalc = Exp(709)
                Else
                    meanbackcalc = Exp(LNMean + 0.5 * (lnstddev ^ 2))
                End If
                'jrs 2008/10/21 no adjustment necessary if it's a high income country
                'this was producing unrealistic resutls for countries like the US
                'ex. less than 1% of pop. under $200/day
                If portionpoor > 0 Then
                    NSNARAT2 = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption)
                Else
                    NSNARAT2 = 1
                End If
                'End If
                NSNARATI2 = NSNARAT2
                NSNARAT2 = NSNARATI2 * nsnaratm(i)
                NSNARATFac = NSNARAT(i) 'jrs 2008/07/17
                If level > PovLevels("MIDLOW") Then
                    NSNARATFac = NSNARAT2
                ElseIf level > PovLevels("EXTREME") Then
                    NSNARATFac = NSNARAT(i) + (NSNARAT2 - NSNARAT(i)) * (level - PovLevels("EXTREME")) / (PovLevels("MIDLOW") - PovLevels("EXTREME"))
                End If
                'jrs 2008/07/23 meanconsumption = C(i) / AMAX(0.0001, POP(i)) * PPPCONV(i)
                'jrs 2008/07/23 lnstddev = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)
                'jrs 2008/07/21 
                'LNMean = Log(meanconsumption * NSNARAT(i) * 1000) - 0.5 * (lnstddev ^ 2)

                'incomelt1lnpcnt = LogNormalCDF(365, LNMean, lnstddev)
                'incomelt1lncalc = Amin(0.99 * POP(i), incomelt1lnpcnt * POP(i))
                'incomelt1lnshift = INCOMELT1LN(i) - incomelt1lncalc

                'LNMean = Log(meanconsumption * NSNARAT2 * 1000) - 0.5 * (lnstddev ^ 2)
                'incomelt2lnpcnt = LogNormalCDF(730, LNMean, lnstddev)
                'incomelt2lncalc = Amin(0.99 * POP(i), incomelt2lnpcnt * POP(i))
                'incomelt2lnshift = INCOMELT2LN(i) - incomelt2lncalc

                'jrs 2008/07/21
                'jrs 2008/07/17
                'If level <= 1 Then
                '    AvgShift = incomelt1lnshift
                'ElseIf level < 2 Then
                '    AvgShift = incomelt1lnshift + (incomelt2lnshift - incomelt1lnshift) * (level - 1)
                'Else
                '    AvgShift = incomelt2lnshift
                'End If

                LNMean = Log(meanconsumption * NSNARATFac * 1000) - 0.5 * (lnstddev ^ 2)
                incomelt1lnpcnt = LogNormalCDF(365 * level, LNMean, lnstddev)
                incomelt1lncalc = AMAX(Amin(0.99 * POP(i), incomelt1lnpcnt * POP(i)), 0) 'jrs 2008/07/21 + AvgShift

                'jrs 2007/03/30 change group logic
                If bGrp Then
                    If grpIdx = 1 Then
                        PLOT(i, COUNTE) = 0
                    End If
                    PLOT(i, COUNTE) = PLOT(i, COUNTE) + incomelt1lncalc 'jrs 2008/07/17 + (incomelt1lnshift + incomelt2lnshift) / 2
                Else
                    PLOT(i, COUNTE) = incomelt1lncalc 'jrs 2008/07/17 + (incomelt1lnshift + incomelt2lnshift) / 2
                End If

                smpppconv = PPPCONV(1)

                'jrs 2026/01/22
                If FirstYear < FirstYearForecast Then
                    xx = FirstYearForecast - FirstYear + 2
                Else
                    xx = 2
                End If
                For i = xx To LastYear - FirstYear + 1
                    'jrs 2007/03/30 check if runfile goes to an earlier year
                    If POP(i) = 0 Then Exit For
                    smpppconv = smpppconv * 0.8 + PPPCONV(i) * 0.2
                    lnstddev = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)

                    meanconsumption = AMAX(0.0001, C(i) / AMAX(0.0001, POP(i)) * smpppconv)
                    LNMean = Log(meanconsumption * NSNARATFac * nsnaratm(i) * 1000) - 0.5 * (lnstddev ^ 2)
                    incomelt1lnpcnt = LogNormalCDF(365 * level, LNMean, lnstddev)
                    'jrs 2007/03/30 change group logic
                    If bGrp Then
                        If grpIdx = 1 Then
                            PLOT(i, COUNTE) = 0
                        End If
                        PLOT(i, COUNTE) = PLOT(i, COUNTE) + AMAX(0, Amin(0.99 * POP(i),
                        incomelt1lnpcnt * POP(i))) 'jrs 2008/07/21 + AvgShift
                    Else
                        PLOT(i, COUNTE) = AMAX(0, Amin(0.99 * POP(i), incomelt1lnpcnt * POP(i))) 'jrs 2008/07/21 + AvgShift
                    End If
                Next i

                'jrs 2007/03/30 change group logic
                If bGrp Then
                    grpIdx = grpIdx + 1
                    If grpIdx > gCountGroupMembers Then
                        Exit Do
                    End If
                Else
                    Exit Do
                End If
            Loop

            Dim idxVar As Integer
            idxVar = IfsVars.Item("POVEXTREME").Index
            If level <> PovLevels("EXTREME") Then
                'jrs 2021/05/05 added * 100
                VARN(0, COUNTE) = "INCOMELT" & CStr(level * 100) & "LN"
                VARN(1, COUNTE) = "INCOMELT" & CStr(level * 100) & "LN"
                'jrs 2007/10/19 replace legend
                VARN(2, COUNTE) = Replace(VDef$(idxVar), "$" & PovLevels("EXTREME"), "$" & CStr(level))
            End If

            VARN(3, COUNTE) = VHelpID(idxVar)
            VARN(6, COUNTE) = VHelpIDEqn(idxVar)

            'this is for validation
            If bGrp Then
                VARN(5, COUNTE) = "GROUP"
            Else
                VARN(5, COUNTE) = "REGION"
            End If
            If SensitivityFlag <> True Then
                VARN(0, COUNTE) = VARN(0, COUNTE) & "[" & LTrim$(CStr(vShortSce(fileIdx))) & "]"
                VARN(1, COUNTE) = VARN(1, COUNTE) & "[" & LTrim$(Str$(fileIdx)) & "]"
            End If

            GR1N(COUNTE) = dim1

            If VCurrency(idxVar) Then
                gCurrencyLblSwitch(idxVar, COUNTE, CurrencySym, GR4N)
            Else
                GR4N(COUNTE) = VUnits(idxVar) 'Other Grid Values determined earlier
            End If

            'Flexible Dimension Names for Graphs
            FDNG1(COUNTE) = GR1N(COUNTE)
            FDNG2(COUNTE) = GR2N(COUNTE)
            FDNG3(COUNTE) = GR3N(COUNTE)
            FDNG4(COUNTE) = GR4N(COUNTE)

            'jrs 2007/08/20
            If COUNTE > 1 Then
                FinYear(COUNTE) = FinYear(1)
            End If
        End If


        If bPctPop Then
            'jrs 2014/11/24 This loads POP for levels that have not been loaded yet
            'added condition to load for 2011 Dollars
            'jrs 2007/03/30 change in group logic
            If bGrp And Not PovLevels.ContainsValue(level) Then
                'jrs 2021/05/05
                If FilesCol Is Nothing OrElse Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) Then
                    MyFileforDisplay = Nothing
                Else
                    MyFileforDisplay = FilesCol("FileForDisplay" + fileIdx.ToString)
                End If
                If dfCol Is Nothing OrElse Not dfCol.Contains("dfPOP" + fileIdx.ToString) Then
                    MyDF = Nothing
                Else
                    MyDF = dfCol("dfPOP" + fileIdx.ToString)
                End If

                gLoadForDisplayNET("POP", -1, dim1, -1, "", -1, "", -1, "", fileIdx, False, False, True, 1, POP, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF)

                'jrs 2021/05/05
                If Not (FilesCol Is Nothing) AndAlso Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
                    FilesCol.Add(MyFileforDisplay, "FileForDisplay" + fileIdx.ToString)
                End If
                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPOP" + fileIdx.ToString) AndAlso Not (MyDF Is Nothing) Then
                    dfCol.Add(MyDF, "dfPOP" + fileIdx.ToString)
                End If
            End If

            'jrs 2026/01/22
            For i = xx - 1 To LastYear - FirstYear + 1
                If POP(i) = 0 Then Exit For
                PLOT(i, COUNTE) = PLOT(i, COUNTE) / POP(i) * 100
            Next i
            'jrs 2007/10/24 move % to before the "[", instead of at the end of the name
            'problems when saving for flex displays
            VARN(0, COUNTE) = Replace(VARN(0, COUNTE), "LN[", "LN%[")
            VARN(1, COUNTE) = Replace(VARN(1, COUNTE), "LN[", "LN%[")
            VARN(2, COUNTE) = VARN(2, COUNTE) & " Percent of Population"
            GR4N(COUNTE) = "Percent"
        End If
    End Sub

    'jrs 2021/05/06 added SQLlite flag, and optional parameters dfCol and FilesCol
    'jrs 2014/10/21 added b2005PPP As Boolean
    'JRS 2008/07/17
    'jrs 2007/05/06
    'jrs 2025/10/03 not using 2005PPP flag anymore, always using current PPP Year.
    Public Sub gFindPovertyLevel(ByVal dim1 As String, ByVal fileIdx As Integer, ByVal bGrp As Boolean, ByVal PctPop As Single, ByVal b2005PPP As Boolean,
    ByRef PLOT As Object, ByRef COUNTE As Object, ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object,
    ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object,
    ByVal FirstYear As Integer, ByVal LastYear As Integer, ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef RunFiles As Object,
    ByRef PutFdrvRun As String, ByRef vShortSce As Object, ByRef FileforDisplay As Integer, ByRef FinYear As Object,
    ByVal IFs_MDB2Active As String, ByVal CurrencyVal As Single, ByRef CurrencySym As String, ByRef SQLite As String,
    Optional ByRef dfCol As Collection = Nothing,
    Optional ByRef FilesCol As Collection = Nothing)

        'jrs 2021/05/05
        Dim MyFileforDisplay As IStorage = Nothing
        Dim MyDF As IDataframe = Nothing
        'jrs 2026/01/22
        Dim xx As Integer

        Dim UseSQLite As Boolean

        If SQLite = "True" Then
            UseSQLite = True
        Else
            UseSQLite = False
        End If

        'jrs 2010/08/13 updating to use $1.25/day as extreme poverty line
        'Find level
        Dim level As Single
        Dim i As Integer
        Dim POP(0, 0) As Single
        Dim C() As Single, PPPCONV() As Single, NSNARAT(0, 0) As Single,
        GINIDOM() As Single, nsnaratm(0, 0) As Single, INCOMELT2CS() As Single
        ReDim C(LastYear - FirstYear + 1), PPPCONV(LastYear - FirstYear + 1)
        ReDim GINIDOM(LastYear - FirstYear + 1),
        INCOMELT2CS(1)

        Dim LNMean As Single, meanconsumption(0, 0) As Single, lnstddev(0, 0) As Single
        Dim NSNARATFac As Single
        Dim NSNARAT2() As Single, portionpoor As Single, smpppconv As Single
        Dim NInv As Single, meanbackcalc As Single, NSNARATI2 As Single
        'jrs 2008/07/17
        'jrs 2008/07/21 Dim AvgShift As Single

        'jrs 2007/03/30 changing group logic, to compute regions individually and then add them up
        Dim sDim1 As String, grpIdx As Integer, POPtot() As Single
        ReDim POPtot(LastYear - FirstYear + 1)
        Dim levels(0, 0) As Single
        Dim Maxs() As Integer
        ReDim Maxs(LastYear - FirstYear + 1)
        Dim Mins() As Integer
        ReDim Mins(LastYear - FirstYear + 1)
        Dim gCountGroupMembers As Integer
        Dim gGroupMembrs() As String, gGroupMembersPtrs() As Integer, gGroupMemberWeights() As Single
        Dim INCOMELT1LN() As Single

        If bGrp Then
            gLoadGroupMembers(dim1, POPidx, 1, 1, gCountGroupMembers, IFs_MDB2Active, gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
            ReDim levels(LastYear - FirstYear + 1, gCountGroupMembers)
        Else
            gCountGroupMembers = 1
        End If
        ReDim INCOMELT1LN(1)

        grpIdx = 1

        'jrs 2008/07/20
        ReDim NSNARAT(LastYear - FirstYear + 1, gCountGroupMembers)
        ReDim NSNARAT2(gCountGroupMembers)
        ReDim nsnaratm(LastYear - FirstYear + 1, gCountGroupMembers)
        ReDim meanconsumption(LastYear - FirstYear + 1, gCountGroupMembers)
        ReDim lnstddev(LastYear - FirstYear + 1, gCountGroupMembers)
        ReDim POP(LastYear - FirstYear + 1, gCountGroupMembers)

        Dim MyDFC, MyDFP, MyDFPPP, MyDFG, MyDFN, MyDFI, MyDFnn As IDataframe

        'jrs 2021/05/05
        If FilesCol Is Nothing OrElse Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) Then
            MyFileforDisplay = Nothing
        Else
            MyFileforDisplay = FilesCol("FileForDisplay" + fileIdx.ToString)
        End If
        If dfCol Is Nothing OrElse Not dfCol.Contains("dfC" + fileIdx.ToString) Then
            MyDFC = Nothing
        Else
            MyDFC = dfCol("dfC" + fileIdx.ToString)
        End If
        If dfCol Is Nothing OrElse Not dfCol.Contains("dfPOP" + fileIdx.ToString) Then
            MyDFP = Nothing
        Else
            MyDFP = dfCol("dfPOP" + fileIdx.ToString)
        End If
        If dfCol Is Nothing OrElse Not dfCol.Contains("dfPPPCONV" + fileIdx.ToString) Then
            MyDFPPP = Nothing
        Else
            MyDFPPP = dfCol("dfPPPCONV" + fileIdx.ToString)
        End If
        If dfCol Is Nothing OrElse Not dfCol.Contains("dfGINIDOM" + fileIdx.ToString) Then
            MyDFG = Nothing
        Else
            MyDFG = dfCol("dfGINIDOM" + fileIdx.ToString)
        End If
        If dfCol Is Nothing OrElse Not dfCol.Contains("dfNSNARAT" + fileIdx.ToString) Then
            MyDFN = Nothing
        Else
            MyDFN = dfCol("dfNSNARAT" + fileIdx.ToString)
        End If
        If dfCol Is Nothing OrElse Not dfCol.Contains("dfnsnaratm" + fileIdx.ToString) Then
            MyDFnn = Nothing
        Else
            MyDFnn = dfCol("dfnsnaratm" + fileIdx.ToString)
        End If

        Do While True
            If bGrp Then
                sDim1 = gGroupMembrs(grpIdx)
            Else
                sDim1 = dim1
            End If
            If UseSQLite = True Then
                gLoadForDisplayNET("C", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, grpIdx = 1, False, False, 1, C, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFC)

                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfC" + fileIdx.ToString) AndAlso Not (MyDFC Is Nothing) Then
                    dfCol.Add(MyDFC, "dfC" + fileIdx.ToString)
                End If

                gLoadForDisplayNET("POP", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, POP, grpIdx,
                1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFP)

                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPOP" + fileIdx.ToString) AndAlso Not (MyDFP Is Nothing) Then
                    dfCol.Add(MyDFP, "dfPOP" + fileIdx.ToString)
                End If

                gLoadForDisplayNET("PPPCONV", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, PPPCONV, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFPPP)

                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPPPCONV" + fileIdx.ToString) AndAlso Not (MyDFPPP Is Nothing) Then
                    dfCol.Add(MyDFPPP, "dfPPPCONV" + fileIdx.ToString)
                End If

                gLoadForDisplayNET("GINIDOM", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, GINIDOM, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFG)

                If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfGINIDOM" + fileIdx.ToString) AndAlso Not (MyDFG Is Nothing) Then
                    dfCol.Add(MyDFG, "dfGINIDOM" + fileIdx.ToString)
                End If
            Else

                gLoadForDisplay("C", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, grpIdx = 1, False, False, 1, C, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)

                gLoadForDisplay("POP", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, POP, grpIdx,
                1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)

                gLoadForDisplay("PPPCONV", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, PPPCONV, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)

                gLoadForDisplay("GINIDOM", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, GINIDOM, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If
            'jrs 2021/05/05
            If dfCol Is Nothing OrElse Not dfCol.Contains("dfPOVEXTREME" + fileIdx.ToString) Then
                MyDF = Nothing
            Else
                MyDF = dfCol("dfPOVEXTREME" + fileIdx.ToString)
            End If

            gLoadForDisplayNET("POVEXTREME", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, INCOMELT1LN, 1,
                        1, FirstYear, FirstYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                        FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF)

            If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPOVEXTREME" + fileIdx.ToString) AndAlso Not (MyDF Is Nothing) Then
                dfCol.Add(MyDF, "dfPOVEXTREME" + fileIdx.ToString)
            End If

            'jrs 2026/01/22
            If FirstYear < FirstYearForecast Then
                xx = FirstYearForecast - FirstYear + 1
            Else
                xx = 1
            End If
            i = xx

            meanconsumption(i, grpIdx) = C(i) / AMAX(0.0001, POP(i, grpIdx)) * PPPCONV(i)

            'jrs 2015/11/19
            'Need to compute NSNARAT
            portionpoor = Amin(0.99, INCOMELT1LN(i) / AMAX(0.0001, POP(i, grpIdx)))
            NInv = NormalInverse(portionpoor)
            lnstddev(i, grpIdx) = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)
            LNMean = Log(365 * PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME")) - lnstddev(i, grpIdx) * NInv
            If LNMean + 0.5 * (lnstddev(i, grpIdx) ^ 2) > 709 Then
                meanbackcalc = Exp(709)
            Else
                meanbackcalc = Exp(LNMean + 0.5 * (lnstddev(i, grpIdx) ^ 2))
            End If

            If portionpoor > 0 Then
                'jrs 2016/05/02
                For i = xx To LastYear - FirstYear + 1
                    NSNARAT(i, grpIdx) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption(1, grpIdx))
                Next
            Else
                'jrs 2016/05/02
                For i = xx To LastYear - FirstYear + 1
                    NSNARAT(i, grpIdx) = 1
                Next
            End If
            'jrs 2016/05/02
            i = xx

            'jrs 2021/05/05
            If dfCol Is Nothing OrElse Not dfCol.Contains("dfPOVMIDLOW" + fileIdx.ToString) Then
                MyDFI = Nothing
            Else
                MyDFI = dfCol("dfPOVMIDLOW" + fileIdx.ToString)
            End If

            gLoadForDisplayNET("POVMIDLOW", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, INCOMELT2CS, 1,
                        1, FirstYear, FirstYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                        FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFI)

            If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfPOVMIDLOW" + fileIdx.ToString) AndAlso Not (MyDFI Is Nothing) Then
                dfCol.Add(MyDFI, "dfPOVMIDLOW" + fileIdx.ToString)
            End If


            gLoadForDisplayNET("nsnaratm", -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, grpIdx = gCountGroupMembers, False, 1, nsnaratm, grpIdx,
                1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFnn)

            If Not (dfCol Is Nothing) AndAlso Not dfCol.Contains("dfnsnaratm" + fileIdx.ToString) AndAlso Not (MyDFnn Is Nothing) Then
                dfCol.Add(MyDFnn, "dfnsnaratm" + fileIdx.ToString)
            End If


            portionpoor = Amin(0.99, INCOMELT2CS(i) / AMAX(0.0001, POP(i, grpIdx)))
            lnstddev(i, grpIdx) = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)

            'jrs 2008/07/17
            'If portionpoor < 0.001 Then
            '    NSNARAT2 = 1
            'Else
            NInv = NormalInverse(portionpoor)
            LNMean = Log(365 * PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW")) - lnstddev(i, grpIdx) * NInv

            'jrs 2008/07/17
            If LNMean + 0.5 * (lnstddev(i, grpIdx) ^ 2) > 709 Then
                meanbackcalc = Exp(709)
            Else
                meanbackcalc = Exp(LNMean + 0.5 * (lnstddev(i, grpIdx) ^ 2))
            End If
            'jrs 2008/10/21 no adjustment necessary if it's a high income country
            'this was producing unrealistic resutls for countries like the US
            'ex. $1,250/day for the 50th percentile
            If portionpoor > 0 Then 'In dollars, not thousands
                NSNARAT2(grpIdx) = (meanbackcalc / 1000) / AMAX(0.0001, meanconsumption(i, grpIdx))
            Else
                NSNARAT2(grpIdx) = 1
            End If
            'End If
            NSNARATI2 = NSNARAT2(grpIdx)
            NSNARAT2(grpIdx) = NSNARATI2 * nsnaratm(i, grpIdx)
            NSNARATFac = NSNARAT2(grpIdx)

            LNMean = Log(meanconsumption(i, grpIdx) * NSNARATFac * 1000) - 0.5 * (lnstddev(i, grpIdx) ^ 2)
            level = Round(LogNormalInverse(AMAX(0, Amin(0.99, PctPop / 100)), LNMean, lnstddev(i, grpIdx)) / 365, 2)

            If level <= PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW") Then
                'jrs 2008/07/14
                If POP(i, grpIdx) * PctPop / 100 < INCOMELT1LN(i) Then
                    If level >= PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME") Then
                        level = 0.95 * PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME")
                    End If
                Else
                    If level < PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME") Then
                        level = (PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME") + PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW")) / 2
                    End If
                End If

                'jrs 2008/03/06 interpolation for NSNARATFac only works between 1 and 2, else use NSNARAT
                If level > PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME") Then
                    'jrs 2008/07/14
                    level = gFindPovertyLevelBetweenLimits(level, PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME"),
                    PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW"), PctPop, NSNARAT(i, grpIdx),
                    NSNARAT2(grpIdx), meanconsumption(i, grpIdx), lnstddev(i, grpIdx), False) 'jrs 2016/05/02 True) 'jrs 2008/07/21 , AvgShift

                    'jrs 2016/05/02 NSNARATFac = NSNARAT(i, grpIdx) + (NSNARAT2(grpIdx) - NSNARAT(i, grpIdx)) * (level - 0.7) / (1.45 - 0.7)
                    NSNARATFac = NSNARAT(i, grpIdx) + (NSNARAT2(grpIdx) - NSNARAT(i, grpIdx)) * (level - 1.9) / (3.1 - 1.9)
                Else
                    NSNARATFac = NSNARAT(i, grpIdx)
                End If
                LNMean = Log(meanconsumption(i, grpIdx) * NSNARATFac * 1000) - 0.5 * (lnstddev(i, grpIdx) ^ 2)
                'jrs 2008/07/21 level = Round(LogNormalInverse(AMAX(Amin(PctPop / 100 - AvgShift, 0.99), 0), LNMean, lnstddev(i, grpIdx)) / 365, 2)

                'mti Oct 01, 2009
                level = Round(LogNormalInverse(AMAX(Amin(PctPop / 100, 0.99), 0), LNMean, lnstddev(i, grpIdx)) / 365, 2)
                'level = Round(LogNormalInverse(AMAX(Amin(PctPop / 100, 0.99), 0), LNMean, lnstddev(i, grpIdx)) / 365, 2)
            End If


            'jrs 2007/03/30
            If bGrp Then
                levels(i, grpIdx) = level
                If Maxs(i) = 0 Or levels(i, Maxs(i)) < level Then
                    Maxs(i) = grpIdx
                End If
                If Mins(i) = 0 Or levels(i, Mins(i)) > level Then
                    Mins(i) = grpIdx
                End If
                POPtot(i) = POPtot(i) + POP(i, grpIdx)
            Else
                PLOT(i, COUNTE) = level
            End If

            smpppconv = PPPCONV(1)

            For i = xx + 1 To LastYear - FirstYear + 1
                'jrs 2007/03/30 in case runfiles run for less years
                If POP(i, grpIdx) = 0 Then Exit For
                smpppconv = smpppconv * 0.8 + PPPCONV(i) * 0.2
                lnstddev(i, grpIdx) = Sqrt(2) * NormalInverse((GINIDOM(i) + 1) / 2)

                meanconsumption(i, grpIdx) = AMAX(0.0001, C(i) / AMAX(0.0001, POP(i, grpIdx)) * smpppconv)
                LNMean = Log(meanconsumption(i, grpIdx) * NSNARATFac * nsnaratm(i, grpIdx) * 1000) - 0.5 * (lnstddev(i, grpIdx) ^ 2)
                level = Round(LogNormalInverse(AMAX(0, Amin(0.99, PctPop / 100)), LNMean, lnstddev(i, grpIdx)) / 365, 2)

                If bGrp Then
                    levels(i, grpIdx) = level
                    If Maxs(i) = 0 Or levels(i, Maxs(i)) < level Then
                        Maxs(i) = grpIdx
                    End If
                    If Mins(i) = 0 Or levels(i, Mins(i)) > level Then
                        Mins(i) = grpIdx
                    End If
                    POPtot(i) = POPtot(i) + POP(i, grpIdx)
                Else
                    PLOT(i, COUNTE) = level
                End If

            Next i

            'jrs 2007/03/30 change group logic
            If bGrp Then
                grpIdx = grpIdx + 1
                If grpIdx > gCountGroupMembers Then
                    Exit Do
                End If
            Else
                Exit Do
            End If
        Loop

        'jrs 2021/05/06
        If Not (FilesCol Is Nothing) AndAlso Not FilesCol.Contains("FileForDisplay" + fileIdx.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
            FilesCol.Add(MyFileforDisplay, "FileForDisplay" + fileIdx.ToString)
        End If

        'jrs 2007/04/20
        If bGrp Then
            'Search for the level for each year
            For i = xx To LastYear - FirstYear + 1
                'JRS 2007/03/30 IN CASE RUNFILES RUN FOR LESS YEARS
                If POP(i, 1) = 0 Then Exit For
                PLOT(i, COUNTE) = gSearchPovertyLevel(levels(i, Mins(i)), levels(i, Maxs(i)), i, PctPop, gCountGroupMembers, POPtot,
                NSNARAT, NSNARAT2, nsnaratm, meanconsumption, lnstddev, POP, b2005PPP) 'jrs 2008/07/21 , incomelt1lnshift, incomelt2lnshift
            Next i
        End If

        VARN(0, COUNTE) = "INCOMELT" & CStr(PctPop) & "%LN" & "[" & LTrim$(CStr(vShortSce(fileIdx))) & "]"
        VARN(1, COUNTE) = "INCOMELT" & CStr(PctPop) & "%LN" & "[" & LTrim$(Str$(fileIdx)) & "]"
        VARN(2, COUNTE) = "INCOMELT" & CStr(PctPop) & "%LN"

        If bGrp Then
            VARN(2, COUNTE) = VARN(2, COUNTE) & ", using population weighted average for groups."
        End If
        GR1N(COUNTE) = dim1
        GR4N(COUNTE) = "$ per day"
        If CurrencySym > "" And CurrencySym <> "$" Then
            GR4N(COUNTE) = Replace(GR4N(COUNTE), CurrencySym, "$")
        End If
        FDNG1(COUNTE) = GR1N(COUNTE)
        FDNG4(COUNTE) = GR4N(COUNTE)
        'jrs 2007/03/30 FinYear(COUNTE) = LastYear - FirstYear + 1
        If bGrp = True Then
            VARN(5, COUNTE) = "GROUP"
        Else
            VARN(5, COUNTE) = "REGION"
        End If

    End Sub

    'jrs 2014/10/21
    'added parameter b2005PPP
    'jrs 2011/06/17
    'added parameter bIncRange and level2
    'jrs 2008/01/31 implemented on the web until now
    'jrs 2007/10/19
    Public Sub checkPovertyVarName(ByVal sVar As String, ByRef bPoverty As Boolean, ByRef bPctPop As Boolean, ByRef bFind As Boolean, ByRef level As Single,
    ByRef bIncRange As Boolean, ByRef level2 As Single, ByRef b2005PPP As Boolean)
        Dim iPos As Integer, iPos2 As Integer, iPos3 As Integer
        'jrs 2011/06/17
        Dim iPos4 As Integer
        'jrs 2014/10/21
        Dim iPos5 As Integer

        'jrs 2007/02/19
        iPos = InStr(sVar, "INCOMELT")
        iPos2 = InStr(sVar, "LN")
        iPos3 = InStr(sVar, "%")
        'jrs 2011/06/17
        iPos4 = InStr(sVar, "GT")
        'jrs 2014/10/21
        iPos5 = InStr(sVar, "2005")

        bPoverty = False
        bPctPop = False
        bFind = False
        'jrs 2011/06/17
        bIncRange = False
        'jrs 2014/10/21
        b2005PPP = False

        'jrs 2014/10/21
        If iPos5 > iPos2 Then
            b2005PPP = True
        End If

        If iPos > 0 And iPos2 > 0 Then
            bFind = (iPos3 > 0 And iPos3 < iPos2)
            If bFind Then
                level = Val(Mid(sVar, 9, iPos2 - 10))
            Else
                'jrs 2011/06/17
                If iPos4 > 0 Then
                    level2 = Val(Mid(sVar, 9, iPos4 - 9))
                    'jrs 2021/05/05
                    level2 = level2 / 100

                    level = Val(Mid(sVar, iPos4 + 2, iPos2 - 11 - Len(CStr(level))))
                    bIncRange = True
                    If InStr(sVar, "%") > 0 Then
                        bPctPop = True
                    End If
                Else
                    level = Val(Mid(sVar, 9, iPos2 - 9))
                    'jrs 2016/10/12 changed from 1 and 2 to 190 and 310 added level 110, and added $2005 branch
                    'jrs 2025/10/03 using new poverty names for standard poverty lines
                    'If level <> 110 And level <> 190 And level <> 310 Then
                    bPoverty = True
                    'End If

                    If InStr(sVar, "%") > 0 Then
                        bPctPop = True
                    End If
                End If
            End If
            'jrs 2021/05/05
            level = level / 100
        End If

    End Sub

