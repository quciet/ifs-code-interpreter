    Private Function BuildSceDescVLine(ByVal CustStr As String, ByRef LastYear As Object, ByRef FirstYear As Object) As String
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        Dim Value As String, mult As Double, FVAL As Single

        Dim ThisYear%, RTime%, LCount%
        LCount = 0
        Dim LastValue As Single
        Dim LastChange As String
        Dim xxYears As Integer
        Dim nvalue As Single

        RTime = LastYear - FirstYear + 1
        ThisYear% = 1
        xxYears = 0
        While Len(CustStr) > 0  'Keep going as long as non-zero line
            Value$ = CustStr
            If InStr(CustStr, ",") > 0 Then 'If commas in line
                Value$ = Mid$(CustStr, 1, InStr(CustStr, ",") - 1)
                CustStr = Mid$(CustStr, InStr(CustStr, ",") + 1)
            End If

            If InStr(Value$, ":") <> 0 Then  'Any repeats in current string?
                mult = Val(Mid$(Value$, InStr(Value$, ":") + 1))
                LCount = LCount + mult
                If LCount > RTime Then
                    LCount = RTime
                End If
                nvalue = Val(Value$)
                If ThisYear = 1 Then
                    BuildSceDescVLine = " The initial condition was set at " & Value & "."
                End If
                BuildSceDescVLine = BuildSceDescVLine & " Values remain constant at " & Value & " over " & Str(LCount - ThisYear + 1) & " years."
                ThisYear% = LCount
            ElseIf InStr(Value$, "@") <> 0 Then 'Any interpolations?
                mult = Val(Mid$(Value$, InStr(Value$, "@") + 1))
                LCount = LCount + mult
                Value$ = Left(Value$, InStr(Value$, "@") - 1)
                nvalue = Val(Value$)
                If LCount > RTime Then
                    LCount = RTime
                End If
                If ThisYear = 1 Then
                    BuildSceDescVLine = " The initial condition was set at " & Value & "."
                End If
                If nvalue > FVAL Then
                    BuildSceDescVLine = BuildSceDescVLine & " Values increase to " & nvalue & " over " & Str(LCount - ThisYear + 1) & " years."
                ElseIf nvalue < FVAL Then
                    BuildSceDescVLine = BuildSceDescVLine & " Values decrease to " & nvalue & " over " & Str(LCount - ThisYear + 1) & " years."
                Else
                    BuildSceDescVLine = BuildSceDescVLine & " Values remain constant at " & nvalue & " over " & Str(LCount - ThisYear + 1) & " years."
                End If
                ThisYear = LCount

            Else   'Then must only be single value
                LCount = LCount + 1
                nvalue = Val(Value$)
                If ThisYear% <= RTime Then
                    If ThisYear = 1 Then
                        BuildSceDescVLine = " The initial condition was set at " & Value & "."
                    ElseIf ThisYear = 2 Then
                        If nvalue = LastValue Then
                            LastChange = "="
                        ElseIf nvalue > LastValue Then
                            LastChange = "+"
                        ElseIf nvalue < LastValue Then
                            LastChange = "-"
                        End If
                    Else
                        If nvalue = LastValue And (LastChange <> "=" Or ThisYear = RTime) Then
                            Select Case LastChange
                                Case "+"
                                    BuildSceDescVLine = BuildSceDescVLine & " Values increase to " & LastValue & " over " & Str(xxYears) & " years."
                                Case "-"
                                    BuildSceDescVLine = BuildSceDescVLine & " Values decrease to " & LastValue & " over " & Str(xxYears) & " years."
                                Case "="
                                    BuildSceDescVLine = BuildSceDescVLine & " Values remain constant at " & nvalue & " over " & Str(xxYears) & " years."
                            End Select
                            LastChange = "="
                            xxYears = 0
                        ElseIf nvalue > LastValue And (LastChange <> "+" Or ThisYear = RTime) Then
                            Select Case LastChange
                                Case "+"
                                    BuildSceDescVLine = BuildSceDescVLine & " Values increase to " & nvalue & " over " & Str(xxYears) & " years."
                                Case "-"
                                    BuildSceDescVLine = BuildSceDescVLine & " Values decrease to " & LastValue & " over " & Str(xxYears) & " years."
                                Case "="
                                    BuildSceDescVLine = BuildSceDescVLine & " Values remain constant at " & LastValue & " over " & Str(xxYears) & " years."
                            End Select
                            LastChange = "+"
                            xxYears = 0
                        ElseIf nvalue < LastValue And (LastChange <> "-" Or ThisYear = RTime) Then
                            Select Case LastChange
                                Case "+"
                                    BuildSceDescVLine = BuildSceDescVLine & " Values increase to " & LastValue & " over " & Str(xxYears) & " years."
                                Case "-"
                                    BuildSceDescVLine = BuildSceDescVLine & " Values decrease to " & nvalue & " over " & Str(xxYears) & " years."
                                Case "="
                                    BuildSceDescVLine = BuildSceDescVLine & " Values remain constant at " & LastValue & " over " & Str(xxYears) & " years."
                            End Select
                            LastChange = "-"
                            xxYears = 0
                        End If
                    End If
                    LastValue = nvalue
                    ThisYear% = ThisYear% + 1
                    xxYears = xxYears + 1
                End If
            End If

            FVAL = nvalue
            If LCount >= RTime Then  'Have we counted up to year yet?
                CustStr = ""
            End If
        End While
    End Function


    Private Function BuildSceDescBase(ByVal sVar As String, ByVal sDim1 As String, ByVal sDim2 As String, ByVal sDim3 As String,
    ByRef COUNTE As Object, ByRef PLOT As Object, ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object,
    ByRef GR3N As Object, ByRef GR4N As Object, ByRef FdrvRun As Object, ByRef PutFdrvRun As Object,
    ByRef RunFiles As Object, ByRef IFs_MDB2Active As Object, ByRef FirstYear As Object, ByRef LastYear As Object,
    ByRef LastYearForecast As Object, ByRef FinYear As Object, ByRef PercentOn As Object, ByRef FDNG1 As Object,
    ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object, ByRef ShortSce As Object, ByRef ActiveBase As Object,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef vShortSce As Object, ByRef FileforDisplay As Integer,
    ByVal currencyVal As Single, ByRef CurrencySym As String, ByRef SensitivityFlag As Object, ByRef FinYearHis As Object,
    ByRef YAxisLabel As String, ByRef XAxisLabel As String, ByRef StaYearHis As Object, ByRef sUsrDefCats As Object) As String
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        Dim Value As String, FVAL As Single

        ClearPlot(COUNTE, PLOT, VARN, GR1N, GR2N, GR3N, GR4N, FirstYear, LastYear, LastYearForecast, FDNG1, FDNG2, FDNG3, FDNG4, FinYear, FinYearHis, False, YAxisLabel, XAxisLabel, StaYearHis, sUsrDefCats)

        COUNTE = COUNTE + 1
        Dim idx As Integer = -1
        Dim bGrp As Object = Nothing
        gLoadForDisplayNET(sVar, idx, sDim1, -1, sDim2, -1, sDim3, -1, "", 1, True, True, bGrp,
        1, PLOT, COUNTE, 1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, myForm,
        RunFiles, PutFdrvRun, vShortSce, FinYear, IFs_MDB2Active,
        currencyVal)
        'gLoadForDisplay(sVar, idx, sDim1, -1, sDim2, -1, sDim3, -1, "", 1, True, True, bGrp,
        '1, PLOT, COUNTE, 1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, myForm,
        'RunFiles, PutFdrvRun, vShortSce, FileforDisplay, FinYear, IFs_MDB2Active,
        'currencyVal)
        gLoadForDisplaySaveLbls(COUNTE, idx, sDim1, sDim2, sDim3, bGrp, 1, "",
        SensitivityFlag, ShortSce, CurrencySym, VARN, GR1N, GR2N, GR3N, GR4N,
        FDNG1, FDNG2, FDNG3, FDNG4)

        Dim ThisYear%, RTime%, LCount%
        LCount = 0
        Dim LastValue As Single
        Dim LastChange As String
        Dim xxYears As Integer
        Dim nvalue As Single

        RTime = LastYear - FirstYear + 1
        'jrs 2011/05/16
        If RTime > FinYear(COUNTE) Then
            RTime = FinYear(COUNTE)
        End If

        ThisYear% = 1
        xxYears = 0
        While ThisYear <= RTime
            Value$ = Str(PLOT(ThisYear, 1))

            LCount = LCount + 1
            nvalue = Val(Value$)

            If ThisYear = 1 Then
                BuildSceDescBase = " Contrast this with the base case where the initial condition was set at " & Value & "."
            ElseIf ThisYear = 2 Then
                If nvalue = LastValue Then
                    LastChange = "="
                ElseIf nvalue > LastValue Then
                    LastChange = "+"
                ElseIf nvalue < LastValue Then
                    LastChange = "-"
                End If
            Else
                If nvalue = LastValue And (LastChange <> "=" Or ThisYear = RTime) Then
                    Select Case LastChange
                        Case "+"
                            BuildSceDescBase = BuildSceDescBase & " Values increase to " & LastValue & " over " & Str(xxYears) & " years."
                        Case "-"
                            BuildSceDescBase = BuildSceDescBase & " Values decrease to " & LastValue & " over " & Str(xxYears) & " years."
                        Case "="
                            BuildSceDescBase = BuildSceDescBase & " Values remain constant at " & nvalue & " over " & Str(xxYears) & " years."
                    End Select
                    LastChange = "="
                    xxYears = 0
                ElseIf nvalue > LastValue And (LastChange <> "+" Or ThisYear = RTime) Then
                    Select Case LastChange
                        Case "+"
                            BuildSceDescBase = BuildSceDescBase & " Values increase to " & nvalue & " over " & Str(xxYears) & " years."
                        Case "-"
                            BuildSceDescBase = BuildSceDescBase & " Values decrease to " & LastValue & " over " & Str(xxYears) & " years."
                        Case "="
                            BuildSceDescBase = BuildSceDescBase & " Values remain constant at " & LastValue & " over " & Str(xxYears) & " years."
                    End Select
                    LastChange = "+"
                    xxYears = 0
                ElseIf nvalue < LastValue And (LastChange <> "-" Or ThisYear = RTime) Then
                    Select Case LastChange
                        Case "+"
                            BuildSceDescBase = BuildSceDescBase & " Values increase to " & LastValue & " over " & Str(xxYears) & " years."
                        Case "-"
                            BuildSceDescBase = BuildSceDescBase & " Values decrease to " & nvalue & " over " & Str(xxYears) & " years."
                        Case "="
                            BuildSceDescBase = BuildSceDescBase & " Values remain constant at " & LastValue & " over " & Str(xxYears) & " years."
                    End Select
                    LastChange = "-"
                    xxYears = 0
                End If
            End If
            LastValue = nvalue
            ThisYear% = ThisYear% + 1
            xxYears = xxYears + 1


            FVAL = nvalue
        End While
    End Function

