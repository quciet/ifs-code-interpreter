    'When Resetting Working.run (Creating a new session, loading History, loading Forecast, etc) 
    'first check if there's a file available in the FARM directory, if there is one
    'instead of copying ifsbase*.run into working*.run, just move that file into working.run

    'jrs 2006/07/20
    'Eficiency procedure to take files from a folder (no need to copy, just move)
    Public Sub FarmFileAllocator(ByVal sType As String, ByVal TargetFile As String, ByRef SQLite As String)
        '1. sType is the type of File we want to allocate, options are BASE, HIST, SAM, Pop, PopHist
        Dim UseSQLite As Boolean
        If SQLite = "True" Then
            UseSQLite = True
        Else
            UseSQLite = False
        End If
        Dim sFileName As String = "", sFileExt As String = ""
        'jrs 2008/06/18
        Dim sFilePreFx As String = ""

        Dim fs
        Dim BASE
        Dim currRun
        Dim OrgFolder As String
        Dim sRunFile As String
        OrgFolder = PutFdrv & "RUNFILES\FARM\"
        fs = CreateObject("Scripting.FileSystemObject")
        If UseSQLite Then
            Select Case sType
                Case "BASE"
                    sFileName = "IFsBase"
                    sFileExt = ".run.db"
                Case "HIST"
                    sFileName = "IFsBaseHIST"
                    sFileExt = ".run.db"
                Case "SAM"
                    sFileName = "SAMBase"
                    sFileExt = ".db"
                    sFilePreFx = "SAM"
                Case "POP" 'jrs 2008/06/16
                    sFileName = "IFsPop"
                    sFileExt = ".db"
                    sFilePreFx = "IFsPop"
                Case "POPHIST"
                    sFileName = "IFsPopHist"
                    sFileExt = ".db"
                    sFilePreFx = "IFsPop"
            End Select
        Else
            Select Case sType
                Case "BASE"
                    sFileName = "IFsBase"
                    sFileExt = ".run"
                Case "HIST"
                    sFileName = "IFsBaseHIST"
                    sFileExt = ".run"
                Case "SAM"
                    sFileName = "SAMBase"
                    sFileExt = ".mdb"
                    sFilePreFx = "SAM"
                Case "POP" 'jrs 2008/06/16
                    sFileName = "IFsPop"
                    sFileExt = ".mdb"
                    sFilePreFx = "IFsPop"
                Case "POPHIST"
                    sFileName = "IFsPopHist"
                    sFileExt = ".mdb"
                    sFilePreFx = "IFsPop"
            End Select
        End If
        BASE = fs.GetFile(PutFdrv & "RUNFILES\" & sFileName & sFileExt)
        sFileName = "" 'jrs 2006/07/31 if the farm is empty this should go empty too

        SyncLock FarmList

            ' Returns filename with specified extension. If more than one 
            ' file exists, the first file found is returned.
            sRunFile = Dir(OrgFolder & sFilePreFx & "*" & sFileExt)

            Do While (sRunFile <> "")
                currRun = fs.GetFile(OrgFolder & sRunFile)
                'jrs 2020/05/07 If BASE.size = currRun.size Then
                sFileName = sRunFile
                Exit Do
                'End If
                ' Call Dir again without arguments to return the next *.INI file in the
                ' same directory.
                sRunFile = Dir()
            Loop

            'If we found a File available continue
            If sFileName > "" Then
                FarmList = sFileName
                'Move it
                FileMoveCheck(OrgFolder & sFileName, TargetFile)
            End If

        End SyncLock

    End Sub

    'jrs 2006/07/20
    Public Sub FileMoveCheck(ByRef InFile As String, ByRef OutFile As String)
        Dim FDT2 As Object
        Dim FDT1 As Object
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        On Error GoTo move
        FDT1 = FileDateTime(OutFile)
        FDT2 = FileDateTime(InFile)

        If FDT1 = FDT2 Then
            Kill(InFile) 'jrs 2008/06/11 Move is supposed to end with nothing in the InFile location
            Exit Sub
        Else
            Kill(OutFile)
        End If

move:
        'jrs 2023/07/12 this is problematic when trying to move working.run and it's still in use
        On Error Resume Next

        File.Move(InFile, OutFile)
    End Sub

