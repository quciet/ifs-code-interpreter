                        'jrs 2012/12/05 Next DimIdx 'jrs 2006/01/12
                    Next Location
                    idx = idx + 1
                Else 'jrs 2017/03/28 if it's another list, exit rs loop and go to next VarList
                    Exit Do
                End If
            Loop
        Next Pack
    End Sub

    'jrs 2024/11/25
    Private Sub LoadColumn(ByVal cc As Short, ByVal Rpoints As Short, ByRef Frec As Short, ByRef bTotal As Boolean,
                           DisYear As Integer, PLOT As Object, VARN As Object, GR1N As Object, GR2N As Object, GR3N As Object,
                           GR4N As Object, Context As HttpContext)
        Dim Value As Object

        Dim rr As Short, rrPLOT As Integer, rrOflw As Integer
        'jrs 2025/07/03 Dim ValtoShow As New VB6.FixedLengthString(15)
        Dim ValtoShow As String

        For rr = 0 To Rpoints
            If rr > 6 And cc > 0 Then
                'jrs 2006/07/12
                rrPLOT = (rr - 7) + 1
                If rrPLOT > DisYear Then
                    rrOflw = rrPLOT - DisYear
                    rrPLOT = DisYear
                End If

                'jrs 2025/07/03 added Or IsNothing(PLOT(rrPLOT, cc))
                If IsDBNull(PLOT(rrPLOT, cc)) Or IsNothing(PLOT(rrPLOT, cc)) Then
                    Value = ""
                Else
                    Value = PLOT(rrPLOT, cc)
                End If

                If IsNumeric(Value) Then
                    'jrs 2025/07/03 ValtoShow.Value = ValueScale(Value, False, False)
                    ValtoShow = ValueScale(Value, False, False)
                Else
                    'jrs 2025/07/03 ValtoShow.Value = RSet(VB6.Format("", "############"), Len(ValtoShow.Value))
                    ValtoShow = Value.ToString.PadRight(15).Substring(0, 15)
                End If

                If rr < Rpoints Then
                    'jrs 2012/01/27 Print(fNum, ValtoShow.Value & ",")
                    'jrs 2025/07/03 Context.Response.Write(ValtoShow.Value & ",")
                    Context.Response.Write(ValtoShow & ",")
                Else
                    'jrs 2012/01/27 PrintLine(fNum, ValtoShow.Value)
                    'jrs 2025/05/07 Context.Response.Write(ValtoShow.Value)
                    Context.Response.Write(ValtoShow)
                    Context.Response.Write(Environment.NewLine)
                End If
            Else
                If rr = 1 And bTotal Then
                    'jrs 2012/01/27 Print(fNum, "Total ")
                    Context.Response.Write("Total ")
                End If
                Select Case rr
                    Case 1
                        Context.Response.Write(Replace(VARN(1, cc), ",", ";") & ",")
                    Case 2
                        Dim pos As Integer, pos2 As Integer
                        pos = InStr(VARN(0, cc), "[")
                        pos2 = InStr(VARN(0, cc), "]")
                        Context.Response.Write(Replace(VARN(0, cc).substring(pos, pos2 - pos - 1), ",", ";") & ",")
                    Case 3
                        Context.Response.Write(Replace(GR1N(cc), ",", ";") & ",")
                    Case 4
                        Context.Response.Write(Replace(GR2N(cc), ",", ";") & ",")
                    Case 5
                        Context.Response.Write(Replace(GR3N(cc), ",", ";") & ",")
                    Case 6
                        Context.Response.Write(Replace(GR4N(cc), ",", ";") & ",")
                End Select
            End If
            If Frec > 1 And rr > 6 And rr < Rpoints Then
                rr = rr + Frec - 1
                If rr >= Rpoints Then
                    rr = Rpoints - 1
                End If
            End If
        Next rr
    End Sub

