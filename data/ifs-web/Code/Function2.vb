    'jrs 2011/02/10
    'Assuming Groups are sorted alphabetically we can improve the search
    Public Function gGetGroupIdxBinarySearch(ByVal sGroup As String, ByVal iFirst As Integer, ByVal iLast As Integer) As Integer
        Dim midPt As Integer
        midPt = CInt((iFirst + iLast) / 2)
        'jrs 2023/01/06 replacing UCASE with .ToUpper, UCASE("America") > UCASE("Amer-North") returns false
        'trying with .ToUpper but same problem, and the worst part is that in the immediate window returns true
        'started using string.compare, which returns false both in the run of the code and immediate window
        'then added a replace to deal with this particular case of "-"
        If iFirst > iLast Then
            gGetGroupIdxBinarySearch = -1
        ElseIf iFirst = iLast Then
            If sGroup.ToUpper = GroupNames$(iFirst).ToUpper Then
                gGetGroupIdxBinarySearch = iFirst
            Else
                gGetGroupIdxBinarySearch = -1
            End If
        ElseIf sGroup.ToUpper = GroupNames$(midPt).ToUpper Then
            gGetGroupIdxBinarySearch = midPt

        ElseIf String.Compare(sGroup.ToUpper.Replace("-", "_"), GroupNames$(midPt).ToUpper.Replace("-", "_")) > 0 Then 'sGroup.ToUpper > GroupNames$(midPt).ToUpper Then
            gGetGroupIdxBinarySearch = gGetGroupIdxBinarySearch(sGroup, midPt + 1, iLast)
        Else
            gGetGroupIdxBinarySearch = gGetGroupIdxBinarySearch(sGroup, iFirst, midPt - 1)
        End If
    End Function

