        db.Close()
    End Sub

    Public Sub FeedCurrentlyRunningModel()

        Dim db As SqliteConnection
        Dim sIP = Replace(PutDataFileDir, "\DATA\", "\IFsInit.db")
        db = New SqliteConnection("DataSource=" & sIP)
        db.Open()
        Dim rs As SqliteDataReader
        Dim dbCmdrs As SqliteCommand
        dbCmdrs = db.CreateCommand
        dbCmdrs.CommandText = "SELECT * FROM IFsInit WHERE [Variable] = 'CurrentlyRunningWith'"
        rs = dbCmdrs.ExecuteReader
        While rs.Read
            ModelRunningWith = rs("Value").ToString
        End While
        rs.Close()
        db.Close()

    End Sub

