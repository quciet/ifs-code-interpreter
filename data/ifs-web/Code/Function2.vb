    'jrs 2014/04/16
    Public Sub CleanStartPLOTWallAvHis(COUNTE As Integer, StaYearHis As Object, PLOT As Object, FinYear As Object)
        _logger.Debug("CleanStartPLOTWallAvHis - " + COUNTE.ToString + " - " + StaYearHis(1).ToString + " - " + FinYear(1).ToString)
        'This procedure is useful when All Available History is On, or it was on to load variables
        'When loading formulas it is possible that nulls are loaded at the begining of the plot (before 1960)
        'This nulls will be problematic and are unseful in Tables and Graphs, so we want to remove them here
        Dim i As Integer, j As Integer, MinYearIdx As Integer
        MinYearIdx = 5000
        'Check every variable to find the earliest year with data
        For i = 1 To COUNTE
            For j = 1 To FirstYearHistory - StaYearHis(i)
                If IsNumeric(PLOT(j, i)) Then
                    'First valid data
                    If j < MinYearIdx Then
                        MinYearIdx = j
                    End If
                    Exit For
                End If
            Next j
            If j = FirstYearHistory - StaYearHis(i) + 1 And j < MinYearIdx Then
                MinYearIdx = j
            End If
            If MinYearIdx = 1 Then
                Exit For
            End If
        Next i
        'if valid year is found the remove all blanks before that year
        If MinYearIdx < 5000 And MinYearIdx > 1 Then
            For i = 1 To COUNTE
                For j = MinYearIdx To FinYear(i)
                    PLOT(j - MinYearIdx + 1, i) = PLOT(j, i)
                Next j
                FinYear(i) = FinYear(i) - MinYearIdx + 1
                StaYearHis(i) = StaYearHis(i) + MinYearIdx - 1
            Next i
        End If
    End Sub

    'jrs 2017/12/07
    Public Sub CleanStartPLOTWCompareForecast(COUNTE As Integer, StaYearHis As Object, PLOT As Object, FinYear As Object)
        '_logger.Debug("CleanStartPLOTWCompareForecast - " + COUNTE + " - " + StaYearHis + " - " + FinYear) 'dsb 2025/10/24
        _logger.Debug("CleanStartPLOTWCompareForecast - " + COUNTE.ToString() + " - " + "StaYearHis " + String.Join(", ", StaYearHis) + " - " + "FinYear " + String.Join(", ", FinYear)) 'dsb 2025/10/24 String to double
        'This procedure is useful when doing comparison with exogenous forecast 
        'When loading formulas it is possible that nulls are loaded at the begining of the plot (before 1960)
        'This nulls will be problematic and are unuseful in Tables and Graphs, so we want to remove them here
        Dim i As Integer, j As Integer, MinYearIdx As Integer
        MinYearIdx = 5000
        Dim MinCountIdx As Integer
        'Check every variable to find the earliest year with data
        For i = 1 To COUNTE
            For j = 1 To FirstYearForecast - StaYearHis(i)
                If IsNumeric(PLOT(j, i)) Then
                    'First valid data
                    If j < MinYearIdx Then
                        MinYearIdx = j
                        MinCountIdx = i
                    End If
                    Exit For
                End If
            Next j
        Next i
        'if valid year is found the remove all blanks before that year
        If MinYearIdx < 5000 Then
            For i = 1 To COUNTE
                For j = MinYearIdx To FinYear(i) + MinYearIdx
                    PLOT(j - MinYearIdx + 1, i) = PLOT(j, i)
                Next j
                'FinYear(i) = FinYear(i) - MinYearIdx + 1
                StaYearHis(i) = StaYearHis(MinCountIdx)
            Next i
        Else
            'There's no data before FirstYearForecast
            For i = 1 To COUNTE
                MinYearIdx = FirstYearForecast - StaYearHis(i) + 1
                For j = MinYearIdx To FinYear(i) + MinYearIdx
                    PLOT(j - MinYearIdx + 1, i) = PLOT(j, i)
                Next j
                If MinYearIdx > 0 Then
                    FinYear(i) = FinYear(i) - MinYearIdx + 1
                End If
                StaYearHis(i) = 0
            Next i
        End If
    End Sub

