    Public Sub LoadProjectFile(sFileName As String, IFs_MDB2Active As String)

        'Screen.MousePointer = vbHourglass
        FileCopy(sFileName, DataFileDir & "ifsHistSeriesAugment.db")
        'Open Augment file to find countries to use
        '-------------------------------------------
        'Dim db As Database
        'Set db = OpenDatabase(DataFileDir & "ifsHistSeriesAugment.mdb")
        Dim tds As DataTable
        SetDataTablefromSQLite(DataFileDir & "ifsHistSeriesAugment.db", "SELECT name as TABLE_NAME FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%'", "", tds)

        Dim CountryTot As Integer, CountryList() As String
