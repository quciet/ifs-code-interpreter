    'jrs 2014/09/25
    Private Sub aggregateWVADD(ByRef VarVal As Object, ByRef SumWeight As Object, ByVal SectorId As Integer, ByVal VarPointer As Long,
    ByVal yr As Integer, ByVal fNum As Integer, ByVal bGroup As Boolean, ByVal idxVar As Integer, ByRef SVarVals() As Object,
    ByVal gCountGroupMembers As Integer, ByRef gGroupMemberWeights() As Single)
        'Load VADD for the given Sector
        Dim Varval2 As Single, VarPointer2 As Object, tmpVarVal As Single
        Dim RECORD As Object, Number As Single
        If bGroup Then
            Dim rr As Integer
            Varval2 = 0
            For rr = 1 To gCountGroupMembers
                VarPointer2 = VarPointer + ((SectorId - 1) * (MAXCOM(1) - 1)) + gGroupMemberWeights(rr)
                RECORD = (VarPointer2 + ((yr - 1) * filen)) * 4 - 3
                FileGet(fNum, Number, RECORD)
                Varval2 = Varval2 + Number
            Next rr
        Else
            VarPointer2 = VarPointer + ((SectorId - 1) * (MAXCOM(1) - 1))  'final pointer shift calculation
            RECORD = (VarPointer2 + ((yr - 1) * filen)) * 4 - 3
            FileGet(fNum, Number, RECORD)
            Varval2 = Number!
        End If
        SumWeight = SumWeight + Varval2
        If V(idxVar) = "TEFF" Then
            If yr = 1 Then
                If SectorId = 1 Then
                    ReDim SVarVals(NSec)
                End If
                SVarVals(SectorId) = VarVal
                VarVal = VarVal * Varval2
            Else
                tmpVarVal = VarVal
                If SVarVals(SectorId) <> 0 Then
                    VarVal = (VarVal / SVarVals(SectorId) - 1) * Varval2
                Else
                    VarVal = VarVal * Varval2
                End If
                SVarVals(SectorId) = tmpVarVal
            End If
        Else
            VarVal = VarVal * Varval2
        End If
    End Sub

    'jrs 2019/07/05
    Private Sub aggregateWVADDNET(ByRef VarVal As Object, ByRef SumWeight As Object, ByVal SectorId As Integer, ByVal VarPointer As Long,
    ByVal yr As Integer, ByVal dfVADD As Dataframe, ByVal bGroup As Boolean, ByVal idxVar As Integer, ByRef SVarVals() As Object,
    ByVal gCountGroupMembers As Integer, ByRef gGroupMemberWeights() As Single, ByVal FirstYear As Integer)
        'Load VADD for the given Sector
        Dim Varval2 As Single ', VarPointer2 As Object,
        Dim tmpVarVal As Single
        'Dim RECORD As Object
        Dim Number As Single
        If bGroup Then
            Dim rr As Integer
            Varval2 = 0
            For rr = 1 To gCountGroupMembers
                Number = dfVADD(yr - 1 + FirstYear, gGroupMemberWeights(rr) + 1, SectorId)
                Varval2 = Varval2 + Number
            Next rr
        Else
            Number = dfVADD(yr - 1 + FirstYear, VarPointer, SectorId)
            Varval2 = Number!
        End If
        SumWeight = SumWeight + Varval2
        If V(idxVar) = "TEFF" Then
            If yr = 1 Then
                If SectorId = 1 Then
                    ReDim SVarVals(NSec)
                End If
                SVarVals(SectorId) = VarVal
                VarVal = VarVal * Varval2
            Else
                tmpVarVal = VarVal
                If SVarVals(SectorId) <> 0 Then
                    VarVal = (VarVal / SVarVals(SectorId) - 1) * Varval2
                Else
                    VarVal = VarVal * Varval2
                End If
                SVarVals(SectorId) = tmpVarVal
            End If
        Else
            VarVal = VarVal * Varval2
        End If
    End Sub

    'jrs 2014/04/01
    'When AllHistorical Data is used, and different years are found in the first year of history
    'Need to match them so that all start in the same year
    Public Sub ReArrangeDataAll(iAbsolutePosition As Integer, ByVal diff As Integer, ByVal totYears As Integer, ByRef data As Object)
        'iAbsolutePosition is the last element in the formula to be moved
        'diff is the number of years that all elements need to be moved
        If iAbsolutePosition = -1 Then
            Exit Sub 'iAbsolutePosition = grdVars.row
        End If

        Dim i As Integer, j As Integer
        For i = 1 To iAbsolutePosition
            For j = totYears To 1 Step -1
                data(i)(j + diff) = data(i)(j)
                data(i)(j) = DBNull.Value
            Next j
        Next i
    End Sub

    'jrs 2010/08/26
    'Reloads the Data for all variables in the formula from Yr1 to Yr2, used when doing All available history
    'To restore values above BaseYear - 1 that might have been nulled out
    Public Sub ReLoadDataAll(ByRef NewData As Object, ByVal yr1 As Integer, ByVal yr2 As Integer, ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef f As Formula, ByRef data As Object)
        'jrs 2017/06/30
        If Not (f Is Nothing) Then
            If Not (f.disVar Is Nothing) Then 'jrs 2014/04/24
                Dim i As Integer, j As Integer, k As Integer 'jrs 2014/05/05
                If bCompAll Then
                    For i = 1 To f.disVar.disSize
                        For j = yr1 To yr2
                            For k = f.begAll To f.endAll
                                dataAll(i)(j, k) = NewData(i - 1, j)
                            Next k
                        Next j
                    Next i
                Else
                    For i = 1 To f.disVar.disSize
                        For j = yr1 To yr2
                            data(i)(j) = NewData(i - 1, j)
                        Next j
                    Next i
                End If
            End If
        End If
    End Sub

    'jrs 2014/04/04
    'Save forecast in case formula returns null for History plus forecast using all available history
    'jrs 2014/05/05 added parameter bSingleDim and ColIdx
    Public Sub SaveForecastPlot(ByVal iRowPosition As Integer, ByVal iFirstYearH As Integer, ByRef TargetV As Object, ByVal bSingleDim As Boolean, ByVal ColIdx As Integer,
                                ByVal LastYear As Integer, ByRef PLOTCompF As Object, ByVal row As Integer)
        Dim i As Integer
        If bSingleDim Then
            For i = iRowPosition To LastYear - iFirstYearH + 1
                PLOTCompF(row - 1, i) = TargetV(i)
            Next i
        Else 'jrs 2014/05/05
            For i = iRowPosition To LastYear - iFirstYearH + 1
                PLOTCompF(row - 1, i) = TargetV(i, ColIdx)
            Next i
        End If
    End Sub

