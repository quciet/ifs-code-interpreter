    Private Function checkIfYearExists(sVarName As String, sYear As String) As Boolean
        Dim dbH As SqliteConnection
        dbH = New SqliteConnection("DataSource=" & PutFdrv$ + "RUNFILES\ifsHistSeries.db")
        dbH.Open()

