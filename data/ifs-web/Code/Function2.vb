    Function FileCheck(ByRef Filename As Object, ByRef ErrMsg As String, ByRef _Error As String, ByRef currPage As System.Web.UI.Page) As Short
        Dim msg As String
        Dim SuggestMsg As String
        Dim NL As String
        Dim FDT As Object
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

        '   Turn on error trapping
        '   ----------------------
        On Error GoTo AnnounceError
        'UPGRADE_WARNING: Couldn't resolve default property of object Filename. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'UPGRADE_WARNING: Couldn't resolve default property of object FDT. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        FDT = FileDateTime(Filename)
        Exit Function 'If file exists]

AnnounceError:
        '   Define constants for specific errors
        '   vbExclamation, vbOK, vbCancel, vbCritical, and vbOKCancel are
        '       constants defined in the VBA type library
        '   -------------------------------------------------------------
        'jrs 2007/11/29
        Dim frm_msg As New frm_Message

        _logger.Error(Err.GetException, "FileCheck - exception")

        Const ErrDiskNotReady As Short = 71
        Const ErrDeviceUnavailable As Short = 68
        Const FileNotFound As Short = 53
        NL = "<br>" & Chr(10)
        SuggestMsg = "Additional Information/Possible Corrective Action: " & NL & ErrMsg
        If (Err.Number = ErrDiskNotReady) Then
            msg = "Put a floppy disk in the drive and close the drive door." & NL
            msg = msg & SuggestMsg
            '  Message box with ! plus OK and Cancel buttons
            'CONVERSION_TODO: The equivalent of Method 'MsgBox()' may have a different behavior in Webforms.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1004.html'.
            'jrs 2005/11/04
            'WinFormsToWeb_Messagebox.Show(msg, vbOKCancel)
            'If MsgBoxResult.OK Then
            '    Resume
            'Else
            '    Resume Next
            'End If
        ElseIf (Err.Number = ErrDeviceUnavailable) Then
            'UPGRADE_WARNING: Couldn't resolve default property of object Filename. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            msg = "This drive or path does not exist: " & Filename & NL
            msg = msg & SuggestMsg
            _Error = msg
            ' Transfer back to this page.
            'jrs 2007/11/29
            'Support.FormManager.Show(currPage, "ErrorHandler.aspx")
            frm_msg.LoadMessage(msg)
            If Not (currPage Is Nothing) Then
                Support.FormManager.StateStore(currPage)
            End If
            Support.FormManager.Show(currPage, "frm_Message.aspx")

        ElseIf (Err.Number = FileNotFound) Then
            'UPGRADE_WARNING: Couldn't resolve default property of object Filename. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            msg = "This file does not exist: " & Filename & NL
            msg = msg & SuggestMsg & Err.GetException.ToString
            _Error = msg
            ' Transfer back to this page.

            'jrs 2007/11/29
            'Support.FormManager.Show(currPage, "ErrorHandler.aspx")
            frm_msg.LoadMessage(msg)
            If Not (currPage Is Nothing) Then
                Support.FormManager.StateStore(currPage)
            End If

            Support.FormManager.Show(currPage, "frm_Message.aspx")

        Else
            msg = "Critical Error #" & Str(Err.Number) & " occurred: "
            msg = msg & NL & SuggestMsg
            _Error = msg
            ' Transfer back to this page.
            'jrs 2007/11/29
            'Support.FormManager.Show(currPage, "ErrorHandler.aspx")
            frm_msg.LoadMessage(msg)
            If Not (currPage Is Nothing) Then
                Support.FormManager.StateStore(currPage)
            End If
            Dim page As Page = TryCast(HttpContext.Current.Handler, Page)
            Support.FormManager.Show(currPage, "frm_Message.aspx")



        End If
        Resume

    End Function

