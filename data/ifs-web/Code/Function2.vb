    Public Function DimLstToURL(ByRef lstDim As ListBox, ByVal idx As Integer) As String
        Dim i As Integer, sDim As String = "", iFst As Integer, iLst As Integer
        For i = 0 To lstDim.Items.Count - 1
            If lstDim.Items(i).Selected Then
                'spell out G-Lists and Groups
                If i > lstDim.Items.Count - GCount - GListCount - 2 And i < lstDim.Items.Count - 1 Then
                    If sDim = "" Then
                        sDim = """" & lstDim.Items(i).Text & """"
                    Else
                        sDim = sDim & ",""" & lstDim.Items(i).Text & """"
                    End If
                Else 'use numbers, save some space using ranges
                    If sDim = "" Then
                        sDim = Trim(CStr(i))
                        iLst = i
                        iFst = i
                    Else
                        If i = iLst + 1 Then
                            If i = iFst + 1 Then
                                sDim = sDim & "-" & Trim(CStr(i))
                            Else
                                sDim = Replace(sDim, "-" & Trim(CStr(iLst)), "-" & Trim(CStr(i)))
                            End If
                            iLst = i
                        Else
                            sDim = sDim & "," & Trim(CStr(i))
                            iFst = i
                        End If
                    End If
                End If
            End If
        Next
        'don't save empty space
        If sDim <> Trim(CStr(lstDim.Items.Count - 1)) Then
            DimLstToURL = "&Dim" & Trim(CStr(idx)) & "=" & PrepareForURL(sDim)
        End If
    End Function

    Public Function FileLstToURL(ByRef lstFiles As ListBox, Optional ByVal sOrdFiles As String = "") As String
        Dim i As Integer, sFile As String = "", iFst As Integer, iLst As Integer

        'jrs 2011/11/04
        'Create Collection based on Order passed or listBox
        Dim SceOrdFiles As New Collection
        Dim sceFile As Object
        If Trim(sOrdFiles) > "" Then
            Dim Fs As Object
            Fs = Split(sOrdFiles, ",")
            For i = 0 To UBound(Fs)
                SceOrdFiles.Add(CInt(Fs(i)), Fs(i).ToString)
            Next
        Else
            For i = 0 To lstFiles.Items.Count - 1
                If lstFiles.Items(i).Selected Then
                    SceOrdFiles.Add(i, i.ToString)
                End If
            Next
        End If

        'jrs 2011/11/08 For i = 0 To lstFiles.Items.Count - 1
        For Each sceFile In SceOrdFiles
            i = CInt(sceFile)
            If lstFiles.Items(i).Selected Then

                'spell out G-Lists and Groups
                'jrs 2022/02/14 If i > 5 Then now there's only 3 scenarios so changing to > 4
                If i > 4 Then
                    If sFile = "" Then
                        sFile = """" & Replace(lstFiles.Items(i).Text, i.ToString & " - ", "") & """"
                    Else
                        sFile = sFile & ",""" & Replace(lstFiles.Items(i).Text, i.ToString & " - ", "") & """"
                    End If
                Else 'use numbers, save some space using ranges
                    If sFile = "" Then
                        sFile = Trim(CStr(i))
                        iLst = i
                        iFst = i
                    Else
                        'jrs 2014/01/02 If i = iLst + 1 Then
                        If i = iLst + 1 And IsNumeric(sFile) Then
                            If i = iFst + 1 Then
                                sFile = sFile & "-" & Trim(CStr(i))
                            Else
                                sFile = Replace(sFile, "-" & Trim(CStr(iLst)), "-" & Trim(CStr(i)))
                            End If
                            iLst = i
                        Else
                            sFile = sFile & "," & Trim(CStr(i))
                            iFst = i
                        End If
                    End If
                End If
            End If
        Next
        FileLstToURL = "&File=" & sFile
    End Function

    'jrs 2011/04/12
    Public Sub URLToDimLst(ByVal sURL As String, ByRef lstDim As ListBox, Optional ByVal bUseCtryAndGroup As Boolean = False)
        Dim bAlpha As Boolean
        bAlpha = (InStr(sURL, """") > 0)

        Dim x As Object
        Dim i As Integer, pos As Integer, j As Integer, iFst As Integer, iLst As Integer
        'jrs 2014/01/22
        If Not bAlpha Then
            x = Split(sURL, ",")
            For i = 0 To UBound(x)
                'jrs 2016/09/30 202-207 was being read as alpha
                If Not IsNumeric(Replace(x(i), "-", "")) Then
                    bAlpha = True
                    Exit For
                End If
            Next
        End If

        'If Alphanumeric it includes Groups or G-Lists
        If bAlpha Then
            'jrs 2021/04/12
            'if using mix of groups and Country
            'then convert numeric Country into text
            If bUseCtryAndGroup Then
                x = Split(sURL, ",")
                j = 0
                Do While j <= UBound(x)
                    If IsNumeric(x(j)) Then
                        sURL = Replace(sURL, x(j), """" & GRPS(1, CInt(x(j)) + 1) & """")
                    End If
                    j = j + 1
                Loop
            End If

            x = Split(sURL, """,""")
            j = 0
            'jrs 2021/04/12
            'Now searching all array in case order is different
            Do While j <= UBound(x)
                For i = lstDim.Items.Count - GCount - GListCount - 1 To lstDim.Items.Count - 2
                    If lstDim.Items(i).Text = Replace(x(j), """", "") Then
                        lstDim.Items(i).Selected = True
                        'j = j + 1
                        'If j > UBound(x) Then
                        Exit For
                        'End If
                    End If
                Next
                j = j + 1
            Loop
        Else
            x = Split(sURL, ",")
            For i = 0 To UBound(x)
                pos = InStr(x(i), "-")
                If pos > 0 Then
                    iFst = CInt(Left(x(i), pos - 1))
                    iLst = CInt(Mid(x(i), pos + 1))
                    For j = iFst To iLst
                        lstDim.Items(j).Selected = True
                    Next
                Else
                    lstDim.Items(CInt(x(i))).Selected = True
                End If
            Next
        End If

    End Sub

    'jrs 2012/01/09 added IFsRunFiles, PDFilesIdx, FilesSelected, RunFiles, PutFdrvRun2, vShortSce to add additional runfiles
    Public Sub URLToFileLst(ByVal sURL As String, ByRef lstFiles As ListBox, ByRef sOrdFiles As String,
    ByRef IFsRunFiles As Object, ByRef PDFilesIdxs As Object, ByRef FilesSelected As Integer,
    ByRef RunFiles As Object, ByVal PutFdrvRun2 As String, ByRef vShortSce As Object,
    ByVal ScenarioFileDir As String) 'jrs 2014/01/14 added ScenarioFileDir
        Dim bAlpha As Boolean
        bAlpha = (InStr(sURL, """") > 0)
        Dim x As Object
        Dim i As Integer, pos As Integer, j As Integer, iFst As Integer, iLst As Integer
        sOrdFiles = ""

        'jrs 2014/01/22
        If Not bAlpha Then
            x = Split(sURL, ",")
            For i = 0 To UBound(x)
                If Not IsNumeric(x(i)) Then
                    bAlpha = True
                    Exit For
                End If
            Next
        End If

        'jrs 2013/10/08
        Dim bOpen As Boolean, bClose As Boolean, myChar As String
        bOpen = False
        bClose = False

        'If Alphanumeric it includes Groups or G-Lists
        If bAlpha Then
            'jrs 2013/10/08
            'Need to check for commas inside file name, that should not split the name
            For j = 1 To Len(sURL)
                myChar = Mid(sURL, j, 1)
                If Not bOpen And myChar = """" Then
                    bOpen = True
                    bClose = False
                ElseIf bOpen And Not bClose Then
                    If myChar = """" Then
                        bClose = True
                        bOpen = False
                    ElseIf myChar = "," Then
                        sURL = Mid(sURL, 1, j - 1) & "~" & Mid(sURL, j + 1)
                    End If
                End If
            Next

            x = Split(sURL, ",")

            For j = 0 To UBound(x)
                If IsNumeric(x(j)) Then
                    lstFiles.Items(x(j)).Selected = True
                    If sOrdFiles > "" Then
                        sOrdFiles = sOrdFiles & ","
                    End If
                    sOrdFiles = sOrdFiles & x(j).ToString
                Else
                    'jrs 2013/10/08
                    x(j) = Replace(x(j), "~", ",")

                    pos = InStr(x(j), "-")
                    If pos > 0 Then
                        iFst = CInt(Left(x(j), pos - 1))
                        iLst = CInt(Mid(x(j), pos + 1))
                        For i = iFst To iLst
                            lstFiles.Items(i).Selected = True
                            If sOrdFiles > "" Then
                                sOrdFiles = sOrdFiles & ","
                            End If
                            sOrdFiles = sOrdFiles & i.ToString
                        Next
                    Else
                        'Scenario Name Spelled out
                        Dim sSceName As String, iSce As Integer
                        sSceName = Replace(x(j), """", "")
                        iSce = lstFiles.Items.Count
                        lstFiles.Items.Add(iSce.ToString & " - " & sSceName)
                        ReDim Preserve PDFilesIdxs(iSce)

                        FilesSelected = FilesSelected + 1
                        ReDim Preserve RunFiles(FilesSelected)
                        RunFiles(FilesSelected) = PutFdrvRun2 + "\" + sSceName
                        If FilesSelected > UBound(vShortSce) Then
                            ReDim Preserve vShortSce(FilesSelected)
                        End If
                        vShortSce(FilesSelected) = TruncateSceFileName(sSceName)

                        IFsRunFiles.item(sSceName, ScenarioFileDir, PutFdrvRun2).visible = True
                        lstFiles.Items(iSce).Selected = True
                        If sOrdFiles > "" Then
                            sOrdFiles = sOrdFiles & ","
                        End If
                        sOrdFiles = sOrdFiles & iSce.ToString
                    End If
                End If
            Next
        Else
            x = Split(sURL, ",")
            For i = 0 To UBound(x)
                pos = InStr(x(i), "-")
                If pos > 0 Then
                    iFst = CInt(Left(x(i), pos - 1))
                    iLst = CInt(Mid(x(i), pos + 1))
                    For j = iFst To iLst
                        lstFiles.Items(j).Selected = True
                        If sOrdFiles > "" Then
                            sOrdFiles = sOrdFiles & ","
                        End If
                        sOrdFiles = sOrdFiles & j.ToString
                    Next
                Else
                    lstFiles.Items(CInt(x(i))).Selected = True
                    If sOrdFiles > "" Then
                        sOrdFiles = sOrdFiles & ","
                    End If
                    sOrdFiles = sOrdFiles & x(i).ToString
                End If
            Next
        End If
    End Sub

    'jrs 2011/09/15
    Public Function PrepareForURL(ByVal sParameter As String) As String
        'Remember to Update JavaScript Function too
        Dim tmp As String
        tmp = sParameter
        tmp = Replace(tmp, "%", "%25")
        tmp = Replace(tmp, "&", "%26")
        tmp = Replace(tmp, "+", "%2B")
        tmp = Replace(tmp, "<", "%3C")
        PrepareForURL = tmp
    End Function

    'jrs 2011/09/15
    Public Function PrepareForHTML(ByVal sParameter As String) As String
        Dim tmp As String
        tmp = sParameter
        tmp = Replace(tmp, "<", "&lt;")
        'jrs 2016/01/04
        tmp = Replace(tmp, "'", "\'")
        PrepareForHTML = tmp
    End Function

