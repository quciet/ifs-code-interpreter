    Private Function bFunctionHasGDP(sFunctionName As String, XName As String, YName As String) As Boolean
        If sFunctionName.IndexOf("GDP") >= 0 Then
            Return True
        End If
        If XName.IndexOf("GDP") >= 0 Then
            Return True
        End If
        If YName.IndexOf("GDP") >= 0 Then
            Return True
        End If
        Return False
    End Function

    'jrs 2023/09/05
    Private Sub ComputeAndSaveRegression(sXVarName As String, sXYear As String, sYVarName As String, sYYear As String,
                                         bLog As Boolean, sFxName As String, bXFactor As Boolean, sXFactor As String,
                                         bYFactor As Boolean, sYFactor As String, bReplace As Boolean, bPow As Boolean,
                                         bCubic As Boolean, ByRef IndVarTbls As Dictionary(Of String, DataTable),
                                         ByRef sReportLine As String, sMin As String, sMax As String)
        'Open Dep Variable
        Dim rsD As DataTable
        SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\ifsHistSeries.db", "Select [" & sYYear & "] FROM [Series" & sYVarName & "] ORDER BY Country", "", rsD)
        'Open Indep Variable
        Dim rsI As DataTable
        If IndVarTbls.ContainsKey(sXVarName & sXYear) Then
            rsI = IndVarTbls(sXVarName & sXYear)
        Else
            SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\ifsHistSeries.db", "Select [" & sXYear & "] FROM [Series" & sXVarName & "] ORDER BY Country", "", rsI)
            IndVarTbls.Add(sXVarName & sXYear, rsI)
        End If
        'Compute Regression
        Dim vreg As New RegressionObject
        Dim x#, y#
        With vreg
            If bCubic Then
                .Degree = 3
            Else
                .Degree = 1
            End If

            For i = 1 To rsD.Rows.Count
                If IsNumeric(rsD.Rows(i - 1).Item(0)) AndAlso IsNumeric(rsI.Rows(i - 1).Item(0)) Then
                    If bLog Then
                        If rsI.Rows(i - 1).Item(0) > 0 Then
                            x# = CDbl(rsI.Rows(i - 1).Item(0))
                            y# = CDbl(rsD.Rows(i - 1).Item(0))
                            If bXFactor Then
                                x# = x# / CSng(sXFactor)
                            End If
                            If bYFactor Then
                                y# = y# / CSng(sYFactor)
                            End If
                            x# = Log(x#)
                            .XYAdd(x#, y#)
                        End If
                    ElseIf bPow Then
                        If rsI.Rows(i - 1).Item(0) > 0 And rsD.Rows(i - 1).Item(0) > 0 Then
                            x# = CDbl(rsI.Rows(i - 1).Item(0))
                            y# = CDbl(rsD.Rows(i - 1).Item(0))
                            If bXFactor Then
                                x# = x# / CSng(sXFactor)
                            End If
                            If bYFactor Then
                                y# = y# / CSng(sYFactor)
                            End If
                            x# = Log(x#)
                            y# = Log(y#)
                            .XYAdd(x#, y#)
                        End If
                    Else
                        x# = CDbl(rsI.Rows(i - 1).Item(0))
                        y# = CDbl(rsD.Rows(i - 1).Item(0))
                        If bXFactor Then
                            x# = x# / CSng(sXFactor)
                        End If
                        If bYFactor Then
                            y# = y# / CSng(sYFactor)
                        End If
                        .XYAdd(x#, y#)
                    End If
                End If
            Next
        End With

        'Save New Regression
        Dim CoefB1 = vreg.Coeff(0)  'Y=a + bt
        Dim CoefB2 = vreg.Coeff(1)
        Dim CoefB3, CoefB4 As Double
        If bCubic Then
            CoefB3 = vreg.Coeff(2)
            CoefB4 = vreg.Coeff(3)
        End If

        Dim R2 As Single = CalcRSQR(vreg, rsD, rsI, bLog, bXFactor, sXFactor, bYFactor, sYFactor, bPow)

        Dim dbT As SqliteConnection
