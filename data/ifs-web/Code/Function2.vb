    'jrs 2025/10/03 don't use b2005PPP, always use current PPP year
    'jrs 2014/10/21 added b2005PPP as Boolean
    'jrs 2008/07/15
    'Returns the level of income that correspond to a given Percentile
    'Between the $1/day Percentile and the $2/day Percentile
    Public Function gFindPovertyLevelBetweenLimits(ByVal level As Single, ByVal level1 As Single, ByVal level2 As Single,
    ByVal PctPop As Single, ByVal NSNARAT As Single, ByVal NSNARAT2 As Single, ByVal meanconsumption As Single,
    ByVal lnstddev As Single, b2005PPP As Boolean) As Single 'jrs 2008/07/21 , AvgShift As Single
        'AvgShift is a portion, not an absolute number
        'jrs 2010/08/13 change extreme poverty line to $1.25/day

        Dim NSNARATFac As Single, LNMean As Single, incomelt1lnpcnt As Single
        'jrs 2016/05/02 NSNARATFac = NSNARAT + (NSNARAT2 - NSNARAT) * (level - 0.7) / (1.45 - 0.7)
        NSNARATFac = NSNARAT + (NSNARAT2 - NSNARAT) * (level - PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME")) / (PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW") - PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME"))
        LNMean = Log(meanconsumption * NSNARATFac * 1000) - 0.5 * (lnstddev ^ 2)
        'jrs 2008/07/21 incomelt1lnpcnt = AMAX(Amin(LogNormalCDF(365 * level, LNMean, lnstddev) + AvgShift, 0.99), 0)
        incomelt1lnpcnt = AMAX(Amin(LogNormalCDF(365 * level, LNMean, lnstddev), 0.99), 0)

        If Abs(incomelt1lnpcnt - PctPop / 100) > 0.01 And level1 = level2 Then
            'jrs 2008/07/22 MsgBox("Poverty Level Not Found, using estimation.", vbInformation, "Find Level")
            gFindPovertyLevelBetweenLimits = level
            Exit Function
        End If

        'Too big, go lower
        If incomelt1lnpcnt - PctPop / 100 > 0.01 Then
            gFindPovertyLevelBetweenLimits = gFindPovertyLevelBetweenLimits((level1 + level) / 2, level1, level,
            PctPop, NSNARAT, NSNARAT2, meanconsumption, lnstddev, b2005PPP) 'jrs 2008/07/21 AvgShift
            'Too low, go bigger
        ElseIf incomelt1lnpcnt - PctPop / 100 < -0.01 Then
            gFindPovertyLevelBetweenLimits = gFindPovertyLevelBetweenLimits((level + level2) / 2, level, level2,
            PctPop, NSNARAT, NSNARAT2, meanconsumption, lnstddev, b2005PPP) 'jrs 2008/07/21 AvgShift
        Else
            gFindPovertyLevelBetweenLimits = level
        End If
    End Function

    'jrs 2014/10/21 added b2005PPP
    'jrs 2008/07/17
    'jrs 2007/04/20
    'Function to search for a poverty level for a group between a range of values.
    Private Function gSearchPovertyLevel(ByVal min As Single, ByVal max As Single,
    ByVal iYr As Integer, ByVal pct As Single, ByVal grpTot As Long, ByVal POPTot As Object,
    ByVal NSNARAT As Object, ByVal NSNARAT2 As Object, ByVal nsnaratm As Object, ByVal meanconsumption As Object,
    ByVal lnstddev As Object, ByVal POP As Object, b2005PPP As Boolean) As Single 'jrs 2008/07/21 , incomelt1lnshift As Variant, incomelt2lnshift As Variant
        'Parameters:
        '1. min is the income level at which the desired level is reached in the poorest country of the group
        '2. max is the income level at which the desired level is reached in the richest country of the group
        '3. iYr is the year in which we're searching (1 is the base year)
        '4. pct is the percentage of population we're targeting
        '5. grpTot is the number of members of the group 'jrs 2008/07/01 changed it from integer to long
        '6. POPTot is an array that stores the total population accross time.
        '7-12. Arrays that store variables accross time for each country
        '13,14 shifts

        'Find a given level
        'We'll use the middle point between min and max
        Dim mid As Single
        mid = (max + min) / 2
        'Get it's population for the level
        Dim People As Single
        People = gGetPopAtPovLevel(mid, iYr, grpTot, NSNARAT, NSNARAT2, nsnaratm, meanconsumption,
        lnstddev, POP, b2005PPP) 'jrs 2008/07/21 , incomelt1lnshift, incomelt2lnshift
        'Check if we hit it!
        If Abs(People / POPTot(iYr) * 100 - pct) < 1 Then
            gSearchPovertyLevel = mid
        Else
            If People < POPTot(iYr) * pct / 100 Then
                gSearchPovertyLevel = gSearchPovertyLevel(mid, max, iYr, pct, grpTot, POPTot,
                NSNARAT, NSNARAT2, nsnaratm, meanconsumption, lnstddev, POP, b2005PPP) 'jrs 2008/07/21 , incomelt1lnshift, incomelt2lnshift
            Else
                gSearchPovertyLevel = gSearchPovertyLevel(min, mid, iYr, pct, grpTot, POPTot,
                NSNARAT, NSNARAT2, nsnaratm, meanconsumption, lnstddev, POP, b2005PPP) 'jrs 2008/07/21 , incomelt1lnshift, incomelt2lnshift
            End If
        End If
    End Function

    'jrs 2025/10/03 don't use b2005PPP, always use current PPP year
    'jrs 2014/10/21 added b2005PPP
    'jrs 2008/07/17
    'jrs 2007/04/20
    'Function to retrieve the number of people living at a certain level of income for a group
    'in a certain year given all variables already loaded.
    Private Function gGetPopAtPovLevel(ByVal level As Single, ByVal iYr As Integer, ByVal grpTot As Long,
    ByVal NSNARAT As Object, ByVal NSNARAT2 As Object, ByVal nsnaratm As Object, ByVal meanconsumption As Object,
    ByVal lnstddev As Object, ByVal POP As Object, b2005PPP As Boolean) As Single 'jrs 2008/07/21 , incomelt1lnshift As Variant, incomelt2lnshift As Variant
        '1. level is the income level that we want to test.
        '2. iYr is the year (1 is for the base year)
        '3. grpTot is the number of members of the group 'jrs 2008/07/01 changed from integer to long
        '4-9. Arrays containing variables accross time for each country in group.
        '10,11 shifts

        Dim i As Integer, grpIdx As Integer, NSNARATFac As Single, LNMean As Single
        Dim incomelt1lnpcnt As Single, incomelt1lncalc As Single

        i = iYr

        'jrs 2008/07/18
        'jrs 2008/07/21 Dim AvgShift As Single

        If iYr = 1 Then

            For grpIdx = 1 To grpTot
                If level > PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW") Then
                    NSNARATFac = NSNARAT2(grpIdx)
                ElseIf level > PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME") Then
                    NSNARATFac = NSNARAT(iYr, grpIdx) + (NSNARAT2(grpIdx) - NSNARAT(iYr, grpIdx)) * (level - PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME")) / (PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW") - PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME"))
                Else
                    NSNARATFac = NSNARAT(iYr, grpIdx)
                End If

                LNMean = Log(meanconsumption(iYr, grpIdx) * NSNARATFac * 1000) - 0.5 * (lnstddev(iYr, grpIdx) ^ 2)
                incomelt1lnpcnt = LogNormalCDF(365 * level, LNMean, lnstddev(iYr, grpIdx))
                'jrs 2008/07/21 incomelt1lncalc = AMAX(Amin(0.99 * POP(iYr, grpIdx), incomelt1lnpcnt * POP(iYr, grpIdx) + AvgShift), 0)
                incomelt1lncalc = AMAX(Amin(0.99 * POP(iYr, grpIdx), incomelt1lnpcnt * POP(iYr, grpIdx)), 0)

                If grpIdx = 1 Then
                    gGetPopAtPovLevel = 0
                End If
                gGetPopAtPovLevel = gGetPopAtPovLevel + incomelt1lncalc
            Next grpIdx
        Else
            For grpIdx = 1 To grpTot
                If level > PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW") Then
                    NSNARATFac = NSNARAT2(grpIdx)
                ElseIf level > PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME") Then
                    NSNARATFac = NSNARAT(iYr, grpIdx) + (NSNARAT2(grpIdx) - NSNARAT(iYr, grpIdx)) * (level - PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME")) / (PovLevelsByPPPYear(ConstantDollarsYear)("MIDLOW") - PovLevelsByPPPYear(ConstantDollarsYear)("EXTREME"))
                Else
                    NSNARATFac = NSNARAT(iYr, grpIdx)
                End If

                LNMean = Log(meanconsumption(iYr, grpIdx) * NSNARATFac * nsnaratm(iYr, grpIdx) * 1000) - 0.5 * (lnstddev(iYr, grpIdx) ^ 2)
                incomelt1lnpcnt = LogNormalCDF(365 * level, LNMean, lnstddev(iYr, grpIdx))
                If grpIdx = 1 Then
                    gGetPopAtPovLevel = 0
                End If
                gGetPopAtPovLevel = gGetPopAtPovLevel + AMAX(0, Amin(0.99 * POP(iYr, grpIdx),
                incomelt1lnpcnt * POP(iYr, grpIdx)))  'jrs 2008/07/21 + AvgShift
            Next grpIdx
        End If
    End Function

    'jrs 2008/09/26
    Public Function CheckNegsPLOT(ByVal COUNTE As Integer, ByRef FinYear As Object, ByRef PLOT As Object) As Boolean
        'this function returns true if negatives are found loaded in the PLOT vector
        'originially designed to disallow Pie charts for negatives.
        CheckNegsPLOT = False
        Dim i As Integer, j As Integer
        For j = 1 To COUNTE
            For i = 1 To FinYear(j)
                If IsNumeric(PLOT(i, j)) Then
                    If PLOT(i, j) < 0 Then
                        CheckNegsPLOT = True
                        Exit Function
                    End If
                End If
            Next i
        Next j
    End Function

    'jrs 2008/11/11
    'Looks for the Maximum value in the table for a given country
    Private Function findMaxValCtry(ByRef valtbl As DataTable, ByVal sCtry As String) As Single
        Dim row As DataRow
        row = SeekRow(valtbl, sCtry)
        Dim i As Integer
        findMaxValCtry = -1000
        For i = 2 To valtbl.Columns.Count - 3
            If Not IsDBNull(row.Item(i)) Then
                If row.Item(i) > findMaxValCtry Then
                    findMaxValCtry = row.Item(i)
                End If
            End If
        Next i
    End Function

    'jrs 2008/11/11
    Private Function findMaxValGrp(ByRef valtbl As DataTable, ByRef sCtrys() As String, ByVal Count As Integer) As Single
        Dim i As Integer
        findMaxValGrp = -1000
        Dim currVal As Single
        For i = 1 To Count
            currVal = findMaxValCtry(valtbl, sCtrys(i))
            If currVal > findMaxValGrp Then
                findMaxValGrp = currVal
            End If
        Next i
    End Function

    'jrs 2009/01/20
    Public Sub RecomputePointersforTotal(ByRef VarPointer As Object, ByVal idxVar As Integer,
    ByVal idxDim1 As Integer, ByVal idxDim2 As Integer, ByVal idxDim3 As Integer, ByVal bGroup As Boolean,
    ByRef gGroupMembrs As Object, ByRef gGroupMembersPtrs As Object, ByVal gCountGroupMembers As Integer)
        '1. VarPointer pointer calculation result when not using groups
        '2. idxVar index of Variable
        '3. idxDim1 index of Dimension1
        '4. idxDim2 index of Dimension2
        '5. idxDim3 index of Dimension3
        '6. bGroup flat indicating if using Groups
        '7. gGroupMembrs array that holds all members of the group
        '8. gGroupMembersPtrs array that holds pointers for all members of the group
        '9. gCountGroupMembers number of members in the group

        _logger.Debug("RecomputePointersforTotal ")

        'Pointer Calculation 2006/04/06
        Dim VPTR As Object, iTotal As Integer
        iTotal = 0
        Do While True
            VPTR = 0
            iTotal = iTotal + 1

            If bGroup Then
                idxDim1 = IFsRegs.Item(gGroupMembrs(iTotal)).Index
            End If

            If VDim1(idxVar) > 0 Then
                VPTR = idxDim1
            Else
                VPTR = 1
            End If
            If VDim2(idxVar) > 0 Then
                VPTR = VPTR + ((idxDim2 - 1) * (MAXCOM(VDim1(idxVar)) - 1))  'final pointer shift calculation
            End If
            If VDim3(idxVar) > 0 Then
                VPTR = VPTR + ((idxDim3 - 1) * (MAXCOM(VDim1(idxVar)) - 1) * (MAXCOM(VDim2(idxVar)) - 1))  'final pointer shift calculation
            End If

            'Get Variable Pointer
            '--------------------
            If Not bGroup Then
                VarPointer = VarPoint(idxVar) + VPTR - 1
                Exit Do
            Else
                gGroupMembersPtrs(iTotal) = VarPoint(idxVar) + VPTR - 1
                If iTotal = gCountGroupMembers Then Exit Do
            End If
        Loop

    End Sub

    'jrs 2009/01/23
    Private Function gLoadHistAnalogTableFromString(ByVal idxVar As Integer, ByVal idxDim2 As Integer) As String
        Dim txt As String
        txt = Trim(VHistoricAnalog(idxVar))
        Dim tmpTblNo As Integer
        tmpTblNo = 0
        Dim tmptblname As String
        tmptblname = ""
        Dim i As Integer, k As String
        For i = 1 To Len(txt)
            k = Mid(txt, i, 1)
            Select Case k
                Case ","
                    tmpTblNo = tmpTblNo + 1
                    If tmpTblNo = idxDim2 Then Exit For
                    tmptblname = ""
                Case Else
                    tmptblname = tmptblname + k
            End Select
            'jrs 2009/01/23
            If i = Len(txt) Then tmpTblNo = tmpTblNo + 1
        Next
        If tmpTblNo <> idxDim2 Then tmptblname = "" 'jrs 2009/01/23 in case it wasn't found
        gLoadHistAnalogTableFromString = tmptblname
    End Function

    'jrs 2009/01/21
    'Loads Total Empirical History, across non-region dimensions, not for Gender nor Age cohorts
    Private Sub gLoadForDisplayHisTot(ByVal sVar As String, ByVal sDim1 As String, ByVal sDim2 As String,
    ByVal bTotal2 As Boolean, ByVal sDim3 As String, ByVal bTotal3 As Boolean, ByRef bGrp As Object,
    ByVal bfillHistoryHoles As Boolean, ByVal buseAllHistory As Boolean,
    ByRef iLstYrUseAllHistory As Integer, ByVal bUseNullsAs0 As Boolean,
    ByVal COUNTE As Integer, ByRef bComputation As Boolean,
    ByVal iFirstYear As Integer, ByVal iLastYear As Integer, ByVal LastYearForecast As Integer,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef FinYear As Object,
    ByRef IfsPars As myParameters, ByRef TargetVector As Object, ByVal bfillHistoryHolesOnly As Boolean,
    ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef StaYearHis As Object, ByRef iFstYrUseAllHisotry As Integer, ByRef SQLite As String)

        Dim idxVar As Integer, idxDim2 As Integer, idxDim3 As Integer
        idxVar = IfsVars.Item(sVar).Index
        idxDim2 = 1
        idxDim3 = 1
        'Size of the formula
        Dim iSize As Integer
        If bTotal2 And Not bTotal3 Then
            iSize = MAXCOM(VDim2(idxVar)) - 1
            If UCase(GRPS(VDim2(idxVar), iSize)) = "TOTAL" Then
                iSize = iSize - 1
            End If
        ElseIf bTotal3 And Not bTotal2 Then
            iSize = MAXCOM(VDim3(idxVar)) - 1
            If UCase(GRPS(VDim3(idxVar), iSize)) = "TOTAL" Then
                iSize = iSize - 1
            End If
        ElseIf bTotal2 And bTotal3 Then
            iSize = (MAXCOM(VDim2(idxVar)) - 1)
            If UCase(GRPS(VDim2(idxVar), iSize)) = "TOTAL" Then
                iSize = iSize - 1
            End If
            If UCase(GRPS(VDim3(idxVar), MAXCOM(VDim3(idxVar)) - 1)) = "TOTAL" Then
                iSize = iSize * (MAXCOM(VDim3(idxVar)) - 2)
            Else
                iSize = iSize * (MAXCOM(VDim3(idxVar)) - 1)
            End If
        End If
        'Formula string
        Dim sFormula As String
        Dim i As Integer, j As Integer
        For i = 1 To iSize
            sFormula = sFormula & "T"
            If i < 10 Then
                sFormula = sFormula & "0"
            End If
            sFormula = sFormula & Trim(CStr(i))
            If i < iSize Then
                sFormula = sFormula & "+"
            End If
        Next i
        Dim ff As New Formula
        Dim fDet() As String
        ReDim fDet(iSize)

        'build the Total formula, based on 3 types of logic to build historic analog option
        Select Case UCase(VHistoricAnalog(idxVar))
            Case "FORMULA"
                'check for formula
                Dim dbCHA As String, qry As String, rsCHA As DataTable
                Dim rsComp As DataTable
                Dim sFormula2 As String
                j = 1
                i = 1
                dbCHA = IfsPars.PutFdrvRun & "IFSVAR.MDB"
                Do While True
                    If bTotal2 And Not bTotal3 Then
                        sDim2 = GRPS(VDim2(idxVar), idxDim2)
                        idxDim2 = idxDim2 + 1
                    ElseIf bTotal3 And Not bTotal2 Then
                        sDim3 = GRPS(VDim3(idxVar), idxDim3)
                        idxDim3 = idxDim3 + 1
                    ElseIf bTotal2 And bTotal3 Then
                        idxDim2 = idxDim2 + 1
                        If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                            idxDim3 = idxDim3 + 1
                            sDim3 = GRPS(VDim3(idxVar), idxDim3)
                            idxDim2 = 1
                        End If
                        sDim2 = GRPS(VDim2(idxVar), idxDim2)
                    End If

                    qry = "NAME = '" & V(idxVar) & "'"
                    If VDim2(idxVar) > 0 Then
                        qry = qry & " AND DIM2 = '" & Replace(sDim2, "'", "''") & "'"
                        If VDim3(idxVar) > 0 Then
                            qry = qry & " AND DIM3 = '" & sDim3 & "'"
                        End If
                    End If

                    Try
                        rsCHA = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULAS")
                    Catch ex As ArgumentException
                        'jrs 2012/01/31 avoid duplicate keys
                        SyncLock IFsTables
                            If Not IFsTables.Contains("SELECT * FROM IfsVarHISTANAFORMULAS") Then
                                SetDataTablefromAccess(dbCHA, "SELECT * FROM IfsVarHISTANAFORMULAS", "", rsCHA)
                                IFsTables.Add(rsCHA, "SELECT * FROM IfsVarHISTANAFORMULAS")
                            Else
                                rsCHA = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULAS")
                            End If
                        End SyncLock
                    End Try
                    Dim tblRowsCHA() As DataRow
                    tblRowsCHA = rsCHA.Select(qry)

                    'replace element with formula
                    If tblRowsCHA.Length > 0 Then
                        sFormula2 = tblRowsCHA(0).Item("Formula")
                        bUseNullsAs0 = bUseNullsAs0 Or tblRowsCHA(0).Item("UseNullsAsZeros") 'jrs 2019/09/16 changed from And to Or

                        qry = "FORVARNAME = '" & V(idxVar) & "'"
                        If sDim2 > "" Then
                            qry = qry & " AND DIM2 = '" & Replace(sDim2, "'", "''") & "'"
                            If sDim3 > "" Then
                                qry = qry & " AND DIM3 = '" & sDim3 & "'"
                            End If
                        End If

                        Try
                            rsComp = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]")
                        Catch ex As ArgumentException
                            'jrs 2012/01/31 avoid duplicate keys
                            SyncLock IFsTables
                                If Not IFsTables.Contains("SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]") Then
                                    SetDataTablefromAccess(dbCHA, "SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]", "", rsComp)
                                    IFsTables.Add(rsComp, "SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]")
                                Else
                                    rsComp = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]")
                                End If
                            End SyncLock
                        End Try
                        Dim tblRows() As DataRow
                        tblRows = rsComp.Select(qry)

                        If j + tblRows.Length > UBound(fDet) Then
                            ReDim Preserve fDet(j + tblRows.Length)
                        End If

                        Dim rr As Integer = 0
                        Do While Not rr = tblRows.Length
                            If i < 10 Then
                                sFormula2 = Replace(sFormula2, tblRows(rr).Item("CodeVar"), "T0" & CStr(i) & tblRows(rr).Item("CodeVar"))
                            Else
                                sFormula2 = Replace(sFormula2, tblRows(rr).Item("CodeVar"), "T" & CStr(i) & tblRows(rr).Item("CodeVar"))
                            End If
                            fDet(j) = tblRows(rr).Item("VarName")
                            j = j + 1
                            rr = rr + 1
                        Loop

                        sFormula2 = "(" & sFormula2 & ")"
                        If i < 10 Then
                            sFormula = Replace(sFormula, "T0" & CStr(i), sFormula2)
                        Else
                            sFormula = Replace(sFormula, "T" & CStr(i), sFormula2)
                        End If
                    Else
                        If i < 10 Then
                            sFormula = Replace(sFormula, "T0" & CStr(i), "0")
                        Else
                            sFormula = Replace(sFormula, "T" & CStr(i), "0")
                        End If
                    End If

                    i = i + 1
                    If i > iSize Then Exit Do
                Loop

                ff.init(sFormula)
                ff.UseNullsAsZeros = bUseNullsAs0
                i = 1
                Do While True
                    sVar = fDet(i)
                    ff.disVar.setDataDet(i, sVar & "[-1]")
                    ff.disVar.setDataDet1(i, sDim1)
                    i = i + 1
                    If i > ff.disVar.disSize Then Exit Do
                Loop

            Case "IFSVARHISTANA"
                ff.init(sFormula)
                ff.UseNullsAsZeros = bUseNullsAs0
                i = 1
                j = 1
                Do While True
                    If bTotal2 And Not bTotal3 Then
                        sDim2 = GRPS(VDim2(idxVar), idxDim2)
                        idxDim2 = idxDim2 + 1
                    ElseIf bTotal3 And Not bTotal2 Then
                        sDim3 = GRPS(VDim3(idxVar), idxDim3)
                        idxDim3 = idxDim3 + 1
                    ElseIf bTotal2 And bTotal3 Then
                        'jrs 2025/02/24
                        'idxDim2 = idxDim2 + 1
                        'If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                        '    idxDim3 = idxDim3 + 1
                        '    sDim3 = GRPS(VDim3(idxVar), idxDim3)
                        '    idxDim2 = 1
                        'End If
                        'sDim2 = GRPS(VDim2(idxVar), idxDim2)
                        sDim2 = GRPS(VDim2(idxVar), idxDim2)
                        If idxDim2 = 1 Then
                            sDim3 = GRPS(VDim3(idxVar), idxDim3)
                        End If
                        idxDim2 = idxDim2 + 1
                        If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                            idxDim3 = idxDim3 + 1
                            idxDim2 = 1
                        End If
                    End If

                    sVar = IFsHistAnalogs.Item(V(idxVar), sDim2, sDim3).sHistAna
                    If sVar > "" Then
                        fDet(j) = sVar
                        j = j + 1
                    Else
                        If i < 10 Then
                            sFormula = Replace(sFormula, "T0" & CStr(i), "0")
                        Else
                            sFormula = Replace(sFormula, "T" & CStr(i), "0")
                        End If
                    End If

                    i = i + 1
                    If i > iSize Then Exit Do
                Loop

                ff.init(sFormula)
                ff.UseNullsAsZeros = bUseNullsAs0
                i = 1
                Do While True
                    sVar = fDet(i)
                    ff.disVar.setDataDet(i, sVar & "[-1]")
                    ff.disVar.setDataDet1(i, sDim1)
                    i = i + 1
                    If i > ff.disVar.disSize Then Exit Do
                Loop

            Case Else
                'check for old format
                i = 1
                j = 1
                Do While True
                    sVar = gLoadHistAnalogTableFromString(idxVar, idxDim2)
                    idxDim2 = idxDim2 + 1
                    If sVar > "" Then
                        fDet(j) = sVar
                        j = j + 1
                    Else
                        If i < 10 Then
                            sFormula = Replace(sFormula, "T0" & CStr(i), "0")
                        Else
                            sFormula = Replace(sFormula, "T" & CStr(i), "0")
                        End If
                    End If

                    i = i + 1
                    If i > iSize Then Exit Do
                Loop

                ff.init(sFormula)
                ff.UseNullsAsZeros = bUseNullsAs0
                i = 1
                Do While True
                    sVar = fDet(i)
                    ff.disVar.setDataDet(i, sVar & "[-1]")
                    ff.disVar.setDataDet1(i, sDim1)

                    i = i + 1
                    If i > ff.disVar.disSize Then Exit Do
                Loop

        End Select

        Dim FileforDisplay As Integer = 0 'not being saved for Empirical variables
        Dim aFormulas(COUNTE) As Object 'no need to save this one in global array

        'load plot for the history part
        gLoadComp(COUNTE, ff.Formula_Renamed, sVar, sDim1, "", "", "", -1, bGrp, -1, False, True, ff,
        bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, False, bComputation, iFirstYear, iLastYear,
        LastYearForecast, bLoadForDisplaySuccess, myForm, FinYear, FileforDisplay, IfsPars, TargetVector,
        aFormulas, bfillHistoryHolesOnly, iFstYrUseAllHisotry, bCompAll, dataAll, StaYearHis, "", SQLite)

    End Sub

    'jrs 2009/01/26
    'Loads Total Empirical History, across Gender or Age cohorts
    'using weighted average
    Private Sub gLoadForDisplayHisTotW(ByVal sVar As String, ByVal sDim1 As String, ByVal idxDim1 As Integer,
    ByVal sDim2 As String, ByVal bTotal2 As Boolean, ByVal sDim3 As String, ByVal bTotal3 As Boolean, ByRef bGrp As Object,
    ByRef Target As Object, ByVal bSnglDim As Boolean, ByVal icol As Integer, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer, ByRef bLoadForDisplaySuccess As Boolean,
    ByRef myForm As Page, ByRef FinYear As Object, ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef bComputation As Boolean, ByRef sDefinition As String, ByRef sUnits As String,
    ByRef IfsParameters As myParameters, ByVal bfillHistoryHolesOnly As Boolean,
    ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef StaYearHis As Object, ByRef SQLite As String)

        Dim idxVar As Integer, idxDim2 As Integer, idxDim3 As Integer
        idxVar = IfsVars.Item(sVar).Index

        idxDim2 = 1
        idxDim3 = 1

        'Find number of individual members
        '----------------------------------
        Dim iSize As Integer, iSize2 As Integer
        Dim sType As String
        sType = ""
        If bTotal2 And Not bTotal3 Then
            iSize = MAXCOM(VDim2(idxVar)) - 1
            If UCase(GRPS(VDim2(idxVar), iSize)) = "TOTAL" Then
                iSize = iSize - 1
            End If
            If VDim2(idxVar) = GenderIdx Then
                sType = "GenderOnly"
            ElseIf VDim2(idxVar) = Age30_70Idx And VDim3(idxVar) = GenderIdx Then
                If sDim3 = "Male" Then
                    sType = "Male30to70"
                Else
                    sType = "Female30to70"
                End If
            End If
        ElseIf bTotal3 And Not bTotal2 Then
            iSize = MAXCOM(VDim3(idxVar)) - 1
            If UCase(GRPS(VDim3(idxVar), iSize)) = "TOTAL" Then
                iSize = iSize - 1
            End If
            If VDim3(idxVar) = GenderIdx Then
                If VDim2(idxVar) = Age30_70Idx Then
                    sType = "Gender" & sDim2
                Else
                    sType = "GenderOnly"
                End If
            End If
        ElseIf bTotal2 And bTotal3 Then
            iSize = (MAXCOM(VDim2(idxVar)) - 1)
            If UCase(GRPS(VDim2(idxVar), iSize)) = "TOTAL" Then
                iSize = iSize - 1
            End If
            iSize2 = iSize
            If UCase(GRPS(VDim3(idxVar), MAXCOM(VDim3(idxVar)) - 1)) = "TOTAL" Then
                iSize = iSize * (MAXCOM(VDim3(idxVar)) - 2)
            Else
                iSize = iSize * (MAXCOM(VDim3(idxVar)) - 1)
            End If
            If VDim2(idxVar) = Age30_70Idx And VDim3(idxVar) = GenderIdx Then sType = "Gender30to70"
        End If

        Dim Vals(0, 0)
        'jrs 2009/02/05
        Dim MaxYr As Integer
        If buseAllHistory Then
            'blows up when using only 2025
            If LastYearForecast > 2030 Then
                ReDim Vals(LastYearForecast - FirstYearHistory, iSize)
            Else
                ReDim Vals(2031 - FirstYearHistory, iSize)
            End If
        Else
            ReDim Vals(LastYearHistory - FirstYearHistory, iSize)
            MaxYr = LastYearHistory - 1
        End If

        'Load individual elements
        '------------------------
        Dim i As Integer
        i = 1

        Select Case UCase(VHistoricAnalog(idxVar))
            Case "FORMULA"
                MsgBox("Weighted Average Logic not implemented for Formulas", vbInformation, "Weighted Average")
                Exit Sub
            Case "IFSVARHISTANA"
                Do While True
                    If bTotal2 And Not bTotal3 Then
                        sDim2 = GRPS(VDim2(idxVar), idxDim2)
                        idxDim2 = idxDim2 + 1
                    ElseIf bTotal3 And Not bTotal2 Then
                        sDim3 = GRPS(VDim3(idxVar), idxDim3)
                        idxDim3 = idxDim3 + 1
                    ElseIf bTotal2 And bTotal3 Then
                        If idxDim2 = iSize2 + 1 Then
                            idxDim3 = idxDim3 + 1
                            idxDim2 = 1
                        End If
                        sDim3 = GRPS(VDim3(idxVar), idxDim3)
                        sDim2 = GRPS(VDim2(idxVar), idxDim2)
                        idxDim2 = idxDim2 + 1
                    End If

                    gLoadForDisplayHis(sVar, sDim1, idxDim1, sDim2, idxDim2, sDim3, idxDim3,
                    bGrp, 1, Vals, i, FirstYearHistory, LastYearHistory - 1,
                    False, True, bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory,
                    bLoadForDisplaySuccess, myForm, FinYear, LastYear, LastYearForecast, bComputation,
                    sDefinition, sUnits, IfsParameters, bfillHistoryHolesOnly, bCompAll, dataAll, StaYearHis, SQLite)

                    'jrs 2009/02/05
                    If buseAllHistory Then
                        If iLstYrUseAllHistory > MaxYr Then
                            MaxYr = iLstYrUseAllHistory
                        End If
                    End If

                    i = i + 1
                    If i > iSize Then Exit Do
                Loop
            Case Else 'old format
                Do While True
                    sDim2 = GRPS(VDim2(idxVar), idxDim2)
                    idxDim2 = idxDim2 + 1

                    'jrs 2012/11/22 changed from idxDim2 to idxDim2 - 1
                    gLoadForDisplayHis(sVar, sDim1, idxDim1, sDim2, idxDim2 - 1, sDim3, idxDim3,
                    bGrp, 1, Vals, i, FirstYearHistory, LastYearHistory - 1,
                    False, True, bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory,
                    bLoadForDisplaySuccess, myForm, FinYear, LastYear, LastYearForecast, bComputation,
                    sDefinition, sUnits, IfsParameters, bfillHistoryHolesOnly, bCompAll, dataAll, StaYearHis, SQLite)

                    'jrs 2009/02/05
                    If buseAllHistory Then
                        If iLstYrUseAllHistory > MaxYr Then
                            MaxYr = iLstYrUseAllHistory
                        End If
                    End If

                    i = i + 1
                    If i > iSize Then Exit Do
                Loop
        End Select

        'Load Weights: Gender or Age
        '---------------------------
        Dim Weights(0, 0)
        If sType > "" Then
            'Load Population by Gender, Year
            gLoadPopWeightsGA(sType, Weights, MaxYr, sDim1, idxDim1,
            bGrp, iSize, IfsParameters.PutFdrvRun, IfsParameters.Ifs_MDB2Active)
        Else
            'MsgBox("This weighted average has not been implemented", vbInformation, "Weighted Average")
            Exit Sub
        End If

        'Compute weigthed average
        '------------------------
        Dim iYr As Integer, jYr As Integer
        Dim w As Object, v As Object
        For iYr = 1 To MaxYr - FirstYearHistory + 1 'jrs 2009/02/05 LastYearHistory - FirstYearHistory
            w = 0
            v = 0
            'jrs 2009/02/06
            If iYr + FirstYearHistory - 1 < FirstYearForecast Then
                jYr = 1
            Else
                jYr = iYr + FirstYearHistory - FirstYearForecast
            End If

            For i = 1 To iSize
                If IsNumeric(Vals(iYr, i)) Then
                    v = v + Vals(iYr, i) * Weights(jYr, i)
                    w = w + Weights(jYr, i)
                Else
                    w = 0 'finding a Null should produce Null in the operation
                    Exit For
                End If
            Next i
            If w > 0 Then
                If bSnglDim Then
                    Target(iYr) = v / w
                Else
                    Target(iYr, icol) = v / w
                End If
            Else
                If bSnglDim Then
                    Target(iYr) = DBNull.Value
                Else
                    Target(iYr, icol) = DBNull.Value
                End If
            End If
        Next iYr

    End Sub

