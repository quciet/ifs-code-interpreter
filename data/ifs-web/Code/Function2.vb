    'jrs 2011/01/28
    'Function created to search alternatively in all words in the search string (OR like)
    'Considering only the entire search string when using double quotation marks (AND like)
    'based on bSearchInVarIdx
    Public Function bSearchInListItem(sSearch As String, sListItem As String) As Boolean

        bSearchInListItem = False
        Dim x As Object
        x = Split(sSearch, " ")
        Dim i As Integer, j As Integer
        Dim bOpen As Boolean, bClose As Boolean, bQuot As Boolean
        Dim Target() As String
        ReDim Target(0)

        j = 0
        'Create Target Array
        For i = 0 To UBound(x)
            bQuot = (InStr(x(i), """") > 0)
            If bQuot Then
                If bOpen Then
                    bClose = True
                Else
                    bOpen = True
                End If
            End If

            If Not bOpen Then
                ReDim Preserve Target(j)
                Target(j) = x(i)
                j = j + 1
            Else
                If j > UBound(Target) Then
                    ReDim Preserve Target(j)
                End If
                Target(j) = Target(j) & " " & x(i)
                If bClose Then
                    Target(j) = Replace(LTrim(Target(j)), """", "")
                    j = j + 1
                    bClose = False
                    bOpen = False
                End If
            End If
        Next i

        'Search for each target
        Dim k As Integer
        Dim iSearchCount As Integer
        iSearchCount = 0

        For k = 0 To UBound(Target)
            If InStr(UCase(sListItem), UCase(Target(k))) > 0 Then
                iSearchCount = iSearchCount + 1
            End If
        Next k

        'if all words were found, then set it to true, otherwise too many matches
        If iSearchCount = UBound(Target) + 1 Then
            bSearchInListItem = True
        End If
    End Function

    'jrs 2013/11/26
    'Procedure needed by Development Profile, broght from Main Project
    Public Sub AnalFunc(ByVal TFName As String, ByRef IndVar As Object, ByRef DepVar As Object, ByRef rsAnalytic As DataTable)
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        'JRS 6/18/02 Originally was XYTABL, modified to handle several independant variables
        'IndVar is an array of values, corresponding to independent variables used in this function 'be carefull with the order of this values, it has to be the same order in which the 'variables are stored in AnalFunc.mdb
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        '   Identify Table Function Accessed
        '   --------------------------------
        On Error GoTo AnalFuncError
        Dim Msg As String
        If IsDBNull(IndVar) Then
            Msg = "In a call to ANALFUNC for the computation of " + TFName +
                " the Independent Variable is Null.  We will exit the subroutine."
            Err.Raise(vbObjectError + 1051, Nothing, Msg)
        End If

        Dim rws As Object
        rws = rsAnalytic.Select("[Function Name]='" & TFName & "'")

        If rws Is Nothing Then
            Msg = "Fatal Error:  Table function " + TFName + " not found."
            Err.Raise(vbObjectError + 1051, Nothing, Msg)
        End If

        '   Analytic function - compute dependent
        '   -------------------------------------
        DepVar = CType(rws(0), DataRow).Item("a")
        Dim i As Integer
        'jrs 2009/09/14
        Dim ValLimit As Single
        ValLimit = IIf(IsDBNull(CType(rws(0), DataRow).Item("b9")), 0, CType(rws(0), DataRow).Item("b9"))

        For i = 0 To UBound(IndVar)
            'Check that all lines belong to the required function
            If CType(rws(i), DataRow).Item("Function Name") <> TFName Then
                Msg = "Fatal Error:  Table function " + TFName + " not found."
                Err.Raise(vbObjectError + 1051, Nothing, Msg)
            End If
            'The iif function is replacing nulls with 0, and 0 with 1 for the log
            DepVar = DepVar _
                + IIf(IsDBNull(CType(rws(i), DataRow).Item("b1")), 0, CType(rws(i), DataRow).Item("b1")) * IndVar(i) _
            + IIf(IsDBNull(CType(rws(i), DataRow).Item("b2")), 0, CType(rws(i), DataRow).Item("b2")) * IndVar(i) ^ 2 _
            + IIf(IsDBNull(CType(rws(i), DataRow).Item("b3")), 0, CType(rws(i), DataRow).Item("b3")) * IndVar(i) ^ 3 _
            + IIf(IsDBNull(CType(rws(i), DataRow).Item("b4")), 0, CType(rws(i), DataRow).Item("b4")) *
            Log(IIf(IndVar(i) <= 0, 1, IndVar(i))) _
            + IIf(IsDBNull(CType(rws(i), DataRow).Item("b5")), 0, CType(rws(i), DataRow).Item("b5")) * IndVar(i) ^
            IIf(IsDBNull(CType(rws(i), DataRow).Item("b6")), 0, CType(rws(i), DataRow).Item("b6")) _
            + IIf(IsDBNull(CType(rws(i), DataRow).Item("b7")), 0, CType(rws(i), DataRow).Item("b7")) _
            * Exp(IIf(IsDBNull(CType(rws(i), DataRow).Item("b8")), 0, CType(rws(i), DataRow).Item("b8")) * IndVar(i))

            'Advance to the next independent variable
        Next i

        'jrs 2009/09/14
        If ValLimit <> 0 Then
            DepVar = ValLimit / (1 + Exp(DepVar))
        End If

        Exit Sub

AnalFuncError:
        Msg = "Error occurred processing AnalFunc, using Function " + TFName
        Msg = Msg + ".  You will need to reverse changes made in multivariate "
        Msg = Msg + "functions or reload the original AnalFunc.mdb."
        _logger.Error(Err.GetException, $"AnalFunc - {Msg}")
        Err.Raise(vbObjectError + 1051, Nothing, Msg)

    End Sub
