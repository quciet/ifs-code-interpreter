        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "//IE 6+ in 'standards compliant mode'" & vbCr
        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "myWidth = document.documentElement.clientWidth;" & vbCr
        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "myHeight = document.documentElement.clientHeight;" & vbCr
