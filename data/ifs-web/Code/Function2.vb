    '' ' <summary>
    '' ' ''''''''''''''''''''''''''''''''''''''''''''''''''''
    '' ' 
    '' ' 
    '' ' JAM 2015-07-23 Recovering Comments for Cyber Scenarios
    '' ' 
    '' ' 
    '' ' '''''''''''''''''''''''''''''''''''''''''''''''
    '' ' </summary>
    '' ' <param name="vSceName">Scenario Name</param>
    '' ' <param name="vPathSce">Full Path CyberScenarios</param>
    '' ' <remarks></remarks>
    Public Function RecoverCommentCyberScenario(ByVal vSceName As String, ByVal vPathSce As String) As String
        Dim intfile As Short
        Dim RLine As String
        Dim vpostComment As Boolean
        Dim vCommentAdd As String

        'Dim FullFileName As String
        Dim vLinetoRead As Integer


        If vSceName = "" Then Exit Function

        Dim sFileName As String

        sFileName = FindFile(vPathSce, vSceName, "sce")

        If sFileName Is Nothing Then Exit Function

        ''FullFileName = vPathSce & "\" & vSceName

        intfile = FreeFile()

        If Dir(sFileName) <> "" Then
            FileOpen(intfile, sFileName, OpenMode.Input)
        End If

        vpostComment = False
        vLinetoRead = 0
        Do While Not EOF(intfile)
            RLine = LineInput(intfile)
            If UCase(Mid(RLine, 1, 7)) = "COMMENT" Then
                vpostComment = True
                vLinetoRead = 1
            End If

            If vpostComment And vLinetoRead > 1 Then
                vCommentAdd = vCommentAdd & Replace(Replace(RLine, """", "\"""), "'", "\'") & "<br>&nbsp&nbsp&nbsp&nbsp&nbsp" 'jrs 2015/08/13 added 5 spaces
            End If

            vLinetoRead += 1

        Loop

        FileClose(intfile)


        'FileCopy(Session("ScenarioFileDir") & "Working.add", Session("ScenarioFileDir") & "Working.sce")

        RecoverCommentCyberScenario = vCommentAdd
        Exit Function
    End Function

