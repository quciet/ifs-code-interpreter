            sFxName & """, """ & sXVarName & """, """ & sYVarName & """, 1, 0,'No','No','No','No','No'," & R2.ToString & ", " & b1 & ", " & CoefB3.ToString & ", " & CoefB4.ToString & ", " & CoefB1.ToString & "," &
            sMin & "," & sMax & ", ""Automated for Constant Dollars"")"
        ElseIf bPow Then
