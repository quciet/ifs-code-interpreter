    'jrs 2013/05/21 (created on vb6 'jrs 2009/04/07 copied from the main project)
    'function to search for the function name, returns the index if found, and the next index if not
    Public Function SearchFunctionNameIdx(ByVal sFuncName As String, ByVal st As Integer, ByVal en As Integer) As Integer
        If st > en Then
            'there's an error
            SearchFunctionNameIdx = -1
        Else
            Dim md As Integer
            md = (st + en) / 2
            If FuncName$(md) = sFuncName Or st = en Then
                SearchFunctionNameIdx = md
            ElseIf UCase(Replace(FuncName$(md), "- ", "& ")) < UCase(Replace(sFuncName, "- ", "& ")) Then
                If md = en Then md = en - 1
                SearchFunctionNameIdx = SearchFunctionNameIdx(sFuncName, md + 1, en)
            Else
                If md = st Then md = st + 1
                SearchFunctionNameIdx = SearchFunctionNameIdx(sFuncName, st, md - 1)
            End If
        End If
    End Function

    'jrs 2013/02/07
    Public Function BuildHelpURL(ByVal sTitle As String, ByVal sControl As String, ByVal bWeb As Boolean) As String
        'jrs 2025/01/16
        If Not bWeb Then
            If IsConnectedToInternet() Then
                bWeb = True
            End If
        End If

        Dim db As String
        db = PutDataFileDir & "ifsHelp.mdb"
        Dim rs As DataTable
        Dim sql As String
        sql = "SELECT [Help Site File Path] FROM HelpURL WHERE [Web title] = """ & sTitle & """"
        If sControl > "" Then
            sql = sql & " AND [Control] = """ & sControl & """"
        End If
        SetDataTablefromAccess(db, sql, "", rs)
        BuildHelpURL = ""
        If Not IsNothing(rs) Then
            If rs.Rows.Count > 0 Then
                BuildHelpURL = rs.Rows(0).Item(0).ToString
                'jrs 2020/05/19
                BuildHelpURL = Replace(BuildHelpURL, "https://", "")
                'jrs 2023/10/11 added and not bWeb
                'jrs 2020/06/26
                If StandAloneMode And Not bWeb Then
                    BuildHelpURL = Replace(BuildHelpURL, ":", "_")
                    'jrs 2023/10/11
                    BuildHelpURL = BuildHelpURL.Replace("pardee.du.edu/wiki/", "pardeewiki.du.edu/")
                    Dim pos As Integer = -1
                    pos = InStr(BuildHelpURL, "pardeewiki.du.edu/")
                    If pos > 0 Then
                        pos = pos + 18
                        Dim pos2 As Integer = -1
                        pos2 = InStr(BuildHelpURL, "?")
                        If pos2 > pos Then
                            BuildHelpURL = BuildHelpURL.Substring(0, pos2 - 1) & "%253F" & BuildHelpURL.Substring(pos2)
                        End If
                        pos2 = InStr(BuildHelpURL, "/")
                        If pos2 > pos Then
                            BuildHelpURL = BuildHelpURL.Substring(0, pos2 - 1) & "%252F" & BuildHelpURL.Substring(pos2)
                        End If
                        pos2 = InStr(BuildHelpURL, ":")
                        If pos2 > pos Then
                            BuildHelpURL = BuildHelpURL.Substring(0, pos2 - 1) & "%253A" & BuildHelpURL.Substring(pos2)
                        End If
                    End If
                Else 'jrs 2023/10/11
                    BuildHelpURL = BuildHelpURL.Replace("%253F", "?")
                    BuildHelpURL = BuildHelpURL.Replace("%252F", "/")
                    BuildHelpURL = BuildHelpURL.Replace("%253A", ":")
                End If
            End If
        End If
    End Function

    'jrs 2021/11/11 added bWeb parameter
    'jrs 2013/08/29
    Public Function LoadHelpJS(ByVal sCaption As String, ByVal sControl As String, Optional ByVal bWeb As Boolean = False) As String

        'jrs 2025/01/16
        If Not bWeb Then
            If IsConnectedToInternet() Then
                bWeb = True
            End If
        End If

        'jrs 2013/01/18
        Dim sURL As String
        sURL = BuildHelpURL(sCaption, sControl, bWeb)
        If sURL = "" Then
            sURL = "intro/index"
        End If

        'jrs 2019/06/05 sURL = "http://www.du.edu/ifs/help/" & Replace(sURL, "\", "/") & ".html"
        'jrs 2020/05/21
        If StandAloneMode And Not bWeb Then
            sURL = "./help/" & sURL
            sURL = Replace(sURL, "\", "/")
            'jrs 2020/05/19
            Dim sInternalURL As String
            Dim pos As Integer
            pos = InStr(sURL, "#")
            sInternalURL = ""
            If pos > 0 Then
                sInternalURL = Mid(sURL, pos)
                sURL = Replace(sURL, sInternalURL, "")
            End If
            sURL = sURL & ".html" & sInternalURL
        Else
            'jrs 2022/03/03 sURL = "http://www." & Replace(sURL, "\", "/")  'jrs 2020/04/02 & ".html"
            sURL = "https://" & Replace(Replace(sURL, "\", "/"), "pardee.du.edu/wiki/", "pardeewiki.du.edu/index.php?title=")
        End If

        LoadHelpJS = "window.open('" & sURL & "');"
    End Function

