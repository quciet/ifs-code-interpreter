    'jrs 2005/06/27
    Public Sub LoadMenuFiles(ByVal sDir As String, ByRef cswmItem As Coalesys.WebMenu.Item, ByRef cswmGroup1 As Coalesys.WebMenu.Group,
    ByVal sType As String, ByVal BaseSize As Integer, ByVal sAction As String) 'jrs 2005/11/14 added Base Size
        'jrs 2006/11/02
        'sAction: is a parameter that contains ADD or empty, to store in the ID of the menu item, it's used to ADD (as opossed to Open) a scenario
        If Right(sDir, 1) = "\" Then
            sDir = Mid(sDir, 1, Len(sDir) - 1)
        End If

        Dim sRunFile As String
        ' Returns filename with specified extension. If more than one *.ini
        ' file exists, the first file found is returned.
        sRunFile = Dir(sDir + "\*." & sType)
        'jrs 2005/11/14
        Dim currRun
        Dim fs
        fs = CreateObject("Scripting.FileSystemObject")

        Do While (sRunFile <> "")
            'jrs 2005/11/14
            currRun = fs.GetFile(sDir + "\" + sRunFile)
            If UCase(sRunFile) <> "WORKING." & UCase(sType) And UCase(sRunFile) <> "WORKING FILE." & UCase(sType) _
            And UCase(sRunFile) <> "IFSBASE." & UCase(sType) And UCase(sRunFile) <> "IFSBASEHIST." & UCase(sType) Then 'jrs 2005/11/14 added currRun.size = BaseSize Or UCase(sType) <> "RUN"
                cswmItem = cswmGroup1.Items.Add()
                cswmItem.Caption = Mid(sRunFile, 1, InStr(UCase(sRunFile), "." & UCase(sType), CompareMethod.Text) - 1)
                cswmItem.UserData = sDir
                cswmItem.URL = sAction
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop
        'Look for all folders within
        Dim counter As Integer
        counter = -1
        Dim DirList(0) As String

        sRunFile = Dir(sDir + "\*", vbDirectory)

        Do While (sRunFile <> "")
            'jrs 2025/06/09 added code to hide rerun folders And (Not sRunFile.ToLower.Contains("rerun") Or DevelopmentMode) 
            'jrs 2022/04/08 added  And Not sRunFile.Contains(".run.db-shm")
            'jrs 2022/05/18 added  And Not sRunFile.Contains(".run.db-wal")
            'jrs 2024/08/15 added .ToLower so that scenarios that are spelled with Upper cases are also consider in the filter, ex. IFSBASE.RUN.DB-shm
            If Mid(sRunFile, 1, 7) <> "Session" And sRunFile <> "." And sRunFile <> ".." And Not sRunFile.ToLower.Contains(".run.db-shm") _
                 And Not sRunFile.ToLower.Contains(".run.db-wal") And Not sRunFile.ToLower.Contains(".db-journal") And (Not sRunFile.ToLower.Contains("rerun") Or DevelopmentMode) Then
                If (GetAttr(sDir & "\" & sRunFile) And vbDirectory) = vbDirectory Then
                    counter = counter + 1
                    ReDim Preserve DirList(counter)
                    DirList(counter) = sRunFile
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop

        Dim i As Integer
        Dim cswmGroup2 As Coalesys.WebMenu.Group
        For i = 0 To counter
            cswmItem = cswmGroup1.Items.Add()
            cswmItem.Caption = DirList(i)
            cswmGroup2 = cswmItem.AddGroup()
            LoadMenuFiles(sDir + "\" + DirList(i), cswmItem, cswmGroup2, sType, BaseSize, sAction)
            'jrs 2005/08/05
            If cswmGroup2.Items.Count = 0 Then
                cswmGroup1.Items.Remove(DirList(i))
            End If
        Next i
    End Sub

    'jrs 2005/10/31
    Public Function getFileNum(ByVal sVarDisp As String, ByVal vShortSce As Object) As Integer
        Dim st As Integer, en As Integer
        st = InStr(sVarDisp, "[") + 1
        en = InStr(sVarDisp, "]") + 1
        Dim sFileName As String
        If st > 0 And en > st Then
            sFileName = Mid(sVarDisp, st, en - st - 1)
        Else
            sFileName = sVarDisp
        End If
        If IsNumeric(sFileName) Then
            getFileNum = CInt(sFileName)
        Else
            Dim i As Integer
            For i = 0 To UBound(vShortSce)
                If UCase(sFileName) = UCase(vShortSce(i)) Then
                    getFileNum = i
                    Exit Function
                End If
            Next
            getFileNum = -1 'This doesn't mean it's an historic file
        End If
    End Function

    'jrs 2006/04/04 CENTRALIZE DISPLAYS
    'Loads a single column into an array
    Public Sub gLoadForDisplay(ByVal sVar As String, ByRef idxVar As Integer, ByRef sDim1 As String,
    ByVal idxDim1 As Integer, ByRef sDim2 As String, ByVal idxDim2 As Integer, ByRef sDim3 As String,
    ByVal idxDim3 As Integer, ByVal sFileName As String, ByRef idxFile As Integer, ByVal bOpenFile As Boolean,
    ByVal bCloseFile As Boolean, ByRef bGroups As Object, ByVal Factor As Single, ByRef TargetVector As Object,
    ByVal iColPosition As Integer, ByVal iRowPosition As Integer, ByVal iFirstYear As Integer, ByVal iLastYear As Integer,
    ByVal iFirstYearOffSet As Integer, ByVal bSingleDim As Boolean,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef RunFiles As Object, ByRef PutFdrvRun As String,
    ByRef vShortSce As Object, ByRef FileforDisplay As Integer, ByRef FinYear As Object,
    ByRef IFs_MDB2Active As String, ByVal CurrencyVal As Single)
        '1. sVar Variable Name
        '2. idxVar Variable Index
        '3. sDim1 Dimension1 Name
        '4. idxDim1 Dimension1 Index
        '5. sDim2 Dimension2 Name
        '6. idxDim2 Dimension2 Index
        '7. sDim3 Dimension3 Name
        '8. idxDim3 Dimension3 Index
        '9. sFileName should contain the full path of the file
        '10. idxFile File Index within array Runfiles
        '11. bOpenFile is false when the file is already open and there's no need to open it again.
        '12. bCloseFile is false when there's no need to close the file used.
        '13. bGroups is true when using groups in dimension1, eventually will have bGroups1 and bGroups2, if Null we have to find out if using groups or not
        '14. Factor multiplies every value read from sFileName
        '15. TargetVector array where read values are stored
        '16. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '17. iRowPosition is the Row position within the Target vector to store the array. Greater than 1 when History plus Forecast, 1 otherwise.
        '18. iFirstYear, 2000 for forecast, 1960 for History
        '19. iLastYear, 2000 to 2100 for forecast, 1960 to 2000 for history
        '20. iFirstYearOffset, is the difference between iFirstYear and the FirstYear in the Base Case (generally 0)
        '21. bSingleDim is True when using a Single Dimension vector as Target
        '22. bLoadForDisplaySuccess is a flag to indicate that the load for display has been successful.
        '23. myForm is the webpage that is calling this sub routine, used to return after a message
        '24. RunFiles is the array that stores file names
        '25. PutFdrRun is the path to RunFiles
        '26. vShortSce is an array with the short name of the scenario files
        '27. FileforDisplay is the number used to open the run file.
        '28. FinYear is an array that contains the number of values for each column in the target vector
        '29. IFs_MDB2Active is the full path to IFs.mdb
        '30. CurrencyVal is the currency convertion factor               

        bLoadForDisplaySuccess = False
        Dim frm_msg As New frm_Message

        'jrs 2009/01/20
        Dim bTotal1 As Boolean, bTotal2 As Boolean, bTotal3 As Boolean
        Dim VarValTot As Single
        VarValTot = 0

        'Check Variable Name Parameters
        If sVar = "" And idxVar < 1 Then
            frm_msg.LoadMessage("Invalid Variable Parameters")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If sVar = "" Then
            sVar = V(idxVar)
        End If

        If idxVar < 1 Then
            idxVar = IfsVars.Item(sVar).Index
        Else 'jrs 2019/07/11
            If VHidePrivateVars(idxVar) Then
                frm_msg.LoadMessage("Variable not found")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'Check Group Parameters
        If (bGroups Is Nothing) Then
            If VDim1(idxVar) = 1 And sDim1 > "" Then 'jrs 2012/02/06
                idxDim1 = gGetDimIdx(1, sDim1, False, myForm)
                bGroups = (idxDim1 < 1)
                'jrs 2006/12/29 check for second dimension
                If VDim2(idxVar) = 1 And Not bGroups Then
                    idxDim2 = gGetDimIdx(1, sDim2, False, myForm)
                    bGroups = (idxDim2 < 1)
                End If
            Else
                bGroups = False
            End If
        End If

        'Check Dimension Parameters
        If VDim1(idxVar) > 0 Then
            If sDim1 = "" And idxDim1 < 1 Then
                frm_msg.LoadMessage("Invalid Dimension 1 Parameters")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If

            If Not bGroups Or VDim1(idxVar) <> 1 Then
                If sDim1 = "" Then
                    sDim1 = GRPS(VDim1(idxVar), idxDim1)
                End If

                'jrs 2009/01/21
                If idxDim1 > 0 Then
                    If UCase(sDim1) <> UCase(GRPS(VDim1(idxVar), idxDim1)) Then
                        idxDim1 = -1
                    End If
                End If

                If idxDim1 < 1 Then
                    idxDim1 = gGetDimIdx(VDim1(idxVar), sDim1, True, myForm)
                End If
            Else 'if it's a group
                If sDim1 = "" Then
                    sDim1 = GroupNames$(idxDim1)
                End If

                If idxDim1 < 1 Then
                    idxDim1 = gGetGroupIdx(sDim1, False, myForm) 'jrs 2006/12/28 change to false to check in case 2 dim with reg and groups
                    'jrs 2006/12/28 if 2 dimensions the second one could be the group
                    If idxDim1 = -1 Then
                        If VDim2(idxVar) = 1 Then
                            idxDim1 = gGetDimIdx(VDim1(idxVar), sDim1, True, myForm)
                        Else
                            frm_msg.LoadMessage("Group not Found")
                            Support.FormManager.StateStore(myForm)
                            Support.FormManager.Show(myForm, "frm_Message.aspx")
                        End If
                    End If

                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim1 = -1 And UCase(sDim1) = "TOTAL" And VDim1(idxVar) > 1 Then
                bTotal1 = True
                idxDim1 = 1
            End If

            If idxDim1 = -1 Then
                Exit Sub
            End If
        End If

        If VDim2(idxVar) > 0 Then
            If sDim2 = "" And idxDim2 < 1 Then
                frm_msg.LoadMessage("Invalid Dimension 2 Parameters")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If

            If Not bGroups Or VDim2(idxVar) <> 1 Then
                If sDim2 = "" Then
                    sDim2 = GRPS(VDim2(idxVar), idxDim2)
                End If

                'jrs 2009/01/21
                If idxDim2 > 0 Then
                    If UCase(sDim2) <> UCase(GRPS(VDim2(idxVar), idxDim2)) Then
                        idxDim2 = -1
                    End If
                End If

                If idxDim2 < 1 Then
                    idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                End If
            Else 'if it's a group
                If sDim2 = "" Then
                    sDim2 = GroupNames$(idxDim2)
                End If

                If idxDim2 < 1 Then
                    idxDim2 = gGetGroupIdx(sDim2, False, myForm) 'jrs 2006/12/28 changed to false to check for comb of groups and regs
                    'jrs 2006/12/28 if 2 dimensions the first one could be the group
                    If idxDim2 = -1 Then
                        idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                    End If
                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim2 = -1 And UCase(sDim2) = "TOTAL" And VDim2(idxVar) > 1 Then
                bTotal2 = True
                idxDim2 = 1
            End If

            If idxDim2 = -1 Then
                Exit Sub
            End If
        End If

        If VDim3(idxVar) > 0 Then
            If sDim3 = "" And idxDim3 < 1 Then
                MsgBox("Invalid Dimension 3 Parameters", vbCritical, "Load for Display")
                Exit Sub
            End If

            If Not bGroups Or VDim3(idxVar) <> 1 Then
                If sDim3 = "" Then
                    sDim3 = GRPS(VDim3(idxVar), idxDim3)
                End If

                'jrs 2009/01/21
                If idxDim3 > 0 Then
                    If UCase(sDim3) <> UCase(GRPS(VDim3(idxVar), idxDim3)) Then
                        idxDim3 = -1
                    End If
                End If

                If idxDim3 < 1 Then
                    idxDim3 = gGetDimIdx(VDim3(idxVar), sDim3, True, myForm)
                End If
            Else 'if it's a group
                If sDim3 = "" Then
                    sDim3 = GroupNames$(idxDim3)
                End If

                If idxDim3 < 1 Then
                    idxDim3 = gGetGroupIdx(sDim3, True, myForm)
                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim3 = -1 And UCase(sDim3) = "TOTAL" And VDim3(idxVar) > 1 Then
                bTotal3 = True
                idxDim3 = 1
            End If

            If idxDim3 = -1 Then
                Exit Sub
            End If
        End If

        'jrs 2006/08/29 I removed it, because in VarSelect you could be using groups and call a variable like WGDP
        'and this would change the flag to false, incorrectly
        ''Check Grouping Parameters
        'If bGroups And VDim1(idxVar) <> 1 Then
        '    bGroups = False
        'End If

        'Check File Parameters
        If sFileName = "" And idxFile < 0 Then
            MsgBox("Invalid File Parameters", vbCritical, "Load for Display")
            Exit Sub
        End If

        If sFileName = "" Then
            If idxFile > 0 Then
                If idxFile > UBound(RunFiles) Then
                    frm_msg.LoadMessage("Invalid File Parameters")
                    Support.FormManager.StateStore(myForm)
                    Support.FormManager.Show(myForm, "frm_Message.aspx")
                End If
                sFileName = RunFiles(idxFile)
                sFileName = sFileName.Replace(".db", "")
                sFileName = sFileName.Replace(".DB", "")
            Else
                sFileName = PutFdrvRun + "Working.run"
            End If
        End If
        If idxFile < 0 Then
            idxFile = getFileNum(sFileName, vShortSce)
        End If
        If idxFile = -1 Then
            frm_msg.LoadMessage("Invalid File Name")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        'Check Target Parameters
        If iLastYear - iFirstYear + 1 > UBound(TargetVector, 1) Then
            frm_msg.LoadMessage("Invalid Year Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If Not bSingleDim Then 'doubly dimension array
            If iColPosition > UBound(TargetVector, 2) Then
                frm_msg.LoadMessage("Invalid Initial Column")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'Open File if necessary
        Dim fNum As Integer
        If bOpenFile Then
            fNum = FreeFile()
            FileOpen(fNum, sFileName, OpenMode.Binary, OpenAccess.Read, OpenShare.Shared)
        Else
            fNum = FileforDisplay
        End If

        'jrs 2008/10/17 testing efficient ways of reading files
        'Dim value As Byte() = My.Computer.FileSystem.ReadAllBytes(sFileName)

        'Low Common Year
        Dim VLN As Object, Number As Single, RECORD As Object, VarVal As Single
        VLN = VarPoint(PosModYear)
        RECORD = (VLN) * 4 - 3
        FileGet(fNum, Number, RECORD)
        VarVal = Number!
        'jrs 2009/01/14
        If VarVal > 0 Then
            'jrs 2017/06/21
            If VarVal > iLastYear Then
                VarVal = iLastYear
            End If
            FinYear(iColPosition) = VarVal - (iFirstYear - iFirstYearOffSet) + 1
        Else
            FinYear(iColPosition) = 0
        End If

        'Pointer Calculation 2006/04/06
        Dim VPTR As Object, VarPointer As Object
        Dim VarPointerVADD As Object 'jrs 2014/09/25
        VPTR = 0
        If VDim1(idxVar) > 0 Then
            VPTR = idxDim1
        Else
            VPTR = 1
        End If
        If VDim2(idxVar) > 0 Then
            VPTR = VPTR + ((idxDim2 - 1) * (MAXCOM(VDim1(idxVar)) - 1))  'final pointer shift calculation
        End If
        If VDim3(idxVar) > 0 Then
            VPTR = VPTR + ((idxDim3 - 1) * (MAXCOM(VDim1(idxVar)) - 1) * (MAXCOM(VDim2(idxVar)) - 1))  'final pointer shift calculation
        End If

        'Get Variable Pointer
        '--------------------
        VarPointer = VarPoint(idxVar) + VPTR - 1
        'jrs 2014/08/01
        If bGroups Then
            VarPointerVADD = VarPoint(IfsVars.Item("VADD").Index)
        Else
            VarPointerVADD = VarPoint(IfsVars.Item("VADD").Index) + idxDim1 - 1
        End If

        'Load Group Members
        '------------------
        Dim AgPoint As Long, sAgRule As String
        Dim Varval2 As Object
        Dim gCountGroupMembers As Integer
        Dim gGroupMembrs() As String, gGroupMembersPtrs() As Integer, gGroupMemberWeights() As Single
        'jrs 2006/09/27
        Dim sAgVar As String, iAgIdx As Integer

        'jrs 2006/08/29 added and VDim1(idxVar) = 1
        If bGroups And VDim1(idxVar) = 1 Then
            sAgRule = VAggregation(idxVar)
            'jrs 2006/09/27
            sAgVar = IFsAggRules.Item(sAgRule).ForecastVar
            If sAgVar > "" Then
                iAgIdx = IfsVars.Item(sAgVar).Index
                If iAgIdx > 0 Then
                    AgPoint = VarPoint(iAgIdx)
                End If
            End If
            'jrs 2006/09/06 groups by groups, no groups in dim3.
            If VDim2(idxVar) = 1 Then
                Dim Ctr2 As Integer, Ctr1 As Integer
                Dim RegPtrs2, RegPtrs1
                'load group 2
                gLoadGroupMembers(sDim2, idxVar, 1, 1, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
                'jrs 2006/12/28
                If gCountGroupMembers = 0 Then
                    gCountGroupMembers = 1
                    ReDim gGroupMemberWeights(1)
                    gGroupMemberWeights(1) = idxDim2 - 1
                End If
                'save counter
                Ctr2 = gCountGroupMembers
                'save region pointers
                RegPtrs2 = gGroupMemberWeights
                'load group 1
                gLoadGroupMembers(sDim1, idxVar, 1, 1, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
                'jrs 2006/12/28
                If gCountGroupMembers = 0 Then
                    gCountGroupMembers = 1
                    ReDim gGroupMemberWeights(1)
                    gGroupMemberWeights(1) = idxDim1 - 1
                End If
                'save counter
                Ctr1 = gCountGroupMembers
                'save region pointers
                RegPtrs1 = gGroupMemberWeights
                'change counter
                gCountGroupMembers = Ctr1 * Ctr2
                'change pointers
                ReDim gGroupMembersPtrs(gCountGroupMembers)
                Dim ipt1 As Integer, ipt2 As Integer
                For ipt1 = 1 To Ctr1
                    For ipt2 = 1 To Ctr2
                        If VDim3(idxVar) = 0 Then
                            gGroupMembersPtrs((ipt1 - 1) * Ctr2 + ipt2) = VarPoint(idxVar) + RegPtrs2(ipt2) * (MAXCOM(1) - 1) +
                            RegPtrs1(ipt1)
                        Else
                            gGroupMembersPtrs((ipt1 - 1) * Ctr2 + ipt2) = VarPoint(idxVar) + RegPtrs2(ipt2) * (MAXCOM(1) - 1) +
                            RegPtrs1(ipt1) + (idxDim3 - 1) * (MAXCOM(1) - 1) * (MAXCOM(VDim2(idxVar)) - 1)
                        End If
                    Next ipt2
                Next ipt1
            Else
                gLoadGroupMembers(sDim1, idxVar, idxDim2, idxDim3, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
            End If
        End If

        'Get Currency Factor
        Dim CurrencyFct As Single
        If VCurrency(idxVar) Then
            CurrencyFct = gGetCurrencyFct(idxVar, CurrencyVal)
        Else
            CurrencyFct = 1
        End If

        'Load Target Vector
        '------------------
        Dim yr As Integer, rr As Integer
        Dim Sumplot As Object, SumWeight As Object
        'jrs 2014/09/25
        Dim SumWeight2 As Object = 0
        Dim SVarVals(0, 0) As Object, SVarVals2() As Object
        Dim TempVarVal As Object, SVarValBySec() As Object

        Dim MinValue As Single, MaxValue As Single
        For yr = 1 + iFirstYearOffSet To iLastYear - iFirstYear + 1 + iFirstYearOffSet
            If yr > FinYear(iColPosition) Then Exit For 'Beyond run year
            'jrs 2020/03/23 the line above would not work when checking historical run
            'jrs 2019/08/08
            'If yr > iLastYear - FirstYearForecast + 1 Then Exit For

            'jrs 2009/01/20 Total
            Do While True

                If Not bGroups Or VDim1(idxVar) <> 1 Then 'jrs 2006/08/29 added Or VDim1(idxVar) <> 1
                    RECORD = CLng((VarPointer + ((yr - 1) * filen)) * 4) - 3
                    FileGet(fNum, Number, RECORD)
                    VarVal = Number!
                Else
                    'jrs 2014/08/07
                    If sVar = "TEFF" Then
                        If ((bTotal2 And idxDim2 = 1) Or Not bTotal2) And yr = 1 + iFirstYearOffSet Then
                            ReDim SVarVals(gCountGroupMembers, NSec)
                            ReDim SVarValBySec(NSec)
                        End If
                    End If

                    MinValue = 1000000000
                    MaxValue = -100000000
                    Sumplot = 0
                    SumWeight = 0
                    For rr = 1 To gCountGroupMembers
                        VarPointer = gGroupMembersPtrs(rr)
                        RECORD = CLng((VarPointer + ((yr - 1) * filen)) * 4) - 3
                        FileGet(fNum, Number, RECORD)
                        VarVal = Number!
                        'jrs 2006/09/27 generalization of Agg rule If sAgRule = "GDP" Or sAgRule = "POP" Then
                        If sAgVar > "" Then
                            'jrs 2014/08/07
                            If sVar = "TEFF" Then
                                If yr = 1 + iFirstYearOffSet Then
                                    SVarVals(rr, idxDim2) = VarVal
                                Else
                                    TempVarVal = VarVal
                                    VarVal = VarVal / SVarVals(rr, idxDim2) - 1
                                    SVarVals(rr, idxDim2) = TempVarVal
                                End If
                            End If

                            VarPointer = AgPoint + gGroupMemberWeights(rr)
                            If VDim2(iAgIdx) > 0 Then
                                Dim iAgidxDim2 As Integer
                                'jrs 2014/08/05
                                If IFsAggRules.Item(sAgRule).Dim2 > "" Then
                                    iAgidxDim2 = gGetDimIdx(VDim2(iAgIdx), IFsAggRules.Item(sAgRule).Dim2, True, myForm)
                                Else
                                    iAgidxDim2 = idxDim2
                                End If
                                VarPointer = VarPointer + ((iAgidxDim2 - 1) * (MAXCOM(VDim1(iAgIdx)) - 1))  'final pointer shift calculation
                            End If
                            If VDim3(iAgIdx) > 0 Then
                                Dim iAgidxDim3 As Integer
                                'mti 2021/12/02 start
                                'iAgidxDim3 = gGetDimIdx(VDim3(iAgIdx), IFsAggRules.Item(sAgRule).Dim3, True, myForm)
                                If IFsAggRules.Item(sAgRule).Dim3 > "" Then
                                    iAgidxDim3 = gGetDimIdx(VDim3(iAgIdx), IFsAggRules.Item(sAgRule).Dim3, True, myForm)
                                Else
                                    iAgidxDim3 = idxDim3
                                End If
                                'mti 2021/12/02 End
                                VarPointer = VarPointer + ((idxDim3 - 1) * (MAXCOM(VDim1(iAgIdx)) - 1) * (MAXCOM(VDim2(iAgIdx)) - 1))  'final pointer shift calculation
                            End If
                            RECORD = CLng((CLng(VarPointer) + ((yr - 1) * filen)) * 4) - 3
                            FileGet(fNum, Number, RECORD)
                            Varval2 = Number!
                            SumWeight = SumWeight + Varval2
                            Sumplot = Sumplot + VarVal * Varval2
                        Else
                            Sumplot = Sumplot + VarVal
                        End If
                        If sAgRule = "MIN" And VarVal < MinValue Then MinValue = VarVal
                        If sAgRule = "MAX" And VarVal > MaxValue Then MaxValue = VarVal
                    Next rr
                    Select Case sAgRule
                        Case "SUM"
                            VarVal = Sumplot
                        Case "AVG"
                            VarVal = Sumplot / gCountGroupMembers
                        Case "MIN"
                            VarVal = MinValue
                        Case "MAX"
                            VarVal = MaxValue
                        Case Else 'jrs 2006/09/27 "GDP", "POP"
                            If sAgVar > "" Then
                                VarVal = Sumplot / AMAX(0.001, SumWeight)
                                'jrs 2014/08/07
                                If sVar = "TEFF" Then
                                    If yr > 1 + iFirstYearOffSet Then
                                        VarVal = SVarValBySec(idxDim2) * (1 + VarVal)
                                    End If
                                    SVarValBySec(idxDim2) = VarVal
                                End If
                            End If
                    End Select
                End If

                'jrs 2009/01/20
                If Not (bTotal1 Or bTotal2 Or bTotal3) Then
                    Exit Do
                Else
                    'jrs 2014/08/01 Adding other aggregation rules for Total, ex. TEFF(R, Sector), using GDP, with this dimension means using VADD
                    If bTotal2 And VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 Then
                        aggregateWVADD(VarVal, SumWeight2, idxDim2, VarPointerVADD, yr, fNum, bGroups, idxVar, SVarVals2, gCountGroupMembers, gGroupMemberWeights)
                    End If

                    'Sum across other dimensions
                    VarValTot = VarValTot + VarVal
                    'advance dimension index
                    Select Case True
                        Case bTotal1
                            idxDim1 = idxDim1 + 1
                            If idxDim1 = MAXCOM(VDim1(idxVar)) Then
                                idxDim1 = 1
                                If bTotal2 Then
                                    idxDim2 = idxDim2 + 1
                                    If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                                        idxDim2 = 1
                                        If bTotal3 Then
                                            idxDim3 = idxDim3 + 1
                                            If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                                idxDim3 = 1
                                                VarVal = VarValTot
                                                VarValTot = 0
                                                RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                                Exit Do
                                            End If
                                        Else
                                            VarVal = VarValTot
                                            VarValTot = 0
                                            RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                            Exit Do
                                        End If
                                    End If
                                Else
                                    VarVal = VarValTot
                                    VarValTot = 0
                                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                    Exit Do
                                End If
                            End If
                        Case bTotal2
                            idxDim2 = idxDim2 + 1
                            If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                                idxDim2 = 1
                                If bTotal3 Then
                                    idxDim3 = idxDim3 + 1
                                    If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                        idxDim3 = 1
                                        VarVal = VarValTot
                                        VarValTot = 0
                                        RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                        Exit Do
                                    End If
                                Else
                                    VarVal = VarValTot
                                    VarValTot = 0
                                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                    Exit Do
                                End If
                            End If
                        Case bTotal3
                            idxDim3 = idxDim3 + 1
                            If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                idxDim3 = 1
                                VarVal = VarValTot
                                VarValTot = 0
                                RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                Exit Do
                            End If
                    End Select
                    'recompute pointers
                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                End If
            Loop 'jrs 2009/01/20

            'jrs 2014/03/07
            'Check if aggregation rule is not sum
            If bTotal1 And VAggregation(idxVar) <> "SUM" Then
                VarVal = VarVal / (MAXCOM(VDim1(idxVar)) - 1)
            End If
            'JRS 2014/09/17
            If bTotal2 And (VAggregation(idxVar) <> "SUM" And VAggregation2(idxVar) <> "SUM") Then 'JRS 2014/09/25
                'jrs 2014/08/01
                If VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 And SumWeight2 > 0 Then
                    VarVal = VarVal / SumWeight2
                    SumWeight2 = 0
                    'jrs 2014/08/07
                    If V(idxVar) = "TEFF" And yr > 1 Then
                        If bSingleDim Then 'single dimension array
                            VarVal = TargetVector(yr + iRowPosition - 2 - iFirstYearOffSet) * (1 + VarVal) / Factor * CurrencyFct
                        Else
                            VarVal = TargetVector(yr + iRowPosition - 2 - iFirstYearOffSet, iColPosition) * (1 + VarVal) / Factor * CurrencyFct
                        End If
                    End If
                Else
                    VarVal = VarVal / (MAXCOM(VDim2(idxVar)) - 1)
                End If
            End If

            'Apply Currency Convertion
            VarVal = VarVal / CurrencyFct
            'Store Value
            If bSingleDim Then 'single dimension array
                TargetVector(yr + iRowPosition - 1 - iFirstYearOffSet) = VarVal
            Else
                TargetVector(yr + iRowPosition - 1 - iFirstYearOffSet, iColPosition) = VarVal
            End If
        Next yr

        'Close file if necessary
        If bCloseFile Then
            FileClose(fNum)
        Else
            FileforDisplay = fNum
        End If

        'Finish Successfully
        bLoadForDisplaySuccess = True
    End Sub

    'jrs 2021/05/31 added bIncompatibleRegionFile
    'jrs 2019/06/28 To be used with new file formats
    'Loads a single column into an array
    Public Sub gLoadForDisplayNET(ByVal sVar As String, ByRef idxVar As Integer, ByRef sDim1 As String,
    ByVal idxDim1 As Integer, ByRef sDim2 As String, ByVal idxDim2 As Integer, ByRef sDim3 As String,
    ByVal idxDim3 As Integer, ByVal sFileName As String, ByRef idxFile As Integer, ByVal bOpenFile As Boolean,
    ByVal bCloseFile As Boolean, ByRef bGroups As Object, ByVal Factor As Single, ByRef TargetVector As Object,
    ByVal iColPosition As Integer, ByVal iRowPosition As Integer, ByVal iFirstYear As Integer, ByVal iLastYear As Integer,
    ByVal iFirstYearOffSet As Integer, ByVal bSingleDim As Boolean,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef RunFiles As Object, ByRef PutFdrvRun As String,
    ByRef vShortSce As Object, ByRef FinYear As Object, ByRef IFs_MDB2Active As String, ByVal CurrencyVal As Single,
    Optional ByRef FileforDisplay As IStorage = Nothing, Optional ByRef dfVar As IDataframe = Nothing,
    Optional bIncompatibleRegionFile As Boolean = False,
    Optional IncompatibleRegionIdx As Integer = -1)
        '1. sVar Variable Name
        '2. idxVar Variable Index
        '3. sDim1 Dimension1 Name
        '4. idxDim1 Dimension1 Index
        '5. sDim2 Dimension2 Name
        '6. idxDim2 Dimension2 Index
        '7. sDim3 Dimension3 Name
        '8. idxDim3 Dimension3 Index
        '9. sFileName should contain the full path of the file
        '10. idxFile File Index within array Runfiles
        '11. bOpenFile is false when the file is already open and there's no need to open it again.
        '12. bCloseFile is false when there's no need to close the file used.
        '13. bGroups is true when using groups in dimension1, eventually will have bGroups1 and bGroups2, if Null we have to find out if using groups or not
        '14. Factor multiplies every value read from sFileName
        '15. TargetVector array where read values are stored
        '16. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '17. iRowPosition is the Row position within the Target vector to store the array. Greater than 1 when History plus Forecast, 1 otherwise.
        '18. iFirstYear, 2000 for forecast, 1960 for History
        '19. iLastYear, 2000 to 2100 for forecast, 1960 to 2000 for history
        '20. iFirstYearOffset, is the difference between iFirstYear and the FirstYear in the Base Case (generally 0)
        '21. bSingleDim is True when using a Single Dimension vector as Target
        '22. bLoadForDisplaySuccess is a flag to indicate that the load for display has been successful.
        '23. myForm is the webpage that is calling this sub routine, used to return after a message
        '24. RunFiles is the array that stores file names
        '25. PutFdrRun is the path to RunFiles
        '26. vShortSce is an array with the short name of the scenario files
        '27. FileforDisplay is the number used to open the run file.
        '28. FinYear is an array that contains the number of values for each column in the target vector
        '29. IFs_MDB2Active is the full path to IFs.mdb
        '30. CurrencyVal is the currency convertion factor               

        _logger.Debug("gLoadForDisplayNET start")
        Debug.WriteLine("gLoadForDisplayNET start")

        bLoadForDisplaySuccess = False

        'jam 2026/05/15 Defensive OOM wrapper for large .run.db loads (Dataframe.cs:76 hotspot).
        ' The original 9 Exit Sub statements below still work inside this Try block.
        Try

        Dim frm_msg As New frm_Message

        'jrs 2009/01/20
        Dim bTotal1 As Boolean, bTotal2 As Boolean, bTotal3 As Boolean
        Dim VarValTot As Single
        VarValTot = 0

        'Check Variable Name Parameters
        If sVar = "" And idxVar < 1 Then
            frm_msg.LoadMessage("Invalid Variable Parameters")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If sVar = "" Then
            sVar = V(idxVar)
        End If

        If idxVar < 1 Then
            idxVar = IfsVars.Item(sVar).Index
        Else 'jrs 2019/07/11
            If VHidePrivateVars(idxVar) Then
                frm_msg.LoadMessage("Variable not found")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'jrs 2025/02/12
        Dim bGroups1, bGroups2 As Boolean
        bGroups1 = bGroups
        bGroups2 = bGroups
        'jrs 2025/07/09
        Dim bNewCountry As Boolean = False

        'Check Group Parameters
        If (bGroups Is Nothing) Then
            If VDim1(idxVar) = 1 And sDim1 > "" Then 'jrs 2012/02/06
                If bIncompatibleRegionFile Then
                    'jrs 2025/10/06 idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1, False, myForm)
                    idxDim1 = gGetDimIdx(IncompatibleRegionIdx, sDim1, False, myForm)
                    'jrs 2025/07/09
                    'Need to check if this is a new country
                    If idxDim1 < 1 Then
                        bNewCountry = (gGetDimIdx(1, sDim1, False, myForm) > 0)
                        If bNewCountry Then
                            bGroups = False
                        End If
                    End If
                Else
                    idxDim1 = gGetDimIdx(1, sDim1, False, myForm)
                End If
                'jrs 2025/07/09
                If Not bNewCountry Then
                    bGroups = (idxDim1 < 1)
                    'jrs 2025/02/12
                    bGroups1 = bGroups
                    bGroups2 = bGroups
                    'jrs 2006/12/29 check for second dimension
                    If VDim2(idxVar) = 1 And Not bGroups Then
                        idxDim2 = gGetDimIdx(1, sDim2, False, myForm)
                        bGroups = (idxDim2 < 1)
                        'jrs 2025/02/12
                        bGroups2 = bGroups
                    End If
                End If
            Else
                bGroups = False
                'jrs 2025/02/12
                bGroups1 = bGroups
                bGroups2 = bGroups
            End If
        ElseIf bGroups = False Then 'jrs 2022/06/01
            'Needed for incompatible files
            If VDim1(idxVar) = 1 And sDim1 > "" Then
                If bIncompatibleRegionFile Then
                    'jrs 2025/10/06 idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1, False, myForm)
                    idxDim1 = gGetDimIdx(IncompatibleRegionIdx, sDim1, False, myForm)
                End If
            End If
        End If


        'Check Dimension Parameters
        If VDim1(idxVar) > 0 Then
            If sDim1 = "" And idxDim1 < 1 Then
                frm_msg.LoadMessage("Invalid Dimension 1 Parameters")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If

            If Not bGroups Or VDim1(idxVar) <> 1 Then
                If sDim1 = "" Then
                    'jrs 2021/05/31
                    If VDim1(idxVar) = 1 And bIncompatibleRegionFile Then
                        'jrs 2025/10/06 sDim1 = GRPS(UBound(GRPS, 1), idxDim1)
                        sDim1 = GRPS(IncompatibleRegionIdx, idxDim1)
                    Else
                        sDim1 = GRPS(VDim1(idxVar), idxDim1)
                    End If
                End If

                'jrs 2009/01/21
                If idxDim1 > 0 Then
                    If UCase(sDim1) <> UCase(GRPS(VDim1(idxVar), idxDim1)) Then
                        'jrs 2021/05/31
                        'jrs 2025/10/06 If Not (VDim1(idxVar) = 1 And bIncompatibleRegionFile) OrElse (UCase(sDim1) <> UCase(GRPS(UBound(GRPS, 1), idxDim1))) Then
                        If Not (VDim1(idxVar) = 1 And bIncompatibleRegionFile) OrElse (UCase(sDim1) <> UCase(GRPS(IncompatibleRegionIdx, idxDim1))) Then
                            idxDim1 = -1
                        End If
                    End If
                End If

                If idxDim1 < 1 Then
                    'jrs 2021/05/31
                    If VDim1(idxVar) = 1 And bIncompatibleRegionFile Then
                        'jrs 2022/03/11 
                        'idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1, True, myForm)
                        Dim sDim1Alias As String = sDim1
                        'jrs 2025/10/06 idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1Alias, False, myForm)
                        idxDim1 = gGetDimIdx(IncompatibleRegionIdx, sDim1Alias, False, myForm)
                        'jrs 2022/03/16
                        If idxDim1 < 0 Then
                            'Need to read from all possible aliases to current current country name, not implemented yet
                            SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM [Country Translation Long] WHERE Country = """ & sDim1 & """",
                            "", valtbl)
                            Dim idx As Integer = 0
                            'jrs 2022/06/15
                            If Not IsNothing(valtbl) Then
                                Do While idx < valtbl.Rows.Count And idxDim1 < 0
                                    'jrs 2023/04/24
                                    If Not IsDBNull(valtbl.Rows(idx).Item("Alias")) Then
                                        sDim1Alias = valtbl.Rows(idx).Item("Alias")
                                        'jrs 2025/10/06 idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1Alias, False, myForm)
                                        idxDim1 = gGetDimIdx(IncompatibleRegionIdx, sDim1Alias, False, myForm)
                                    End If
                                    idx = idx + 1
                                Loop
                            End If
                        End If
                    Else
                        idxDim1 = gGetDimIdx(VDim1(idxVar), sDim1, True, myForm)
                    End If
                End If
            Else 'if it's a group
                If sDim1 = "" Then
                    sDim1 = GroupNames$(idxDim1)
                End If

                If idxDim1 < 1 Then
                    idxDim1 = gGetGroupIdx(sDim1, False, myForm) 'jrs 2006/12/28 change to false to check in case 2 dim with reg and groups
                    'jrs 2006/12/28 if 2 dimensions the second one could be the group
                    If idxDim1 = -1 Then
                        If VDim2(idxVar) = 1 Then
                            idxDim1 = gGetDimIdx(VDim1(idxVar), sDim1, True, myForm)
                        Else
                            frm_msg.LoadMessage("Group not Found")
                            Support.FormManager.StateStore(myForm)
                            Support.FormManager.Show(myForm, "frm_Message.aspx")
                        End If
                    End If

                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim1 = -1 And UCase(sDim1) = "TOTAL" And VDim1(idxVar) > 1 Then
                bTotal1 = True
                idxDim1 = 1
            End If

            If idxDim1 = -1 Then
                Exit Sub
            End If
        End If

        If VDim2(idxVar) > 0 Then
            If sDim2 = "" And idxDim2 < 1 Then
                frm_msg.LoadMessage("Invalid Dimension 2 Parameters")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If

            If Not bGroups Or VDim2(idxVar) <> 1 Then
                If sDim2 = "" Then
                    sDim2 = GRPS(VDim2(idxVar), idxDim2)
                End If

                'jrs 2009/01/21
                If idxDim2 > 0 Then
                    If UCase(sDim2) <> UCase(GRPS(VDim2(idxVar), idxDim2)) Then
                        idxDim2 = -1
                    End If
                End If

                'jrs 2020/07/27
                If VDim2(idxVar) = 1 Then
                    'check if it's not a group, and the first one was country
                    idxDim2 = gGetGroupIdx(sDim2, False, myForm)
                End If

                If idxDim2 < 1 Then
                    idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                End If
            Else 'if it's a group
                If sDim2 = "" Then
                    sDim2 = GroupNames$(idxDim2)
                End If

                If idxDim2 < 1 Then
                    idxDim2 = gGetGroupIdx(sDim2, False, myForm) 'jrs 2006/12/28 changed to false to check for comb of groups and regs
                    'jrs 2006/12/28 if 2 dimensions the first one could be the group
                    If idxDim2 = -1 Then
                        idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                    End If
                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim2 = -1 And UCase(sDim2) = "TOTAL" And VDim2(idxVar) > 1 Then
                bTotal2 = True
                idxDim2 = 1
            End If

            If idxDim2 = -1 Then
                Exit Sub
            End If
        End If

        If VDim3(idxVar) > 0 Then
            If sDim3 = "" And idxDim3 < 1 Then
                MsgBox("Invalid Dimension 3 Parameters", vbCritical, "Load for Display")
                Exit Sub
            End If

            If Not bGroups Or VDim3(idxVar) <> 1 Then
                If sDim3 = "" Then
                    sDim3 = GRPS(VDim3(idxVar), idxDim3)
                End If

                'jrs 2009/01/21
                If idxDim3 > 0 Then
                    If UCase(sDim3) <> UCase(GRPS(VDim3(idxVar), idxDim3)) Then
                        idxDim3 = -1
                    End If
                End If

                If idxDim3 < 1 Then
                    idxDim3 = gGetDimIdx(VDim3(idxVar), sDim3, True, myForm)
                End If
            Else 'if it's a group
                If sDim3 = "" Then
                    sDim3 = GroupNames$(idxDim3)
                End If

                If idxDim3 < 1 Then
                    idxDim3 = gGetGroupIdx(sDim3, True, myForm)
                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim3 = -1 And UCase(sDim3) = "TOTAL" And VDim3(idxVar) > 1 Then
                bTotal3 = True
                idxDim3 = 1
            End If

            If idxDim3 = -1 Then
                Exit Sub
            End If
        End If

        'jrs 2006/08/29 I removed it, because in VarSelect you could be using groups and call a variable like WGDP
        'and this would change the flag to false, incorrectly
        ''Check Grouping Parameters
        'If bGroups And VDim1(idxVar) <> 1 Then
        '    bGroups = False
        'End If

        'Check File Parameters
        'jrs 2019/06/28
        'sFileName = PutFdrvRun + "Working2.run"
        If sFileName = "" And idxFile < 0 Then
            MsgBox("Invalid File Parameters", vbCritical, "Load for Display")
            Exit Sub
        End If

        If sFileName = "" Then
            If idxFile > 0 Then
                If idxFile > UBound(RunFiles) Then
                    frm_msg.LoadMessage("Invalid File Parameters")
                    Support.FormManager.StateStore(myForm)
                    Support.FormManager.Show(myForm, "frm_Message.aspx")
                End If
                'jrs 2021/02/24
                sFileName = RunFiles(idxFile)
            Else
                sFileName = PutFdrvRun + "Working.run.db"
            End If
        End If

        If idxFile < 0 Then
            idxFile = getFileNum(sFileName, vShortSce)
        End If
        If idxFile = -1 Then
            frm_msg.LoadMessage("Invalid File Name")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        'Check Target Parameters
        If iLastYear - iFirstYear + 1 > UBound(TargetVector, 1) Then
            frm_msg.LoadMessage("Invalid Year Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If Not bSingleDim Then 'doubly dimension array
            If iColPosition > UBound(TargetVector, 2) Then
                frm_msg.LoadMessage("Invalid Initial Column")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'jrs 2019/06/28
        Dim working As IStorage
        Dim df As IDataframe

        'Open File if necessary
        If bOpenFile Or (FileforDisplay Is Nothing) Then 'jrs 2020/06/02 added or File is Nothing
            'Dim services As IServiceProvider
            'services = New ServiceCollection() _
            '.AddScoped(Of IContextService, ContextService)() _
            '.AddScoped(Of IStorageService, StorageService)() _
            '.AddScoped(Of IForecastService, ForecastService)() _
            '.BuildServiceProvider()

            'Dim storageSvc As IStorageService = services.GetService(Of IStorageService)()
            Dim sFolder As String = PutFdrvRun
            If PutFdrvRun.Contains("Session") Then
                Dim SessionFolder As String
                Dim pos As Short
                pos = PutFdrvRun.IndexOf("Session")
                SessionFolder = PutFdrvRun.Substring(pos)
                sFolder = sFolder.Replace(SessionFolder, "")
            End If

            Debug.WriteLine("gLoadForDisplayNET " + sFileName)

            Dim storageSvc As IStorageService = New StorageService(sFileName)
            'jrs 2024/03/08
            'storageSvc.DisableMigration()
            working = storageSvc.Open()
            _logger.Debug("gLoadForDisplayNET LoadDataFrame start " + sVar)
            df = working.LoadDataframe(sVar)
            'jrs 2026/01/23
            If df Is Nothing Then
                Exit Sub
            End If
            _logger.Debug("gLoadForDisplayNET LoadDataFrame end")
            dfVar = df
        Else
            working = FileforDisplay
            If dfVar Is Nothing OrElse dfVar.Variable.Name <> sVar Then
                _logger.Debug("gLoadForDisplayNET LoadDataFrame start " + sVar + " FileforDisplay")
                df = working.LoadDataframe(sVar)
                _logger.Debug("gLoadForDisplayNET LoadDataFrame end")
                dfVar = df
            Else
                df = dfVar
            End If
        End If
        'jrs 2025/10/06
        If df Is Nothing Then Exit Sub

        'jrs 2008/10/17 testing efficient ways of reading files
        'Dim value As Byte() = My.Computer.FileSystem.ReadAllBytes(sFileName)
        Debug.WriteLine("gLoadForDisplayNET after loadDataFrame")

        Dim DimCount As Integer = 1
        If df.Dimensions.Count > 1 Then
            DimCount = DimCount * df.Dimensions(1).Buckets.Count
            'jrs 2025/07/09
            If Not bIncompatibleRegionFile Then
                'Double Checking for formulas
                If VDim1(idxVar) = 1 Then
                    If DimCount <> NR Then
                        bIncompatibleRegionFile = True
                        'jrs 2025/10/06 check every possible Region Set
                        For iRegSetIdx = 1 To ExtraRegionSetsLoaded
                            'Need to Redo DimIdx if not doing groups
                            If Not bGroups Then
                                If VDim1(idxVar) = 1 Then
                                    'jrs 2025/10/06 If UCase(sDim1) <> UCase(GRPS(UBound(GRPS, 1), idxDim1)) Then
                                    If UCase(sDim1) <> UCase(GRPS(UBound(GRPS, 1) - iRegSetIdx, idxDim1)) Then
                                        'Let's find it again
                                        Dim sDim1Alias As String = sDim1
                                        'jrs 2025/10/06 idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1Alias, False, myForm)
                                        idxDim1 = gGetDimIdx(UBound(GRPS, 1) - iRegSetIdx, sDim1Alias, False, myForm)
                                        If idxDim1 < 0 Then
                                            'Need to read from all possible aliases to current current country name, not implemented yet
                                            SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM [Country Translation Long] WHERE Country = """ & sDim1 & """",
                                        "", valtbl)
                                            Dim idx As Integer = 0
                                            If Not IsNothing(valtbl) Then
                                                Do While idx < valtbl.Rows.Count And idxDim1 < 0
                                                    If Not IsDBNull(valtbl.Rows(idx).Item("Alias")) Then
                                                        sDim1Alias = valtbl.Rows(idx).Item("Alias")
                                                        'jrs 2025/10/06 idxDim1 = gGetDimIdx(UBound(GRPS, 1), sDim1Alias, False, myForm)
                                                        idxDim1 = gGetDimIdx(UBound(GRPS, 1) - iRegSetIdx, sDim1Alias, False, myForm)
                                                    End If
                                                    idx = idx + 1
                                                Loop
                                            End If
                                            'jrs 2026/10/06
                                            'If idxDim1 = -1 Then
                                            '    Exit Sub
                                            'End If
                                        End If
                                    End If
                                End If
                            End If
                        Next
                        If idxDim1 = -1 Then
                            Exit Sub
                        End If
                    End If
                End If
            End If
            'jrs 2022/03/28 avoid blow up when using provinces, and old base file
            If DimCount < idxDim1 Then
                idxDim1 = DimCount
            End If
            If df.Dimensions.Count > 2 Then
                DimCount = DimCount * df.Dimensions(2).Buckets.Count
                If df.Dimensions.Count > 3 Then
                    DimCount = DimCount * df.Dimensions(3).Buckets.Count
                End If
            End If
        End If

        'Low Common Year
        Dim VarVal As Single?
        VarVal = df.RowCount / DimCount - 1 + working.FirstYear

        'jrs 2009/01/14
        If VarVal > 0 Then
            'jrs 2017/06/21
            If VarVal > iLastYear Then
                VarVal = iLastYear
            End If
            FinYear(iColPosition) = VarVal - (iFirstYear - iFirstYearOffSet) + 1
        Else
            FinYear(iColPosition) = 0
        End If

        'Pointer Calculation 2006/04/06
        Dim VarPointer As Object
        Dim VarPointerVADD As Object 'jrs 2014/09/25

        Debug.WriteLine("gLoadForDisplayNET load group members")

        'Load Group Members
        '------------------
        Dim AgPoint As Long, sAgRule As String
        Dim Varval2 As Object
        Dim gCountGroupMembers As Integer
        Dim gGroupMembrs() As String, gGroupMembersPtrs() As Integer, gGroupMemberWeights() As Single
        'jrs 2006/09/27
        Dim sAgVar As String, iAgIdx As Integer

        Dim df2 As IDataframe

        'jrs 2006/08/29 added and VDim1(idxVar) = 1
        Dim Ctr2 As Integer, Ctr1 As Integer
        Dim RegPtrs2, RegPtrs1
        If bGroups And VDim1(idxVar) = 1 Then
            sAgRule = VAggregation(idxVar)
            'jrs 2023/09/08
            If sAgRule <> "SUM" And sAgRule <> "AVG" Then
                'jrs 2006/09/27
                sAgVar = IFsAggRules.Item(sAgRule).ForecastVar
            End If
            If sAgVar > "" Then
                iAgIdx = IfsVars.Item(sAgVar).Index
                If iAgIdx > 0 Then
                    If bTotal2 And VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 Then
                        _logger.Debug("gLoadForDisplayNET LoadDataFrame start VADD")
                        df2 = working.LoadDataframe("VADD")
                        _logger.Debug("gLoadForDisplayNET LoadDataFrame end")
                        'jrs 2022/08/11
                        iAgIdx = IfsVars.Item("VADD").Index
                    Else
                        _logger.Debug("gLoadForDisplayNET LoadDataFrame start " + sAgVar)
                        df2 = working.LoadDataframe(sAgVar)
                        _logger.Debug("gLoadForDisplayNET LoadDataFrame end")
                    End If
                End If
            End If
            'jrs 2006/09/06 groups by groups, no groups in dim3.
            If VDim2(idxVar) = 1 Then
                'load group 2
                gLoadGroupMembers(sDim2, idxVar, 1, 1, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
                'jrs 2006/12/28
                If gCountGroupMembers = 0 Then
                    gCountGroupMembers = 1
                    ReDim gGroupMemberWeights(1)
                    gGroupMemberWeights(1) = idxDim2 - 1
                End If
                'save counter
                Ctr2 = gCountGroupMembers
                'save region pointers
                RegPtrs2 = gGroupMemberWeights
                'load group 1
                gLoadGroupMembers(sDim1, idxVar, 1, 1, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
                'jrs 2006/12/28
                If gCountGroupMembers = 0 Then
                    gCountGroupMembers = 1
                    ReDim gGroupMemberWeights(1)
                    gGroupMemberWeights(1) = idxDim1 - 1
                End If
                'save counter
                Ctr1 = gCountGroupMembers
                'save region pointers
                RegPtrs1 = gGroupMemberWeights
                'change counter
                gCountGroupMembers = Ctr1 * Ctr2
                'change pointers
                ReDim gGroupMembersPtrs(gCountGroupMembers)
                Dim ipt1 As Integer, ipt2 As Integer
                For ipt1 = 1 To Ctr1
                    For ipt2 = 1 To Ctr2
                        If VDim3(idxVar) = 0 Then
                            gGroupMembersPtrs((ipt1 - 1) * Ctr2 + ipt2) = VarPoint(idxVar) + RegPtrs2(ipt2) * (MAXCOM(1) - 1) +
                            RegPtrs1(ipt1)
                        Else
                            gGroupMembersPtrs((ipt1 - 1) * Ctr2 + ipt2) = VarPoint(idxVar) + RegPtrs2(ipt2) * (MAXCOM(1) - 1) +
                            RegPtrs1(ipt1) + (idxDim3 - 1) * (MAXCOM(1) - 1) * (MAXCOM(VDim2(idxVar)) - 1)
                        End If
                    Next ipt2
                Next ipt1
            Else
                gLoadGroupMembers(sDim1, idxVar, idxDim2, idxDim3, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights, bIncompatibleRegionFile, IncompatibleRegionIdx)
            End If
        Else 'jrs 2020/06/06
            VarPointerVADD = idxDim1
        End If

        'Get Currency Factor
        Dim CurrencyFct As Single
        If VCurrency(idxVar) Then
            CurrencyFct = gGetCurrencyFct(idxVar, CurrencyVal)
        Else
            CurrencyFct = 1
        End If

        'Load Target Vector
        '------------------
        Dim yr As Integer, rr As Integer
        Dim Sumplot As Object, SumWeight As Object
        'jrs 2014/09/25
        Dim SumWeight2 As Object = 0
        Dim SVarVals(0, 0) As Object, SVarVals2() As Object
        Dim TempVarVal As Object, SVarValBySec() As Object

        'jrs 2021/03/18
        Dim iYrOffSetDF As Integer = 0

        Debug.WriteLine("gLoadDisplayForNet before FirstYear")

        'jrs 2020/10/07
        'Consider when first year of file is higher than first year to be loaded
        'Example file is 2017, but first year is 2015
        If iFirstYear < working.FirstYear Then
            iFirstYearOffSet = iFirstYearOffSet + working.FirstYear - iFirstYear
            iRowPosition = iRowPosition + working.FirstYear - iFirstYear

            'jrs 2021/03/18
            iYrOffSetDF = working.FirstYear - iFirstYear

            iFirstYear = working.FirstYear
        ElseIf iFirstYear > working.FirstYear Then 'In case trying to read 2015 base files, when the new base year is 2017
            'jrs 2021/02/24 added if statement to handle cases when reading only one year, for example in CountryProfile
            If working.FirstYear <> FirstYearForecast And working.FirstYear <> FirstYearHistory Then
                iFirstYearOffSet = iFirstYearOffSet + iFirstYear - working.FirstYear
                'jrs 2021/03/18
                FinYear(iColPosition) = FinYear(iColPosition) + iFirstYearOffSet
            End If
        End If

        Debug.WriteLine("gLoadDisplayForNet before LastYear")
        Dim yr2 As Integer = working.LastYear

        Dim MinValue As Single, MaxValue As Single
        For yr = 1 + iFirstYearOffSet To iLastYear - iFirstYear + 1 + iFirstYearOffSet
            If yr > FinYear(iColPosition) Then Exit For 'Beyond run year
            'jrs 2023/06/08

            'jrs 2009/01/20 Total
            Do While True

                If Not bGroups Or VDim1(idxVar) <> 1 Then 'jrs 2006/08/29 added Or VDim1(idxVar) <> 1
                    If VDim3(idxVar) > 0 Then
                        VarVal = df((yr - 1) + iFirstYear - iFirstYearOffSet, idxDim1, idxDim2, idxDim3)
                    ElseIf VDim2(idxVar) > 0 Then
                        VarVal = df((yr - 1) + iFirstYear - iFirstYearOffSet, idxDim1, idxDim2)
                    ElseIf VDim1(idxVar) > 0 Then
                        VarVal = df((yr - 1) + iFirstYear - iFirstYearOffSet, idxDim1)
                    Else
                        'jrs 2021/03/18 added iYrOffSetDF to fix the index when file is base 2017 and the model is still using 2015
                        VarVal = df((yr - 1 - iYrOffSetDF)) 'jrs 2019/10/18 when using only one index don't pass the year, but the position
                    End If
                Else
                    'jrs 2014/08/07
                    If sVar = "TEFF" Then
                        If ((bTotal2 And idxDim2 = 1) Or Not bTotal2) And yr = 1 + iFirstYearOffSet Then
                            ReDim SVarVals(gCountGroupMembers, NSec)
                            ReDim SVarValBySec(NSec)
                        End If
                    End If

                    MinValue = 1000000000
                    MaxValue = -100000000
                    Sumplot = 0
                    SumWeight = 0
                    For rr = 1 To gCountGroupMembers
                        'jrs 2020/07/27
                        If rr <= UBound(gGroupMemberWeights) Then
                            VarPointer = gGroupMemberWeights(rr) + 1
                        Else
                            VarPointer = 0
                        End If
                        If VDim2(idxVar) = 1 And Ctr2 > 0 Then
                            VarPointer = RegPtrs1(((rr - 1) Mod (RegPtrs1.length - 1)) + 1) + 1
                            idxDim2 = RegPtrs2(((rr - 1) \ (RegPtrs1.length - 1)) + 1) + 1
                        End If
                        If VDim3(idxVar) > 0 Then
                            VarVal = df((yr - 1) + iFirstYear - iFirstYearOffSet, VarPointer, idxDim2, idxDim3)
                        ElseIf VDim2(idxVar) > 0 Then
                            VarVal = df((yr - 1) + iFirstYear - iFirstYearOffSet, VarPointer, idxDim2)
                        ElseIf VDim1(idxVar) > 0 Then
                            VarVal = df((yr - 1) + iFirstYear - iFirstYearOffSet, VarPointer)
                        Else
                            VarVal = df((yr - 1)) 'jrs 2019/10/18 when using only one index don't pass the year, but the position
                        End If
                        'jrs 2006/09/27 generalization of Agg rule If sAgRule = "GDP" Or sAgRule = "POP" Then
                        If sAgVar > "" Then
                            'jrs 2014/08/07
                            If sVar = "TEFF" Then
                                If yr = 1 + iFirstYearOffSet Then
                                    SVarVals(rr, idxDim2) = VarVal
                                Else
                                    TempVarVal = VarVal
                                    VarVal = VarVal / SVarVals(rr, idxDim2) - 1
                                    SVarVals(rr, idxDim2) = TempVarVal
                                End If
                            End If

                            VarPointer = gGroupMemberWeights(rr) + 1
                            Dim iAgidxDim2 As Integer
                            If VDim2(iAgIdx) > 0 Then
                                'jrs 2014/08/05
                                If IFsAggRules.Item(sAgRule).Dim2 > "" Then
                                    iAgidxDim2 = gGetDimIdx(VDim2(iAgIdx), IFsAggRules.Item(sAgRule).Dim2, True, myForm)
                                Else
                                    iAgidxDim2 = idxDim2
                                End If
                            End If
                            Dim iAgidxDim3 As Integer
                            If VDim3(iAgIdx) > 0 Then
                                'mti 2021/12/02 start
                                'iAgidxDim3 = gGetDimIdx(VDim3(iAgIdx), IFsAggRules.Item(sAgRule).Dim3, True, myForm)
                                If IFsAggRules.Item(sAgRule).Dim3 > "" Then
                                    iAgidxDim3 = gGetDimIdx(VDim3(iAgIdx), IFsAggRules.Item(sAgRule).Dim3, True, myForm)
                                Else
                                    iAgidxDim3 = idxDim3
                                End If
                                'mti 2021/12/02 End
                            End If

                            If VDim3(iAgIdx) > 0 Then
                                Varval2 = df2((yr - 1) + iFirstYear - iFirstYearOffSet, VarPointer, iAgidxDim2, iAgidxDim3)
                            ElseIf VDim2(iAgIdx) > 0 Then
                                Varval2 = df2((yr - 1) + iFirstYear - iFirstYearOffSet, VarPointer, iAgidxDim2)
                            ElseIf VDim1(iAgIdx) > 0 Then
                                Varval2 = df2((yr - 1) + iFirstYear - iFirstYearOffSet, VarPointer)
                            Else
                                Varval2 = df2((yr - 1)) 'jrs 2019/10/18 when using only one index don't pass the year, but the position
                            End If
                            SumWeight = SumWeight + Varval2
                            Sumplot = Sumplot + VarVal * Varval2
                        Else
                            Sumplot = Sumplot + VarVal
                        End If
                        If sAgRule = "MIN" And VarVal < MinValue Then MinValue = VarVal
                        If sAgRule = "MAX" And VarVal > MaxValue Then MaxValue = VarVal
                    Next rr
                    Select Case sAgRule
                        Case "SUM"
                            VarVal = Sumplot
                        Case "AVG"
                            VarVal = Sumplot / gCountGroupMembers
                        Case "MIN"
                            VarVal = MinValue
                        Case "MAX"
                            VarVal = MaxValue
                        Case Else 'jrs 2006/09/27 "GDP", "POP"
                            If sAgVar > "" Then
                                VarVal = Sumplot / AMAX(0.001, SumWeight)
                                'jrs 2014/08/07
                                If sVar = "TEFF" Then
                                    If yr > 1 + iFirstYearOffSet Then
                                        VarVal = SVarValBySec(idxDim2) * (1 + VarVal)
                                    End If
                                    SVarValBySec(idxDim2) = VarVal
                                End If
                            End If
                    End Select
                End If

                'jrs 2009/01/20
                If Not (bTotal1 Or bTotal2 Or bTotal3) Then
                    Exit Do
                Else
                    'jrs 2014/08/01 Adding other aggregation rules for Total, ex. TEFF(R, Sector), using GDP, with this dimension means using VADD
                    If bTotal2 And VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 Then
                        'jrs 2020/06/06
                        If df2 Is Nothing Then
                            _logger.Debug("gLoadForDisplayNET LoadDataFrame start VADD")
                            df2 = working.LoadDataframe("VADD")
                            _logger.Debug("gLoadForDisplayNET LoadDataFrame end")
                        End If
                        aggregateWVADDNET(VarVal, SumWeight2, idxDim2, VarPointerVADD, yr, df2, bGroups, idxVar, SVarVals2, gCountGroupMembers, gGroupMemberWeights, iFirstYear - iFirstYearOffSet)
                    End If

                    'Sum across other dimensions
                    VarValTot = VarValTot + VarVal
                    'advance dimension index
                    Select Case True
                        Case bTotal1
                            idxDim1 = idxDim1 + 1
                            If idxDim1 = MAXCOM(VDim1(idxVar)) Then
                                idxDim1 = 1
                                If bTotal2 Then
                                    idxDim2 = idxDim2 + 1
                                    If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                                        idxDim2 = 1
                                        If bTotal3 Then
                                            idxDim3 = idxDim3 + 1
                                            If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                                idxDim3 = 1
                                                VarVal = VarValTot
                                                VarValTot = 0
                                                RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                                Exit Do
                                            End If
                                        Else
                                            VarVal = VarValTot
                                            VarValTot = 0
                                            RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                            Exit Do
                                        End If
                                    End If
                                Else
                                    VarVal = VarValTot
                                    VarValTot = 0
                                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                    Exit Do
                                End If
                            End If
                        Case bTotal2
                            idxDim2 = idxDim2 + 1
                            If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                                idxDim2 = 1
                                If bTotal3 Then
                                    idxDim3 = idxDim3 + 1
                                    If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                        idxDim3 = 1
                                        VarVal = VarValTot
                                        VarValTot = 0
                                        RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                        Exit Do
                                    End If
                                Else
                                    VarVal = VarValTot
                                    VarValTot = 0
                                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                    Exit Do
                                End If
                            End If
                        Case bTotal3
                            idxDim3 = idxDim3 + 1
                            If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                idxDim3 = 1
                                VarVal = VarValTot
                                VarValTot = 0
                                RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                Exit Do
                            End If
                    End Select
                    'recompute pointers
                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                End If
            Loop 'jrs 2009/01/20

            'jrs 2014/03/07
            'Check if aggregation rule is not sum
            If bTotal1 And VAggregation(idxVar) <> "SUM" Then
                VarVal = VarVal / (MAXCOM(VDim1(idxVar)) - 1)
            End If
            'JRS 2014/09/17
            If bTotal2 And (VAggregation(idxVar) <> "SUM" And VAggregation2(idxVar) <> "SUM") Then 'JRS 2014/09/25
                'jrs 2014/08/01
                If VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 And SumWeight2 > 0 Then
                    VarVal = VarVal / SumWeight2
                    SumWeight2 = 0
                    'jrs 2014/08/07
                    If V(idxVar) = "TEFF" And yr > 1 Then
                        If bSingleDim Then 'single dimension array
                            VarVal = TargetVector(yr + iRowPosition - 2 - iFirstYearOffSet) * (1 + VarVal) / Factor * CurrencyFct
                        Else
                            VarVal = TargetVector(yr + iRowPosition - 2 - iFirstYearOffSet, iColPosition) * (1 + VarVal) / Factor * CurrencyFct
                        End If
                    End If
                Else
                    VarVal = VarVal / (MAXCOM(VDim2(idxVar)) - 1)
                End If
            End If

            'Apply Currency Convertion
            VarVal = VarVal / CurrencyFct
            'Store Value
            If bSingleDim Then 'single dimension array
                TargetVector(yr + iRowPosition - 1 - iFirstYearOffSet) = VarVal
            Else
                TargetVector(yr + iRowPosition - 1 - iFirstYearOffSet, iColPosition) = VarVal
            End If
        Next yr

        Debug.WriteLine("gLoadForDisplayNET after year loop")

        'Close file if necessary
        If bCloseFile AndAlso working IsNot Nothing Then
            'working.Dispose()
        Else
            ' try to not keep dbcontext alive
            FileforDisplay = working
        End If

        'jrs 2025/02/12 this is needed when mixing Countries and Groups for Bilateral, for example Exports from US to Europe
        If bGroups1 <> bGroups2 Then
            bGroups = Nothing
        End If

        'Finish Successfully
        bLoadForDisplaySuccess = True
        Debug.WriteLine("gLoadForDisplayNET end")

        'jam 2026/05/15 Defensive OOM catch — recover memory and return safe failure
        Catch oom As OutOfMemoryException
            bLoadForDisplaySuccess = False
            Try
                'jam 2026/05/15 Aggressive GC to reclaim the partially-allocated Dictionary from Dataframe.cs:76
                GC.Collect(2, GCCollectionMode.Forced, blocking:=True)
                GC.WaitForPendingFinalizers()
                GC.Collect(2, GCCollectionMode.Forced, blocking:=True)
            Catch
                ' Suppress — GC failure shouldn't mask the original OOM
            End Try
            _logger.Error(oom, $"gLoadForDisplayNET OOM  sVar='{sVar}' idxVar={idxVar} file='{sFileName}'. Returning safe failure to caller.")
            Debug.WriteLine("gLoadForDisplayNET OOM caught")
        End Try
    End Sub

    'jrs 2019/04/01
    'Loads a single column into an array
    Public Sub gLoadForDisplay2(ByVal sVar As String, ByRef idxVar As Integer, ByRef sDim1 As String,
    ByVal idxDim1 As Integer, ByRef sDim2 As String, ByVal idxDim2 As Integer, ByRef sDim3 As String,
    ByVal idxDim3 As Integer, ByVal sFileName As String, ByRef idxFile As Integer, ByVal bOpenFile As Boolean,
    ByVal bCloseFile As Boolean, ByRef bGroups As Object, ByVal Factor As Single, ByRef TargetVector As Object,
    ByVal iColPosition As Integer, ByVal iRowPosition As Integer, ByVal iFirstYear As Integer, ByVal iLastYear As Integer,
    ByVal iFirstYearOffSet As Integer, ByVal bSingleDim As Boolean,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef RunFiles As Object, ByRef PutFdrvRun As String,
    ByRef vShortSce As Object, ByRef FileforDisplay As Integer, ByRef FinYear As Object,
    ByRef IFs_MDB2Active As String, ByVal CurrencyVal As Single)
        '1. sVar Variable Name
        '2. idxVar Variable Index
        '3. sDim1 Dimension1 Name
        '4. idxDim1 Dimension1 Index
        '5. sDim2 Dimension2 Name
        '6. idxDim2 Dimension2 Index
        '7. sDim3 Dimension3 Name
        '8. idxDim3 Dimension3 Index
        '9. sFileName should contain the full path of the file
        '10. idxFile File Index within array Runfiles
        '11. bOpenFile is false when the file is already open and there's no need to open it again.
        '12. bCloseFile is false when there's no need to close the file used.
        '13. bGroups is true when using groups in dimension1, eventually will have bGroups1 and bGroups2, if Null we have to find out if using groups or not
        '14. Factor multiplies every value read from sFileName
        '15. TargetVector array where read values are stored
        '16. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '17. iRowPosition is the Row position within the Target vector to store the array. Greater than 1 when History plus Forecast, 1 otherwise.
        '18. iFirstYear, 2000 for forecast, 1960 for History
        '19. iLastYear, 2000 to 2100 for forecast, 1960 to 2000 for history
        '20. iFirstYearOffset, is the difference between iFirstYear and the FirstYear in the Base Case (generally 0)
        '21. bSingleDim is True when using a Single Dimension vector as Target
        '22. bLoadForDisplaySuccess is a flag to indicate that the load for display has been successful.
        '23. myForm is the webpage that is calling this sub routine, used to return after a message
        '24. RunFiles is the array that stores file names
        '25. PutFdrRun is the path to RunFiles
        '26. vShortSce is an array with the short name of the scenario files
        '27. FileforDisplay is the number used to open the run file.
        '28. FinYear is an array that contains the number of values for each column in the target vector
        '29. IFs_MDB2Active is the full path to IFs.mdb
        '30. CurrencyVal is the currency convertion factor               

        bLoadForDisplaySuccess = False
        Dim frm_msg As New frm_Message

        'jrs 2009/01/20
        Dim bTotal1 As Boolean, bTotal2 As Boolean, bTotal3 As Boolean
        Dim VarValTot As Single
        VarValTot = 0

        'Check Variable Name Parameters
        If sVar = "" And idxVar < 1 Then
            frm_msg.LoadMessage("Invalid Variable Parameters")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If sVar = "" Then
            sVar = V(idxVar)
        End If

        If idxVar < 1 Then
            idxVar = IfsVars.Item(sVar).Index
        End If

        'Check Group Parameters
        If (bGroups Is Nothing) Then
            If VDim1(idxVar) = 1 And sDim1 > "" Then 'jrs 2012/02/06
                idxDim1 = gGetDimIdx(1, sDim1, False, myForm)
                bGroups = (idxDim1 < 1)
                'jrs 2006/12/29 check for second dimension
                If VDim2(idxVar) = 1 And Not bGroups Then
                    idxDim2 = gGetDimIdx(1, sDim2, False, myForm)
                    bGroups = (idxDim2 < 1)
                End If
            Else
                bGroups = False
            End If
        End If

        'Check Dimension Parameters
        If VDim1(idxVar) > 0 Then
            If sDim1 = "" And idxDim1 < 1 Then
                frm_msg.LoadMessage("Invalid Dimension 1 Parameters")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If

            If Not bGroups Or VDim1(idxVar) <> 1 Then
                If sDim1 = "" Then
                    sDim1 = GRPS(VDim1(idxVar), idxDim1)
                End If

                'jrs 2009/01/21
                If idxDim1 > 0 Then
                    If UCase(sDim1) <> UCase(GRPS(VDim1(idxVar), idxDim1)) Then
                        idxDim1 = -1
                    End If
                End If

                If idxDim1 < 1 Then
                    idxDim1 = gGetDimIdx(VDim1(idxVar), sDim1, True, myForm)
                End If
            Else 'if it's a group
                If sDim1 = "" Then
                    sDim1 = GroupNames$(idxDim1)
                End If

                If idxDim1 < 1 Then
                    idxDim1 = gGetGroupIdx(sDim1, False, myForm) 'jrs 2006/12/28 change to false to check in case 2 dim with reg and groups
                    'jrs 2006/12/28 if 2 dimensions the second one could be the group
                    If idxDim1 = -1 Then
                        If VDim2(idxVar) = 1 Then
                            idxDim1 = gGetDimIdx(VDim1(idxVar), sDim1, True, myForm)
                        Else
                            frm_msg.LoadMessage("Group not Found")
                            Support.FormManager.StateStore(myForm)
                            Support.FormManager.Show(myForm, "frm_Message.aspx")
                        End If
                    End If

                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim1 = -1 And UCase(sDim1) = "TOTAL" And VDim1(idxVar) > 1 Then
                bTotal1 = True
                idxDim1 = 1
            End If

            If idxDim1 = -1 Then
                Exit Sub
            End If
        End If

        If VDim2(idxVar) > 0 Then
            If sDim2 = "" And idxDim2 < 1 Then
                frm_msg.LoadMessage("Invalid Dimension 2 Parameters")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If

            If Not bGroups Or VDim2(idxVar) <> 1 Then
                If sDim2 = "" Then
                    sDim2 = GRPS(VDim2(idxVar), idxDim2)
                End If

                'jrs 2009/01/21
                If idxDim2 > 0 Then
                    If UCase(sDim2) <> UCase(GRPS(VDim2(idxVar), idxDim2)) Then
                        idxDim2 = -1
                    End If
                End If

                If idxDim2 < 1 Then
                    idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                End If
            Else 'if it's a group
                If sDim2 = "" Then
                    sDim2 = GroupNames$(idxDim2)
                End If

                If idxDim2 < 1 Then
                    idxDim2 = gGetGroupIdx(sDim2, False, myForm) 'jrs 2006/12/28 changed to false to check for comb of groups and regs
                    'jrs 2006/12/28 if 2 dimensions the first one could be the group
                    If idxDim2 = -1 Then
                        idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                    End If
                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim2 = -1 And UCase(sDim2) = "TOTAL" And VDim2(idxVar) > 1 Then
                bTotal2 = True
                idxDim2 = 1
            End If

            If idxDim2 = -1 Then
                Exit Sub
            End If
        End If

        If VDim3(idxVar) > 0 Then
            If sDim3 = "" And idxDim3 < 1 Then
                MsgBox("Invalid Dimension 3 Parameters", vbCritical, "Load for Display")
                Exit Sub
            End If

            If Not bGroups Or VDim3(idxVar) <> 1 Then
                If sDim3 = "" Then
                    sDim3 = GRPS(VDim3(idxVar), idxDim3)
                End If

                'jrs 2009/01/21
                If idxDim3 > 0 Then
                    If UCase(sDim3) <> UCase(GRPS(VDim3(idxVar), idxDim3)) Then
                        idxDim3 = -1
                    End If
                End If

                If idxDim3 < 1 Then
                    idxDim3 = gGetDimIdx(VDim3(idxVar), sDim3, True, myForm)
                End If
            Else 'if it's a group
                If sDim3 = "" Then
                    sDim3 = GroupNames$(idxDim3)
                End If

                If idxDim3 < 1 Then
                    idxDim3 = gGetGroupIdx(sDim3, True, myForm)
                End If
            End If

            'jrs 2009/01/20 Total
            If idxDim3 = -1 And UCase(sDim3) = "TOTAL" And VDim3(idxVar) > 1 Then
                bTotal3 = True
                idxDim3 = 1
            End If

            If idxDim3 = -1 Then
                Exit Sub
            End If
        End If

        'jrs 2006/08/29 I removed it, because in VarSelect you could be using groups and call a variable like WGDP
        'and this would change the flag to false, incorrectly
        ''Check Grouping Parameters
        'If bGroups And VDim1(idxVar) <> 1 Then
        '    bGroups = False
        'End If

        'Check File Parameters
        If sFileName = "" And idxFile < 0 Then
            MsgBox("Invalid File Parameters", vbCritical, "Load for Display")
            Exit Sub
        End If

        If sFileName = "" Then
            If idxFile > 0 Then
                If idxFile > UBound(RunFiles) Then
                    frm_msg.LoadMessage("Invalid File Parameters")
                    Support.FormManager.StateStore(myForm)
                    Support.FormManager.Show(myForm, "frm_Message.aspx")
                End If
                sFileName = RunFiles(idxFile)
            Else
                sFileName = PutFdrvRun + "Working.run"
            End If
        End If

        If idxFile < 0 Then
            idxFile = getFileNum(sFileName, vShortSce)
        End If
        If idxFile = -1 Then
            frm_msg.LoadMessage("Invalid File Name")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        'Check Target Parameters
        If iLastYear - iFirstYear + 1 > UBound(TargetVector, 1) Then
            frm_msg.LoadMessage("Invalid Year Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If Not bSingleDim Then 'doubly dimension array
            If iColPosition > UBound(TargetVector, 2) Then
                frm_msg.LoadMessage("Invalid Initial Column")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'Open File if necessary
        Dim fNum As Integer
        If bOpenFile Then
            fNum = FreeFile()
            FileOpen(fNum, sFileName, OpenMode.Binary, OpenAccess.Read, OpenShare.Shared)
        Else
            fNum = FileforDisplay
        End If

        'Using working As IStorage = Me.storageSvc.Open(False)

        'End Using

        'jrs 2008/10/17 testing efficient ways of reading files
        'Dim value As Byte() = My.Computer.FileSystem.ReadAllBytes(sFileName)

        'Low Common Year
        Dim VLN As Object, Number As Single, RECORD As Object, VarVal As Single
        VLN = VarPoint(PosModYear)
        RECORD = VLN * 4 - 3
        FileGet(fNum, Number, RECORD)
        VarVal = Number!
        'jrs 2009/01/14
        If VarVal > 0 Then
            'jrs 2017/06/21
            If VarVal > iLastYear Then
                VarVal = iLastYear
            End If
            FinYear(iColPosition) = VarVal - (iFirstYear - iFirstYearOffSet) + 1
        Else
            FinYear(iColPosition) = 0
        End If

        'Pointer Calculation 2006/04/06
        Dim VPTR As Object, VarPointer As Object
        Dim VarPointerVADD As Object 'jrs 2014/09/25
        VPTR = 0
        If VDim1(idxVar) > 0 Then
            VPTR = idxDim1
        Else
            VPTR = 1
        End If
        If VDim2(idxVar) > 0 Then
            VPTR = VPTR + ((idxDim2 - 1) * (MAXCOM(VDim1(idxVar)) - 1))  'final pointer shift calculation
        End If
        If VDim3(idxVar) > 0 Then
            VPTR = VPTR + ((idxDim3 - 1) * (MAXCOM(VDim1(idxVar)) - 1) * (MAXCOM(VDim2(idxVar)) - 1))  'final pointer shift calculation
        End If

        'Get Variable Pointer
        '--------------------
        VarPointer = VarPoint(idxVar) + VPTR - 1
        'jrs 2014/08/01
        If bGroups Then
            VarPointerVADD = VarPoint(IfsVars.Item("VADD").Index)
        Else
            VarPointerVADD = VarPoint(IfsVars.Item("VADD").Index) + idxDim1 - 1
        End If

        'Load Group Members
        '------------------
        Dim AgPoint As Long, sAgRule As String
        Dim Varval2 As Object
        Dim gCountGroupMembers As Integer
        Dim gGroupMembrs() As String, gGroupMembersPtrs() As Integer, gGroupMemberWeights() As Single
        'jrs 2006/09/27
        Dim sAgVar As String, iAgIdx As Integer

        'jrs 2006/08/29 added and VDim1(idxVar) = 1
        If bGroups And VDim1(idxVar) = 1 Then
            sAgRule = VAggregation(idxVar)
            'jrs 2006/09/27
            sAgVar = IFsAggRules.Item(sAgRule).ForecastVar
            If sAgVar > "" Then
                iAgIdx = IfsVars.Item(sAgVar).Index
                If iAgIdx > 0 Then
                    AgPoint = VarPoint(iAgIdx)
                End If
            End If
            'jrs 2006/09/06 groups by groups, no groups in dim3.
            If VDim2(idxVar) = 1 Then
                Dim Ctr2 As Integer, Ctr1 As Integer
                Dim RegPtrs2, RegPtrs1
                'load group 2
                gLoadGroupMembers(sDim2, idxVar, 1, 1, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
                'jrs 2006/12/28
                If gCountGroupMembers = 0 Then
                    gCountGroupMembers = 1
                    ReDim gGroupMemberWeights(1)
                    gGroupMemberWeights(1) = idxDim2 - 1
                End If
                'save counter
                Ctr2 = gCountGroupMembers
                'save region pointers
                RegPtrs2 = gGroupMemberWeights
                'load group 1
                gLoadGroupMembers(sDim1, idxVar, 1, 1, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
                'jrs 2006/12/28
                If gCountGroupMembers = 0 Then
                    gCountGroupMembers = 1
                    ReDim gGroupMemberWeights(1)
                    gGroupMemberWeights(1) = idxDim1 - 1
                End If
                'save counter
                Ctr1 = gCountGroupMembers
                'save region pointers
                RegPtrs1 = gGroupMemberWeights
                'change counter
                gCountGroupMembers = Ctr1 * Ctr2
                'change pointers
                ReDim gGroupMembersPtrs(gCountGroupMembers)
                Dim ipt1 As Integer, ipt2 As Integer
                For ipt1 = 1 To Ctr1
                    For ipt2 = 1 To Ctr2
                        If VDim3(idxVar) = 0 Then
                            gGroupMembersPtrs((ipt1 - 1) * Ctr2 + ipt2) = VarPoint(idxVar) + RegPtrs2(ipt2) * (MAXCOM(1) - 1) +
                            RegPtrs1(ipt1)
                        Else
                            gGroupMembersPtrs((ipt1 - 1) * Ctr2 + ipt2) = VarPoint(idxVar) + RegPtrs2(ipt2) * (MAXCOM(1) - 1) +
                            RegPtrs1(ipt1) + (idxDim3 - 1) * (MAXCOM(1) - 1) * (MAXCOM(VDim2(idxVar)) - 1)
                        End If
                    Next ipt2
                Next ipt1
            Else
                gLoadGroupMembers(sDim1, idxVar, idxDim2, idxDim3, gCountGroupMembers, IFs_MDB2Active,
                gGroupMembrs, gGroupMembersPtrs, gGroupMemberWeights)
            End If
        End If

        'Get Currency Factor
        Dim CurrencyFct As Single
        If VCurrency(idxVar) Then
            CurrencyFct = gGetCurrencyFct(idxVar, CurrencyVal)
        Else
            CurrencyFct = 1
        End If

        'Load Target Vector
        '------------------
        Dim yr As Integer, rr As Integer
        Dim Sumplot As Object, SumWeight As Object
        'jrs 2014/09/25
        Dim SumWeight2 As Object = 0
        Dim SVarVals(0, 0) As Object, SVarVals2() As Object
        Dim TempVarVal As Object, SVarValBySec() As Object

        Dim MinValue As Single, MaxValue As Single
        For yr = 1 + iFirstYearOffSet To iLastYear - iFirstYear + 1 + iFirstYearOffSet
            If yr > FinYear(iColPosition) Then Exit For 'Beyond run year

            'jrs 2009/01/20 Total
            Do While True

                If Not bGroups Or VDim1(idxVar) <> 1 Then 'jrs 2006/08/29 added Or VDim1(idxVar) <> 1
                    RECORD = CLng((VarPointer + ((yr - 1) * filen)) * 4) - 3
                    FileGet(fNum, Number, RECORD)
                    VarVal = Number!
                Else
                    'jrs 2014/08/07
                    If sVar = "TEFF" Then
                        If ((bTotal2 And idxDim2 = 1) Or Not bTotal2) And yr = 1 + iFirstYearOffSet Then
                            ReDim SVarVals(gCountGroupMembers, NSec)
                            ReDim SVarValBySec(NSec)
                        End If
                    End If

                    MinValue = 1000000000
                    MaxValue = -100000000
                    Sumplot = 0
                    SumWeight = 0
                    For rr = 1 To gCountGroupMembers
                        VarPointer = gGroupMembersPtrs(rr)
                        RECORD = CLng((VarPointer + ((yr - 1) * filen)) * 4) - 3
                        FileGet(fNum, Number, RECORD)
                        VarVal = Number!
                        'jrs 2006/09/27 generalization of Agg rule If sAgRule = "GDP" Or sAgRule = "POP" Then
                        If sAgVar > "" Then
                            'jrs 2014/08/07
                            If sVar = "TEFF" Then
                                If yr = 1 + iFirstYearOffSet Then
                                    SVarVals(rr, idxDim2) = VarVal
                                Else
                                    TempVarVal = VarVal
                                    VarVal = VarVal / SVarVals(rr, idxDim2) - 1
                                    SVarVals(rr, idxDim2) = TempVarVal
                                End If
                            End If

                            VarPointer = AgPoint + gGroupMemberWeights(rr)
                            If VDim2(iAgIdx) > 0 Then
                                Dim iAgidxDim2 As Integer
                                'jrs 2014/08/05
                                If IFsAggRules.Item(sAgRule).Dim2 > "" Then
                                    iAgidxDim2 = gGetDimIdx(VDim2(iAgIdx), IFsAggRules.Item(sAgRule).Dim2, True, myForm)
                                Else
                                    iAgidxDim2 = idxDim2
                                End If
                                VarPointer = VarPointer + ((iAgidxDim2 - 1) * (MAXCOM(VDim1(iAgIdx)) - 1))  'final pointer shift calculation
                            End If
                            If VDim3(iAgIdx) > 0 Then
                                Dim iAgidxDim3 As Integer
                                iAgidxDim3 = gGetDimIdx(VDim3(iAgIdx), IFsAggRules.Item(sAgRule).Dim3, True, myForm)
                                VarPointer = VarPointer + ((idxDim3 - 1) * (MAXCOM(VDim1(iAgIdx)) - 1) * (MAXCOM(VDim2(iAgIdx)) - 1))  'final pointer shift calculation
                            End If
                            RECORD = CLng((CLng(VarPointer) + ((yr - 1) * filen)) * 4) - 3
                            FileGet(fNum, Number, RECORD)
                            Varval2 = Number!
                            SumWeight = SumWeight + Varval2
                            Sumplot = Sumplot + VarVal * Varval2
                        Else
                            Sumplot = Sumplot + VarVal
                        End If
                        If sAgRule = "MIN" And VarVal < MinValue Then MinValue = VarVal
                        If sAgRule = "MAX" And VarVal > MaxValue Then MaxValue = VarVal
                    Next rr
                    Select Case sAgRule
                        Case "SUM"
                            VarVal = Sumplot
                        Case "AVG"
                            VarVal = Sumplot / gCountGroupMembers
                        Case "MIN"
                            VarVal = MinValue
                        Case "MAX"
                            VarVal = MaxValue
                        Case Else 'jrs 2006/09/27 "GDP", "POP"
                            If sAgVar > "" Then
                                VarVal = Sumplot / AMAX(0.001, SumWeight)
                                'jrs 2014/08/07
                                If sVar = "TEFF" Then
                                    If yr > 1 + iFirstYearOffSet Then
                                        VarVal = SVarValBySec(idxDim2) * (1 + VarVal)
                                    End If
                                    SVarValBySec(idxDim2) = VarVal
                                End If
                            End If
                    End Select
                End If

                'jrs 2009/01/20
                If Not (bTotal1 Or bTotal2 Or bTotal3) Then
                    Exit Do
                Else
                    'jrs 2014/08/01 Adding other aggregation rules for Total, ex. TEFF(R, Sector), using GDP, with this dimension means using VADD
                    If bTotal2 And VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 Then
                        aggregateWVADD(VarVal, SumWeight2, idxDim2, VarPointerVADD, yr, fNum, bGroups, idxVar, SVarVals2, gCountGroupMembers, gGroupMemberWeights)
                    End If

                    'Sum across other dimensions
                    VarValTot = VarValTot + VarVal
                    'advance dimension index
                    Select Case True
                        Case bTotal1
                            idxDim1 = idxDim1 + 1
                            If idxDim1 = MAXCOM(VDim1(idxVar)) Then
                                idxDim1 = 1
                                If bTotal2 Then
                                    idxDim2 = idxDim2 + 1
                                    If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                                        idxDim2 = 1
                                        If bTotal3 Then
                                            idxDim3 = idxDim3 + 1
                                            If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                                idxDim3 = 1
                                                VarVal = VarValTot
                                                VarValTot = 0
                                                RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                                Exit Do
                                            End If
                                        Else
                                            VarVal = VarValTot
                                            VarValTot = 0
                                            RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                            Exit Do
                                        End If
                                    End If
                                Else
                                    VarVal = VarValTot
                                    VarValTot = 0
                                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                    Exit Do
                                End If
                            End If
                        Case bTotal2
                            idxDim2 = idxDim2 + 1
                            If idxDim2 = MAXCOM(VDim2(idxVar)) Then
                                idxDim2 = 1
                                If bTotal3 Then
                                    idxDim3 = idxDim3 + 1
                                    If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                        idxDim3 = 1
                                        VarVal = VarValTot
                                        VarValTot = 0
                                        RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                        Exit Do
                                    End If
                                Else
                                    VarVal = VarValTot
                                    VarValTot = 0
                                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                    Exit Do
                                End If
                            End If
                        Case bTotal3
                            idxDim3 = idxDim3 + 1
                            If idxDim3 = MAXCOM(VDim3(idxVar)) Then
                                idxDim3 = 1
                                VarVal = VarValTot
                                VarValTot = 0
                                RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                                Exit Do
                            End If
                    End Select
                    'recompute pointers
                    RecomputePointersforTotal(VarPointer, idxVar, idxDim1, idxDim2, idxDim3, (bGroups And VDim1(idxVar) = 1), gGroupMembrs, gGroupMembersPtrs, gCountGroupMembers)
                End If
            Loop 'jrs 2009/01/20

            'jrs 2014/03/07
            'Check if aggregation rule is not sum
            If bTotal1 And VAggregation(idxVar) <> "SUM" Then
                VarVal = VarVal / (MAXCOM(VDim1(idxVar)) - 1)
            End If
            'JRS 2014/09/17
            If bTotal2 And (VAggregation(idxVar) <> "SUM" And VAggregation2(idxVar) <> "SUM") Then 'JRS 2014/09/25
                'jrs 2014/08/01
                If VAggregation(idxVar) = "GDP" And VDim2(idxVar) = 2 And SumWeight2 > 0 Then
                    VarVal = VarVal / SumWeight2
                    SumWeight2 = 0
                    'jrs 2014/08/07
                    If V(idxVar) = "TEFF" And yr > 1 Then
                        If bSingleDim Then 'single dimension array
                            VarVal = TargetVector(yr + iRowPosition - 2 - iFirstYearOffSet) * (1 + VarVal) / Factor * CurrencyFct
                        Else
                            VarVal = TargetVector(yr + iRowPosition - 2 - iFirstYearOffSet, iColPosition) * (1 + VarVal) / Factor * CurrencyFct
                        End If
                    End If
                Else
                    VarVal = VarVal / (MAXCOM(VDim2(idxVar)) - 1)
                End If
            End If

            'Apply Currency Convertion
            VarVal = VarVal / CurrencyFct
            'Store Value
            If bSingleDim Then 'single dimension array
                TargetVector(yr + iRowPosition - 1 - iFirstYearOffSet) = VarVal
            Else
                TargetVector(yr + iRowPosition - 1 - iFirstYearOffSet, iColPosition) = VarVal
            End If
        Next yr

        'Close file if necessary
        If bCloseFile Then
            FileClose(fNum)
        Else
            FileforDisplay = fNum
        End If

        'Finish Successfully
        bLoadForDisplaySuccess = True
    End Sub

    Public Sub gLoadForDisplaySaveLbls(ByVal iColPosition As Integer, ByVal idxVar As Integer,
    ByVal sDim1 As String, ByVal sDim2 As String, ByVal sDim3 As String, ByVal bGroups As Boolean,
    ByVal idxFile As Integer, ByVal sTitle As String, ByRef SensitivityFlag As Object,
    ByRef vShortSce As Object, ByRef CurrencySym As String, ByRef VARN As Object,
    ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object,
    ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object)
        '1. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '2. idxVar Variable Index
        '3. sDim1 Dimension1 Name
        '4. sDim2 Dimension2 Name
        '5. sDim3 Dimension3 Name
        '6. bGroups is true when using groups in dimension1, eventually will have bGroups1 and bGroups2, if Null we have to find out if using groups or not
        '7. idxFile File Index within array Runfiles
        '8. sTitle is the optional title to use in graphics
        '9. SensitivityFlag is a global variable that indicates if doing sensitivity analysis
        '10. vShortSce is an array with the short name of the scenario files
        '11. CurrencySym is the currency symbol
        '12. VARN is a global array that contains labels
        '13. GR1N is a global array that contains labels
        '14. GR2N is a global array that contains labels
        '15. GR3N is a global array that contains labels
        '16. GR4N is a global array that contains labels
        '17. FDNG1 is a global array that contains labels for graphs
        '18. FDNG2 is a global array that contains labels for graphs
        '19. FDNG3 is a global array that contains labels for graphs
        '20. FDNG4 is a global array that contains labels for graphs

        Debug.WriteLine("gLoadForDisplaySaveLbls")

        '   Save variable name
        '   ------------------
        If sTitle > "" Then
            VARN(0, iColPosition) = sTitle
        Else
            VARN(0, iColPosition) = V$(idxVar)
        End If
        VARN(1, iColPosition) = V(idxVar)
        VARN(2, iColPosition) = VDef(idxVar)
        VARN(3, iColPosition) = VHelpID(idxVar)
        VARN(6, iColPosition) = VHelpIDEqn(idxVar)

        'this is for Validation
        If bGroups = True Then
            VARN(5, iColPosition) = "GROUP"
        Else
            VARN(5, iColPosition) = "REGION"
        End If

        If SensitivityFlag <> True Then
            VARN(0, iColPosition) = VARN(0, iColPosition) & "[" & LTrim$(CStr(vShortSce(idxFile))) & "]"
            VARN(1, iColPosition) = VARN(1, iColPosition) & "[" & LTrim$(Str$(idxFile)) & "]"
        End If

        'jrs 2012/04/26
        If VDim1(idxVar) > 0 Then
            GR1N(iColPosition) = sDim1
        Else
            GR1N(iColPosition) = ""
        End If
        If VDim2(idxVar) > 0 Then
            GR2N(iColPosition) = sDim2
        Else
            GR2N(iColPosition) = ""
        End If
        If VDim3(idxVar) > 0 Then
            GR3N(iColPosition) = sDim3
        Else
            GR3N(iColPosition) = ""
        End If

        If VCurrency(idxVar) Then
            gCurrencyLblSwitch(idxVar, iColPosition, CurrencySym, GR4N)
        Else
            GR4N(iColPosition) = VUnits(idxVar) 'Other Grid Values determined earlier
        End If

        'Flexible Dimension Names for Graphs
        FDNG1(iColPosition) = GR1N(iColPosition)
        FDNG2(iColPosition) = GR2N(iColPosition)
        FDNG3(iColPosition) = GR3N(iColPosition)
        FDNG4(iColPosition) = GR4N(iColPosition)

        Debug.WriteLine("gLoadForDisplaySaveLbls - end")
    End Sub

