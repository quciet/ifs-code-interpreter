            Next i
            'UPGRADE_WARNING: Couldn't resolve default property of object MAXCOM(VDim1(idx)). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            If i < MAXCOM(VDim1(idx)) + 1 Then
                Ptr = Ptr - 1
