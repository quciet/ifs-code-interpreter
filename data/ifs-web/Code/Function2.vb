        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "myWidth = document.body.clientWidth;" & vbCr
        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "myHeight = document.body.clientHeight;" & vbCr
