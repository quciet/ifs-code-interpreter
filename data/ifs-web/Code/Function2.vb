    Public Sub ReLoadRegionsandGroups(IFs_MDB2 As String)
        '   Read Region Names and Determine Number of Regions
        '   -------------------------------------------------

        Dim regcount = 0
        Dim msg = "There is an error in init, probably associated with opening IFs.mdb"
        'mtiwebforms April 2004 ADO.Net
        'db = DAODBEngine_definst.OpenDatabase(IFs_MDB2)
        'valtbl = db.OpenRecordset(RegionIDNew)
        Dim db1 As String
        Dim valtbl1 As DataTable
        Dim RCnt As Integer

        db1 = IFs_MDB2

        'jrs 2011/04/01 SetDataTablefromAccess(db1, "Select * from " + RegionIDNew, "PrimaryKey", valtbl1)
        Dim sISO As String
        'jrs 2011/08/02 added ESRI
        Dim sESRI As String
        'jrs 2022/06/23
        SetDataTablefromAccess(db1, "Select * FROM [Country Translation]", "", valtbl1)
        Dim bISO As Boolean = False
        bISO = valtbl1.Columns.Contains("ISO3166-2 Codes")

        If bISO Then
            SetDataTablefromAccess(db1, "Select *, (SELECT MAX([ISO3166-2 Codes]) FROM [Country Translation] c, " &
            Regionalization & " r WHERE c.Country = r.Country AND r.NewRegion = RegionNum) as ISO, " &
            "(SELECT MAX([ESRI Countries]) FROM [Country Translation] c, " &
            Regionalization & " r WHERE c.Country = r.Country AND r.NewRegion = RegionNum) as ESRI FROM " & RegionIDNew &
            " ORDER BY RegionNum", "", valtbl1)
        Else
            SetDataTablefromAccess(db1, "Select * FROM " & RegionIDNew &
            " ORDER BY RegionNum", "", valtbl1)
        End If

        IFsRegs = New MyRegions

        For RCnt = 0 To valtbl1.Rows.Count - 1
            regcount = regcount + 1
            GRPS(1, regcount) = valtbl1.Rows(RCnt).Item("regionname")
            RegName(regcount) = GRPS(1, regcount)
            If bISO Then
                sISO = IIf(IsDBNull(valtbl1.Rows(RCnt).Item("iso")), "", valtbl1.Rows(RCnt).Item("iso"))
                sESRI = IIf(IsDBNull(valtbl1.Rows(RCnt).Item("ESRI")), "", valtbl1.Rows(RCnt).Item("ESRI"))
            Else
                sISO = ""
                sESRI = ""
            End If
            If (valtbl1.Columns.Contains("regionalias")) Then
                IFsRegs.Add(RegName$(regcount), regcount, sISO, sESRI, IIf(IsDBNull(valtbl1.Rows(RCnt).Item("regionalias")), "", valtbl1.Rows(RCnt).Item("regionalias"))) 'jrs 2016/05/27
            Else
                IFsRegs.Add(RegName$(regcount), regcount, sISO, sESRI, "")
            End If
        Next

        MaxVal(1) = regcount + 1
        GRPS(1, MaxVal(1)) = "ALL"

        IFsCtrys = New MyRegions
        SetDataTablefromAccess(db1, "SELECT * FROM Economic ORDER BY country", "", valtbl1)
        For RCnt = 0 To valtbl1.Rows.Count - 1
            IFsCtrys.Add(valtbl1.Rows(RCnt).Item("Country"), RCnt + 1, "", "", "")
        Next RCnt

        '   Now that know maximum region numbers, dimension dynamic display arrays
        '   ----------------------------------------------------------------------

        NR = MaxVal(1) - 1 'Recomputed in FRM.RUN Load
        GDimsCount = GDimsCount + NR

        '   Read Country/Region Groupings
        '   -----------------------------

        msg = "There is an error in init, probably associated with opening IFs.mdb, 2nd"

        Dim valtbl As DataTable
        'jrs 2022/07/19
        If UseOnlySQLite Then
            SetDataTablefromAccess(IFs_MDB2, "SELECT * FROM " & GroupIDNew & " ORDER BY UPPER(GroupName)", "", valtbl)
        Else
            SetDataTablefromAccess(IFs_MDB2, "SELECT * FROM " & GroupIDNew & " ORDER BY GroupName", "", valtbl)
        End If
        ReDim Preserve GroupNames(valtbl.Rows.Count + 1)
        ReDim Preserve GroupCodes(valtbl.Rows.Count + 1)

        Dim eleloop = 0
        Do
            eleloop = eleloop + 1
            GroupNames(eleloop) = valtbl.Rows(eleloop - 1).Item("GroupName")
            GroupCodes(eleloop) = valtbl.Rows(eleloop - 1).Item("GroupNum")
            If eleloop = valtbl.Rows.Count Then Exit Do
        Loop
        GCount = eleloop
        GroupNames(eleloop + 1) = "ALL"

        SetDataTablefromAccess(IFs_MDB2, "SELECT * FROM " & GroupIDNew & " WHERE Core = TRUE ORDER BY GroupName", "", valtbl)
        If Not IsNothing(valtbl) Then
            ReDim Preserve CoreGroupNames(valtbl.Rows.Count + 1)
            eleloop = 0
            Do
                eleloop += 1
                CoreGroupNames(eleloop) = valtbl.Rows(eleloop - 1).Item("GroupName")
                If eleloop = valtbl.Rows.Count Then Exit Do
            Loop
            CGCount = eleloop
            CoreGroupNames(eleloop + 1) = "ALL"
        End If

        SetDataTablefromAccess(IFs_MDB2, "SELECT * FROM GListId ORDER BY Description", "", valtbl)
        ReDim Preserve GListNames(valtbl.Rows.Count + 1)

        eleloop = 0
        Do
            eleloop = eleloop + 1
            GListNames(eleloop) = valtbl.Rows(eleloop - 1).Item("Description")
            If eleloop = valtbl.Rows.Count Then Exit Do
        Loop
        GListCount = eleloop
    End Sub


    Public Sub ReadFromExcel(ByVal Msg As String, ByVal xlsFile As String, ByVal PopTbl As String,
    ByVal rr1 As Long, ByVal cc1 As Integer, ByVal RepCols As Integer,
    ByVal sFilterYr As String, ByVal DataCols As Integer, ByVal rscc1 As Integer, ByRef db As SQLiteConnection,
    ByVal sFilterSex As String, ByVal sWorksheet As String,
    ByVal CtryCol As Integer, ByVal dd1 As Integer, ByVal PutFdrvRun As String, Optional ByVal bSingleYear As Boolean = False)
        'rr1 is the initial row where to start reading the file
        'cc1 is the column for the years
        'RepCols is the # of columns to repit, right at the end (and filled with last value)
        'sFilterYr is the year to be used
        'DataCols is the # of columns to load
        'rscc1 is the position in the recordset of the first column with data
        'sFilterSex is the sex to be used
        'CtryCol Column where the country is stored
        'dd1 is the column where the data starts

        '            lblProgress.Caption = "Processing " & Msg

        Dim reader As IExcelDataReader
        Dim stream = File.Open(PutFdrvRun & xlsFile, FileMode.Open, FileAccess.Read)
        reader = ExcelDataReader.ExcelReaderFactory.CreateReader(stream)
        Dim conf = New ExcelDataSetConfiguration With {
        .ConfigureDataTable = Function(__) New ExcelDataTableConfiguration With {
            .UseHeaderRow = True
        }
    }
        Dim dataSet = reader.AsDataSet(conf)
        Dim dataTable = dataSet.Tables(sWorksheet)

        '    Dim rs As Recordset
        '    Set rs = db.OpenRecordset(PopTbl)
        '    rs.Index = "Country"

        Dim rr As Integer, cc As Integer
        Dim vv As Single, yy As String
        Dim sCtryUN As String, sCtry As String
        'jrs 2009/01/05
        Dim bFilter As Boolean
        Dim gg As String

        rr = rr1 - 2
        'jrs 2011/07/26
        Dim mm As Integer

        Dim vSQLiteCommand As SQLiteCommand
        Dim vSQLiteReader As SQLiteDataReader


        Do While True
            yy = dataTable.Rows(rr).ItemArray(cc1)
            'jrs 2011/07/26
            If yy = "" Then
                yy = dataTable.Rows(rr - 1).ItemArray(cc1)
                If yy = "" Then
                    yy = dataTable.Rows(rr - 2).ItemArray(cc1)
                End If
            End If
            'jrs 2009/01/05
            bFilter = (yy = sFilterYr)
            If bFilter And sFilterSex > "" Then
                gg = Trim(dataTable.Rows(rr).Item(cc1 + 1))
                bFilter = bFilter And (gg = sFilterSex)
            End If
            If bFilter Then
                'read country
                sCtryUN = dataTable.Rows(rr).ItemArray(CtryCol)
                'jrs 2011/07/26
                mm = 1
                Do While sCtryUN = "" And rr > mm
                    sCtryUN = dataTable.Rows(rr - mm).ItemArray(CtryCol)
                    mm = mm + 1
                Loop
                'translate
                vSQLiteCommand = db.CreateCommand()
                vSQLiteCommand.CommandText = "SELECT Country FROM [Country Translation] WHERE [UN Pop Countries] = """ & sCtryUN & """"
                vSQLiteReader = vSQLiteCommand.ExecuteReader()

                If vSQLiteReader.HasRows Then
                    vSQLiteReader.Read()
                    sCtry = vSQLiteReader(0)
                Else
                    'jrs 2026/03/06 try with the newer table
                    Dim vSQLiteCommandLong = db.CreateCommand()
                    vSQLiteCommandLong.CommandText = "SELECT Country FROM [Country Translation Long] WHERE [Alias] = """ & sCtryUN & """"
                    Dim vSQLiteReaderLong = vSQLiteCommandLong.ExecuteReader()
                    If vSQLiteReaderLong.HasRows Then
                        vSQLiteReaderLong.Read()
                        sCtry = vSQLiteReaderLong(0)
                    Else
                        sCtry = sCtryUN
                    End If
                End If
                'check country
                vSQLiteReader.Close()
                vSQLiteCommand.CommandText = "SELECT * FROM " & PopTbl & " WHERE Country = """ & sCtry & """"
                vSQLiteReader = vSQLiteCommand.ExecuteReader()

                If vSQLiteReader.HasRows Then
                    vSQLiteReader.Close()
                    Dim sUpd As String = "UPDATE " & PopTbl & " SET "
                    '[Value] = """ & Session("bCheckHideNonCoreGroups") & """ WHERE [Variable] = 'CoreGroups$'"
                    'Load all cohorts
                    For cc = dd1 To dd1 + DataCols - 1
                        vv = AMAX(dataTable.Rows(rr).ItemArray(cc), 0.002)
                        If cc > dd1 Then
                            sUpd = sUpd & ", "
                        End If
                        'jrs 2025/01/23
                        If bSingleYear Then
                            sUpd = sUpd & "Age" & (cc - (dd1 - rscc1) - 1).ToString & " = " & vv.ToString
                        Else
                            sUpd = sUpd & "Cohort" & (cc - (dd1 - rscc1)).ToString & " = " & vv.ToString
                        End If
                    Next cc
                    'remaining cohorts 85+
                    For cc = dd1 + DataCols To dd1 + DataCols + RepCols - 1
                        'jrs 2025/01/23
                        If bSingleYear Then
                            sUpd = sUpd & ", Age" & (cc - (dd1 - rscc1) - 1).ToString & " = " & AMAX(vv, 0.002).ToString
                        Else
                            sUpd = sUpd & ", Cohort" & (cc - (dd1 - rscc1)).ToString & " = " & AMAX(vv, 0.002).ToString
                        End If
                    Next cc
                    'WHERE statement
                    sUpd = sUpd & " WHERE Country = """ & sCtry & """"

                    vSQLiteCommand.CommandText = sUpd
                    'jrs 2024/04/17 vSQLiteCommand.ExecuteReader()
                    vSQLiteCommand.ExecuteNonQuery()
                End If

                'jrs 2023/03/20 Sahrawi not included in the UN database
                'jrs 2020/09/15 Taiwan is now in the UN database
                '            '*************************************************************************
                '            'Taiwan is the only country in the IFs set that is not in the UN database
                '            '*************************************************************************
                '            'Redo for Taiwan, using China
                'Redo for Sahrawi, using Mali
                '            'jrs 2009/06/23 using South Korea Instead
                '            'If sCtry = "China" Then
                '            If sCtry = "Korea, Republic of" Then
                'jrs 2026/03/06 Sahrawi is now included as Western Sahara in the UN database
                'If sCtry = "Mali" Then
                '    '                rs.Seek "=", "Taiwan, China"
                '    'rs.Seek "=", "Sahrawi Arab Democratic Republic"
                '    'check country
                '    'jrs 2024/04/17
                '    If Not vSQLiteReader.IsClosed Then
                '        vSQLiteReader.Close()
                '    End If
                '    vSQLiteCommand.CommandText = "SELECT * FROM " & PopTbl & " WHERE Country = ""Sahrawi Arab Democratic Republic"""
                '    vSQLiteReader = vSQLiteCommand.ExecuteReader()

                '    If vSQLiteReader.HasRows Then
                '        vSQLiteReader.Close()
                '        Dim sUpd As String = "UPDATE " & PopTbl & " SET "
                '        For cc = dd1 To dd1 + DataCols - 1
                '            vv = AMAX(dataTable.Rows(rr).ItemArray(cc), 0.002)
                '            If cc > dd1 Then
                '                sUpd = sUpd & ", "
                '            End If
                '            'jrs 2025/01/23
                '            If bSingleYear Then
                '                sUpd = sUpd & "Age" & (cc - (dd1 - rscc1) - 1).ToString & " = " & vv.ToString
                '            Else
                '                sUpd = sUpd & "Cohort" & (cc - (dd1 - rscc1)).ToString & " = " & vv.ToString
                '            End If
                '        Next cc
                '        'remaining cohorts 85+
                '        For cc = dd1 + DataCols To dd1 + DataCols + RepCols - 1
                '            'jrs 2025/01/23
                '            If bSingleYear Then
                '                sUpd = sUpd & ", Age" & (cc - (dd1 - rscc1) - 1).ToString & " = " & AMAX(vv, 0.002).ToString
                '            Else
                '                sUpd = sUpd & ", Cohort" & (cc - (dd1 - rscc1)).ToString & " = " & AMAX(vv, 0.002).ToString
                '            End If
                '        Next cc
                '        'WHERE statement
                '        sUpd = sUpd & " WHERE Country = ""Sahrawi Arab Democratic Republic"""

                '        vSQLiteCommand.CommandText = sUpd
                '        'jrs 2024/04/17 vSQLiteCommand.ExecuteReader()
                '        vSQLiteCommand.ExecuteNonQuery()
                '    End If
                'End If

            End If
            rr = rr + 1
            'jrs 2011/07/26
            'If dataTable.Rows(rr).ItemArray(cc1).ToString = "" And dataTable.Rows(rr + 1).ItemArray(cc1).ToString = "" And dataTable.Rows(rr + 2).ItemArray(cc1).ToString = "" Then Exit Do
            If dataTable.Rows.Count = rr Then Exit Do
        Loop

        reader.Close()
        stream.Close()

        'wb.Close()
        '            rs.Close

    End Sub

