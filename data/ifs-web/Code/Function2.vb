    'jrs 2010/07/21
    Public Function BuildInterceptSQL(ByVal iStart As Integer, ByVal bGlist As Boolean, ByRef lstDim As ListBox,
    ByRef DimIdxs As Object, ByRef currPage As System.Web.UI.Page, ByRef OnlyCoreGroups As Integer) As String 'cdv 2021/09/01 NEw argument for core groups
        Dim i As Integer, AuxIdx As Integer
        If bGlist Then
            BuildInterceptSQL = "SELECT * FROM GList d, GListId i WHERE i.Code = d.GListCode AND i.Description = """ & lstDim.Items(iStart).Text & """"

            For i = iStart + 1 To lstDim.Items.Count - 1
                If lstDim.Items(i).Selected Then
                    BuildInterceptSQL = BuildInterceptSQL & " AND EXISTS (SELECT * FROM GList, GListId WHERE GListId.Code = GList.GListCode AND GListId.Description = """ & lstDim.Items(i).Text & """ AND GList.Region = d.Region)"
                    'jrs 2016/01/11
                    ''jrs 2011/02/11
                    'AuxIdx = gGetGListIdx(lstDim.Items(i).Text, False, currPage)
                    'DimIdxs(AuxIdx - 1) = True
                    AuxIdx = i
                    DimIdxs(AuxIdx) = True
                End If
            Next i

            BuildInterceptSQL = BuildInterceptSQL & " ORDER BY MemberOrder, Region"
        Else
            'cdv 2021/09/01 Change SQL to only find Core Groups when needed
            If OnlyCoreGroups = 1 Then
                BuildInterceptSQL = "SELECT * FROM " & GroupIDNew & " i, " &
                            Grouping & " d WHERE Core = 1 AND i.GroupNum = d.GroupNo AND i.GroupName = """ &
                            lstDim.Items(iStart).Text & """"
            Else
                BuildInterceptSQL = "SELECT * FROM " & GroupIDNew & " i, " &
                Grouping & " d WHERE i.GroupNum = d.GroupNo AND i.GroupName = """ &
                lstDim.Items(iStart).Text & """"
            End If
            For i = iStart + 1 To lstDim.Items.Count - 1
                If lstDim.Items(i).Selected Then
                    BuildInterceptSQL = BuildInterceptSQL & " AND EXISTS (SELECT * FROM " & GroupIDNew & ", " &
                        Grouping & " WHERE " & GroupIDNew & ".GroupNum = " & Grouping & ".GroupNo AND " &
                        GroupIDNew & ".GroupName = """ & lstDim.Items(i).Text & """ AND " & Grouping & ".Region = d.Region)"

                    'jrs 2016/01/11 
                    ''jrs 2011/02/11
                    'AuxIdx = gGetGroupIdx(lstDim.Items(i).Text, False, currPage)
                    'DimIdxs(AuxIdx - 1) = True
                    AuxIdx = i
                    DimIdxs(AuxIdx) = True
                End If
            Next i

            BuildInterceptSQL = BuildInterceptSQL & " ORDER BY Region"
        End If
    End Function

