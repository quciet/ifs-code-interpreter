    'This function returns True if the field exist
    'the vb6 version also requires that the field has data in the current row, but that is not checked here
    Public Function checkField(ByVal Tbl As DataTable, ByVal iYr As Integer) As Boolean
        Dim i As Integer
        Dim v As Object
        checkField = False
        With Tbl
            'the last column should be MostRecent
            For i = .Columns.Count - 2 To 0 Step -1
                If IsNumeric(.Columns.Item(i).Caption) Then
                    If Int(.Columns.Item(i).Caption) = iYr Then
                        'v = .Fields(i).value
                        'If Not IsNull(v) Then
                        checkField = True
                        'End If
                        Exit Function
                    ElseIf Int(.Columns.Item(i).Caption) < iYr Then
                        Exit Function
                    End If
                End If
            Next i
        End With
    End Function

    'This procedure assumes there are 3 variables loaded for a set of regions
    'The 1st variable is in postion 1 to COUNTE/3, the 2nd var is from COUNTE/3+1 TO 2*/3*COUNTE
    'the last 3rd is used for bubble size, and should be used to order the rest
    Public Sub SortByBubbleSize(ByVal Rank_Year_IDX As Integer, ByVal COUNTE As Integer, ByRef PLOT As Object,
    ByRef GR1N As Object, ByRef VARN As Object, ByRef aFormulas As Object, ByRef FDNG1 As Object, ByRef FileNumbr As Object,
    ByRef FinYear As Object, ByRef FinYearHis As Object)
        'Create an array of columns
        Dim PlotRank() As DisplayColumn
        ReDim PlotRank(COUNTE / 3)
        Dim i As Integer, j As Integer

        For i = 1 To COUNTE / 3
            PlotRank(i) = New DisplayColumn
            PlotRank(i).Index = i
            j = i + 2 * COUNTE / 3 'only last 3rd of the plot
            PlotRank(i).Value = PLOT(Rank_Year_IDX, j)
            'jrs 2010/02/03 to break ties
            PlotRank(i).Value2 = GR1N(i)
        Next i
        'Sort the array
        QuickSortObj(PlotRank, 1, CInt(COUNTE / 3), False, True)

        'Copy source
        Dim pCopy As Object, VARNCopy As Object, gr1Copy As Object, fCopy As Object,
        FileNumbrCopy As Object, FinYearCopy As Object, FinYearHisCopy As Object,
        bNotDecomposablesCopy As Object, bLineFeedsCopy As Object,
        sGroupTitlesCopy As Object, sUsrDefCatsCopy As Object, DispDecimalsCopy As Object

        Dim FDNG1Copy As Object

        pCopy = VB6.CopyArray(PLOT)
        VARNCopy = VB6.CopyArray(VARN)
        gr1Copy = VB6.CopyArray(GR1N)
        fCopy = VB6.CopyArray(aFormulas)

        FDNG1Copy = VB6.CopyArray(FDNG1)

        FileNumbrCopy = VB6.CopyArray(FileNumbr)
        FinYearCopy = VB6.CopyArray(FinYear)
        FinYearHisCopy = VB6.CopyArray(FinYearHis)

        'bNotDecomposablesCopy = bNotDecomposables
        'bLineFeedsCopy = bLineFeeds
        'sGroupTitlesCopy = sGroupTitles
        'sUsrDefCatsCopy = sUsrDefCats
        'DispDecimalsCopy = DispDecimals

        'Reset Target
        Dim k As Integer, x As Integer, T As Integer
        'jrs 2008/03/24
        Dim focus As Integer
        For i = 1 To COUNTE / 3
            For x = 1 To 3
                'Adjustment
                Select Case x
                    Case 1
                        T = 0
                    Case 2
                        T = COUNTE / 3
                    Case 3
                        T = 2 * COUNTE / 3
                End Select
                'source index
                k = PlotRank(i).Index
                'copy to target
                For j = 0 To UBound(PLOT, 1)
                    PLOT(j, i + T) = pCopy(j, k + T)
                Next j

                For j = 0 To UBound(VARN, 1)
                    VARN(j, i + T) = VARNCopy(j, k + T)
                Next j
                GR1N(i + T) = gr1Copy(k + T)
                If k + T <= UBound(fCopy) Then
                    If i + T > UBound(aFormulas) Then
                        ReDim Preserve aFormulas(i + T)
                    End If
                    aFormulas(i + T) = fCopy(k + T)
                End If
                FDNG1(i + T) = FDNG1Copy(k + T)
                FileNumbr(i + T) = FileNumbrCopy(k + T)
                FinYear(i + T) = FinYearCopy(k + T)
                FinYearHis(i + T) = FinYearHisCopy(k + T)
                'bNotDecomposables(i + T) = bNotDecomposablesCopy(k + T)
                'bLineFeeds(i + T) = bLineFeedsCopy(k + T)
                'sGroupTitles(i + T) = sGroupTitlesCopy(k + T)
                'sUsrDefCats(i + T) = sUsrDefCatsCopy(k + T)
                'DispDecimals(i + T) = DispDecimalsCopy(k + T)
            Next x
        Next i
    End Sub

    'jrs 2011/04/06
    Public Sub PrepareTransformForStatistics(ByVal regCount As Integer, ByVal VarsICount As Integer, ByRef RVarD As Object, ByRef RVarI As Object,
    ByVal sVarNameD As String, ByRef sVarNameI As Object, ByVal IFsStat_MDB As String, ByRef Total_Records As Integer, ByRef Total_Var As Integer)

        If VarsICount > 5 Then
            VarsICount = 5
        End If

        '   Open the database and delete the temporary table
        '   ------------------------------------------------
        updateAccessWith1Command(IFsStat_MDB, "Drop table Statistics_Temp")

        '   Create the temporary table again
        '   --------------------------------
        Dim CreateQuery As String
        CreateQuery = "Create table Statistics_Temp ([Region] Text, [Dependent] Double"

        Dim iCount As Integer, IndLabel As String
        For iCount = 1 To 5  'Establish 5 fields, just in case
            CreateQuery = CreateQuery & ", [Independent" & Trim(Str(iCount)) & "] Double"
        Next iCount
        CreateQuery = CreateQuery & ")"

        updateAccessWith1Command(IFsStat_MDB, CreateQuery)

        '   Open the database again and add the data from SCVAR
        '   ---------------------------------------------------

        Dim tbl9 As DataTable, nrow As DataRow
        SetDataTablefromAccess(IFsStat_MDB, "Select * from Statistics_Temp", "", tbl9)
        Dim indvars As Integer, aloop As Integer
        With tbl9
            For aloop = 1 To regCount
                nrow = .NewRow()
                nrow.BeginEdit()
                nrow.Item("Region") = aloop
                'jrs 2013/03/22
                If IsNumeric(RVarD(aloop)) Then
                    nrow.Item("Dependent") = RVarD(aloop)
                Else
                    nrow.Item("Dependent") = DBNull.Value
                End If

                indvars = 0
                For iCount% = 0 To VarsICount - 1
                    indvars = indvars + 1
                    IndLabel$ = "Independent" & Trim$(Str$(indvars))
                    If IsNothing(RVarI(aloop%, iCount%)) Then
                        nrow.Item(IndLabel$) = DBNull.Value
                    Else
                        nrow.Item(IndLabel$) = RVarI(aloop%, iCount%)
                    End If
                Next iCount%
                nrow.EndEdit()
                .Rows.Add(nrow)
            Next aloop
        End With

        WriteDataTable2Access(IFsStat_MDB, "Select * from Statistics_Temp", tbl9, "Insert")
        tbl9 = Nothing

        '   Add the variable names
        '   ----------------------
        Dim newtbl As DataTable
        SetDataTableforUpdate(IFsStat_MDB, "SELECT * FROM Var_Names", "Delete FROM Var_Names", tbl9, newtbl)

        newtbl.Rows.Clear()
        Dim i As Integer
        i = 0
        tbl9.Rows(i).Item("Var_Name") = sVarNameD
        tbl9.Rows(i).Item("Var_Type") = "Dependent"
        For aloop% = 1 To indvars
            i = i + 1
            tbl9.Rows(i).Item("Var_Name") = sVarNameI(aloop% - 1)
            tbl9.Rows(i).Item("Var_Type") = "Independent"
        Next aloop%

        For i = 0 To tbl9.Rows.Count - 1
            nrow = newtbl.NewRow
            nrow.ItemArray = tbl9.Rows(i).ItemArray
            newtbl.Rows.Add(nrow)
        Next
        WriteDataTable2Access(IFsStat_MDB, "Select * from Var_Names", newtbl, "Insert")


        '   Set the temporary variables needed for statistics
        '   -------------------------------------------------

        Total_Records = regCount
        Total_Var = indvars


    End Sub

    'jrs 2020/10/05
    Public Sub PrepareTransformPyForStatistics(ByVal regCount As Integer, ByVal VarsICount As Integer, ByRef RVarD As Object, ByRef RVarI As Object,
    ByVal sVarNameD As String, ByRef sVarNameI As Object, ByVal IFsStat_MDB As String, ByRef Total_Records As Integer, ByRef Total_Var As Integer,
    ByRef ValidData As Object, ByRef AllValidPoints As Integer, ByRef VarNameD As String, ByRef VarNameI As String())

        If VarsICount > 5 Then
            VarsICount = 5
        End If

        AllValidPoints = regCount
        ReDim ValidData(regCount, 6)

        Dim indvars As Integer = 0
        For aloop = 1 To regCount
            If IsNumeric(RVarD(aloop)) Then
                ValidData(aloop - 1, 1) = RVarD(aloop)
            Else
                ValidData(aloop - 1, 1) = DBNull.Value
            End If

            Dim IndLabel As String
            indvars = 0
            For iCount% = 0 To VarsICount - 1
                indvars = indvars + 1
                IndLabel$ = "Independent" & Trim$(Str$(indvars))
                If IsNothing(RVarI(aloop%, iCount%)) Then
                    ValidData(aloop - 1, iCount% + 2) = DBNull.Value
                Else
                    ValidData(aloop - 1, iCount% + 2) = RVarI(aloop%, iCount%)
                End If
            Next iCount%
        Next aloop

        Total_Var = indvars
        ReDim VarNameI(Total_Var)

        '   Add the variable names
        '   ----------------------
        Dim i As Integer
        i = 0
        VarNameD = sVarNameD
        For aloop% = 1 To indvars
            i = i + 1
            VarNameI(aloop% - 1) = sVarNameI(aloop% - 1)
        Next aloop%


        '   Set the temporary variables needed for statistics
        '   -------------------------------------------------

        Total_Records = regCount
        Total_Var = indvars


    End Sub

    Public Sub gLoadEdnCostDisp(ByVal trgtRate As Single, ByVal trgtStartYr As Integer, ByVal trgtEndYr As Integer,
    ByVal RateVar As String, ByVal NetRateVar As String, ByVal RateType As String, ByVal TotVar As String, ByVal UnitCostVar As String, ByVal TotCostVar As String,
    ByVal Dim1 As String, ByVal Dim2 As String, ByVal fileIdx As Integer, ByVal bGrp As Boolean,
    ByVal ShowUnitCost As Boolean, ByVal GDPPcnt As Boolean, ByVal GOVCONPcnt As Boolean,
    ByVal EnrDiff As Boolean, ByVal StudentsDiff As Boolean, ByVal ShowAll As Boolean,
    ByVal ShowCostDifffromPop As Boolean, ByVal UseFlatEnr As Boolean, ByVal UseFlatCost As Boolean,
    ByRef PLOT As Object, ByRef COUNTE As Object, ByVal FirstYear As Integer, ByVal LastYear As Integer,
    ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object,
    ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef RunFiles As Object,
    ByRef PutFdrvRun As String, ByRef vShortSce As Object, ByRef FileforDisplay As Integer, ByRef FinYear As Object,
    ByVal IFs_MDB2Active As String, ByVal CurrencyVal As Single, ByRef CurrencySym As String, ByRef SensitivityFlag As Object)
        'mti April 2008 New

        Dim i As Integer
        Dim TmpCountE As Integer


        Dim TOTSTDNT() As Single, UNITCOST() As Single, ENRRATE() As Single, ENRRATEN() As Single ', TOTCOST() As Single
        Dim GDP() As Single, POP() As Single, GOVCON() As Single
        Dim GDPSUM() As Single, POPSUM() As Single, GOVCONSUM() As Single
        Dim TOTCHILDREN() As Single



        Dim COSTDIFFSUM() As Single, COSTEXSTSUM() As Single, COSTREQDSUM() As Single, UNITCOSTSUM() As Single

        Dim ENRRDIFFSUM() As Single, ENRREXSTSUM() As Single, ENRRREQDSUM() As Single

        Dim STDNTDIFFSUM() As Single, STDNTEXSTSUM() As Single, STDNTREQDSUM() As Single

        Dim COSTDIFF_POPSUM() As Single


        ReDim TOTSTDNT(LastYear - FirstYear + 1),
                UNITCOST(LastYear - FirstYear + 1),
                ENRRATE(LastYear - FirstYear + 1),
                ENRRATEN(LastYear - FirstYear + 1)

        ReDim GDP(LastYear - FirstYear + 1),
                POP(LastYear - FirstYear + 1),
                    GOVCON(LastYear - FirstYear + 1)

        ReDim GDPSUM(LastYear - FirstYear + 1),
                POPSUM(LastYear - FirstYear + 1),
                    GOVCONSUM(LastYear - FirstYear + 1),
                        TOTCHILDREN(LastYear - FirstYear + 1)



        ReDim COSTDIFFSUM(LastYear - FirstYear + 1),
                COSTEXSTSUM(LastYear - FirstYear + 1),
                COSTREQDSUM(LastYear - FirstYear + 1),
                UNITCOSTSUM(LastYear - FirstYear + 1)

        ReDim ENRRDIFFSUM(LastYear - FirstYear + 1),
                ENRREXSTSUM(LastYear - FirstYear + 1),
                ENRRREQDSUM(LastYear - FirstYear + 1)


        ReDim STDNTDIFFSUM(LastYear - FirstYear + 1),
                STDNTEXSTSUM(LastYear - FirstYear + 1),
                STDNTREQDSUM(LastYear - FirstYear + 1)

        ReDim COSTDIFF_POPSUM(LastYear - FirstYear + 1)

        '            Dim NInv As Single, meanbackcalc As Single, NSNARATI2 As Single
        'jrs 2007/03/30 changing group logic, to compute regions individually and then add them up
        Dim sDim1 As String, grpIdx As Integer, TimeGap As Integer

        TimeGap = trgtEndYr - trgtStartYr

        Dim gCountGroupMembers As Integer
        Dim gGroupMembers() As String, gGroupMembersPtrs() As Integer, gGroupMemberWeights() As Single
        If bGrp Then
            gLoadGroupMembers(Dim1, POPidx, 1, 1, gCountGroupMembers, IFs_MDB2Active, gGroupMembers,
                    gGroupMembersPtrs, gGroupMemberWeights)
            grpIdx = 1
        End If

        Dim calcENRRExst As Single, calcENRRReqd As Single, TotalSchoolAge As Single, sTotalSchoolAge As Single
        Dim BaseRate As Single, FlatEnrRate As Single, BaseUnitCost As Single, BaseCalcUnitCost As Single
        Dim BaseSchoolAge As Single, calcUnitCostExst As Single, calcENRRDiff As Single, calcSTDNTExst As Single
        Dim calcSTDNTReqd As Single, calcSTDNTDiff As Single, calcCOSTExst As Single, calcCOSTReqd As Single
        Dim calcCOSTDiff As Single, calcSTDNTExst_LastPop As Single, calcSTDNTDiff_Pop As Single
        Dim calcCOSTDiff_POP As Single, TimePassed As Single, ReqdRate As Single, GrossNetDiff As Single
        Dim AvgUnitCostExst As Single
        Dim tgtStr As String, diffStr As String, demogstr As String

        Dim MyFileforDisplay As IStorage
        Dim MyDF, MyDFU, MyDFR, MyDFN, MyDFG, MyDFP, MyDFGC As IDataframe

        Do While True
            If bGrp Then
                sDim1 = gGroupMembers(grpIdx)
            Else
                sDim1 = Dim1
            End If
            'cdv 2021/03/09 All of the gLoadForDisplay has been updated to use the correct function based off StandAloneMode
            If StandAloneMode Then
                gLoadForDisplayNET(TotVar, -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, True, False, False, 1, TOTSTDNT, 1,
            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF)
            Else
                gLoadForDisplay(TotVar, -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, True, False, False, 1, TOTSTDNT, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If
            If StandAloneMode Then
                gLoadForDisplayNET(UnitCostVar, -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, UNITCOST, 1,
            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFU)
            Else
                gLoadForDisplay(UnitCostVar, -1, sDim1, -1, "", -1, "", -1, "", fileIdx, False, False, False, 1, UNITCOST, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If
            If StandAloneMode Then
                gLoadForDisplayNET(RateVar, -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, ENRRATE, 1,
            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFR)
            Else
                gLoadForDisplay(RateVar, -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, ENRRATE, 1,
                1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If
            If NetRateVar <> "" Then
                If StandAloneMode Then
                    gLoadForDisplayNET(NetRateVar, -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, ENRRATEN, 1,
        1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
        FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFN)
                Else
                    gLoadForDisplay(NetRateVar, -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, ENRRATEN, 1,
                    1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                    FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
                End If
            End If
            If StandAloneMode Then
                gLoadForDisplayNET("GDP", -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, GDP, 1,
            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFG)
            Else
                gLoadForDisplay("GDP", -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, GDP, 1,
                    1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                    FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If
            If StandAloneMode Then
                gLoadForDisplayNET("POP", -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, POP, 1,
            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFP)
            Else
                gLoadForDisplay("POP", -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, False, False, 1, POP, 1,
                    1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                    FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If
            If StandAloneMode Then
                gLoadForDisplayNET("GOVCON", -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, True, False, 1, GOVCON, 1,
            1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
            FinYear, IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDFGC)
            Else
                gLoadForDisplay("GOVCON", -1, sDim1, -1, Dim2, -1, "", -1, "", fileIdx, False, True, False, 1, GOVCON, 1,
                    1, FirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce,
                    FileforDisplay, FinYear, IFs_MDB2Active, CurrencyVal)
            End If

            i = 1

            For i = 1 To LastYear - FirstYear + 1

                '                If I = 16 Then Stop

                If TOTSTDNT(i) = 0 Then Exit For
                If UNITCOST(i) = 0 Then Exit For

                'Scale-up cost = (Goal level (e.g. 100) � MIN(variable level such as gross enrollment, goal level)) * cost per student

                If RateType = "Gross" Or RateType = "Both" Then
                    calcENRRExst = ENRRATE(i)
                    calcENRRReqd = calcENRRExst ' TOTCOST(I) '* 1000 'convert to million $
                Else 'net
                    calcENRRExst = ENRRATEN(i)
                    calcENRRReqd = calcENRRExst  ' TOTCOST(I) '* 1000 'convert to million $
                End If

                TotalSchoolAge = 100 * TOTSTDNT(i) / ENRRATE(i)  'millions of school age children
                If i = 1 Then 'first year
                    sTotalSchoolAge = TotalSchoolAge
                End If

                If i = trgtStartYr - FirstYear% + 1 Then 'project onset
                    If RateType = "Net" Then 'Or RateType = "Both" Then
                        BaseRate = ENRRATEN(i)
                        FlatEnrRate = BaseRate
                    ElseIf RateType = "Gross" Then 'Gross
                        BaseRate = ENRRATE(i)
                        FlatEnrRate = BaseRate
                    Else  'using both
                        BaseRate = ENRRATEN(i)  'base rate for target interpolation (net)
                        FlatEnrRate = ENRRATE(i) 'flat projection of enrollment (gross)
                    End If
                    BaseUnitCost = UNITCOST(i)
                    BaseCalcUnitCost = 10 * UNITCOST(i) * GDP(i) / POP(i) 'UNITCOST in  (constant) dollars
                    BaseSchoolAge = TotalSchoolAge
                End If

                'calcUnitCostExst = UNITCOST(I)

                'convert relative per student cost, as % of GDPPC,  to (constant) dollar
                calcUnitCostExst = 10 * UNITCOST(i) * GDP(i) / POP(i)

                'convert relative per student cost, as % of GDPPC,  to thousand dollar
                'calcUnitCostExst = UNITCOST(i) * GDP(i) / POP(i) / 100

                If i > trgtStartYr - FirstYear% + 1 Then

                    'use constant latest enrollment rates as forecast
                    If UseFlatEnr Then
                        calcENRRExst = FlatEnrRate 'BaseRate
                        calcENRRReqd = calcENRRExst
                    End If
                    'use constant latest Costs
                    If UseFlatCost Then
                        calcUnitCostExst = BaseCalcUnitCost
                        UNITCOST(i) = BaseUnitCost
                    End If
                End If



                calcENRRDiff = calcENRRReqd - calcENRRExst



                '                    If RateType = "Gross" Or RateType = "Both" Then
                '                        calcSTDNTExst = TotalSchoolAge * calcENRRExst / 100
                '                        calcSTDNTReqd = calcSTDNTExst ' TOTCOST(I) '* 1000 'convert to million $
                '                    Else 'net
                calcSTDNTExst = TotalSchoolAge * calcENRRExst / 100  'millions
                calcSTDNTReqd = calcSTDNTExst


                '                    End If

                calcSTDNTDiff = calcSTDNTReqd - calcSTDNTExst 'millions

                '                    'student diffferential just due to demographic change
                '                    calcSTDNTReqd_FlatPop = BaseSchoolAge * calcENRRReqd / 100  'students at required rate for target chasing but at no population change from project onset
                '                    calcSTDNTDiff_Pop = calcSTDNTReqd - calcSTDNTReqd_FlatPop  'additional students coming from population change


                'student diffferential just due to demographic change
                '                    calcSTDNTExst_FlatPop = BaseSchoolAge * calcENRRExst / 100  'students at required rate for target chasing but at no population change from project onset
                '                    calcSTDNTDiff_Pop = calcSTDNTExst - calcSTDNTExst_FlatPop 'additional students coming from population change

                'cost differential for chasing target
                calcCOSTExst = calcUnitCostExst * calcSTDNTExst 'dollar x millions of students= millions
                calcCOSTReqd = calcUnitCostExst * calcSTDNTReqd
                calcCOSTDiff = calcCOSTReqd - calcCOSTExst



                'student diffferential just due to demographic change from the previous; with the existing (base/scenario) enrollment rate
                calcSTDNTExst_LastPop = sTotalSchoolAge * calcENRRExst / 100  '(million) students at existing (base/scen) enrollment rate but previous population rate
                calcSTDNTDiff_Pop = calcSTDNTExst - calcSTDNTExst_LastPop 'additional students coming from population change



                'cost diffferential just due to demographic change
                calcCOSTDiff_POP = calcSTDNTDiff_Pop * calcUnitCostExst  'dollar x millions of students= millions

                If i > trgtStartYr - FirstYear% + 1 Then 'years before target start
                    'continue at goal rate (reached now) after the target is reached

                    '                        If RateType = "Gross" Or RateType = "Both" Then
                    '                            ExstRate = ENRRATE(I)
                    '                        Else 'Net
                    '                            ExstRate = ENRRATEN(I)
                    '                        End If

                    If trgtRate > calcENRRExst Then
                        'interpolate to target
                        TimePassed = i - (trgtStartYr - FirstYear% + 1)
                        ReqdRate = BaseRate + (trgtRate - BaseRate) * Amin(1, (TimePassed / TimeGap))

                        If RateType = "Both" Then
                            GrossNetDiff = ENRRATE(i) - ENRRATEN(i)
                            ReqdRate = ReqdRate + GrossNetDiff
                        End If

                        If ReqdRate > calcENRRExst Then
                            'calcSTDNTExst = TOTSTDNT(I)
                            calcSTDNTReqd = ReqdRate * calcSTDNTExst / calcENRRExst
                            calcSTDNTDiff = calcSTDNTReqd - calcSTDNTExst

                            'calcCOSTExst = UNITCOST(I) * calcSTDNTExst
                            calcCOSTReqd = calcUnitCostExst * calcSTDNTReqd
                            calcCOSTDiff = calcCOSTReqd - calcCOSTExst

                            'calcENRRExst = ExstRate 'ENRRATE(I)
                            calcENRRReqd = ReqdRate  ' TOTCOST(I) '* 1000 'convert to million $
                            calcENRRDiff = calcENRRReqd - calcENRRExst

                            '                                'student diffferential just due to demographic change
                            '                                calcSTDNTReqd_FlatPop = BaseSchoolAge * calcENRRReqd / 100  'students at required rate for target chasing but at no population change from project onset
                            '                                calcSTDNTDiff_Pop = calcSTDNTReqd - calcSTDNTReqd_FlatPop  'additional students coming from population change

                            'student diffferential just due to demographic change
                            '                                calcSTDNTExst_FlatPop = BaseSchoolAge * calcENRRExst / 100  'students at required rate for target chasing but at no population change from project onset
                            '                                calcSTDNTDiff_Pop = calcSTDNTExst - calcSTDNTExst_FlatPop 'additional students coming from population change

                            'student diffferential just due to demographic change - year to year
                            calcSTDNTExst_LastPop = sTotalSchoolAge * calcENRRExst / 100  'students at required rate for target chasing but at no population change from project onset
                            calcSTDNTDiff_Pop = calcSTDNTExst - calcSTDNTExst_LastPop 'additional students coming from population change


                            'cost diffferential just due to demographic change
                            calcCOSTDiff_POP = calcSTDNTDiff_Pop * calcUnitCostExst  'reqd cost is same till now?


                        End If


                    End If 'lse
                End If


                If bGrp Then
                    If grpIdx = 1 Then

                        COSTDIFF_POPSUM(i) = 0

                        UNITCOSTSUM(i) = 0

                        COSTDIFFSUM(i) = 0
                        COSTEXSTSUM(i) = 0
                        COSTREQDSUM(i) = 0

                        ENRRDIFFSUM(i) = 0
                        ENRREXSTSUM(i) = 0
                        ENRRREQDSUM(i) = 0

                        STDNTDIFFSUM(i) = 0
                        STDNTEXSTSUM(i) = 0
                        STDNTREQDSUM(i) = 0

                        GOVCONSUM(i) = 0
                        GDPSUM(i) = 0

                        POPSUM(i) = 0

                        TOTCHILDREN(i) = 0

                    End If

                    'If grpIdx = gCountGroupMembers Then
                    TmpCountE = COUNTE - 1
                    UNITCOSTSUM(i) = UNITCOSTSUM(i) + UNITCOST(i) * POP(i) '+ calcUnitCostExst * POP(i)
                    POPSUM(i) = POPSUM(i) + POP(i)
                    AvgUnitCostExst = UNITCOSTSUM(i) / POPSUM(i) 'grpIdx
                    '                   If I = 1 Then Stop
                    If ShowUnitCost Then
                        'unit cost at base case/scenario forecast- dollars
                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = AvgUnitCostExst

                    End If


                    If ShowAll Then
                        'total cost at base case/scenario forecast- million dollars
                        TmpCountE = TmpCountE + 1

                        If grpIdx = 1 Then
                            PLOT(i, TmpCountE) = 0
                        End If

                        COSTEXSTSUM(i) = COSTEXSTSUM(i) + calcCOSTExst
                        PLOT(i, TmpCountE) = COSTEXSTSUM(i)

                        'total cost required to mee the goal - million dollars
                        TmpCountE = TmpCountE + 1
                        'don't need it now!
                        If grpIdx = 1 Then
                            PLOT(i, TmpCountE) = 0
                        End If

                        COSTREQDSUM(i) = COSTREQDSUM(i) + calcCOSTReqd
                        PLOT(i, TmpCountE) = COSTREQDSUM(i)

                    End If


                    'additional cost to mee the goal- million dollars
                    TmpCountE = TmpCountE + 1
                    COSTDIFFSUM(i) = COSTDIFFSUM(i) + calcCOSTDiff
                    PLOT(i, TmpCountE) = COSTDIFFSUM(i)

                    If ShowCostDifffromPop Then
                        'additional cost from population to mee the goal- million dollars
                        TmpCountE = TmpCountE + 1
                        COSTDIFF_POPSUM(i) = COSTDIFF_POPSUM(i) + calcCOSTDiff_POP
                        PLOT(i, TmpCountE) = COSTDIFF_POPSUM(i)
                    End If

                    If GDPPcnt Then
                        GDPSUM(i) = GDPSUM(i) + GDP(i) 'billion $
                        If ShowAll Then
                            'total cost at base case/scenario forecast- million dollars
                            TmpCountE = TmpCountE + 1
                            PLOT(i, TmpCountE) = COSTEXSTSUM(i) / GDPSUM(i) / 10

                            'total cost required to mee the goal - million dollars
                            TmpCountE = TmpCountE + 1
                            PLOT(i, TmpCountE) = COSTREQDSUM(i) / GDPSUM(i) / 10

                        End If

                        'cost diff(million$) as % of GDP(billion$)
                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = COSTDIFFSUM(i) / GDPSUM(i) / 10
                    End If

                    If GOVCONPcnt Then
                        GOVCONSUM(i) = GOVCONSUM(i) + GOVCON(i) 'billion $
                        If ShowAll Then
                            'total cost at base case/scenario forecast- million dollars
                            TmpCountE = TmpCountE + 1
                            PLOT(i, TmpCountE) = COSTEXSTSUM(i) / GOVCONSUM(i) / 10

                            'total cost required to mee the goal - million dollars
                            TmpCountE = TmpCountE + 1
                            PLOT(i, TmpCountE) = COSTREQDSUM(i) / GOVCONSUM(i) / 10

                        End If

                        'show cost diff(million$) as % of GOVCON(billion$)
                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = COSTDIFFSUM(i) / GOVCONSUM(i) / 10
                    End If

                    'students, existing, existing  plus additional and differential
                    STDNTEXSTSUM(i) = STDNTEXSTSUM(i) + calcSTDNTExst
                    STDNTDIFFSUM(i) = STDNTDIFFSUM(i) + calcSTDNTDiff
                    STDNTREQDSUM(i) = STDNTREQDSUM(i) + calcSTDNTReqd

                    'add country/region total children to group total
                    TOTCHILDREN(i) = TOTCHILDREN(i) + 100 * calcSTDNTExst / calcENRRExst 'ENRRATE(I)

                    If EnrDiff Then

                        If ShowAll Then
                            'total cost at base case/scenario forecast- million dollars
                            TmpCountE = TmpCountE + 1

                            If grpIdx = 1 Then
                                PLOT(i, TmpCountE) = 0
                            End If

                            ENRREXSTSUM(i) = 100 * STDNTEXSTSUM(i) / TOTCHILDREN(i)
                            PLOT(i, TmpCountE) = ENRREXSTSUM(i)

                            'total cost required to mee the goal - million dollars
                            TmpCountE = TmpCountE + 1
                            If grpIdx = 1 Then
                                PLOT(i, TmpCountE) = 0
                            End If

                            ENRRREQDSUM(i) = 100 * STDNTREQDSUM(i) / TOTCHILDREN(i)
                            PLOT(i, TmpCountE) = ENRRREQDSUM(i)

                        End If


                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = 100 * STDNTDIFFSUM(i) / TOTCHILDREN(i)
                    End If



                    If StudentsDiff Then

                        If ShowAll Then
                            'total cost at base case/scenario forecast- million dollars
                            TmpCountE = TmpCountE + 1

                            If grpIdx = 1 Then
                                PLOT(i, TmpCountE) = 0
                            End If

                            PLOT(i, TmpCountE) = STDNTEXSTSUM(i)

                            'total cost required to mee the goal - million dollars
                            TmpCountE = TmpCountE + 1
                            If grpIdx = 1 Then
                                PLOT(i, TmpCountE) = 0
                            End If

                            PLOT(i, TmpCountE) = STDNTREQDSUM(i)

                        End If


                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = STDNTDIFFSUM(i)

                    End If


                Else  'region/country

                    TmpCountE = COUNTE - 1

                    If ShowUnitCost Then
                        'unit cost at base case/scenario forecast- dollars
                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = UNITCOST(i)  'new unit percentage of GDPPC  'calcUnitCostExst

                    End If


                    If ShowAll Then
                        'total cost at base case/scenario forecast- million dollars
                        TmpCountE = TmpCountE + 1
                        PLOT(i, TmpCountE) = calcCOSTExst

