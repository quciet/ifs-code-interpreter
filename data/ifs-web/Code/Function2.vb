    'jrs 2023/01/12
    Private Function IsValidGList(ByRef ErrorText As String, sGListName As String, PutFdrvRun As String) As Boolean
        ErrorText = ""
        Dim firstChar = sGListName.Chars(0)
        If sGListName = "" Then
            ErrorText = "<script>alert('Please enter a name for the G-List');</script>"
            Return False
        End If
        If sGListName.Length > 35 Then
            ErrorText = "<script>alert('That G-List name is too long, please shorten it');</script>"
            Return False
        End If
        If sGListName.Contains(",") Then
            ErrorText = "<script>alert('G-List Names can\'t contain commas');</script>"
            Return False
        End If
        If sGListName.Contains("""") Then
            ErrorText = "<script>alert('G-List Names can\'t contain double quotes');</script>"
            Return False
        End If
        'anf 2022/10/19 ****START****
        If sGListName.Contains("'") Then
            ErrorText = "<script>alert('G-List Names can\'t contain single quotes');</script>"
            Return False
        End If
        If (firstChar = " ") Then 'first char - space
            ErrorText = "<script>alert('G-List Names can\'t begin with space');</script>"
            Return False
        End If
        If Char.IsSymbol(firstChar) Or firstChar = "!" Or firstChar = "@" Or firstChar = "#" Or firstChar = "<" Or firstChar = ">" Or firstChar = "?" Or firstChar = "%" Or firstChar = "&" Or firstChar = "*" Then 'first char - symbol
            ErrorText = "<script>alert('G-List Names can\'t begin with symbols');</script>"
            Return False
        End If
        If Char.IsDigit(firstChar) Then 'first char - numeric, remining - empty
            Dim i As Integer
            For i = 1 To sGListName.Length - 1
                If Char.IsLetter(sGListName.Chars(i)) Then
                    Exit For
                End If
            Next
            If i = sGListName.Length And Char.IsLetter(sGListName.Chars(i - 1)) = False Then
                ErrorText = "<script>alert('Please enter at least one letter.');</script>"
                Return False
            End If
        End If
        'anf 2022/10/19 ****END****
        Dim rsL As DataTable
        'jrs 2025/09/23 SetDataTablefromSQLite(PutFdrvRun & "IFs.db", "SELECT Description FROM GListId WHERE Description = '" & sGListName & "'", "", rsL)
        'Make it case insensitive
        SetDataTablefromSQLite(PutFdrvRun & "IFs.db", "SELECT Description FROM GListId WHERE UPPER(Description) = '" & sGListName.ToUpper & "'", "", rsL)
        If rsL.Rows.Count > 0 Then
            ErrorText = "<script>alert('Please change the name to a unique name');</script>"
            Return False
        End If
        Return True
    End Function

    'jrs 2023/01/12
    Public Sub AddGList(ByRef ErrorText As String, sGListName As String, PutFdrvRun As String, myResponse As HttpResponse)
        If IsValidGList(ErrorText, sGListName, PutFdrvRun) = False Then
            myResponse.Write(ErrorText)
            ErrorText = ""
            Exit Sub
        End If
        Dim getID = "SELECT MAX(Code) FROM GListId"
        Dim rsL As DataTable
        SetDataTablefromSQLite(PutFdrvRun & "IFs.db", getID, "", rsL)
        Dim ID = rsL.Rows(0).Item(0) + 1
        ErrorText = ID.ToString
        Dim strConnection As String = "Data Source=" & PutFdrvRun & "IFs.db;"
