                                                                                        'jrs 2019/11/12 it was repeating the move for every forecast by others
                                                                                        'needs to do it only once, so saving StaYearHis
                                                                                        StaYearHis(jj) = StaYearHis(COUNTE)
                                                                                    End If
                                                                                Next jj
                                                                            End If
                                                                            'jrs 2019/07/29 *** end ***
                                                                        End If
