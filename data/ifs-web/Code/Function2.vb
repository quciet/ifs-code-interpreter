    Public Sub FileCopyCheck(ByRef InFile As String, ByRef OutFile As String)

        _logger.Debug("FileCopyCheck " + InFile + " - " + OutFile)
        Dim FDT2 As Object
        Dim FDT1 As Object
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        'On Error GoTo copy
        Try
            'UPGRADE_WARNING: Couldn't resolve default property of object FDT1. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            FDT1 = FileDateTime(OutFile)
            'UPGRADE_WARNING: Couldn't resolve default property of object FDT2. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            FDT2 = FileDateTime(InFile)

            If FDT1 = FDT2 Then
                Exit Sub
            End If
        Catch
        End Try

copy:
        Try
            FileCopy(InFile, OutFile)
        Catch ex As Exception
            _logger.Error(ex, "FileCopyCheck Error " + InFile + " To " + OutFile)
            Throw
        End Try
    End Sub


