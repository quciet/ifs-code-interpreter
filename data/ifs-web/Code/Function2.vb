                                    cswmItem.Caption = "--shadow--"
                                    cswmItem.DividerColor = "#808080"
                                    cswmItem.Style = Coalesys.WebMenu.StyleConstants.Divider
                                End If
                            End If
                        Next

                        MenuCounter = MenuCounter - 1
                        If MenuCounter > 0 Then
                            sFirstIdx = CStr(CInt(sLastIdx) + 1)
                            sFirstChar = GroupNames(CInt(sFirstIdx)).Substring(0, 3).ToUpper & "-"
                            If MenuCounter > 1 Then
                                CtryXCatCounter = CtryXCatAprox
                            Else
                                CtryXCatCounter = LetterDictionary.Values(i - 1) Mod CtryXCatAprox
                            End If
                            sLastIdx = CStr(CInt(sFirstIdx) + CtryXCatCounter - 1)
                            sLastChar = GroupNames(CInt(sLastIdx)).Substring(0, 3).ToUpper
                        End If
                    Loop

                End If
            Else
                CtryXCatCounter = CtryXCatCounter + LetterDictionary.Values(i - 1)
                sLastIdx = CStr(CInt(sLastIdx) + LetterDictionary.Values(i - 1))
                If CtryXCatCounter >= CtryXCatAprox Or i = LetterDictionary.Count Then
                    'If first letter has more than the limit, split it
                    Dim MenuCounter As Single = 1
                    If CtryXCatCounter > CtryXCatAprox + 5 Then
                        MenuCounter = CtryXCatCounter / CtryXCatAprox
                        CtryXCatCounter = CtryXCatAprox
                        sLastIdx = CStr(CInt(sFirstIdx) + CtryXCatAprox - 1)
                        sLastChar = GroupNames(CInt(sLastIdx)).Substring(0, 3).ToUpper
                    Else
                        sLastChar = LetterDictionary.Keys(i - 1)
                        CtryXCatCounter = 0
                    End If

                    Do While MenuCounter > 1
                        cswmItem = cswmGroup2.Items.Add()
                        cswmItem.Caption = sFirstChar & sLastChar
                        Dim cswmGroup3 As Coalesys.WebMenu.Group
                        cswmGroup3 = cswmItem.AddGroup()
                        For j = CInt(sFirstIdx) To CInt(sLastIdx)
                            cswmItem = cswmGroup3.Items.Add()
                            cswmItem.Caption = GroupNames(j)
                            cswmItem.UserData = "Grp"
                            If j < CInt(sLastIdx) Then
                                If GroupNames(j).Chars(0) <> GroupNames(j + 1).Chars(0) Then
                                    cswmItem = cswmGroup3.Items.Add()
                                    cswmItem.Caption = "--shadow--"
                                    cswmItem.DividerColor = "#808080"
                                    cswmItem.Style = Coalesys.WebMenu.StyleConstants.Divider
                                End If
                            End If
                        Next

                        MenuCounter = MenuCounter - 1
                        If MenuCounter > 0 And CInt(sLastIdx) < GCount Then
                            sFirstIdx = CStr(CInt(sLastIdx) + 1)
                            sFirstChar = GroupNames(CInt(sFirstIdx)).Substring(0, 3).ToUpper & "-"
                            If MenuCounter > 1 Then
                                CtryXCatCounter = CtryXCatAprox
                            Else
                                CtryXCatCounter = CInt(sFirstIdx2) + LetterDictionary.Values(i - 1) - 1 - CInt(sLastIdx)
                            End If
                            sLastIdx = CStr(CInt(sFirstIdx) + CtryXCatCounter - 1)
                            sLastChar = GroupNames(CInt(sLastIdx)).Substring(0, 3).ToUpper
                            If CInt(sLastIdx) = GCount Then
                                MenuCounter = 1.01
                            End If
                        End If
                    Loop

                End If
            End If
        Next
    End Sub

    'dsb 2026/06/29 Get the index in Dim2 of the first group
    Public Function getIdxGroupSelection(ByVal SelectedText As String, ByVal bUseGroup As Boolean, ByVal bUseGList As Boolean, ByVal bUseCtryGrp As Boolean, ByVal dbGL As String) As Boolean
        If SelectedText Is Nothing Then Return False
        SelectedText = Trim(SelectedText)
        If SelectedText = "" OrElse SelectedText.ToUpper = "TOTAL" Then Return False
        'If user selected a group or g-list, selected item is a group or g-list, so return true
        If bUseGroup OrElse bUseGList Then Return True
        'If user selected a country group, selected item can be a country or a group, so check if it's a group
        If bUseCtryGrp Then
            Dim rsGroup As DataTable = Nothing
            Dim SafeText As String = Replace(SelectedText, """", """""")
            SetDataTablefromAccess(dbGL, "SELECT GroupNum FROM " & GroupIDNew & " WHERE GroupName = """ & SafeText & """", "", rsGroup)
            Return rsGroup IsNot Nothing AndAlso rsGroup.Rows.Count > 0
        End If
        Return False
    End Function
End Module

