    Public Function EstimateFromMostRecentRevBBH(ByVal GDPPCPBaseYear As Integer, ByVal Year2Estimate As Integer, ByRef valtbl As DataTable,
ByRef tbldriver As DataTable, ByVal Country As String, ByVal FuncName As String,
    ByRef mySession As Object, ByRef myPage As Page,
    Optional ByVal MaxV As Double = 0, Optional ByVal MinV As Double = 0, Optional ByVal Conversion$ = "",
    Optional ByVal ConversionNumber As Double = 0)
        '-------------------------------------------------------------
        'mti November 2006 - take whole procedure 18
        '
        '   Read from bottom up to top of Income data table
        '   Leave block with value for Year2Estimate (base year) if available
        '   Leave block with previous year closest to Year2Estimate, if available
        '   Leave block with later/post year closest to Year2Estimate, if available
        '
        EstimateFromMostRecentRevBBH = System.DBNull.Value
        Dim vIdx As Integer = 0
        Dim PrevYearWithData As Integer = 0
        Dim PrevYearData As Object = System.DBNull.Value
        Dim PostYearWithDat As Integer = 0
        Dim PostYearData As Object = System.DBNull.Value
        Dim Year2EstimateData As Object = System.DBNull.Value
        Dim valRow As DataRow
        valRow = SeekRow(valtbl, Country)

        Dim j As Integer
        Dim YearVal As Integer
        Dim VarVal
        Dim PostYearWithData As Integer
        Dim YearGap As Integer
        Dim YearShr As Integer
        Dim LatestYearWithData As Integer
        Dim LatestData

        For j = 0 To valtbl.Columns.Count - 1
            YearVal = Val(valtbl.Columns(j).Caption)
            If YearVal > 0 Then 'field is an year
                VarVal = valRow.Item(j)
                'jrs 2007/06/11 change = Empty for isEmpty
                If IsNumeric(VarVal) Then
                    If YearVal = Year2Estimate Then
                        Year2EstimateData = VarVal
                        Exit For
                    ElseIf YearVal < Year2Estimate Then
                        PrevYearWithData = YearVal
                        PrevYearData = VarVal
                    Else
                        PostYearWithData = YearVal
                        PostYearData = VarVal
                        Exit For
                    End If
                End If
            End If
        Next j

        '
        '   Use survey from base year if possible
        '   If not, try to interpolate
        '
        'jrs 2007/06/11 change = Empty for isEmpty
        If IsNumeric(Year2EstimateData) Then  'Have data base year, can quit

            EstimateFromMostRecentRevBBH = Year2EstimateData
            Exit Function

        ElseIf IsNumeric(PrevYearData) And
            IsNumeric(PostYearData) Then 'Can Interpolate
            YearGap = PostYearWithData - PrevYearWithData
            YearShr = Year2Estimate - PrevYearWithData
            'jrs 2012/07/27 convertion to vs 2010
            Dim vprevYearData As Single, vpostYearData As Single
            vprevYearData = Val(PrevYearData)
            vpostYearData = Val(PostYearData)
            EstimateFromMostRecentRevBBH = vprevYearData +
                (vpostYearData - vprevYearData) * YearShr / YearGap
            Exit Function
        End If

        '
        '   If arrive here do not have data for year or values for interpolation
        '   Pull out GDP per capita at PPP from separate file for
        '       Year2Estimate and LastestYearWithData
        '   If data for Year2Estimate are not available, will use to
        '       shift latest year for data to Year2Estimate
        '
        If IsNumeric(PostYearData) Then
            LatestYearWithData = PostYearWithData
            LatestData = PostYearData
        Else
            LatestYearWithData = PrevYearWithData
            LatestData = PrevYearData

        End If

        Dim drvRow As DataRow
        drvRow = SeekRow(tbldriver, Country)
        Dim DrvVal_EstYear, DrvVal_LatestYear, Val_EstYear, Val_LatestYear
        DrvVal_EstYear = DBNull.Value
        DrvVal_LatestYear = DBNull.Value

        Dim fld As Integer, fldName As String
        For fld% = 0 To tbldriver.Columns.Count - 1
            fldName$ = tbldriver.Columns(fld%).Caption
            If Trim(fldName$) = Trim(Str(LatestYearWithData)) Then
                DrvVal_LatestYear = drvRow.Item(fldName$)
            End If
            If Trim(fldName$) = Trim(Str(Year2Estimate)) Then
                DrvVal_EstYear = drvRow.Item(fldName$)
            End If

        Next fld%

        Dim valdiff As Integer
        Dim CalculatedVal
        '
        '   Use data from base year (Year2EstimateData) if available
        '   Else Use GDPPC at PPP data from base year and latest data year, plus
        '       Cross-Sectional function to shift base year calculation

        If LatestYearWithData > 0 And IsNumeric(DrvVal_EstYear) And
            IsNumeric(DrvVal_LatestYear) Then
            'Have data other year and drivers both base, other year
            If Conversion = "Div" And ConversionNumber <> 0 Then
                DrvVal_LatestYear = DrvVal_LatestYear / ConversionNumber
                DrvVal_EstYear = DrvVal_EstYear / ConversionNumber
            End If

            Call XYTABL(FuncName, DrvVal_EstYear, Val_EstYear, mySession("TFuncPoints"), mySession("XPoints"),
            mySession("YPoints"), "", myPage, mySession("APoint"), mySession("BPoints"))
            Call XYTABL(FuncName, DrvVal_LatestYear, Val_LatestYear, mySession("TFuncPoints"), mySession("XPoints"),
            mySession("YPoints"), "", myPage, mySession("APoint"), mySession("BPoints"))

            valdiff = Val_LatestYear - Val_EstYear
            EstimateFromMostRecentRevBBH = LatestData - valdiff

        Else 'Do not have data base year or 3 before, after; use Cross-Sectional
            Call XYTABL(FuncName, GDPPCPBaseYear, CalculatedVal, mySession("TFuncPoints"), mySession("XPoints"),
            mySession("YPoints"), "", myPage, mySession("APoint"), mySession("BPoints"))
            EstimateFromMostRecentRevBBH = CalculatedVal
        End If

        '
        '   Bound Value between 0 and 100 (or other values specified_
        '
        '    EstimateFromMostRecentRevBBH = Amin(100, AMAX(0, EstimateFromMostRecentRevBBH))
        If IsNumeric(EstimateFromMostRecentRevBBH) And IsNumeric(MaxV) And IsNumeric(MinV) Then
            EstimateFromMostRecentRevBBH = Amin(MaxV, AMAX(MinV, EstimateFromMostRecentRevBBH))
        End If



    End Function

    'jrs 2008/05/13
    'Returns Truncated Filename
    Public Function TruncateSceFileName(ByVal sRunFile As String) As String
        Dim X() As String
        Dim m As Integer
        'check for .
        X = Split(sRunFile, ".")
        TruncateSceFileName = ""
        For m = 0 To UBound(X) - 2 'jrs 2020/06/08 now names have .run.db replace - 1 with - 2
            If m > 0 Then
                TruncateSceFileName = TruncateSceFileName & "."
            End If
            TruncateSceFileName = TruncateSceFileName & X(m)
        Next m
        'check for " "
        X = Split(TruncateSceFileName, " ")
        TruncateSceFileName = ""
        For m = 0 To UBound(X)
            If Len(TruncateSceFileName) + Len(X(m)) + 1 > 12 Then
                If m = 0 Then
                    TruncateSceFileName = Left(X(m), 12)
                End If
                Exit For
            End If
            If m > 0 Then
                TruncateSceFileName = TruncateSceFileName & " "
            End If
            TruncateSceFileName = TruncateSceFileName & X(m)
        Next m
    End Function

