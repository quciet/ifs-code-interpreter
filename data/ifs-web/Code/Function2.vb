    'function to retrieve a given year if it exists, if not returns mostrecent
    Public Function getYearOrMstRct(ByVal Tbl As DataTable, ByVal iYr As Integer, ByVal rowIdx As Integer) As Single?
        Dim i As Integer
        With Tbl
            'the last 2 columns should be Earliest and MostRecent
            For i = .Columns.Count - 3 To 0 Step -1
                If IsNumeric(.Columns(i).ColumnName) Then
                    If Int(.Columns(i).ColumnName) = iYr Then
                        'jrs 2022/10/07
                        If IsNumeric(.Rows(rowIdx)(i)) Then
                            getYearOrMstRct = CSng(.Rows(rowIdx)(i))
                        Else
                            getYearOrMstRct = Nothing
                        End If
                        If Not getYearOrMstRct.HasValue Then
                            getYearOrMstRct = .Rows(rowIdx)("MostRecent")
                        End If
                        Exit Function
                    ElseIf Int(.Columns(i).ColumnName) < iYr Then
                        'jrs 2022/10/07
                        If IsNumeric(.Rows(rowIdx)("MostRecent")) Then
                            getYearOrMstRct = CSng(.Rows(rowIdx)("MostRecent"))
                        Else
                            getYearOrMstRct = Nothing
                        End If
                        Exit Function
                    End If
                End If
            Next i
        End With
    End Function

