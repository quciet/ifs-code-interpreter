    'jrs 2018/07/04 moved from Flex Displays
    'jrs 2008/01/30 originally from VarSelect
    Public Function ReadIdx(ByVal rsVar As String) As Integer
        Dim pp As Integer
        Dim ss As String
        pp = InStr(rsVar, "[") - 1
        If pp > 0 Then
            ss = Mid(rsVar, 1, pp)
        Else
            ss = rsVar
        End If
        ReadIdx = IfsVars.Item(ss).Index
        If ReadIdx < 0 Then
            ReadIdx = 0
        End If
    End Function

    'jrs 2018/07/04 moved from Flex Displays
    'jrs 2008/01/30 (originally from VarSelect)
    Public Sub CheckDims(ByRef bDim As Boolean, ByVal VDim As Integer, ByVal idx As Integer, ByVal rsPar As String, ByRef sDim As String,
    ByRef MaxDimNum As Integer, ByRef svIdx As Object, ByVal ss As String, ByVal Dim_Num As Integer, ByVal bFormula As Boolean)
        '1. bDim is the flag that will block loading this dimension if not needed.
        '2. VDim is the Dimension number, i.e. VDim2(idx) or VDim3(idx)
        '3. idx is the id of the Variable
        '4. rsPar is the Parameter stored with the list
        '5. sDim is the global variable that's used to check if the same value is used accross this dimension.
        '6. MaxDimNum Dimension number, that is number of dimensions a variable has
        '7. svIdx index of variable being analized
        '8. ss used for formulas, this is the parameter passed to the formula as a whole vs the parameters for each member of the formula
        '9. Dim_Num is the variable being analized (2nd or 3rd).
        '10. bFormula indicates if working with a Formula or not.
        If bDim And VDim > 0 Then
            If rsPar > "" And (ss = "" Or ss = rsPar) Then 'jrs 2010/12/16 added or ss=rsPar consider Google list with formulas for Deaths and DALYs across Comm. Dis, saving for Males, Females and Total
                If sDim = "" Then
                    sDim = rsPar
                    'jrs 2026/03/20 This commennt doesn't match the code, also having problems with formulas like INTSFLOWS(Country,Sec1,Sec2)/POP(Country)
                    If Not bFormula Or (ss = rsPar And bFormula) Then 'jrs 2014/01/13 added Or (ss = "" And bFormula)
                        bDim = False
                    End If
                ElseIf sDim <> rsPar Then
                    bDim = False
                End If
            End If
            If MaxDimNum < Dim_Num Then
                MaxDimNum = Dim_Num
                svIdx = idx
            End If
        End If
    End Sub

    'jrs 2005/08/24
    Public Sub LoadMenuFiles(ByVal sDir As String, ByRef Targetnode As TreeNode, ByRef tree As TreeView, ByVal sType As String)
        If Right(sDir, 1) = "\" Then
            sDir = Mid(sDir, 1, Len(sDir) - 1)
        End If

        Dim sRunFile As String
        ' Returns filename with specified extension. If more than one *.ini
        ' file exists, the first file found is returned.
        sRunFile = Dir(sDir + "\*." & sType)

        Do While (sRunFile <> "")
            'jrs 2008/11/18 added And InStr(sRunFile, ".") > 0 to avoid problems with files with no .ext
            If UCase(sRunFile) <> "WORKING." & UCase(sType) And UCase(sRunFile) <> "WORKING FILE." & UCase(sType) And
            UCase(sRunFile) <> "IFSBASE." & UCase(sType) And InStr(sRunFile, ".") > 0 Then
                If Targetnode Is Nothing Then
                    tree.Nodes.Add(New TreeNode(Mid(sRunFile, 1, InStr(UCase(sRunFile), "." & UCase(sType)) - 1)))
                Else
                    Targetnode.Text = Mid(sRunFile, 1, InStr(UCase(sRunFile), "." & UCase(sType)) - 1)
                    tree.Nodes.Add(Targetnode)
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop
        'Look for all folders within
        Dim counter As Integer
        counter = -1
        Dim DirList() As String

        sRunFile = Dir(sDir + "\*", vbDirectory)

        Do While (sRunFile <> "")
            If Mid(sRunFile, 1, 7) <> "Session" And sRunFile <> "." And sRunFile <> ".." Then
                If (GetAttr(sDir & "\" & sRunFile) And vbDirectory) = vbDirectory Then
                    counter = counter + 1
                    ReDim Preserve DirList(counter)
                    DirList(counter) = sRunFile
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop

        Dim i As Integer
        For i = 0 To counter
            Dim NewNodeDir As TreeNode = New TreeNode()

            If Targetnode Is Nothing Then
                NewNodeDir.Text = DirList(i)
                tree.Nodes.Add(NewNodeDir)
            Else
                NewNodeDir.Text = DirList(i)
                Targetnode.ChildNodes.Add(NewNodeDir)
            End If
            LoadMenuFiles(sDir + "\" + DirList(i), NewNodeDir, tree, sType)
            'jrs 2005/08/05
            'jrs 2007/08/06 added and sType > ""
            If NewNodeDir.ChildNodes.Count = 0 And sType > "" Then
                tree.Nodes.Remove(NewNodeDir)
            Else
                'jrs 2005/09/07 NewNodeDir.Expanded = True
            End If
        Next i
    End Sub

    'jrs 2007/08/06 made sub public
    Public Sub ReadSceFiles(ByVal sDir As String, ByRef FilesSelected As Integer, ByRef fileList() As String)
        If Right(sDir, 1) = "\" Then
            sDir = Mid(sDir, 1, Len(sDir) - 1)
        End If

        Dim sRunFile As String
        ' Returns filename with specified extension. If more than one *.ini
        ' file exists, the first file found is returned.
        sRunFile = Dir(sDir + "\*.sce")

        Do While (sRunFile <> "")
            If UCase(sRunFile) <> "WORKING.SCE" And UCase(sRunFile) <> "WORKING FILE.SCE" And UCase(sRunFile) <> "IFSBASE.SCE" Then
                FilesSelected = FilesSelected + 1
                ReDim Preserve fileList(FilesSelected)
                fileList(FilesSelected) = sDir + "\" + sRunFile
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop
        'Look for all folders within
        Dim counter As Integer
        counter = -1
        Dim DirList() As String

        sRunFile = Dir(sDir + "\*", vbDirectory)

        Do While (sRunFile <> "")
            If Mid(sRunFile, 1, 7) <> "Session" And sRunFile <> "." And sRunFile <> ".." Then
                If (GetAttr(sDir & "\" & sRunFile) And vbDirectory) = vbDirectory Then
                    counter = counter + 1
                    ReDim Preserve DirList(counter)
                    DirList(counter) = sRunFile
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sRunFile = Dir()
        Loop

        Dim i As Integer
        For i = 0 To counter
            ReadSceFiles(sDir + "\" + DirList(i), FilesSelected, fileList)
        Next i
    End Sub

    'Procedure to compare all variables across all dimensions between .run and .run.db files
    '1. Parameter to define years to check
    '2. Parameter to define differences to save in report
    '3. Max number of differences before quit
    '4. Use percentage for differences
    Public Sub gLoadCompareReport(ByRef FirstYear As Integer, ByRef LastYear As Integer,
    ByVal MaxDiff As Single, ByVal MaxCountDiff As Integer, ByVal bPctDiff As Boolean,
    ByVal IFs_MDB2Active As String, ByRef FinYear As Object, ByRef IfsPars As myParameters,
    ByVal PutFdrvRun As String, ByRef FileNumbr As Object, ByRef RunFiles As Object)
        'Dim FinAll As Integer
        'Dim msg As String
        Dim frm_msg As New frm_Message

        Dim DimIdx As Integer 'jrs 2006/01/12
        Dim DimIdx2 As Integer 'jrs 2006/01/15
        Dim DimIdx3 As Integer 'jrs 2006/06/20
        Dim YrIdx As Integer
        Dim Dim1 As String
        Dim Dim2 As String
        Dim Dim3 As String
        Dim sVar As String
        Dim bFirst As Boolean
        bFirst = True
        Dim idx = 0
        'Dim idxVar As Integer
        'Dim iRowPosition As Integer, iFirstYear As Integer, iLastYear As Integer
        Dim sLine As String
        Dim diffCount As Integer = 0

        'jrs 2006/01/18 GList
        Dim dbGL As String
        dbGL = IFs_MDB2Active
        Dim DimNum As Integer, VarIdx As Integer

        Dim objWriter = New System.IO.StreamWriter(PutFdrvRun + "ComparissonReportVb6vs.NET.txt", append:=True)
        objWriter.WriteLine("Comparisson Report Vb6 vs .NET - " & Today.ToString)
        objWriter.Close()

        objWriter = New System.IO.StreamWriter(PutFdrvRun + "ComparissonReportVb6vs.NET.txt", append:=False)

        Dim MyFileforDisplay As IStorage
        Dim MyDF As IDataframe

        Dim TargetOld(), TargetNew() As Single
        ReDim TargetOld(LastYear - FirstYear + 1), TargetNew(LastYear - FirstYear + 1)

        'jrs 2017/03/24 Do While (Not idx = rs.Rows.Count)
        Dim vIdx As Integer
        For vIdx = 1 To NumbVars

            sVar = V(vIdx)
            'jrs 2012/04/26
            VarIdx = vIdx
            DimNum = -1
            MyDF = Nothing

            'Not considering if variable has the dimension fixed
            If VarIdx > 0 Then
                If VDim3(VarIdx) > 0 Then
                    DimNum = 3
                ElseIf VDim2(VarIdx) > 0 Then
                    DimNum = 2
                ElseIf VDim1(VarIdx) > 0 Then
                    DimNum = 1
                Else
                    DimNum = 0
                End If
            Else
                DimNum = 3
            End If

            Dim Dim1Count As Integer
            If VDim1(VarIdx) = 0 Then
                Dim1Count = 1
                Dim1 = ""
            Else
                Dim1Count = MaxVal(VDim1(VarIdx)) - 1
            End If

            Dim Dim2Count As Integer
            If VDim2(VarIdx) = 0 Then
                Dim2Count = 1
                Dim2 = ""
            Else
                Dim2Count = MaxVal(VDim2(VarIdx)) - 1
            End If

            Dim Dim3Count As Integer
            If VDim3(VarIdx) = 0 Then
                Dim3Count = 1
                Dim3 = ""
            Else
                Dim3Count = MaxVal(VDim3(VarIdx)) - 1
            End If

            For DimIdx = 1 To Dim1Count
                If VDim1(VarIdx) > 0 Then
                    Dim1 = GRPS(VDim1(VarIdx), DimIdx)
                End If

                For DimIdx2 = 1 To Dim2Count
                    If VDim2(VarIdx) > 0 Then
                        Dim2 = GRPS(VDim2(VarIdx), DimIdx2)
                    End If

                    For DimIdx3 = 1 To Dim3Count
                        If VDim3(VarIdx) > 0 Then
                            Dim3 = GRPS(VDim3(VarIdx), DimIdx3)
                        End If
                        gLoadForDisplay(sVar, VarIdx, Dim1, DimIdx, Dim2, DimIdx2, Dim3, DimIdx3, "", 1, True, True, Nothing, 1, TargetOld, 1,
                                                            1, FirstYear, LastYear, 0, True, Nothing, Nothing, RunFiles, PutFdrvRun, ShortSce, 1, FinYear,
                                                            IFs_MDB2Active, 1)
                        ReDim TargetNew(LastYear - FirstYear + 1)
                        gLoadForDisplayNET(sVar, VarIdx, Dim1, DimIdx, Dim2, DimIdx2, Dim3, DimIdx3, "", 1, VarIdx = 1 And DimIdx = 1 And DimIdx2 = 1 And DimIdx3 = 1, False, Nothing, 1, TargetNew, 1,
                        1, FirstYear, LastYear, 0, True, Nothing, Nothing, RunFiles, PutFdrvRun, ShortSce, FinYear,
                        IFs_MDB2Active, 1, MyFileforDisplay, MyDF)

                        For YrIdx = 1 To LastYear - FirstYear + 1
                            If Abs(TargetOld(YrIdx) - TargetNew(YrIdx)) > MaxDiff And bPctDiff = False AndAlso
                                Abs(TargetOld(YrIdx) - TargetNew(YrIdx)) > 0.001 * Abs(TargetOld(YrIdx)) Then
                                sLine = sVar & ", " & CStr(YrIdx + FirstYear - 1)
                                If Dim1 > "" Then
                                    sLine = sLine & ", " & Dim1
                                    If Dim2 > "" Then
                                        sLine = sLine & ", " & Dim2
                                        If Dim3 > "" Then
                                            sLine = sLine & ", " & Dim3
                                        End If
                                    End If
                                End If
                                sLine = sLine & ", " & TargetOld(YrIdx).ToString & ", " & TargetNew(YrIdx).ToString & ", " & (TargetOld(YrIdx) - TargetNew(YrIdx)).ToString
                                objWriter.WriteLine(sLine)
                                diffCount = diffCount + 1
                                If diffCount = MaxCountDiff Then
                                    objWriter.Close()
                                    Exit Sub
                                End If
                            ElseIf bPctDiff Then
                                If TargetOld(YrIdx) <> 0 Then
                                    If Abs((TargetOld(YrIdx) - TargetNew(YrIdx)) / TargetOld(YrIdx)) > MaxDiff / 100 Then
                                        sLine = sVar
                                        If Dim1 > "" Then
                                            sLine = sLine & ", " & Dim1
                                            If Dim2 > "" Then
                                                sLine = sLine & ", " & Dim2
                                                If Dim3 > "" Then
                                                    sLine = sLine & ", " & Dim3
                                                End If
                                            End If
                                        End If
                                        sLine = sLine & ", " & TargetOld(YrIdx).ToString & ", " & TargetNew(YrIdx).ToString & ", " & (100 * (TargetOld(YrIdx) - TargetNew(YrIdx)) / TargetOld(YrIdx)).ToString
                                        objWriter.WriteLine(sLine)
                                        diffCount = diffCount + 1
                                        If diffCount = MaxCountDiff Then
                                            objWriter.Close()
                                            Exit Sub
                                        End If
                                    End If
                                ElseIf TargetNew(YrIdx) <> 0 Then
                                    sLine = sVar
                                    If Dim1 > "" Then
                                        sLine = sLine & ", " & Dim1
                                        If Dim2 > "" Then
                                            sLine = sLine & ", " & Dim2
                                            If Dim3 > "" Then
                                                sLine = sLine & ", " & Dim3
                                            End If
                                        End If
                                    End If
                                    sLine = sLine & ", " & TargetOld(YrIdx).ToString & ", " & TargetNew(YrIdx).ToString & ", " & (TargetOld(YrIdx) - TargetNew(YrIdx)).ToString
                                    objWriter.WriteLine(sLine)
                                    diffCount = diffCount + 1
                                    If diffCount = MaxCountDiff Then
                                        objWriter.Close()
                                        Exit Sub
                                    End If
                                End If
                            End If
                        Next YrIdx

                    Next DimIdx3
                Next DimIdx2
            Next DimIdx
        Next vIdx

        objWriter.Close()

    End Sub

