                    'UPGRADE_WARNING: Couldn't resolve default property of object MAXCOM(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                    Ptr = Ptr + (MAXCOM(VDim1(idx)) - 1) * (i - 1)
                    Exit For
                End If
            Next i
        End If
        'UPGRADE_WARNING: Couldn't resolve default property of object gRetrievePtr. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        gRetrievePtr = Ptr
    End Function

