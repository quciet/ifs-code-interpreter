        'UPGRADE_WARNING: Couldn't resolve default property of object VarPoint(idx). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        Ptr = VarPoint(idx)

        If sDim1 > "" Then
            'UPGRADE_WARNING: Couldn't resolve default property of object MAXCOM(VDim1(idx)). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            For i = 1 To MAXCOM(VDim1(idx))
                If UCase(sDim1) = UCase(GRPS(VDim1(idx), i)) Then
