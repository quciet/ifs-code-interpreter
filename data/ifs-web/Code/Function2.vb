                gLongVarFiltName = "ALL"
                bInclude = bIncludedByOthrFilterLongvars(sPreprocessor, sYears, gLongVarFiltName, giFilterDataPoints, giFilterYear)
                sJscript = sJscript & "  jbInclude[" & Rcnt2.ToString & "]= """ & bInclude.ToString & """ ;" & vbCr


                If bInclude Then

                    FullName = Varname & " - " & VarDefinition & " - " & sUnits

