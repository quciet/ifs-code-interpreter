    ByRef FinYear As Object)
        Dim iloop As Short
        Dim ICount As Short
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        'JRS 9/10/01 CREATED FOR COMPUTATIONS
        ' Delete Variable
        COUNTE = COUNTE - 1 ''Do later?
        'jrs 2006/09/25 use all his
