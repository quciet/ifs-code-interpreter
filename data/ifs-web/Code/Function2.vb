    'Routine to Aggregate Values (Group Calculation)
    'The members of the G-LIst can be read from IFs.mdb, table G-List, and
    'you 'll see the Group Column there too.
    Public Sub AggVal(ByRef OrgArray As Object, ByRef OrgCounter As Integer, ByVal NewCounter As Integer,
    ByRef MemberArray As Object, ByRef MemberisGroupArray As Object, ByVal sAgg As String, ByVal IndType As String, ByVal vIFs_mdb As String,
    ByRef vCVarIGdp() As Object, ByRef vCVarIPop() As Object, ByRef vOrigTemp() As Object)

        'Parameters:
        '1. OrgArray() is the array containing values for all countries
        '2. OrgCounter is the number of countries in the array
        '3. NewCounter number of members of the G-List
        '4. MemberArray() is the array containing the names of all the Groups/Regions-Countries members of the G-List
        '5. MemberisGroupArray(), this array specifies if the corresponding member in MemberArray is a Group or NOT.
        '6. sAgg is the Aggregation Rule for the Variable selected

        ' Declare an Array to Store Results
        ' ---------------------------------
        On Error GoTo GroupError


        Dim vResultArray(NewCounter)
        Dim vgGroupMembrs(OrgCounter)
        Dim vCountryRegress(OrgCounter)
        Dim vNewVal(OrgCounter)



        ' Loop through all Members of the G-List
        ' --------------------------------------
        Dim i, aa, indexGr As Integer, RegIdx As Integer, bRegions As Boolean
        Dim vgCountGroupMembers

        Dim onlyNull As Boolean
        'jrs 2012/05/01 Dim IFsCtrys As New MyRegions
        Dim myForm As Page




        For i = 1 To NewCounter


            'check if region has countries in it
            'and load members
            If MemberisGroupArray(i) Then

                RegIdx = gGetGroupIdx(MemberArray(i), True, myForm) '--gGetGroupIdx(MemberArray(i), True, Me)


                'gLoadGroupMembersHis(sDim1, GroupCodes(idxDim1), gCountGroupMembers, gGroupMembrs, IfsParameters.Ifs_MDB2Active)
                gLoadGroupMembersHis(CStr(MemberArray(i)), GroupCodes(RegIdx), vgCountGroupMembers, vgGroupMembrs, vIFs_mdb)

            Else
                RegIdx = gGetDimIdx(1, MemberArray(i), True, myForm)

                gLoadRegionMembersHis(CStr(MemberArray(i)), RegIdx, vgCountGroupMembers, vgGroupMembrs, vIFs_mdb)


                bRegions = (vgCountGroupMembers > 1)
            End If

            'JAM 2010-03-20 Code added for Group with members with null data
            onlyNull = False



            For aa = 1 To vgCountGroupMembers


                'JAM 2010-04-18 Object returns a value -1 that real position
                'jrs 2012/05/01 not anymore so I removed the + 1 
                indexGr = (IFsCtrys.Item(vgGroupMembrs(aa)).Index) '+ 1


                vCountryRegress(indexGr) = True

                If Not IsDBNull(OrgArray(indexGr)) Then
                    onlyNull = True
                    'Exit For
                End If
            Next aa


            If Not onlyNull Then
                vResultArray(i) = DBNull.Value
            Else
                'If it's not a GROUP just copy data
                If Not MemberisGroupArray(i) And Not bRegions Then

                    RegIdx = IFsCtrys.Item(vgGroupMembrs(1)).Index
                    vResultArray(i) = OrgArray(RegIdx)
                    'If it's a GROUP do aggregation
                Else
                    vResultArray(i) = 0
                    Dim k As Integer, Aux As Single 'jrs 2008/08/27 changed from integer to single
                    Aux = 0

                    For k = 1 To vgCountGroupMembers
                        'JAM 2010-04-18 Object returns a value -1 that real position
                        'jrs 2012/05/01 not anymore so I removed the + 1 
                        RegIdx = (IFsCtrys.Item(vgGroupMembrs(k)).Index) '+ 1
                        Select Case sAgg
                                'jrs 2008/08/27 added and Not is empty
                            Case "SUM"
                                If IsNumeric(OrgArray(RegIdx)) And Not (OrgArray(RegIdx) Is Nothing) Then
                                    vResultArray(i) = vResultArray(i) + OrgArray(RegIdx)
                                End If
                            Case "AVG"
                                If IsNumeric(OrgArray(RegIdx)) And Not (OrgArray(RegIdx) Is Nothing) Then
                                    vResultArray(i) = vResultArray(i) + OrgArray(RegIdx)
                                    Aux = Aux + 1
                                End If
                            Case "GDP"
                                If IsNumeric(OrgArray(RegIdx)) And Not (OrgArray(RegIdx) Is Nothing) Then
                                    vResultArray(i) = vResultArray(i) + OrgArray(RegIdx) * vCVarIGdp(RegIdx)
                                    Aux = Aux + vCVarIGdp(RegIdx)
                                End If
                            Case "POP"
                                If IsNumeric(OrgArray(RegIdx)) And Not (OrgArray(RegIdx) Is Nothing) Then
                                    vResultArray(i) = vResultArray(i) + OrgArray(RegIdx) * vCVarIPop(RegIdx)
                                    Aux = Aux + vCVarIPop(RegIdx)
                                End If
                            Case "LND"
                        End Select

                    Next k
                    If Aux <> 0 Then
                        vResultArray(i) = vResultArray(i) / Aux
                    End If
                End If

            End If



        Next i



        '''''''''''
        Dim mn

        ''''''''''
        If IndType = "I" Then
            For i = 1 To NewCounter
                vNewVal(i) = vResultArray(i)
            Next i
        Else
            If IndType = "G" Then
                For i = 1 To NewCounter
                    vCVarIGdp(i) = vResultArray(i)
                Next i
            Else
                If IndType = "P" Then
                    For i = 1 To NewCounter
                        vCVarIPop(i) = vResultArray(i)
                    Next i
                Else
                    If IndType = "O" Then
                        For i = 1 To NewCounter
                            vOrigTemp(i) = vResultArray(i)
                            mn = vResultArray(i)
                        Next i
                    End If
                End If
            End If
        End If

        Exit Sub

GroupError:
        _logger.Error(Err.GetException, "AggVal - GroupError")
        'Screen.MousePointer = 0
        'Msg$ = "The Group doesn't exist.  Please try another."
        'MsgBox$ Msg$
        'Call mnuCountries_Click()
        'frm_ScatVarS.mnuCountries.Checked = False
        'frm_ScatVarS.mnucountry.Checked = False
        'frm_ScatVarS.mnuCodes.Checked = False
        'frm_ScatVarS.mnuNolabels.Checked = False
        'frm_ScatVarS.mnuGeographic.Checked = False
        Exit Sub


    End Sub

