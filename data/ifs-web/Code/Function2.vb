    'jrs 2025/10/06 added IncompatibleRegionIdx
    'jrs 2023/04/24 added bIncompatibleRegionFile
    'jrs 2006/04/06
    'Subroutine to load members of a group
    Public Sub gLoadGroupMembers(ByVal GroupName As String, ByVal idxVar As Integer, ByVal idxDim2 As Integer, ByVal idxDim3 As Integer,
    ByRef gCountGroupMembers As Integer, ByRef IFs_MDB2Active As String, ByRef gGroupMembrs() As String, ByRef gGroupMembersPtrs() As Integer,
    ByRef gGroupMemberWeights() As Single, Optional bIncompatibleRegionFile As Boolean = False, Optional IncompatibleRegionIdx As Integer = -1)
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        '1. GroupName is the Name of the Group
        '2. idxVar helps load pointers to a specific variable for every member of the group
        '3. idxDim2 helps build pointers to a specific variable for every member of the group
        '4. idxDim3 helsp build pointers to a specific variable for every member of the group
        '5. gCountGroupMembers is the counter for members of this particular group
        '6. IFs_MDB2Active is the full path to IFs.mdb
        '7. gGroupMembrs is an array with the Regions in the group
        '8. gGroupMembersPtrs is an array with the pointer of each member of the group
        '9. gGroupMemberWeights is an array with the Weight values for each member of the group


        Dim valtblG As DataTable
        'Dim resG As DataTable
        gCountGroupMembers = 0

        'SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " + GroupIDNew$ + " WHERE GroupName = '" + GroupName + "'", "", resG)
        'If resG.Rows.Count = 0 Then
        '    Exit Sub
        'End If
        'Dim GroupNum As Integer
        'GroupNum = resG.Rows(0).Item("GroupNum")

        'jrs 2006/07/24 Reload Table only if necessary
        Try
            valtblG = IFsTables.Item("SELECT * FROM " & Grouping$ & ", " & GroupIDNew$ & " WHERE GroupNo = GroupNum")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM " & Grouping$ & ", " & GroupIDNew$ & " WHERE GroupNo = GroupNum") Then
                    SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " & Grouping$ & ", " & GroupIDNew$ & " WHERE GroupNo = GroupNum",
                    "", valtblG)
                    IFsTables.Add(valtblG, "SELECT * FROM " & Grouping$ & ", " & GroupIDNew$ & " WHERE GroupNo = GroupNum")
                Else
                    valtblG = IFsTables.Item("SELECT * FROM " & Grouping$ & ", " & GroupIDNew$ & " WHERE GroupNo = GroupNum")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = valtblG.Select("GroupName = '" & Replace(GroupName, "'", "''") & "'")

        'SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " + Grouping$ + ", " + GroupIDNew$ + _
        '" WHERE GroupNo = GroupNum AND GroupName = '" + GroupName + "'", "", valtblG)


        Dim iTotal As Integer, i As Integer
        iTotal = 0
        i = 0

        iTotal = UBound(tblRows) + 1

        '   Load Group Member Names List Box
        ReDim gGroupMembrs(iTotal)
        ReDim gGroupMembersPtrs(iTotal)
        ReDim gGroupMemberWeights(iTotal)

        'jrs 2023/04/24
        Dim RemoveIncomp As Dictionary(Of String, Integer) = New Dictionary(Of String, Integer)
        Dim tblrr As Integer = 0

        Do While Not iTotal = i
            'iTotal = iTotal + 1
            gGroupMembrs(i + 1) = tblRows(tblrr).Item("Region")
            gGroupMemberWeights(i + 1) = tblRows(tblrr).Item("RegionNo") - 1

            'jrs 2023/04/24
            If bIncompatibleRegionFile Then
                'jrs 2025/10/06 Dim idxDim1 = gGetDimIdx(UBound(GRPS, 1), gGroupMembrs(i + 1), False, Nothing)
                Dim idxDim1 = gGetDimIdx(IncompatibleRegionIdx, gGroupMembrs(i + 1), False, Nothing)
                If idxDim1 = -1 Then
                    RemoveIncomp.Add(gGroupMembrs(i + 1), gGroupMemberWeights(i + 1))
                    iTotal = iTotal - 1
                    i = i - 1
                Else
                    gGroupMemberWeights(i + 1) = idxDim1 - 1

                    If VDim1(idxVar) = 1 And VDim2(idxVar) = 0 Then
                        gGroupMembersPtrs(i + 1) = VarPoint(idxVar) + gGroupMemberWeights(i + 1) 'jrs 2023/04/24 tblRows(i).Item("RegionNo") - 1
                    End If

                End If
            Else
                If VDim1(idxVar) = 1 And VDim2(idxVar) = 0 Then
                    gGroupMembersPtrs(i + 1) = VarPoint(idxVar) + tblRows(tblrr).Item("RegionNo") - 1
                ElseIf VDim3(idxVar) = 0 Then 'jrs 2006/05/16 Dim3
                    gGroupMembersPtrs(i + 1) = VarPoint(idxVar) + (idxDim2 - 1) * (MAXCOM(1) - 1) +
                    tblRows(tblrr).Item("RegionNo") - 1
                Else
                    gGroupMembersPtrs(i + 1) = VarPoint(idxVar) + (idxDim2 - 1) * (MAXCOM(1) - 1) +
                    tblRows(tblrr).Item("RegionNo") - 1 + (idxDim3 - 1) * (MAXCOM(1) - 1) * (MAXCOM(VDim2(idxVar)) - 1)
                End If
            End If

            i = i + 1
            tblrr = tblrr + 1
        Loop

        'jrs 2023/04/24
        If bIncompatibleRegionFile Then
            If RemoveIncomp.Count > 0 Then
                If VDim2(idxVar) > 0 And VDim3(idxVar) = 0 Then
                    For i = 0 To iTotal - 1
                        gGroupMembersPtrs(i + 1) = VarPoint(idxVar) + (idxDim2 - 1) * (MAXCOM(1) - 1 - RemoveIncomp.Count) +
                        gGroupMemberWeights(i + 1)
                    Next
                ElseIf VDim3(idxVar) > 0 Then
                    gGroupMembersPtrs(i + 1) = VarPoint(idxVar) + (idxDim2 - 1) * (MAXCOM(1) - 1 - RemoveIncomp.Count) +
                    gGroupMemberWeights(i + 1) + (idxDim3 - 1) * (MAXCOM(1) - 1 - RemoveIncomp.Count) * (MAXCOM(VDim2(idxVar)) - 1)
                End If
            End If
        End If

        'JRS 10/03/02
        gCountGroupMembers = iTotal

    End Sub

