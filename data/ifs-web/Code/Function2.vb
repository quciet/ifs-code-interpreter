        '   -------------------------------------------------------------------------------

        On Error GoTo FileCopyError
        If UseSQLite Then
            InFile = DataFileDir & "TablFunc.db"
            OutFile = PutFdrvRun & "TablFunc.db"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "AnalFunc.db"
            OutFile = PutFdrvRun & "AnalFunc.db"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "IFsVar.db"
            OutFile = PutFdrvRun & "IFsVar.db"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "IFsPop.db"
            OutFile = PutFdrvRun & "IFsPop.db"
            FileCopyCheck(InFile, OutFile)
        Else
            InFile = DataFileDir & "TablFunc.mdb"
            OutFile = PutFdrvRun & "TablFunc.mdb"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "AnalFunc.mdb"
            OutFile = PutFdrvRun & "AnalFunc.mdb"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "IFsVar.mdb"
            OutFile = PutFdrvRun & "IFsVar.mdb"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "IFsPop.mdb"
            OutFile = PutFdrvRun & "IFsPop.mdb"
            FileCopyCheck(InFile, OutFile)
        End If

        'jrs 2008/06/18
        If UseSQLite Then
            InFile = DataFileDir & "IFsPopHist.db"
            OutFile = PutFdrvRun & "IFsPopHist.db"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "DataDict.db"
            OutFile = PutFdrvRun & "DataDict.db"
            FileCopyCheck(InFile, OutFile)

        Else
            InFile = DataFileDir & "IFsPopHist.mdb"
            OutFile = PutFdrvRun & "IFsPopHist.mdb"
            FileCopyCheck(InFile, OutFile)

            InFile = DataFileDir & "DataDict.mdb"
            OutFile = PutFdrvRun & "DataDict.mdb"
            FileCopyCheck(InFile, OutFile)
        End If


        InFile = IFs_MDB
        OutFile = IFs_MDB2
        FileCopyCheck(InFile, OutFile)


        'jrs 2008/11/20
        If UseSQLite Then
            'jrs 2023/09/22
            'JRS 10/08/02 GUIDED USE
            'InFile = DataFileDir & "GuidedUse.db"
            'OutFile = PutFdrvRun & "GuidedUse.db"
            'FileCopyCheck(InFile, OutFile)

            If UCase(ModelLoad) = UCase("LoadCoVaTrA") Then
                InFile = DataFileDir & "IFsCoVaTrA.DB"
                OutFile = PutFdrvRun & "IFsCoVaTrA.DB"
                FileCopyCheck(InFile, OutFile)
            End If

            'jrs 2007/05/09
            InFile$ = DataFileDir$ + "Provinces.db"
            OutFile$ = PutFdrvRun$ + "Provinces.db"
            FileCopyCheck(InFile$, OutFile$)

            InFile$ = DataFileDir$ + "ifsSmoking.db"
            OutFile$ = PutFdrvRun + "ifsSmoking.db"
            FileCopyCheck(InFile$, OutFile$)
        Else
            'JRS 10/08/02 GUIDED USE
            InFile = DataFileDir & "GuidedUse.mdb"
            OutFile = PutFdrvRun & "GuidedUse.mdb"
            FileCopyCheck(InFile, OutFile)

            If UCase(ModelLoad) = UCase("LoadCoVaTrA") Then
                InFile = DataFileDir & "IFsCoVaTrA.MDB"
                OutFile = PutFdrvRun & "IFsCoVaTrA.MDB"
                FileCopyCheck(InFile, OutFile)
            End If

            'jrs 2007/05/09
            InFile$ = DataFileDir$ + "Provinces.mdb"
            OutFile$ = PutFdrvRun$ + "Provinces.mdb"
            FileCopyCheck(InFile$, OutFile$)

            InFile$ = DataFileDir$ + "ifsSmoking.mdb"
            OutFile$ = PutFdrvRun + "ifsSmoking.mdb"
            FileCopyCheck(InFile$, OutFile$)
