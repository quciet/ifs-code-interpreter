    'jrs 2005/06/08
    Public Sub DeleteOldSceUsrDef(ByVal sDir As String)
        Dim fs
        fs = CreateObject("Scripting.FileSystemObject")
        If Right(sDir, 1) = "\" Then
            sDir = Mid(sDir, 1, Len(sDir) - 1)
        End If

        Dim sFile As String
        ' Returns filename with specified extension. If more than one *.ini
        ' file exists, the first file found is returned.
        sFile = Dir(sDir + "\*.sce")

        Dim curFile As Object

        Do While (sFile <> "")
            curFile = fs.getFile(sDir & "\" & sFile)

            'jrs 2024/03/19
            If Now.Subtract(CDate(curFile.DateLastModified)).Days > 90 Then
                curFile.Delete()
                'jrs 2008/06/04
                'Check for run files and SAM mdb files
                If fs.FileExists(sDir & "\" & Replace(sFile, "sce", "run")) Then
                    curFile = fs.getFile(sDir & "\" & Replace(sFile, "sce", "run"))
                    curFile.delete()
                    curFile = fs.getFile(sDir & "\SAM" & Replace(sFile, "sce", "mdb"))
                    curFile.delete()
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sFile = Dir()
        Loop

        'Look for all folders within
        Dim counter As Integer
        counter = -1
        Dim DirList(0) As String

        sFile = Dir(sDir + "\*", vbDirectory)

        Do While (sFile <> "")
            If sFile <> "." And sFile <> ".." Then
                If (GetAttr(sDir & "\" & sFile) And vbDirectory) = vbDirectory Then
                    counter = counter + 1
                    ReDim Preserve DirList(counter)
                    DirList(counter) = sFile
                End If
            End If
            ' Call Dir again without arguments to return the next *.INI file in the
            ' same directory.
            sFile = Dir()
        Loop

        Dim i As Integer
        For i = 0 To counter
            DeleteOldSceUsrDef(sDir & "\" & DirList(i))
            If CheckDirSize(sDir & "\" & DirList(i)) = 0 Then
                fs.GetFolder(sDir & "\" & DirList(i)).Delete()
            End If
        Next i
    End Sub

