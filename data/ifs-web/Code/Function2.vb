    'jrs 2006/10/20 Function to compute formulas with the option to use All
    Public Sub ComputeFormulasWAll(ByRef f As Formula, ByVal iTotYears As Integer, ByVal iFirstYear As Integer,
    ByRef data As Object, ByRef idx As Integer, ByRef TargetVector As Object, ByVal gHistoricAnalog As Boolean,
    ByRef aFormulas As Object, ByRef myPage As Page, ByVal sOrgForm As String,
    ByVal LV_Chk_Indep As Object, ByVal DisYear As Integer, ByVal CountryTot As Integer, ByVal bCompAll As Boolean,
    ByRef dataAll As Object, ByRef LongVArSTag As String, ByVal LongVarScmb_Varname As String,
    ByVal LongVarSopt_Dependent As Boolean, ByVal LongVarSopt_Independent As Boolean)

        Dim d1 As Short
        Dim start As Short
        Dim X As Short
        Dim CT As Object
        Dim V As Short

        On Error GoTo CompHandler

        If f.disVar Is Nothing Then
            V = 0
            CT = 0
        Else
            V = f.disVar.disSize
            Dim vv As Integer
            CT = 0
            For vv = 1 To V
                If f.disVar.displayDet(vv) = "" Then
                    CT = CT + 1
                End If
            Next vv
        End If

        If CT = 0 And V > 0 Then
            'VALIDATE DIMENSIONS
            ValidateDims(f)
            PrepareTotVar(sOrgForm, f, iTotYears, LV_Chk_Indep, DisYear, CountryTot)

            d1 = f.begAll
            Do While True
                If bCompAll Then
                    'This has to pass elements from dataAll to data
                    PrepareData(d1, f, dataAll, data)
                End If
                'Loads numerical data into an internal array
                'but still without specifing to which node it belongs
                f.LoadNumData(data)
                AddIdx(sOrgForm, LongVArSTag, idx, LongVarScmb_Varname, LongVarSopt_Dependent, LongVarSopt_Independent)
                d1 = d1 + 1
                'Computes formula and load result into its destination
                LoadData(f, idx, TargetVector, iFirstYear, 0)
                If d1 > f.endAll Then
                    bCompAll = False
                End If
                If Not bCompAll Then Exit Do
            Loop

            If Not gHistoricAnalog Then
                If UBound(aFormulas) = 1 And (idx = NR Or idx = GCount) Then 'jrs 2006/02/02
                    start = 1
                Else
                    start = idx
                End If
                If idx > UBound(aFormulas) Then
                    ReDim Preserve aFormulas(idx)
                End If
                'f.Name = lblFormulaName.Text
                'f.Dimension = lblDimensionality.Text
                'f.Unit = lblUnits.Text
                For X = start To idx
                    aFormulas(X) = f
                Next X
            End If
        End If

        f = Nothing


        Exit Sub

CompHandler:
        _logger.Error(Err.GetException, "ComputeFormulasWAll - exception")
        Dim frm_msg As New frm_Message
        frm_msg.LoadMessage(Err.Description)
        Support.FormManager.StateStore(myPage)
        Support.FormManager.Show(myPage, "frm_Message.aspx")

    End Sub

    Private Sub PrepareTotVar(ByVal sOriginForm As String, ByRef f As Formula, ByVal iTotYears As Integer,
    ByVal LV_Chk_Indep As Object, ByVal DisYear As Integer, ByVal CountryTot As Integer)
        Select Case sOriginForm
            Case "frm_VarSel", "Global" 'jrs 2006/04/12
                f.itotYears = iTotYears
            Case "frm_ScatVarS"
                f.itotYears = 200
            Case "frm_LongVarS"
                If LV_Chk_Indep = 0 Then
                    f.itotYears = DisYear * CountryTot
                Else
                    f.itotYears = DisYear
                End If
        End Select
    End Sub

    Private Sub PrepareData(ByRef dim1 As Short, ByRef f As Formula, ByRef dataAll As Object, ByRef data As Object)
        'This has to pass elements from dataAll to data
        Dim i As Object
        Dim j As Short
        Dim arrTemp() As Object
        ReDim arrTemp(f.itotYears)

        For j = 1 To f.disVar.disSize()
            For i = 1 To f.itotYears
                arrTemp(i) = dataAll(j)(i, dim1)
            Next i
            data(j) = VB6.CopyArray(arrTemp)
        Next j
    End Sub

