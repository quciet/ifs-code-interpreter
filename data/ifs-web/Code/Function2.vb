    'jrs 2006/04/06
    'Get Currency Label
    Public Sub gCurrencyLblSwitch(ByVal idxVar As Integer, ByVal iColPosition As Integer, ByRef CurrencySym As String, ByRef GR4N As Object)
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        '1. idxVar is the Variable Index that will define if a currency convertion is needed or not
        '2. iColPosition identifies the position in the array GR3N where we want to make the label change
        '3. CurrencySym is the currency symbol
        '4. GR4N is a global array that contians labels

        'If it returns information, load it to the variables
        If CurrencySym > "" And CurrencySym <> "$" Then
            'Update the name of the Units
            Dim MyPos As Long
            Dim S As String
            Dim s2 As String
            s2 = VUnits(idxVar)
            'Using an Array for the Original Symbol
            'of every variable
            MyPos = InStr(1, s2, "$", vbTextCompare)
            S = RTrim(CurrencySym)
            If MyPos > 0 Then
                'Using an Array for the Original Symbol
                'of every variable
                GR4N(iColPosition) = Left(s2, MyPos - 1) + S + Right(s2, Len(s2) - MyPos)
            Else
                GR4N(iColPosition) = VUnits(idxVar)
            End If
        Else
            GR4N(iColPosition) = VUnits(idxVar)
        End If
    End Sub

    'jrs 2006/04/04 CENTRALIZE DISPLAYS
    'Loads a single column into an array
    Public Sub gLoadForDisplayHis(ByVal sVar As String, ByVal sDim1 As String,
    ByVal idxDim1 As Integer, ByVal sDim2 As String, ByVal idxDim2 As Integer,
    ByVal sDim3 As String, ByVal idxDim3 As Integer, ByRef bGroups As Object,
    ByVal Factor As Single, ByRef TargetVector As Object, ByVal iColPosition As Integer,
    ByVal iFirstYear As Integer, ByVal iLastYear As Integer,
    ByVal bSingleDim As Boolean, ByVal bHistoricAnalog As Boolean, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page,
    ByRef FinYear As Object, ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef bComputation As Boolean, ByRef sDefinition As String, ByRef sUnits As String,
    ByRef IfsParameters As myParameters, ByVal bfillHistoryOnlyHoles As Boolean,
    ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef StaYearHis As Object, ByRef SQLite As String)
        '1. sVar Variable Name
        '2. sDim1 Dimension1 Name
        '3. idxDim1 Dimension1 Index
        '4. sDim2 Dimension2 Name
        '5. idxDim2 Dimension2 Index
        '6. sDim3 Dimension3 Name
        '7. idxDim3 Dimension3 Index
        '8. bGroups is true when using groups, if Null we have to find out if using groups or not
        '9. Factor multiplies every value read from sFileName
        '10. TargetVector array where read values are stored
        '11. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '12. iFirstYear, 2000 for forecast, 1960 for History
        '13. iLastYear, 2000 to 2100 for forecast, 1960 to 2000 for history
        '14. bSingleDim is True when using a Single Dimension vector as Target
        '15. bHistoricAnalog is True when using as part of History plus Forecast
        '16. bfillHistoryHoles if true indicates the use of estimation to fill in the holes in history
        '17. buseAllHIstory if true it will ignore iLastYear and will retrieve all available history (> lastyearhistory, not < firstyearhistory)
        '18. iLstYrUseAllHistory is the last year of history loaded
        '19. bLoadForDisplaySuccess is a flag that indicates sucess when loading data
        '20. myForm is the web page that is calling this subroutine
        '21. FinYear is a global array that contains the number of points ploted
        '22. LastYear is a global variable
        '23. LastYearForecast is a global variable
        '24. bComputation is a global variable that indicates if we're doing a computation
        '25. sDefinition is a variable to return definition value
        '26. sUnits is a variable to return units value
        '27. IfsParameters is an object that contains the following parameters:
        'i. currencyVal 
        'ii. vShortSce (not used)
        'iii. RunFiles (not used)
        'iv. Ifs_MDB2Active is a global variable with the database with group information
        'v. IFsCoVaTrASeries_MDB is the path to the covatra historical series file
        'vi. IFsHistSeries_MDB is the path to ifshistseries.mdb
        'vii. PutFdrvRun is a global variable that contains the path to ifsvar.mdb
        'jrs 2011/03/28
        '28. bfillHistoryOnlyHoles is true when only filling holes and not extrapolation


        Dim i As Integer, j As Integer, kk As Integer
        Dim TableName As String
        Dim valtbl As DataTable
        Dim tblWeight As DataTable
        Dim sAgRule As String
        Dim bRegions As Boolean
        Dim NewVal As Object
        Dim NoVal As Object
        Dim row As DataRow, rowWeight As DataRow
        'jrs 2014/03/27
        Dim diff As Integer

        bLoadForDisplaySuccess = False

        Dim frm_msg As New frm_Message

        'Check Variable Name Parameter
        If sVar = "" Then
            frm_msg.LoadMessage("Invalid Variable Name Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        'Check Group Parameters
        If (bGroups Is Nothing) Then
            idxDim1 = gGetDimIdx(1, sDim1, False, myForm)
            bGroups = (idxDim1 < 1)
        End If

        'Check Dimension Parameters
        If sDim1 = "" Then
            frm_msg.LoadMessage("Invalid Dimension 1 Parameters")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If idxDim1 < 1 Then
            If bGroups Then
                idxDim1 = gGetGroupIdx(sDim1, True, myForm)
            Else
                idxDim1 = gGetDimIdx(1, sDim1, True, myForm)
            End If
        End If

        If idxDim1 = -1 Then
            Exit Sub
        End If

        'Check Target Parameters
        If iLastYear - iFirstYear + 1 > UBound(TargetVector, 1) Then
            frm_msg.LoadMessage("Invalid Year Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If
        If Not bSingleDim Then 'doubly dimension array
            If iColPosition > UBound(TargetVector, 2) Then
                frm_msg.LoadMessage("Invalid Initial Column")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'jrs 2009/01/21 Total
        Dim bTotal2 As Boolean, bTotal3 As Boolean
        bTotal2 = False
        bTotal3 = False
        'for weighted totals
        Dim bTotal2W As Boolean, bTotal3W As Boolean
        bTotal2W = False
        bTotal3W = False
        'jrs 2009/01/23 moved up
        Dim bUseNullsAs0 As Boolean
        'jrs 2011/03/28
        Dim SuggestedMaxEst As Single
        SuggestedMaxEst = 100
        'jrs 2014/03/27
        If iFirstYear < FirstYearHistory Then
            StaYearHis(iColPosition) = iFirstYear
        End If

        'jrs 2008/12/16
        Dim sHistAna As String

        'Historic Analog
        If bHistoricAnalog Then
            Dim idxVar As String
            idxVar = IfsVars.Item(sVar).Index
            'jrs 2011/03/28
            If idxVar > 0 Then
                SuggestedMaxEst = VMax(idxVar)
            End If

            'jrs 2008/10/07
            If Not IsDBNull(VHistoricAnalog(idxVar)) Then
                If UCase(VHistoricAnalog(idxVar)) = "FORMULA" Then
                    Dim dbCHA As String, qry As String, rsCHA As DataTable
                    dbCHA = IfsParameters.PutFdrvRun + "IFSVAR.MDB"
                    qry = "NAME = '" & V(idxVar) & "'"
                    If VDim2(idxVar) > 0 Then
                        qry = qry & " AND DIM2 = '" & Replace(sDim2, "'", "''") & "'"
                        If VDim3(idxVar) > 0 Then
                            qry = qry & " AND DIM3 = '" & sDim3 & "'"
                        End If
                    End If
                    'jrs 2006/07/24 Reload Table only if necessary
                    Try
                        rsCHA = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULAS")
                    Catch ex As ArgumentException
                        'jrs 2012/01/31 avoiding duplicate keys
                        SyncLock IFsTables
                            If Not IFsTables.Contains("SELECT * FROM IfsVarHISTANAFORMULAS") Then
                                SetDataTablefromAccess(dbCHA, "SELECT * FROM IfsVarHISTANAFORMULAS", "", rsCHA)
                                IFsTables.Add(rsCHA, "SELECT * FROM IfsVarHISTANAFORMULAS")
                            Else
                                rsCHA = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULAS")
                            End If
                        End SyncLock
                    End Try

                    Dim tblRowsCHA() As DataRow
                    tblRowsCHA = rsCHA.Select(qry)
                    'SetDataTablefromAccess(dbCHA, qry, "", rsCHA)
                    If tblRowsCHA.Length = 0 Then

                        'jrs 2009/01/23
                        bTotal2 = (UCase(sDim2) = "TOTAL")
                        bTotal3 = (UCase(sDim3) = "TOTAL")
                        'jrs 2018/12/03 DALY, Males and Females are not available so need to read Total, not sum
                        If bTotal2 And bTotal3 Then
                            'if Total exist, use it
                            If IFsHistAnalogs.Item(V(idxVar), GRPS(VDim2(idxVar), 1), sDim3).sHistAna > "" Then
                                bTotal3 = False
                            End If
                        End If

                        If bTotal2 Or bTotal3 Then
                            'check for Gender Total and Age Total
                            'jrs 2018/12/03
                            If VAggregation(idxVar) <> "SUM" Then
                                If bTotal2 Then
                                    If VDim2(idxVar) = GenderIdx Or VDim2(idxVar) = Age15_80Idx Or
                                    VDim2(idxVar) = Age18_65Idx Or VDim2(idxVar) = Age30_70Idx Then
                                        bTotal2W = True
                                    End If
                                End If
                                If bTotal3 Then
                                    If VDim3(idxVar) = GenderIdx Or VDim3(idxVar) = Age15_80Idx Or
                                    VDim3(idxVar) = Age18_65Idx Or VDim3(idxVar) = Age30_70Idx Then
                                        bTotal3W = True
                                    End If
                                End If
                            End If

                            If bTotal2W Or bTotal3W Then
                                'need weighted average
                                'only when all dimensions are weighted
                                If bTotal2 = bTotal2W And bTotal3 = bTotal3W Then
                                    'using weighted average
                                    gLoadForDisplayHisTotW(V(idxVar), sDim1, idxDim1, sDim2, bTotal2, sDim3, bTotal3, bGroups,
                                        TargetVector, bSingleDim, iColPosition,
                                        bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory,
                                        bLoadForDisplaySuccess, myForm, FinYear, LastYear, LastYearForecast, bComputation,
                                        sDefinition, sUnits, IfsParameters, bfillHistoryOnlyHoles,
                                        bCompAll, dataAll, StaYearHis, SQLite)
                                    Exit Sub
                                End If
                            Else
                                'jrs 2010/08/27 if simply summing up Nulls As 0 should be fine
                                'jrs 2026/07/17 bUseNullsAs0 = True
                                'Not really, problematic for GDS(Total), where GDS(Other) is (T-M-E-H-R)*G/100
                                '(GovCon%GDP - GovtMil%GDPWDI - GovtEdPub%GDP - GovtHl%GDP - R&DGovt%GNP)*GDP2021/100
                                'if T (GovCon%GDP) is 0, that is going to produce a big negative number
                                bUseNullsAs0 = False
                                'else regular sum will do
                                gLoadForDisplayHisTot(V(idxVar), sDim1, sDim2, bTotal2, sDim3, bTotal3,
                                    bGroups, bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, bUseNullsAs0,
                                    iColPosition, bComputation, iFirstYear, iLastYear, LastYearForecast,
                                    bLoadForDisplaySuccess, myForm, FinYear, IfsParameters, TargetVector,
                                    bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, StaYearHis(iColPosition), SQLite)
                                Exit Sub
                            End If
                        End If

                        'jrs 2008/12/17
                        'frm_msg.LoadMessage("This dimension doesn't have a formula associated.")
                        'Support.FormManager.StateStore(myForm)
                        'Support.FormManager.Show(myForm, "frm_Message.aspx")
                    Else 'jrs 2008/12/17
                        'jrs 2008/05/22
                        'jrs 2009/01/27 Dim bUseNullsAs0 As Boolean
                        If Not IsDBNull(tblRowsCHA(0).Item("UseNullsAsZeros")) Then
                            bUseNullsAs0 = tblRowsCHA(0).Item("UseNullsAsZeros")
                        End If

                        'jrs 2018/09/10 Added AND iColPosition = 1, only move for col = 1, because it will be moved back inside, otherwise problems
                        'jrs 2014/04/23
                        'if iFirstYear is < than FirstYearHistory, need to move the PlotComp back as if it was based on 1960
                        'this is because gLoadCompHistAnal doesn't have a FirstYear Parameter, and thus assumes the forecast Plot starts
                        'at LastYearHistory - FirstYearHistory + 1
                        If iFirstYear < FirstYearHistory And iColPosition = 1 Then
                            diff = FirstYearHistory - iFirstYear
                            For i = 1 To LastYearForecast - FirstYearForecast + 1
                                TargetVector(i + LastYearHistory - FirstYearHistory) = TargetVector(i + LastYearHistory - FirstYearHistory + diff)
                            Next i
                        End If

                        gLoadCompHistAnal(iColPosition, tblRowsCHA(0).Item("Formula"), idxVar,
                        sDim1, idxDim1, sDim2, idxDim2, sDim3, idxDim3, bGroups, dbCHA, bfillHistoryHoles,
                        buseAllHistory, iLstYrUseAllHistory, LastYear, LastYearForecast, myForm,
                        bLoadForDisplaySuccess, FinYear, bComputation, TargetVector, IfsParameters,
                        bUseNullsAs0, bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, SQLite)

                        Exit Sub
                    End If 'jrs 2008/12/17
                End If 'eof if HistoricAnalog = FORMULA
            End If 'eof if HistoricAnalog <> NULL

            'jrs 2008/05/01
            If IsDBNull(VHistoricAnalog(idxVar)) Then
                'jrs 2008/12/16 Load an array full of nulls
                'frm_msg.LoadMessage("This variable doesn't have a Historic Analog option.")
                'Support.FormManager.StateStore(myForm)
                'Support.FormManager.Show(myForm, "frm_Message.aspx")
                sHistAna = "ALLNULLS"
            ElseIf Trim(VHistoricAnalog(idxVar)) = "" Then
                'jrs 2008/12/16 Load an array full of nulls
                'frm_msg.LoadMessage("This variable doesn't have a Historic Analog option.")
                'Support.FormManager.StateStore(myForm)
                'Support.FormManager.Show(myForm, "frm_Message.aspx")
                sHistAna = "ALLNULLS"
            ElseIf UCase(VHistoricAnalog(idxVar)) = "FORMULA" Then 'jrs 2008/12/17
                sHistAna = "ALLNULLS"
            Else
                sHistAna = VHistoricAnalog(idxVar)
            End If

            'jrs 2012/11/09 added or VDim1(idxvar) = 0, DIPLOXXXMAX is the analog option for variables that don't have dimensions
            If (VDim1(idxVar) = 1 And VDim2(idxVar) = 0) Or
            sHistAna = "ALLNULLS" Or VDim1(idxVar) = 0 Then 'jrs 2008/12/17 added or allnulls
                sVar = sHistAna 'jrs 2008/12/17 VHistoricAnalog(idxVar)
                TableName = "Series" + sVar
            ElseIf VDim1(idxVar) = 1 And VDim2(idxVar) = 1 Then
                'jrs 2025/01/13 go to Bilateral Historical Analog
                gLoadForDisplayHisBilateral(sVar, sDim1, idxDim1, sDim2, idxDim2,
                sDim3, idxDim3, bGroups, Nothing, Factor, TargetVector, iColPosition,
                iFirstYear, iLastYear, bSingleDim, bfillHistoryHoles,
                buseAllHistory, iLstYrUseAllHistory, bLoadForDisplaySuccess, myForm,
                FinYear, LastYear, LastYearForecast, bComputation, sDefinition, sUnits,
                IfsParameters, bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, SQLite)
                Exit Sub
            ElseIf VHistoricAnalog(idxVar) = "IFSVARHISTANA" Then 'JRS 2006/06/05 DIM3
                sVar = IFsHistAnalogs.Item(V(idxVar), sDim2, sDim3).sHistAna

                'jrs 2009/01/21 Total
                If sVar = "" Then
                    bTotal2 = (UCase(sDim2) = "TOTAL")
                    bTotal3 = (UCase(sDim3) = "TOTAL")
                    If bTotal2 Or bTotal3 Then
                        'jrs 2018/12/03
                        If VAggregation(idxVar) <> "SUM" Then
                            'check for Gender Total and Age Total
                            If bTotal2 Then
                                If VDim2(idxVar) = GenderIdx Or VDim2(idxVar) = Age15_80Idx Or
                            VDim2(idxVar) = Age18_65Idx Or VDim2(idxVar) = Age30_70Idx Then
                                    bTotal2W = True
                                End If
                            End If
                            If bTotal3 Then
                                If VDim3(idxVar) = GenderIdx Or VDim3(idxVar) = Age15_80Idx Or
                            VDim3(idxVar) = Age18_65Idx Or VDim3(idxVar) = Age30_70Idx Then
                                    bTotal3W = True
                                End If
                            End If
                        End If

                        If bTotal2W Or bTotal3W Then
                            'need weighted average
                            'only when all dimensions are weighted
                            If bTotal2 = bTotal2W And bTotal3 = bTotal3W Then
                                'using weighted average
                                gLoadForDisplayHisTotW(V(idxVar), sDim1, idxDim1, sDim2, bTotal2, sDim3, bTotal3, bGroups,
                                TargetVector, bSingleDim, iColPosition,
                                bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory,
                                bLoadForDisplaySuccess, myForm, FinYear, LastYear, LastYearForecast, bComputation,
                                sDefinition, sUnits, IfsParameters, bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, SQLite)
                                Exit Sub
                            End If
                        Else
                            'jrs 2019/05/22 if simply summing up Nulls As 0 should be fine
                            bUseNullsAs0 = True
                            'else regular sum will do
                            gLoadForDisplayHisTot(V(idxVar), sDim1, sDim2, bTotal2, sDim3, bTotal3,
                            bGroups, bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, bUseNullsAs0,
                            iColPosition, bComputation, iFirstYear, iLastYear, LastYearForecast,
                            bLoadForDisplaySuccess, myForm, FinYear, IfsParameters, TargetVector,
                            bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, StaYearHis(iColPosition), SQLite)
                            Exit Sub
                        End If
                    End If
                End If

                If sVar = "" Then
                    'jrs 2008/12/17
                    'frm_msg.LoadMessage("This dimension doesn't have a Historic Analog option.")
                    'Support.FormManager.StateStore(myForm)
                    'Support.FormManager.Show(myForm, "frm_Message.aspx")
                    sVar = "ALLNULLS"
                    'jrs 2009/01/20
                    sHistAna = "ALLNULLS"
                End If
                TableName = "Series" + sVar
            Else
                TableName$ = "Series"
                Dim txt As String, tmptblname As String, k As String
                Dim tmpTblNo As Integer
                If idxDim2 < 1 Then
                    idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                Else 'jrs 2009/01/23
                    If UCase(sDim2) <> UCase(GRPS(VDim2(idxVar), idxDim2)) Then
                        idxDim2 = -1
                    End If
                End If

                'jrs 2009/01/21 Total
                If idxDim2 = -1 And UCase(sDim2) = "TOTAL" And VDim2(idxVar) > 1 Then
                    bTotal2 = True
                    'check for Gender Total and Age Total
                    If VDim2(idxVar) = GenderIdx Or VDim2(idxVar) = Age15_80Idx Or
                    VDim2(idxVar) = Age18_65Idx Or VDim2(idxVar) = Age30_70Idx Then
                        bTotal2W = True
                        'using weighted average
                        gLoadForDisplayHisTotW(V(idxVar), sDim1, idxDim1, sDim2, bTotal2, sDim3, bTotal3, bGroups,
                        TargetVector, bSingleDim, iColPosition,
                        bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory,
                        bLoadForDisplaySuccess, myForm, FinYear, LastYear, LastYearForecast, bComputation,
                        sDefinition, sUnits, IfsParameters, bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, SQLite)
                        Exit Sub
                    Else
                        'else regular sum will do
                        gLoadForDisplayHisTot(V(idxVar), sDim1, sDim2, bTotal2, sDim3, False,
                        bGroups, bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, bUseNullsAs0,
                        iColPosition, bComputation, iFirstYear, iLastYear, LastYearForecast,
                        bLoadForDisplaySuccess, myForm, FinYear, IfsParameters, TargetVector,
                        bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, StaYearHis(iColPosition), SQLite)
                        Exit Sub
                    End If
                End If

                sVar = gLoadHistAnalogTableFromString(idxVar, idxDim2) 'jrs 2009/01/23 moved code to function
                If sVar = "" Then
                    'jrs 2012/11/22
                    If VDim2(idxVar) = GenderIdx And UCase(sDim2) = "TOTAL" Then
                        bTotal2 = True
                        bTotal2W = True
                        'using weighted average
                        gLoadForDisplayHisTot(V(idxVar), sDim1, sDim2, bTotal2, sDim3, False,
                        bGroups, bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, bUseNullsAs0,
                        iColPosition, bComputation, iFirstYear, iLastYear, LastYearForecast,
                        bLoadForDisplaySuccess, myForm, FinYear, IfsParameters, TargetVector,
                        bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, StaYearHis(iColPosition), SQLite)

                        Exit Sub
                    End If

                    'MsgBox("Historic Analog Option doesn't exist for this dimension", vbInformation, "Historic Analog")
                    sHistAna = "ALLNULLS"
                End If
                TableName = "Series" + sVar

            End If
        End If

        'jrs 2008/12/16
        'Load Nulls
        '----------
        If sHistAna = "ALLNULLS" Then
            For i = 1 To iLastYear - iFirstYear + 1
                'Store Value
                If bSingleDim Then 'single dimension array
                    TargetVector(i) = DBNull.Value
                Else
                    TargetVector(i, iColPosition) = DBNull.Value
                End If
            Next i
            bLoadForDisplaySuccess = True
            FinYear(iColPosition) = iLastYear - iFirstYear + 1
            Exit Sub
        End If

        'Load Table Name
        '---------------
        Dim db2 As String
        Dim VarValSave As String
        db2 = IfsParameters.PutFdrvRun + "datadict.MDB"
        'jrs 2006/07/24 Reload Table only if necessary
        Try
            valtbl = IFsTables.Item("SELECT * FROM DataDict")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM DataDict") Then
                    SetDataTablefromAccess(db2, "SELECT * FROM DataDict", "", valtbl)
                    IFsTables.Add(valtbl, "SELECT * FROM DataDict")
                Else
                    valtbl = IFsTables.Item("SELECT * FROM DataDict")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = valtbl.Select("Variable = '" & sVar & "'")
        'SetDataTablefromAccess(db2, "SELECT * FROM DataDict WHERE Variable = '" & sVar & "'", "", valtbl)
        'Check Variable Name Parameter
        If tblRows.Length = 0 Then
            frm_msg.LoadMessage("Invalid Variable Name Parameter" & "<br>" &
            "Variable " & sVar & " doesn't exist in DataDict.db")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        VarValSave = tblRows(0).Item("CoVaTrA")
        If TableName = "" Then
            TableName = tblRows(0).Item("Table")
        End If
        sAgRule = tblRows(0).Item("Aggregation")
        sDefinition = tblRows(0).Item("Definition")
        sUnits = tblRows(0).Item("Units")
        'jrs 2011/01/26
        Dim bTreatNullsAs0s As Boolean
        bTreatNullsAs0s = tblRows(0).Item("TreatNullsAs0s")
        'jrs 2008/05/09
        Dim bCurrency As Boolean
        'jrs 2023/09/27 bCurrency = IIf(IsDBNull(tblRows(0).Item("Currency")), False, tblRows(0).Item("Currency"))
        If IsDBNull(tblRows(0).Item("Currency")) Then
            bCurrency = False
        Else
            If tblRows(0).Item("Currency") = "" Then
                bCurrency = False
            Else
                bCurrency = tblRows(0).Item("Currency")
            End If
        End If

        'jrs 2008/05/09
        If bCurrency And Trim(IfsParameters.currencySym) > "" Then
            sUnits = Replace(sUnits, "$", IfsParameters.currencySym)
        End If

        'Open File 
        Dim db As String, spwd As String
        If UCase$(Regionalization$) <> UCase$("RegionalizationCoVaTrA") Or VarValSave <> "Yes" Then
            db = IfsParameters.IFsHistSeries_MDB
            spwd = DataPW$
        Else
            db = IfsParameters.IFsCoVaTrASeries_MDB
            spwd = ""
        End If


        'Load Group Members
        '------------------
        Dim gCountGroupMembers As Integer
        Dim gGroupMembrs() As String
        If bGroups Then
            gLoadGroupMembersHis(sDim1, GroupCodes(idxDim1), gCountGroupMembers, gGroupMembrs, IfsParameters.Ifs_MDB2Active)
        Else
            gLoadRegionMembersHis(sDim1, idxDim1, gCountGroupMembers, gGroupMembrs, IFs_MDB)
            bRegions = (gCountGroupMembers > 1)
        End If

        'jrs 2008/05/09
        'Get Currency Factor
        Dim CurrencyFct As Single
        If bCurrency And IfsParameters.currencyVal <> 0 Then
            CurrencyFct = IfsParameters.currencyVal
        Else
            CurrencyFct = 1
        End If

        'Load Target Vector
        '------------------
        Dim agcount As Integer
        Dim totalYearFields As Integer
        Dim seriesYears() As Single
        Dim Sumplot As Object, SumWeight As Object
        Dim NullFound As Boolean
        'jrs 2008/11/11
        Dim MaxValEst As Single
        'jrs 2009/03/03 when using all available history
        'sometimes last years are null, then better show forecast
        Dim iLastYearNotNull As Integer
        iLastYearNotNull = LastYearHistory - 1
        'jrs 2015/08/28 moved up to use in both branches, groups or countries
        Dim iFirstYearOrg As Integer

        If bGroups Or bRegions Then

            agcount = gCountGroupMembers

            'jrs 2006/07/24 Reload Table only if necessary
            Try
                valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
            Catch ex As ArgumentException
                'jrs 2012/01/31 avoid duplicate keys
                SyncLock IFsTables
                    If Not IFsTables.Contains("SELECT * FROM [" & TableName & "]") Then
                        SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
                        IFsTables.Add(valtbl, "SELECT * FROM [" & TableName & "]")
                    Else
                        valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
                    End If
                End SyncLock
            End Try
            'SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
            'jrs 2006/09/28 gen. agg.
            Dim sTbl As String, sEmpVar As String
            'jrs 2023/09/08
            If sAgRule <> "SUM" And sAgRule <> "AVG" Then
                sEmpVar = IFsAggRules.Item(sAgRule).HisEmpVar
            End If

            'jrs 2008/11/11
            If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                MaxValEst = findMaxValGrp(valtbl, gGroupMembrs, agcount)
                If MaxValEst < 100 Then
                    MaxValEst = 100
                End If
                'MaxValEst = 1.2 * MaxValEst
            End If

            Dim MaxAuxYr As Integer
            MaxAuxYr = 5000
            Dim AuxUnits As String, AuxMaxValEst As Single
            If sEmpVar > "" Then
                'jrs 2011/03/28
                Dim valtbl2 As DataTable
                valtbl2 = IFsTables.Item("SELECT * FROM DataDict")
                tblRows = valtbl2.Select("Variable = '" & sEmpVar & "'")
                AuxUnits = tblRows(0).Item("Units")

                sTbl = "[Series" & sEmpVar & "]"
                Try
                    tblWeight = IFsTables.Item("SELECT * FROM " & sTbl)
                Catch ex As ArgumentException
                    'jrs 2012/01/31 avoid duplicate keys
                    SyncLock IFsTables
                        If Not IFsTables.Contains("SELECT * FROM " & sTbl) Then
                            SetDataTablefromAccess(db, "SELECT * FROM " & sTbl, "Country", tblWeight, spwd)
                            IFsTables.Add(tblWeight, "SELECT * FROM " & sTbl)
                        Else
                            tblWeight = IFsTables.Item("SELECT * FROM " & sTbl)
                        End If
                    End SyncLock
                End Try
                MaxAuxYr = Val(tblWeight.Columns(tblWeight.Columns.Count - 3).Caption) 'jrs 2006/10/08, HDI, World, using AAH

                'jrs 2011/03/28
                Dim AuxForIdx As Integer
                AuxMaxValEst = 100
                AuxForIdx = IfsVars.Item(IFsAggRules.Item(sAgRule).ForecastVar).Index
                If AuxForIdx > 0 Then
                    AuxMaxValEst = VMax(AuxForIdx)
                End If
            End If

            'Select Case sAgRule
            '    Case "GDP"
            '        SetDataTablefromAccess(db, "SELECT * FROM [SeriesGDP95]", "Country", tblWeight, spwd)
            '    Case "POP"
            '        SetDataTablefromAccess(db, "SELECT * FROM [SeriesPopulation]", "Country", tblWeight, spwd)
            '    Case "LND"
            '        SetDataTablefromAccess(db, "SELECT * FROM [SeriesLandTotal]", "Country", tblWeight, spwd)
            'End Select

            totalYearFields = valtbl.Columns.Count - 2
            ReDim seriesYears(totalYearFields)
            For i = 1 To totalYearFields
                seriesYears(i) = Val(valtbl.Columns(i + 1).Caption)
            Next i
            'jrs 2015/08/31 j = 1

            Dim Auxfld As String, Auxval As Object
            Dim VarVal As Object, SumNum As Object

            'jrs 2006/09/22
            If buseAllHistory Then
                For i = totalYearFields To 1 Step -1
                    If seriesYears(i) > 0 And seriesYears(i) <= MaxAuxYr Then 'jrs 2006/10/08
                        'jrs 2010/08/27
                        If seriesYears(i) > LastYearHistory - 1 Then
                            iLastYear = seriesYears(i)
                        End If
                        iLstYrUseAllHistory = iLastYear
                        Exit For
                    End If
                Next i
                'jrs 2014/03/26
                If seriesYears(1) < iFirstYear Then
                    iFirstYearOrg = iFirstYear
                    iFirstYear = seriesYears(1)
                    'jrs 2014/04/15 iFstYrUseAllHisotry = iFirstYear
                    If Not bSingleDim Then
                        StaYearHis(iColPosition) = iFirstYear
                    Else
                        If StaYearHis(iColPosition) > iFirstYear Or StaYearHis(iColPosition) = 0 Then
                            StaYearHis(iColPosition) = iFirstYear
                        Else
                            iFirstYear = StaYearHis(iColPosition)
                        End If
                    End If
                    'Need to move previous columns
                    If Not bSingleDim And iColPosition > 1 Then  'doubly dimension array
                        For j = 1 To iColPosition - 1
                            If iFirstYear < StaYearHis(j) Or StaYearHis(j) < 1 Then
                                If StaYearHis(j) < 1 Then
                                    'jrs 2015/08/28 diff = FirstYearHistory - iFirstYear
                                    diff = iFirstYearOrg - iFirstYear
                                Else
                                    diff = StaYearHis(j) - iFirstYear
                                End If
                                For i = FinYear(j) To 1 Step -1
                                    TargetVector(i + diff, j) = TargetVector(i, j)
                                Next i
                                For i = 1 To diff
                                    TargetVector(i, j) = DBNull.Value
                                Next i
                                FinYear(j) = FinYear(j) + diff
                                StaYearHis(j) = iFirstYear
                            End If
                        Next j
                    End If
                    'jrs 2015/08/28 If bHistoricAnalog And iFirstYear < FirstYearHistory Then
                    'Need to move current column for forecast part on history+forecast
                    If bHistoricAnalog And iFirstYear < iFirstYearOrg Then
                        diff = FirstYearHistory - iFirstYear
                        If Not bSingleDim Then
                            For i = LastYearHistory - FirstYearHistory + FinYear(iColPosition) To LastYearHistory - FirstYearHistory + 1 Step -1
                                TargetVector(i + diff, iColPosition) = TargetVector(i, iColPosition)
                                TargetVector(i, iColPosition) = DBNull.Value
                            Next i
                        Else
                            For i = LastYearHistory - FirstYearHistory + FinYear(iColPosition) To LastYearHistory - FirstYearHistory + 1 Step -1
                                TargetVector(i + diff) = TargetVector(i)
                                TargetVector(i) = DBNull.Value
                            Next i
                        End If
                    End If
                End If

            End If

            'jrs 2015/08/28 moved from above, there's a loop using j
            j = 1

            For i = 1 To iLastYear - iFirstYear + 1
                NullFound = False
                'Code to start reading data from first year
                Do While i + iFirstYear - 1 > seriesYears(j) And j < totalYearFields
                    j = j + 1
                Loop
                If j <= totalYearFields And i + iFirstYear - 1 = seriesYears(j) Then
                    'data for this year is in Table
                    Select Case sAgRule
                        Case "SUM"
                            'jrs 2007/07/30 Sumplot = 0
                            Sumplot = System.DBNull.Value
                            VarVal = 0
                            For kk = 1 To agcount
                                row = SeekRow(valtbl, gGroupMembrs(kk))
                                VarVal = row.Item(j + 1)
                                If Not IsNumeric(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                    VarVal = fillHistoryHoles(row, j + 1, Val(valtbl.Columns(j + 1).Caption), bfillHistoryOnlyHoles, bHistoricAnalog)
                                    'jrs 2008/05/13
                                    If IsNumeric(VarVal) Then
                                        If sUnits = "Percent" And VarVal > 100 Then
                                            'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                            If VarVal > MaxValEst Then
                                                VarVal = MaxValEst
                                            End If
                                        ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                            VarVal = 0
                                            'jrs 2011/03/28
                                        ElseIf sUnits = "Index" And VarVal > MaxValEst Then
                                            VarVal = MaxValEst
                                        End If
                                    End If
                                End If
                                'jrs 2011/01/26
                                If IsDBNull(VarVal) And bTreatNullsAs0s Then
                                    VarVal = 0
                                End If
                                '1st and second field = Country and Fips
                                If (IsNumeric(VarVal)) Then
                                    'jrs 2007/07/20
                                    If IsDBNull(Sumplot) Then
                                        Sumplot = VarVal
                                    Else
                                        Sumplot = Sumplot + VarVal
                                    End If
                                Else
                                    'There are Nulls in the set
                                    VarVal = 0
                                    NullFound = True
                                End If
                            Next kk
                            VarVal = Sumplot

                        Case "AVG"
                            Sumplot = 0
                            SumNum = 0
                            For kk = 1 To agcount
                                row = SeekRow(valtbl, gGroupMembrs(kk))
                                VarVal = row.Item(j + 1)
                                If Not IsNumeric(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                    VarVal = fillHistoryHoles(row, j + 1, Val(valtbl.Columns(j + 1).Caption), bfillHistoryOnlyHoles, bHistoricAnalog)
                                    'jrs 2008/05/13
                                    If IsNumeric(VarVal) Then
                                        If sUnits = "Percent" And VarVal > 100 Then
                                            'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                            If VarVal > MaxValEst Then
                                                VarVal = MaxValEst
                                            End If
                                        ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                            VarVal = 0
                                            'jrs 2011/03/28
                                        ElseIf sUnits = "Index" And VarVal > MaxValEst Then
                                            VarVal = MaxValEst
                                        End If
                                    End If
                                End If
                                'jrs 2011/01/26
                                If IsDBNull(VarVal) And bTreatNullsAs0s Then
                                    VarVal = 0
                                End If
                                '1st and second field = Country and Fips
                                If (IsNumeric(VarVal)) Then
                                    Sumplot = Sumplot + VarVal
                                    SumNum = SumNum + 1
                                Else
                                    VarVal = 0
                                    NullFound = True
                                End If
                            Next kk
                            If SumNum <> 0 Then
                                VarVal = Sumplot / SumNum
                            Else
                                'jrs 2007/07/30 VarVal = 0 ' 0 in denom
                                VarVal = System.DBNull.Value
                            End If

                        Case Else 'jrs 2006/09/28
                            If sEmpVar > "" Then
                                'jrs 2007/07/30 Sumplot = 0
                                Sumplot = System.DBNull.Value
                                SumWeight = 0
                                For kk = 1 To agcount
                                    row = SeekRow(valtbl, gGroupMembrs(kk))
                                    VarVal = row.Item(j + 1)
                                    If Not IsNumeric(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                        VarVal = fillHistoryHoles(row, j + 1, Val(valtbl.Columns(j + 1).Caption), bfillHistoryOnlyHoles, bHistoricAnalog)
                                        'jrs 2008/05/13
                                        If IsNumeric(VarVal) Then
                                            If sUnits = "Percent" And VarVal > 100 Then
                                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                                If VarVal > MaxValEst Then
                                                    VarVal = MaxValEst
                                                End If
                                            ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                                VarVal = 0
                                                'jrs 2011/03/28
                                            ElseIf sUnits = "Index" And VarVal > MaxValEst Then
                                                VarVal = MaxValEst
                                            End If
                                        End If
                                    End If
                                    'jrs 2011/01/26
                                    If IsDBNull(VarVal) And bTreatNullsAs0s Then
                                        VarVal = 0
                                    End If

                                    '1st and second field = Country and Fips
                                    If sAgRule = "LND" Then
                                        Auxfld$ = "MostRecent"
                                    Else
                                        'jrs 2015/06/04
                                        If seriesYears(j) < FirstYearHistory Then
                                            Auxfld$ = "Earliest"
                                        Else
                                            Auxfld$ = Trim(Str(seriesYears(j)))
                                        End If
                                    End If
                                    rowWeight = SeekRow(tblWeight, gGroupMembrs(kk))
                                    Auxval = rowWeight(Auxfld)
                                    If Not IsNumeric(Auxval) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                        Auxval = fillHistoryHoles(rowWeight, -1, seriesYears(j), bfillHistoryOnlyHoles, bHistoricAnalog)
                                        'jrs 2008/05/13
                                        If IsNumeric(Auxval) Then
                                            If sUnits = "Percent" And Auxval > 100 Then
                                                Auxval = 100
                                            ElseIf sVar <> "PopulationGrowthRate" And Auxval < 0 Then
                                                Auxval = 0
                                                'jrs 2011/03/28
                                            ElseIf AuxUnits = "Index" And Auxval > AuxMaxValEst Then
                                                Auxval = AuxMaxValEst
                                            End If
                                        End If
                                    End If
                                    If (IsNumeric(VarVal)) And (IsNumeric(Auxval)) Then
                                        'jrs 2007/07/20
                                        If IsDBNull(Sumplot) Then
                                            Sumplot = VarVal * Auxval
                                        Else
                                            Sumplot = Sumplot + VarVal * Auxval
                                        End If
                                        SumWeight = SumWeight + Auxval
                                    Else
                                        NullFound = True
                                        VarVal = 0
                                        Auxval = 0
                                    End If
                                Next kk
                                If SumWeight <> 0 Then
                                    VarVal = Sumplot / SumWeight
                                ElseIf IsDBNull(Sumplot) Then 'jrs 2007/07/20 in case all values are null
                                    VarVal = System.DBNull.Value
                                Else
                                    VarVal = 0  'Zero In Denominator
                                End If
                            End If

                    End Select

                    'jrs 2008/05/09
                    'Apply Currency Convertion
                    If IsNumeric(VarVal) Then
                        VarVal = VarVal / CurrencyFct
                        'jrs 2008/11/14 
                        'the if statement bellow from 2007/07/30 was probably to avoid doing the multiplication on a Null
                        VarVal = VarVal * Factor
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If
                    End If

                    'jrs 2009/03/03
                    'Avoid overwritting forecast with Nulls
                    If Not (IsDBNull(VarVal) And buseAllHistory And i + iFirstYear - 1 > iLastYearNotNull) Then
                        'jrs 2007/07/30
                        'jrs 2008/11/14 If IsNumeric(VarVal) Then
                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = VarVal 'jrs 2008/11/14 * Factor
                        Else
                            TargetVector(i, iColPosition) = VarVal 'jrs 2008/11/14 * Factor
                        End If
                        'jrs 2008/11/14 End If
                        'we need to load null values, otherwise we get problems in formulas
                        'where the same vector is reused to load each item of the formula
                        'and some years have data and others don't ex. GDS/GDP hist+for
                    End If

                    j = j + 1
                    'Check if it's the last year with data
                    If j > UBound(seriesYears) Then 'jrs 2006/06/06 LandUrban%Built only has data for 1992
                        Exit For
                    End If

                Else
                    If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                        NoVal = fillHistoryHolesforGroups(valtbl, -1, iFirstYear + i - 1, sAgRule, tblWeight, gCountGroupMembers, gGroupMembrs, sUnits, MaxValEst, sVar, bfillHistoryOnlyHoles, bHistoricAnalog)
                        'jrs 2008/05/13
                        If IsNumeric(NoVal) Then
                            If sUnits = "Percent" And NoVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NoVal > MaxValEst Then
                                    NoVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NoVal < 0 Then
                                NoVal = 0
                                'jrs 2011/03/28
                            ElseIf sUnits = "Index" And NoVal > MaxValEst Then
                                NoVal = MaxValEst
                            End If
                        End If
                    Else
                        NoVal = System.DBNull.Value
                    End If

                    'jrs 2008/05/09
                    'Apply Currency Convertion
                    If Not IsDBNull(NoVal) Then
                        NoVal = NoVal / CurrencyFct
                        'jrs 2009/03/03
                        NoVal = NoVal * Factor
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If
                    End If

                    'jrs 2009/03/03
                    'Avoid overwritting forecast with Nulls
                    If Not (IsDBNull(NoVal) And buseAllHistory And i + iFirstYear - 1 > iLastYearNotNull) Then
                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = NoVal
                        Else
                            TargetVector(i, iColPosition) = NoVal
                        End If
                    End If

                End If

            Next i
        Else  ' 1 country in the region, aggregation not needed
            NullFound = False
            'jrs 2006/07/24 Reload Table only if necessary
            Try
                valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
            Catch ex As ArgumentException
                'jrs 2012/01/31 avoid duplicate keys
                SyncLock IFsTables
                    If Not IFsTables.Contains("SELECT * FROM [" & TableName & "]") Then
                        SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
                        IFsTables.Add(valtbl, "SELECT * FROM [" & TableName & "]")
                    Else
                        valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
                    End If
                End SyncLock
            End Try
            'SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
            row = SeekRow(valtbl, gGroupMembrs(1))

            'jrs 2008/11/11
            If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                MaxValEst = findMaxValCtry(valtbl, gGroupMembrs(1))
                If MaxValEst < 100 Then
                    MaxValEst = 100
                End If
                'MaxValEst = 1.2 * MaxValEst
            End If

            totalYearFields = valtbl.Columns.Count - 2
            ReDim seriesYears(totalYearFields)
            For i = 1 To totalYearFields
                seriesYears(i) = Val(valtbl.Columns(i + 1).Caption)
            Next i
            'jrs 2006/09/22
            If buseAllHistory Then
                For i = totalYearFields To 1 Step -1
                    If seriesYears(i) > 0 Then
                        'jrs 2010/08/27 added if to keep using forecast instead of trying to fill holes above base year
                        If Not IsDBNull(row.Item(CStr(seriesYears(i)))) Or seriesYears(i) < FirstYearForecast Then
                            'jrs 2010/08/20 to fill holes at the end of the table
                            If seriesYears(i) > FirstYearForecast - 1 Then
                                iLastYear = seriesYears(i)
                            Else
                                iLastYear = FirstYearForecast - 1
                            End If
                            iLstYrUseAllHistory = iLastYear
                            Exit For
                        End If
                    End If
                Next i
                'jrs 2014/03/26
                If seriesYears(1) < iFirstYear Then
                    iFirstYearOrg = iFirstYear
                    iFirstYear = seriesYears(1)
                    'jrs 2025/05/13 only allowing MaxYears, that's 305 years, that's enough
                    'CARANN has data to 1751 but only for the UK and that was giving problems here
                    If MaxYears < LastYearHistory - iFirstYear + FinYear(iColPosition) Then
                        iFirstYear = seriesYears(LastYearHistory - iFirstYear + FinYear(iColPosition) - MaxYears + 1)
                    End If
                    'jrs 2014/04/15 iFstYrUseAllHisotry = iFirstYear
                    If Not bSingleDim Then
                        StaYearHis(iColPosition) = iFirstYear
                    Else
                        If StaYearHis(iColPosition) > iFirstYear Or StaYearHis(iColPosition) = 0 Then
                            StaYearHis(iColPosition) = iFirstYear
                        ElseIf StaYearHis(iColPosition) > 0 Then
                            iFirstYear = StaYearHis(iColPosition)
                        End If
                    End If
                    'Need to move previous columns
                    If Not bSingleDim And iColPosition > 1 Then  'doubly dimension array
                        For j = 1 To iColPosition - 1
                            If iFirstYear < StaYearHis(j) Or StaYearHis(j) < 1 Then
                                If StaYearHis(j) < 1 Then
                                    'jrs 2015/08/28 diff = FirstYearHistory - iFirstYear
                                    diff = iFirstYearOrg - iFirstYear
                                Else
                                    diff = StaYearHis(j) - iFirstYear
                                End If
                                For i = FinYear(j) To 1 Step -1
                                    TargetVector(i + diff, j) = TargetVector(i, j)
                                Next i
                                For i = 1 To diff
                                    TargetVector(i, j) = System.DBNull.Value
                                Next i
                                FinYear(j) = FinYear(j) + diff
                                StaYearHis(j) = iFirstYear
                            End If
                        Next j
                    End If
                    'Need to move current column for forecast part on history+forecast
                    If bHistoricAnalog And iFirstYear < iFirstYearOrg Then
                        diff = iFirstYearOrg - iFirstYear
                        If Not bSingleDim Then
                            For i = LastYearHistory - iFirstYearOrg + FinYear(iColPosition) To LastYearHistory - iFirstYearOrg + 1 Step -1
                                TargetVector(i + diff, iColPosition) = TargetVector(i, iColPosition)
                                TargetVector(i, iColPosition) = System.DBNull.Value
                            Next i
                        Else
                            For i = LastYearHistory - iFirstYearOrg + FinYear(iColPosition) To LastYearHistory - iFirstYearOrg + 1 Step -1
                                TargetVector(i + diff) = TargetVector(i)
                                TargetVector(i) = System.DBNull.Value
                            Next i
                        End If
                    End If
                End If
            End If

            j = 1
            For i = 1 To iLastYear - iFirstYear + 1
                If seriesYears(j) < iFirstYear Then
                    Do While j < totalYearFields
                        j = j + 1
                        If seriesYears(j) >= iFirstYear Then Exit Do 'jrs 2008/04/29 added > table had years 51 and 61 so it was going to the end
                    Loop
                End If
                If j <= totalYearFields And i + iFirstYear - 1 = seriesYears(j) Then
                    NewVal = row.Item(j + 1)
                    If Not IsNumeric(NewVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                        NewVal = fillHistoryHoles(row, j + 1, Val(valtbl.Columns(j + 1).Caption), bfillHistoryOnlyHoles, bHistoricAnalog)
                        'jrs 2008/05/13
                        If IsNumeric(NewVal) Then
                            If sUnits = "Percent" And NewVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NewVal > MaxValEst Then
                                    NewVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NewVal < 0 Then
                                NewVal = 0
                            End If
                        End If
                    End If
                    If Not IsNumeric(NewVal) Then
                        NullFound = True
                        'jrs 2009/03/03
                        'Avoid overwritting forecast with Nulls
                        If Not (buseAllHistory And i + iFirstYear - 1 > iLastYearNotNull) Then
                            If bSingleDim Then 'single dimension array
                                TargetVector(i) = System.DBNull.Value
                            Else
                                TargetVector(i, iColPosition) = System.DBNull.Value
                            End If
                        End If
                    Else
                        'jrs 2008/05/09
                        'Apply Currency Convertion
                        NewVal = NewVal / CurrencyFct
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If

                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = NewVal * Factor
                        Else
                            TargetVector(i, iColPosition) = NewVal * Factor
                        End If
                    End If


                    j = j + 1
                    'Check if it's the last year with data
                    If j > UBound(seriesYears) Then 'jrs 2006/06/06 LandUrban%Built only has data for 1992
                        Exit For
                    End If
                Else
                    If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                        NoVal = fillHistoryHoles(row, -1, iFirstYear + i - 1, bfillHistoryOnlyHoles, bHistoricAnalog)
                        'jrs 2008/05/13
                        If IsNumeric(NoVal) Then
                            If sUnits = "Percent" And NoVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NoVal > MaxValEst Then
                                    NoVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NoVal < 0 Then
                                NoVal = 0
                            End If
                        End If
                    Else
                        NoVal = System.DBNull.Value
                    End If

                    'jrs 2008/05/09
                    'Apply Currency Convertion
                    If Not IsDBNull(NoVal) Then
                        NoVal = NoVal / CurrencyFct
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If
                    End If

                    'Store Value
                    If bSingleDim Then 'single dimension array
                        TargetVector(i) = NoVal
                    Else
                        TargetVector(i, iColPosition) = NoVal
                    End If
                End If
            Next i

        End If

        'jrs 2009/03/03
        If iLastYearNotNull > LastYearHistory - 1 And buseAllHistory Then
            iLastYear = iLastYearNotNull
            iLstYrUseAllHistory = iLastYear
        End If

        FinYear(iColPosition) = iLastYear - iFirstYear + 1
        valtbl = Nothing
        tblWeight = Nothing

        bLoadForDisplaySuccess = True

    End Sub

    'jrs 2010/09/07 translate to the web
    'jrs 2007/08/24 CENTRALIZE DISPLAYS
    'Loads a single column into an array
    'Difference with gLoadForDisplayHis is that this one can take Earliest and Most Recent,
    'originally designed for computations in ScatVars.
    Public Sub gLoadForDisplayHisYrFld(ByVal sVar As String, ByVal sDim1 As String,
    ByVal idxDim1 As Integer, ByVal sDim2 As String, ByVal idxDim2 As Integer,
    ByVal sDim3 As String, ByVal idxDim3 As Integer,
    ByVal bGroups As Object,
    ByVal Factor As Single, ByRef TargetVector As Object,
    ByVal iColPosition As Integer, ByVal sFirstYearFld As String,
    ByVal sLastYearFld As String, ByVal bSingleDim As Boolean, ByVal bHistoricAnalog As Boolean,
    ByVal bSaveLabels As Boolean, ByVal sTitle As String, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer,
    ByVal bFilterCtry As Boolean, ByRef FilterCtry As Object, ByRef bLoadForDisplaySuccess As Boolean,
    ByRef myForm As Page, ByRef IfsParameters As myParameters, ByRef FinYear As Object,
    ByVal bComputation As Boolean, ByRef IFsCtrys As Object, ByRef LastYear As Integer,
    ByRef LastYearForecast As Integer, ByVal bfillHistoryOnlyHoles As Boolean, ByRef SQLite As String)
        '1. sVar Variable Name
        '2. sDim1 Dimension1 Name
        '3. idxDim1 Dimension1 Index
        '4. sDim2 Dimension2 Name
        '5. idxDim2 Dimension2 Index
        '6. sDim3 Dimension3 Name
        '7. idxDim3 Dimension3 Index
        '8. bOpenFile is false when the file is already open and there's no need to open it again.
        '9. bCloseFile is false when there's no need to close the file used.
        '10. bGroups is true when using groups, if dbnull.value we have to find out if using groups or not
        '11. Factor multiplies every value read from sFileName
        '12. TargetVector array where read values are stored
        '13. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '14. sFirstYearFld, 2000 for forecast, 1960 for History, Earliest or MostRecent
        '15. sLastYearFld, 2000 to 2100 for forecast, 1960 to 2000 for history, Earliest or MostRecent
        '16. bSingleDim is True when using a Single Dimension vector as Target
        '17. bHistoricAnalog is True when using as part of History plus Forecast
        '18. bSaveLabels is True is we want to save the labels for display
        '19. sTitle is the optional title to use in graphics
        '20. bfillHistoryHoles if true indicates the use of estimation to fill in the holes in history
        '21. buseAllHIstory if true it will ignore iLastYear and will retrieve all available history (> lastyearhistory, not < firstyearhistory)
        '22. iLstYrUseAllHistory is the last year of history loaded
        'jrs 2008/09/01
        'These options are used from Cross-Sectional, where ctries in X and Y are not selected
        'simultaneously and need to be matched
        '23. bFilterCtry is true if we need to filter members of a group (not all members to be used)
        '24. FilterCtry is an array of all ctries, if element is true, the ctry is to be skipped/filtered
        '25. bfillHistoryOnlyHoles is true when not using extrapolation for fill holes

        Dim i As Integer, j As Integer, kk As Integer
        Dim TableName As String
        Dim db As String
        Dim valtbl As DataTable
        Dim tblAux As DataTable
        Dim sAgRule As String
        Dim sDefinition As String
        Dim sUnits As String
        Dim bRegions As Boolean
        Dim NewVal As Object
        Dim NoVal As Object
        'jrs 2008/09/01
        Dim bSkipCtry As Boolean
        Dim row As DataRow, rowAux As DataRow

        bLoadForDisplaySuccess = False

        Dim frm_msg As New frm_Message

        'Check Variable Name Parameter
        If sVar = "" Then
            frm_msg.LoadMessage("Invalid Variable Name Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        'Check Group Parameters
        If (bGroups Is Nothing) Then
            idxDim1 = gGetDimIdx(1, sDim1, False, myForm)
            bGroups = (idxDim1 < 1)
        End If

        'Check Dimension Parameters
        If sDim1 = "" Then
            frm_msg.LoadMessage("Invalid Dimension 1 Parameters")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If idxDim1 < 1 Then
            If bGroups Then
                idxDim1 = gGetGroupIdx(sDim1, True, myForm)
            Else
                idxDim1 = gGetDimIdx(1, sDim1, True, myForm)
            End If
        End If

        If idxDim1 = -1 Then
            Exit Sub
        End If

        'Check Target Parameters
        Dim iFirstYear As Integer, iLastYear As Integer
        If IsNumeric(sLastYearFld) Then
            iLastYear = CInt(sLastYearFld)
        Else
            iLastYear = 0
        End If
        If IsNumeric(sFirstYearFld) Then
            iFirstYear = CInt(sFirstYearFld)
        Else
            iFirstYear = 0
        End If

        If iLastYear - iFirstYear + 1 > UBound(TargetVector, 1) Then
            frm_msg.LoadMessage("Invalid Year Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If
        If Not bSingleDim Then 'doubly dimension array
            If iColPosition > UBound(TargetVector, 2) Then
                frm_msg.LoadMessage("Invalid Initial Column")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'Historic Analog
        If bHistoricAnalog Then
            Dim idxVar As String
            idxVar = IfsVars.Item(sVar).Index
            If UCase(VHistoricAnalog(idxVar)) = "FORMULA" Then
                Dim dbCHA As String, qry As String, rsCHA As DataTable
                dbCHA = IfsParameters.PutFdrvRun & "IFSVAR.MDB"
                'jrs 2008/05/21 added UseNullsAsZeros
                qry = "SELECT Formula, UseNullsAsZeros FROM IfsVarHISTANAFORMULAS WHERE NAME = '" & V(idxVar) & "'"
                If VDim2(idxVar) > 0 Then
                    qry = qry & " AND DIM2 = '" & Replace(sDim2, "'", "''") & "'"
                    If VDim3(idxVar) > 0 Then
                        qry = qry & " AND DIM3 = '" & sDim3 & "'"
                    End If
                End If
                Try
                    rsCHA = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULAS")
                Catch ex As ArgumentException
                    'jrs 2012/01/31 avoid duplicate keys
                    SyncLock IFsTables
                        If Not IFsTables.Contains("SELECT * FROM IfsVarHISTANAFORMULAS") Then
                            SetDataTablefromAccess(dbCHA, "SELECT * FROM IfsVarHISTANAFORMULAS", "", rsCHA)
                            IFsTables.Add(rsCHA, "SELECT * FROM IfsVarHISTANAFORMULAS")
                        Else
                            rsCHA = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULAS")
                        End If
                    End SyncLock
                End Try
                Dim tblRowsCHA() As DataRow
                tblRowsCHA = rsCHA.Select(qry)
                If tblRowsCHA.Length = 0 Then
                    frm_msg.LoadMessage("This dimension doesn't have a formula associated.")
                    Support.FormManager.StateStore(myForm)
                    Support.FormManager.Show(myForm, "frm_Message.aspx")
                End If
                'jrs 2008/05/22
                Dim bUseNullsAs0 As Boolean
                If Not IsDBNull(tblRowsCHA(0).Item("UseNullsAsZeros")) Then
                    bUseNullsAs0 = tblRowsCHA(0).Item("UseNullsAsZeros")
                End If
                gLoadCompHistAnal(iColPosition, tblRowsCHA(0).Item("Formula").value, idxVar,
                sDim1, idxDim1, sDim2, idxDim2, sDim3, idxDim3, bGroups, dbCHA, bfillHistoryHoles,
                buseAllHistory, iLstYrUseAllHistory, LastYear, LastYearForecast, myForm,
                bLoadForDisplaySuccess, FinYear, bComputation, TargetVector, IfsParameters,
                bUseNullsAs0, bfillHistoryOnlyHoles, False, Nothing, Nothing, SQLite)
                Exit Sub
            End If
            If VDim1(idxVar) = 1 And VDim2(idxVar) = 0 Then
                sVar = VHistoricAnalog(idxVar)
                TableName = "Series" + sVar
            ElseIf VHistoricAnalog(idxVar) = "IFSVARHISTANA" Then 'JRS 2006/06/05 DIM3
                sVar = IFsHistAnalogs.Item(V(idxVar), sDim2, sDim3).sHistAna
                If sVar = "" Then
                    MsgBox("This dimension doesn't have a Historic Analog option.")
                    Exit Sub
                End If
                TableName = "Series" + sVar
            Else
                TableName$ = "Series"
                Dim txt As String, tmptblname As String, k As String
                Dim tmpTblNo As Integer
                If idxDim2 < 1 Then
                    idxDim2 = gGetDimIdx(VDim2(idxVar), sDim2, True, myForm)
                End If
                txt = Trim(VHistoricAnalog(idxVar))
                tmpTblNo = 0
                tmptblname = ""
                For i = 1 To Len(txt)
                    k = Mid(txt, i, 1)
                    Select Case k
                        Case ","
                            tmpTblNo = tmpTblNo + 1
                            If tmpTblNo = idxDim2 Then Exit For
                            tmptblname = ""
                        Case Else
                            tmptblname = tmptblname + k
                    End Select
                Next
                sVar = tmptblname
                TableName = "Series" + tmptblname
            End If
        End If

        'Load Table Name
        '---------------
        Dim db2 As String
        Dim VarValSave As String
        db2 = IfsParameters.PutFdrvRun + "datadict.MDB"
        Try
            valtbl = IFsTables.Item("SELECT * FROM DataDict")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM DataDict") Then
                    SetDataTablefromAccess(db2, "SELECT * FROM DataDict", "", valtbl)
                    IFsTables.Add(valtbl, "SELECT * FROM DataDict")
                Else
                    valtbl = IFsTables.Item("SELECT * FROM DataDict")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = valtbl.Select("Variable = '" & sVar & "'")

        'Check Variable Name Parameter
        If tblRows.Length = 0 Then
            frm_msg.LoadMessage("Invalid Variable Name Parameter" & Chr(13) &
            "Variable " & sVar & " doesn't exist in DataDict.mdb")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        VarValSave = tblRows(0).Item("CoVaTrA")
        If TableName = "" Then
            TableName = tblRows(0).Item("Table")
        End If
        sAgRule = tblRows(0).Item("Aggregation")
        sDefinition = tblRows(0).Item("Definition")
        sUnits = tblRows(0).Item("Units")
        'jrs 2011/01/26
        Dim bTreatNullsAs0s As Boolean
        bTreatNullsAs0s = tblRows(0).Item("TreatNullsAs0s")

        'Open File if necessary
        Dim spwd As String
        If UCase$(Regionalization$) <> UCase$("RegionalizationCoVaTrA") Or VarValSave <> "Yes" Then
            db = IfsParameters.IFsHistSeries_MDB
            spwd = DataPW
        Else
            db = IfsParameters.IFsCoVaTrASeries_MDB
            spwd = ""
        End If

        'Load Group Members
        '------------------
        Dim gCountGroupMembers As Integer
        Dim gGroupMembrs() As String
        If bGroups Then
            gLoadGroupMembersHis(sDim1, GroupCodes(idxDim1), gCountGroupMembers, gGroupMembrs, IfsParameters.Ifs_MDB2Active)
        Else
            gLoadRegionMembersHis(sDim1, idxDim1, gCountGroupMembers, gGroupMembrs, IfsParameters.Ifs_MDB2Active)
            bRegions = (gCountGroupMembers > 1)
        End If

        'Load Target Vector
        '------------------
        Dim agcount As Integer
        Dim totalYearFields As Integer
        Dim seriesYears() As Single
        Dim Sumplot As Object, SumWeight As Object
        Dim NullFound As Boolean
        'jrs 2008/11/11
        Dim MaxValEst As Single

        If bGroups Or bRegions Then

            agcount = gCountGroupMembers
            'jrs 2006/07/24 Reload Table only if necessary
            Try
                valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
            Catch ex As ArgumentException
                'jrs 2012/01/31 avoid duplicate keys
                SyncLock IFsTables
                    If Not IFsTables.Contains("SELECT * FROM [" & TableName & "]") Then
                        SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
                        IFsTables.Add(valtbl, "SELECT * FROM [" & TableName & "]")
                    Else
                        valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
                    End If
                End SyncLock
            End Try
            'jrs 2006/09/28 gen. agg.
            Dim sTbl As String, sEmpVar As String
            sEmpVar = IFsAggRules.Item(sAgRule).HisEmpVar

            'jrs 2008/11/11
            If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                MaxValEst = findMaxValGrp(valtbl, gGroupMembrs, agcount)
                If MaxValEst < 100 Then
                    MaxValEst = 100
                End If
                'MaxValEst = 1.2 * MaxValEst
            End If

            Dim MaxAuxYr As Integer
            MaxAuxYr = 5000
            If sEmpVar > "" Then
                sTbl = "[Series" & sEmpVar & "]"
                Try
                    tblAux = IFsTables.Item("SELECT * FROM " & sTbl)
                Catch ex As ArgumentException
                    'jrs 2012/01/31 avoid duplicate keys
                    SyncLock IFsTables
                        If Not IFsTables.Contains("SELECT * FROM " & sTbl) Then
                            SetDataTablefromAccess(db, "SELECT * FROM " & sTbl, "Country", tblAux, spwd)
                            IFsTables.Add(tblAux, "SELECT * FROM " & sTbl)
                        Else
                            tblAux = IFsTables.Item("SELECT * FROM " & sTbl)
                        End If
                    End SyncLock
                End Try
                MaxAuxYr = Val(tblAux.Columns(tblAux.Columns.Count - 3).Caption) 'jrs 2006/10/08, HDI, World, using AAH
            End If

            totalYearFields = valtbl.Columns.Count - 2
            ReDim seriesYears(totalYearFields)
            For i = 1 To totalYearFields
                seriesYears(i) = Val(valtbl.Columns(i + 1).Caption)
            Next i
            j = 1

            Dim Auxfld As String, Auxval As Object
            Dim VarVal As Object, SumNum As Single

            'jrs 2006/09/22
            If buseAllHistory Then
                For i = totalYearFields To 1 Step -1
                    If seriesYears(i) > 0 And seriesYears(i) <= MaxAuxYr Then 'jrs 2006/10/08
                        iLastYear = seriesYears(i)
                        iLstYrUseAllHistory = iLastYear
                        Exit For
                    End If
                Next i
            End If

            For i = 1 To iLastYear - iFirstYear + 1
                NullFound = False
                'Code to start reading data from first year
                Do While i + iFirstYear - 1 > seriesYears(j) And j < totalYearFields
                    j = j + 1
                Loop
                If j <= totalYearFields And (i + iFirstYear - 1 = seriesYears(j) Or
                UCase(sFirstYearFld) = "EARLIEST" Or UCase(sLastYearFld) = "MOSTRECENT") Then
                    'data for this year is in Table
                    Select Case sAgRule
                        Case "SUM"
                            'jrs 2007/07/20 Sumplot = 0
                            Sumplot = DBNull.Value
                            VarVal = 0
                            For kk = 1 To agcount
                                row = SeekRow(valtbl, gGroupMembrs(kk))

                                'jrs 2008/09/01
                                bSkipCtry = False
                                If bFilterCtry Then
                                    'bSkipCtry = FilterCtry(IFsCtrys.Item(gGroupMembrs(kk)).Index)
                                End If

                                If bSkipCtry Then
                                    VarVal = DBNull.Value
                                Else
                                    If IsNumeric(sFirstYearFld) Then
                                        VarVal = row.Item(j + 1)
                                    Else
                                        VarVal = row.Item(sFirstYearFld)
                                    End If
                                End If

                                If IsDBNull(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                    VarVal = fillHistoryHoles(row, j + 1, Val(row.Item(j + 1).Name), bfillHistoryOnlyHoles, bHistoricAnalog)
                                    'jrs 2008/05/13
                                    If Not IsDBNull(VarVal) Then
                                        If sUnits = "Percent" And VarVal > 100 Then
                                            'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                            If VarVal > MaxValEst Then
                                                VarVal = MaxValEst
                                            End If
                                        ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                            VarVal = 0
                                        End If
                                    End If
                                End If
                                'jrs 2011/01/26
                                If IsDBNull(VarVal) And bTreatNullsAs0s And Not bSkipCtry Then
                                    VarVal = 0
                                End If

                                '1st and second field = Country and Fips
                                If Not (IsDBNull(VarVal)) Then
                                    'jrs 2007/07/20
                                    If IsDBNull(Sumplot) Then
                                        Sumplot = VarVal
                                    Else
                                        Sumplot = Sumplot + VarVal
                                    End If
                                Else
                                    'There are Nulls in the set
                                    VarVal = 0
                                    NullFound = True
                                End If
                            Next kk
                            VarVal = Sumplot

                        Case "AVG"
                            Sumplot = 0
                            SumNum = 0
                            For kk = 1 To agcount
                                row = SeekRow(valtbl, gGroupMembrs(kk))
                                'jrs 2008/09/01
                                bSkipCtry = False
                                If bFilterCtry Then
                                    'bSkipCtry = FilterCtry(frm_ScatVarS.IFsCtrys.Item(gGroupMembrs(kk)).Index)
                                End If

                                If bSkipCtry Then
                                    VarVal = DBNull.Value
                                Else
                                    If IsNumeric(sFirstYearFld) Then
                                        VarVal = row.Item(j + 1)
                                    Else
                                        VarVal = row.Item(sFirstYearFld)
                                    End If
                                End If

                                If IsDBNull(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                    VarVal = fillHistoryHoles(row, j + 1, Val(row.Item(j + 1).Name), bfillHistoryOnlyHoles, False)
                                    'jrs 2008/05/13
                                    If Not IsDBNull(VarVal) Then
                                        If sUnits = "Percent" And VarVal > 100 Then
                                            'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                            If VarVal > MaxValEst Then
                                                VarVal = MaxValEst
                                            End If
                                        ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                            VarVal = 0
                                        End If
                                    End If
                                End If

                                'jrs 2011/01/26
                                If IsDBNull(VarVal) And bTreatNullsAs0s And Not bSkipCtry Then
                                    VarVal = 0
                                End If

                                '1st and second field = Country and Fips
                                If Not (IsDBNull(VarVal)) Then
                                    Sumplot = Sumplot + VarVal
                                    SumNum = SumNum + 1
                                Else
                                    VarVal = 0
                                    NullFound = True
                                End If
                            Next kk
                            If SumNum <> 0 Then
                                VarVal = Sumplot / SumNum
                            Else
                                'jrs 2007/07/20 VarVal = 0 ' 0 in denom
                                VarVal = DBNull.Value
                            End If

                            'jrs 2006/09/28
                        Case Else
                            If sEmpVar > "" Then
                                'jrs 2007/07/20 Sumplot = 0
                                Sumplot = DBNull.Value
                                SumWeight = 0
                                For kk = 1 To agcount
                                    row = SeekRow(valtbl, gGroupMembrs(kk))
                                    rowAux = SeekRow(tblAux, gGroupMembrs(kk))
                                    'jrs 2008/09/01
                                    bSkipCtry = False
                                    If bFilterCtry Then
                                        'bSkipCtry = FilterCtry(frm_ScatVarS.IFsCtrys.Item(gGroupMembrs(kk)).Index)
                                    End If

                                    If bSkipCtry Then
                                        VarVal = DBNull.Value
                                    Else
                                        If IsNumeric(sFirstYearFld) Then
                                            VarVal = row.Item(j + 1)
                                        Else
                                            VarVal = row.Item(sFirstYearFld)
                                        End If
                                    End If

                                    If IsDBNull(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                        VarVal = fillHistoryHoles(row, j + 1, Val(row.Item(j + 1).Name), bfillHistoryOnlyHoles, False)
                                        'jrs 2008/05/13
                                        If Not IsDBNull(VarVal) Then
                                            If sUnits = "Percent" And VarVal > 100 Then
                                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                                If VarVal > MaxValEst Then
                                                    VarVal = MaxValEst
                                                End If
                                            ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                                VarVal = 0
                                            End If
                                        End If
                                    End If

                                    'jrs 2011/01/26
                                    If IsDBNull(VarVal) And bTreatNullsAs0s And Not bSkipCtry Then
                                        VarVal = 0
                                    End If

                                    '1st and second field = Country and Fips
                                    If sAgRule = "LND" Then
                                        Auxfld$ = "MostRecent"
                                    Else
                                        If IsNumeric(sFirstYearFld) Then
                                            Auxfld$ = Trim(Str(seriesYears(j)))
                                        Else
                                            Auxfld$ = sFirstYearFld
                                        End If
                                    End If
                                    Auxval = rowAux.Item(Auxfld$)  'Aux of that particular year
                                    If IsDBNull(Auxval) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                        Auxval = fillHistoryHoles(rowAux, -1, seriesYears(j), bfillHistoryOnlyHoles, False)
                                        'jrs 2008/05/13
                                        If Not IsDBNull(Auxval) Then
                                            If sUnits = "Percent" And Auxval > 100 Then
                                                Auxval = 100
                                            ElseIf sVar <> "PopulationGrowthRate" And Auxval < 0 Then
                                                Auxval = 0
                                            End If
                                        End If
                                    End If
                                    If Not (IsDBNull(VarVal)) And Not (IsDBNull(Auxval)) Then
                                        'jrs 2007/07/20
                                        If IsDBNull(Sumplot) Then
                                            Sumplot = VarVal * Auxval
                                        Else
                                            Sumplot = Sumplot + VarVal * Auxval
                                        End If
                                        SumWeight = SumWeight + Auxval
                                    Else
                                        NullFound = True
                                        VarVal = 0
                                        Auxval = 0
                                    End If
                                Next kk
                                If SumWeight <> 0 Then
                                    VarVal = Sumplot / SumWeight
                                ElseIf IsDBNull(Sumplot) Then 'jrs 2007/07/20 in case all values are dbnull.value
                                    VarVal = DBNull.Value
                                Else
                                    VarVal = 0  'Zero In Denominator
                                End If

                            End If

                    End Select

                    'Store Value
                    If bSingleDim Then 'single dimension array
                        TargetVector(i) = VarVal * Factor
                    Else
                        TargetVector(i, iColPosition) = VarVal * Factor
                    End If


                    j = j + 1
                    'Check if it's the last year with data
                    If j > UBound(seriesYears) Then 'jrs 2006/06/06 LandUrban%Built only has data for 1992
                        Exit For
                    End If

                Else 'year went out of range in table, and everything else is dbnull.value
                    If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                        'NoVal = fillHistoryHolesforGroups(valtbl, -1, iFirstYear + i - 1, sAgRule, tblAux, sUnits, MaxValEst)
                        'jrs 2008/05/13
                        If Not IsDBNull(NoVal) Then
                            If sUnits = "Percent" And NoVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NoVal > MaxValEst Then
                                    NoVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NoVal < 0 Then
                                NoVal = 0
                            End If
                        End If
                    Else
                        NoVal = DBNull.Value
                    End If
                    'Store Value
                    If bSingleDim Then 'single dimension array
                        TargetVector(i) = NoVal
                    Else
                        TargetVector(i, iColPosition) = NoVal
                    End If
                End If

            Next i
        Else  ' 1 country in the region, aggregation not needed
            NullFound = False
            'jrs 2006/07/24 Reload Table only if necessary
            Try
                valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
            Catch ex As ArgumentException
                'jrs 2012/01/31 avoid duplicate keys
                SyncLock IFsTables
                    If Not IFsTables.Contains("SELECT * FROM [" & TableName & "]") Then
                        SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
                        IFsTables.Add(valtbl, "SELECT * FROM [" & TableName & "]")
                    Else
                        valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
                    End If
                End SyncLock
            End Try
            'SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
            row = SeekRow(valtbl, gGroupMembrs(1))

            'jrs 2008/11/11
            If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                MaxValEst = findMaxValCtry(valtbl, gGroupMembrs(1))
                If MaxValEst < 100 Then
                    MaxValEst = 100
                End If
                'MaxValEst = 1.2 * MaxValEst
            End If

            totalYearFields = valtbl.Columns.Count - 2
            ReDim seriesYears(totalYearFields)
            For i = 1 To totalYearFields
                'jrs 2017/07/25 seriesYears(i) = Val(row.Item(i + 1).Name)
                seriesYears(i) = Val(valtbl.Columns(i + 1).Caption)
            Next i
            'jrs 2006/09/22
            If buseAllHistory Then
                For i = totalYearFields To 1 Step -1
                    If seriesYears(i) > 0 Then
                        iLastYear = seriesYears(i)
                        iLstYrUseAllHistory = iLastYear
                        Exit For
                    End If
                Next i
            End If

            j = 1
            For i = 1 To iLastYear - iFirstYear + 1
                If seriesYears(j) < iFirstYear Then
                    Do While j < totalYearFields
                        j = j + 1
                        If seriesYears(j) = iFirstYear Then Exit Do
                    Loop
                End If
                If j <= totalYearFields And (i + iFirstYear - 1 = seriesYears(j) Or
                UCase(sFirstYearFld) = "EARLIEST" Or UCase(sLastYearFld) = "MOSTRECENT") Then
                    If IsNumeric(sFirstYearFld) Then
                        NewVal = row.Item(j + 1)
                    Else
                        NewVal = row.Item(sFirstYearFld)
                    End If

                    If IsDBNull(NewVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                        NewVal = fillHistoryHoles(row, j + 1, Val(row.Item(j + 1).Name), bfillHistoryOnlyHoles, False)
                        'jrs 2008/05/13
                        If Not IsDBNull(NewVal) Then
                            If sUnits = "Percent" And NewVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NewVal > MaxValEst Then
                                    NewVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NewVal < 0 Then
                                NewVal = 0
                            End If
                        End If
                    End If
                    If IsDBNull(NewVal) Then
                        NullFound = True
                        'jrs 2017/07/25
                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = DBNull.Value
                        Else
                            TargetVector(i, iColPosition) = DBNull.Value
                        End If
                    Else
                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = NewVal * Factor
                        Else
                            TargetVector(i, iColPosition) = NewVal * Factor
                        End If
                    End If

                    j = j + 1
                    'Check if it's the last year with data
                    If j > UBound(seriesYears) Then 'jrs 2006/06/06 LandUrban%Built only has data for 1992
                        Exit For
                    End If
                Else
                    If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                        NoVal = fillHistoryHoles(row, -1, iFirstYear + i - 1, bfillHistoryOnlyHoles, bHistoricAnalog)
                        'jrs 2008/05/13
                        If Not IsDBNull(NoVal) Then
                            If sUnits = "Percent" And NoVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NoVal > MaxValEst Then
                                    NoVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NoVal < 0 Then
                                NoVal = 0
                            End If
                        End If
                    Else
                        NoVal = DBNull.Value
                    End If
                    'Store Value
                    If bSingleDim Then 'single dimension array
                        TargetVector(i) = NoVal
                    Else
                        TargetVector(i, iColPosition) = NoVal
                    End If
                End If
            Next i

        End If

        'FinYear(iColPosition) = iLastYear - iFirstYear + 1
        valtbl = Nothing

        'If bSaveLabels Then
        '    If sTitle > "" Then
        '        VARN$(0, iColPosition) = sTitle
        '    Else
        '        VARN$(0, iColPosition) = sVar
        '    End If
        '    VARN$(1, iColPosition) = sVar
        '    VARN$(2, iColPosition) = sDefinition

        '    If bGroups Then
        '        VARN$(5, iColPosition) = "GROUP"
        '    Else
        '        VARN$(5, iColPosition) = "REGION"
        '    End If


        '    FileNumbr$(iColPosition) = "-1"
        '    VARN$(0, iColPosition) = VARN$(0, iColPosition) & "[-1]"
        '    VARN$(1, iColPosition) = VARN$(1, iColPosition) & "[-1]"

        '    GR1N$(iColPosition) = sDim1
        '    GR2N$(iColPosition) = ""
        '    GR3N$(iColPosition) = ""
        '    GR4N$(iColPosition) = sUnits

        '    'Flexible Dimension Names for Graphs
        '    FDNG1(iColPosition) = GR1N$(iColPosition)
        '    FDNG2(iColPosition) = GR2N$(iColPosition)
        '    FDNG3(iColPosition) = GR3N$(iColPosition)
        '    FDNG4(iColPosition) = GR4N$(iColPosition)
        'End If

        bLoadForDisplaySuccess = True


    End Sub

    'jrs 2025/01/13
    Public Sub gLoadForDisplayHisBilateral(ByVal sVar As String, ByVal sDim1 As String,
    ByVal idxDim1 As Integer, ByVal sDim2 As String, ByVal idxDim2 As Integer,
    ByVal sDim3 As String, ByVal idxDim3 As Integer, ByRef bGroups As Object, ByRef bGroups2 As Object,
    ByVal Factor As Single, ByRef TargetVector As Object, ByVal iColPosition As Integer,
    ByVal iFirstYear As Integer, ByVal iLastYear As Integer,
    ByVal bSingleDim As Boolean, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page,
    ByRef FinYear As Object, ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef bComputation As Boolean, ByRef sDefinition As String, ByRef sUnits As String,
    ByRef IfsParameters As myParameters, ByVal bfillHistoryOnlyHoles As Boolean,
    ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef StaYearHis As Object, ByRef SQLite As String)
        '1. sVar Variable Name
        '2. sDim1 Dimension1 Name
        '3. idxDim1 Dimension1 Index
        '4. sDim2 Dimension2 Name
        '5. idxDim2 Dimension2 Index
        '6. sDim3 Dimension3 Name
        '7. idxDim3 Dimension3 Index
        '8. bGroups is true when using groups, if Null we have to find out if using groups or not
        '9. bGroups2 is true when using groups in Dim2, if Null we have to find out if using groups or not
        '10. Factor multiplies every value read from sFileName
        '11. TargetVector array where read values are stored
        '12. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '13. iFirstYear, 2000 for forecast, 1960 for History
        '14. iLastYear, 2000 to 2100 for forecast, 1960 to 2000 for history
        '15. bSingleDim is True when using a Single Dimension vector as Target
        '16. bfillHistoryHoles if true indicates the use of estimation to fill in the holes in history
        '17. buseAllHIstory if true it will ignore iLastYear and will retrieve all available history (> lastyearhistory, not < firstyearhistory)
        '18. iLstYrUseAllHistory is the last year of history loaded
        '19. bLoadForDisplaySuccess is a flag that indicates sucess when loading data
        '20. myForm is the web page that is calling this subroutine
        '21. FinYear is a global array that contains the number of points ploted
        '22. LastYear is a global variable
        '23. LastYearForecast is a global variable
        '24. bComputation is a global variable that indicates if we're doing a computation
        '25. sDefinition is a variable to return definition value
        '26. sUnits is a variable to return units value
        '27. IfsParameters is an object that contains the following parameters:
        'i. currencyVal 
        'ii. vShortSce (not used)
        'iii. RunFiles (not used)
        'iv. Ifs_MDB2Active is a global variable with the database with group information
        'v. IFsCoVaTrASeries_MDB is the path to the covatra historical series file
        'vi. IFsHistSeries_MDB is the path to ifshistseries.mdb
        'vii. PutFdrvRun is a global variable that contains the path to ifsvar.mdb
        'jrs 2011/03/28
        '28. bfillHistoryOnlyHoles is true when only filling holes and not extrapolation


        Dim i As Integer, j As Integer, kk As Integer
        Dim TableName As String
        Dim valtbl As DataTable
        Dim tblWeight As DataTable
        Dim sAgRule As String
        Dim bRegions, bRegions2 As Boolean
        Dim NewVal As Object
        Dim NoVal As Object
        Dim row As DataRow, rowWeight As DataRow
        'jrs 2014/03/27
        Dim diff As Integer

        bLoadForDisplaySuccess = False

        Dim frm_msg As New frm_Message

        'Check Variable Name Parameter
        If sVar = "" Then
            frm_msg.LoadMessage("Invalid Variable Name Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        'Check Group Parameters
        If (bGroups Is Nothing) Then
            idxDim1 = gGetDimIdx(1, sDim1, False, myForm)
            bGroups = (idxDim1 < 1)
        End If

        'Check Group2 Parameters
        If (bGroups2 Is Nothing) Then
            idxDim2 = gGetDimIdx(1, sDim2, False, myForm)
            bGroups2 = (idxDim2 < 1)
        End If

        'Check Dimension Parameters
        If sDim1 = "" Then
            frm_msg.LoadMessage("Invalid Dimension 1 Parameters")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        If idxDim1 < 1 Then
            If bGroups Then
                idxDim1 = gGetGroupIdx(sDim1, True, myForm)
            Else
                idxDim1 = gGetDimIdx(1, sDim1, True, myForm)
            End If
        End If

        If idxDim1 = -1 Then
            Exit Sub
        End If

        If idxDim2 < 1 Then
            If bGroups2 Then
                idxDim2 = gGetGroupIdx(sDim2, True, myForm)
            Else
                idxDim2 = gGetDimIdx(1, sDim2, True, myForm)
            End If
        End If

        If idxDim2 = -1 Then
            Exit Sub
        End If

        'Check Target Parameters
        If iLastYear - iFirstYear + 1 > UBound(TargetVector, 1) Then
            frm_msg.LoadMessage("Invalid Year Parameter")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If
        If Not bSingleDim Then 'doubly dimension array
            If iColPosition > UBound(TargetVector, 2) Then
                frm_msg.LoadMessage("Invalid Initial Column")
                Support.FormManager.StateStore(myForm)
                Support.FormManager.Show(myForm, "frm_Message.aspx")
            End If
        End If

        'jrs 2009/01/21 Total
        Dim bTotal2 As Boolean, bTotal3 As Boolean
        bTotal2 = False
        bTotal3 = False
        'for weighted totals
        Dim bTotal2W As Boolean, bTotal3W As Boolean
        bTotal2W = False
        bTotal3W = False
        'jrs 2009/01/23 moved up
        Dim bUseNullsAs0 As Boolean
        'jrs 2011/03/28
        Dim SuggestedMaxEst As Single
        SuggestedMaxEst = 100
        'jrs 2014/03/27
        If iFirstYear < FirstYearHistory Then
            StaYearHis(iColPosition) = iFirstYear
        End If

        'jrs 2008/12/16
        Dim sHistAna As String

        'It's always for Historic Analog
        Dim idxVar As String
        idxVar = IfsVars.Item(sVar).Index
        If idxVar > 0 Then
            SuggestedMaxEst = VMax(idxVar)
        End If

        'No Formulas implemented

        If IsDBNull(VHistoricAnalog(idxVar)) Then
            sHistAna = "ALLNULLS"
        ElseIf Trim(VHistoricAnalog(idxVar)) = "" Then
            sHistAna = "ALLNULLS"
        ElseIf UCase(VHistoricAnalog(idxVar)) = "FORMULA" Then 'jrs 2008/12/17
            sHistAna = "ALLNULLS"
        Else
            sHistAna = VHistoricAnalog(idxVar)
        End If

        'jrs 2025/01/17
        'if file is not loaded, then all nulls
        If Dir(IfsParameters.PutFdrvRun + "IFsHistSeriesDyadic.db") = "" Then
            sHistAna = "ALLNULLS"
        End If

        'jrs 2025/03/10
        If sDim1 = sDim2 And bGroups = False Then
            sHistAna = "ALLNULLS"
        End If

        'Load Nulls
        '----------
        If sHistAna = "ALLNULLS" Then
            For i = 1 To iLastYear - iFirstYear + 1
                'Store Value
                If bSingleDim Then 'single dimension array
                    TargetVector(i) = DBNull.Value
                Else
                    TargetVector(i, iColPosition) = DBNull.Value
                End If
            Next i
            bLoadForDisplaySuccess = True
            FinYear(iColPosition) = iLastYear - iFirstYear + 1
            Exit Sub
        End If

        'Load Table Name
        '---------------
        Dim db2 As String
        Dim VarValSave As String
        'jrs 2025/02/11 db2 = IfsParameters.PutFdrvRun + "datadictDyadic.MDB"
        db2 = DataFileDir + "DataDictDyadic.MDB"
        'jrs 2006/07/24 Reload Table only if necessary
        Try
            valtbl = IFsTables.Item("SELECT * FROM DataDictDyadic")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM DataDictDyadic") Then
                    SetDataTablefromAccess(db2, "SELECT * FROM DataDict", "", valtbl)
                    IFsTables.Add(valtbl, "SELECT * FROM DataDictDyadic")
                Else
                    valtbl = IFsTables.Item("SELECT * FROM DataDictDyadic")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = valtbl.Select("Variable = '" & sHistAna & "'")
        'SetDataTablefromAccess(db2, "SELECT * FROM DataDict WHERE Variable = '" & sVar & "'", "", valtbl)
        'Check Variable Name Parameter
        If tblRows.Length = 0 Then
            frm_msg.LoadMessage("Invalid Variable Name Parameter" & "<br>" &
            "Variable " & sHistAna & " doesn't exist in DataDictDyadic.db")
            Support.FormManager.StateStore(myForm)
            Support.FormManager.Show(myForm, "frm_Message.aspx")
        End If

        VarValSave = tblRows(0).Item("CoVaTrA")
        If TableName = "" Then
            TableName = tblRows(0).Item("Table")
        End If
        sAgRule = tblRows(0).Item("Aggregation")
        sDefinition = tblRows(0).Item("Definition")
        sUnits = tblRows(0).Item("Units")

        'Exports USD to Billion
        If sUnits.Substring(0, 3) = "USD" Then
            Factor = 1 / 1000000000.0
            'Migrants headcounts to Million
        ElseIf sUnits = "Headcounts" Then
            Factor = 1 / 1000000.0
        End If

        'jrs 2011/01/26
        Dim bTreatNullsAs0s As Boolean
        bTreatNullsAs0s = tblRows(0).Item("TreatNullsAs0s")
        'jrs 2008/05/09
        Dim bCurrency As Boolean
        'jrs 2023/09/27 bCurrency = IIf(IsDBNull(tblRows(0).Item("Currency")), False, tblRows(0).Item("Currency"))
        If IsDBNull(tblRows(0).Item("Currency")) Then
            bCurrency = False
        Else
            If tblRows(0).Item("Currency") = "" Then
                bCurrency = False
            Else
                bCurrency = tblRows(0).Item("Currency")
            End If
        End If

        'jrs 2008/05/09
        If bCurrency And Trim(IfsParameters.currencySym) > "" Then
            sUnits = Replace(sUnits, "$", IfsParameters.currencySym)
        End If

        'Open File 
        Dim db As String, spwd As String

        db = IfsParameters.IFsHistSeries_MDB.Replace(".db", "Dyadic.db")
        spwd = DataPW$


        'Load Group Members
        '------------------
        Dim gCountGroupMembers, gCountGroupMembers2 As Integer
        Dim gGroupMembrs(), gGroupMembrs2() As String
        If bGroups Then
            gLoadGroupMembersHis(sDim1, GroupCodes(idxDim1), gCountGroupMembers, gGroupMembrs, IfsParameters.Ifs_MDB2Active)
        Else
            gLoadRegionMembersHis(sDim1, idxDim1, gCountGroupMembers, gGroupMembrs, IFs_MDB)
            bRegions = (gCountGroupMembers > 1)
        End If

        If bGroups2 Then
            gLoadGroupMembersHis(sDim2, GroupCodes(idxDim2), gCountGroupMembers2, gGroupMembrs2, IfsParameters.Ifs_MDB2Active)
        Else
            gLoadRegionMembersHis(sDim2, idxDim2, gCountGroupMembers2, gGroupMembrs2, IFs_MDB)
            bRegions2 = (gCountGroupMembers2 > 1)
        End If

        'jrs 2008/05/09
        'Get Currency Factor
        Dim CurrencyFct As Single
        If bCurrency And IfsParameters.currencyVal <> 0 Then
            CurrencyFct = IfsParameters.currencyVal
        Else
            CurrencyFct = 1
        End If

        'Load Target Vector
        '------------------
        Dim agcount, agcount2 As Integer
        Dim totalYearFields As Integer
        Dim seriesYears() As Single
        Dim Sumplot As Object, SumWeight As Object
        Dim NullFound As Boolean
        'jrs 2008/11/11
        Dim MaxValEst As Single
        'jrs 2009/03/03 when using all available history
        'sometimes last years are null, then better show forecast
        Dim iLastYearNotNull As Integer
        iLastYearNotNull = LastYearHistory - 1
        'jrs 2015/08/28 moved up to use in both branches, groups or countries
        Dim iFirstYearOrg As Integer

        If bGroups Or bRegions Or bGroups2 Or bRegions2 Then

            agcount = gCountGroupMembers
            agcount2 = gCountGroupMembers2

            'jrs 2006/07/24 Reload Table only if necessary
            Try
                valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
            Catch ex As ArgumentException
                'jrs 2012/01/31 avoid duplicate keys
                SyncLock IFsTables
                    If Not IFsTables.Contains("SELECT * FROM [" & TableName & "]") Then
                        SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "", valtbl, spwd)
                        IFsTables.Add(valtbl, "SELECT * FROM [" & TableName & "]")
                    Else
                        valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "]")
                    End If
                End SyncLock
            End Try
            'SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
            'jrs 2006/09/28 gen. agg.
            Dim sTbl As String, sEmpVar As String
            'jrs 2023/09/08
            If sAgRule <> "SUM" And sAgRule <> "AVG" Then
                sEmpVar = IFsAggRules.Item(sAgRule).HisEmpVar
            End If

            'jrs 2008/11/11
            If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                MaxValEst = findMaxValGrp(valtbl, gGroupMembrs, agcount)
                If MaxValEst < 100 Then
                    MaxValEst = 100
                End If
                'MaxValEst = 1.2 * MaxValEst
            End If

            Dim MaxAuxYr As Integer
            MaxAuxYr = 5000
            Dim AuxUnits As String, AuxMaxValEst As Single
            If sEmpVar > "" Then
                'jrs 2011/03/28
                Dim valtbl2 As DataTable
                valtbl2 = IFsTables.Item("SELECT * FROM DataDict")
                tblRows = valtbl2.Select("Variable = '" & sEmpVar & "'")
                AuxUnits = tblRows(0).Item("Units")

                sTbl = "[Series" & sEmpVar & "]"
                Try
                    tblWeight = IFsTables.Item("SELECT * FROM " & sTbl)
                Catch ex As ArgumentException
                    'jrs 2012/01/31 avoid duplicate keys
                    SyncLock IFsTables
                        If Not IFsTables.Contains("SELECT * FROM " & sTbl) Then
                            SetDataTablefromAccess(db, "SELECT * FROM " & sTbl, "Country", tblWeight, spwd)
                            IFsTables.Add(tblWeight, "SELECT * FROM " & sTbl)
                        Else
                            tblWeight = IFsTables.Item("SELECT * FROM " & sTbl)
                        End If
                    End SyncLock
                End Try
                MaxAuxYr = Val(tblWeight.Columns(tblWeight.Columns.Count - 3).Caption) 'jrs 2006/10/08, HDI, World, using AAH

                'jrs 2011/03/28
                Dim AuxForIdx As Integer
                AuxMaxValEst = 100
                AuxForIdx = IfsVars.Item(IFsAggRules.Item(sAgRule).ForecastVar).Index
                If AuxForIdx > 0 Then
                    AuxMaxValEst = VMax(AuxForIdx)
                End If
            End If

            'Select Case sAgRule
            '    Case "GDP"
            '        SetDataTablefromAccess(db, "SELECT * FROM [SeriesGDP95]", "Country", tblWeight, spwd)
            '    Case "POP"
            '        SetDataTablefromAccess(db, "SELECT * FROM [SeriesPopulation]", "Country", tblWeight, spwd)
            '    Case "LND"
            '        SetDataTablefromAccess(db, "SELECT * FROM [SeriesLandTotal]", "Country", tblWeight, spwd)
            'End Select

            totalYearFields = valtbl.Columns.Count - 4
            ReDim seriesYears(totalYearFields)
            For i = 1 To totalYearFields
                seriesYears(i) = Val(valtbl.Columns(i + 3).Caption)
            Next i
            'jrs 2015/08/31 j = 1

            Dim Auxfld As String, Auxval As Object
            Dim VarVal As Object, SumNum As Object

            'jrs 2006/09/22
            If buseAllHistory Then
                For i = totalYearFields To 1 Step -1
                    If seriesYears(i) > 0 And seriesYears(i) <= MaxAuxYr Then 'jrs 2006/10/08
                        'jrs 2010/08/27
                        If seriesYears(i) > LastYearHistory - 1 Then
                            iLastYear = seriesYears(i)
                        End If
                        iLstYrUseAllHistory = iLastYear
                        Exit For
                    End If
                Next i
                'jrs 2014/03/26
                If seriesYears(1) < iFirstYear Then
                    iFirstYearOrg = iFirstYear
                    iFirstYear = seriesYears(1)
                    'jrs 2014/04/15 iFstYrUseAllHisotry = iFirstYear
                    If Not bSingleDim Then
                        StaYearHis(iColPosition) = iFirstYear
                    Else
                        If StaYearHis(iColPosition) > iFirstYear Or StaYearHis(iColPosition) = 0 Then
                            StaYearHis(iColPosition) = iFirstYear
                        Else
                            iFirstYear = StaYearHis(iColPosition)
                        End If
                    End If
                    'Need to move previous columns
                    If Not bSingleDim And iColPosition > 1 Then  'doubly dimension array
                        For j = 1 To iColPosition - 1
                            If iFirstYear < StaYearHis(j) Or StaYearHis(j) < 1 Then
                                If StaYearHis(j) < 1 Then
                                    'jrs 2015/08/28 diff = FirstYearHistory - iFirstYear
                                    diff = iFirstYearOrg - iFirstYear
                                Else
                                    diff = StaYearHis(j) - iFirstYear
                                End If
                                For i = FinYear(j) To 1 Step -1
                                    TargetVector(i + diff, j) = TargetVector(i, j)
                                Next i
                                For i = 1 To diff
                                    TargetVector(i, j) = DBNull.Value
                                Next i
                                FinYear(j) = FinYear(j) + diff
                                StaYearHis(j) = iFirstYear
                            End If
                        Next j
                    End If
                    'jrs 2015/08/28 If bHistoricAnalog And iFirstYear < FirstYearHistory Then
                    'Need to move current column for forecast part on history+forecast
                    If iFirstYear < iFirstYearOrg Then
                        diff = FirstYearHistory - iFirstYear
                        If Not bSingleDim Then
                            For i = LastYearHistory - FirstYearHistory + FinYear(iColPosition) To LastYearHistory - FirstYearHistory + 1 Step -1
                                TargetVector(i + diff, iColPosition) = TargetVector(i, iColPosition)
                                TargetVector(i, iColPosition) = DBNull.Value
                            Next i
                        Else
                            For i = LastYearHistory - FirstYearHistory + FinYear(iColPosition) To LastYearHistory - FirstYearHistory + 1 Step -1
                                TargetVector(i + diff) = TargetVector(i)
                                TargetVector(i) = DBNull.Value
                            Next i
                        End If
                    End If
                End If

            End If

            'jrs 2015/08/28 moved from above, there's a loop using j
            j = 1

            For i = 1 To iLastYear - iFirstYear + 1
                NullFound = False
                'Code to start reading data from first year
                Do While i + iFirstYear - 1 > seriesYears(j) And j < totalYearFields
                    j = j + 1
                Loop
                If j <= totalYearFields And i + iFirstYear - 1 = seriesYears(j) Then
                    'data for this year is in Table
                    Select Case sAgRule
                        Case "SUM"
                            'jrs 2007/07/30 Sumplot = 0
                            Sumplot = System.DBNull.Value
                            VarVal = 0
                            For kk = 1 To agcount
                                For jj = 1 To agcount2
                                    'row = SeekRow(valtbl, gGroupMembrs(kk))
                                    If valtbl.Select("Actor = '" & gGroupMembrs(kk).Replace("'", "''") & "' AND Partner = '" & gGroupMembrs2(jj).Replace("'", "''") & "'").Count > 0 Then
                                        row = valtbl.Select("Actor = '" & gGroupMembrs(kk).Replace("'", "''") & "' AND Partner = '" & gGroupMembrs2(jj).Replace("'", "''") & "'")(0)
                                        VarVal = row.Item(j + 3)
                                        If Not IsNumeric(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                            VarVal = fillHistoryHoles(row, j + 3, Val(valtbl.Columns(j + 3).Caption), bfillHistoryOnlyHoles, True)
                                            'jrs 2008/05/13
                                            If IsNumeric(VarVal) Then
                                                If sUnits = "Percent" And VarVal > 100 Then
                                                    'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                                    If VarVal > MaxValEst Then
                                                        VarVal = MaxValEst
                                                    End If
                                                ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                                    VarVal = 0
                                                    'jrs 2011/03/28
                                                ElseIf sUnits = "Index" And VarVal > MaxValEst Then
                                                    VarVal = MaxValEst
                                                End If
                                            End If
                                        End If
                                    End If
                                    'jrs 2011/01/26
                                    If IsDBNull(VarVal) And bTreatNullsAs0s Then
                                        VarVal = 0
                                    End If
                                    '1st and second field = Country and Fips
                                    If (IsNumeric(VarVal)) Then
                                        'jrs 2007/07/20
                                        If IsDBNull(Sumplot) Then
                                            Sumplot = VarVal
                                        Else
                                            Sumplot = Sumplot + VarVal
                                        End If
                                    Else
                                        'There are Nulls in the set
                                        VarVal = 0
                                        NullFound = True
                                    End If
                                Next jj
                            Next kk
                            VarVal = Sumplot

                        Case "AVG"
                            Sumplot = 0
                            SumNum = 0
                            For kk = 1 To agcount
                                For jj = 1 To agcount2
                                    If valtbl.Select("Actor = '" & gGroupMembrs(kk).Replace("'", "''") & "' AND Partner = '" & gGroupMembrs2(jj).Replace("'", "''") & "'").Count > 0 Then
                                        'row = SeekRow(valtbl, gGroupMembrs(kk))
                                        row = valtbl.Select("Actor = '" & gGroupMembrs(kk).Replace("'", "''") & "' AND Partner = '" & gGroupMembrs2(jj).Replace("'", "''") & "'")(0)
                                        VarVal = row.Item(j + 3)
                                        If Not IsNumeric(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                            VarVal = fillHistoryHoles(row, j + 3, Val(valtbl.Columns(j + 3).Caption), bfillHistoryOnlyHoles, True)
                                            'jrs 2008/05/13
                                            If IsNumeric(VarVal) Then
                                                If sUnits = "Percent" And VarVal > 100 Then
                                                    'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                                    If VarVal > MaxValEst Then
                                                        VarVal = MaxValEst
                                                    End If
                                                ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                                    VarVal = 0
                                                    'jrs 2011/03/28
                                                ElseIf sUnits = "Index" And VarVal > MaxValEst Then
                                                    VarVal = MaxValEst
                                                End If
                                            End If
                                        End If
                                        'jrs 2011/01/26
                                        If IsDBNull(VarVal) And bTreatNullsAs0s Then
                                            VarVal = 0
                                        End If
                                        '1st and second field = Country and Fips
                                        If (IsNumeric(VarVal)) Then
                                            Sumplot = Sumplot + VarVal
                                            SumNum = SumNum + 1
                                        Else
                                            VarVal = 0
                                            NullFound = True
                                        End If
                                    End If
                                Next jj
                            Next kk
                            If SumNum <> 0 Then
                                VarVal = Sumplot / SumNum
                            Else
                                'jrs 2007/07/30 VarVal = 0 ' 0 in denom
                                VarVal = System.DBNull.Value
                            End If

                        Case Else 'jrs 2006/09/28
                            If sEmpVar > "" Then
                                'jrs 2007/07/30 Sumplot = 0
                                Sumplot = System.DBNull.Value
                                SumWeight = 0
                                For kk = 1 To agcount
                                    row = SeekRow(valtbl, gGroupMembrs(kk))
                                    VarVal = row.Item(j + 1)
                                    If Not IsNumeric(VarVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                        VarVal = fillHistoryHoles(row, j + 1, Val(valtbl.Columns(j + 1).Caption), bfillHistoryOnlyHoles, True)
                                        'jrs 2008/05/13
                                        If IsNumeric(VarVal) Then
                                            If sUnits = "Percent" And VarVal > 100 Then
                                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                                If VarVal > MaxValEst Then
                                                    VarVal = MaxValEst
                                                End If
                                            ElseIf sVar <> "PopulationGrowthRate" And VarVal < 0 Then
                                                VarVal = 0
                                                'jrs 2011/03/28
                                            ElseIf sUnits = "Index" And VarVal > MaxValEst Then
                                                VarVal = MaxValEst
                                            End If
                                        End If
                                    End If
                                    'jrs 2011/01/26
                                    If IsDBNull(VarVal) And bTreatNullsAs0s Then
                                        VarVal = 0
                                    End If

                                    '1st and second field = Country and Fips
                                    If sAgRule = "LND" Then
                                        Auxfld$ = "MostRecent"
                                    Else
                                        'jrs 2015/06/04
                                        If seriesYears(j) < FirstYearHistory Then
                                            Auxfld$ = "Earliest"
                                        Else
                                            Auxfld$ = Trim(Str(seriesYears(j)))
                                        End If
                                    End If
                                    rowWeight = SeekRow(tblWeight, gGroupMembrs(kk))
                                    Auxval = rowWeight(Auxfld)
                                    If Not IsNumeric(Auxval) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                                        Auxval = fillHistoryHoles(rowWeight, -1, seriesYears(j), bfillHistoryOnlyHoles, True)
                                        'jrs 2008/05/13
                                        If IsNumeric(Auxval) Then
                                            If sUnits = "Percent" And Auxval > 100 Then
                                                Auxval = 100
                                            ElseIf sVar <> "PopulationGrowthRate" And Auxval < 0 Then
                                                Auxval = 0
                                                'jrs 2011/03/28
                                            ElseIf AuxUnits = "Index" And Auxval > AuxMaxValEst Then
                                                Auxval = AuxMaxValEst
                                            End If
                                        End If
                                    End If
                                    If (IsNumeric(VarVal)) And (IsNumeric(Auxval)) Then
                                        'jrs 2007/07/20
                                        If IsDBNull(Sumplot) Then
                                            Sumplot = VarVal * Auxval
                                        Else
                                            Sumplot = Sumplot + VarVal * Auxval
                                        End If
                                        SumWeight = SumWeight + Auxval
                                    Else
                                        NullFound = True
                                        VarVal = 0
                                        Auxval = 0
                                    End If
                                Next kk
                                If SumWeight <> 0 Then
                                    VarVal = Sumplot / SumWeight
                                ElseIf IsDBNull(Sumplot) Then 'jrs 2007/07/20 in case all values are null
                                    VarVal = System.DBNull.Value
                                Else
                                    VarVal = 0  'Zero In Denominator
                                End If
                            End If

                    End Select

                    'jrs 2008/05/09
                    'Apply Currency Convertion
                    If IsNumeric(VarVal) Then
                        VarVal = VarVal / CurrencyFct
                        'jrs 2008/11/14 
                        'the if statement bellow from 2007/07/30 was probably to avoid doing the multiplication on a Null
                        VarVal = VarVal * Factor
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If
                    End If

                    'jrs 2009/03/03
                    'Avoid overwritting forecast with Nulls
                    If Not (IsDBNull(VarVal) And buseAllHistory And i + iFirstYear - 1 > iLastYearNotNull) Then
                        'jrs 2007/07/30
                        'jrs 2008/11/14 If IsNumeric(VarVal) Then
                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = VarVal 'jrs 2008/11/14 * Factor
                        Else
                            TargetVector(i, iColPosition) = VarVal 'jrs 2008/11/14 * Factor
                        End If
                        'jrs 2008/11/14 End If
                        'we need to load null values, otherwise we get problems in formulas
                        'where the same vector is reused to load each item of the formula
                        'and some years have data and others don't ex. GDS/GDP hist+for
                    End If

                    j = j + 1
                    'Check if it's the last year with data
                    If j > UBound(seriesYears) Then 'jrs 2006/06/06 LandUrban%Built only has data for 1992
                        Exit For
                    End If

                Else
                    If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                        NoVal = fillHistoryHolesforGroups(valtbl, -1, iFirstYear + i - 1, sAgRule, tblWeight, gCountGroupMembers, gGroupMembrs, sUnits, MaxValEst, sVar, bfillHistoryOnlyHoles, True)
                        'jrs 2008/05/13
                        If IsNumeric(NoVal) Then
                            If sUnits = "Percent" And NoVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NoVal > MaxValEst Then
                                    NoVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NoVal < 0 Then
                                NoVal = 0
                                'jrs 2011/03/28
                            ElseIf sUnits = "Index" And NoVal > MaxValEst Then
                                NoVal = MaxValEst
                            End If
                        End If
                    Else
                        NoVal = System.DBNull.Value
                    End If

                    'jrs 2008/05/09
                    'Apply Currency Convertion
                    If Not IsDBNull(NoVal) Then
                        NoVal = NoVal / CurrencyFct
                        'jrs 2009/03/03
                        NoVal = NoVal * Factor
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If
                    End If

                    'jrs 2009/03/03
                    'Avoid overwritting forecast with Nulls
                    If Not (IsDBNull(NoVal) And buseAllHistory And i + iFirstYear - 1 > iLastYearNotNull) Then
                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = NoVal
                        Else
                            TargetVector(i, iColPosition) = NoVal
                        End If
                    End If

                End If

            Next i
        Else  ' 1 country in the region, aggregation not needed
            NullFound = False
            'jrs 2006/07/24 Reload Table only if necessary
            Try
                'jrs 2025/03/11
                'Too many tables crashes the object
                If IFsTables.Count > 15000 Then
                    SyncLock IFsTables
                        IFsTables.Clear()
                    End SyncLock
                End If
                valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "] WHERE Actor = """ & gGroupMembrs(1) & """ AND Partner = """ & gGroupMembrs2(1) & """")
            Catch ex As ArgumentException
                'jrs 2012/01/31 avoid duplicate keys
                SyncLock IFsTables
                    If Not IFsTables.Contains("SELECT * FROM [" & TableName & "] WHERE Actor = """ & gGroupMembrs(1) & """ AND Partner = """ & gGroupMembrs2(1) & """") Then
                        SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "] WHERE Actor = """ & gGroupMembrs(1) & """ AND Partner = """ & gGroupMembrs2(1) & """", "", valtbl, spwd)
                        IFsTables.Add(valtbl, "SELECT * FROM [" & TableName & "] WHERE Actor = """ & gGroupMembrs(1) & """ AND Partner = """ & gGroupMembrs2(1) & """")
                    Else
                        valtbl = IFsTables.Item("SELECT * FROM [" & TableName & "] WHERE Actor = """ & gGroupMembrs(1) & """ AND Partner = """ & gGroupMembrs2(1) & """")
                    End If
                End SyncLock
            End Try
            'SetDataTablefromAccess(db, "SELECT * FROM [" & TableName & "]", "Country", valtbl, spwd)
            'row = SeekRow(valtbl, gGroupMembrs(1))
            'jrs 2025/03/10
            If valtbl.Rows.Count > 0 Then
                row = valtbl.Rows(0)
            Else
                Exit Sub
            End If

            'jrs 2008/11/11
            If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                MaxValEst = findMaxValCtry(valtbl, gGroupMembrs(1))
                If MaxValEst < 100 Then
                    MaxValEst = 100
                End If
                'MaxValEst = 1.2 * MaxValEst
            End If

            totalYearFields = valtbl.Columns.Count - 4
            ReDim seriesYears(totalYearFields)
            For i = 1 To totalYearFields
                seriesYears(i) = Val(valtbl.Columns(i + 3).Caption)
            Next i
            'jrs 2006/09/22
            If buseAllHistory Then
                For i = totalYearFields To 1 Step -1
                    If seriesYears(i) > 0 Then
                        'jrs 2010/08/27 added if to keep using forecast instead of trying to fill holes above base year
                        If Not IsDBNull(row.Item(CStr(seriesYears(i)))) Or seriesYears(i) < FirstYearForecast Then
                            'jrs 2010/08/20 to fill holes at the end of the table
                            If seriesYears(i) > FirstYearForecast - 1 Then
                                iLastYear = seriesYears(i)
                            Else
                                iLastYear = FirstYearForecast - 1
                            End If
                            iLstYrUseAllHistory = iLastYear
                            Exit For
                        End If
                    End If
                Next i
                'jrs 2014/03/26
                If seriesYears(1) < iFirstYear Then
                    iFirstYearOrg = iFirstYear
                    iFirstYear = seriesYears(1)
                    'jrs 2014/04/15 iFstYrUseAllHisotry = iFirstYear
                    If Not bSingleDim Then
                        StaYearHis(iColPosition) = iFirstYear
                    Else
                        If StaYearHis(iColPosition) > iFirstYear Or StaYearHis(iColPosition) = 0 Then
                            StaYearHis(iColPosition) = iFirstYear
                        ElseIf StaYearHis(iColPosition) > 0 Then
                            iFirstYear = StaYearHis(iColPosition)
                        End If
                    End If
                    'Need to move previous columns
                    If Not bSingleDim And iColPosition > 1 Then  'doubly dimension array
                        For j = 1 To iColPosition - 1
                            If iFirstYear < StaYearHis(j) Or StaYearHis(j) < 1 Then
                                If StaYearHis(j) < 1 Then
                                    'jrs 2015/08/28 diff = FirstYearHistory - iFirstYear
                                    diff = iFirstYearOrg - iFirstYear
                                Else
                                    diff = StaYearHis(j) - iFirstYear
                                End If
                                For i = FinYear(j) To 1 Step -1
                                    TargetVector(i + diff, j) = TargetVector(i, j)
                                Next i
                                For i = 1 To diff
                                    TargetVector(i, j) = System.DBNull.Value
                                Next i
                                FinYear(j) = FinYear(j) + diff
                                StaYearHis(j) = iFirstYear
                            End If
                        Next j
                    End If
                    'Need to move current column for forecast part on history+forecast
                    If iFirstYear < iFirstYearOrg Then
                        diff = iFirstYearOrg - iFirstYear
                        If Not bSingleDim Then
                            For i = LastYearHistory - iFirstYearOrg + FinYear(iColPosition) To LastYearHistory - iFirstYearOrg + 1 Step -1
                                TargetVector(i + diff, iColPosition) = TargetVector(i, iColPosition)
                                TargetVector(i, iColPosition) = System.DBNull.Value
                            Next i
                        Else
                            For i = LastYearHistory - iFirstYearOrg + FinYear(iColPosition) To LastYearHistory - iFirstYearOrg + 1 Step -1
                                TargetVector(i + diff) = TargetVector(i)
                                TargetVector(i) = System.DBNull.Value
                            Next i
                        End If
                    End If
                End If
            End If

            j = 1
            For i = 1 To iLastYear - iFirstYear + 1
                If seriesYears(j) < iFirstYear Then
                    Do While j < totalYearFields
                        j = j + 1
                        If seriesYears(j) >= iFirstYear Then Exit Do 'jrs 2008/04/29 added > table had years 51 and 61 so it was going to the end
                    Loop
                End If
                If j <= totalYearFields And i + iFirstYear - 1 = seriesYears(j) Then
                    NewVal = row.Item(j + 3)
                    If Not IsNumeric(NewVal) And (bfillHistoryHoles Or bfillHistoryOnlyHoles) Then
                        NewVal = fillHistoryHoles(row, j + 3, Val(valtbl.Columns(j + 3).Caption), bfillHistoryOnlyHoles, True)
                        'jrs 2008/05/13
                        If IsNumeric(NewVal) Then
                            If sUnits = "Percent" And NewVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NewVal > MaxValEst Then
                                    NewVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NewVal < 0 Then
                                NewVal = 0
                            End If
                        End If
                    End If
                    If Not IsNumeric(NewVal) Then
                        NullFound = True
                        'jrs 2009/03/03
                        'Avoid overwritting forecast with Nulls
                        If Not (buseAllHistory And i + iFirstYear - 1 > iLastYearNotNull) Then
                            If bSingleDim Then 'single dimension array
                                TargetVector(i) = System.DBNull.Value
                            Else
                                TargetVector(i, iColPosition) = System.DBNull.Value
                            End If
                        End If
                    Else
                        'jrs 2008/05/09
                        'Apply Currency Convertion
                        NewVal = NewVal / CurrencyFct
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If

                        'Store Value
                        If bSingleDim Then 'single dimension array
                            TargetVector(i) = NewVal * Factor
                        Else
                            TargetVector(i, iColPosition) = NewVal * Factor
                        End If
                    End If


                    j = j + 1
                    'Check if it's the last year with data
                    If j > UBound(seriesYears) Then 'jrs 2006/06/06 LandUrban%Built only has data for 1992
                        Exit For
                    End If
                Else
                    If bfillHistoryHoles Or bfillHistoryOnlyHoles Then
                        NoVal = fillHistoryHoles(row, -1, iFirstYear + i - 1, bfillHistoryOnlyHoles, True)
                        'jrs 2008/05/13
                        If IsNumeric(NoVal) Then
                            If sUnits = "Percent" And NoVal > 100 Then
                                'jrs 2008/11/11 EDPRIENRG is supposed to go above 100
                                If NoVal > MaxValEst Then
                                    NoVal = MaxValEst
                                End If
                            ElseIf sVar <> "PopulationGrowthRate" And NoVal < 0 Then
                                NoVal = 0
                            End If
                        End If
                    Else
                        NoVal = System.DBNull.Value
                    End If

                    'jrs 2008/05/09
                    'Apply Currency Convertion
                    If Not IsDBNull(NoVal) Then
                        NoVal = NoVal / CurrencyFct
                        'jrs 2009/03/03
                        'save last year that is not null
                        If i + iFirstYear - 1 > iLastYearNotNull Then
                            'null out all forecast years not deleted before
                            For kk = iLastYearNotNull + 1 To i + iFirstYear - 2
                                If bSingleDim Then
                                    TargetVector(kk - iFirstYear + 1) = DBNull.Value
                                Else
                                    TargetVector(kk - iFirstYear + 1, iColPosition) = DBNull.Value
                                End If
                            Next kk
                            iLastYearNotNull = i + iFirstYear - 1
                        End If
                    End If

                    'Store Value
                    If bSingleDim Then 'single dimension array
                        TargetVector(i) = NoVal
                    Else
                        TargetVector(i, iColPosition) = NoVal
                    End If
                End If
            Next i

        End If

        'jrs 2009/03/03
        If iLastYearNotNull > LastYearHistory - 1 And buseAllHistory Then
            iLastYear = iLastYearNotNull
            iLstYrUseAllHistory = iLastYear
        End If

        FinYear(iColPosition) = iLastYear - iFirstYear + 1
        valtbl = Nothing
        tblWeight = Nothing

        bLoadForDisplaySuccess = True

    End Sub


    Public Sub gLoadForDisplayHisSaveLbls(ByVal iColPosition As Integer, ByVal sVar As String,
    ByVal sDim1 As String, ByVal bGroups As Boolean, ByVal sDefinition As String,
    ByVal sUnits As String, ByVal sTitle As String, ByRef FileNumbr As Object,
    ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object,
    ByRef GR3N As Object, ByRef GR4N As Object, ByRef FDNG1 As Object, ByRef FDNG2 As Object,
    ByRef FDNG3 As Object, ByRef FDNG4 As Object)
        '13. iColPosition is the Column position within the Target vector to store the array. Used when the Target is doubly dimensioned.
        '1. sVar Variable Name
        '2. sDim1 Dimension1 Name
        '10. bGroups is true when using groups, if Null we have to find out if using groups or not
        '19. sTitle is the optional title to use in graphics
        '31. FileNumbr is a global array that stores the file number been read
        '30. VARN is a global array for labels
        '32. GR1N is a global array for labels
        '33. GR2N is a global array for labels
        '34. GR3N is a global array for labels
        '35. GR4N is a global array for labels
        '36. FDNG1 is a global array for graphs
        '37. FDNG2 is a global array for graphs
        '38. FDNG3 is a global array for graphs
        '39. FDNG4 is a global array for graphs
        If sTitle > "" Then
            VARN(0, iColPosition) = sTitle
        Else
            VARN(0, iColPosition) = sVar
        End If
        VARN(1, iColPosition) = sVar
        VARN(2, iColPosition) = sDefinition

        If bGroups Then
            VARN(5, iColPosition) = "GROUP"
        Else
            VARN(5, iColPosition) = "REGION"
        End If


        FileNumbr(iColPosition) = "-1"
        VARN(0, iColPosition) = VARN(0, iColPosition) & "[-1]"
        VARN(1, iColPosition) = VARN(1, iColPosition) & "[-1]"

        GR1N(iColPosition) = sDim1
        GR2N(iColPosition) = ""
        GR3N(iColPosition) = ""
        GR4N(iColPosition) = sUnits

        'Flexible Dimension Names for Graphs
        FDNG1(iColPosition) = GR1N(iColPosition)
        FDNG2(iColPosition) = GR2N(iColPosition)
        FDNG3(iColPosition) = GR3N(iColPosition)
        FDNG4(iColPosition) = GR4N(iColPosition)

    End Sub

    'jrs 2006/04/12
    'Subroutine to Load Formulas into Historic Analog, for History plus Forecast
    Public Sub gLoadCompHistAnal(ByVal col As Integer, ByVal sFormulaDet As String, ByVal idxVar As Integer, ByVal sDim1 As String,
    ByVal idxDim1 As Integer, ByVal sDim2 As String, ByVal idxDim2 As Integer, ByVal sDim3 As String, ByVal idxDim3 As Integer,
    ByVal FlagGroup As Boolean, ByRef dbComp As String, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer,
    ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef MyForm As Page, ByRef bLoadForDisplaySuccess As Boolean,
    ByRef FinYear As Object, ByRef bComputation As Boolean, ByRef TargetVector As Object,
    ByRef IFsPars As myParameters, ByVal bUseNullsAsZeros As Boolean, ByVal bFillHisOnlyHoles As Boolean,
    ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef StayearHis As Object, ByRef SQLite As String)
        '1. col indicates the position within the plot vector where the Formula is to be loaded usualy COUNTE
        '2. sFormulaDet is the formula itself, ex. a/b
        '3. idxVar is the index of the Variable in the Forecast side
        '4. sDim1 is the description of Dimension1, could be a region/group
        '5. idxDim1 is the index of Dimension1
        '6. sDim2 is the description of Dimension2
        '7. idxDim2 is the index of Dimension2
        '8. sDim3 is the description of Dimension3
        '9. idxDim3 is the index of Dimension3
        '10. FlagGroup indicates if we're working with groups
        '11. dbComp is the database (IFsVar.mdb), already connected that holds the information of the Analog Formula
        '12. bfillHistoryHoles, true indicates that we'll use interpolation or extrapolation where possible to fill in the holes.
        '13. buseAllHIstory if true it will ignore iLastYear and will retrieve all available history (> lastyearhistory, not < firstyearhistory)
        '14. iLstYrUseAllHistory is the last year of history loaded
        '15. LastYear global variable
        '16. LastYearForecast global variable
        '17. MyForm is the Page that is calling the sub routine
        '18. bLoadForDisplaySuccess global variable, indicates success when loading data
        '19. FinYear is a global array that contains the number of points ploted
        '20. bComputation is a global variable that indicates we're doing a computaion
        '21. TargetVector is the array to which store the results when using computations
        '22. IfsParameters is an object that contains the following parameters:
        'i. currencyVal (not used)
        'ii. vShortSce (not used)
        'iii. RunFiles (not used)
        'iv. Ifs_MDB2Active is a global variable with the database with group information
        'v. IFsCoVaTrASeries_MDB is the path to the covatra historical series file
        'vi. IFsHistSeries_MDB is the path to ifshistseries.mdb
        'vii. PutFdrvRun is a global variable that contains the path to ifsvar.mdb
        '22. bUseNullsAsZeros, if true replaces null with 0 'jrs 2008/05/22
        '23. bFillHisOnlyHoles true when not using extrapolation when filling holes

        Dim sql As String
        'open formula's table
        Dim rsComp As DataTable
        sql = "FORVARNAME = '" & V(idxVar) & "'"
        If sDim2 > "" Then
            sql = sql & " AND DIM2 = '" & Replace(sDim2, "'", "''") & "'"
            If sDim3 > "" Then
                sql = sql & " AND DIM3 = '" & sDim3 & "'"
            End If
        End If
        'jrs 2006/07/24 Reload Table only if necessary
        Try
            rsComp = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]") Then
                    SetDataTablefromAccess(dbComp, "SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]", "", rsComp)
                    IFsTables.Add(rsComp, "SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]")
                Else
                    rsComp = IFsTables.Item("SELECT * FROM IfsVarHISTANAFORMULASDET ORDER BY [CodeVar]")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = rsComp.Select(sql)

        Dim f As Formula
        f = New Formula
        f.init(sFormulaDet)
        f.Name = tblRows(0).Item("FormulaName")
        f.Dimension = sDim1
        f.Dimension2 = sDim2
        f.Dimension3 = sDim3
        f.Unit = ""
        'jrs 2008/05/22
        f.UseNullsAsZeros = bUseNullsAsZeros

        'jrs 2006/07/21
        'If bComputation Then
        '    frm_comp.SaveSessionFormula()
        'End If

        Dim oldLastYear As Integer
        oldLastYear = LastYear
        LastYear = LastYearHistory - 1 'jrs 2006/06/11

        Dim oldDimsize As Integer
        oldDimsize = f.DimensionSize
        f.DimensionSize = 0
        f.begAll = col

        f.endAll = col

        'jrs 2006/09/22
        Dim iMaxLstYrUseAllHistory As Integer
        'jrs 2008/11/13
        Dim iMinLstYrUseAllHistory As Integer
        Dim iYrToUseAllHistoryComp As Integer
        Dim i As Integer
        iMinLstYrUseAllHistory = 5000
        'jrs 2014/04/03
        Dim iMinFstYrUseAllHistory As Integer
        Dim iMaxFstYrUseAllHistory As Integer
        iMinFstYrUseAllHistory = 5000
        'jrs 2014/03/31
        Dim iFirstYearH As Integer
        iFirstYearH = FirstYearHistory
        'jrs 2015/06/04 This issue was found when doing:
        'Flex Displays, Cat. Governance, DemocPolity H+F and Freedom H+F with all available history
        'The first one starts in 1800, the second one in 1972
        'So when loading Freedom it was putting the values in 1812
        'I worry there might be problems if using a Formula with H+F and all avail. hist.
        If StayearHis(col) > 0 And StayearHis(col) < FirstYearHistory Then
            iFirstYearH = StayearHis(col)
        End If

        'jrs 2010/08/26
        'Save forecast in case formula returns null
        Dim PLOTCompF() As Single
        If buseAllHistory And bComputation Then
            'jrs 2014/03/31 Dim1Size = LastYearForecast - FirstYearHistory + 1
            ReDim PLOTCompF(MaxYears)

            'Save forecast in case formula returns null
            If bCompAll Then
                'jrs 2014/04/22 For i = LastYearHistory - FirstYearHistory + 1 To LastYearForecast - FirstYearHistory + 1
                For i = 1 To MaxYears
                    PLOTCompF(i) = TargetVector(i, col)
                Next i
            Else
                'jrs 2014/04/22 For i = LastYearHistory - FirstYearHistory + 1 To LastYearForecast - FirstYearHistory + 1
                For i = 1 To MaxYears
                    If IsNumeric(TargetVector(i)) Then
                        PLOTCompF(i) = TargetVector(i)
                    End If
                Next i
            End If
        End If

        'jrs 2014/04/21
        Dim FinYearCol As Integer
        FinYearCol = FinYear(col)

        Dim rr As Integer = 0
        Dim xPLOTComp() As Object
        ReDim xPLOTComp(MaxYears)
        Dim xData(f.disVar.disSize) As Object

        Do While Not tblRows.Length = rr
            f.disVar.setDataDetS(tblRows(rr).Item("CodeVar"), tblRows(rr).Item("VarName"))
            'jrs 2014/03/31 use iFirstYearH instead of using FirstYearHistory
            gLoadForDisplayHis(tblRows(rr).Item("VarName"), sDim1, idxDim1, sDim2, idxDim2, sDim3, idxDim3,
            FlagGroup, 1, xPLOTComp, col, iFirstYearH, LastYearHistory - 1, True, False,
            bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, bLoadForDisplaySuccess, MyForm,
            FinYear, LastYear, LastYearForecast, bComputation, "", "", IFsPars, bFillHisOnlyHoles,
            bCompAll, dataAll, StayearHis, SQLite)                'jrs 2006/06/11
            'jrs 2006/09/22
            If buseAllHistory Then
                If iMaxLstYrUseAllHistory < iLstYrUseAllHistory Then
                    iMaxLstYrUseAllHistory = iLstYrUseAllHistory
                End If
                'jrs 2010/08/27 added And iLstYrUseAllHistory > 0
                'jrs 2008/11/13
                If iMinLstYrUseAllHistory > iLstYrUseAllHistory And iLstYrUseAllHistory > 0 Then
                    iMinLstYrUseAllHistory = iLstYrUseAllHistory
                End If
                iYrToUseAllHistoryComp = AMAX(iMaxLstYrUseAllHistory, LastYearHistory - 1)
                'jrs 2014/04/03
                If iMaxFstYrUseAllHistory < StayearHis(col) Then
                    iMaxFstYrUseAllHistory = StayearHis(col)
                End If
                If iMinFstYrUseAllHistory > StayearHis(col) And StayearHis(col) > 0 Then
                    'If the new first year is smaller
                    If iMinFstYrUseAllHistory < FirstYearHistory Then
                        'need to move up previous elements of formula
                        ReArrangeDataAll(rr, iMinFstYrUseAllHistory - StayearHis(col), iMaxLstYrUseAllHistory - iMinFstYrUseAllHistory + 1, xData)
                        'jrs 2017/08/30 also need to move if the previous element was set at FirstYearHistory, so iMinFstYrUseAllHistory is still 5000
                    ElseIf iMinFstYrUseAllHistory = 5000 And StayearHis(col) < FirstYearHistory Then
                        ReArrangeDataAll(rr, FirstYearHistory - StayearHis(col), iMaxLstYrUseAllHistory - FirstYearHistory + 1, xData)
                    End If
                    iMinFstYrUseAllHistory = StayearHis(col)
                End If
                iFirstYearH = Amin(iMinFstYrUseAllHistory, FirstYearHistory)


                ''Clear vector from min to max
                'For i = iMinLstYrUseAllHistory + 1 To iYrToUseAllHistoryComp
                '    xPLOTComp(i - FirstYearHistory + 1) = System.DBNull.Value
                'Next i
            End If

            'jrs 2006/09/21 this was a problem when TargetVector = PlotComp
            'we were loosing information in PlotComp
            'ex. hist+forecast, a/b, ENP-us-oil/ENP-saudi-oil
            'loosing forecast side

            xData(rr + 1) = xPLOTComp.Clone

            'next variable
            rr = rr + 1
        Loop

        'jrs 2014/04/21
        'Need to move current column for forecast part on history+forecast
        If iFirstYearH < FirstYearHistory And (col = 1 Or iFirstYearH < StayearHis(col - 1)) Then
            Dim diffF As Integer, diff As Integer
            diffF = 0
            If col > 1 And StayearHis(col - 1) < FirstYearHistory Then
                diffF = FirstYearHistory - StayearHis(col - 1)
            End If
            diff = FirstYearHistory - iFirstYearH

            If bComputation Then
                'For i = LastYearHistory - FirstYearHistory + diffF + FinYearCol To iLstYrUseAllHistory - FirstYearHistory + diffF + 1 Step -1
                For i = LastYearHistory - FirstYearHistory + diffF + FinYearCol To iMinLstYrUseAllHistory - FirstYearHistory + diffF + 1 Step -1 'dsb 2025/12/2
                    TargetVector(i + diff - diffF) = PLOTCompF(i)
                Next i
            Else
                For i = LastYearHistory - FirstYearHistory + diffF + FinYearCol To LastYearHistory - FirstYearHistory + diffF + 1 Step -1
                    TargetVector(i + diff - diffF, col) = TargetVector(i, col)
                    TargetVector(i, col) = DBNull.Value
                Next i
            End If
        End If

        'jrs 2006/09/22
        If buseAllHistory Then
            'jrs 2010/08/20 iLstYrUseAllHistory = iMaxLstYrUseAllHistory
            'in order to avoid nulls after base year
            If iMinLstYrUseAllHistory < iMaxLstYrUseAllHistory Then
                iLstYrUseAllHistory = iMinLstYrUseAllHistory
            Else
                iLstYrUseAllHistory = AMAX(iMaxLstYrUseAllHistory, LastYearHistory - 1)
            End If

            If iLstYrUseAllHistory > LastYear Then
                LastYear = iLstYrUseAllHistory
                'jrs 2010/08/20
                FinYear(col) = iLstYrUseAllHistory - iFirstYearH + 1
            ElseIf FinYear(col) > iLstYrUseAllHistory - iFirstYearH + 1 Then
                'jrs 2014/04/21 FinYear(col) = iLstYrUseAllHistory - FirstYearHistory + 1
                FinYear(col) = iLstYrUseAllHistory - iFirstYearH + 1
            End If
            'jrs 2014/04/03
            If iMinFstYrUseAllHistory < FirstYearHistory Then
                StayearHis(col) = iMinFstYrUseAllHistory
            End If
        End If

        'jrs 2006/06/28
        'frm_comp.bHistAnal = True
        'End loading computed var
        'jrs 2008/07/11 changing from lastyear to totyears
        ComputeFormulas(f, LastYear - iFirstYearH + 1, iFirstYearH, xData, col, TargetVector,
        True, Nothing, MyForm, 0)

        'restore original values
        LastYear = oldLastYear

        'jrs 2006/09/22
        Dim lstYrHis As Integer
        If buseAllHistory Then
            lstYrHis = iLstYrUseAllHistory + 1 'jrs 2008/11/13 because we're not loading the last one when doing regular hist+forec
        Else
            lstYrHis = LastYearHistory
        End If

        'jrs 2010/03/02
        'Check mins and Max when using estimation
        If bfillHistoryHoles Then
            For i = 1 To lstYrHis - iFirstYearH
                If TargetVector.Rank = 1 Then
                    'jrs 2010/08/27
                    If IsNumeric(TargetVector(i)) Then
                        TargetVector(i) = Amin(AMAX(TargetVector(i), VMin(idxVar)), VMax(idxVar))
                    End If
                Else
                    'jrs 2010/08/27
                    If IsNumeric(TargetVector(i, col)) Then
                        TargetVector(i, col) = Amin(AMAX(TargetVector(i, col), VMin(idxVar)), VMax(idxVar))
                    End If
                End If
            Next i
        End If

        'jrs 2006/06/28
        'moved to frm_Computation
        If bComputation Then
            'jrs 2006/10/19
            ''jrs 2006/07/21
            'frm_comp.LoadTargetVector(TargetVector, lstYrHis)
            'frm_comp.ResetSessionFormula()
            '    Dim i As Integer
            '    If bCompAll Then
            '        For i = 1 To LastYearHistory - FirstYearHistory 'jrs 2006/06/11 + 1
            '            PLOTAll(i, col) = PLOT(i, col)
            '        Next i
            '    Else
            '        For i = 1 To LastYearHistory - FirstYearHistory 'jrs 2006/06/11 + 1
            '            PLOTComp(i) = PLOT(i, col)
            '        Next i
            '    End If
        End If

    End Sub

    'jrs 2006/04/09
    'Subroutine to load members of a group for Historical Empirical
    Public Sub gLoadGroupMembersHis(ByVal GroupName As String, ByVal GroupPoint As Integer, ByRef gCountGroupMembers As Integer,
    ByRef gGroupMembrs() As String, ByRef IFs_MDB2Active As String)
        '1. GroupName is the Group Name to load
        '2. GroupPoint is the Group Index as in the Grouping Table in IFs.mdb
        '3. gCountGroupMembers is a global variable to indicate number of countries in a group
        '4. gGroupMembrs is a global array that contains all countries in a group
        '5. IFs_MDB2Active is a global variable that contains the path to ifshistseries.mdb

        'Read and save pointers to group members and count of them
        '---------------------------------------------------------
        Dim valtblG As DataTable
        gCountGroupMembers = 0

        Dim GroupTot As Integer
        GroupTot = 0
        'jrs 2006/07/24 Reload Table only if necessary
        Try
            valtblG = IFsTables.Item("SELECT * FROM " & Grouping$ & " as G, " & Regionalization$ &
            " as R WHERE G.RegionNo = R.NewRegion Order by Country")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM " & Grouping$ & " as G, " & Regionalization$ &
                    " as R WHERE G.RegionNo = R.NewRegion Order by Country") Then
                    SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " & Grouping$ & " as G, " & Regionalization$ &
                    " as R WHERE G.RegionNo = R.NewRegion Order by Country", "", valtblG)
                    IFsTables.Add(valtblG, "SELECT * FROM " & Grouping$ & " as G, " & Regionalization$ &
                    " as R WHERE G.RegionNo = R.NewRegion Order by Country")
                Else
                    valtblG = IFsTables.Item("SELECT * FROM " & Grouping$ & " as G, " & Regionalization$ &
                    " as R WHERE G.RegionNo = R.NewRegion Order by Country")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = valtblG.Select("GroupNo = " & GroupPoint)
        'SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " & Grouping$ & " as G, " & Regionalization$ & _
        '" as R WHERE G.RegionNo = R.NewRegion AND G.GroupNo = " & GroupPoint & "  Order by Country", "", valtblG)
        GroupTot = tblRows.Length
        Dim rr As Integer = 0
        ReDim gGroupMembrs(GroupTot)
        Do While Not GroupTot = rr
            'GroupTot = GroupTot + 1
            gGroupMembrs(rr + 1) = tblRows(rr).Item("Country")
            rr = rr + 1
        Loop
        gCountGroupMembers = GroupTot
    End Sub

    'jrs 2006/04/09
    'Subroutine to load members of a Region for Historical Empirical
    Public Sub gLoadRegionMembersHis(ByVal regionname As String, ByVal idxRegion As Integer, ByRef gCountGroupMembers As Integer,
    ByRef gGroupMembrs() As String, ByRef IFs_MDB As String)
        '1. regionname is the Region Name to load
        '2. idxRegion is the Region Index as in the Regionalization table in Ifs.mdb
        '3. gCountGroupMembers is a global variable with the number of countries in a region
        '4. gGroupMembrs is a global array to store the members of the Group
        '5. IFs_MDB is a global variable with the path to IFs.mdb

        'Read and save pointers to group members and count of them
        '---------------------------------------------------------
        Dim valtblR As DataTable
        gCountGroupMembers = 0

        Dim RegTot As Integer
        RegTot = 0
        'jrs 2006/07/24 Reload Table only if necessary
        Try
            valtblR = IFsTables.Item("SELECT * FROM " + Regionalization$ + " Order by Country")
        Catch ex As ArgumentException
            'jrs 2012/01/31 avoid duplicate keys
            SyncLock IFsTables
                If Not IFsTables.Contains("SELECT * FROM " + Regionalization$ + " Order by Country") Then
                    SetDataTablefromAccess(IFs_MDB, "SELECT * FROM " + Regionalization$ + " Order by Country", "", valtblR)
                    IFsTables.Add(valtblR, "SELECT * FROM " + Regionalization$ + " Order by Country")
                Else
                    valtblR = IFsTables.Item("SELECT * FROM " + Regionalization$ + " Order by Country")
                End If
            End SyncLock
        End Try
        Dim tblRows() As DataRow
        tblRows = valtblR.Select("NewRegion = " + Str(idxRegion))
        'SetDataTablefromAccess(IFs_MDB, "SELECT * FROM " + Regionalization$ + _
        '       " Where NewRegion = " + Str(idxRegion) + " Order by Country", "", valtblR)

        ReDim gGroupMembrs(tblRows.Length)
        Dim rr As Integer = 0
        Do While Not tblRows.Length = rr
            RegTot = RegTot + 1
            gGroupMembrs(RegTot) = tblRows(rr).Item("Country")
            rr = rr + 1
        Loop
        gCountGroupMembers = RegTot
    End Sub

    'jrs 2020/08/03 added colDFs and colFiles
    'jrs 2006/04/17
    'Subroutine to Load stored Formulas
    Public Sub gLoadComp(ByVal col As Integer, ByVal sFormulaDet As String, ByVal sFormulaName As String, ByVal sDim1 As String, ByVal sDim2 As String,
    ByVal sDim3 As String, ByVal sUnit As String, ByVal FormulaId As Integer, ByRef FlagGroup As Object, ByVal FileNum As Integer,
    ByVal bHistoryPlusForecast As Boolean, ByVal bDiff As Object, ByRef ff As Formula, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer, ByVal bYearinVars As Boolean,
    ByRef bComputation As Boolean, ByRef FirstYear As Integer, ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef FinYear As Object,
    ByRef FileforDisplay As Integer, ByRef IfsPars As myParameters,
    ByRef TargetVector As Object, ByRef aFormulas As Object, ByVal bfillHistoryOnlyHoles As Boolean,
    ByRef iFstYrUseAllHisotry As Integer, ByVal bCompAll As Boolean, ByRef dataAll As Object, ByRef StaYearHis As Object,
    ByVal ActiveBase As String, ByRef SQLite As String, Optional ByRef colDFs As Collection = Nothing,
    Optional ByRef colFiles As Collection = Nothing)
        '1. col is the position within the Target vector where to store results, usually COUNTE within PLOT
        '2. sFormulaDet is the Formula used to initialize computations
        '3. sFormulaName is the Name to be diplayed
        '4. sDim1 is the First Dimension, if empty is read from the Variable saved
        '5. sDim2 is the Second Dimension, if empty is read from the Variable saved
        '6. sDim3 is the Third Dimension, if empty is read from the Variable saved
        '7. sUnit is the Units label to be used for display
        '8. FormulaId is the Id to retrive the Formula from IFsVars.VarListsFormulas, -1 means we're using a formula not saved, -2 means we're using history part for differentiated formulas
        '9. FlagGroup is True when Dimension1 is a group, in the future will need a FlagGroup for Dim2 and Dim3, if null is passed the parameter is changed to true if Groups are found
        '10. FileNum is the File Number to be used, when using forecast
        '11. bHistoryPlusForecast is true when using the Historic Analog option
        '12. bDiff is true when using differentiation between the Formula the History side, and the formula in the forecast side, if Null set to False
        '13. Formula to be used when not saved in Display List
        '14. bfillHistoryHoles, true indicates to fill up holes with interpolation or extrapolation
        '15. buseAllHIstory if true it will ignore iLastYear and will retrieve all available history (> lastyearhistory, not < firstyearhistory)
        '16. iLstYrUseAllHistory is the last year of history loaded
        '17. bYearinVars, if true indicates that the filenum should be taken from each variable and not from the parameter
        '18. bComputation global variable that indicates we're using computations
        '19. FirstYear global variable
        '20. LastYear global variable
        '21. LastYearForecast global variable
        '22. bLoadForDisplaySuccess global variable that indicates success when loading data
        '23. FinYear global array with the number of points per column
        '24. filefordisplay global variable to store opened file
        '25. IfsParameters is an object that contains the following parameters:
        'i. currencyVal global variable with the factor for currency conversion
        'ii. vShortSce global array with short name of sce files
        'iii. RunFiles global array with name of runfiles
        'iv. Ifs_MDB2Active is a global variable with the database with group information
        'v. IFsCoVaTrASeries_MDB is the path to the covatra historical series file
        'vi. IFsHistSeries_MDB is the path to ifshistseries.mdb
        'vii. PutFdrvRun is a global variable that contains the path to ifsvar.mdb
        '25. TargetVector is the array where to store the results
        '26. aFormulas array that stores the resulting formula
        'jrs 2014/03/26
        '27. iFstYrUseAllHisotry sets the first year in the table when using All History, even if it doesn 't have a value, only if less than FirstYearHistory
        '28. bCompAll true when loading formulas with all dimensions
        '29. dataAll
        '30. StaYearHis start year for history when using all available history
        '31. ActiveBase name of the base case, helps you tell if historical or forecast mode
        '32. colDFs is a collection of DataFrames to avoid having to re-load the dataframe if it's already in memory
        '33. colFiles is a collection of Files to avoid having to re-open the file

        _logger.Debug("gLoadComp")

        'jrs 2020/08/03
        Dim MyFileforDisplay As IStorage = Nothing
        Dim MyDF As IDataframe = Nothing

        'Validation for FileNumber
        If FileNum < 0 Then
            FileNum = 0
        End If
        'cdv 2021/03/25 Variable used for dynamic SQLite
        Dim UseSQLite As Boolean
        If SQLite = "True" Then
            UseSQLite = True
        Else
            UseSQLite = False
        End If

        'Validation for Formula Differentiation
        If IsNothing(bDiff) Then
            bDiff = False
        End If

        Dim f As Formula
        f = New Formula
        f.init(sFormulaDet)
        f.Name = sFormulaName
        f.Dimension = sDim1
        f.Dimension2 = sDim2
        f.Dimension3 = sDim3
        f.Unit = sUnit

        Dim oldbComputation As Boolean
        oldbComputation = bComputation
        bComputation = True
        Dim FinAll As Integer
        'jrs 2008/07/09
        Dim FinMin As Integer
        FinMin = LastYearForecast - FirstYearHistory + 1

        Dim oldDimsize As Integer
        oldDimsize = f.DimensionSize
        f.DimensionSize = 0
        f.begAll = col + 1

        'if formula id is -1 use formula data
        Dim sVarName As String, sCodeVar As String, iAbsolutePosition As Integer
        Dim sD1 As String, sD2 As String, sD3 As String
        Dim ii As Integer
        Dim rsComp As DataTable
        'jrs 2024/03/27
        Dim bOperationVsWorld As Boolean = False
        'jrs 2025/12/08
        Dim bOperationsVsPartner As Boolean = False
        'jrs 2025/12/15
        Dim sActor, sPartner As String
        sActor = ""
        sPartner = ""

        If FormulaId > 0 Then
            'open ifsvar
            Dim dbComp As String
            dbComp = IfsPars.PutFdrvRun + "IFSVAR.MDB"
            Dim sql As String
            'open formula's table
            SetDataTablefromAccess(dbComp, "SELECT Code, FormulaName, CodeVar, VarName, Dim1, Dim2, Dim3, IndexListName FROM VarListsFormulas WHERE FormulaId = " _
            & Str(FormulaId) & " ORDER BY [CodeVar]", "", rsComp)
            sVarName = rsComp.Rows(0).Item("VarName")
            sCodeVar = rsComp.Rows(0).Item("CodeVar")
            'jrs 2008/09/12
            If IsDBNull(rsComp.Rows(0).Item("Dim1")) Then
                sD1 = ""
            Else
                sD1 = Trim(rsComp.Rows(0).Item("Dim1"))
                'jrs 2024/03/27
                If rsComp.Rows.Count > 1 Then
                    If (rsComp.Rows(0).Item("Dim1").ToString.Trim = "World" And rsComp.Rows(1).Item("Dim1").ToString.Trim > "" And rsComp.Rows(1).Item("Dim1").ToString.Trim <> "World") Or
                        (rsComp.Rows(1).Item("Dim1").ToString.Trim = "World" And rsComp.Rows(0).Item("Dim1").ToString.Trim > "" And rsComp.Rows(0).Item("Dim1").ToString.Trim <> "World") Then
                        bOperationVsWorld = True
                    End If
                    'jrs 2025/12/08
                    If rsComp.Rows(0).Item("Dim2").ToString.Trim = rsComp.Rows(1).Item("Dim1").ToString.Trim And
                        rsComp.Rows(0).Item("Dim2").ToString.Trim > "" Then
                        bOperationsVsPartner = True
                        sActor = rsComp.Rows(0).Item("Dim1").ToString.Trim
                        sPartner = rsComp.Rows(0).Item("Dim2").ToString.Trim
                    End If
                End If
            End If
            'jrs 2008/09/11 sD2 = IIf(IsDBNull(rsComp.Rows(0).Item("Dim2")), "", Trim(rsComp.Rows(0).Item("Dim2")))
            If IsDBNull(rsComp.Rows(0).Item("Dim2")) Then
                sD2 = ""
            Else
                sD2 = Trim(rsComp.Rows(0).Item("Dim2"))
            End If
            If IsDBNull(rsComp.Rows(0).Item("Dim3")) Then
                sD3 = ""
            Else
                sD3 = Trim(rsComp.Rows(0).Item("Dim3"))
            End If

            iAbsolutePosition = 0

            'jrs 2008/01/22
            'check if it's an index
            If Not IsDBNull(rsComp.Rows(0).Item("IndexListName")) Then
                f.IndexVarListName = rsComp.Rows(0).Item("IndexListName")
            End If

            'jrs 2008/03/06
            Dim rsDef As DataTable
            SetDataTablefromAccess(dbComp, "SELECT * FROM VarListsFormulasHdr WHERE FormulaId = " & Str(FormulaId), "", rsDef)
            If rsDef.Rows.Count > 0 Then
                If Not IsDBNull(rsDef.Rows(0).Item("FormulaDefinition")) Then
                    f.Definition = rsDef.Rows(0).Item("FormulaDefinition")
                End If
                'jrs 2008/05/23
                If Not IsDBNull(rsDef.Rows(0).Item("UseNullsAsZeros")) Then
                    f.UseNullsAsZeros = rsDef.Rows(0).Item("UseNullsAsZeros")
                End If
                'jrs 2010/07/29
                If Not IsDBNull(rsDef.Rows(0).Item("Units")) Then
                    f.Unit = Trim(rsDef.Rows(0).Item("Units"))
                End If
            End If

        Else
            ii = 1
            If FormulaId = -2 Then
                sVarName = ff.disVarHis.displayDet(ii)
                sD1 = ff.disVarHis.displayDet1(ii)
                sD2 = ff.disVarHis.displayDet2(ii)
                sD3 = ff.disVarHis.displayDet3(ii)
            Else
                sVarName = ff.disVar.displayDet(ii)
                sD1 = ff.disVar.displayDet1(ii)
                sD2 = ff.disVar.displayDet2(ii)
                sD3 = ff.disVar.displayDet3(ii)
            End If
            sCodeVar = ff.disVar.display(ii)
            iAbsolutePosition = ii - 1

            'jrs 2008/01/22
            f.IndexVarListName = ff.IndexVarListName
            'jrs 2008/03/06
            f.Definition = ff.Definition
            'jrs 2008/05/21
            f.UseNullsAsZeros = ff.UseNullsAsZeros
            'jrs 2010/07/29
            f.Unit = ff.Unit
        End If

        Dim idxPos As Integer, idxPos2 As Integer, l As Integer, idxHis As Integer
        idxPos = InStr(1, sVarName, "]")
        idxHis = InStr(1, sVarName, "[-1]")

        Dim iFirstYear As Integer
        'jrs 2014/03/31
        Dim iFirstYearH As Integer
        iFirstYearH = FirstYearHistory
        If idxHis > 0 Then
            iFirstYear = FirstYearHistory
            'jrs 2014/03/31
            If col > 1 And StaYearHis(col - 1) > 0 And StaYearHis(col - 1) < iFirstYear Then
                iFirstYear = StaYearHis(col - 1)
                iFirstYearH = iFirstYear
            End If
        Else
            'jrs 2006/06/13
            If bHistoryPlusForecast And Not bDiff Then
                iFirstYear = FirstYearForecast
            Else
                iFirstYear = FirstYear
                'jrs 2019/08/08 added Or (Not bHistoryPlusForecast And UCase(ActiveBase) = "IFSBASE.RUN")
                'jrs 2014/03/31
                If col > 1 Then
                    If StaYearHis(col - 1) > 0 And (StaYearHis(col - 1) < iFirstYear Or (Not bHistoryPlusForecast And UCase(ActiveBase) = "IFSBASE.RUN")) Then
                        iFirstYear = StaYearHis(col - 1)
                        iFirstYearH = iFirstYear
                    End If
                End If
            End If
        End If

        'jrs 2019/08/08 added Or (iFirstYear = FirstYearHistory And UCase(ActiveBase) = "IFSBASE.RUN" And idxHis < 1)
        'jrs 2008/09/12, used for differentiated formulas
        Dim iOffsetPosition As Integer = 0

        Dim iRowPosition As Integer
        If bHistoryPlusForecast Or (bDiff And idxHis < 1) Or (iFirstYear < FirstYearForecast And UCase(ActiveBase) = "IFSBASE.RUN" And idxHis < 1) Then
            'jrs 2014/03/31
            iRowPosition = LastYearHistory - FirstYearHistory + 1
            'jrs 2019/08/08 Or (UCase(ActiveBase) = "IFSBASE.RUN" And idxHis < 1)
            'jrs 2014/03/31
            If col > 1 And StaYearHis(col - 1) > 0 And (StaYearHis(col - 1) < FirstYearHistory Or (UCase(ActiveBase) = "IFSBASE.RUN" And idxHis < 1)) Then
                iRowPosition = LastYearHistory - StaYearHis(col - 1) + 1
            End If

            'jrs 2008/09/12
            If bDiff And idxHis < 1 Then
                iOffsetPosition = iRowPosition - 1
                iRowPosition = 1
            End If
        Else
            iRowPosition = 1
        End If

        f.endAll = col + 1

        'thes are the dimensions to be saved whith each element of the formula,
        'independently of the parameters passed, or retrieved
        Dim dim1 As String, Dim2 As String, Dim3 As String 'jrs 2006/05/17 Dim3

        Dim fn As String, sDet As String
        Dim idxVar As Integer, sVar As String
        'Labels for Dimentionality
        Dim d1 As String, d2 As String, d3 As String
        d1 = "d1"
        d2 = "d2"
        d3 = "d3"

        'jrs 2006/09/22
        Dim iMaxLstYrUseAllHistory As Integer
        'jrs 2008/11/13
        Dim iMinLstYrUseAllHistory As Integer
        Dim iYrToUseAllHistoryComp As Integer
        Dim i As Integer
        iMinLstYrUseAllHistory = 5000
        'jrs 2014/04/03
        Dim iMinFstYrUseAllHistory As Integer
        Dim iMaxFstYrUseAllHistory As Integer
        iMinFstYrUseAllHistory = 5000

        'jrs 2014/02/03
        'Flag to mark this formula has both history and forecast variables
        Dim bMixHisFor As Boolean, tmpFinYear As Integer, tmpbuseAllHistory As Boolean
        bMixHisFor = False

        Dim rr As Integer
        rr = 0

        Dim xData(f.disVar.disSize) As Object

        'jrs 2010/08/26
        Dim PLOTCompF(0, 0) As Single
        'jrs 2016/02/24 *** begin ***
        'removed buseAllHistory to use in regular Hist+Forecast cases, if there's a formula in hist empirical it would
        'reset PlotComp
        'jrs 2010/08/26
        'If buseAllHistory And bHistoryPlusForecast Then 'jrs 2014/04/17 added and bHistoryPlusForecast
        If bHistoryPlusForecast Then 'jrs 2014/04/17 added and bHistoryPlusForecast
            'Save forecast in case formula returns null
            'jrs 2014/04/22 replaced LastYearForecast - FirstYearHistory + 1 with MaxYears
            'it can hapen that this is the first column loaded, and the elements need more space with all av. history
            ReDim PLOTCompF(f.disVar.disSize, MaxYears)
        End If
        Dim bFlagReloadForecast As Boolean

        'loop in the first formula's variables idx = 0
        Do While True
            'Replace File Number in Formula
            idxPos = InStr(1, sVarName, "[")
            If idxPos > 0 Then
                sVar = Mid(sVarName, 1, idxPos - 1)
                If idxHis < 1 Then
                    idxPos2 = InStr(1, sVarName, "]")
                    fn = Mid(sVarName, idxPos + 1, idxPos2 - idxPos - 1)
                    'jrs 2014/01/03 combining with history, only for initialization like procedure
                    If fn = "-1" Then
                        idxHis = 1
                        'Flag to mark this formula has both history and forecast variables
                        bMixHisFor = True
                    End If

                    'jrs 2006/06/15
                    If bYearinVars Then
                        sDet = sVarName
                        FileNum = fn
                    Else
                        sDet = Replace(sVarName, "[" & fn & "]", "[" & CStr(FileNum) & "]")
                    End If
                Else
                    sDet = sVarName
                End If
                'set variable idxvar
                idxVar = IfsVars.Item(Left(sVarName, idxPos - 1)).Index
            Else
                sDet = sVarName
                sVar = sDet
                'set variable idxvar
                idxVar = IfsVars.Item(sVarName).Index
            End If

            If idxVar = -1 Then
                idxVar = 0
            End If

            'Replace dimensions in formula
            If VDim1(idxVar) > 0 Or idxHis > 0 Then
                'jrs 2024/03/27 problem decomposing X(World)/Y(World) so added a flag bOperationVsWorld
                'jrs 2017/05/15 added  And sD1 <> "World", to allow X(country)/X(World)*100
                If sDim1 > "" And (sD1 <> "World" Or Not bOperationVsWorld) Then
                    dim1 = sDim1
                Else
                    dim1 = sD1
                End If
                'jrs 2025/12/15 added or sd1 = spartner
                'jrs 2025/12/08 added bOperationsVsPartner
                If bOperationsVsPartner And (VDim2(idxVar) = 0 Or sD1 = sPartner) Then
                    dim1 = sDim2
                End If

                If d1 = "d1" Then
                    d1 = dim1
                    'jrs 2025/12/10 added and not bOperationsVsPartner
                    'jrs 2017/05/15 added  And sD1 <> "World", to allow X(country)/X(World)*100
                ElseIf d1 <> dim1 And sD1 <> "World" And Not bOperationsVsPartner Then
                    d1 = ""
                End If
            Else
                dim1 = ""
                'jrs 2006/08/21 d1 = ""
            End If

            If VDim2(idxVar) > 0 Then
                'jrs 2008/01/11 added gGetDimIdx(VDim2(idxVar), sDim2, False) Or (VDim2(idxVar) = 1 And FlagGroup)
                'using old formulas A+B ENP hdryo + OthRenew
                'jrs 2009/03/12 added or (sDim2 = "Total" and Vdim2 <>1), GDS/GDP, for Total was returning Education
                'jrs 2026/02/12 If sDim2 > "" And (gGetDimIdx(VDim2(idxVar), sDim2, False, myForm) > 0 Or (VDim2(idxVar) = 1 And FlagGroup) _
                'Or (UCase(sDim2) = "TOTAL" And VDim2(idxVar) > 1)) Then
                'FlagGroup might be Nothing because of the combination of groups and regions, in that case we only check if the group exists
                If sDim2 > "" And (gGetDimIdx(VDim2(idxVar), sDim2, False, myForm) > 0 Or (VDim2(idxVar) = 1 And gGetGroupIdx(sDim2, False, myForm) > 0) _
                Or (UCase(sDim2) = "TOTAL" And VDim2(idxVar) > 1)) Then
                    Dim2 = sDim2
                Else
                    Dim2 = sD2
                End If
                'jrs 2025/12/15 added or sd1 = spartner
                If bOperationsVsPartner And sD2 = sActor Then
                    Dim2 = sDim1
                End If
                'jrs 2025/12/16
                If bOperationsVsPartner And sD2 = "World" Then
                    Dim2 = sD2
                    FlagGroup = Nothing
                    'jrs 2026/01/09
                    bOperationVsWorld = True
                End If

                If d2 = "d2" Then
                    d2 = Dim2
                ElseIf d2 <> Dim2 And Not bOperationsVsPartner Then 'jrs 2025/12/15 added and not bOperationsVsPartner
                    d2 = ""
                End If
            Else
                Dim2 = ""
                'jrs 2006/08/21 d2 = ""
            End If

            If VDim3(idxVar) > 0 Then
                'jrs 2008/01/11 added gGetDimIdx(VDim3(idxVar), sDim3, False) Or (VDim3(idxVar) = 1 And FlagGroup)
                'using old formulas A+B ENP hdryo + OthRenew
                'jrs 2009/03/12 added or (sDim3 = "Total" and Vdim3 <>1)
                If sDim3 > "" And (gGetDimIdx(VDim3(idxVar), sDim3, False, myForm) > 0 Or (VDim3(idxVar) = 1 And FlagGroup) _
                Or (UCase(sDim3) = "TOTAL" And VDim3(idxVar) > 1)) Then
                    Dim3 = sDim3
                Else
                    Dim3 = sD3
                End If
                If d3 = "d3" Then
                    d3 = Dim3
                ElseIf d3 <> Dim3 Then
                    d3 = ""
                End If
            Else
                Dim3 = ""
                'jrs 2006/08/21 d3 = ""
            End If

            f.disVar.setDataDetS(sCodeVar, sDet)
            f.disVar.setDataDet1S(sCodeVar, dim1)
            f.disVar.setDataDet2S(sCodeVar, Dim2)
            f.disVar.setDataDet3S(sCodeVar, Dim3)

            'jrs 2006/07/24
            'Check FlagGroup every time, since the formula could combine groups and regions
            Dim idxDim1 As Integer
            idxDim1 = -1
            If (VDim1(idxVar) = 1 Or idxHis > 0) And Not IsNothing(FlagGroup) Then
                idxDim1 = IFsRegs.Item(dim1).Index
                If FlagGroup Then
                    If idxDim1 > 0 Then
                        FlagGroup = False
                    End If
                Else
                    If idxDim1 < 0 Then
                        FlagGroup = True
                    End If
                End If
            End If

            'JRS 2006/06/28
            Dim xPLOTComp() As Object
            ReDim xPLOTComp(MaxYears)
            If idxHis > 0 Then
                'jrs 2008/07/11
                Dim LYH As Integer
                LYH = LastYearHistory
                If bDiff Then
                    LYH = LYH - 1
                End If

                'jrs 2014/01/03
                If bMixHisFor Then
                    tmpFinYear = FinYear(col)
                    iFirstYear = FirstYearHistory
                    tmpbuseAllHistory = buseAllHistory
                    buseAllHistory = True
                End If

                Dim sDef As String, sUn As String
                gLoadForDisplayHis(sVar, dim1, idxDim1, Dim2, -1, Dim3, -1,
                FlagGroup, 1, xPLOTComp, col, iFirstYear, LYH, True, False, bfillHistoryHoles,
                buseAllHistory, iLstYrUseAllHistory, bLoadForDisplaySuccess, myForm, FinYear,
                LastYear, LastYearForecast, bComputation, sDef, sUn, IfsPars, bfillHistoryOnlyHoles, False, Nothing, Nothing, SQLite)
                'gLoadForDisplayHisSaveLbls(col, sVar, dim1, FlagGroup, sDef, sUn, "", FileNumbr, VARN, _
                'GR1N, GR2N, GR3N, GR4N, FDNG1, FDNG2, FDNG3, FDNG4)

                'jrs 2014/01/03
                If bMixHisFor Then
                    FinYear(col) = tmpFinYear
                    buseAllHistory = tmpbuseAllHistory
                    'Reseting base year value for initialization purposes of Regression formulas on the fly
                    If IsDBNull(xPLOTComp(FirstYearForecast - FirstYearHistory + 1)) Or FirstYearForecast > iLstYrUseAllHistory Then
                        For i = iLstYrUseAllHistory To FirstYearHistory Step -1
                            If Not IsDBNull(xPLOTComp(i - FirstYearHistory + 1)) Then
                                xPLOTComp(FirstYearForecast - FirstYearHistory + 1) = xPLOTComp(i - FirstYearHistory + 1)
                                Exit For
                            End If
                        Next i
                    End If
                    'Moving history data to sit in forecast position for mixed formulas
                    If iLstYrUseAllHistory > FirstYearForecast Then
                        For i = FirstYearForecast To iLstYrUseAllHistory
                            xPLOTComp(i - FirstYearForecast + 1) = xPLOTComp(i - FirstYearHistory + 1)
                        Next i
                    Else
                        xPLOTComp(1) = xPLOTComp(FirstYearForecast - FirstYearHistory + 1)
                    End If
                End If

                'jrs 2006/09/22
                If buseAllHistory Then
                    If iMaxLstYrUseAllHistory < iLstYrUseAllHistory Then
                        iMaxLstYrUseAllHistory = iLstYrUseAllHistory
                    End If
                    'jrs 2008/11/13
                    If iMinLstYrUseAllHistory > iLstYrUseAllHistory Then
                        iMinLstYrUseAllHistory = iLstYrUseAllHistory
                    End If
                    iYrToUseAllHistoryComp = AMAX(iMaxLstYrUseAllHistory, LastYearHistory - 1)
                    'jrs 2014/04/03
                    If iMaxFstYrUseAllHistory < iFstYrUseAllHisotry Then
                        iMaxFstYrUseAllHistory = iFstYrUseAllHisotry
                    End If
                    If iMinFstYrUseAllHistory > iFstYrUseAllHisotry And iFstYrUseAllHisotry > 0 Then 'jrs 2014/05/05 added and iFstYrUseAllHisotry>0
                        'If the new first year is smaller
                        If iMinFstYrUseAllHistory < FirstYearHistory Then
                            'need to move up previous elements of formula
                            ReArrangeDataAll(iAbsolutePosition, iMinFstYrUseAllHistory - iFstYrUseAllHisotry, iMaxLstYrUseAllHistory - iMinFstYrUseAllHistory + 1, xData)
                        End If
                        iMinFstYrUseAllHistory = iFstYrUseAllHisotry
                    End If
                    iFirstYearH = Amin(iMinFstYrUseAllHistory, FirstYearHistory)
                    'jrs 2014/04/03 this is commented out in the hist+forecast branch
                    'originally commented out on 2010/08/26 by jrs
                    'Clear vector from min to max
                    'For i = iMinLstYrUseAllHistory + 1 To iYrToUseAllHistoryComp
                    '    xPLOTComp(i - FirstYearHistory + 1) = ""
                    'Next i
                End If
            Else
                If UseSQLite Then
                    'jrs 2020/08/03
                    If colFiles Is Nothing OrElse Not colFiles.Contains("FileForDisplay" + FileNum.ToString) Then
                        MyFileforDisplay = Nothing
                    Else
                        MyFileforDisplay = colFiles("FileForDisplay" + FileNum.ToString)
                    End If
                    If colDFs Is Nothing OrElse Not colDFs.Contains("df" + sVar + FileNum.ToString) Then
                        MyDF = Nothing
                    Else
                        MyDF = colDFs("df" + sVar + FileNum.ToString)
                    End If

                    'jrs 2020/12/08 change: bOpen = bCloseFile = Not Standalone, so that the file stays open all the time
                    'WEB VERSION NOTE: Need to Test leaving File Open with multiple users

                    _logger.Debug("gLoadComp before gLoadForDisplayNET call")
                    gLoadForDisplayNET(sVar, idxVar, dim1, idxDim1, Dim2, -1, Dim3, -1, "", FileNum, Not StandAloneMode, Not StandAloneMode, FlagGroup, 1, xPLOTComp, col, iRowPosition,
                    iFirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, IfsPars.RunFiles, IfsPars.PutFdrvRun, IfsPars.vShortSce,
                    FinYear, IfsPars.Ifs_MDB2Active, IfsPars.currencyVal, MyFileforDisplay, MyDF)
                Else
                    gLoadForDisplay(sVar, idxVar, dim1, idxDim1, Dim2, -1, Dim3, -1, "", FileNum, True, True, FlagGroup, 1, xPLOTComp, col, iRowPosition,
                    iFirstYear, LastYear, 0, True, bLoadForDisplaySuccess, myForm, IfsPars.RunFiles, IfsPars.PutFdrvRun, IfsPars.vShortSce, FileforDisplay,
                    FinYear, IfsPars.Ifs_MDB2Active, IfsPars.currencyVal)
                End If
                'gLoadForDisplaySaveLbls(col, idxVar, dim1, Dim2, Dim3, FlagGroup, FileNum, "",
                'sensitivityFlag, ShortSce, currencySym, VARN, GR1N, GR2N, GR3N, GR4N,
                'FDNG1, FDNG2, FDNG3, FDNG4)

                'jrs 2020/12/08 added and MyFileForDisplay <> Nothing and MyDF <> Nothing
                'jrs 2020/08/03
                If Not (colFiles Is Nothing) AndAlso Not colFiles.Contains("FileForDisplay" + FileNum.ToString) AndAlso Not (MyFileforDisplay Is Nothing) Then
                    colFiles.Add(MyFileforDisplay, "FileForDisplay" + FileNum.ToString)
                End If
                If Not (colDFs Is Nothing) AndAlso Not colDFs.Contains("df" + sVar + FileNum.ToString) AndAlso Not (MyDF Is Nothing) Then
                    colDFs.Add(MyDF, "df" + sVar + FileNum.ToString)
                End If

                'jrs 2008/07/09 to use different horizons in the same formula
                If FinYear(col) < FinMin Then
                    FinMin = FinYear(col)
                ElseIf FinYear(col) > FinMin Then
                    FinYear(col) = FinMin
                End If

                If bHistoryPlusForecast And Not bDiff Then
                    FinAll = FinYear(col)
                    'jrs 2014/03/28
                    If iFirstYearH = 0 Then
                        iFirstYearH = FirstYearHistory
                    End If
                    If col > 1 Then
                        If StaYearHis(col - 1) > 0 And StaYearHis(col - 1) < iFirstYearH Then
                            iFirstYearH = StaYearHis(col - 1)
                        End If
                    End If

                    'jrs 2016/02/24
                    'If Historic analog uses a formula, then it will reset PLOTComp, so we need to save it just in case that happens
                    '****************************************************************************************************************
                    'jrs 2010/08/26
                    'If buseAllHistory Then
                    'Save forecast in case formula returns null
                    For i = iRowPosition To LastYear - iFirstYearH + 1 'jrs 2014/03/31 LastYear - FirstYearHistory + 1
                        PLOTCompF(iAbsolutePosition, i) = xPLOTComp(i)
                    Next i
                    'End If
                    'jrs 2016/02/24 *** end *****************************************************************************************
                    'jrs 2012/11/09
                    If VDim1(idxVar) = 0 And dim1 = "" Then
                        If sDim1 > "" Then
                            dim1 = sDim1
                        Else
                            'jrs 2026/02/23
                            If sD1 > "" Then
                                dim1 = sD1
                            Else
                                dim1 = GRPS(1, 1)
                            End If
                        End If
                    End If

                    'jrs 2014/03/31 use iFirstYearH instead of using FirstYearHistory
                    'jrs 2006/06/08 Lastyearhistory - 1 in order to keep forecast values for year 2000 instead of historic ones
                    gLoadForDisplayHis(sVar, dim1, idxDim1, Dim2, -1, Dim3, -1,
                    FlagGroup, 1, xPLOTComp, col, iFirstYearH, LastYearHistory - 1, True, True, bfillHistoryHoles,
                    buseAllHistory, iLstYrUseAllHistory, bLoadForDisplaySuccess, myForm, FinYear, LastYear, LastYearForecast,
                    bComputation, "", "", IfsPars, bfillHistoryOnlyHoles, bCompAll, dataAll, StaYearHis, SQLite)
                    'jrs 2006/09/22
                    If buseAllHistory Then
                        'jrs 2018/09/12
                        iFstYrUseAllHisotry = StaYearHis(col)

                        If iMaxLstYrUseAllHistory < iLstYrUseAllHistory Then
                            iMaxLstYrUseAllHistory = iLstYrUseAllHistory
                        End If
                        'jrs 2008/11/13
                        If iMinLstYrUseAllHistory > iLstYrUseAllHistory Then
                            iMinLstYrUseAllHistory = iLstYrUseAllHistory
                        End If
                        iYrToUseAllHistoryComp = AMAX(iMaxLstYrUseAllHistory, LastYearHistory - 1)
                        'jrs 2014/04/03
                        If iMaxFstYrUseAllHistory < iFstYrUseAllHisotry Then
                            iMaxFstYrUseAllHistory = iFstYrUseAllHisotry
                        End If
                        Dim diff As Integer
                        If iMinFstYrUseAllHistory > iFstYrUseAllHisotry And iFstYrUseAllHisotry > 0 Then 'jrs 2014/05/05 added and iFstYrUseAllHisotry > 0
                            'If the new first year is smaller
                            If iMinFstYrUseAllHistory < FirstYearHistory Then
                                'need to move up previous elements of formula
                                ReArrangeDataAll(iAbsolutePosition, iMinFstYrUseAllHistory - iFstYrUseAllHisotry, LastYear - iMinFstYrUseAllHistory + 1, xData)
                                'jrs 2014/04/22
                                'also need to move the forecast plot
                                For i = 0 To iAbsolutePosition - 1
                                    diff = iMinFstYrUseAllHistory - iFstYrUseAllHisotry
                                    For j = LastYear - iMinFstYrUseAllHistory + 1 To 1 Step -1
                                        PLOTCompF(i, j + diff) = PLOTCompF(i, j)
                                    Next j
                                Next i
                                'jrs 2018/01/24
                            ElseIf iMinFstYrUseAllHistory = 5000 Then
                                'need to move up previous elements of formula
                                ReArrangeDataAll(iAbsolutePosition, FirstYearHistory - iFstYrUseAllHisotry, LastYear - FirstYearHistory + 1, xData)
                                'jrs 2014/04/22
                                'also need to move the forecast plot
                                For i = 0 To iAbsolutePosition - 1
                                    diff = FirstYearHistory - iFstYrUseAllHisotry
                                    For j = LastYear - FirstYearHistory + 1 To 1 Step -1
                                        PLOTCompF(i, j + diff) = PLOTCompF(i, j)
                                    Next j
                                Next i
                            End If
                            iMinFstYrUseAllHistory = iFstYrUseAllHisotry
                        End If
                        iFirstYearH = Amin(iMinFstYrUseAllHistory, FirstYearHistory)
                        'jrs 2014/04/22
                        If iRowPosition < LastYearHistory - iFirstYearH + 1 Then
                            diff = (LastYearHistory - iFirstYearH + 1) - iRowPosition
                            For i = MaxYears - diff To iRowPosition Step -1
                                PLOTCompF(iAbsolutePosition, i + diff) = PLOTCompF(iAbsolutePosition, i)
                            Next i
                            iRowPosition = LastYearHistory - iFirstYearH + 1
                        End If
                        'jrs 2010/08/20
                        '                    'Clear vector from min to max
                        '                    For i = iMinLstYrUseAllHistory + 1 To iYrToUseAllHistoryComp
                        '                        PLOTComp(i - FirstYearHistory + 1) = Null
                        '                    Next i                            
                    End If
                End If
            End If

            xData(iAbsolutePosition + 1) = xPLOTComp
            'jrs 2014/04/17
            ReDim xPLOTComp(MaxYears)

            'next variable
            If FormulaId > 0 Then
                rr = rr + 1
                If rr = rsComp.Rows.Count Then
                    Exit Do
                End If
                sVarName = rsComp.Rows(rr).Item("VarName")
                sCodeVar = rsComp.Rows(rr).Item("CodeVar")
                'jrs 2009/07/08 iif is evaluating the else part even if is true
                If IsDBNull(rsComp.Rows(rr).Item("Dim1")) Then
                    sD1 = ""
                Else
                    sD1 = Trim(rsComp.Rows(rr).Item("Dim1"))
                End If
                If IsDBNull(rsComp.Rows(rr).Item("Dim2")) Then
                    sD2 = ""
                Else
                    sD2 = Trim(rsComp.Rows(rr).Item("Dim2"))
                End If
                If IsDBNull(rsComp.Rows(rr).Item("Dim3")) Then
                    sD3 = ""
                Else
                    sD3 = Trim(rsComp.Rows(rr).Item("Dim3"))
                End If
                'sD1 = IIf(IsDBNull(rsComp.Rows(rr).Item("Dim1")), "", Trim(rsComp.Rows(rr).Item("Dim1")))
                'sD2 = IIf(IsDBNull(rsComp.Rows(rr).Item("Dim2")), "", Trim(rsComp.Rows(rr).Item("Dim2")))
                'sD3 = IIf(IsDBNull(rsComp.Rows(rr).Item("Dim3")), "", Trim(rsComp.Rows(rr).Item("Dim3")))
                iAbsolutePosition = rr
            Else
                ii = ii + 1
                If ii > ff.disVar.disSize Then
                    Exit Do
                End If
                If FormulaId = -2 Then
                    sVarName = ff.disVarHis.displayDet(ii)
                    sD1 = ff.disVarHis.displayDet1(ii)
                    sD2 = ff.disVarHis.displayDet2(ii)
                    sD3 = ff.disVarHis.displayDet3(ii)
                Else
                    sVarName = ff.disVar.displayDet(ii)
                    sD1 = ff.disVar.displayDet1(ii)
                    sD2 = ff.disVar.displayDet2(ii)
                    sD3 = ff.disVar.displayDet3(ii)
                End If
                sCodeVar = ff.disVar.display(ii)
                iAbsolutePosition = ii - 1
            End If
        Loop

        'jrs 2010/08/27
        If idxHis > 0 Or (bHistoryPlusForecast And Not bDiff) Then
            'jrs 2006/09/22
            If buseAllHistory Then
                'jrs 2010/08/20 iLstYrUseAllHistory = iMaxLstYrUseAllHistory
                iLstYrUseAllHistory = iMinLstYrUseAllHistory
                'jrs 2015/01/30
                If iMinFstYrUseAllHistory < LastYearForecast Then
                    'jrs 2014/04/03
                    iFstYrUseAllHisotry = iMinFstYrUseAllHistory
                End If
                'jrs 2009/02/27 blowing up when AllHistory is on, but doing just forecast
                If iLstYrUseAllHistory > 0 Then
                    'jrs 2009/02/05, it wasn't computing all years
                    'it depended on the years available in the last variable
                    'ENP, USA, Total -> oth. renew goes til 2k5, everything else to 2k7
                    FinYear(col) = iLstYrUseAllHistory - FirstYearHistory + 1
                End If
                'jrs 2010/08/26
                'Restore forecast where Nulls have been created
                'jrs 2014/03/31 
                'Dim j As Integer
                'For i = 1 To f.disVar.disSize
                '    'jrs 2015/01/30 For j = iMinLstYrUseAllHistory - FirstYearHistory + 2 To iMaxLstYrUseAllHistory - FirstYearHistory + 1
                '    For j = iMinLstYrUseAllHistory - iFirstYearH + 2 To iMaxLstYrUseAllHistory - iFirstYearH + 1
                '        xData(i)(j) = PLOTCompF(i - 1, j)
                '    Next j
                'Next i
                If bHistoryPlusForecast Then
                    ReLoadDataAll(PLOTCompF, iMinLstYrUseAllHistory - iFirstYearH + 2, iMaxLstYrUseAllHistory - iFirstYearH + 1, bCompAll, dataAll, ff, xData)
                End If
            End If
        End If

        'Labels for dimentionality
        If d1 = "d1" Then
            d1 = ""
        End If
        If d2 = "d2" Then
            d2 = ""
        End If
        If d3 = "d3" Then
            d3 = ""
        End If
        f.Dimension = d1
        f.Dimension2 = d2
        f.Dimension3 = d3

        'jrs 2006/04/19
        Dim oldFirstYear As Integer
        If bHistoryPlusForecast And Not bDiff Then
            oldFirstYear = FirstYear
            FirstYear = FirstYearHistory
        End If

        'jrs 2006/09/22
        Dim oldLastYear As Integer
        If buseAllHistory And iLstYrUseAllHistory > 0 Then
            oldLastYear = LastYear
            If iLstYrUseAllHistory > LastYear Then
                LastYear = iLstYrUseAllHistory
            End If
        End If

        'jrs 2008/07/11 moved up, before exit to use in loading only necessary data
        If bHistoryPlusForecast Then
            'jrs 2014/03/31 FinYear(col) = LastYearHistory - FirstYearHistory + FinAll
            FinYear(col) = LastYearHistory - iFirstYearH + FinAll
        End If

        'jrs 2018/09/12
        If iFirstYearH > 0 Then
            'jrs 2006/07/18
