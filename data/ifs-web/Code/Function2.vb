    Public Sub ReEstimateFunctionsWithUSD(ByVal iConstantYearDollars As Integer, ByVal bReplace As Boolean)
        Dim objWriter = New System.IO.StreamWriter(PutFdrv$ + "RUNFILES\TablFuncNotReEstimated.txt", append:=False)
        objWriter.WriteLine("Functions Not Re-estimated")
        objWriter.WriteLine("===========================")

        Dim objWriter2 = New System.IO.StreamWriter(PutFdrv$ + "RUNFILES\TablFuncReEstimated.csv", append:=False)
        objWriter2.WriteLine("Functions Re-estimated")
        objWriter2.WriteLine("========================")
        objWriter2.WriteLine("Original Fx, R2, a, b1, b2, b3, b4, b5, b6, New Fx, R2, a, b1, b2, b3, b4, b5, b6")

        'Open functions in TableFunc.db that are used in Preprocessor, Run, Historic Preprocessor or Historic Run
        Dim rsT As DataTable
        SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\TablFunc.db", "Select [Function Name] As Function_Name, XVariable, YVariable, RSquared, a, b1, b2, b3, b4, b5, b6, Minimum, Maximum FROM TablFunc WHERE Analytic = 1 And (UsedRun = ""Yes"" Or UsedPre = ""Yes"")", "", rsT)
        Dim rsV, rsV2 As DataTable

        'Collection of Independent Variable Tables
        Dim IndVarTbls As Dictionary(Of String, DataTable) = New Dictionary(Of String, DataTable)

        'Load all definitions used in preprocessor
        SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\DataDict.db", "Select [Variable] FROM DataDict WHERE UsedInPreprocessor = 1", "", rsV)

        Dim rr As Integer
        For rr = 0 To rsT.Rows.Count - 1
            Debug.Print("Funcion " & (rr + 1).ToString & " Of " & rsT.Rows.Count)
            'If rsT.Rows(rr).Item("Function_Name") = "GDP/Capita (PPP 2011) Versus Primary Net Intake Rate Male (MostRecent) Log" Then Stop
            'Look for functions using GDP, it could be
            'GDPPCP forecast
            'GDPPC forecast
            'GDP forecast
            'GDP2011PCPPP
            If bFunctionHasGDP(rsT.Rows(rr).Item("Function_Name"), rsT.Rows(rr).Item("XVariable"), rsT.Rows(rr).Item("YVariable")) Then
                'Define dependent variable and year
                Dim sXVarName As String
                sXVarName = rsT.Rows(rr).Item("XVariable")
                'Get Year from name
                Dim sXYear As String = ""
                Dim pos As Integer
                pos = sXVarName.IndexOf("(")
                If pos > 0 Then
                    sXYear = sXVarName.Substring(pos + 1)
                    pos = sXYear.IndexOf(")")
                    If pos > 0 Then
                        sXYear = sXYear.Substring(0, pos)
                    End If
                    sXVarName = sXVarName.Replace("(" & sXYear & ")", "")
                End If
                pos = sXVarName.IndexOf("/")
                Dim sXFactor As String = "1"
                Dim bXFactor As Boolean = False
                If pos > 0 Then
                    bXFactor = True
                    sXFactor = sXVarName.Substring(pos + 1)
                    sXVarName = sXVarName.Replace(sXFactor, "")
                    sXVarName = sXVarName.Replace("/", "")
                    sXVarName = sXVarName.Trim
                End If

                Dim sConstantDollarsOrig As String = ""
                pos = rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("(PPP")
                If pos > 0 Then
                    sConstantDollarsOrig = rsT.Rows(rr).Item("Function_Name").ToString.Substring(pos + 5, 4)
                    If Not IsNumeric(sConstantDollarsOrig) Then
                        sConstantDollarsOrig = ""
                    End If
                End If

                If sConstantDollarsOrig = "" Then
                    pos = rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("$)")
                    If pos > 0 Then
                        sConstantDollarsOrig = rsT.Rows(rr).Item("Function_Name").ToString.Substring(pos - 5, 4)
                        If Not IsNumeric(sConstantDollarsOrig) Then
                            sConstantDollarsOrig = ""
                        End If
                    End If

                End If

                'Don't recompute functions that already use the current constant year
                If sConstantDollarsOrig <> iConstantYearDollars.ToString Then
                    'Check if using forecast variable
                    pos = sXVarName.IndexOf("[")
                    If pos > 0 Then
                        'Remove file
                        sXVarName = sXVarName.Substring(0, pos)
                    End If

                    If sXVarName = "GDPPCP" Then
                        sXVarName = "GDP" & iConstantYearDollars.ToString & "PCPPP"
                    ElseIf sXVarName = "GDP" Then
                        sXVarName = "GDP" & iConstantYearDollars.ToString
                    End If

                    'Validate VarName
                    'SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\DataDict.db", "Select COUNT(*) FROM DataDict WHERE [Variable] = """ & sXVarName & """", "", rsV)
                    sXVarName = SeekValueNoIdx(rsV, "Variable", sXVarName, "Variable")

                    'if not found
                    If sXVarName = "" Then
                        'sXVarName = ""
                        'try name in function name
                        If rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("GDP/Capita (PPP ") >= 0 Or
                            rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("GDP/Capita ") >= 0 Or
                            (rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("GDP") >= 0 And
                            rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("PCPPP") >= 0) Then
                            sXVarName = "GDP" & iConstantYearDollars.ToString & "PCPPP"
                        Else
                            Debug.Print(rsT.Rows(rr).Item("Function_Name").ToString)
                            'Stop
                        End If
                    End If

                    If sXVarName.IndexOf("GDP") >= 0 And sConstantDollarsOrig = "" Then
                        sConstantDollarsOrig = sXVarName.Substring(3, 4)
                    End If
                    If sConstantDollarsOrig > "" Then
                        sXVarName = sXVarName.Replace(sConstantDollarsOrig, iConstantYearDollars.ToString)
                    End If
                    'Define dependent variable and year
                    Dim sYVarName As String
                    sYVarName = rsT.Rows(rr).Item("YVariable")
                    'Get Year from name
                    Dim sYYear As String = ""
                    Dim sFxYear As String = ""
                    pos = sYVarName.IndexOf("(")
                    If pos > 0 Then
                        sYYear = sYVarName.Substring(pos + 1)
                        sYYear = sYYear.Replace(")", "")
                        sYVarName = sYVarName.Replace("(" & sYYear & ")", "")
                    End If
                    pos = sYVarName.IndexOf("/")
                    Dim syFactor As String = "1"
                    Dim byFactor As Boolean = False
                    If pos > 0 Then
                        byFactor = True
                        syFactor = sYVarName.Substring(pos + 1)
                        sYVarName = sYVarName.Replace(syFactor, "")
                        sYVarName = sYVarName.Replace("/", "")
                        sYVarName = sYVarName.Trim
                    End If
                    'Check for Forecast variable
                    pos = sYVarName.IndexOf("[")
                    If pos > 0 Then
                        'Remove file
                        sYVarName = sYVarName.Substring(0, pos)
                    End If

                    If IfsVars.Item(sYVarName).Index > 0 Then
                        If Not IsDBNull(VHistoricAnalog(IfsVars.Item(sYVarName).Index)) Then
                            sYVarName = VHistoricAnalog(IfsVars.Item(sYVarName).Index)
                        End If
                    End If

                    'Validate VarName
                    'SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\DataDict.db", "Select COUNT(*) FROM DataDict WHERE [Variable] = """ & sYVarName & """", "", rsV)
                    sYVarName = SeekValueNoIdx(rsV, "Variable", sYVarName, "Variable")

                    'if not found
                    If sYVarName = "" Then
                        'sYVarName = ""
                        'try name in function name
                        pos = rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf("VERSUS")
                        If pos >= 0 Then
                            sYVarName = rsT.Rows(rr).Item("Function_Name").ToString.Substring(pos + 6)
                            'Check that Dep Variable is after the Versus
                            Dim pos2 As Integer
                            pos2 = sYVarName.ToUpper.IndexOf("GDP")
                            If pos2 >= 0 Then
                                sYVarName = rsT.Rows(rr).Item("Function_Name").ToString.Substring(0, pos - 1)
                            End If

                            pos = sYVarName.IndexOf("(")
                            If pos > 0 Then
                                If sFxYear = "" Then
                                    sFxYear = sYVarName.Substring(pos)
                                End If
                                sYVarName = sYVarName.Substring(0, pos - 1)
                            End If
                            SetDataTablefromSQLite(PutFdrv$ + "RUNFILES\DataDict.db", "Select [Variable] FROM DataDict WHERE [Definition] Like ""*" & sYVarName & "*""", "", rsV2)
                            If rsV2.Rows.Count > 0 Then
                                sYVarName = rsV2.Rows(0).Item(0)
                            Else
                                sYVarName = ""
                            End If
                        End If
                    End If

                    If sYVarName > "" And sXVarName > "" Then
                        If sFxYear = "" Then
                            'Try to find year in function
                            pos = rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf("VERSUS")
                            pos = rsT.Rows(rr).Item("Function_Name").ToString.IndexOf("(", pos)
                            If pos >= 0 Then
                                sFxYear = rsT.Rows(rr).Item("Function_Name").ToString.Substring(pos)
                                pos = sFxYear.IndexOf(")")
                                If pos > 0 Then
                                    sFxYear = sFxYear.Substring(0, pos + 1)
                                End If
                            End If
                        End If

                        If checkIfYearExists(sYVarName, FirstYearForecast.ToString) Then
                            sYYear = FirstYearForecast.ToString
                        Else
                            sYYear = "MostRecent"
                        End If

                        If checkIfYearExists(sXVarName, FirstYearForecast.ToString) Then
                            sXYear = FirstYearForecast.ToString
                        Else
                            sXYear = "MostRecent"
                        End If

                        'If sYYear > "" Then
                        'If sXYear = "" Then
                        '    sXYear = sYYear
                        'End If

                        Dim bLog As Boolean = False
                        If rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf("(LOG)") > 0 Or
                        rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf(" LOG ") > 0 Or
                        rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.Substring(rsT.Rows(rr).Item("Function_Name").ToString.Length - 3) = "LOG" Then
                            bLog = True
                        End If

                        Dim bPow As Boolean = False
                        If rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf("(POWER)") > 0 Or
                        rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf(" POWER ") > 0 Or
                        rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.Substring(rsT.Rows(rr).Item("Function_Name").ToString.Length - 3) = "POW" Then
                            bPow = True
                        End If

                        Dim bCubic As Boolean = False
                        If rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf("(CUBIC)") > 0 Or
                        rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.IndexOf(" CUBIC ") > 0 Or
                        rsT.Rows(rr).Item("Function_Name").ToString.ToUpper.Substring(rsT.Rows(rr).Item("Function_Name").ToString.Length - 5) = "CUBIC" Then
                            bCubic = True
                        End If


                        'Define new name of function (if already exists, decide if delete old or change name)
                        Dim FxName As String = rsT.Rows(rr).Item("Function_Name").ToString
                        If sConstantDollarsOrig > "" Then
                            FxName = FxName.Replace(sConstantDollarsOrig, iConstantYearDollars.ToString)
                        Else
                            FxName = FxName.Replace("GDP", "GDP" & iConstantYearDollars.ToString)
                        End If
                        If sFxYear > "" Then
                            FxName = FxName.Replace(sFxYear, "(" & sYYear & ")")
                        End If
                        'jrs 2023/10/04
                        Dim sReportLine As String = ""
                        'jrs 2023/10/05
                        Dim sMin, sMax As String
                        sMin = If(IsDBNull(rsT.Rows(rr).Item("Minimum")), "0", rsT.Rows(rr).Item("Minimum").ToString)
                        sMax = If(IsDBNull(rsT.Rows(rr).Item("Maximum")), "1000", rsT.Rows(rr).Item("Maximum").ToString)

                        'jrs 2025/01/21
                        'Revisit XFactor for GDPPCP
                        If Not bXFactor And sXVarName.Contains("PC") And CInt(sMax) < 200 Then
                            'GDPPC should be in thousands,not plain dollars
                            bXFactor = True
                            sXFactor = "1000"
                        End If

                        'Compute Regression
                        'Save Regression
                        ComputeAndSaveRegression(sXVarName, sXYear, sYVarName, sYYear, bLog, FxName, bXFactor, sXFactor, byFactor, syFactor, bReplace, bPow, bCubic, IndVarTbls, sReportLine, sMin, sMax)
                        'jrs 2023/10/04
                        sReportLine = rsT.Rows(rr).Item("Function_Name").ToString & "," & rsT.Rows(rr).Item("RSquared").ToString & "," & rsT.Rows(rr).Item("a").ToString & "," &
                            If(IsDBNull(rsT.Rows(rr).Item("b1")), "Null", rsT.Rows(rr).Item("b1").ToString) & "," &
                            If(IsDBNull(rsT.Rows(rr).Item("b2")), "Null", rsT.Rows(rr).Item("b2").ToString) & ", " &
                            If(IsDBNull(rsT.Rows(rr).Item("b3")), "Null", rsT.Rows(rr).Item("b3").ToString) & "," &
                            If(IsDBNull(rsT.Rows(rr).Item("b4")), "Null", rsT.Rows(rr).Item("b4").ToString) & "," &
                            If(IsDBNull(rsT.Rows(rr).Item("b5")), "Null", rsT.Rows(rr).Item("b5").ToString) & "," &
                            If(IsDBNull(rsT.Rows(rr).Item("b6")), "Null", rsT.Rows(rr).Item("b6").ToString) & "," &
                            sReportLine
                        objWriter2.WriteLine(sReportLine)
                        'End If
                    Else 'Variables to Re-estimate not found
