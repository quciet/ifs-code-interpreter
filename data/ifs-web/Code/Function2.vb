    Private Function CalcRSQR(ByRef vreg As RegressionObject, ByRef rsD As DataTable, ByRef rsI As DataTable, bLog As Boolean, bXFactor As Boolean, sXFactor As String, bYFactor As Boolean, sYFactor As String, bPow As Boolean) As Single
        Dim YMed As Single = 0
        Dim CCount As Integer = 0
        CalcRSQR = 0
        For i = 1 To rsD.Rows.Count
            If IsNumeric(rsD.Rows(i - 1).Item(0)) AndAlso IsNumeric(rsI.Rows(i - 1).Item(0)) Then
                If bLog Then
                    If rsI.Rows(i - 1).Item(0) > 0 Then
                        If bYFactor Then
                            YMed = YMed + rsD.Rows(i - 1).Item(0) / CSng(sYFactor)
                        Else
                            YMed = YMed + rsD.Rows(i - 1).Item(0)
                        End If
                        CCount = CCount + 1
                    End If
                ElseIf bPow Then
                    If rsI.Rows(i - 1).Item(0) > 0 And rsD.Rows(i - 1).Item(0) > 0 Then
                        If bYFactor Then
                            YMed = YMed + Log(rsD.Rows(i - 1).Item(0)) / CSng(sYFactor)
                        Else
                            YMed = YMed + Log(rsD.Rows(i - 1).Item(0))
                        End If
                        CCount = CCount + 1
                    End If
                Else
                    If bYFactor Then
                        YMed = YMed + rsD.Rows(i - 1).Item(0) / CSng(sYFactor)
                    Else
                        YMed = YMed + rsD.Rows(i - 1).Item(0)
                    End If
                    CCount = CCount + 1
                End If
            End If
        Next
        If CCount > 0 Then
            YMed = YMed / CCount
        Else
            Exit Function
        End If

        Dim STC As Single = 0
        Dim SCR As Single = 0
        For i = 1 To rsD.Rows.Count
            If IsNumeric(rsD.Rows(i - 1).Item(0)) AndAlso IsNumeric(rsI.Rows(i - 1).Item(0)) Then
                Dim Y, X As Single
                If bYFactor Then
                    Y = rsD.Rows(i - 1).Item(0) / CSng(sYFactor)
                Else
                    Y = rsD.Rows(i - 1).Item(0)
                End If
                If bXFactor Then
                    X = rsI.Rows(i - 1).Item(0) / CSng(sXFactor)
                Else
                    X = rsI.Rows(i - 1).Item(0)
                End If
                If bLog Then
                    If X > 0 Then
                        STC = STC + (Y - YMed) ^ 2
                        SCR = SCR + (vreg.RegVal(CDbl(Log(X))) - YMed) ^ 2
                    End If
                ElseIf bPow Then
                    If X > 0 And Y > 0 Then
                        STC = STC + (Log(Y) - YMed) ^ 2
                        SCR = SCR + (vreg.RegVal(CDbl(Log(X))) - YMed) ^ 2
                    End If
                Else
                    STC = STC + (Y - YMed) ^ 2
                    SCR = SCR + (vreg.RegVal(CDbl(X)) - YMed) ^ 2
                End If
            End If
        Next

        If STC > 0 Then
            CalcRSQR = SCR / STC
            'If CalcRSQR > 1 Then Stop
        End If
    End Function

