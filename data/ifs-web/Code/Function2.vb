    Public Sub OpenFile(ByRef Filename As String, ByRef COUNTE As Integer, ByRef PLOT As Object, ByRef VARN As Object,
    ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object, ByRef PutFdrvRun As String,
    ByRef WorkingFile As String, ByRef RunFiles As Object, ByRef HistoricBase As Boolean, ByRef ActiveBase As String,
    ByRef FirstYear As Integer, ByRef LastYear As Integer, ByRef LastYearForecast As Integer, ByRef FilesSelected As Short,
    ByRef DisplayLastYear As Integer, ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object,
    ByRef ScenarioFileDir As Object, ByRef FinYear As Object, ByRef SessionIdx As Integer, ByRef FinYearHis As Object,
    ByRef YAxisLabel As String, ByRef XAxisLabel As String, ByRef StaYearHis As Object, ByRef SQLite As String, ByRef sUsrDefCats As Object)
        'jrs 2005/05/27
        Dim UseSQLite As Boolean

        If SQLite = "True" Then
            UseSQLite = True
        Else
            UseSQLite = False
        End If

        If Dir(ScenarioFileDir & "Working.Sce") <> "" Then
            Kill(ScenarioFileDir & "Working.Sce")
        End If

        Dim OutFile As String
        Dim Number As Single
        Dim InFile As String
        Dim RECORD As Long
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        'JRS 4/27/02

        '   CancelError is True
        '    On Error GoTo ErrHandler
        '   -------------------------

        InFile = Filename
        OutFile = PutFdrvRun & "Working.run.db"

        If InStr(StrConv(InFile, VbStrConv.Uppercase), "IFSBASEHIST.RUN.DB") > 0 Then
            'jrs 2006/07/20
            If Not HistoricBase Then
                'IF THE WORKING FILE HAS NOT BEEN MODIFIED SAVE IT IN THE FARM
                FarmCheckSave(SessionIdx, OutFile, PutFdrvRun & "IFSBASE.RUN.DB")
            End If
            FarmFileAllocator("HIST", OutFile, SQLite)

            FirstYear = FirstYearHistory
            LastYear = LastYearHistory
            HistoricBase = CStr(True)
            ActiveBase = "IFSBASEHIST.RUN" 'IFsHist_MDB2
            RunFiles(1) = PutFdrvRun & "IFSBASEHIST.RUN.DB"
        ElseIf InStr(StrConv(InFile, VbStrConv.Uppercase), "IFSBASE.RUN.DB") > 0 Then
            'jrs 2006/07/21
            If HistoricBase Then
                'IF THE WORKING FILE HAS NOT BEEN MODIFIED SAVE IT IN THE FARM
                FarmCheckSave(SessionIdx, OutFile, PutFdrvRun & "IFSBASEHIST.RUN.DB")
            End If
            'jrs 2006/07/20
            FarmFileAllocator("BASE", OutFile, SQLite)

            FirstYear = FirstYearForecast
            LastYear = LastYearForecast
            HistoricBase = CStr(False)
            ActiveBase = "IFSBASE.RUN"
            RunFiles(1) = PutFdrvRun & "IFSBASE.RUN.DB"
        Else
            'jrs 2020/03/23
            If UseSQLite = True Then
                Dim working As IStorage
                Dim storageSvc As IStorageService = New StorageService(Filename)
                working = storageSvc.Open()
                FirstYear = working.FirstYear
                If FirstYear = FirstYearForecast Then
                    LastYear = LastYearForecast
                    HistoricBase = CStr(False)
                    ActiveBase = "IFSBASE.RUN"
                    RunFiles(1) = PutFdrvRun & "IFSBASE.RUN.DB"
                Else
                    LastYear = LastYearHistory
                    HistoricBase = CStr(True)
                    ActiveBase = "IFSBASEHIST.RUN"
                    RunFiles(1) = PutFdrvRun & "IFSBASEHIST.RUN.DB"
                End If
            Else
                'cdv 2021/12/13 ****START****
                ''jrs 2005/02/12
                Dim fNum As Integer
                fNum = FreeFile()
                FileOpen(fNum, InFile, OpenMode.Binary, OpenAccess.Read, OpenShare.Shared) 'Could be history or forecast scenario
                RECORD = VarPoint(PosModYearI)
                RECORD = RECORD * 4 - 3
                FileGet(fNum, Number, RECORD)
                FirstYear = Number
                FileClose(fNum)
                If FirstYear = FirstYearForecast Then
                    LastYear = LastYearForecast
                    HistoricBase = CStr(False)
                    ActiveBase = "IFSBASE.RUN"
                    RunFiles(1) = PutFdrvRun & "IFSBASE.RUN"
                Else
                    LastYear = LastYearHistory
                    HistoricBase = CStr(True)
                    ActiveBase = "IFSBASEHIST.RUN"
                    RunFiles(1) = PutFdrvRun & "IFSBASEHIST.RUN"
                End If
            End If


        End If
        FileCopyCheck(InFile, OutFile) 'jrs 2006/07/20 changed to FileCopyCheck, it was plain FileCopy
        WorkingFile = InFile
        FilesSelected = 1 'Must eliminate other selected files because may be
        'incompatible with new working file in initial year (i.e, historical/forecast)
        COUNTE = 0
        ClearPlot(COUNTE, PLOT, VARN, GR1N, GR2N, GR3N, GR4N, FirstYear, LastYear, LastYearForecast, FDNG1, FDNG2, FDNG3, FDNG4, FinYear, FinYearHis, True, YAxisLabel, XAxisLabel, StaYearHis, sUsrDefCats)
        'JRS 10/16/02 SAM COPY
        Dim sFileName() As String
        Dim idx As Short
        If UseSQLite Then
            If InStr(StrConv(InFile, VbStrConv.Uppercase), "IFSBASEHIST.RUN.DB") <= 0 Then
                sFileName = Split(InFile, "\")
                InFile = ""
                For idx = 0 To UBound(sFileName) - 1
                    InFile = InFile & sFileName(idx) & "\"
                Next idx
                If UCase(sFileName(idx)) = "IFSBASE.RUN.DB" Then
                    InFile = InFile & "SAMBase"
                Else
                    InFile = InFile & "SAM" & sFileName(idx)
                End If
                If (Right(InFile, 7) = ".run.db") Then
                    InFile = Left(InFile, Len(InFile) - 7)
                End If
                InFile = InFile & ".db"
                'jrs 2006/07/20
                FarmFileAllocator("SAM", PutFdrvRun & "SAMWorking.db", SQLite)
                FileCopyCheck(InFile, PutFdrvRun & "SAMWorking.db")
                'jrs 2008/06/16
                'need to copy ifsPop.mdb
                If InStr(InFile, "SAMBase.db") > 0 Then
                    InFile = Replace(InFile, "SAMBase.db", "IFsPop.db")
                Else
                    InFile = Replace(InFile, "SAM" & Replace(sFileName(idx), ".run.db", ".db"), "IFsPop" & Replace(sFileName(idx), ".run.db", ".db"))
                End If
                FarmFileAllocator("POP", PutFdrvRun & "IFsPopWork.db", SQLite)
                FileCopyCheck(InFile, PutFdrvRun & "IFsPopWork.db")
                'jrs 2008/06/16
            Else 'opening historic file
                'Open Population cohorts file too, if it's there
                InFile = DataFileDir$ & "IFsPopHist.db"
                If Dir(InFile) > "" Then
                    FarmFileAllocator("POPHIST", PutFdrvRun & "IFsPopWork.db", SQLite)
                    FileCopyCheck(InFile, PutFdrvRun & "IFsPopWork.db")
                End If
            End If
        Else
            If InStr(StrConv(InFile, VbStrConv.Uppercase), "IFSBASEHIST.RUN") <= 0 Then
                sFileName = Split(InFile, "\")
                InFile = ""
                For idx = 0 To UBound(sFileName) - 1
                    InFile = InFile & sFileName(idx) & "\"
                Next idx
                If UCase(sFileName(idx)) = "IFSBASE.RUN" Then
                    InFile = InFile & "SAMBase.mdb"
                Else
                    InFile = InFile & "SAM" & sFileName(idx)
                End If
                'jrs 2006/07/20
                FarmFileAllocator("SAM", PutFdrvRun & "SAMWorking.mdb", SQLite)
                FileCopyCheck(InFile, PutFdrvRun & "SAMWorking.mdb")
                'jrs 2008/06/16
                'need to copy ifsPop.mdb
                If InStr(InFile, "SAMBase.mdb") > 0 Then
                    InFile = Replace(InFile, "SAMBase.mdb", "IFsPop.mdb")
                Else
                    InFile = Replace(InFile, "SAM" & Replace(sFileName(idx), ".run", ".mdb"), "IFsPop" & Replace(sFileName(idx), ".run.db", ".mdb"))
                End If
                FarmFileAllocator("POP", PutFdrvRun & "IFsPopWork.db", SQLite)
                FileCopyCheck(InFile, PutFdrvRun & "IFsPopWork.mdb")
                'jrs 2008/06/16
            Else 'opening historic file
                'Open Population cohorts file too, if it's there
                InFile = DataFileDir$ & "IFsPopHist.mdb"
                If Dir(InFile) > "" Then
                    FarmFileAllocator("POPHIST", PutFdrvRun & "IFsPopWork.mdb", SQLite)
                    FileCopyCheck(InFile, PutFdrvRun & "IFsPopWork.mdb")
                End If
            End If
        End If
        'cdv 2021/12/13 ****END****
        'JRS 11/26/03
        DisplayLastYear = 0
        'ErrHandler: ' User Pressed Cancel
        '    Exit Sub

        'JRS 8/23/01 GUI Updating the properties
        'of the control
        'IFsGUIctrl1.FirstYear = FirstYear%
        'IFsGUIctrl1.LastYear = LastYear%
        'IFsGUIctrl1.HistoricBase = HistoricBase$
        'IFsGUIctrl1.cActiveBase = ActiveBase$
        'IFsGUIctrl1.cRunFiles(1) = RunFiles$(1)

    End Sub


