                dbTCmd.ExecuteNonQuery()
            Else
                Debug.Print(sFxName)
                rd.Close()
                Exit Sub
            End If
        End If

        rd.Close()

        Dim b1, b4 As String
        If bLog Then
            b4 = CoefB2.ToString
            b1 = "Null"
        ElseIf bPow Then
