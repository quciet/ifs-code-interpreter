        Dim rd As SqliteDataReader
        rd = dbHCmd.ExecuteReader

        Dim sLastYear As String
        sLastYear = rd.GetName(rd.FieldCount - 3)
        Dim sFirstYear As String
        sFirstYear = rd.GetName(2)
        If sLastYear < sYear Then
            checkIfYearExists = False
        Else
            If sFirstYear > sYear Then
                checkIfYearExists = False
            Else
                Dim i As Integer
                checkIfYearExists = False
                For i = rd.FieldCount - 3 To 2 Step -1
                    If sYear = rd.GetName(i) Then
                        checkIfYearExists = True
                        Exit For
                    End If
                Next i
            End If
        End If

        dbH.Close()

    End Function

