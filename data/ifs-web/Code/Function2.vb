        'jrs 2017/03/24 Do While (Not idx = rs.Rows.Count)
        Dim vIdx As Integer
        For vIdx = 1 To NumbVars

            sVar = V(vIdx)
            'jrs 2012/04/26
            VarIdx = vIdx
            DimNum = -1
            _logger.Debug("gLoadForDisplayNET LoadDataFrame start " + sVar)
