    'This procedure checks if the working file has not been modified, and if not saves it to the FARM
    'This allow us to save non-modified working files and thus not eat up FARM resources too quickly
    Public Sub FarmCheckSave(ByVal SessionIdx As Integer, ByVal WorkingPath As String, ByVal BasePath As String)
        Dim FDT1 As Object
        Dim FDT2 As Object
        FDT1 = FileDateTime(WorkingPath)
        FDT2 = FileDateTime(BasePath)
        If FDT1 = FDT2 Then
            'Build Target File Name
            Dim TargetFile As String, IFsPopTarget As String
            If InStr(UCase(BasePath), "IFSBASEHIST") > 0 Then
                TargetFile = "IFsBASEHISTSession"
                IFsPopTarget = "IFsPopHistSession"
            Else
                TargetFile = "IFsBASESession"
                IFsPopTarget = "IFsPopSession"
            End If
            If SessionIdx < 10 Then
                TargetFile = TargetFile & "0"
                IFsPopTarget = IFsPopTarget & "0"
            End If
            TargetFile = TargetFile & Trim(Str(SessionIdx)) & "_"
            IFsPopTarget = IFsPopTarget & Trim(Str(SessionIdx)) & "_"
            Dim FarmPath As String
            FarmPath = PutFdrv & "RUNFILES\FARM\"
            Dim counter As Integer = 0

            'jrs 2008/06/13
            'It's generating too many files
            'Do While File.Exists(FarmPath & TargetFile & Trim(Str(counter)) & ".run")
            '    counter = counter + 1
            'Loop

            TargetFile = TargetFile & Trim(Str(counter)) & ".run.db"
            IFsPopTarget = IFsPopTarget & Trim(Str(counter)) & ".db"
            'Move it
            FileMoveCheck(WorkingPath, FarmPath & TargetFile)
            'jrs 2008/06/16
            'also move ifsPopWork.mdb
            FileMoveCheck(Replace(WorkingPath, "Working.run.db", "IFsPopWork.db"), FarmPath & IFsPopTarget)
        End If
