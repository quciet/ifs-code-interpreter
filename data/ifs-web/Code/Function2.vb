    Public Sub gLoadEdnCostLabels(ByVal idxVar As Integer, ByVal pCOUNTE As Integer, ByVal fileIdx As Integer,
    ByVal Dim1 As String, ByVal Dim2 As String, ByVal strPrefix As String, ByVal strSuffix As String,
    ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object,
    ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object, ByVal bGrp As Boolean,
    ByRef SensitivityFlag As Object, ByRef vShortSce As Object, ByRef CurrencySym As String,
    Optional ByVal VName As String = "", Optional ByVal VDefn As String = "", Optional ByVal VUnit As String = "",
    Optional ByVal strGR3 As String = "")
        'mti April 2008 New

        If VName = "" Then
            VARN(0, pCOUNTE) = strPrefix & V$(idxVar) & strSuffix '& "(" & LTrim$(CStr(trgtRate)) & "%)"
            VARN(1, pCOUNTE) = strPrefix & V$(idxVar) & strSuffix '& "(" & LTrim$(CStr(trgtRate)) & "%)" 'Replace(V$(idxVar), "1LN", CStr(level) & "LN")
        Else
            VARN(0, pCOUNTE) = strPrefix & VName & strSuffix '& "(" & LTrim$(CStr(trgtRate)) & "%)"
            VARN(1, pCOUNTE) = strPrefix & VName & strSuffix '& "(" & LTrim$(CStr(trgtRate)) & "%)" 'Replace(V$(idxVar), "1LN", CStr(level) & "LN")
        End If

        If VDefn = "" Then
            VARN(2, pCOUNTE) = VDef$(idxVar)
        Else
            VARN(2, pCOUNTE) = VDefn
        End If

        VARN(3, pCOUNTE) = VHelpID(idxVar)
        VARN(6, pCOUNTE) = VHelpIDEqn(idxVar)

        'this is for Validation
        If bGrp = True Then
            VARN(5, pCOUNTE) = "GROUP"
        Else
            VARN(5, pCOUNTE) = "REGION"
        End If

        If SensitivityFlag <> True Then
            VARN(0, pCOUNTE) = VARN(0, pCOUNTE) & "[" & LTrim$(CStr(vShortSce(fileIdx))) & "]"
            VARN(1, pCOUNTE) = VARN(1, pCOUNTE) & "[" & LTrim$(Str$(fileIdx)) & "]"
        End If

        GR1N(pCOUNTE) = Dim1
        GR2N(pCOUNTE) = Dim2

        GR3N(pCOUNTE) = strGR3

        If VCurrency(idxVar) Then
            gCurrencyLblSwitch(idxVar, pCOUNTE, CurrencySym, GR4N)
            If VUnit = "" Then
                GR4N(pCOUNTE) = VUnits(idxVar)
            Else
                GR4N(pCOUNTE) = VUnit
            End If
        Else
            'GR4N$(pCOUNTE) = VUnits(idxVar) 'Other Grid Values determined earlier
            If VUnit = "" Then
                GR4N(pCOUNTE) = VUnits(idxVar)
            Else
                GR4N(pCOUNTE) = VUnit
            End If

        End If

        'Flexible Dimension Names for Graphs
        FDNG1(pCOUNTE) = GR1N(pCOUNTE)
        FDNG2(pCOUNTE) = GR2N(pCOUNTE)
        FDNG3(pCOUNTE) = GR3N(pCOUNTE)
        FDNG4(pCOUNTE) = GR4N(pCOUNTE)

    End Sub

    'jrs 2012/10/24
    Public Function getUnitsWCurrency(ByVal idxVar As Integer, ByVal CurrencySym As String) As String
        'If it returns information, load it to the variables
        If CurrencySym > "" And CurrencySym <> "$" Then
            'Update the name of the Units
            Dim MyPos As Long
            Dim s As String
            Dim s2 As String
            s2 = VUnits(idxVar)
            'Using an Array for the Original Symbol
            'of every variable
            MyPos = InStr(1, s2, "$", vbTextCompare)
            s = RTrim(CurrencySym)
            If MyPos > 0 Then
                'Using an Array for the Original Symbol
                'of every variable
                getUnitsWCurrency = Left(s2, MyPos - 1) + s + Right(s2, Len(s2) - MyPos)
            Else
                getUnitsWCurrency = VUnits(idxVar)
            End If
        Else
            getUnitsWCurrency = VUnits(idxVar)
        End If
    End Function

    'jrs 2016/11/09 added parameter VDisplayUnitsName 
    'jrs 2012/10/24
    Public Function getDisplayUnitsWCurrency(ByVal idxVar As Integer, ByVal CurrencyName As String, ByRef VDisplayUnitsName As Object) As String
        'If it returns information, load it to the variables
        If CurrencyName > "" And CurrencyName <> "Dollar" Then
            'Update the name of the Units
            Dim MyPos As Long
            Dim s As String
            Dim s2 As String
            s2 = VDisplayUnitsName(idxVar)
            s2 = Replace(s2, "US Dollar", "Dollar")
            'Using an Array for the Original Symbol
            'of every variable
            MyPos = InStr(1, s2, "Dollar", vbTextCompare)
            s = RTrim(CurrencyName)
            If MyPos > 0 Then
                'Using an Array for the Original Symbol
                'of every variable
                getDisplayUnitsWCurrency = Left(s2, MyPos - 1) + s + Right(s2, Len(s2) - MyPos - 5)
            Else
                getDisplayUnitsWCurrency = VDisplayUnitsName(idxVar)
            End If
        Else
            getDisplayUnitsWCurrency = VDisplayUnitsName(idxVar)
        End If
    End Function

