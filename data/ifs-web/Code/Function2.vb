        Dim rsCountry As DataTable
        Dim rsDataDict As DataTable
        SetDataTablefromSQLite(DataFileDir$ & "DataDict.db", "SELECT * FROM DataDict", "", rsDataDict)

        Dim i As Integer
        For i = 0 To tds.Rows.Count - 1
            If rsDataDict.Select("[Table] = '" & tds.Rows(i).Item(0) & "'").Count > 0 Then
                'jrs 2023/06/30 added []
                'if it's a valid table then look for content
                SetDataTablefromSQLite(DataFileDir & "ifsHistSeriesAugment.db", "SELECT * FROM [" & tds.Rows(i).Item(0) & "]", "", rsCountry)
                Exit For
            End If
        Next i
        If rsCountry.Rows.Count > 0 Then
            'Open ifs to check if country is valid
            Dim rsValCtry As DataTable
            SetDataTablefromSQLite(IFs_MDB2Active, "SELECT * FROM [Country Translation]", "", rsValCtry)
            CountryTot = rsCountry.Rows.Count
            ReDim CountryList(CountryTot)
            i = 1
            Dim j As Integer = 0
            Do While j < rsCountry.Rows.Count
                'jrs 2025/05/21 If rsValCtry.Select("Country = '" & rsCountry.Rows(j).Item(0) & "'").Count > 0 Then
                If rsValCtry.Select("Country = '" & rsCountry.Rows(j).Item(0).ToString.Replace("'", "''") & "'").Count > 0 Then
                    CountryList(i) = rsCountry.Rows(j).Item(0)
                    i = i + 1
                End If
                j = j + 1
            Loop
            rsValCtry = Nothing
            CountryTot = i - 1
        End If
        'Close Augment file
        'db.Close
        'Close DataDict
        rsDataDict = Nothing
        'dbDataDict.Close
        'Need to add new rows to ifsInit
