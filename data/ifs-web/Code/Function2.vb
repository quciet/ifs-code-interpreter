    'loop throught the V-List searching for the dimensions to be loaded (originally from VarSelect)
    Public Sub SearchDimstoLoadforVList(ByVal sVar As String, ByRef svIdx As Integer, ByRef sbDim2 As String, ByRef sbDim3 As String, ByRef db As SqliteConnection)
        Dim idx As Integer
        Dim sDim2 As String
        Dim sDim3 As String
        Dim rsList As SqliteDataReader
        Dim rsCmd As SqliteCommand
        rsCmd = db.CreateCommand
        rsCmd.CommandText = "SELECT * FROM VarLists WHERE ListName = """ & sVar & """ ORDER BY ListOrder"
        rsList = rsCmd.ExecuteReader

        Dim rsListComp As SqliteDataReader
        Dim dbCmdComp As SqliteCommand
        dbCmdComp = db.CreateCommand
        Dim bDim2 = True
        Dim bDim3 = True
        svIdx = -1
        Dim MaxDimNum As Integer
        MaxDimNum = 0
        'jrs 2007/10/19
        Dim bPov As Boolean, bPovPct As Boolean, bPovFind As Boolean, PovLevel As Single
        'jrs 2014/10/21
        Dim b2005PPP As Boolean
        'jrs 2011/06/17
        Dim bIncR As Boolean, PovLevel2 As Single

        'jrs 2010/05/14
        Dim bMortChl As Boolean, bMortAdl As Boolean

        'loop each variable
        Do While rsList.Read
            'read index
            idx = ReadIdx(rsList("VarName"))
            If svIdx = -1 Then
                svIdx = idx
            End If

            'check dimensions
            If VDim1(idx) > 0 And MaxDimNum = 0 Then
                MaxDimNum = 1
                svIdx = idx
            End If
            CheckDims(bDim2, VDim2(idx), idx, IIf(IsDBNull(rsList("Param2")), "", rsList("Param2")), sDim2, MaxDimNum, svIdx, "", 2, False)
            CheckDims(bDim3, VDim3(idx), idx, IIf(IsDBNull(rsList("Param3")), "", rsList("Param3")), sDim3, MaxDimNum, svIdx, "", 3, False)

            'if formula loop each member
            If rsList("Formula") Then
                dbCmdComp.CommandText = "SELECT * FROM VarListsFormulas WHERE FormulaId = " & rsList("FormulaId") & " ORDER BY [CodeVar]"
                rsListComp = dbCmdComp.ExecuteReader
                'jrs 2025/12/10
                'Check for Dyadic vs Monadic formulas
                Dim bBilateral As Boolean = False
                Dim bMonadic As Boolean = False
                'jrs 2025/12/16
                Dim bBilateralVsWorld As Boolean = False

                'check dimensions
                Do While rsListComp.Read
                    idx = ReadIdx(rsListComp("VarName"))
                    'jrs 2014/10/06
                    If rsList("History") Then
                        idx = POPidx
                    End If
                    If VDim1(idx) > 0 And MaxDimNum = 0 Then
                        MaxDimNum = 1
                        svIdx = idx
                    End If
                    'jrs 2025/12/10
                    If bBilateral Then
                        If VDim1(idx) = 1 And VDim2(idx) = 0 Then
                            bMonadic = True
                        End If
                    End If
                    If VDim1(idx) = 1 And VDim2(idx) = 1 Then
                        bBilateral = True
                        'jrs 2025/12/16
                        If rsListComp("Dim1") = "World" Or rsListComp("Dim2") = "World" Then
                            bBilateralVsWorld = True
                        End If
                    End If


                    CheckDims(bDim2, VDim2(idx), idx, IIf(IsDBNull(rsListComp("Dim2")), "", rsListComp("Dim2")),
                    sDim2, MaxDimNum, svIdx, IIf(IsDBNull(rsList("Param2")), "", rsList("Param2")), 2, True)
                    CheckDims(bDim3, VDim3(idx), idx, IIf(IsDBNull(rsListComp("Dim3")), "", rsListComp("Dim3")),
                    sDim3, MaxDimNum, svIdx, IIf(IsDBNull(rsList("Param3")), "", rsList("Param3")), 3, True)
                Loop
                rsListComp.Close()
                'jrs 2025/12/10
                'If both Bilateral and Monadic variables are used in the formula, set to Bilateral
                If bBilateral And bMonadic Then
                    bDim2 = True
                End If
                'jrs 2025/12/16
                If bBilateralVsWorld Then
                    bDim2 = True
                End If
            Else 'jrs 2007/10/19
                If idx < 1 Then
                    If rsList("History") Then 'jrs 2012/12/06
                        idx = POPidx
                    Else
                        'jrs 2023/06/15
                        PovLevel = 0
                        PovLevel2 = 0
                        checkPovertyVarName(rsList("VarName"), bPov, bPovPct, bPovFind, PovLevel, bIncR, PovLevel2, b2005PPP) 'jrs 2014/10/21 'jrs 2011/06/17 added bIncR as PovLevel2
                        If bPov Or bPovPct Or bPovFind Or bIncR Then 'jrs 2011/06/17 added or bIncR
                            idx = IfsVars.Item("INCOMELT125LN2005").Index
                        Else 'jrs 2010/05/13 check Mortality Prob
                            checkMortProbName(rsList("VarName"), bMortChl, bMortAdl)
                            If bMortChl Or bMortAdl Then
                                idx = IfsVars.Item("DEATHCAT").Index
                            End If
                        End If
                    End If

                    If idx > 0 Then
                        'check dimensions
                        If VDim1(idx) > 0 And MaxDimNum = 0 Then
                            MaxDimNum = 1
                            svIdx = idx
                        End If
                        CheckDims(bDim2, VDim2(idx), idx, IIf(IsDBNull(rsList("Param2")), "", rsList("Param2")), sDim2, MaxDimNum, svIdx, "", 2, False)
                        CheckDims(bDim3, VDim3(idx), idx, IIf(IsDBNull(rsList("Param3")), "", rsList("Param3")), sDim3, MaxDimNum, svIdx, "", 3, False)
                    End If
                End If
            End If
        Loop
        'if dimensions are different don't Load them, use the ones saved (except on Dim1).
        'jrs 2012/01/17 if previous variable had only one item in dimension 2 or 3, like death rates, it wouldn't remove from the next selection
        If MaxDimNum < 2 Then
            bDim2 = False
            bDim3 = False
        ElseIf MaxDimNum < 3 Then
            bDim3 = False
