    Public Sub CreateJSforFlexDisplays(ByVal ActiveBase As String, ByVal PutFdrvRun As String, ByRef CategoryIds As Collection)
        'jrs 2023/06/15
        UpdateVarListHdr(PutFdrvRun)

        Dim rsL As DataTable
        Dim sql As String
        'jrs 2025/06/11 added bNoTot2
        sql = "SELECT ListName, Dim1, Dim2, Dim3, bDim2, bDim3, bNoTot2 FROM VarListsHDR"
        If UCase(ActiveBase) = "IFSBASEHIST.RUN" Then
            sql = sql & " WHERE EXISTS (SELECT * FROM VarLists as L WHERE L.ListName = VarListsHDR.ListName " &
            "AND L.HistoryplusForecast = False)"
        Else
            sql = sql & " WHERE EXISTS (SELECT * FROM VarLists as L WHERE L.ListName = VarListsHDR.ListName " &
            "AND L.HisCompEmpFor = False)"
        End If
        'jrs 2023/01/11
        If UseOnlySQLite Then
            sql = sql & " ORDER BY UPPER(ListName)"
        Else
            sql = sql & " ORDER BY ListName"
        End If

        SetDataTablefromAccess(PutFdrvRun + "IFSVAR.mdb", sql, "", rsL)
        'jrs 2025/08/28
        Dim DimXListCount As Integer = rsL.Rows.Count

        Dim sJscript As String, i As Integer
        sJscript = "    var DimXList = [];" & vbCr
        For i = 0 To rsL.Rows.Count - 1
            sJscript = sJscript & "    DimXList[" & i.ToString & "] = new Array(" & DimStrBuilder(i, rsL) & ");" & vbCr
        Next
        'jrs 2019/03/27 added PriorityList
        sJscript = sJscript & vbCr & "    var CatXPriority = [];" & vbCr
        sql = "SELECT Category, PriorityList FROM VarLists"
        If UCase(ActiveBase) = "IFSBASEHIST.RUN" Then
            sql = sql & " WHERE HistoryplusForecast = False"
        Else
            sql = sql & " WHERE HisCompEmpFor = False"
        End If
        sql = sql & " AND Type = 'V' GROUP BY Category, PriorityList ORDER BY Category"
        SetDataTablefromAccess(PutFdrvRun + "IFSVAR.mdb", sql, "", rsL)

        Dim str As String, catrow As String, j As Integer, x As Object, y As Object, k As Integer

        i = 0
        j = 0

        Dim CatFilters As Collection = New Collection
        Dim CatNames As Collection = New Collection

        Do While True
            If j = rsL.Rows.Count Then Exit Do

            str = IIf(IsDBNull(rsL.Rows(j).Item("Category")), "", rsL.Rows(j).Item("Category"))
            x = Split(rsL.Rows(j).Item("Category"), ",")

            For i = 0 To UBound(x)
                If CatFilters.Contains(Trim(x(i))) Then
                    Dim s As String = CatFilters(Trim(x(i)))
                    Dim bFlag As Boolean = False
                    'jrs 2019/08/08 added isDBNull
                    y = Split(IIf(IsDBNull(rsL.Rows(j).Item("PriorityList")), "00", rsL.Rows(j).Item("PriorityList")), ",")
                    For k = 0 To UBound(y)
                        If Not CatFilters(Trim(x(i))).ToString.Contains(y(k)) Then
                            s = s & "," & y(k)
                            bFlag = True
                        End If
