    'jrs 2021/12/13
    'Algorithm designed by Caleb Petry
    'Merging without using Forced Migration Data, which was used in the original procedure generateMergedMigrationSeriesBilatPlusUNPD
    Public Sub generateMergedMigrationSeriesAbelPlusUNPD(ByVal IFs_MDB2Active As String, ByRef sMsg As String, ByVal PutFdrvRun As String, ByVal IFsHistSeries_MDB As String)
        '1.  Load the Abel data ("SeriesMigrationFlowOut") and the UNPD's  5-year data ("SeriesForecastNetMigrationMedUNPD2019Rev"), both unannualized
        '==================================================================================================================================
        SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " & Regionalization$ & " ORDER BY NewRegion", "", valtbl)

        '   Count countries and save names and region numbers
        '   -------------------------------------------------

        Dim ICount% = 0
        Dim CountryName() As String, CounReg() As Integer
        ReDim CountryName(NR * 2), CounReg(NR * 2)

        Do
            ICount% = ICount% + 1
            CountryName$(ICount%) = valtbl.Rows(ICount% - 1).Item("Country")
            CounReg(ICount%) = valtbl.Rows(ICount% - 1).Item("NewRegion")
            If IsDBNull(CounReg(ICount%)) Then
                Dim msg$ = "Fatal Error: " + CountryName$(ICount%) + " has no new region number"
                sMsg = msg$
                Stop
            End If

            If valtbl.Rows.Count = ICount% Then Exit Do
        Loop

        Dim CCount As Integer
        CCount = ICount

        Dim CXDYADMIGRANT(,) As Object
        ReDim CXDYADMIGRANT(CCount, CCount)

        Dim migTbl As DataTable
        SetDataTablefromAccess(PutFdrvRun$ + "IFsHistSeriesDyadic.db", "SELECT * FROM SeriesMigrationFlowOut ORDER BY Actor, Partner", "", migTbl)

        Dim AbelGrossIn(), AbelGrossOut()
        ReDim AbelGrossIn(CCount), AbelGrossOut(CCount)
        ICount = 0
        Dim i As Integer, j As Integer, YrIdx As Integer, sYr As String
        Dim YrsCount As Integer
        '2.  Identify the most recent year (2020 at present) in the Abel data series
        If IsNumeric(migTbl.Columns(migTbl.Columns.Count - 1).ColumnName) Then
            YrIdx = migTbl.Columns.Count - 1
            YrsCount = migTbl.Columns.Count - 4
        Else
            YrIdx = migTbl.Columns.Count - 3
            YrsCount = migTbl.Columns.Count - 6
        End If
        sYr = migTbl.Columns(YrIdx).ColumnName
        i = 1
        j = 1
        Dim sYrsMig0 As String
        sYrsMig0 = migTbl.Columns(4).ColumnName

        'Dim k As Integer

        'Dim YrsFrom5 As Integer
        Do While ICount < migTbl.Rows.Count
            'Check Index for actor
            Do While Trim(migTbl.Rows(ICount).Item("Actor")) > CountryName(i) And i < CCount
                i = i + 1
                j = 1
            Loop
            'Check Index for partner
            Do While Trim(migTbl.Rows(ICount).Item("Partner")) > CountryName(j) And j < CCount
                j = j + 1
            Loop
            CXDYADMIGRANT(i, j) = migTbl.Rows(ICount).Item(YrIdx)
            ICount = ICount + 1
        Loop

        '3.  Calculate net migration for the Abel data in that year; this code largely already exists, but we would not want to divide by 5 now
        For i = 1 To CCount
            For j = 1 To CCount
                If i <> j Then
                    If Not IsDBNull(CXDYADMIGRANT(i, j)) Then
                        AbelGrossIn(j) = AbelGrossIn(j) + CXDYADMIGRANT(i, j)
                        AbelGrossOut(i) = AbelGrossOut(i) + CXDYADMIGRANT(i, j)
                    End If
                End If
            Next j
        Next i

        Dim AbelNet(), RatioAbelToUNPD()
        ReDim AbelNet(CCount), RatioAbelToUNPD(CCount)

        'Dim SUMIM, SUMEM
        For i = 1 To CCount
            AbelNet(i) = AbelGrossIn(i) - AbelGrossOut(i)
        Next i

        '4.  Calculate the ratio of net Abel over UNPD by country for that year and temporarily save them; These values should be close to 1 for most countries.
        Dim UNPDTbl As DataTable
        SetDataTablefromAccess(IFsHistSeries_MDB, "SELECT * FROM SeriesForecastNetMigrationMedUNPD2019Rev ORDER BY Country", "", UNPDTbl)

        ICount = 0
        i = 0
        Do While ICount < UNPDTbl.Rows.Count
            i = i + 1
            '5.  Note: There are zeros in the UNPD data. In those instances, we should assign an arbitrary value of 1 in this process and consider replacing them with a small seed value later if so desired.
            If Not IsDBNull(UNPDTbl.Rows(ICount).Item("" & sYr & "")) AndAlso UNPDTbl.Rows(ICount).Item("" & sYr & "") <> 0 Then
                RatioAbelToUNPD(i) = AbelNet(i) / 1000000 / UNPDTbl.Rows(ICount).Item("" & sYr & "")
            Else
                RatioAbelToUNPD(i) = 1
            End If
            ICount = ICount + 1
        Loop

        '6.  Multiply the annualized UNPD data ("SeriesForecastNetMigrationUNPD") values by their country's ratio in each year and save as the merged data series ("SeriesNetMigrationMergedUNPDAbel")
        '================================================================================================================================================
        SetDataTablefromAccess(IFsHistSeries_MDB, "SELECT * FROM SeriesForecastNetMigrationUNPD ORDER BY Country", "", UNPDTbl)

        ICount = 0
        'Save Base Year
        '---------------
        Dim TargetTbl As DataTable
        SetDataTablefromAccess(IFsHistSeries_MDB, "SELECT * FROM SeriesForecastNetMigrationMergedUNPDAbel ORDER BY Country", "", TargetTbl)

        Dim IFsConnT As SQLiteConnection = New SQLiteConnection("DataSource=" & IFsHistSeries_MDB & ";")
        IFsConnT.Open()
        Dim IFsCmdT As SqliteCommand = IFsConnT.CreateCommand

        i = 0
        Dim sUpd As String
        Dim dyadVal As Single
        Do While ICount < UNPDTbl.Rows.Count
            i = i + 1
            sUpd = "UPDATE SeriesForecastNetMigrationMergedUNPDAbel SET [" & sYr & "] = "
            If Not IsDBNull(UNPDTbl.Rows(ICount).Item("" & sYr & "")) Then
                dyadVal = UNPDTbl.Rows(ICount).Item("" & sYr & "") * RatioAbelToUNPD(i)
                sUpd = sUpd & dyadVal.ToString
                sUpd = sUpd & ", MostRecent = " & dyadVal.ToString
            Else
                sUpd = sUpd & "Null"
                sUpd = sUpd & ", MostRecent = Null"
            End If

            'Save previous years
            '--------------------
            dyadVal = -9999
            For j = CInt(sYr) - 1 To UNPDTbl.Columns(2).ColumnName Step -1
                If j < CInt(TargetTbl.Columns(2).ColumnName) Then
                    Exit For
                End If

                If Not IsDBNull(UNPDTbl.Rows(ICount).Item("" & j.ToString & "")) Then
                    dyadVal = UNPDTbl.Rows(ICount).Item("" & j.ToString & "") * RatioAbelToUNPD(i)
                    sUpd = sUpd & ", [" & j.ToString & "] = " & dyadVal.ToString
                Else
                    sUpd = sUpd & ", [" & j.ToString & "] = Null"
                End If

            Next j

            If dyadVal <> -9999 Then
                sUpd = sUpd & ", [Earliest] = " & dyadVal.ToString
            Else
                sUpd = sUpd & ", [Earliest] = Null"
            End If

            'Save next years
            '--------------------
            dyadVal = -9999
            For j = CInt(sYr) + 1 To UNPDTbl.Columns(UNPDTbl.Columns.Count - 3).ColumnName
                If j > CInt(TargetTbl.Columns(TargetTbl.Columns.Count - 3).ColumnName) Then 'jrs 2021/07/28 should be using TargetTbl
                    Exit For
                End If

                If Not IsDBNull(UNPDTbl.Rows(ICount).Item("" & j.ToString & "")) Then
                    dyadVal = UNPDTbl.Rows(ICount).Item("" & j.ToString & "") * RatioAbelToUNPD(i)
                    sUpd = sUpd & ", [" & j.ToString & "] = " & dyadVal.ToString
                Else
                    sUpd = sUpd & ", [" & j.ToString & "] = Null"
                End If

            Next j

            sUpd = sUpd & " WHERE Country = """ & UNPDTbl.Rows(ICount).Item("Country") & """"

            IFsCmdT.CommandText = sUpd
            IFsCmdT.ExecuteNonQuery()

            ICount = ICount + 1
        Loop

        '7. Calculate the rates; Should be the same process as the existing code
        '=======================================================================

        'Convert to Rate using some population forecast
        '-----------------------------------------------
        'Open Population table
        Dim poptbl As DataTable
        'jrs 2021/07/22 Set poptbl = dbHis.OpenRecordset("SeriesForecastPopulationBothSexesMediumUNPD2017Rev")
        SetDataTablefromAccess(IFsHistSeries_MDB, "SELECT * FROM SeriesForecastPopulationUNPDMed ORDER BY Country", "", poptbl)

        ICount = 0

        'Dim TargetRateTbl As DataTable
        'SetDataTablefromAccess(IFsHistSeries_MDB, "SELECT * FROM SeriesForecastNetMigrationRateMergedUNPDAbel ORDER BY Country", "", TargetRateTbl)
        SetDataTablefromAccess(IFsHistSeries_MDB, "SELECT * FROM SeriesForecastNetMigrationMergedUNPDAbel ORDER BY Country", "", TargetTbl)

        Do While ICount < TargetTbl.Rows.Count
            sUpd = "UPDATE SeriesForecastNetMigrationRateMergedUNPDAbel SET "
            'for all years
            For j = CInt(TargetTbl.Columns(2).ColumnName) To CInt(TargetTbl.Columns(TargetTbl.Columns.Count - 3).ColumnName)
                If j > CInt(TargetTbl.Columns(2).ColumnName) Then
                    sUpd = sUpd & ", "
                End If
                sUpd = sUpd & "[" & j.ToString & "] = "

                If Not IsDBNull(TargetTbl.Rows(ICount).Item("" & CStr(j) & "")) AndAlso Not IsDBNull(poptbl.Rows(ICount).Item("" & CStr(j) & "")) AndAlso poptbl.Rows(ICount).Item("" & CStr(j) & "") <> 0 Then
                    dyadVal = TargetTbl.Rows(ICount).Item("" & CStr(j) & "") / poptbl.Rows(ICount).Item("" & CStr(j) & "") * 100
                    sUpd = sUpd & dyadVal.ToString
                Else
                    dyadVal = Nothing
                    sUpd = sUpd & "Null"
                End If

            Next j

            sUpd = sUpd & " WHERE Country = """ & TargetTbl.Rows(ICount).Item("Country") & """"

            IFsCmdT.CommandText = sUpd
            IFsCmdT.ExecuteNonQuery()

            ICount = ICount + 1
        Loop

        IFsConnT.Close()
        IFsConnT.Dispose()


        Dim msg2$ = "Process completed IFsHistSeries.DB, has been copied from RUNFILES TO DATA."
        'jrs 2024/10/14 FileCopy(PutFdrvRun$ + "IFsHistSeries.mdb", DataFileDir$ + "IFsHistSeries.mdb")
        FileCopy(PutFdrvRun$ + "IFsHistSeries.db", DataFileDir$ + "IFsHistSeries.db")
        sMsg = msg2$

    End Sub

