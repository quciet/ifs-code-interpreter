    'jrs 2006/10/19 Function to compute formulas
    'jrs 2008/07/11
    'jrs 2008/09/12 added iOffsetPosition
    Public Sub ComputeFormulas(ByRef f As Formula, ByVal iTotYears As Integer, ByVal iFirstYear As Integer,
    ByRef data As Object, ByVal idx As Integer, ByRef TargetVector As Object, ByVal gHistoricAnalog As Boolean,
    ByRef aFormulas As Object, ByRef myPage As Page, ByVal iOffsetPosition As Integer)

        Dim d1 As Short
        Dim start As Short
        Dim X As Short
        Dim CT As Object
        Dim V As Short

        On Error GoTo CompHandler

        If f.disVar Is Nothing Then
            V = 0
            CT = 0
        Else
            V = f.disVar.disSize
            Dim vv As Integer
            CT = 0
            For vv = 1 To V
                If f.disVar.displayDet(vv) = "" Then
                    CT = CT + 1
                End If
            Next vv
        End If

        If CT = 0 And V > 0 Then
            'VALIDATE DIMENSIONS
            ValidateDims(f)
            'Sets the maximum number of data per variable
            'jrs 2008/07/11 f.itotYears = iLastYear - iFirstYear + 1
            f.itotYears = iTotYears

            d1 = f.begAll
            'Loads numerical data into an internal array
            'but still without specifing to which node it belongs
            f.LoadNumData(data)
            d1 = d1 + 1
            'Computes formula and load result into its destination
            LoadData(f, idx, TargetVector, iFirstYear, iOffsetPosition)
            If Not gHistoricAnalog Then
                If UBound(aFormulas) = 1 And (idx = NR Or idx = GCount) Then 'jrs 2006/02/02
                    start = 1
                Else
                    start = idx
                End If
                If idx > UBound(aFormulas) Then
                    ReDim Preserve aFormulas(idx)
                End If
                'f.Name = lblFormulaName.Text
                'f.Dimension = lblDimensionality.Text
                'f.Unit = lblUnits.Text
                For X = start To idx
                    aFormulas(X) = f
                Next X
            End If
        End If

        f = Nothing


        Exit Sub

CompHandler:
        _logger.Error(Err.GetException, "ComputeFormulas - exception")
        Dim frm_msg As New frm_Message
        frm_msg.LoadMessage(Err.Description)
        Support.FormManager.StateStore(myPage)
        Support.FormManager.Show(myPage, "frm_Message.aspx")

    End Sub

    'jrs 2006/10/19
    Private Sub ValidateDims(ByRef f As Formula)
        Dim iii As Integer
        'jrs 2025/12/10
        Dim bBilateral As Boolean = False
        Dim bMonadic As Boolean = False
        Dim sVar As String
        Dim idx, pos As Integer
        Dim sActor As String = ""
        Dim sPartner As String = ""

        If f.Dimension > "" Then

            For iii = 1 To f.disVar.disSize
                'jrs 2025/12/10 
                sVar = f.disVar.displayDet(iii)
                pos = sVar.IndexOf("[")
                If pos > 0 Then
                    sVar = sVar.Substring(0, pos).Trim()
                End If
                idx = IfsVars.Item(sVar).Index
                If idx > 0 Then
                    If VDim1(idx) = 1 And VDim2(idx) = 1 Then
                        bBilateral = True
                        If sActor = "" Then
                            sActor = f.disVar.displayDet1(iii)
                            sPartner = f.disVar.displayDet2(iii)
                        End If
                    End If
                    If VDim1(idx) = 1 And VDim2(idx) = 0 Then
                        bMonadic = True
                    End If
                End If
                'jrs 2017/05/15 added And f.disVar.displayDet1(iii) <> "World"
                'jrs 2012/11/09 added And f.disVar.displayDet1(iii) > ""
                If InStr(f.disVar.displayDet1(iii), f.Dimension) = 0 And f.disVar.displayDet1(iii) > "" And f.disVar.displayDet1(iii) <> "World" Then
                    If Not (bBilateral And bMonadic) Then
                        'jrs 2025/12/15 don't clear it when it's bilateral(a,b)+bilateral(b,a)
                        If Not (bBilateral And sPartner = f.disVar.displayDet1(iii)) Then
                            f.Dimension = ""
                            Exit For
                        End If
                    End If
                End If
            Next iii
        End If
        If f.Dimension2 > "" Then
            For iii = 1 To f.disVar.disSize
                'jrs 2006/08/21 XS, USA, Energy/GDP, USA * 1000 should keep Energy as sec dimension
                'only remove dim when there's to different values, don't consider blancs
                If f.disVar.displayDet2(iii) > "" Then
                    If InStr(f.disVar.displayDet2(iii), f.Dimension2) = 0 Then
                        'jrs 2025/12/16 added and f.disVar.displayDet2(iii) <> "World"
                        'jrs 2025/12/15 don't clear it when it's bilateral(a,b)+bilateral(b,a)
                        If Not (bBilateral And sActor = f.disVar.displayDet2(iii)) And
                            Not (bBilateral And f.disVar.displayDet2(iii) = "World") Then
                            f.Dimension2 = ""
                            Exit For
                        End If
                    End If
                End If
            Next iii
        End If
        If f.Dimension3 > "" Then 'jrs 2006/05/24 Dim3
            For iii = 1 To f.disVar.disSize
                'jrs 2006/08/21
                'only remove dim when there's to different values, don't consider blancs
                If f.disVar.displayDet3(iii) > "" Then
                    If InStr(f.disVar.displayDet3(iii), f.Dimension3) = 0 Then
                        f.Dimension3 = ""
                        Exit For
                    End If
                End If
            Next iii
        End If
    End Sub


    'jrs 2006/10/19
    Private Sub LoadData(ByRef f As Formula, ByVal idx As Integer, ByRef TargetVector As Object,
    ByVal FirstYear As Integer, ByVal iOffSetPosition As Integer) 'jrs 2008/09/12 added iOffsetPosition
        'jrs 2008/01/29
        f.FirstYear = FirstYear

        Dim k As Short

        Dim finCalc As Object
        finCalc = f.RetrArr(f.disRoot)

        For k = 1 To f.itotYears
            'jrs 2008/09/12
            If TargetVector.Rank = 1 Then
                TargetVector(k + iOffSetPosition) = finCalc(k)
            Else
                TargetVector(k + iOffSetPosition, idx) = finCalc(k)
            End If
