    Public Function CreateFormulaText(ByVal i3 As Integer, ByVal BPoints As Object, ByVal APoint As Object) As String
        Dim sFormula As String
        If BPoints(i3%, 9) <> 0 Then
            sFormula = CStr(Round(BPoints(i3%, 9), 4)) & "/(1 + exp("
        End If
        If APoint(i3%) <> 0 Then
            sFormula = sFormula & CStr(Round(APoint(i3%), 4))
        End If
        If BPoints(i3%, 1) > 0 Then
            sFormula = sFormula & " + " & CStr(Round(BPoints(i3%, 1), 4)) & "*X"
        ElseIf BPoints(i3%, 1) < 0 Then
            sFormula = sFormula & " - " & CStr(Abs(Round(BPoints(i3%, 1), 4))) & "*X"
        End If
        If BPoints(i3%, 2) > 0 Then
            sFormula = sFormula & " + " & CStr(Round(BPoints(i3%, 2), 4)) & "*X^2"
        ElseIf BPoints(i3%, 2) < 0 Then
            sFormula = sFormula & " - " & CStr(Abs(Round(BPoints(i3%, 2), 4))) & "*X^2"
        End If
        If BPoints(i3%, 3) > 0 Then
            sFormula = sFormula & " + " & CStr(Round(BPoints(i3%, 3), 4)) & "*X^3"
        ElseIf BPoints(i3%, 3) < 0 Then
            sFormula = sFormula & " - " & CStr(Abs(Round(BPoints(i3%, 3), 4))) & "*X^3"
        End If
        If BPoints(i3%, 4) > 0 Then
            sFormula = sFormula & " + " & CStr(Round(BPoints(i3%, 4), 4)) & "*Log(X)"
        ElseIf BPoints(i3%, 4) < 0 Then
            sFormula = sFormula & " - " & CStr(Abs(Round(BPoints(i3%, 4), 4))) & "*Log(X)"
        End If
        If BPoints(i3%, 5) > 0 Then
            sFormula = sFormula & " + " & CStr(Round(BPoints(i3%, 5), 4)) & "*X^(" & CStr(Round(BPoints(i3%, 6), 4)) & ")"
        ElseIf BPoints(i3%, 5) < 0 Then
            sFormula = sFormula & " - " & CStr(Abs(Round(BPoints(i3%, 5), 4))) & "*X^(" & CStr(Round(BPoints(i3%, 6), 4)) & ")"
        End If
        If BPoints(i3%, 7) > 0 Then
            sFormula = sFormula & " + " & CStr(Round(BPoints(i3%, 7), 4)) & "*exp(" & CStr(Round(BPoints(i3%, 8), 4)) & "*X)"
        ElseIf BPoints(i3%, 7) < 0 Then
            sFormula = sFormula & " - " & CStr(Abs(Round(BPoints(i3%, 7), 4))) & "*exp(" & CStr(Round(BPoints(i3%, 8), 4)) & "*X)"
        End If
        If BPoints(i3%, 9) <> 0 Then
            sFormula = sFormula & "))"
        End If
        CreateFormulaText = sFormula
    End Function

