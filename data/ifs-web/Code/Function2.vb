                                                                            FilesCol.Remove("FileForDisplay" + CStr(fileIdx))
                                                                            FilesCol.Add(MyFileforDisplay, "FileForDisplay" + CStr(fileIdx))
                                                                        End If
                                                                        If dfCol("df" + sVar + CStr(fileIdx)) Is Nothing Then
                                                                            dfCol.Remove("df" + sVar + CStr(fileIdx))
                                                                            dfCol.Add(MyDF, "df" + sVar + CStr(fileIdx))
                                                                        End If

                                                                        Debug.WriteLine("gLoadPackage before gLoadForDisplaySaveLbls")
                                                                        gLoadForDisplaySaveLbls(COUNTE, idxVar, Dim1, Dim2, Dim3, bGrp, fileIdx, sTitle,
                                                                        SensitivityFlag, ShortSce, CurrencySym, VARN, GR1N, GR2N, GR3N, GR4N,
                                                                        FDNG1, FDNG2, FDNG3, FDNG4)
                                                                        'jrs 2014/04/03
                                                                        'Update FinYear in case reading all Historic data
                                                                        If UCase(ActiveBase) = "IFSBASEHIST.RUN" And iRowPosition > 1 Then
                                                                            FinYear(COUNTE) = FinYear(COUNTE) + iRowPosition - 1
                                                                            StaYearHis(COUNTE) = FirstYearHistory - iRowPosition + 1
                                                                            'jrs 2017/12/07
                                                                            LastCompareForecastIdx = COUNTE
                                                                            'ElseIf iRowPosition > 1 Then 'jrs 2017/12/07 needed if doing forecast by others in previous column
                                                                            '    FinYear(COUNTE) = FinYear(COUNTE) + iRowPosition - 1
                                                                            '    StaYearHis(COUNTE) = FirstYearForecast - iRowPosition + 1
                                                                        End If
                                                                    End If
                                                                End If
                                                            End If
                                                            bFirst = False
                                                            'jrs 2026/01/22 added: and not bIncR and not bPov and not bPovPct and not bPovFind and not bMortChl and not bMortAdl
                                                            'jrs 2018/12/13 added and not rs.Rows(idx).Item("History") *** comparing history plus forecast vs hist empirical variables
                                                            'jrs 2012/10/25 added and Not rs.Fields("CompareOtherForecast")
                                                            'jrs 2005/08/18
                                                            If rs.Rows(idx).Item("HistoryplusForecast") And Not rs.Rows(idx).Item("Formula") And Not rs.Rows(idx).Item("CompareOtherForecast") And Not rs.Rows(idx).Item("History") And
                                                            Not bIncR And Not bPov And Not bPovPct And Not bPovFind And Not bMortChl And Not bMortAdl Then
                                                                FinAll = FinYear(COUNTE)
                                                                'jrs 2012/11/09
                                                                If VDim1(idxVar) = 0 And Dim1 = "" Then
                                                                    Dim1 = GRPS(1, 1)
                                                                End If
                                                                'jrs 2026/01/26 added or VDim1(idxVar) <> 1
                                                                'jrs 2025/11/18 added and Dim1=""
                                                                'jrs 2025/11/06
                                                                If (IsDBNull(VHistoricAnalog(idxVar)) And Dim1 = "") Or
                                                                    VDim1(idxVar) <> 1 Then
                                                                    Dim1 = GRPS(1, 1)
                                                                End If

                                                                'jrs 2006/06/06 FirstYear = FirstYearHistory
                                                                'jrs 2006/06/08 lastyearhistory - 1 in order to keep forecasted values in year 2000 instead of historic ones
                                                                gLoadForDisplayHis(sVar, Dim1, -1, Dim2, -1, Dim3, -1,
                                                            bGrp, 1, PLOT, COUNTE, iFirstYearH, LastYearHistory - 1,
                                                            False, True, bFillHis, buseAllHis, FinYearHis(COUNTE),
                                                            bLoadForDisplaySuccess, currPage, FinYear, LastYear,
                                                            LastYearForecast, bComputation, "", "", IfsPars, bFillHisOnlyHoles,
                                                            False, Nothing, StaYearHis, vmnuSQLITE)
                                                                'jrs 2014/03/28
                                                                If StaYearHis(COUNTE) > 0 And StaYearHis(COUNTE) < FirstYearHistory Then
                                                                    FinYear(COUNTE) = LastYearHistory - StaYearHis(COUNTE) + FinAll 'jrs 2006/09/22
                                                                Else
                                                                    FinYear(COUNTE) = LastYearHistory - FirstYearHistory + FinAll 'jrs 2006/09/22
                                                                End If
                                                                'jrs 2017/12/07
                                                                If StaYearHis(COUNTE) > 0 Then
                                                                    LastCompareForecastIdx = COUNTE
                                                                End If
                                                            End If
                                                            'jrs 2023/05/29
                                                            'jrs 2010/11/03
                                                            If COUNTE <= MaxVariables Then
                                                                'jrs 2006/11/20
                                                                sUsrDefCats(COUNTE) = sUsrDefCat
                                                            End If
                                                        End If
                                                        'jrs 2021/03/18 too long for general displays, example MFPCOR
                                                        'Adding DispUnits array would take changing Clear, which implies lots of changes
                                                        'so we'll wait until is reported as needed
                                                        'added and GR4N = "" to use this only when there's nothing else

                                                        ''jrs 2016/03/28
                                                        If Not IsDBNull(rs.Rows(idx).Item("DisplayUnits")) And GR4N(COUNTE) = "" Then
                                                            GR4N(COUNTE) = rs.Rows(idx).Item("DisplayUnits")
                                                            FDNG4(COUNTE) = rs.Rows(idx).Item("DisplayUnits")
                                                        End If

                                                        'jrs 2006/02/15 'jrs 2006/04/19 tst
                                                        If Not bLoadForDisplaySuccess Then
                                                            If COUNTE > UBound(PLOT, 2) Then
                                                                COUNTE = COUNTE - 1
                                                                msg = "There is not enough room in the PLOT vector for display, please use a smaller number of options with this list."
                                                                frm_msg.LoadMessage(msg)
                                                                Support.FormManager.StateStore(currPage)
                                                                Support.FormManager.Show(currPage, "frm_Message.aspx")
                                                            End If
                                                        End If
                                                        'jrs 2014/03/21
                                                        'Do historical variables only once
                                                        'no need to repeat for every scenario
                                                        If rs.Rows(idx).Item("History") Then
                                                            Exit For
                                                        End If

                                                    Next 'jrs 2011/11/04 fileIdx
                                                    'jrs 2012/04/26
                                                    'if it doesn't have 3 dimensions, exit loop
                                                    If DimNum < 3 Then Exit For
                                                End If
                                            Next DimIdx3

                                            'jrs 2025/06/12 added Glist to 2nd dimension, and not rsGL2 is nothing
                                            If (bUseGList Or bUseGroupDec Or bUseCtryGrpDec) And lstDim2.Visible And Not (rsGL2 Is Nothing) Then
                                                iGL2 = iGL2 + 1
                                                'jrs 2025/06/12 avoid Country x Country in Bilateral
                                                If iGL2 < rsGL2.Rows.Count AndAlso rsGL2.Rows(iGL2).Item("Region") = Dim1 Then
                                                    iGL2 = iGL2 + 1
                                                End If

                                                If rsGL2.Rows.Count <= iGL2 Then
                                                    Exit Do
                                                End If
                                            Else
                                                Exit Do
                                            End If

                                        Loop

                                        'jrs 2012/04/26
                                        'if it doesn't have 2 dimensions, exit loop
                                        If DimNum < 2 Then Exit For
                                    End If
                                    'jrs 2023/09/20
                                    'Next DimIdx2
                                Next Location2

                                'jrs 2025/05/30 added or bUseCtryGrpDec
                                'jrs 2010/11/19 adding and Dim.Visible to avoid problems w/list w/o dims (CO2)
                                'jrs 2008/01/24 moved GList loop out of DimIdx2 and DimIdx3 loops
                                'problems when selecting more than 1 dim2s
                                'jrs 2006/01/18 GList
                                If (bUseGList Or bUseGroupDec Or bUseCtryGrpDec) And lstDim.Visible Then 'jrs 2008/09/04 GroupDec
                                    iGL = iGL + 1
                                    'jrs 2025/06/12 avoid Country x Country in Bilateral
                                    If iGL < rsGL.Rows.Count AndAlso rsGL.Rows(iGL).Item("Region") = lstDim2.SelectedValue Then
                                        iGL = iGL + 1
                                    End If

                                    If rsGL.Rows.Count <= iGL Then
                                        Exit Do
                                    End If
                                Else
                                    Exit Do
                                End If
                                'jrs 2012/04/26
                                'if it doesn't have 1 dimensions, exit loop
                                If DimNum < 1 Then Exit Do
                            Loop 'jrs 2006/01/18 GList
                            'jrs 2012/04/26
                            'if it doesn't have 1 dimensions, exit loop
                            If DimNum < 1 Then Exit For
                        End If
                        'jrs 2012/12/05 Next DimIdx 'jrs 2006/01/12
                    Next Location
                    idx = idx + 1
                Else 'jrs 2017/03/28 if it's another list, exit rs loop and go to next VarList
                    Exit Do
                End If
            Loop
        Next Pack

        'dsb 2025/09/01
        If rs.Rows(0).Item("HistoryplusForecast") Then
            'dsb 2025/11/13 adjust the Firstyear if viewing all historical available data
            Dim y As Integer
            If buseAllHis Then
                For y = 1 To COUNTE
                    If StaYearHis(y) > 0 Then
                        If StaYearHis(y) < FirstYear Then
                            FirstYear = StaYearHis(y)
                            Exit For
                        End If
                    End If
                    'FirstYear = 1950
                Next
            End If
            Dim vData As Integer
            Dim firstYearCheck As Boolean = False
            For y = 1 To LastYear - FirstYear + 1
                For vData = 1 To COUNTE
                    'jrs 2025/09/16 replace "and" with "andalso"
                    If Not IsNothing(PLOT(y, vData)) AndAlso PLOT(y, vData).ToString().Trim() <> "{}" AndAlso PLOT(y, vData).ToString().Trim() <> "" Then
                        diff = y
                        firstYearCheck = True
                    End If
                    If firstYearCheck Then
                        y = LastYear - FirstYear + 1
                        vData = COUNTE 'dsb 2025/09/08
                    End If
                Next
            Next
            If Not diff = 1 Then
                i = 1
                For y = diff To LastYear - FirstYear + 1
                    For vData = 1 To COUNTE
                        PLOT(i, vData) = PLOT(y, vData)
                    Next
                    i = i + 1
                    'PLOT(FirstYear, vData) = PLOT(y, vData)
                Next
                FirstYear = FirstYear + diff - 1

                For j = 1 To COUNTE
                    FinYear(j) = FinYear(j) - diff + 1
                    If StaYearHis(j) > 0 Then StaYearHis(j) = StaYearHis(j) + diff - 1 'dsb 2025/11/18
                Next
            End If
        End If
    End Sub

    'jrs 2024/11/25
    'This a copy of gLoadPackage, but the idea is not to save to the Target array, but instead to save a Target File without
    'Limit in the number of variables, originally designed to download NR*NR, all dyads for THREAT
    'and maybe for several scenarios at a time, but I think it'll be enough one scenario at a time
    'This will not work well with All available history where the starting year for each variable might be different
    'This is because we will be saving/writing each variable sequentially and there won't be a chance to adjust the position after the initial saving
    Public Sub gSavePackage(ByRef rs As DataTable, ByRef COUNTE As Integer, ByRef currPage As System.Web.UI.Page,
    ByVal ActiveBase As String, ByRef FirstYear As Integer, ByRef LastYear As Integer, ByVal LastYearForecast As Integer,
    ByRef oldFirstYear As Integer, ByRef oldLastYear As Integer, ByVal IFs_MDB2Active As String, ByRef lstDim As ListBox,
    ByRef lstDim2 As ListBox, ByRef lstDim3 As ListBox, ByRef lstFiles As ListBox, ByRef slstPacks_SelValue As String,
    ByRef DimIdxs As Object, ByRef DimIdxs2 As Object, ByRef DimIdxs3 As Object,
    ByRef bUseGroup As Object, ByRef bUseGroupDec As Boolean, ByRef bUseGList As Boolean, ByRef bUseCtryGrp As Boolean, ByRef bUseCtryGrpDec As Boolean, ByVal SelIdx As Integer,
    ByRef AllDimsIdx As Object, ByVal bIntercept As Boolean, ByRef PDFilesIdxs As Object, ByRef PLOT As Object,
    ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object,
    ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object,
    ByRef FinYear As Object, ByRef FinYearHis As Object, ByRef buseAllHis As Boolean, ByRef bFillHis As Boolean, ByRef bFillHisOnlyHoles As Boolean,
    ByRef StaYearHis As Object, ByRef YAxisLabel As String, ByRef XAxisLabel As String, ByRef aFormulas As Object, ByRef bComputation As Boolean,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef FileforDisplay As Object, ByRef IfsPars As myParameters,
    ByVal PutFdrvRun As String, ByRef MaxFinYearHis As Object, ByRef FileNumbr As Object, ByRef RunFiles As Object,
    ByRef ShortSce As Object, ByRef CurrencyVal As Object, ByRef CurrencySym As String, ByRef SensitivityFlag As Object,
    ByRef PopMales As Object, ByRef PopFemales As Object, ByRef sListNames As String, ByRef sUsrDefCats As Object, Optional ByVal sOrdFiles As String = "",
    Optional ByVal sOrdDims As String = "", Optional ByVal sOrdDims2 As String = "", Optional ByVal sOrdPacks As String = "", Optional ByRef lstPacks As ListBox = Nothing,
    Optional ByRef dfCol As Collection = Nothing,
    Optional ByRef FilesCol As Collection = Nothing, Optional vmnuSQLITE As Object = "False", Optional OnlyCoreGroups As Object = 0,
    Optional ByRef IFsRunFiles As Object = Nothing,
    Optional ByVal DisYear As Integer = 20,
    Optional ByRef Context As HttpContext = Nothing) 'jrs 2024/04/25 added IFsRunFiles 'cdv 2021/09/01 Added Optional Argument for CoreGroups

        _logger.Debug("gSavePackage")

        'jrs 2006/04/18
        Dim bGrp As Object, FinAll As Integer
        Dim sDef As String, sUn As String
        Dim msg As String
        Dim frm_msg As New frm_Message
        'jrs 2012/12/14
        Dim SelIdx2 As Integer
        'jrs 2025/03/11
        Dim DisYearHF As Integer = 0

        'jrs 10/31/04
        If rs.Rows.Count = 0 Then
            COUNTE = 0
            msg = "Variable doesn't exist!"
            frm_msg.LoadMessage(msg)
            Support.FormManager.StateStore(currPage)
            'jrs 2024/11/22 added "~/" to .Show
            Support.FormManager.Show(currPage, "~/frm_Message.aspx")
        End If

        oldLastYear = LastYear
        oldFirstYear = FirstYear

        Dim fileIdx As Integer
        Dim DimIdx As Integer 'jrs 2006/01/12
        Dim DimIdx2 As Integer 'jrs 2006/01/15
        Dim DimIdx3 As Integer 'jrs 2006/06/20
        Dim PackIdx As Integer 'jrs 2017/03/24
        Dim Dim1 As String
        Dim Dim2 As String
        Dim Dim3 As String
        Dim sVar As String
        Dim sTitle As String
        Dim bFirst As Boolean
        bFirst = True
        Dim idx = 0
        Dim idxVar As Integer
        'jrs 2008/01/28 long Formulas (Indices)
        Dim sFormulaDet As String
        Dim rsFormulaDet As DataTable
        Dim sqlFDet As String
        'jrs 2012/10/25
        Dim iRowPosition As Integer, iFirstYear As Integer, iLastYear As Integer
        'jrs 2014/03/27
        Dim iFirstYearH As Integer
        Dim i As Integer, diff As Integer
        'jrs 2017/12/07
        Dim LastCompareForecastIdx As Integer
        LastCompareForecastIdx = 1

        'jrs 2005/11/09
        If UCase(ActiveBase) = "IFSBASEHIST.RUN" And rs.Rows(0).Item("HistoryplusForecast") Then
            msg = "Can't Load Package for History Plus Forecast when using History."
            frm_msg.LoadMessage(msg)
            Support.FormManager.StateStore(currPage)
            Support.FormManager.Show(currPage, "frm_Message.aspx")
        End If

        'jrs 2006/06/06 set up years
        If rs.Rows(0).Item("HistoryplusForecast") Then
            FirstYear = FirstYearHistory
        ElseIf rs.Rows(0).Item("History") Then
            FirstYear = FirstYearHistory
            LastYear = LastYearHistory
        End If

        'jrs 2019/02/11
        Dim bCompareOtherFor1vsIFs2 As Boolean
        'jrs 2023/10/30 added cbool
        'jrs 2012/12/05
        If CBool(rs.Rows(0).Item("CompareOtherForecast")) Then
            'check if later comes a regular variable
            idx = 1
            Do While Not rs.Rows.Count = idx
                'jrs 2023/10/25 added Cbool
                If Not CBool(rs.Rows(idx).Item("CompareOtherForecast")) Then
                    'jrs 2023/10/30 added Cbool
                    'jrs 2019/02/11
                    If Not CBool(rs.Rows(idx).Item("HistoryplusForecast")) Then
                        bCompareOtherFor1vsIFs2 = True
                    End If

                    If ActiveBase = "IFSBASE.RUN" Then
                        FirstYear = FirstYearForecast
                        LastYear = LastYearForecast
                    Else
                        FirstYear = FirstYearHistory
                        LastYear = LastYearHistory
                    End If

                    'jrs 2023/10/30 added cbool
                    If CBool(rs.Rows(idx).Item("HistoryplusForecast")) Then
                        FirstYear = FirstYearHistory
                    ElseIf CBool(rs.Rows(idx).Item("History")) Then
                        FirstYear = FirstYearHistory
                        LastYear = LastYearHistory
                    End If

                    Exit Do
                End If
                idx = idx + 1
            Loop
            idx = 0
        End If


        'jrs 2006/01/18 GList
        Dim dbGL As String
        dbGL = IFs_MDB2Active
        Dim rsGL As DataTable
        Dim iGL As Integer
        'jrs 2025/06/16 decomposing 2nd dimension
        Dim rsGL2 As DataTable
        Dim iGL2 As Integer

        'jrs 2007/10/19
        Dim bPov As Boolean, bPovPct As Boolean, bPovFind As Boolean, PovLevel As Single
        'jrs 2014/10/21
        Dim b2005PPP As Boolean
        'jrs 2011/06/17
        Dim bIncR As Boolean, PovLevel2 As Single
        'jrs 2010/05/14
        Dim bMortChl As Boolean, bMortAdl As Boolean

        'jrs 2011/01/20
        For DimIdx = 0 To lstDim.Items.Count - 1
            DimIdxs(DimIdx) = False
            DimIdxs2(DimIdx) = False
            DimIdxs3(DimIdx) = False
        Next

        'jrs 2011/11/04
        'Create Collection based on Order passed or listBox
        Dim SceOrdFiles As New Collection
        Dim sceFile As Object
        For fileIdx = 0 To lstFiles.Items.Count - 1
            PDFilesIdxs(fileIdx) = False
        Next
        If Trim(sOrdFiles) > "" Then
            Dim Fs As Object
            Fs = Split(sOrdFiles, ",")
            For fileIdx = 0 To UBound(Fs)
                SceOrdFiles.Add(CInt(Fs(fileIdx)), Fs(fileIdx).ToString)
            Next
        Else
            For fileIdx = 0 To lstFiles.Items.Count - 1
                If lstFiles.Items(fileIdx).Selected Then
                    SceOrdFiles.Add(fileIdx, fileIdx.ToString)
                End If
            Next
        End If

        'jrs 2012/12/05
        'Create Collection based on Order passed or listBox
        Dim OrdDims As New Collection
        Dim Location As Object

        'jrs 2016/01/11
        Dim DimIdxMin As Integer = 1000000

        If Trim(sOrdDims) > "" Then
            'jrs 2013/10/01
            Dim DimAll As Integer

            Dim FDs As Object
            FDs = Split(sOrdDims, ",")
            For DimIdx = 0 To UBound(FDs)
                'jrs 2013/10/01 Convert Dimensions, they bring single index 
                'need cumulative index when all is loaded
                DimAll = ConvertFromSimpleIndexToComplexForDim(CInt(FDs(DimIdx)), bUseGroup Or bUseGroupDec, bUseGList, bUseCtryGrp, bUseCtryGrpDec)
                'jrs 2023/04/10
                'Check if Africa is selected since it's in one of the previous dimensions
                'This would fail if we add new groups that go alphabetically before Africa
                'jrs 2024/10/28
                'If lstDim.Items(NR + 85).Selected And ((DimAll = GDimsCount And OnlyCoreGroups) Or (DimAll = GDimsCount + 33 And Not OnlyCoreGroups)) Then
                '    DimAll = NR + 85
                'End If
                'This had to be updated because 3 new dimensions were added before Africa in dimension 13, like in the case of hivculf, for new Energy Renewables, solar, wind and Geothermal
                If lstDim.Items(NR + 88).Selected And ((DimAll = GDimsCount And OnlyCoreGroups) Or (DimAll = GDimsCount + 33 And Not OnlyCoreGroups)) Then
                    DimAll = NR + 88
                End If

                OrdDims.Add(DimAll, DimAll.ToString)
                'jrs 2016/01/11
                If DimIdxMin > DimAll Then
                    DimIdxMin = DimAll
                End If
            Next
        Else
            For DimIdx = 0 To lstDim.Items.Count - 1
                If lstDim.Items(DimIdx).Selected Then
                    OrdDims.Add(DimIdx, DimIdx.ToString)
                    'jrs 2016/01/11
                    If DimIdxMin > DimIdx Then
                        DimIdxMin = DimIdx
                    End If
                End If
            Next
        End If

        'jrs 2023/09/20
        Dim OrdDims2 As New Collection
        Dim DimIdxMin2 As Integer = 1000000
        If Trim(sOrdDims2) > "" Then
            'jrs 2013/10/01
            Dim DimAll As Integer
            Dim OrdDims2Map As Dictionary(Of Integer, Integer) = New Dictionary(Of Integer, Integer)
            Dim Dim2Count As Integer = 0

            Dim FDs As Object
            FDs = Split(sOrdDims2, ",")
            Dim bTotalMoved As Boolean = False

            For DimIdx = 0 To lstDim2.Items.Count - 1
                If lstDim2.Items(DimIdx).Selected Then
                    'Total First, assumes Total always goes last
                    If lstDim2.Items(DimIdx).Text = "Total" And DimIdxMin2 > DimIdx Then
                        lstDim2.Items(DimIdx).Selected = False
                        'look for next total
                        For j = DimIdx + 1 To lstDim2.Items.Count - 1
                            If lstDim2.Items(j).Text = "Total" Then
                                lstDim2.Items(j).Selected = True
                                bTotalMoved = True
                                Exit For
                            End If
                        Next
                    ElseIf lstDim2.Items(DimIdx).Text = "Other" And DimIdxMin2 > DimIdx And (UBound(FDs) > 2 Or bTotalMoved = False) Then
                        lstDim2.Items(DimIdx).Selected = False
                        'look for next Other
                        For j = DimIdx + 1 To lstDim2.Items.Count - 1
                            If lstDim2.Items(j).Text = "Other" Then
                                lstDim2.Items(j).Selected = True
                                Exit For
                            End If
                        Next
                    Else
                        OrdDims2Map.Add(Dim2Count, DimIdx)
                        Dim2Count = Dim2Count + 1
                        If DimIdxMin2 > DimIdx Then
                            DimIdxMin2 = DimIdx
                        End If
                    End If
                End If
            Next

            'jrs 2023/09/20
            'Find MinFDs
            Dim MinFDs As Integer = 1000000
            For DimIdx = 0 To UBound(FDs)
                If MinFDs > FDs(DimIdx) Then
                    MinFDs = FDs(DimIdx)
                End If
            Next

            'jrs 2023/12/04 added Amin(, OrdDims2Map.Count)
            For DimIdx = 0 To Amin(UBound(FDs), OrdDims2Map.Count - 1)
                'jrs 2013/10/01 Convert Dimensions, they bring single index 
                'need cumulative index when all is loaded
                'jrs 2023/11/30 DimAll = OrdDims2Map(CInt(FDs(DimIdx) - MinFDs))
                DimAll = OrdDims2Map(DimIdx)
                OrdDims2.Add(DimAll, DimAll.ToString)
            Next
        Else
            For DimIdx = 0 To lstDim2.Items.Count - 1
                If lstDim2.Items(DimIdx).Selected Then
                    OrdDims2.Add(DimIdx, DimIdx.ToString)
                    'jrs 2016/01/11
                    If DimIdxMin2 > DimIdx Then
                        DimIdxMin2 = DimIdx
                    End If
                End If
            Next
        End If


        'jrs 2017/06/29
        If IsNothing(lstPacks) And Trim(sOrdPacks) = "" Then
            'jrs 2017/09/06 sOrdPacks = slstPacks_SelValue
            sOrdPacks = Replace(slstPacks_SelValue, """,""", """;""")
            sOrdPacks = Replace(sOrdPacks, """", "")
        End If

        'jrs 2017/03/24
        'Create Collection based on Order passed or listBox
        Dim OrdPacks As New Collection
        Dim Pack As Object
        Dim FPs As Object
        If Trim(sOrdPacks) > "" Then
            'jrs 2017/03/27 FPs = Split(sOrdPacks, ",")
            FPs = Split(sOrdPacks, ";")
            For PackIdx = 0 To UBound(FPs)
                'jrs 2017/03/27 OrdPacks.Add(CInt(FPs(PackIdx)), FPs(PackIdx).ToString)
                OrdPacks.Add(PackIdx, FPs(PackIdx).ToString)
            Next
        Else
            For PackIdx = 0 To lstPacks.Items.Count - 1
                If lstPacks.Items(PackIdx).Selected Then
                    OrdPacks.Add(PackIdx, PackIdx.ToString)
                End If
            Next
        End If

        'jrs 2011/01/25
        Dim AuxIdx As Integer
        'jrs 2012/04/26
        Dim DimNum As Integer, VarIdx As Integer
        'jrs 2017/03/24
        'jrs 2017/03/24
        Dim SelList As String, pos As Integer
        'jrs 2023/05/29
        Dim sUsrDefCat As String
        'jrs 2025/06/16
        Dim bImportsBilateral As Boolean

        'jrs 2017/03/24 Do While (Not idx = rs.Rows.Count)
        For Each Pack In OrdPacks
            'jrs 2017/03/24
            'Logic to sort VarList by selection order
            'Look for the list in record set
            'jrs 2017/03/27 
            If Trim(sOrdPacks) > "" Then
                SelList = FPs(Pack).ToString
            Else
                SelList = lstPacks.Items(Pack).Text
            End If
            pos = InStr(SelList, " - ")
            If pos > 0 Then
                'jrs 2016/06/02
                If InStr(pos + 1, SelList, " - ") = 0 Then
                    Dim rsT As DataTable
                    SetDataTablefromAccess(PutFdrvRun & "IFSVAR.mdb", "SELECT count(*) FROM VarLists WHERE ListName = """ & Mid(SelList, 1, pos - 1) & """", "", rsT)
                    If rsT.Rows(0).Item(0) > 0 Then
                        SelList = Mid(SelList, 1, pos - 1)
                    End If
                Else
                    pos = InStr(pos + 1, SelList, " - ")
                    SelList = Mid(SelList, 1, pos - 1)
                End If
            End If
            idx = 0
            Do While (Not idx = rs.Rows.Count)
                If rs.Rows(idx).Item("ListName") = SelList Then
                    Exit Do
                End If
                idx = idx + 1
            Loop

            'jrs 2020/06/02
            'Collection of FilesForDisplays and DataFrames
            'jrs 2020/08/03 moved up to be declared as parameters
            'Dim FilesCol As New Collection
