    'Get Currency Factor
    Private Function gGetCurrencyFct(ByVal idxVar As Integer, ByVal CurrencyVal As Single) As Single
        '1. idxVar is the Variable Index that will define if a currency convertion is needed or not

        'Checks if the flag for this variable is ON
        Dim bCnvrtCurr As Boolean
