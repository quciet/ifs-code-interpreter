            'Else
            '    BASE = fs.GetFile(PutFdrvRun2 + "\IFsBase.run")
            '    BASE2 = fs.GetFile(PutFdrvRun2 + "\IFsBaseHist.run")
            'End If
        Else
            'jrs 2023/06/21
