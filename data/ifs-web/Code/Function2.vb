        Dim DimIdx2 As Integer 'jrs 2006/01/15
        Dim DimIdx3 As Integer 'jrs 2006/06/20
        Dim YrIdx As Integer
        Dim Dim1 As String
        Dim Dim2 As String
        Dim Dim3 As String
        Dim sVar As String
        Dim bFirst As Boolean
        bFirst = True
        Dim idx = 0
        'Dim iRowPosition As Integer
        'Dim sLine As String
        Dim diffCount As Integer = 0

        'Create target file as copy of current base
        'Done manually after recreating empty base file
        'Target name is ifsBaseX.XX.run.db
        'FileCopyCheck(PutFdrvRun & "ifsBase.run.db", sFileNameTarget)

        'jrs 2006/01/18 GList
        Dim dbGL As String
