    Public Sub XYTABL(ByRef TFName As String, ByRef IndVar As Object, ByRef DepVar As Object, ByRef TFuncPoints As Object, ByRef XPoints As Object, ByRef YPoints As Object, ByRef _Error As String, ByRef currPage As System.Web.UI.Page, ByRef Apoint As Object, ByRef BPoints As Object)
        Dim Denom As Object
        Dim Numer As Object
        Dim IXY As Object
        Dim iloop As Object
        Dim msg As String
        'jrs 2007/11/29
        Dim frm_msg As New frm_Message

        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        '   Identify Bivariate Function Accessed (no longer only table functions)
        '   --------------------------------------------------------------------

        On Error GoTo BivariateFuncError

        'UPGRADE_WARNING: Use of Null/IsNull() detected. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1049"'
        If IsDBNull(IndVar) Then
            msg = "In a call to XYTABL for the computation of " & TFName & " the Independent Variable is Null.  We will exit the subroutine."
            'CONVERSION_TODO: The equivalent of Method 'MsgBox()' may have a different behavior in Webforms.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1004.html'.
            Err.Raise(vbObjectError + 1051, Nothing, msg)
        End If

        FuncInd = 0
        For iloop = 1 To TFCount
            '        If TFunName$(ILoop) = TFName$ Then
            'UPGRADE_WARNING: Couldn't resolve default property of object iloop. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            If FuncName(iloop) = TFName Then
                'UPGRADE_WARNING: Couldn't resolve default property of object iloop. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                FuncInd = iloop
                Exit For
            End If
        Next iloop
        If FuncInd = 0 Then
            msg = "Fatal Error:  Table function " & TFName & " not found."
            _Error = msg
            ' Transfer back to this page.                
            'jrs 2007/11/29
            'Support.FormManager.Show(currPage, "ErrorHandler.aspx")
            frm_msg.LoadMessage(msg)
            Support.FormManager.StateStore(currPage)
            Support.FormManager.Show(currPage, "frm_Message.aspx")
        End If

        '   Analytic function - compute dependent
        '   -------------------------------------

        'UPGRADE_WARNING: Couldn't resolve default property of object TFuncPoints(FuncInd). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        If TFuncPoints(FuncInd) = 0 Then
            'jrs 2009/11/20
            If BPoints(FuncInd, 9) = 0 Then
                DepVar = Apoint(FuncInd) + BPoints(FuncInd, 1) * IndVar + BPoints(FuncInd, 2) * IndVar ^ 2 +
                    BPoints(FuncInd, 3) * IndVar ^ 3 + BPoints(FuncInd, 4) * System.Math.Log(IIf(IndVar <= 0, 1, IndVar)) +
                    BPoints(FuncInd, 5) * IndVar ^ BPoints(FuncInd, 6) + BPoints(FuncInd, 7) * System.Math.Exp(BPoints(FuncInd, 8) * IndVar)
            Else
                DepVar = BPoints(FuncInd, 9) / (1 + Exp(Apoint(FuncInd) + BPoints(FuncInd, 1) * IndVar _
                + BPoints(FuncInd, 2) * IndVar ^ 2 + BPoints(FuncInd, 3) * IndVar ^ 3 _
                + BPoints(FuncInd, 4) * Log(IIf(IndVar <= 0, 1, IndVar)) _
                + BPoints(FuncInd, 5) * IndVar ^ BPoints(FuncInd, 6) _
                + BPoints(FuncInd, 7) * Exp(BPoints(FuncInd, 8) * IndVar)))
            End If
            Exit Sub
        End If

        '   Table function - compute dependent variable
        '   -------------------------------------------

        'JRS 10/20/03 If (IndVar - XPoints(FuncInd%, 1)) <= 0 Then
        'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getXPoints(FuncInd, 1). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'UPGRADE_WARNING: Couldn't resolve default property of object IndVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
        If (IndVar - XPoints(FuncInd, 1)) <= 0 Then
            'JRS 10/20/03 DepVar = YPoints(FuncInd%, 1)
            'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getYPoints(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'UPGRADE_WARNING: Couldn't resolve default property of object DepVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
            DepVar = YPoints(FuncInd, 1)
            Exit Sub 'If below range, set to first point
        End If
        'JRS 10/20/03 If (IndVar - XPoints(FuncInd%, TFuncPoints(FuncInd%))) >= 0 Then
        'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getXPoints(FuncInd, TFuncPoints(FuncInd)). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'UPGRADE_WARNING: Couldn't resolve default property of object IndVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
        If (IndVar - XPoints(FuncInd, TFuncPoints(FuncInd))) >= 0 Then
            'JRS 10/20/03 DepVar = YPoints(FuncInd%, TFuncPoints(FuncInd%))
            'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getYPoints(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'UPGRADE_WARNING: Couldn't resolve default property of object DepVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
            DepVar = YPoints(FuncInd, TFuncPoints(FuncInd))
            Exit Sub 'If above range, set to top point
        End If
        'UPGRADE_WARNING: Couldn't resolve default property of object TFuncPoints(FuncInd). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        For IXY = 2 To TFuncPoints(FuncInd)
            'JRS 10/20/03 If (IndVar - XPoints(FuncInd%, IXY)) <= 0 Then
            'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getXPoints(FuncInd, IXY). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'UPGRADE_WARNING: Couldn't resolve default property of object IndVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
            If (IndVar - XPoints(FuncInd, IXY)) <= 0 Then
                'JRS 10/20/03 Numer = (YPoints(FuncInd%, IXY) - YPoints(FuncInd%, IXY - 1))
                'UPGRADE_WARNING: Couldn't resolve default property of object IXY. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getYPoints(FuncInd, IXY - 1). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getYPoints(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object Numer. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
                Numer = (YPoints(FuncInd, IXY) - YPoints(FuncInd, IXY - 1))
                'JRS 10/20/03 Numer = Numer * (IndVar - XPoints(FuncInd%, IXY - 1))
                'UPGRADE_WARNING: Couldn't resolve default property of object IXY. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getXPoints(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object IndVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object Numer. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
                Numer = Numer * (IndVar - XPoints(FuncInd, IXY - 1))
                'JRS 10/20/03 Denom = (XPoints(FuncInd%, IXY) - XPoints(FuncInd%, IXY - 1))
                'UPGRADE_WARNING: Couldn't resolve default property of object IXY. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getXPoints(FuncInd, IXY - 1). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getXPoints(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object Denom. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
                Denom = (XPoints(FuncInd, IXY) - XPoints(FuncInd, IXY - 1))
                'JRS 10/20/03 DepVar = YPoints(FuncInd%, IXY - 1)
                'UPGRADE_WARNING: Couldn't resolve default property of object IXY. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object 'JRSVBNET frm_MainMenu.IFsGUIctrl1.getYPoints(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object DepVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'CONVERSION_ISSUE: Property 'IFs.frm_MainMenu.DefInstance' is not supported.  Click for more: 'ms-its:C:\Program Files\ArtinSoft\WinFormsToWeb\WinFormsToWeb.chm::1000.html'.
                DepVar = YPoints(FuncInd, IXY - 1)
                'UPGRADE_WARNING: Couldn't resolve default property of object Denom. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object Numer. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object DepVar. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                DepVar = DepVar + Numer / Denom 'This sequence preserves extended digits
                Exit Sub
            End If
        Next IXY


        Exit Sub
BivariateFuncError:
        msg = "Error occurred processing XYTABL, using Function " & TFName
        msg = msg & ".  You will need to reverse changes made in bivariate "
        msg = msg & "functions or reload the original TablFunc.mdb."
        _Error = msg

        _logger.Error(Err.GetException, $"XYTABL: {msg}")
        ' Transfer back to this page.
        'jrs 2007/11/29
        'Support.FormManager.Show(currPage, "ErrorHandler.aspx")
        frm_msg.LoadMessage(msg)
        Support.FormManager.StateStore(currPage)
        Support.FormManager.Show(currPage, "frm_Message.aspx")


    End Sub

