            InFile = "IFsHistSeries_MDB" 'In case of error, need for error message
            OutFile = "IFsHistSeries_MDB"
            FileCopyCheck(DataFileDir & "IFsHistSeries.db", PutFdrvRun & "IFsHistSeries.db")
            IFsHistSeries_MDB = PutFdrvRun & "IFsHistSeries.db"
            IFsCoVaTrASeries_MDB = PutFdrvRun & "IFsCoVaTrASeries.db"

            '    Set db = OpenDatabase(IFsHistSeries_MDB, False, True, DataPW$)

            If UCase(ModelLoad) = UCase("LoadCoVaTrA") Then
                InFile = "IFsCoVaTrASeries_MDB"
                OutFile = "IFsCoVaTrASeries_MDB"
                FileCopyCheck(DataFileDir & "IFsCoVaTrASeries.db", PutFdrvRun & "IFsCoVaTrASeries.db")
            End If

            '   Copy Cohort File to Working Location in local Runfiles directory
            '   --------------------------------------------------------------------

            InFile = "IFsWVSCohort_MDB"
            OutFile = "IFsWVSCohort_MDB"
            FileCopyCheck(DataFileDir & "IFsWVSCohort.db", PutFdrvRun & "IFsWVSCohort.db")

            IFsWVSCohort_MDB = PutFdrvRun & "IFsWVSCohort.db"

            InFile = "IFsPopWork_DB"
            OutFile = "IFsPopWork_DB"
            'jrs 2008/06/18
            FarmFileAllocator("POP", PutFdrvRun & "IFsPopWork.db", SQLite)
            'jrs 2006/09/15 FileCopyCheck(DataFileDir & "IFsPopWork.mdb", PutFdrvRun & "IFsPopWork.mdb")
            FileCopyCheck(DataFileDir & "IFsPop.db", PutFdrvRun & "IFsPopWork.db")
        Else
            '   Copy HistSeries File to Working Location in local Runfiles directory
            '   --------------------------------------------------------------------

            InFile = "IFsHistSeries_MDB" 'In case of error, need for error message
            OutFile = "IFsHistSeries_MDB"
            FileCopyCheck(DataFileDir & "IFsHistSeries.mdb", PutFdrvRun & "IFsHistSeries.mdb")
            IFsHistSeries_MDB = PutFdrvRun & "IFsHistSeries.mdb"
            IFsCoVaTrASeries_MDB = PutFdrvRun & "IFsCoVaTrASeries.mdb"

            '    Set db = OpenDatabase(IFsHistSeries_MDB, False, True, DataPW$)

            If UCase(ModelLoad) = UCase("LoadCoVaTrA") Then
                InFile = "IFsCoVaTrASeries_MDB"
                OutFile = "IFsCoVaTrASeries_MDB"
                FileCopyCheck(DataFileDir & "IFsCoVaTrASeries.mdb", PutFdrvRun & "IFsCoVaTrASeries.mdb")
            End If

            '   Copy Cohort File to Working Location in local Runfiles directory
            '   --------------------------------------------------------------------

            InFile = "IFsWVSCohort_MDB"
            OutFile = "IFsWVSCohort_MDB"
            FileCopyCheck(DataFileDir & "IFsWVSCohort.db", PutFdrvRun & "IFsWVSCohort.mdb")

            IFsWVSCohort_MDB = PutFdrvRun & "IFsWVSCohort.mdb"

            InFile = "IFsPopWork_MDB"
            OutFile = "IFsPopWork_MDB"
            'jrs 2008/06/18
            FarmFileAllocator("POP", PutFdrvRun & "IFsPopWork.mdb", SQLite)
            'jrs 2006/09/15 FileCopyCheck(DataFileDir & "IFsPopWork.mdb", PutFdrvRun & "IFsPopWork.mdb")
            FileCopyCheck(DataFileDir & "IFsPop.mdb", PutFdrvRun & "IFsPopWork.mdb")
            '   Copy Statistics File to Working Location in local Runfiles directory
            '   --------------------------------------------------------------------

            InFile = "IFsStat_MDB"
            OutFile = "IFsStat_MDB"
            FileCopyCheck(DataFileDir & "IFsStat.mdb", PutFdrvRun & "IFsStat.mdb")
            IFsStat_MDB = PutFdrvRun & "IFsStat.mdb"

        End If

        '   On Network, copy IFSBASE.RUN to local directory
        '   -----------------------------------------------
        If UseSQLite Then
            InFile = FdrvRun & Basefile & ".RUN.DB"
            OutFile = PutFdrvRun & Basefile & ".RUN.DB"
        Else
            InFile = FdrvRun & Basefile & ".RUN"
            OutFile = PutFdrvRun & Basefile & ".RUN"
        End If
        If FdrvRun <> PutFdrvRun Then
            FileCopyCheck(InFile, OutFile)
        End If


        '   On Network, copy IFSBASEHIST.RUN to local directory
        '   -----------------------------------------------
        If ModelLoad <> "LoadStudent" And CBool(DevelopmentMode) = False Then 'Historical run not available for students
            InFile = FdrvRun & Basefile & "HIST.RUN.DB"
            OutFile = PutFdrvRun & Basefile & "HIST.RUN.DB"
            If FdrvRun <> PutFdrvRun Then
