    'jrs 2015/04/06 changed from PopMatrix() as single
    Public Function GiniCalc(ByRef GiniMatrix() As Object, ByRef PopMatrix() As Object, ByRef LorenzX As Object, ByRef LorenzY As Object) As Object
        Dim NewAreaIneq As Object
        Dim NewAreaEqAboveBase As Object
        Dim NewAreaEqbase As Object
        Dim LGiniMatrixCum As Object
        Dim LPopCum As Single
        Dim reg As Short
        Dim RegLast As Short
        Dim GiniMatrixCum As Object
        Dim PopCum As Single
        Dim CumAreaIneq As Object
        Dim cumareaeq As Object
        Dim areatot As Object
        Dim reg1 As Short
        Dim SmallReg As Short
        Dim JCount As Short
        Dim MatSmall As Object
        Dim ICount As Short
        Dim WPOPSum As Single
        Dim WGiniMatrixSum As Object
        Dim matlargest As Object

        Dim GiniMatHold(NR) As Object
        Dim rankscale(NR) As Short
        ReDim LorenzX(NR)
        ReDim LorenzY(NR)

        '   Find largest per capita value and compute global sums
        'UPGRADE_WARNING: Couldn't resolve default property of object GiniMatrix(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'UPGRADE_WARNING: Couldn't resolve default property of object matlargest. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        matlargest = GiniMatrix(1) / PopMatrix(1)
        'UPGRADE_WARNING: Couldn't resolve default property of object WGiniMatrixSum. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        WGiniMatrixSum = 0
        'UPGRADE_WARNING: Couldn't resolve default property of object WPOPSum. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        WPOPSum = 0
        For ICount = 1 To NR 'Copy matrix to sort into GiniMatHold and find largest value
            If IsDBNull(GiniMatrix(ICount)) Or IsDBNull(PopMatrix(ICount)) Then
                GiniMatHold(ICount) = System.DBNull.Value
            Else
                GiniMatHold(ICount) = GiniMatrix(ICount) / PopMatrix(ICount)
                If GiniMatHold(ICount) > matlargest Then matlargest = GiniMatHold(ICount)
            End If
            'jrs 2015/04/06
            If IsDBNull(matlargest) And Not IsDBNull(GiniMatHold(ICount)) Then
                matlargest = GiniMatHold(ICount)
            End If

            'jrs 2015/04/06
            If Not IsDBNull(GiniMatrix(ICount)) Then
                WGiniMatrixSum = WGiniMatrixSum + GiniMatrix(ICount)
                WPOPSum = WPOPSum + PopMatrix(ICount)
            End If
        Next ICount

        'jrs 2015/04/06
        If IsDBNull(matlargest) Then
            GiniCalc = System.DBNull.Value
            Exit Function
        End If

        '   Rank a matrix (e.g. GDPPC) from smallest to largest and maintain pointers
        '       1-NR% in RankScale
        For ICount = 1 To NR
            MatSmall = matlargest
            'jrs 2015/04/06
            SmallReg = 0
            For JCount = 1 To NR 'Find smallest value not yet identified
                If Not IsDBNull(GiniMatHold(JCount)) Then
                    If GiniMatHold(JCount) <= MatSmall Then
                        MatSmall = GiniMatHold(JCount)
                        SmallReg = JCount
                    End If
                End If
            Next JCount
            'jrs 2015/04/06
            If SmallReg > 0 Then
                rankscale(ICount) = SmallReg
                'Hold region number of smallest element
                GiniMatHold(SmallReg) = System.Math.Abs(matlargest * 2) 'Do not reuse smallest element
                'jrs 2015/04/06
                If matlargest = 0 Then
                    GiniMatHold(SmallReg) = 1
                End If
            End If
        Next ICount
        WGiniMatrixSum = AMAX(0.00001, WGiniMatrixSum)
        WPOPSum = AMAX(0.00001, WPOPSum)

        '   Compute equality and inequality for "poorest" country
        reg1 = rankscale(1)
        areatot = CSng(0.5 * (PopMatrix(reg1) / WPOPSum) ^ 2)
        cumareaeq = CSng(0.5 * PopMatrix(reg1) / WPOPSum * GiniMatrix(reg1) / WGiniMatrixSum)
        'e.g., if bottom 10% have 2%, then = .5 * .10 * .02 = .001
        CumAreaIneq = System.Math.Round(areatot - cumareaeq, 4)
        'e.g., if looking at bottom 10% then = .5 * .1 * .1 - .001 = .004
        PopCum = PopMatrix(reg1)
        GiniMatrixCum = GiniMatrix(reg1)
        LorenzX(1) = PopMatrix(reg1) / WPOPSum
        LorenzY(1) = GiniMatrix(reg1) / WGiniMatrixSum

        '   Compute equality and inequalty for all countries
        For ICount = 2 To NR
            RegLast = rankscale(ICount - 1)
            reg = rankscale(ICount)
            'jrs 2015/04/06
            If Not IsDBNull(GiniMatrix(reg)) Then
                LPopCum = PopCum
                LGiniMatrixCum = GiniMatrixCum
                PopCum = PopCum + PopMatrix(reg)
                GiniMatrixCum = GiniMatrixCum + GiniMatrix(reg)
                areatot = CSng(0.5 * (PopCum / WPOPSum) ^ 2)
                NewAreaEqbase = CSng((PopMatrix(reg) / WPOPSum) * (LGiniMatrixCum / WGiniMatrixSum))
                NewAreaEqAboveBase = CSng(1 / 2 * (PopMatrix(reg) / WPOPSum) * (GiniMatrixCum / WGiniMatrixSum - LGiniMatrixCum / WGiniMatrixSum))
                NewAreaIneq = System.Math.Round(areatot - cumareaeq - CumAreaIneq - NewAreaEqbase - NewAreaEqAboveBase, 4)
                cumareaeq = cumareaeq + NewAreaEqbase + NewAreaEqAboveBase
                CumAreaIneq = CumAreaIneq + NewAreaIneq
                LorenzX(ICount) = LorenzX(ICount - 1) + PopMatrix(reg) / WPOPSum
                LorenzY(ICount) = LorenzY(ICount - 1) + GiniMatrix(reg) / WGiniMatrixSum
            End If
        Next ICount

        '   Compute Gini relative to 1/2 - line of equality
        'UPGRADE_WARNING: Couldn't resolve default property of object CumAreaIneq. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        'UPGRADE_WARNING: Couldn't resolve default property of object GiniCalc. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
        GiniCalc = CumAreaIneq / 0.5
    End Function

