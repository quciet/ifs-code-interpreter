    'Function to find closest smaller year field in table (where fields are sorted)
    Private Function findClosestSmallerYearIdx(ByVal firstYidx As Integer, ByVal lastYidx As Integer, ByRef row As DataRow,
    ByRef sYr As String, ByVal lastYidxTbl As Integer) As Integer
        'value not found
        If firstYidx > lastYidx Then
            findClosestSmallerYearIdx = -1
            Exit Function
        End If

        Dim idx As Integer

        'if value out of range assign the extremes
        If sYr < row.Table.Columns(2).Caption Then 'jrs 2008/05/13 change from firtYidx to 2
            idx = 2
            Do While IsDBNull(row.Item(idx))
                idx = idx + 1
                If idx > lastYidxTbl Then 'jrs 2008/05/13 from lastYidx to lastYidxTbl
                    idx = -1
                    Exit Do
                End If
            Loop
            findClosestSmallerYearIdx = idx
            Exit Function
        ElseIf sYr > row.Table.Columns(lastYidxTbl).Caption Then 'jrs 2008/05/13 from lastYidx to lastYidxTbl
            idx = lastYidxTbl
            Do While IsDBNull(row.Item(idx))
                idx = idx - 1
                If idx < 2 Then
                    idx = -1
                    Exit Do
                End If
            Loop
            findClosestSmallerYearIdx = idx
            Exit Function
        End If

        'divide and conquer
        Dim midPt As Integer
        midPt = (lastYidx + firstYidx) / 2
        If sYr < row.Table.Columns(midPt).Caption Then
            findClosestSmallerYearIdx = findClosestSmallerYearIdx(firstYidx, midPt - 1, row, sYr, lastYidxTbl)
            Exit Function
        End If
        If sYr > row.Table.Columns(midPt).Caption Then
            If midPt + 1 <= lastYidx Then
                If sYr < row.Table.Columns(midPt + 1).Caption Then
                    idx = midPt
                    Do While IsDBNull(row.Item(idx))
                        idx = idx - 1
                        If idx < 2 Then
                            'start looking forward
                            idx = midPt + 1
                            Do While IsDBNull(row.Item(idx))
                                idx = idx + 1
                                If idx > lastYidxTbl Then 'jrs 2008/05/12 lastYidx should be last year in the full table not in this divide and conquer portion
                                    idx = -1
                                    Exit Do
                                End If
                            Loop
                            Exit Do
                        End If
                    Loop
                    findClosestSmallerYearIdx = idx
                    Exit Function
                End If
            Else
                idx = midPt
                Do While IsDBNull(row.Item(idx))
                    idx = idx - 1
                    If idx < 2 Then
                        'start looking forward
                        idx = midPt + 1
                        Do While IsDBNull(row.Item(idx))
                            idx = idx + 1
                            If idx > lastYidxTbl Then 'jrs 2008/05/12 lastYidx should be last year in the full table not in this divide and conquer portion
                                idx = -1
                                Exit Do
                            End If
                        Loop
                        Exit Do
                    End If
                Loop
                findClosestSmallerYearIdx = idx
                Exit Function
            End If
            findClosestSmallerYearIdx = findClosestSmallerYearIdx(midPt + 1, lastYidx, row, sYr, lastYidxTbl)
            Exit Function
        End If
        findClosestSmallerYearIdx = -1 'value not found
    End Function

