                    " AND CohortId >= " & CStr(cc1) & " AND CohortId <= " & CStr(cc2) & " GROUP BY TimeId", "", rsW)
                    Do While Not rsW.Rows.Count = rr
                        Target(rsW.Rows(rr).Item("Years") - FirstYearForecast + 1, 1) = rsW.Rows(rr).Item("Males")
                        Target(rsW.Rows(rr).Item("Years") - FirstYearForecast + 1, 2) = rsW.Rows(rr).Item("Females")
