    Public Function BuildShiftStr(ByRef plotcol As Short, ByRef ShiftVal As Object, ByRef ShiftOp As Object,
    ByRef ShiftYears As Object, ByRef CheckVal As Object, ByRef bGroup As Object, ByRef PutFdrvRun As String,
    ByRef VL As Object, ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object,
    ByRef GR4N As Object, ByRef FirstYear As Object, ByRef LastYear As Object,
    ByRef FdrvRun As Object, ByRef SEL As Object, ByRef RunFiles As Object,
    ByRef IFs_MDB2Active As Object, ByRef FinYear As Object, ByRef PercentOn As Object,
    ByRef ShortSce As Object, ByRef ActiveBase As Object,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef vShortSce As Object,
    ByRef FileforDisplay As Integer, ByVal currencyVal As Single, ByRef SQLite As String) As String
        Dim finam As String
        '- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
        On Error GoTo TmpErr
        Dim Number As Single
        Dim NewVal As Object
        Dim VarVal As Double
        Dim RECORD As Long

        'If Not Session("Changing_Custom_Scenario") Then
        'txt_value.Text = "Please Wait"
        BuildShiftStr = ""
        'jrs 2005/06/02



        Dim Numbers(1) As Single
        If SQLite = "True" Then
            finam = PutFdrvRun & ActiveBase & ".DB"
            gLoadForDisplayNET(V(SEL), SEL, GR1N(plotcol), -1, GR2N(plotcol), -1, GR3N(plotcol), -1,
            finam$, 1, True, True, bGroup, 1, Numbers, 1, 1, FirstYear, FirstYear, 0, True,
            bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce, FinYear,
            IFs_MDB2Active, currencyVal)
        Else
            finam = PutFdrvRun & ActiveBase
            gLoadForDisplay(V(SEL), SEL, GR1N(plotcol), -1, GR2N(plotcol), -1, GR3N(plotcol), -1,
            finam$, 1, True, True, bGroup, 1, Numbers, 1, 1, FirstYear, FirstYear, 0, True,
            bLoadForDisplaySuccess, myForm, RunFiles, PutFdrvRun, vShortSce, FileforDisplay, FinYear,
            IFs_MDB2Active, currencyVal)
        End If
        Number! = Numbers(1)


        VarVal = System.Math.Round(Number, 4) 'If more than 7- does e : 1.2209873245E-02 etc.
        'does not convert to val properly if more than 4 digits after decimal

        Select Case ShiftOp
            Case "Up"
                NewVal = VarVal + ShiftVal
                If NewVal > CheckVal Then
                    NewVal = CheckVal
                End If
                If ShiftYears = 0 Then
                    BuildShiftStr = Trim(Str(NewVal)) & ":1000"
                Else
                    BuildShiftStr = Trim(Str(VarVal)) & "," & Trim(Str(NewVal)) & "@" & Trim(Str(ShiftYears)) & "," & Trim(Str(NewVal)) & ":1000"
                End If
            Case "Down"
                NewVal = VarVal + ShiftVal
                If NewVal < CheckVal Then
                    NewVal = CheckVal
                End If
                If ShiftYears = 0 Then
                    BuildShiftStr = Trim(Str(NewVal)) & ":1000"
                Else
                    BuildShiftStr = Trim(Str(VarVal)) & "," & Trim(Str(NewVal)) & "@" & Trim(Str(ShiftYears)) & "," & Trim(Str(NewVal)) & ":1000"
                End If
        End Select
        'End If

        'End If
        Exit Function
TmpErr:
        _logger.Error(Err.GetException, "BuildShiftStr - exception")
        Err.Raise(vbObjectError + 1051, Nothing, "In TmpErr")

    End Function


