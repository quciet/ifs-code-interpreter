            'UPGRADE_WARNING: Couldn't resolve default property of object GroupNum. Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            GroupNum = resG.Rows(0).Item("GroupNum")
            '    Dim valtbl As Recordset
            SetDataTablefromAccess(IFs_MDB2Active, "SELECT * FROM " & Grouping, "", valtblG) 'jrs 2009/01/28 removed index on Region because it's not primary key an it was blowing up
            '   Load Group Member Names List Box
            'For icount% = 1 To valtblG.RecordCount
