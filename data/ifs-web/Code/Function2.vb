    'jrs 2021/01/14
    'Taken from microsft web-site: https://www.microsoft.com/en-us/microsoft-365/blog/2012/08/03/automatically-relink-microsoft-access-tables/
    '�������������������������-
    ' Procedure: RefreshTableLinks
    ' Purpose: Refresh table links to back-ends in the same folder as front end.
    ' Note: Linked Tables can be in more than one back-end.
    ' Return: Returns a zero-length string if all tables are relinked.
    ' Return: Or returns a string listing tables not relinked and errors.
    '�������������������������-

    Public Function RefreshTableLinks() As String
        On Error GoTo ErrHandle

        Dim db As dao.Database
        Dim tdf As dao.TableDef
        Dim strCon As String
        Dim strBackEnd As String
        Dim strMsg As String
        Dim intErrorCount As Integer

        'jrs 2021/01/14
        Dim DBE As dao.DBEngine = New dao.DBEngine()

        db = DBE.OpenDatabase(DataFileDir$ + "IFsHistSeriesDyadic.mdb")

        'Loop through the TableDefs Collection.
        For Each tdf In db.TableDefs
            'Verify the table is a linked table.
            If Left$(tdf.Connect, 10) = ";DATABASE=" Then
                'Get the existing Connection String.
                strCon = tdf.Connect
                'jrs 2021/01/14
                'check if already link to avoid re-doing it
                If InStr(strCon, DataFileDir$) > 0 Then Exit For
                'Get the name of the back-end database using String Functions.
                strBackEnd = Right$(strCon, (Len(strCon) - (InStrRev(strCon, "\"))))
                'Verify we have a value for the back-end
                If Len(strBackEnd & "") > 0 Then
                    'Set a reference to the TableDef Object.
                    tdf = db.TableDefs(tdf.Name)
                    'Build the new Connection Property Value.
                    tdf.Connect = ";DATABASE=" & DataFileDir$ & strBackEnd
                    'Refresh the table link.
                    tdf.RefreshLink()
                Else
                    'There was a problem getting the name of the back-end.
                    'Add the information to the message to notify the user.
                    intErrorCount = intErrorCount + 1
                    strMsg = strMsg & "Error getting back-end database name." & vbNewLine
                    strMsg = strMsg & "Table Name: " & tdf.Name & vbNewLine
                    strMsg = strMsg & "Connect = " & strCon & vbNewLine
                End If
            End If
        Next tdf

ExitHere:
        On Error Resume Next
        If intErrorCount > 0 Then
            strMsg = "There were errors refreshing the table links: """ _
    & vbNewLine & strMsg & "In Procedure RefreshTableLinks"""
            RefreshTableLinks = strMsg
        End If
        tdf = Nothing
        'jrs 2022/06/09
        db.Close()
        db = Nothing
        Exit Function

ErrHandle:
        intErrorCount = intErrorCount + 1
        strMsg = strMsg & "Error " & Err.Number & " " & Err.Description
        strMsg = strMsg & vbNewLine & "Table Name: " & tdf.Name & vbNewLine
        strMsg = strMsg & "Connect = " & strCon & vbNewLine
        _logger.Error(Err.GetException, $"RefreshTableLinks - {strMsg}")
        Resume ExitHere

    End Function

    'jrs 2021/05/28
    'Returns True if Regions have not changed, and are still compatible
    'False if they have changed and are not compatible anymore with system
    'Only available for SQLlite files
    Private Function bCheckFile4CompatibilityOfRegions(sFileName As String, PutFdrvRun As String, ByRef RegChgIdx As Integer) As Boolean
        bCheckFile4CompatibilityOfRegions = True
        'Need to open file, load regions, and compare them with existing in system
        If sFileName.ToUpper.Contains(".RUN.DB") Then
            'Open File
            Dim sFolder As String = PutFdrvRun
            If PutFdrvRun.Contains("Session") Then
                Dim SessionFolder As String
                Dim pos As Short
                pos = PutFdrvRun.IndexOf("Session")
                SessionFolder = PutFdrvRun.Substring(pos)
                sFolder = sFolder.Replace(SessionFolder, "")
            End If

            If sFileName IsNot Nothing And Path.GetFileName(sFileName) = sFileName And Path.GetDirectoryName(sFolder) IsNot String.Empty Then
                ' sFileName is only the filename without path so we prepare the path
                sFileName = Path.Combine(sFolder, sFileName)
            End If

            'jam 2026/04/09 Wrapped in Try/Catch for Out of Memory protection in get_Dimensions
            'Without exception management Storage.get_Dimensions generates ArgumentNullException in cascade
            Try

                Dim storageSvc As IStorageService = New StorageService(sFileName)
                Dim working As IStorage
                working = storageSvc.Open()
                Dim R As Integer
                For R = 1 To NR
                    If GRPS(1, R) <> working.Dimensions(1).Buckets(R) Then
                        bCheckFile4CompatibilityOfRegions = False
                        Exit For
                    End If
                Next
                If bCheckFile4CompatibilityOfRegions = False Then
                    Dim KNT As Integer
                    'jrs 2025/10/06
                    'Need to check in the last dimensions loaded, maybe the new regions are already loaded
                    RegChgIdx = 0
                    For i = 1 To ExtraRegionSetsLoaded
                        RegChgIdx = i
                        For R = 1 To working.Dimensions(1).Buckets.Count
                            If GRPS(UBound(GRPS, 1) - i, R) <> working.Dimensions(1).Buckets(R) Then
                                RegChgIdx = 0
                                Exit For
                            End If
                        Next
                        If RegChgIdx > 0 Then Exit For
                    Next

                    If RegChgIdx = 0 Then
                        'Need to extend GRPS first
                        ExtendGRPSDim1()
                        KNT = UBound(GRPS, 1)
                        ReDim Preserve MAXCOM(KNT)
                        'jrs 2025/10/06
                        ReDim Preserve MaxVal(KNT)
                        'jrs 2022/03/28 added newNR
                        Dim newNR As Integer
                        newNR = working.Dimensions(1).Buckets.Count
                        If newNR > UBound(GRPS, 2) Then
                            newNR = UBound(GRPS, 2)
                        End If
                        For R = 1 To newNR
                            GRPS(KNT - 1, R) = working.Dimensions(1).Buckets(R)
                        Next
                        MAXCOM(KNT - 1) = newNR
                        'jrs 2025/10/06
                        MaxVal(KNT - 1) = newNR
                        RegChgIdx = KNT - 1
                        ExtraRegionSetsLoaded = ExtraRegionSetsLoaded + 1
                        'jrs 2025/10/09
                        MAXCOM(KNT) = 0
                        MaxVal(KNT) = 0
                    End If
                End If
            Catch ex As OutOfMemoryException
                'jam 2026/04/09 With memory exception, compatibility is assumed
                _logger.Error(ex, $"bCheckFile4CompatibilityOfRegions - Out of Memory in {sFileName} opening � compatibility assumed")
                bCheckFile4CompatibilityOfRegions = True
            Catch ex As Exception
                _logger.Error(ex, $"bCheckFile4CompatibilityOfRegions - Unexpected error in {sFileName}")
                bCheckFile4CompatibilityOfRegions = True
            End Try
        End If

    End Function


    'jrs 2025/10/06
    'Redim preserve doesn't work on first dimension, so we need to make a copy of GRPS
    'and then extend GRPS
    Private Sub ExtendGRPSDim1()
        Dim KNT As Integer
        KNT = UBound(GRPS, 1)
        'Make a copy of GRPS
        Dim GRPS2(0, 0) As String
        Dim R As Integer
        ReDim GRPS2(KNT, UBound(GRPS, 2))
        For i = 1 To KNT
            For R = 1 To UBound(GRPS, 2)
                GRPS2(i, R) = GRPS(i, R)
            Next
        Next
        KNT = KNT + 1
        ReDim GRPS(KNT, UBound(GRPS, 2))
        For i = 1 To KNT - 1
            For R = 1 To UBound(GRPS, 2)
                GRPS(i, R) = GRPS2(i, R)
            Next
        Next
    End Sub

    Public Sub ReadFormControlCaption(MyPage As Page, PutFdrvRun As String)

        Dim intFile As Integer
        intFile = FreeFile()

        'Clear existing file
        FileOpen(intFile, PutFdrvRun & "FormControlCaptionDotNET.csv", OpenMode.Output)
        FileClose(intFile)
        'Open output File
        FileOpen(intFile, PutFdrvRun & "FormControlCaptionDotNET.csv", OpenMode.Append)

        'For the current page
        Dim sLine As String, sCaption As String

        On Error Resume Next
        'For each object in the form
        For Each x In MyPage.Form.Controls
            If x.ToString = "System.Web.UI.WebControls.Panel" Then
                Dim pn As System.Web.UI.WebControls.Panel
                pn = x
                For Each x2 In pn.Controls
                    sCaption = ""
                    sCaption = x2.Text
                    'Save the name, Default Caption (English)
                    If Not (x2.id Is Nothing) Then
                        If sCaption > "" And x2.ToString <> "System.Web.UI.WebControls.ListBox" _
                        And x2.ToString <> "System.Web.UI.WebControls.DropDownList" Then
                            sLine = MyPage.AppRelativeVirtualPath & ", " & x2.Id & ", " & sCaption
                            PrintLine(intFile, sLine)
                        End If
                    Else
                        If sCaption > "" And x2.ToString = "System.Web.UI.LiteralControl" Then
                            sCaption = sCaption.Replace(vbCrLf, "")
                            sCaption = sCaption.Replace(vbTab, "")
                            sCaption = sCaption.Replace("<BR>", "")
                            sCaption = sCaption.Replace("<br />", "")
                            sCaption = sCaption.Trim()
                            If sCaption > "" Then
                                sLine = MyPage.AppRelativeVirtualPath & ", " & x.Id & ", " & sCaption
                                PrintLine(intFile, sLine)
                            End If
                        End If
                    End If
                Next x2
            ElseIf x.ToString = "Coalesys.WebMenu.WebMenu" Then
                Dim mn As Coalesys.WebMenu.WebMenu
                mn = x
                For Each x3 In mn.Groups
                    sCaption = ""
                    sCaption = x3.Caption
                    'Save the name, Default Caption (English)
                    If sCaption > "" Then
                        PrintGroupMenu(MyPage, x3, intFile)
                    End If
                Next x3
            ElseIf Not (x.id Is Nothing) Then
                sCaption = ""
                sCaption = x.Text
                'Save the name, Default Caption (English)
                If sCaption > "" And x.ToString <> "System.Web.UI.WebControls.ListBox" _
                    And x.ToString <> "System.Web.UI.WebControls.DropDownList" Then
                    sLine = MyPage.AppRelativeVirtualPath & ", " & x.Id & ", " & sCaption
                    PrintLine(intFile, sLine)
                End If
            End If
        Next x
        'Close output file
        FileClose(intFile)
        'Message completed process
