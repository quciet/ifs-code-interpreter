    Public Function JscriptSaveBrowserSize() As String
        'This procedures generate the Jamascript to save the Height and Width of your browser window
        'and saves it to a hidden field txtResValueHolder

        JscriptSaveBrowserSize = "var myWidth = 0, myHeight = 0;" & vbCr
        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "if( typeof( window.innerWidth ) == 'number' ) {" & vbCr
        JscriptSaveBrowserSize = JscriptSaveBrowserSize & "    //Non-IE" & vbCr
