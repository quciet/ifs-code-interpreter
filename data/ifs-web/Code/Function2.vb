    Public Sub UpdateVarNamesInLegacyRunFiles(ByRef PutFdrvRun2 As String)
        'Open ifsvar.db
        Dim db As SQLiteConnection
        db = New SQLiteConnection("DataSource=" + PutFdrvRun2 & "\IfsVar.db;")
        db.Open()

        'Check for all .run.db files in RUNFILES directory, except ifsbase, ifsbasehist and working
        Dim di As New IO.DirectoryInfo(PutFdrvRun2)
        Dim aryFi As IO.FileInfo() = di.GetFiles("*.run.db")

        For Each fi As IO.FileInfo In aryFi
            If UCase(fi.Name) <> UCase("IFSBASE.RUN.DB") And UCase(fi.Name) <> UCase("IFSBASEHIST.RUN.DB") And UCase(fi.Name) <> "WORKING.RUN.DB" Then
                'read version from file name
                Dim sVer As String, pos As Integer
                If fi.Name.ToUpper.Contains("VER") Then
                    Do
                        pos = fi.Name.ToUpper.IndexOf("VER") + 3
                        sVer = fi.Name.Substring(pos)
                    Loop While sVer.ToUpper.Contains("VER")
                    sVer = sVer.Replace(".run.db", "")
                    If IsNumeric(sVer) Then
                        If sVer > "" Then
                            'Load Legacy Table for relevant variables currVer >= FirstVersion and currVer <= LastVersion, order by name to handle HDI issue
                            Dim rsList As SQLiteDataReader
                            Dim rsCmd As SQLiteCommand
                            rsCmd = db.CreateCommand
                            'OldVarName, NewVarName, FirstVersion, LastVersion
                            rsCmd.CommandText = "Select * FROM LegacyVarMatch WHERE " & sVer & " >= FirstVersion And " & sVer & " <= LastVersion ORDER BY OldVarName"
                            rsList = rsCmd.ExecuteReader
                            If rsList.HasRows Then
                                'Declare run file connection
                                Dim dbRun As SQLiteConnection
                                dbRun = New SQLiteConnection("DataSource=" + PutFdrvRun2 & "\" & fi.Name & ";")
                                dbRun.Open()

                                Do While rsList.Read
                                    'For each relevant variable change following 3 tables: ifs_var, ifs_var_blob, ifs_var_dim
                                    Dim runCmd As SQLiteCommand
                                    runCmd = dbRun.CreateCommand
                                    runCmd.CommandText = "UPDATE ifs_var Set [Name] = """ & rsList("NewVarName") &
                                        """ WHERE [Name] = """ & rsList("OldVarName") & """"
                                    runCmd.ExecuteNonQuery()
                                    runCmd.CommandText = "UPDATE ifs_var_blob Set [VariableName] = """ & rsList("NewVarName") &
                                        """ WHERE [VariableName] = """ & rsList("OldVarName") & """"
                                    runCmd.ExecuteNonQuery()
                                    runCmd.CommandText = "UPDATE ifs_var_dim Set [VariableName] = """ & rsList("NewVarName") &
                                        """ WHERE [VariableName] = """ & rsList("OldVarName") & """"
                                    runCmd.ExecuteNonQuery()
                                Loop

                                dbRun.Close()
                            End If
                        End If
                    End If
                End If
            End If
        Next

        db.Close()
    End Sub

