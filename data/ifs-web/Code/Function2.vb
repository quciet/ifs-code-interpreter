            If Not vmnuSQLITE Then
                rdr = ADO_OleDB_GetReader(myCMD, "SELECT * FROM PopBaseCase Where Region = " +
                Str(iReg) + " and NCohorts < 2 and Years <= " & CStr(LastYear))
                Do While rdr.Read 'Not tbl2.Rows.Count = i2
                    TempPopDatabase(rdr.Item("NCohorts"), 1, rdr.Item("Years") - FirstYear + 1) = rdr.Item("PopulationMales")
                    TempPopDatabase(rdr.Item("NCohorts"), 2, rdr.Item("Years") - FirstYear + 1) = rdr.Item("PopulationFemales")
                Loop
                rdr.Close()
            Else
                vSQLiteCommand = vSQLiteCon.CreateCommand()
                vSQLiteCommand.CommandText = "SELECT * FROM Pop_Base_Case Where RegionId = " +
                                Str(iReg) + " and CohortId < 2 and TimeId <= " & CStr(LastYear)
                vSQLiteReader = vSQLiteCommand.ExecuteReader()


                While (vSQLiteReader.Read())

                    TempPopDatabase(vSQLiteReader("CohortId"), 1, vSQLiteReader("TimeId") - FirstYear + 1) = vSQLiteReader("PopulationMales")
                    TempPopDatabase(vSQLiteReader("CohortId"), 2, vSQLiteReader("TimeId") - FirstYear + 1) = vSQLiteReader("PopulationFemales")

