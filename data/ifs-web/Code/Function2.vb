        If sDim2 > "" Then
            'UPGRADE_WARNING: Couldn't resolve default property of object MAXCOM(VDim2(idx)). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
