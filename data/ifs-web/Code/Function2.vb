            ElseIf FileNum = 1 Then
                finam = PutFdrvRun & ActiveBase '"IFSBASE.RUN"
            Else
                finam = RunFiles(FileNum)
            End If

            Dim MyFileforDisplay As IStorage
            Dim MyDF As IDataframe
            Dim MyDF2 As IDataframe

            'JAM 2010-10-05 for history plus forecast
            If LastYear > LastYearHistory And FirstYear = FirstYearHistory Then
                Dim iRowPosition As Integer, iFirstYear As Integer
                iRowPosition = LastYearHistory - FirstYearHistory + 1
                iFirstYear = FirstYearForecast

                For j = 1 To NR    'JAM 2010-10-05 Forecast
                    'cdv 2021/02/17 Now changes based of vmnuSQLITE data
                    If vmnuSQLITE = True Then
                        gLoadForDisplayNET("POP", POPptr, "", j, "", -1, "", -1, finam, FileNum, (j = 1), False, False, 1, popAll,
                        j, iRowPosition, iFirstYear, LastYear, 0, False,
                        bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FinYear,
                        IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF)
                        gLoadForDisplayNET("GDP", GDPptr, "", j, "", -1, "", -1, finam, FileNum, False, (j = NR), False, 1, gdpAll,
                        j, iRowPosition, iFirstYear, LastYear, 0, False,
                        bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FinYear,
                        IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF2)
                    Else
                        gLoadForDisplay("POP", POPptr, "", j, "", -1, "", -1, finam, FileNum, (j = 1), False, False, 1, popAll,
                        j, iRowPosition, iFirstYear, LastYear, 0, False,
                        bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FileforDisplay, FinYear,
                        IFs_MDB2Active, CurrencyVal)

                        gLoadForDisplay("GDP", GDPptr, "", j, "", -1, "", -1, finam, FileNum, False, (j = NR), False, 1, gdpAll,
                        j, iRowPosition, iFirstYear, LastYear, 0, False,
                        bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FileforDisplay, FinYear,
                        IFs_MDB2Active, CurrencyVal)
                    End If
                Next j

                'jrs 2010/10/06
                Dim FinAll As Integer
                FinAll = FinYear(1)

                For i = 1 To NR 'JAM 2010-10-05 History
                    'JAM 2010-09-25 Adding GRPS(1, i) in sdim1 parameter
                    gLoadForDisplayHis("POPULATION", GRPS(1, i), i, "", -1, "", -1, False, 1, popAll, i, FirstYearHistory,
                    LastYearHistory - 1, False, False, bFillHis, buseAllHis, -1,
                    bLoadForDisplaySuccess, currPage, FinYear, LastYear,
                    LastYearForecast, bComputation, "", "", IFsPars, bFillHisOnlyHoles,
                    False, Nothing, StaYearHis, vmnuSQLITE)
                    'jrs 2015/04/06 changed from GDP95 to GDP to look for historic analog
                    gLoadForDisplayHis("GDP", GRPS(1, i), i, "", -1, "", -1, False, 1, gdpAll, i, FirstYearHistory,
                    LastYearHistory - 1, False, True, bFillHis, buseAllHis, -1,
                    bLoadForDisplaySuccess, currPage, FinYear, LastYear,
                    LastYearForecast, bComputation, "", "", IFsPars, bFillHisOnlyHoles,
                    False, Nothing, StaYearHis, vmnuSQLITE)
                    'jrs 2010/10/06
                    FinYear(i) = FinYear(i) + FinAll
                Next i
            Else
                For j = 1 To NR
                    'cdv 2021/02/17 Now changes based of vmnuSQLITE data
                    If vmnuSQLITE Then
                        gLoadForDisplayNET("POP", POPptr, "", j, "", -1, "", -1, finam, FileNum, (j = 1), False, False, 1, popAll,
                        j, 1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FinYear,
                        IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF)
                        gLoadForDisplayNET("GDP", GDPptr, "", j, "", -1, "", -1, finam, FileNum, False, (j = NR), False, 1, gdpAll,
                        j, 1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FinYear,
                        IFs_MDB2Active, CurrencyVal, MyFileforDisplay, MyDF2)
                    Else
                        gLoadForDisplay("POP", POPptr, "", j, "", -1, "", -1, finam, FileNum, (j = 1), False, False, 1, popAll,
                        j, 1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FileforDisplay, FinYear,
                        IFs_MDB2Active, CurrencyVal)

                        gLoadForDisplay("GDP", GDPptr, "", j, "", -1, "", -1, finam, FileNum, False, (j = NR), False, 1, gdpAll,
                        j, 1, FirstYear, LastYear, 0, False, bLoadForDisplaySuccess, currPage, RunFiles, PutFdrvRun, ShortSce, FileforDisplay, FinYear,
                        IFs_MDB2Active, CurrencyVal)
                    End If
                Next j
            End If
        Else 'JRS 08/12/02
            'Regions are in GR1N(1-64)
            'Read countries for every region
            'Read file IFsHistSeries.mdb
            'Read data from countries in region from table SeriesPopulation

            Dim iRow As Integer
            'for every region
            For i = 1 To NR
                gLoadForDisplayHis("POPULATION", "", i, "", -1, "", -1, False, 1, popAll, i, FirstYear,
                LastYear, False, False, bFillHis, buseAllHis, FinYearHis(COUNTE),
                bLoadForDisplaySuccess, currPage, FinYear, LastYear, LastYearForecast,
                bComputation, "", "", IFsPars, bFillHisOnlyHoles,
                False, Nothing, StaYearHis, vmnuSQLITE)
                'jrs 2015/04/08 changed from GDP95 and from false historic analog
                gLoadForDisplayHis("GDP", "", i, "", -1, "", -1, False, 1, gdpAll, i, FirstYear,
                LastYear, False, True, bFillHis, buseAllHis, -1,
                bLoadForDisplaySuccess, currPage, FinYear, LastYear,
                LastYearForecast, bComputation, "", "", IFsPars, bFillHisOnlyHoles,
                False, Nothing, StaYearHis, vmnuSQLITE)

            Next i

        End If 'JRS 08/12/02


        ReDim LorenzX_Year(NR, LastYear - FirstYear + 1)
        ReDim LorenzY_Year(NR, LastYear - FirstYear + 1)
        'For every year
        For year_Renamed = 1 To LastYear - FirstYear + 1
            'UPGRADE_WARNING: Couldn't resolve default property of object FinYear(1). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            If year_Renamed > FinYear(1) Then Exit For 'Beyond run year
            'Load Parameters
            For i = 1 To NR
                'jrs 2015/04/06
                If IsDBNull(PLOT(year_Renamed, i)) Then
                    popAll(year_Renamed, i) = System.DBNull.Value
                    GiniMatrix(i) = System.DBNull.Value
                Else
                    'JRS 10/14/03
                    Select Case sAgg
                        Case "POP"
                            GiniMatrix(i) = CSng(PLOT(year_Renamed, i)) * popAll(year_Renamed, i)
                        Case "GDP"
                            GiniMatrix(i) = CSng(PLOT(year_Renamed, i)) * gdpAll(year_Renamed, i)
                        Case Else
                            GiniMatrix(i) = CSng(PLOT(year_Renamed, i))
                    End Select
                End If

                PopMatrix(i) = popAll(year_Renamed, i)
            Next i
            'Load Gini Values
            'UPGRADE_WARNING: Couldn't resolve default property of object GiniCalc(). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'UPGRADE_WARNING: Couldn't resolve default property of object GiniVec(year_Renamed). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            GiniVec(year_Renamed) = GiniCalc(GiniMatrix, PopMatrix, LorenzX, LorenzY)
            'Load Lorenz Graph
            For i = 1 To NR
                'UPGRADE_WARNING: Couldn't resolve default property of object LorenzX(i). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object LorenzX_Year(i, year_Renamed). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                LorenzX_Year(i, year_Renamed) = LorenzX(i)
                'UPGRADE_WARNING: Couldn't resolve default property of object LorenzY(i). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                'UPGRADE_WARNING: Couldn't resolve default property of object LorenzY_Year(i, year_Renamed). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                LorenzY_Year(i, year_Renamed) = LorenzY(i)
            Next i
            'end of for every year
        Next year_Renamed
        'Save display vars
        Dim Var_name As String
        Dim Sec_Dim As String
        Dim Third_dim As String
        Var_name = VARN(1, 1)
        Sec_Dim = GR2N(1)
        Third_dim = GR3N(1)
        'jrs 2005/06/09
        Dim yr As Integer
        yr = FinYear(1)
        'Clear the plot vector
        ClearPlot(COUNTE, PLOT, VARN, GR1N, GR2N, GR3N, GR4N,
        FirstYear, LastYear, LastYearForecast, FDNG1, FDNG2, FDNG3, FDNG4, FinYear,
        FinYearHis, buseAllHis, YAxisLabel, XAxisLabel, StaYearHis, sUsrDefCats)
        'jrs 2005/06/09
        FinYear(1) = yr

        'Reload it with the calculated data
        VARN(0, 1) = "GINI"
        VARN(1, 1) = "GINI"
        GR1N(1) = Var_name
        GR2N(1) = Sec_Dim
        GR3N(1) = Third_dim

        'jrs 10/27/04 Flexible Dimension Names for Graphs
        FDNG1(COUNTE + 1) = Var_name
        FDNG2(COUNTE + 1) = Sec_Dim
        FDNG3(COUNTE + 1) = Third_dim

        For year_Renamed = 1 To LastYear - FirstYear + 1
            'UPGRADE_WARNING: Couldn't resolve default property of object FinYear(1). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            If year_Renamed > FinYear(1) Then Exit For 'Beyond run year
            'UPGRADE_WARNING: Couldn't resolve default property of object GiniVec(year_Renamed). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            'UPGRADE_WARNING: Couldn't resolve default property of object PLOT(year_Renamed, 1). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            PLOT(year_Renamed, 1) = GiniVec(year_Renamed)
        Next year_Renamed
        COUNTE = 1

    End Sub

