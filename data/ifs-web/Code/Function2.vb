    'JRS 04/14/03
    Public Sub gFilterAll(ByRef filter_Renamed As String, ByRef COUNTE As Integer, ByRef PLOT As Object,
    ByRef TimePoints As Short, ByRef Fil_Min_Level As Single, ByRef Fil_Max_Level As Single,
    ByRef Fil_Rate As Single, ByRef Fil_Range_Min As Single, ByRef Fil_Range_Max As Single,
    ByVal LastYear As Integer, ByVal buseAllHis As Boolean, ByVal ActiveBase As String,
    ByRef FinYearHis As Object, ByVal FirstYear As Integer, ByRef aFormulas As Object,
    ByRef FileNumbr As Object, ByRef VARN As Object, ByRef GR1N As Object, ByRef GR2N As Object,
    ByRef GR3N As Object, ByRef GR4N As Object, ByRef FDNG1 As Object, ByRef FDNG2 As Object,
    ByRef FDNG3 As Object, ByRef FDNG4 As Object, ByRef FinYear As Object)
        Dim bValid As Boolean
        Dim i As Short
        Dim j As Short
        For j = COUNTE To 1 Step -1
            bValid = False
            'UPGRADE_WARNING: Couldn't resolve default property of object FinYear(j). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
            For i = 1 To TimePoints
                Select Case filter_Renamed
                    Case "Min"
                        'UPGRADE_WARNING: Couldn't resolve default property of object PLOT(i, j). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                        If PLOT(i, j) >= Fil_Min_Level Then
                            bValid = True
                            Exit For
                        End If
                    Case "Max"
                        'UPGRADE_WARNING: Couldn't resolve default property of object PLOT(i, j). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                        If PLOT(i, j) <= Fil_Max_Level Then
                            bValid = True
                            Exit For
                        End If
                    Case "Rate"
                        If i > 1 Then
                            'UPGRADE_WARNING: Couldn't resolve default property of object PLOT(i - 1, j). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                            'UPGRADE_WARNING: Couldn't resolve default property of object PLOT(i, j). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                            If (PLOT(i, j) - PLOT(i - 1, j)) * 100 >= Fil_Rate * PLOT(i - 1, j) Then
                                bValid = True
                                Exit For
                            End If
                        End If
                    Case "Range"
                        'UPGRADE_WARNING: Couldn't resolve default property of object PLOT(i, j). Click for more: 'ms-help://MS.VSCC.2003/commoner/redir/redirect.htm?keyword="vbup1037"'
                        If PLOT(i, j) <= Fil_Range_Max And PLOT(i, j) >= Fil_Range_Min Then
                            bValid = True
                            Exit For
                        End If
                End Select
            Next i
            If Not bValid Then
                DeleteVar(j, COUNTE, LastYear, buseAllHis, ActiveBase, FinYearHis,
                FirstYear, PLOT, aFormulas, FileNumbr, VARN, GR1N, GR2N, GR3N, GR4N,
                FDNG1, FDNG2, FDNG3, FDNG4, FinYear)
            End If
        Next j
    End Sub

    'jrs 2012/01/16 added bMoreCols
    'JRS 12/11/02 FILTER
    Public Sub gFilterColumn(ByVal col As Short, ByRef filter_Renamed As String, ByRef COUNTE As Integer, ByRef PLOT As Object,
    ByRef Timepoints As Short, ByRef Fil_Min_Level As Single, ByRef Fil_Max_Level As Single, ByRef Fil_Rate As Single,
    ByRef Fil_Range_Min As Single, ByRef Fil_Range_Max As Single, ByVal Interval As Integer, ByVal bMoreCols As Boolean,
    ByRef GR1N As Object, ByRef GR2N As Object, ByRef GR3N As Object, ByRef GR4N As Object,
    ByRef FDNG1 As Object, ByRef FDNG2 As Object, ByRef FDNG3 As Object, ByRef FDNG4 As Object,
    ByRef VARN As Object)

        Dim bValid As Boolean
        Dim i As Short
        bValid = False

        'jrs 2007/02/12 this wasn't considering Intervals
        'replaced PLOT(i, col) with PLOT((i - 1) * j + 1, col)
        Dim j As Integer
        If Interval > 1 Then
            j = Interval
        Else
            j = 1
        End If

        For i = 1 To Timepoints
            If IsNumeric(PLOT(i, col)) Then
                Select Case filter_Renamed
                    Case "Min"
                        If PLOT((i - 1) * j + 1, col) >= Fil_Min_Level Then
                            bValid = True
                            Exit For
                        End If
                    Case "Max"
                        If PLOT((i - 1) * j + 1, col) <= Fil_Max_Level Then
                            bValid = True
                            Exit For
                        End If
                    Case "Rate"
                        If i > 1 And IsNumeric(PLOT(i - 1, col)) Then
                            'jrs 2007/02/12 considering intervals
                            If j > 1 Then
                                If PLOT((i - 2) * j + 1, col) <> 0 And Math.Sign(PLOT((i - 1) * j + 1, col)) = Math.Sign(PLOT((i - 2) * j + 1, col)) And
                                Math.Abs(PLOT((i - 2) * j + 1, col)) > 0.0001 Then
                                    If (PLOT((i - 1) * j + 1, col) / PLOT((i - 2) * j + 1, col)) ^ (1 / j) - 1 >= Fil_Rate / 100 Then
                                        bValid = True
                                        Exit For
                                    End If
                                End If
                            Else
                                If (PLOT(i, col) - PLOT(i - 1, col)) * 100 >= Fil_Rate * PLOT(i - 1, col) And
                                Math.Abs(PLOT(i - 1, col)) > 0.0001 Then
                                    bValid = True
                                    Exit For
                                End If
                            End If
                        End If
                    Case "Range"
                        If PLOT((i - 1) * j + 1, col) <= Fil_Range_Max And PLOT((i - 1) * j + 1, col) >= Fil_Range_Min Then
                            bValid = True
                            Exit For
                        End If
                End Select
            End If
        Next i
        If Not bValid Then
            'jrs 2012/01/16
            If bMoreCols Then
                Dim k As Integer
                For k = col To COUNTE - 1
                    For i = 1 To Timepoints
                        PLOT((i - 1) * j + 1, k) = PLOT((i - 1) * j + 1, k + 1)
                    Next i
                    'jrs 2012/05/03
                    GR1N(k) = GR1N(k + 1)
                    GR2N(k) = GR2N(k + 1)
                    GR3N(k) = GR3N(k + 1)
                    GR4N(k) = GR4N(k + 1)

                    FDNG1(k) = FDNG1(k + 1)
                    FDNG2(k) = FDNG2(k + 1)
                    FDNG3(k) = FDNG3(k + 1)
                    FDNG4(k) = FDNG4(k + 1)

                    For i = 0 To 6
                        VARN(i, k) = VARN(i, k + 1)
                    Next i
                Next k
                For i = 1 To Timepoints
                    PLOT((i - 1) * j + 1, COUNTE) = 0
                Next i
            Else
                'jrs 2006/03/10
                For i = 1 To Timepoints
                    PLOT(i, col) = 0
                Next i
            End If
            COUNTE = COUNTE - 1
        End If
    End Sub

