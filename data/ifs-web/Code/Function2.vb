    'jrs 2006/04/18
    Public Sub gLoadCompHisFor(ByRef rsList As DataTable, ByVal sDim1 As String, ByVal sDim2 As String, ByVal sDim3 As String,
    ByVal FileNum As Integer, ByVal col As Integer, ByVal bfillHistoryHoles As Boolean,
    ByVal buseAllHistory As Boolean, ByRef iLstYrUseAllHistory As Integer, ByRef COUNTE As Object,
    ByRef aFormulas As Object, ByRef bComputation As Boolean,
    ByRef FirstYear As Integer, ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef bLoadForDisplaySuccess As Boolean, ByRef myForm As Page, ByRef FinYear As Object, ByRef VARN As Object,
    ByRef FileforDisplay As Integer, ByRef IfsPars As myParameters, ByRef TargetVector As Object,
    ByVal bfillHistoryOnlyHoles As Boolean, ByRef ff2 As Object, ByVal bCompAll As Boolean, ByRef dataAll As Object,
    ByRef StaYearHis As Object, ByRef iFstYrUseAllHisotry As Integer, ByRef SQLite As String)
        '1. rsList is a recordset that contains information about the Differentiated Formula to be retrieved, if nothing use first formula in plot
        '2. sDim1 is the dimension 1
        '3. sDim2 is the dimension 2
        '4. sDim3 is the dimension 3
        '5. FileNum is the File Number to be used in Forecast
        '6. col is the index where to look for the formula to use
        '7. bfillHistoryHoles is true to indicate that holes should be filled with interpolation or extrapolation
        '8. buseAllHIstory if true it will ignore iLastYear and will retrieve all available history (> lastyearhistory, not < firstyearhistory)
        '9. iLstYrUseAllHistory is the last year of history loaded
        '10. COUNTE global variable that counts variables read
        '11. aFormulas global array that stores formulas
        '12. bComputation global variable that indicates we're using computations
        '13. FirstYear global variable
        '14. LastYear global variable
        '15. bLoadForDisplaySuccess global variable that indicates success when loading data
        '16. FinYear global array with the number of points per column
        '17. VARN global array to store labels
        '18. filefordisplay global variable to store opened file
        '19. IfsParameters is an object that contains the following parameters:
        'i. currencyVal global variable with the factor for currency conversion
        'ii. vShortSce global array with short name of sce files
        'iii. RunFiles global array with name of runfiles
        'iv. Ifs_MDB2Active is a global variable with the database with group information
        'v. IFsCoVaTrASeries_MDB is the path to the covatra historical series file
        'vi. IFsHistSeries_MDB is the path to ifshistseries.mdb
        'vii. PutFdrvRun is a global variable that contains the path to ifsvar.mdb
        '20. TargetVector stores the results
        '21. bfillHistoryOnlyHoles is true when not using extrapolation to fill holes
        '22. bCompAll
        '23. dataAll
        '24. StaYearHis
        '25. iFstYrUseAllHisotry

        'jrs 2006/04/18
        Dim bGrp As Object
        bGrp = Nothing
        COUNTE = COUNTE + 1
        Dim oldFirstYear As Integer
        oldFirstYear = FirstYear
        'jrs 2008/09/12 FirstYear = FirstYearHistory
        FirstYear = FirstYearForecast

        Dim sUnit As String

        Dim sFormulaDet As String, sFormulaDetHis As String, sVarName As String, iFormulaId As Integer, ff As New Formula
        If Not (rsList Is Nothing) Then
            sFormulaDet = rsList.Rows(0).Item("FormulaDet")
            sFormulaDetHis = rsList.Rows(0).Item("FormulaDetHis")
            sVarName = rsList.Rows(0).Item("VarName")
            iFormulaId = rsList.Rows(0).Item("FormulaId")
            'sUnit = rsList.Fields("Units")
        Else
            'jrs 2012/03/13
            If col > 0 Then
                sFormulaDet = aFormulas(col).Formula
                sFormulaDetHis = aFormulas(col).Formula2
                sVarName = aFormulas(col).Name
                iFormulaId = -1
                ff = aFormulas(col)
                sUnit = aFormulas(col).Unit
            Else
                sFormulaDet = ff2.Formula
                sFormulaDetHis = ff2.Formula2
                sVarName = ff2.Name
                iFormulaId = -1
                ff = ff2
                sUnit = ff2.Unit
            End If
        End If

        'load plot for the forecast part
        gLoadComp(COUNTE, sFormulaDet, sVarName, sDim1, sDim2, sDim3, sUnit, iFormulaId, bGrp, FileNum, False, True,
        ff, bfillHistoryHoles, buseAllHistory, -1, False, bComputation, FirstYear, LastYear, LastYearForecast,
        bLoadForDisplaySuccess, myForm, FinYear, FileforDisplay, IfsPars, TargetVector, aFormulas, bfillHistoryOnlyHoles,
        iFstYrUseAllHisotry, bCompAll, dataAll, StaYearHis, "", SQLite)

        'jrs 2008/07/11
        Dim FinAll As Integer
        FinAll = FinYear(COUNTE)

        Dim f As New Formula
        f = aFormulas(COUNTE)
        Dim oldLastYear As Integer
        oldLastYear = LastYear
        LastYear = LastYearHistory - 1 'jrs 2006/06/08 keep forecast value in year 2000 instead of historic one
        'jrs 2008/09/12
        FirstYear = FirstYearHistory

        If rsList Is Nothing Then
            iFormulaId = -2
        Else
            iFormulaId = iFormulaId + 1
        End If
        'load plot for the history part
        gLoadComp(COUNTE, sFormulaDetHis, sVarName, sDim1, "", "", "", iFormulaId, bGrp, -1, False, True, ff,
        bfillHistoryHoles, buseAllHistory, iLstYrUseAllHistory, False, bComputation, FirstYear, LastYear, LastYearForecast,
        bLoadForDisplaySuccess, myForm, FinYear, FileforDisplay, IfsPars, TargetVector, aFormulas, bfillHistoryOnlyHoles,
        iFstYrUseAllHisotry, bCompAll, dataAll, StaYearHis, "", SQLite)
        'jrs 2005/12/19 RAM for Formulas
        Dim VarHis As Vector
        VarHis = aFormulas(COUNTE).disVar

        aFormulas(COUNTE) = f
        LastYear = oldLastYear
        FirstYear = oldFirstYear
        'jrs 2008/09/12 FinYear(COUNTE) = FinAll 'jrs 2008/07/11 LastYear - FirstYear + 1
        FinYear(COUNTE) = FinYear(COUNTE) + FinAll
        aFormulas(COUNTE).Formula2 = sFormulaDetHis
        'jrs 2005/12/19 RAM for Formulas
        aFormulas(COUNTE).InitializeVarsHis(VarHis)

        'Load Display Titles
        If FileNum >= 0 Then
            VARN(0, COUNTE) = sVarName & "[" & LTrim$(CStr(IfsPars.vShortSce(FileNum))) & "]"
        Else
            VARN(0, COUNTE) = sVarName & "[Historic]"
        End If

    End Sub

    'jrs 2012/10/02
    'changed Result from Single to Object, so that it can store empty or nulls
    'jrs 2010/09/07 translate to web
    'jrs 2007/08/18
    'Year specific formulation used in Cross-Sectional
    Public Sub gLoadCompHisEmp(ByRef Result As Object, ByVal sDim1 As String, ByRef FlagGroup As Object,
    ByRef ff As Formula, ByVal iYearAdv As Integer, ByVal bFilterCtry As Boolean, ByRef FilterCtry As Object,
    ByRef bComputation As Boolean, ByRef FirstYear As Integer, ByRef LastYear As Integer, ByRef LastYearForecast As Integer,
    ByRef aFormulas As Object, ByRef myForm As Page, ByRef IFsParameters As myParameters,
    ByRef IFsCtrys As Object, ByVal bfillHistoryOnlyHoles As Boolean, ByRef SQLite As String)
        '1. Result stores the resulting value
        '2. sDim1 is the First Dimension, if empty is read from the Variable saved
        '3. FlagGroup is True when Dimension1 is a group, in the future will need a FlagGroup for Dim2 and Dim3, if null is passed the parameter is changed to true if Groups are found
        '4. ff is the Formula to be used when not saved in Display List
        '5. iYearAdv is the number of years to advance from the stored year (it can be negative).
        'jrs 2008/09/01
        'These options are used from Cross-Sectional, where ctries in X and Y are not selected
        'simultaneously and need to be matched
        '6. bFilterCtry is true if we need to filter members of a group (not all members to be used)
        '7. FilterCtry is an array of all ctries, if element is true, the ctry is to be skipped/filtered
        '8. bfillHistoryOnlyHoles is true when not using extrapolation for filling holes

        Dim f As Formula
        f = New Formula
        f.init(ff.Formula_Renamed)
        f.Name = ff.Name
        f.Dimension = sDim1
        f.Unit = ff.Unit

        'jrs 2006/06/13
        Dim oldbComputation As Boolean
        oldbComputation = bComputation
        bComputation = True
        Dim FinAll As Integer

        Dim oldDimsize As Integer
        oldDimsize = f.DimensionSize
        f.DimensionSize = 0
        f.begAll = 1

        'if formula id is -1 use formula data
        Dim sVarName As String, sCodeVar As String, iAbsolutePosition As Integer
        Dim sD1 As String, sD2 As String, sD3 As String
        Dim sYr As String
        Dim II As Integer
        II = 1
        sVarName = ff.disVar.displayDet(II)
        sD1 = ff.disVar.displayDet1(II)
        sD2 = ff.disVar.displayDet2(II)
        sD3 = ff.disVar.displayDet3(II)

        sCodeVar = ff.disVar.display(II)
        iAbsolutePosition = II - 1

        Dim idxPos As Integer, idxPos2 As Integer, l As Integer, idxHis As Integer
        idxPos = InStr(1, sVarName, "]")
        idxHis = 1

        Dim iFirstYear As Integer
        iFirstYear = FirstYearHistory

        Dim iRowPosition As Integer
        iRowPosition = 1

        f.endAll = 1

        'thes are the dimensions to be saved whith each element of the formula,
        'independently of the parameters passed, or retrieved
        Dim Dim1 As String, Dim2 As String, Dim3 As String 'jrs 2006/05/17 Dim3

        Dim fn As String, sDet As String
        Dim idxVar As Integer, sVar As String
        'Labels for Dimentionality
        Dim d1 As String, d2 As String, d3 As String
        d1 = "d1"
        d2 = "d2"
        d3 = "d3"

        'jrs 2006/09/22
        Dim iMaxLstYrUseAllHistory As Integer

        Dim xPLOTComp() As Object
        ReDim xPLOTComp(MaxYears)
        Dim xData(f.disVar.disSize) As Object

        'loop in the first formula's variables idx = 0
        Do While True
            'Replace File Number in Formula
            idxPos = InStr(1, sVarName, "(")
            If idxPos > 0 Then
                sVar = Mid(sVarName, 1, idxPos - 1)
                sDet = sVarName
                'set year
                sYr = Mid(sVarName, idxPos + 1, 4)
                If Not IsNumeric(sYr) Then
                    If UCase(sYr) = "EARL" Then
                        sYr = "EARLIEST"
                    Else
                        sYr = "MOSTRECENT"
                    End If
                End If
            Else
                sDet = sVarName
                sVar = sDet
                sYr = CStr(FirstYearHistory)
            End If

            If idxVar = -1 Then
                idxVar = 0
            End If

            'Replace dimensions in formula
            If sDim1 > "" Then
                Dim1 = sDim1
            Else
                Dim1 = sD1
            End If
            If d1 = "d1" Then
                d1 = Dim1
            ElseIf d1 <> Dim1 Then
                d1 = ""
            End If

            Dim2 = ""
            Dim3 = ""

            f.disVar.setDataDetS(sCodeVar, sDet)
            f.disVar.setDataDet1S(sCodeVar, Dim1)
            f.disVar.setDataDet2S(sCodeVar, Dim2)
            f.disVar.setDataDet3S(sCodeVar, Dim3)

            'jrs 2006/07/24
            'Check FlagGroup every time, since the formula could combine groups and regions
            Dim idxDim1 As Integer
            idxDim1 = -1
            If Not (FlagGroup Is Nothing) Then
                idxDim1 = IFsRegs.Item(Dim1).Index
                If FlagGroup Then
                    If idxDim1 > 0 Then
                        FlagGroup = False
                    End If
                Else
                    'jrs 2012/10/01 what if the formula is using Countries, comming from Cross-Sectional
                    'Problems with Bahamas, The
                    If idxDim1 < 0 Then
                        'jrs 2012/10/02 really check if it's a group
                        idxDim1 = gGetGroupIdx(Dim1, False, myForm)
                        If idxDim1 > 0 Then
                            FlagGroup = True
                        Else
                            'need to convert to region
                            Dim1 = getRegionFromCtry(Dim1)
                            idxDim1 = IFsRegs.Item(Dim1).Index
                        End If
                    End If
                End If
            End If

            'jrs 2008/09/01 added bFilterCtry and FilterCtry
            gLoadForDisplayHisYrFld(sVar, Dim1, idxDim1, Dim2, -1, Dim3, -1,
            FlagGroup, 1, xPLOTComp, 1, sYr, sYr, True, False, False, "", False,
            False, -1, bFilterCtry, FilterCtry, True, myForm, IFsParameters, Nothing,
            bComputation, IFsCtrys, LastYearForecast, LastYearForecast, bfillHistoryOnlyHoles, SQLite)

            xData(iAbsolutePosition + 1) = xPLOTComp.Clone

            'next variable
            II = II + 1
            If II > ff.disVar.disSize Then
                Exit Do
            End If
            sVarName = ff.disVar.displayDet(II)
            sD1 = ff.disVar.displayDet1(II)
            sD2 = ff.disVar.displayDet2(II)
            sD3 = ff.disVar.displayDet3(II)

            sCodeVar = ff.disVar.display(II)
            iAbsolutePosition = II - 1
        Loop

        'Labels for dimentionality
        If d1 = "d1" Then
            d1 = ""
        End If
        If d2 = "d2" Then
            d2 = ""
        End If
        If d3 = "d3" Then
            d3 = ""
        End If
        f.Dimension = d1
        f.Dimension2 = d2
        f.Dimension3 = d3

        'jrs 2006/04/19
        Dim oldFirstYear As Integer
        oldFirstYear = FirstYear
        If IsNumeric(sYr) Then
            FirstYear = CInt(sYr)
        Else
            FirstYear = LastYearHistory
        End If

        'jrs 2006/09/22
        Dim oldLastYear As Integer
        oldLastYear = LastYear
        If IsNumeric(sYr) Then
            LastYear = CInt(sYr)
        Else
            LastYear = LastYearHistory
        End If

        Dim TargetVector(1, 1) As Object
        'jrs 2006/07/18
        'End loading computed var
        'jrs 2008/07/11 changing from lastyear to totyears
        ComputeFormulas(f, 1, FirstYear, xData, 1, TargetVector,
        False, aFormulas, myForm, 0) 'jrs 2008/09/12 added iOffsetposition

        LastYear = oldLastYear
        FirstYear = oldFirstYear

        'jrs 2006/06/13
        bComputation = oldbComputation
        Result = TargetVector(1, 1)
    End Sub

    'jrs 2006/06/09
    'Function to Fill Holes in Empirical History
    Public Function fillHistoryHoles(ByRef row As DataRow, ByVal idx As Integer, ByVal iYear As Integer, ByVal bfillHistoryOnlyHoles As Boolean, ByVal bHistoricAnalog As Boolean) As Object
        '1. row is the data row that contains the historic data
        '2. idx is the index of the value to be filled
        '3. iYear is the year (2000) being filled
        'jrs 2011/03/28
        '4. bfillHistoryOnlyHoles is true when only for filling holes but no extrapolation
        '5. bHistoricAnalog is true when using hitoric analog, used in combination with OnlyHoles (if false and onlyholes is true it won't fill holes at the end of the table)

        fillHistoryHoles = System.DBNull.Value
        'We need to find 2 points to interpolate or extrapolate
        Dim P1 As Integer, P2 As Integer
        Dim y1 As Integer, y2 As Integer
        Dim Val1 As Single, Val2 As Single
        Dim i As Integer
        P1 = -1
        P2 = -1

        'If idx is not provided find it
        If idx < 0 Then
            Dim lst As Integer
            lst = row.Table.Columns.Count - 1
            Do While Not IsNumeric(row.Table.Columns(lst).Caption)
                lst = lst - 1
                If lst < 2 Then
                    Exit Do
                End If
            Loop
            idx = findYearIdx(row, Str(iYear))
            If idx < 0 Then
                'Find closest smaller year
                idx = findClosestSmallerYearIdx(2, lst, row, Trim(Str(iYear)), lst)
                If idx = -1 Then
                    fillHistoryHoles = System.DBNull.Value
                    Exit Function
                End If
                P1 = idx
                y1 = row.Table.Columns(P1).Caption
                Val1 = row.Item(P1)
                'If the point found is not the last point
                If P1 < lst Then
                    Do While Not IsNumeric(row.Item(idx + 1))
                        idx = idx + 1
                        If idx + 1 > lst Then 'jrs 2006/07/31 added + 1 (hist+for. POVGap, af. sub-sah)
                            Exit Do
                        End If
                    Loop
                    P2 = idx + 1
                    If P2 > lst Then
                        'look in the past
                        P2 = P1
                        y2 = y1
                        Val2 = Val1
                        idx = P1
                        Do While Not IsNumeric(row.Item(idx - 1))
                            idx = idx - 1
                            If idx < 2 Then
                                Exit Do
                            End If
                        Loop
                        P1 = idx - 1
                        If P1 < 2 Then
                            fillHistoryHoles = System.DBNull.Value
                            Exit Function
                        End If
                        y1 = row.Table.Columns(P1).Caption
                        Val1 = row.Item(P1)
                        'jrs 2017/06/30 added or y2 < cint(iyear), it was filling holes at the end,
                        'ex. India had values in 2009 and 2011, and it was still trying to fill holes in 2014 with the no extrapolation option
                        'jrs 2011/03/28
                        If Not (bfillHistoryOnlyHoles And (y1 > CInt(iYear) Or y2 < CInt(iYear))) Then
                            fillHistoryHoles = Val1 + (Val2 - Val1) / (y2 - y1) * (iYear - y1)
                        End If
                        Exit Function
                    End If
                    y2 = row.Table.Columns(P2).Caption
                    Val2 = row.Item(P2)
                    'jrs 2011/03/28
                    If Not (bfillHistoryOnlyHoles And y1 > CInt(iYear)) Then
                        fillHistoryHoles = Val1 + (Val2 - Val1) / (y2 - y1) * (iYear - y1)
                    End If
                    Exit Function
                Else 'if it's the last point, we have to look for smaller points
                    P2 = P1
                    y2 = y1
                    Val2 = Val1
                    Do While Not IsNumeric(row.Item(idx - 1))
                        idx = idx - 1
                        If idx < 2 Then
                            Exit Do
                        End If
                    Loop
                    P1 = idx - 1
                    If P1 < 2 Then
                        fillHistoryHoles = System.DBNull.Value
                        Exit Function
                    End If
                    y1 = row.Table.Columns(P1).Caption
                    Val1 = row.Item(P1)
                    'jrs 2017/06/30 added or y2 < cint(iyear), it was filling holes at the end,
                    'ex. Argentina had values in 2012 and 2013, and it was still trying to fill holes in 2014 with the no extrapolation option
                    'jrs 2011/03/28
                    If Not (bfillHistoryOnlyHoles And (y1 > CInt(iYear) Or y2 < CInt(iYear))) Then
                        fillHistoryHoles = Val1 + (Val2 - Val1) / (y2 - y1) * (iYear - y1)
                    End If
                    Exit Function
                End If
            End If
        End If

        'look for a point in the past
        For i = idx - 1 To 2 Step -1
            If IsNumeric(row.Item(i)) Then
                P1 = i
                y1 = Val(row.Table.Columns(i).Caption)
                Val1 = row.Item(i)
                Exit For
            End If
        Next i
        'look for a point in the future
        For i = idx + 1 To row.Table.Columns.Count - 1
            If Not IsNumeric(row.Table.Columns(i).Caption) Then
                Exit For
            End If
            If IsNumeric(row.Item(i)) Then
                P2 = i
                y2 = Val(row.Table.Columns(i).Caption)
                Val2 = row.Item(i)
                Exit For
            End If
        Next i
        'If we have 2 points we can interpolate
        If P1 > 0 And P2 > 0 Then
            fillHistoryHoles = Val1 + (Val2 - Val1) / (y2 - y1) * (iYear - y1)
            Exit Function
        End If
        'If we have NO points there's nothing we can do
        If P1 < 0 And P2 < 0 Then
            Exit Function
        End If
        'If we don't have p1 we have to extrapolate using the future
        If P1 < 0 And Not bfillHistoryOnlyHoles Then 'jrs 2011/03/28
            P1 = P2
            y1 = y2
            Val1 = Val2
            P2 = -1
            'look for a point in the future
            For i = P1 + 1 To row.Table.Columns.Count - 1
                If Not IsNumeric(row.Table.Columns(i).Caption) Then
                    Exit For
                End If
                If IsNumeric(row.Item(i)) Then
                    P2 = i
                    y2 = Val(row.Table.Columns(i).Caption)
                    Val2 = row.Item(i)
                    Exit For
                End If
            Next i
            'If we have 2 points we can extrapolate
            If P2 > 0 Then
                fillHistoryHoles = Val1 + (Val2 - Val1) / (y2 - y1) * (iYear - y1)
            End If 'if the second point is not found there's nothing we can do
            Exit Function
        End If
        'If we don't have p2 we have to extrapolate using the past
        If P2 < 0 And (Not bfillHistoryOnlyHoles Or bHistoricAnalog) Then 'jrs 2015/01/30 added And (Not bfillHistoryOnlyHoles Or bHistoricAnalog)
            P2 = P1
            y2 = y1
            Val2 = Val1
            P1 = -1
            'look for a point in the past
            For i = P2 - 1 To 2 Step -1
                If IsNumeric(row.Item(i)) Then
                    P1 = i
                    y1 = Val(row.Table.Columns(i).Caption)
                    Val1 = row.Item(i)
                    Exit For
                End If
            Next i
            'If we have 2 points we can extrapolate
            If P1 > 0 Then
                fillHistoryHoles = Val1 + (Val2 - Val1) / (y2 - y1) * (iYear - y1)
            End If 'if the second point is not found there's nothing we can do
            Exit Function
        End If
    End Function

    'jrs 2006/06/09
    'Function to Fill history holes for groups, when the whole year column is not in the table
    Private Function fillHistoryHolesforGroups(ByRef valtbl As DataTable, ByVal idx As Integer, ByVal iYear As Integer,
    ByVal sAgRule As String, ByRef tblWeight As DataTable, ByRef gCountGroupMembers As Integer, ByRef gGroupMembrs As Object,
    ByVal sUnits As String, ByVal MaxValEst As Single, ByVal sVar As String, ByVal bfillHistoryOnlyHoles As Boolean,
    ByVal bHistoricAnalog As Boolean) As Object
        '1. valtbl is the table that contains the historic data
        '2. idx is the index of the value to be filled
        '3. iYear is the year to be read
        '4. sAgRule is the aggregation rule for the group
        '5. tblWeight is the historic table used for weight average
        '6. gCountGroupMembers is the number of countries in the group
        '7. gGroupMembrs is the array that contains all members of the group
        '8. sUnits Units are useful to limit Percents bellow 100
        '9. MaxValEst is used when Percents can go above 100 like EDPRIENR
        '10. sVar Variable Name used for exception on handling Negatives, for PopGrowth
        'jrs 2011/03/28
        '11. bfillHistoryOnlyHoles true when not doing extrapolation
        '12. bHistoricAnalog is true when using hitoric analog, used in combination with OnlyHoles (if false and onlyholes is true it won't fill holes at the end of the table)

        Dim Sumplot As Object, SumNum As Object, SumWeight As Object
        Dim VarVal As Object
        Dim kk As Integer
        Dim agcount As Integer
        Dim GDPfld As String, GDPval As Object
        Dim POPfld As String, POPval As Object
        Dim LNDfld As String, LNDval As Object
        agcount = gCountGroupMembers
        Dim row As DataRow, rowWeight As DataRow
        Dim Auxfld As String, Auxval As Object

        Select Case sAgRule
            Case "SUM"
                Sumplot = 0
                VarVal = 0
                For kk = 1 To agcount
                    row = SeekRow(valtbl, gGroupMembrs(kk))
                    VarVal = fillHistoryHoles(row, idx, iYear, bfillHistoryOnlyHoles, bHistoricAnalog)
                    '1st and second field = Country and Fips
                    If (IsNumeric(VarVal)) Then
                        Sumplot = Sumplot + VarVal
                    End If
                Next kk
                VarVal = Sumplot

            Case "AVG"
                Sumplot = 0
                SumNum = 0
                For kk = 1 To agcount
                    row = SeekRow(valtbl, gGroupMembrs(kk))
